package main

// bakgrep - Main entry point
// A grep-like file search utility written in Bak

import "example-projects/cli-tool/types.bak" as types
import "example-projects/cli-tool/args.bak" as args
import "example-projects/cli-tool/search.bak" as search
import "example-projects/cli-tool/strings.bak" as str

func main() -> (void) {
    var parse_result: args.ParseResult = args.parse_args()
    
    switch parse_result {
        case Help {
            args.print_help()
        }
        case Error(msg) {
            println("Error: ", msg)
            println("Try 'bakgrep --help' for usage information")
        }
        case Success(config) {
            // Create statistics tracker
            mut var stats: types.Stats = types.Stats.new()
            
            // Run search
            search.search_files(&config, &mut stats)
            
            // Print summary if multiple files
            if config.files.len() > 1 {
                println("")
                println("--- Summary ---")
                println("Files searched: ", stats.files_searched)
                println("Total matches: ", stats.total_matches)
            }
        }
    }
    return void
}
