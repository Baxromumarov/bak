package main

// Command-line argument parsing
import "src/std/os/os.bak" as os
import "example-projects/cli-tool/types.bak" as types

pub enum ParseResult {
    Success(types.Config)
    Help
    Error(string)
}

// Parse command-line arguments into a Config
pub func parse_args() -> (ParseResult) {
    var args: Vec<string, _> = os.args()
    
    // Need at least: program, pattern
    if args.len() < 2 {
        return ParseResult.Error("Usage: bakgrep [options] pattern [file...]")
    }
    
    mut var config: types.Config = types.Config{
        pattern: "",
        files: Vec.new(),
        ignore_case: false,
        line_numbers: false,
        count_only: false,
        invert_match: false,
        recursive: false
    }
    
    mut var i: int = 1
    mut var pattern_set: bool = false
    
    while i < args.len() {
        var arg: string = args[i]
        
        if arg == "-h" || arg == "--help" {
            return ParseResult.Help
        } else if arg == "-i" || arg == "--ignore-case" {
            config.ignore_case = true
        } else if arg == "-n" || arg == "--line-numbers" {
            config.line_numbers = true
        } else if arg == "-c" || arg == "--count" {
            config.count_only = true
        } else if arg == "-v" || arg == "--invert" {
            config.invert_match = true
        } else if arg == "-r" || arg == "--recursive" {
            config.recursive = true
        } else if !pattern_set {
            config.pattern = arg
            pattern_set = true
        } else {
            config.files.push(arg)
        }
        
        i = i + 1
    }
    
    if !pattern_set {
        return ParseResult.Error("No search pattern provided")
    }
    
    // Default to stdin if no files (we'll use a placeholder)
    if config.files.len() == 0 {
        return ParseResult.Error("No files provided (stdin not yet supported)")
    }
    
    return ParseResult.Success(config)
}

// Print help message
pub func print_help() -> (void) {
    println("bakgrep - Search for patterns in files")
    println("")
    println("USAGE:")
    println("    bakgrep [OPTIONS] PATTERN FILE...")
    println("")
    println("OPTIONS:")
    println("    -h, --help         Show this help message")
    println("    -i, --ignore-case  Case-insensitive search")
    println("    -n, --line-numbers Show line numbers")
    println("    -c, --count        Only print match counts")
    println("    -v, --invert       Invert match (show non-matching lines)")
    println("    -r, --recursive    Search directories recursively")
    println("")
    println("EXAMPLES:")
    println("    bakgrep 'error' log.txt")
    println("    bakgrep -in 'TODO' src/*.bak")
    return void
}
