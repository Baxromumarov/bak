package main

// bakgrep-demo - Single-file grep-like utility demonstration
// Shows file searching and pattern matching

import "src/std/fs/fs.bak" as fs

// ============ Configuration ============

pub struct Config {
    pattern: string
    ignore_case: bool
    line_numbers: bool
    count_only: bool
    invert_match: bool
}

impl Config as c {
    pub func new(pattern: string) -> (Config) {
        return Config{
            pattern: pattern,
            ignore_case: false,
            line_numbers: true,
            count_only: false,
            invert_match: false
        }
    }
}

// ============ Search Result ============

pub struct SearchResult {
    line_number: int
    line_content: string
}

// ============ String Matching ============

pub func match_pattern(line: &string, pattern: &string, ignore_case: bool) -> (bool) {
    mut var search_line: string = *line
    mut var search_pattern: string = *pattern
    
    if ignore_case {
        search_line = to_lower(&search_line)
        search_pattern = to_lower(&search_pattern)
    }
    
    return search_line.contains(search_pattern)
}

pub func to_lower(s: &string) -> (string) {
    mut var result: string = ""
    mut var i: int = 0
    while i < s.len() {
        var c: char = (*s)[i]
        var code: int = int(c)
        // A-Z is 65-90, add 32 to get a-z
        if code >= 65 && code <= 90 {
            result = result + string(char(code + 32))
        } else {
            result = result + string(c)
        }
        i = i + 1
    }
    return result
}

// ============ Line Splitting ============

pub func split_lines(content: &string) -> (Vec<string, _>) {
    mut var lines: Vec<string, _> = Vec.new()
    mut var current: string = ""
    mut var i: int = 0
    
    while i < content.len() {
        var c: char = (*content)[i]
        if c == '\n' {
            lines.push(current)
            current = ""
        } else if c != '\r' {
            current = current + string(c)
        }
        i = i + 1
    }
    
    // Don't forget the last line
    if current.len() > 0 {
        lines.push(current)
    }
    return lines
}

// ============ Searching ============

pub struct SearchOutput {
    results: Vec<SearchResult, _>
    match_count: int
}

pub func search_content(content: &string, config: &Config) -> (SearchOutput) {
    mut var results: Vec<SearchResult, _> = Vec.new()
    mut var match_count: int = 0
    
    var lines: Vec<string, _> = split_lines(content)
    mut var line_num: int = 1
    
    mut var i: int = 0
    while i < lines.len() {
        var line: string = lines[i]
        mut var matches: bool = match_pattern(&line, &config.pattern, config.ignore_case)
        
        // Handle inverted match
        if config.invert_match {
            matches = !matches
        }
        
        if matches {
            match_count = match_count + 1
            
            if !config.count_only {
                var result: SearchResult = SearchResult{
                    line_number: line_num,
                    line_content: line
                }
                results.push(result)
            }
        }
        
        line_num = line_num + 1
        i = i + 1
    }
    
    return SearchOutput{results: results, match_count: match_count}
}

// ============ Word Counting ============

pub func count_words(s: &string) -> (int) {
    mut var count: int = 0
    mut var in_word: bool = false
    mut var i: int = 0
    
    while i < s.len() {
        var c: char = (*s)[i]
        var is_space: bool = c == ' ' || c == '\t' || c == '\n' || c == '\r'
        
        if !is_space && !in_word {
            count = count + 1
            in_word = true
        } else if is_space {
            in_word = false
        }
        i = i + 1
    }
    return count
}

pub func count_lines(s: &string) -> (int) {
    mut var count: int = 0
    mut var i: int = 0
    while i < s.len() {
        if (*s)[i] == '\n' {
            count = count + 1
        }
        i = i + 1
    }
    return count + 1  // Add 1 for last line if no trailing newline
}

// ============ Print Results ============

pub func print_results(results: &Vec<SearchResult, _>, show_line_numbers: bool) -> (void) {
    mut var i: int = 0
    while i < results.len() {
        var result: SearchResult = (*results)[i]
        if show_line_numbers {
            println(result.line_number, ": ", result.line_content)
        } else {
            println(result.line_content)
        }
        i = i + 1
    }
    return void
}

// ============ Main ============

func main() -> (void) {
    println("╔════════════════════════════════════╗")
    println("║    bakgrep - Pattern Search Demo   ║")
    println("╚════════════════════════════════════╝")
    println("")
    
    // Sample text content (simulating a file)
    var sample_content: string = "package main

// This is a sample Bak source file for testing the grep tool.
// It contains various patterns to search for.

import \"src/std/io/io.bak\" as io

pub func hello() -> (void) {
    println(\"Hello, World!\")
    return void
}

// TODO: Implement more functions
// TODO: Add error handling
// FIXME: This needs optimization

pub func add(a: int, b: int) -> (int) {
    return a + b
}

// Another TODO item

func main() -> (void) {
    hello()
    var result: int = add(1, 2)
    println(\"Result: \", result)
    return void
}"
    
    println("=== Sample Content ===")
    println(sample_content)
    println("")
    println("=== File Statistics ===")
    println("Lines: ", count_lines(&sample_content))
    println("Words: ", count_words(&sample_content))
    println("Characters: ", sample_content.len())
    println("")
    
    // Search for "TODO"
    println("═══════════════════════════════════════")
    println("Searching for: \"TODO\"")
    println("═══════════════════════════════════════")
    
    var config1: Config = Config.new("TODO")
    var out1: SearchOutput = search_content(&sample_content, &config1)
    
    print_results(&out1.results, true)
    println("")
    println("Found ", out1.match_count, " match(es)")
    println("")
    
    // Case-insensitive search for "func"
    println("═══════════════════════════════════════")
    println("Searching for: \"func\" (case-insensitive)")
    println("═══════════════════════════════════════")
    
    mut var config2: Config = Config.new("func")
    config2.ignore_case = true
    var out2: SearchOutput = search_content(&sample_content, &config2)
    
    print_results(&out2.results, true)
    println("")
    println("Found ", out2.match_count, " match(es)")
    println("")
    
    // Inverted search (lines NOT containing "//")
    println("═══════════════════════════════════════")
    println("Searching for: lines NOT containing \"//\"")
    println("═══════════════════════════════════════")
    
    mut var config3: Config = Config.new("//")
    config3.invert_match = true
    var out3: SearchOutput = search_content(&sample_content, &config3)
    
    print_results(&out3.results, true)
    println("")
    println("Found ", out3.match_count, " non-comment line(s)")
    println("")
    
    println("═══════════════════════════════════════")
    println("All searches completed!")
    println("═══════════════════════════════════════")
    
    return void
}
