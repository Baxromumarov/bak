package main

import (
    "src/std/db/postgres.bak" as postgres
    "example-projects/http-api-server/models.bak" as models
    "src/std/db/db.bak" as db
)

alias user = models.user

struct UsersDB {
    db: db.Connection
}

pub func connect_to_db() -> (UsersDB) {
    var conn_str: string = "host=localhost port=5432 user=postgres password=postgres dbname=test sslmode=disable"
    
    var conn_result = postgres.connect(conn_str)

    if conn_result.isErr() {
        println("Error connecting to database: " + conn_result.unwrapErr())
        return UsersDB{}
    }
    
    var conn = conn_result.unwrap()
    
    println("Successfully connected to the database.")

    return UsersDB{db: conn}
}

impl UsersDB as u { 
    pub func get_all_users() -> (Result<Vec<user, _>, string>) {
        var sql: string = "SELECT id, name, balance FROM users" 
        var result = postgres.query(&u.db, sql)
        if result.isErr() {
            return Err(result.unwrapErr())
        }

        return map_query_result_to_users(result.unwrap())
    }

    pub func get_user_by_id(id: int) -> (Result<user, string>) {
        var sql: string = "SELECT id, name, balance FROM users WHERE id = $1"
        var params: Vec<string, _> = Vec.from([id.toString()])
        var result = postgres.queryParams(&u.db, sql, params)
        if result.isErr() {
            return Err(result.unwrapErr())
        }
        return map_query_result_to_user(result.unwrap())
    }

    pub func create_user(name: string, balance: float64) -> (Result<user, string>) {
        var sql: string = "INSERT INTO users (name, balance) VALUES ($1, $2) RETURNING id, name, balance"
        var params: Vec<string, _> = Vec.from([name, balance.toString()])
        var result = postgres.queryParams(&u.db, sql, params)
        if result.isErr() {
            return Err(result.unwrapErr())
        }
        return map_query_result_to_user(result.unwrap())
    }

    pub func update_user(id: int, name: string, balance: float64) -> (Result<user, string>) {
        var sql: string = "UPDATE users SET name = $1, balance = $2 WHERE id = $3 RETURNING id, name, balance"
        var params: Vec<string, _> = Vec.from([name, balance.toString(), id.toString()])
        var result = postgres.queryParams(&u.db, sql, params)
        if result.isErr() {
            return Err(result.unwrapErr())
        }
        return map_query_result_to_user(result.unwrap())
    }

    pub func delete_user(id: int) -> (Result<user, string>) {
        var sql: string = "DELETE FROM users WHERE id = $1 RETURNING id, name, balance"
        var params: Vec<string, _> = Vec.from([id.toString()])
        var result = postgres.queryParams(&u.db, sql, params)
        if result.isErr() {
            return Err(result.unwrapErr())
        }
        return map_query_result_to_user(result.unwrap())
    }
}

func map_query_result_to_users(result: db.QueryResult) -> (Result<Vec<user, _>, string>) {
    mut var users: Vec<user, _> = Vec.new()

    var rows: Vec<db.Row, _> = db.rows(&result)
    for row in rows {
        var id_result = row.getInt("id")
        if id_result.isErr() {
            return Err(id_result.unwrapErr())
        }

        var name_result = get_required_string(&row, "name")
        if name_result.isErr() {
            return Err(name_result.unwrapErr())
        }
        
        var balance_result = get_float_or(&row, "balance", 0.0)
        if balance_result.isErr() {
            return Err(balance_result.unwrapErr())
        }
    
        users.push(user{
            id: id_result.unwrap(),
            name: name_result.unwrap(),
            balance: balance_result.unwrap(),
        })
    }

    return Ok(users)

}

func map_query_result_to_user(result: db.QueryResult) -> (Result<user, string>) {
    var rows: Vec<db.Row, _> = db.rows(&result)
    if rows.len() == 0 {
        return Err("not found")
    }

    var row: db.Row = rows[0]
    var id_result = row.getInt("id")
    if id_result.isErr() {
        return Err(id_result.unwrapErr())
    }

    var name_result = get_required_string(&row, "name")
    if name_result.isErr() {
        return Err(name_result.unwrapErr())
    }
    
    var balance_result = get_float_or(&row, "balance", 0.0)
    if balance_result.isErr() {
        return Err(balance_result.unwrapErr())
    }

    return Ok(user{
        id: id_result.unwrap(),
        name: name_result.unwrap(),
        balance: balance_result.unwrap(),
    })
}

func get_required_string(row: &db.Row, name: string) -> (Result<string, string>) {
    switch row.get(name) {
        case Ok(v) { return Ok(v) }
        case Err(_) { return Err("column '" + name + "' is NULL or missing") }
    }
}

func get_float_or(row: &db.Row, name: string, fallback: float64) -> (Result<float64, string>) {
    switch row.get(name) {
        case Ok(v) { return v.parseFloat() }
        case Err(_) { return Ok(fallback) }
    }
}
