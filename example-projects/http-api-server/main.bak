package main

import "std/http" as http
import "example-projects/http-api-server/db.bak" as db
import "example-projects/http-api-server/models.bak" as models
import "src/std/encoding/json/json.bak" as json

// Sample curl commands:
// curl -s http://localhost:8080/users
// curl -s http://localhost:8080/users/1
// curl -s -X POST http://localhost:8080/users -H "Content-Type: application/json" -d '{"name":"Ada","balance":12.5}'
// curl -s -X PUT http://localhost:8080/users/1 -H "Content-Type: application/json" -d '{"name":"Ada Lovelace","balance":42.0}'
// curl -s -X DELETE http://localhost:8080/users/1
mut var users_db: db.UsersDB = db.connect_to_db()

struct UserInput {
    name: string
    balance: float64
}

func users_handler(_req: http.Request) -> (http.Response) {
    var users_result = users_db.get_all_users()
    switch users_result {
        case Ok(users) {
            var json_body = users_to_json(users)
            return http.json(200, json_body)
        }
        case Err(e) {
            return http.error("Failed to fetch users: " + e)
        }
    }
    return http.Response{}
}

func user_by_id_handler(req: http.Request) -> (http.Response) {
    var id_result = parse_id_param(&req)
    if id_result.is_err() {
        return http.text(400, id_result.unwrap_err())
    }
    var user_result = users_db.get_user_by_id(id_result.unwrap())
    switch user_result {
        case Ok(user) {
            return http.json(200, json.marshal(user.to_json()))
        }
        case Err(e) {
            if e == "not found" {
                return http.not_found()
            }
            return http.error("Failed to fetch user: " + e)
        }
    }
    return http.Response{}
}

func create_user_handler(req: http.Request) -> (http.Response) {
    var input_result = parse_user_input(req.body_string())
    if input_result.is_err() {
        return http.text(400, input_result.unwrap_err())
    }

    var input: UserInput = input_result.unwrap()
    var user_result = users_db.create_user(input.name, input.balance)
    switch user_result {
        case Ok(user) {
            return http.json(201, json.marshal(user.to_json()))
        }
        case Err(e) {
            return http.error("Failed to create user: " + e)
        }
    }
    return http.Response{}
}

func update_user_handler(req: http.Request) -> (http.Response) {
    var id_result = parse_id_param(&req)
    if id_result.is_err() {
        return http.text(400, id_result.unwrap_err())
    }

    var input_result = parse_user_input(req.body_string())
    if input_result.is_err() {
        return http.text(400, input_result.unwrap_err())
    }

    var input: UserInput = input_result.unwrap()
    var user_result = users_db.update_user(id_result.unwrap(), input.name, input.balance)
    switch user_result {
        case Ok(user) {
            return http.json(200, json.marshal(user.to_json()))
        }
        case Err(e) {
            if e == "not found" {
                return http.not_found()
            }
            return http.error("Failed to update user: " + e)
        }
    }
    return http.Response{}
}

func delete_user_handler(req: http.Request) -> (http.Response) {
    var id_result = parse_id_param(&req)
    if id_result.is_err() {
        return http.text(400, id_result.unwrap_err())
    }

    var user_result = users_db.delete_user(id_result.unwrap())
    switch user_result {
        case Ok(user) {
            return http.json(200, json.marshal(user.to_json()))
        }
        case Err(e) {
            if e == "not found" {
                return http.not_found()
            }
            return http.error("Failed to delete user: " + e)
        }
    }
    return http.Response{}
}

func main() -> (void){
    var router = http.new_router()
    router.get("/users", users_handler)
    router.get("/users/:id", user_by_id_handler)
    router.post("/users", create_user_handler)
    router.put("/users/:id", update_user_handler)
    router.delete("/users/:id", delete_user_handler)

    var res = http.listen_and_serve("localhost:8080", router)
    if res.is_err() {
        println("Server Error: " + res.unwrap_err())
    }

    return void
}

func users_to_json(users: Vec<models.user, _>) -> (string) {
    return json.marshal_array(users, user_to_json)
}

func user_to_json(u: models.user) -> (json.Json) {
    return u.to_json()
}

func parse_id_param(req: &http.Request) -> (Result<int, string>) {
    var id_opt = req.param("id")
    if id_opt.is_none() {
        return Err("missing id param")
    }
    var id_result = id_opt.unwrap().parse_int()
    if id_result.is_err() {
        return Err("invalid id param")
    }
    return Ok(id_result.unwrap())
}

func parse_user_input(body: string) -> (Result<UserInput, string>) {
    if body.len() == 0 {
        return Err("request body is empty")
    }

    var json_result = json.unmarshal(body)
    if json_result.is_err() {
        return Err("invalid JSON: " + json_result.unwrap_err())
    }

    var obj_result = json.as_object(json_result.unwrap())
    if obj_result.is_err() {
        return Err(obj_result.unwrap_err())
    }
    var obj: json.Json = obj_result.unwrap()

    var name_result = json.require_string(&obj, "name")
    if name_result.is_err() {
        return Err(name_result.unwrap_err())
    }

    var balance: float64 = json.get_number_or(&obj, "balance", 0.0)
    return Ok(UserInput{name: name_result.unwrap(), balance: balance})
}
