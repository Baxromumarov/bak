package main

// Simplified dependency graph and task ordering
// Uses simpler patterns to avoid complex borrow issues
import "example-projects/task-runner/types.bak" as types

// Build execution order from config (simple BFS without recursion)
pub func get_execution_order(config: &types.Config, target: string) -> (Result<Vec<string, _>, string>) {
    // First, verify target exists
    if !config.has_task(target) {
        return Err("Task not found: " + target)
    }
    
    // Simple iterative approach - add task and its deps
    mut var order: Vec<string, _> = Vec.new()
    mut var queue: Vec<string, _> = Vec.new()
    
    queue.push(target)
    
    mut var iterations: int = 0
    var max_iterations: int = 100  // Prevent infinite loops
    
    while queue.len() > 0 && iterations < max_iterations {
        var current: string = queue[0]
        queue.remove(0)
        
        // Skip if already in order
        if contains(&order, &current) {
            iterations = iterations + 1
            continue
        }
        
        // Get task deps
        var task_opt: Option<types.TaskDef> = config.get_task(current)
        switch task_opt {
            case Some(task) {
                // Add deps to queue first
                mut var j: int = 0
                while j < task.deps.len() {
                    var dep: string = task.deps[j]
                    if !contains(&order, &dep) {
                        queue.push(dep)
                    }
                    j = j + 1
                }
                
                // Add current to order if all deps are satisfied
                mut var all_deps_satisfied: bool = true
                mut var k: int = 0
                while k < task.deps.len() {
                    if !contains(&order, &task.deps[k]) {
                        all_deps_satisfied = false
                        // Re-add current to queue to try later
                        queue.push(current)
                        break
                    }
                    k = k + 1
                }
                
                if all_deps_satisfied {
                    order.push(current)
                }
            }
            case None {
                return Err("Task not found: " + current)
            }
        }
        
        iterations = iterations + 1
    }
    
    if iterations >= max_iterations {
        return Err("Possible cycle detected or too many dependencies")
    }
    
    return Ok(order)
}

// Check if a vec contains a string
func contains(vec: &Vec<string, _>, s: &string) -> (bool) {
    mut var i: int = 0
    while i < vec.len() {
        if vec[i] == *s {
            return true
        }
        i = i + 1
    }
    return false
}
