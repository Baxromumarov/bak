package main

// Command-line argument parsing for the task runner
import "src/std/os/os.bak" as os
import "example-projects/task-runner/types.bak" as types

pub struct CliArgs {
    config_file: string
    task_name: string
    dry_run: bool
    verbose: bool
    list_tasks: bool
    show_help: bool
}

impl CliArgs as c {
    pub func new_default() -> (CliArgs) {
        return CliArgs{
            config_file: "Bakfile",
            task_name: "",
            dry_run: false,
            verbose: true,
            list_tasks: false,
            show_help: false
        }
    }
}

pub func parse_cli_args() -> (CliArgs) {
    mut var args: CliArgs = CliArgs.new_default()
    var argv: Vec<string, _> = os.args()
    
    mut var i: int = 1
    while i < argv.len() {
        var arg: string = argv[i]
        
        if arg == "-h" || arg == "--help" {
            args.show_help = true
        } else if arg == "-l" || arg == "--list" {
            args.list_tasks = true
        } else if arg == "-n" || arg == "--dry-run" {
            args.dry_run = true
        } else if arg == "-q" || arg == "--quiet" {
            args.verbose = false
        } else if arg == "-f" || arg == "--file" {
            if i + 1 < argv.len() {
                i = i + 1
                args.config_file = argv[i]
            }
        } else if starts_with(&arg, "-") {
            // Unknown flag, skip
        } else {
            // Task name
            args.task_name = arg
        }
        
        i = i + 1
    }
    
    return args
}

pub func print_help() -> (void) {
    println("bake - Task runner for Bak projects")
    println("")
    println("USAGE:")
    println("    bake [OPTIONS] [TASK]")
    println("")
    println("OPTIONS:")
    println("    -h, --help      Show this help message")
    println("    -l, --list      List available tasks")
    println("    -n, --dry-run   Show what would run without executing")
    println("    -q, --quiet     Suppress output")
    println("    -f, --file      Specify config file (default: Bakfile)")
    println("")
    println("EXAMPLES:")
    println("    bake build      Run the 'build' task")
    println("    bake -l         List all tasks")
    println("    bake -n test    Dry-run the 'test' task")
    return void
}

pub func print_task_list(config: &types.Config) -> (void) {
    println("Available tasks:")
    println("")
    
    mut var i: int = 0
    while i < config.tasks.len() {
        var task: types.TaskDef = config.tasks[i]
        mut var line: string = "  " + task.name
        
        if task.description.len() > 0 {
            line = line + " - " + task.description
        }
        
        if task.deps.len() > 0 {
            line = line + " [deps: "
            mut var j: int = 0
            while j < task.deps.len() {
                if j > 0 { line = line + ", " }
                line = line + task.deps[j]
                j = j + 1
            }
            line = line + "]"
        }
        
        println(line)
        i = i + 1
    }
    
    println("")
    println("Default task: ", config.default_task)
    return void
}

func starts_with(s: &string, prefix: string) -> (bool) {
    if s.len() < prefix.len() { return false }
    mut var i: int = 0
    while i < prefix.len() {
        if (*s)[i] != prefix[i] { return false }
        i = i + 1
    }
    return true
}
