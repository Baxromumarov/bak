// 5. in comment as you see two dots(..), any kind of checker must skip the comment section

struct data{
    name: string,

}

impl data as d {
    mut func set_name(s: string)-> (void){
        d.name = s
        return void
    }
}

func main() -> (void) {
    mut var d: data

    d.set_name("Ben")
    println(d.name)
    
    mut var arr= Vec.from([1,2,3])
    arr.push(21)
    arr.push(21)
    arr.push(21)
    arr.pop()


    println("ARR: ",arr)
    println("Hello, World!")

    return void
}
