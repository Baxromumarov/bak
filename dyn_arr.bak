package main

pub struct Data {
    pub age:  int64
    pub name: string
    pub fl:   float64
}

impl Data as d {
    pub func divideAge() -> (Result<int64, string>) {
        if d.age == 0 {
            return Err("zero division error")
        }

        return Ok(d.age / 2)
    }
}

pub func halfAge(d: Data) -> (Result<int64, string>) {
    var out: int64 = try d.divideAge()

    return Ok(out)
}

func main() -> (void) {
    var d: Data = Data{
        age:  12,
        fl:   12.0,
        name: "hello",
    }

    switch halfAge(d) {
        case Ok(out) {
            println(
                "half age: ",
                out,
            )
        }
        case Err(err) {
            println(
                "here error: ",
                err,
            )
        }
    }

    return void
}
