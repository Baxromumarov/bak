package main

func sum(a: int, b: int) -> (int) {
    return a + b
}

func main() -> (void) {
    mut var mp: HashMap<string, int> = HashMap.new()

    mp.insert(
        "a",
        1,
    )

    mp.insert(
        "b",
        2,
    )

    println(mp)
    
    println(sum(
        mp.get("a").unwrap(),
        mp.get("b").unwrap(),
    ))

    mp.clear()

    return void
}
