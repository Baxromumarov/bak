package main

struct Data {
    age:  int64
    name: string
    fl:   float64
}

impl Data as d {
    func divide_age() -> (Result<int64, string>) {
        if d.age == 0 {
            return Err("zero division error")
        }

        return Ok(d.age / 2)
    }
}

func main() -> (void) {
    var d: Data = Data{
        age:  12,
        fl:   12.0,
        name: "hello",
    }

    switch d.divide_age() {
        case Ok(out) {
            println("here error: ", out)
        }
        case Err(err) {
            println("here error: ", err)
        }
    }

    return void
}
