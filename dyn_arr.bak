package main

struct Data {
    age:  int64
    name: string
    fl:   float64
}

impl Data as d {
    func divide_age() -> (Result<int64, string>) {
        if d.age == 0 {
            return Err("zero division error")
        }

        return Ok(d.age / 2)
    }
}

func half_age(d: Data) -> (Result<int64, string>) {
    var out: int64 = try d.divide_age()
    
    return Ok(out)
}

func main() -> (void) {
    var d: Data = Data{
        age:  12,
        fl:   12.0,
        name: "hello",
    }

    switch half_age(d) {
        case Ok(out) {
            println("here error: ", out)
        }
        case Err(err) {
            println("here error: ", err)
        }
    }

    return void
}
