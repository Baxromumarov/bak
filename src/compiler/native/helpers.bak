package native

// Utility/helper functions for the native backend.
import "src/compiler/native/x86_64.bak" as x86
import "src/compiler/ast/ast.bak" as ast

// ─────────────────────────────────────────────────────────────────────────────
// Byte Patching
// ─────────────────────────────────────────────────────────────────────────────
pub func patch_u32(mut code: &mut Vec<int, _>, idx: int, v: int) -> (void) {
    code[idx] = v & 0xff
    code[idx + 1] = v >> 8 & 0xff
    code[idx + 2] = v >> 16 & 0xff
    code[idx + 3] = v >> 24 & 0xff

    return
}

pub func patch_u64(mut code: &mut Vec<int, _>, idx: int, v: int) -> (void) {
    code[idx] = v & 0xff
    code[idx + 1] = v >> 8 & 0xff
    code[idx + 2] = v >> 16 & 0xff
    code[idx + 3] = v >> 24 & 0xff
    code[idx + 4] = v >> 32 & 0xff
    code[idx + 5] = v >> 40 & 0xff
    code[idx + 6] = v >> 48 & 0xff
    code[idx + 7] = v >> 56 & 0xff

    return
}

// patch_rel32 computes a rel32 displacement from the end of the imm32 field.
pub func patch_rel32(
    mut code: &mut Vec<int, _>,
    imm_offset: int,
    target: int,
) -> (void) {
    var rel: int = target - (imm_offset + 4)

    patch_u32(
        code,
        imm_offset,
        rel,
    )

    return
}

// ─────────────────────────────────────────────────────────────────────────────
// Jump Placeholders
// ─────────────────────────────────────────────────────────────────────────────
pub func emit_jz_placeholder(code: &mut Vec<int, _>) -> (int) {
    var start: int = code.len()

    x86.emit_jz_rel32(
        code,
        0,
    )

    return start + 2
}

pub func emit_jnz_placeholder(code: &mut Vec<int, _>) -> (int) {
    var start: int = code.len()

    x86.emit_jnz_rel32(
        code,
        0,
    )

    return start + 2
}

pub func emit_jne_placeholder(code: &mut Vec<int, _>) -> (int) {
    var start: int = code.len()

    x86.emit_jne_rel32(
        code,
        0,
    )

    return start + 2
}

pub func emit_jmp_placeholder(code: &mut Vec<int, _>) -> (int) {
    var start: int = code.len()

    x86.emit_jmp_rel32(
        code,
        0,
    )

    return start + 1
}

pub func emit_jmp_to(code: &mut Vec<int, _>, target: int) -> (void) {
    var start: int = code.len()

    x86.emit_jmp_rel32(
        code,
        0,
    )
    patch_rel32(
        code,
        start + 1,
        target,
    )

    return
}

// ─────────────────────────────────────────────────────────────────────────────
// Patch Sites
// ─────────────────────────────────────────────────────────────────────────────
pub func patch_sites(
    code: &mut Vec<int, _>,
    sites: &Vec<int, _>,
    target: int,
) -> (void) {
    for s in *sites {
        patch_rel32(
            code,
            s,
            target,
        )
    }

    return
}

pub func push_end_site(mut sites: &mut Vec<int, _>, site: int) -> (void) {
    sites.push(site)

    return
}

// ─────────────────────────────────────────────────────────────────────────────
// Byte Vector Helpers
// ─────────────────────────────────────────────────────────────────────────────
pub func string_bytes(s: &string) -> (Vec<int, _>) {
    mut var out: Vec<int, _> = Vec.new()
    mut var i: int = 0

    while i < s.len() {
        out.push(int(s[i]))
        i = i + 1
    }

    return out
}

pub func zero_bytes(size: int) -> (Vec<int, _>) {
    mut var out: Vec<int, _> = Vec.new()
    mut var i: int = 0

    while i < size {
        out.push(0)
        i = i + 1
    }

    return out
}

pub func append_u64_vec(mut out: &mut Vec<int, _>, v: int) -> (void) {
    out.push(v & 0xff)
    out.push(v >> 8 & 0xff)
    out.push(v >> 16 & 0xff)
    out.push(v >> 24 & 0xff)
    out.push(v >> 32 & 0xff)
    out.push(v >> 40 & 0xff)
    out.push(v >> 48 & 0xff)
    out.push(v >> 56 & 0xff)

    return
}

pub func append_u32_vec(mut out: &mut Vec<int, _>, v: int) -> (void) {
    out.push(v & 0xff)
    out.push(v >> 8 & 0xff)
    out.push(v >> 16 & 0xff)
    out.push(v >> 24 & 0xff)

    return
}

// ─────────────────────────────────────────────────────────────────────────────
// Alignment
// ─────────────────────────────────────────────────────────────────────────────
pub func align_to(value: int, align: int) -> (int) {
    if align <= 1 {
        return value
    }

    var rem: int = value % align

    if rem == 0 {
        return value
    }

    return value + (align - rem)
}

// ─────────────────────────────────────────────────────────────────────────────
// AST Helpers
// ─────────────────────────────────────────────────────────────────────────────
pub func is_range_expr(expr: &ast.Expression) -> (bool) {
    switch *expr {
        case ast.Expression.Range(_) {
            return true
        }
        default {
        }
    }

    return false
}

pub func extract_range(expr: &ast.Expression) -> (Option<ast.RangeExpression>) {
    switch *expr {
        case ast.Expression.Range(r) {
            return Some(r)
        }
        default {
        }
    }

    return None
}

pub func is_literal_expr(expr: &ast.Expression) -> (bool) {
    switch *expr {
        case ast.Expression.IntegerLiteral(il) {
            return true
        }
        case ast.Expression.BooleanLiteral(bl) {
            return true
        }
        case ast.Expression.CharLiteral(cl) {
            return true
        }
        case ast.Expression.StringLiteral(sl) {
            return true
        }
        default {
        }
    }

    return false
}

pub func assignment_target_name(expr: &ast.Expression) -> (Option<string>) {
    switch *expr {
        case ast.Expression.Identifier(id) {
            return Some(id.Value)
        }
        default {
        }
    }

    return None
}

pub func call_target_name(expr: &ast.Expression) -> (Option<string>) {
    switch *expr {
        case ast.Expression.Identifier(id) {
            return Some(id.Value)
        }
        default {
        }
    }

    return None
}

// ─────────────────────────────────────────────────────────────────────────────
// Vec Element Scale
// ─────────────────────────────────────────────────────────────────────────────
pub func vec_elem_scale(elem_size: int) -> (int) {
    if elem_size == 1 {
        return 0
    }

    if elem_size == 2 {
        return 1
    }

    if elem_size == 4 {
        return 2
    }

    if elem_size == 8 {
        return 3
    }

    // For larger sizes, we use explicit multiplication
    return -1
}

// ─────────────────────────────────────────────────────────────────────────────
// Struct Name Helpers
// ─────────────────────────────────────────────────────────────────────────────
pub func struct_name_suffix(name: &string) -> (string) {
    var idx: Option<int> = name.lastIndexOf(".")

    switch idx {
        case Some(i) {
            return name.substring(
                i + 1,
                name.len(),
            )
        }
        case None {
            return *name
        }
    }
}

pub func find_struct_field(
    decl: &ast.StructDecl,
    field_name: &string,
) -> (Option<ast.StructField>) {
    for f in decl.Fields {
        if f.Name.Value == *field_name {
            return Some(f)
        }
    }

    return None
}

// ─────────────────────────────────────────────────────────────────────────────
// Argument Register Mapping
// ─────────────────────────────────────────────────────────────────────────────
pub func arg_register(index: int) -> (Option<int>) {
    // SysV AMD64 ABI: rdi, rsi, rdx, rcx, r8, r9
    if index == 0 {
        return Some(x86.RDI)
    }

    if index == 1 {
        return Some(x86.RSI)
    }

    if index == 2 {
        return Some(x86.RDX)
    }

    if index == 3 {
        return Some(x86.RCX)
    }

    if index == 4 {
        return Some(x86.R8)
    }

    if index == 5 {
        return Some(x86.R9)
    }

    return None
}

// ─────────────────────────────────────────────────────────────────────────────
// Type Checking Helpers
// ─────────────────────────────────────────────────────────────────────────────
pub func is_supported_return_type(t: ast.TypeExpression) -> (bool) {
    switch t {
        case ast.TypeExpression.Simple(s) {
            if s.Name == "int" {
                return true
            }

            if s.Name == "bool" {
                return true
            }

            if s.Name == "char" {
                return true
            }

            if s.Name == "string" {
                return true
            }

            // Assume struct types are supported
            return true
        }
        case ast.TypeExpression.Generic(g) {
            // Vec, Option, Result
            return true
        }
        case ast.TypeExpression.Void(v) {
            return true
        }
        case ast.TypeExpression.TupleRef(tp) {
            // Support up to 2-element tuples
            return true
        }
        default {
        }
    }

    return false
}

pub func is_supported_param_type(t: ast.TypeExpression) -> (bool) {
    switch t {
        case ast.TypeExpression.Simple(s) {
            if s.Name == "int" {
                return true
            }

            if s.Name == "bool" {
                return true
            }

            if s.Name == "char" {
                return true
            }

            if s.Name == "string" {
                return true
            }

            return true
        }
        case ast.TypeExpression.Generic(g2) {
            return true
        }
        case ast.TypeExpression.BorrowRef(b) {
            return true
        }
        default {
        }
    }

    return false
}
