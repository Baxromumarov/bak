// movzx dst, byte ptr [base+disp32]
pub func emit_movzx_reg_mem_base_disp(
    mut out: &mut Vec<int, _>,
    dst: int,
    base: int,
    disp: int,
) -> (void) {
    out.push(
        rex(
            1,
            needsRex(dst),
            0,
            needsRex(base),
        ),
    )
    out.push(0x0f)
    out.push(0xb6)
    out.push(
        modRM(
            2,
            dst,
            4,
        ),
    )
    // SIB
    out.push(
        sib(
            0,
            4,
            base,
        ),
    )
    // no index
    emit_u32(
        out,
        disp,
    )
}

