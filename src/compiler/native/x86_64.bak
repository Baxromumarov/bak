// mov dst (32-bit), [base+disp32]
pub func emit_mov_reg_mem_base_disp32(
    mut out: &mut Vec<int, _>,
    dst: int,
    base: int,
    disp: int,
) -> (void) {
    out.push(
        rex(
            0,
            needsRex(dst),
            0,
            needsRex(base),
        ),
    )
    out.push(0x8b)
    out.push(
        modRM(
            2,
            dst,
            4,
        ),
    )
    // SIB
    out.push(
        sib(
            0,
            4,
            base,
        ),
    )
    // no index
    emit_u32(
        out,
        disp,
    )
}

// mov dst, [base + index*scale] (disp32=0)
pub func emit_mov_reg_mem_base_index(
    mut out: &mut Vec<int, _>,
    dst: int,
    base: int,
    index: int,
    scale: int,
) -> (void) {
    mut var scale_bits: int = 0

    if scale == 1 {
        scale_bits = 0
    } else if scale == 2 {
        scale_bits = 1
    } else if scale == 4 {
        scale_bits = 2
    } else {
        scale_bits = 3
    }

    // 8
    out.push(
        rex(
            1,
            needsRex(dst),
            needsRex(index),
            needsRex(base),
        ),
    )
    out.push(0x8b)
    out.push(
        modRM(
            2,
            dst,
            4,
        ),
    )
    // SIB
    out.push(
        sib(
            scale_bits,
            index,
            base,
        ),
    )
    emit_u32(
        out,
        0,
    )
}

