    if scale == 1 {
        scale_bits = 0
    } else if scale == 2 {
        scale_bits = 1
    } else if scale == 4 {
        scale_bits = 2
    } else {
        scale_bits = 3
    }

    // 8
    out.push(
        rex(
            0,
            needsRex(dst),
            needsRex(index),
            needsRex(base),
        ),
    )
    out.push(0x8b)
    out.push(
        modRM(
            2,
            dst,
            4,
        ),
    )
    // SIB
    out.push(
        sib(
            scale_bits,
            index,
            base,
        ),
    )
    emit_u32(
        out,
        0,
    )
}

