package native

// x86_64 instruction encoder helpers.
// All functions emit bytes into a Vec<int, _> byte buffer.
// Register encoding constants (SysV x86_64 ABI).
pub const RAX: int = 0
pub const RCX: int = 1
pub const RDX: int = 2
pub const RBX: int = 3
pub const RSP: int = 4
pub const RBP: int = 5
pub const RSI: int = 6
pub const RDI: int = 7
pub const R8: int = 8
pub const R9: int = 9
pub const R10: int = 10
pub const R11: int = 11
pub const R12: int = 12
pub const R13: int = 13
pub const R14: int = 14
pub const R15: int = 15

// --- REX prefix helpers ---
// rex computes a REX prefix byte. w=1 for 64-bit operand size.
// r=1 if ModRM reg field encodes r8-r15, b=1 if ModRM r/m or opcode reg encodes r8-r15.
func rex(w: int, r: int, x: int, b: int) -> (int) {
    return 0x40 | w << 3 | r << 2 | x << 1 | b
}

// needsRex returns 1 if the register number is >= 8, else 0.
func needsRex(reg: int) -> (int) {
    if reg >= 8 {
        return 1
    }

    return 0
}

// modRM builds a ModRM byte. mod is 2 bits, reg is 3 bits, rm is 3 bits.
func modRM(mod: int, reg: int, rm: int) -> (int) {
    return (mod & 3) << 6 | (reg & 7) << 3 | rm & 7
}

// sib builds a SIB byte. scale is 2 bits, index is 3 bits, base is 3 bits.
func sib(scale: int, index: int, base: int) -> (int) {
    return (scale & 3) << 6 | (index & 7) << 3 | base & 7
}

// --- Data emission helpers ---
pub func emit_u8(mut out: &mut Vec<int, _>, v: int) -> (void) {
    out.push(v & 0xff)
}

pub func emit_u32(mut out: &mut Vec<int, _>, v: int) -> (void) {
    out.push(v & 0xff)
    out.push(v >> 8 & 0xff)
    out.push(v >> 16 & 0xff)
    out.push(v >> 24 & 0xff)
}

pub func emit_u64(mut out: &mut Vec<int, _>, v: int) -> (void) {
    out.push(v & 0xff)
    out.push(v >> 8 & 0xff)
    out.push(v >> 16 & 0xff)
    out.push(v >> 24 & 0xff)
    out.push(v >> 32 & 0xff)
    out.push(v >> 40 & 0xff)
    out.push(v >> 48 & 0xff)
    out.push(v >> 56 & 0xff)
}

// --- Move instructions ---
// mov reg, imm32 (sign-extended to 64-bit).
pub func emit_mov_reg_imm32(
    mut out: &mut Vec<int, _>,
    reg: int,
    imm: int,
) -> (void) {
    out.push(
        rex(
            1,
            0,
            0,
            needsRex(reg),
        ),
    )
    out.push(0xc7)
    out.push(
        modRM(
            3,
            0,
            reg,
        ),
    )
    emit_u32(
        out,
        imm,
    )
}

// mov rax, imm32 (convenience wrapper).
pub func emit_mov_rax_imm32(mut out: &mut Vec<int, _>, imm: int) -> (void) {
    emit_mov_reg_imm32(
        out,
        RAX,
        imm,
    )
}

// mov rdi, imm32 (convenience wrapper).
pub func emit_mov_rdi_imm32(mut out: &mut Vec<int, _>, imm: int) -> (void) {
    emit_mov_reg_imm32(
        out,
        RDI,
        imm,
    )
}

// mov rsi, imm32 (convenience wrapper).
pub func emit_mov_rsi_imm32(mut out: &mut Vec<int, _>, imm: int) -> (void) {
    emit_mov_reg_imm32(
        out,
        RSI,
        imm,
    )
}

// mov rdi, rax.
pub func emit_mov_rdi_rax(mut out: &mut Vec<int, _>) -> (void) {
    emit_mov_reg_reg(
        out,
        RDI,
        RAX,
    )
}

// movabs reg, imm64 (full 64-bit immediate).
pub func emit_mov_reg_imm64(
    mut out: &mut Vec<int, _>,
    reg: int,
    imm: int,
) -> (void) {
    out.push(
        rex(
            1,
            0,
            0,
            needsRex(reg),
        ),
    )
    out.push(0xb8 + (reg & 7))
    emit_u64(
        out,
        imm,
    )
}

// mov dst, src (register to register, 64-bit).
pub func emit_mov_reg_reg(
    mut out: &mut Vec<int, _>,
    dst: int,
    src: int,
) -> (void) {
    out.push(
        rex(
            1,
            needsRex(src),
            0,
            needsRex(dst),
        ),
    )
    out.push(0x89)
    out.push(
        modRM(
            3,
            src,
            dst,
        ),
    )
}

// mov [rbp+offset], src (store register to stack).
// offset is a signed value (negative for locals).
pub func emit_mov_mem_rbp_reg(
    mut out: &mut Vec<int, _>,
    offset: int,
    src: int,
) -> (void) {
    out.push(
        rex(
            1,
            needsRex(src),
            0,
            0,
        ),
    )
    out.push(0x89)

    if offset >= -128 && offset <= 127 {
        out.push(
            modRM(
                1,
                src,
                RBP,
            ),
        )
        emit_u8(
            out,
            offset & 0xff,
        )
    } else {
        out.push(
            modRM(
                2,
                src,
                RBP,
            ),
        )
        emit_u32(
            out,
            offset,
        )
    }
}

// mov dst, [base+disp32]
pub func emit_mov_reg_mem_base_disp(
    mut out: &mut Vec<int, _>,
    dst: int,
    base: int,
    disp: int,
) -> (void) {
    out.push(
        rex(
            1,
            needsRex(dst),
            0,
            needsRex(base),
        ),
    )
    out.push(0x8b)
    out.push(
        modRM(
            2,
            dst,
            4,
        ),
    )
    // SIB
    out.push(
        sib(
            0,
            4,
            base,
        ),
    )
    // no index
    emit_u32(
        out,
        disp,
    )
}

// mov [base+disp32], src (64-bit store)
pub func emit_mov_mem_base_disp_reg(
    mut out: &mut Vec<int, _>,
    base: int,
    disp: int,
    src: int,
) -> (void) {
    out.push(
        rex(
            1,
            needsRex(src),
            0,
            needsRex(base),
        ),
    )
    out.push(0x89)
    out.push(
        modRM(
            2,
            src,
            4,
        ),
    )
    // SIB
    out.push(
        sib(
            0,
            4,
            base,
        ),
    )
    // no index
    emit_u32(
        out,
        disp,
    )
}

// mov [base+disp32], src (32-bit store)
pub func emit_mov_mem_base_disp_reg32(
    mut out: &mut Vec<int, _>,
    base: int,
    disp: int,
    src: int,
) -> (void) {
    out.push(
        rex(
            0,
            needsRex(src),
            0,
            needsRex(base),
        ),
    )
    out.push(0x89)
    out.push(
        modRM(
            2,
            src,
            4,
        ),
    )
    // SIB
    out.push(
        sib(
            0,
            4,
            base,
        ),
    )
    // no index
    emit_u32(
        out,
        disp,
    )
}

// mov [base+disp32], src (8-bit store)
pub func emit_mov_mem_base_disp_reg8(
    mut out: &mut Vec<int, _>,
    base: int,
    disp: int,
    src: int,
) -> (void) {
    out.push(
        rex(
            0,
            needsRex(src),
            0,
            needsRex(base),
        ),
    )
    out.push(0x88)
    out.push(
        modRM(
            2,
            src,
            4,
        ),
    )
    // SIB
    out.push(
        sib(
            0,
            4,
            base,
        ),
    )
    // no index
    emit_u32(
        out,
