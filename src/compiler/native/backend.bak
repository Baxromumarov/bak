) -> (void) {
    if state.scopes.len() == 0 {
        return
    }

    (state.scopes[state.scopes.len() - 1]).structs.push(
        StructBinding{
            name:        name,
            struct_name: struct_name,
        },
    )

    return
}

func resolve_iterable_binding(
    state: &mut BackendEmitState,
    name: &string,
) -> (Option<int>) {
    if state.scopes.len() == 0 {
        return None
    }

    mut var i: int = state.scopes.len() - 1

    while i >= 0 {
        mut var j: int = 0
        var n: int = (state.scopes[i]).iterables.len()

        while j < n {
            if str_eq(
                &((state.scopes[i]).iterables[j]).name,
                name,
            ) {
                return Some(((state.scopes[i]).iterables[j]).elem_size)
            }

            j = j + 1
        }

        if i == 0 {
            break
        }

        i = i - 1
    }

    return None
}

