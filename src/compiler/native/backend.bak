                x86.RAX,
                x86.RAX,
                0,
            )
            x86.emit_mov_reg_imm32(
                code,
                x86.RCX,
                1000000000,
            )
            x86.emit_cqo(code)
            x86.emit_idiv_reg(
                code,
                x86.RCX,
            )

            return Ok(void)
        }

        if mc.Method.Value == "add" {
            if mc.Arguments.len() != 1 {
                return Err(ERR_NATIVE_BAD_ARGS)
            }

            var res: Result<void, string> = emit_expr(
                &mc.Object,
                state,
                code,
            )

            switch res {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            x86.emit_mov_reg_mem_base_disp(
                code,
                x86.R8,
                x86.RAX,
                0,
            )
            x86.emit_push_reg(
                code,
                x86.R8,
            )
            x86.emit_sub_rsp_imm8(
                code,
                8,
            )

            var resOther: Result<void, string> = emit_expr(
                &mc.Arguments[0],
                state,
                code,
            )

            switch resOther {
