                &id.Value,
            )

            switch ebOpt {
                case Some(eb) {
                    return eb.enum_kind == ENUM_KIND_RESULT
                }
                case None {
                }
            }

            var infoOpt: Option<IterableInfo> = iterable_info_from_binding(
                state,
                &id.Value,
            )

            switch infoOpt {
                case Some(info) {
                    return info.container_kind == CONTAINER_KIND_RESULT
                }
                case None {
                }
            }
        }
        case ast.Expression.MutableIdentifier(id) {
            var ebOpt: Option<EnumBinding> = resolve_enum_binding(
                state,
                &id.Value,
            )

            switch ebOpt {
                case Some(eb) {
                    return eb.enum_kind == ENUM_KIND_RESULT
                }
                case None {
                }
            }

            var infoOpt: Option<IterableInfo> = iterable_info_from_binding(
                state,
                &id.Value,
            )

            switch infoOpt {
                case Some(info) {
                    return info.container_kind == CONTAINER_KIND_RESULT
                }
                case None {
                }
            }
        }
        default {
        }
    }

    return false
}

func enum_variant_tag_from_name(
    name: &string,
    state: &mut BackendEmitState,
) -> (Option<int>) {
    if *name == "None" {
        return Some(0)
    }

    var enumOpt: Option<ast.EnumDecl> = find_enum_by_variant(
        &state.enums,
        name,
    )

    switch enumOpt {
        case Some(decl) {
            var tagVal: int = find_variant_index(
                &decl,
                name,
            )

            if tagVal >= 0 {
                return Some(tagVal)
            }
        }
        case None {
        }
    }

    return None
}

func enum_variant_tag_from_expr(
    expr: &ast.Expression,
    state: &mut BackendEmitState,
) -> (Option<int>) {
    switch *expr {
        case ast.Expression.Identifier(id) {
            return enum_variant_tag_from_name(
                &id.Value,
                state,
            )
        }
        case ast.Expression.MutableIdentifier(id) {
            return enum_variant_tag_from_name(
                &id.Value,
                state,
            )
        }
        case ast.Expression.FieldAccess(fe) {
            return enum_variant_tag_from_name(
                &fe.Field.Value,
                state,
            )
        }
        default {
        }
    }

    return None
}

func is_known_enum_type_name(
    type_name: &string,
    state: &mut BackendEmitState,
) -> (bool) {
    var suffix: string = struct_name_suffix(type_name)

    if suffix == "Option" || suffix == "Result" {
        return true
    }

    mut var ei: int = 0

    while ei < state.enums.len() {
        var decl: &ast.EnumDecl = &state.enums[ei]
        var decl_name: string = decl.Name.Value
        var decl_suffix: string = struct_name_suffix(&decl_name)

        if decl_name == suffix || decl_suffix == suffix {
            return true
        }

        if decl_name == *type_name || decl_suffix == *type_name {
            return true
        }

        ei = ei + 1
    }

    return false
}

func is_enum_expr(
    expr: &ast.Expression,
    state: &mut BackendEmitState,
) -> (bool) {
    switch *expr {
        case ast.Expression.Identifier(id) {
            var ebOpt: Option<EnumBinding> = resolve_enum_binding(
                state,
                &id.Value,
            )

            switch ebOpt {
                case Some(_) {
                    return true
                }
                case None {
                }
            }

            switch enum_variant_tag_from_name(
                &id.Value,
                state,
            ) {
                case Some(_) {
                    return true
                }
                case None {
                }
            }

            switch resolve_local_type(
                state,
                &id.Value,
            ) {
                case Some(typeName) {
                    if is_known_enum_type_name(
                        &typeName,
                        state,
                    ) {
                        return true
                    }
                }
                case None {
                }
            }
        }
        case ast.Expression.MutableIdentifier(id) {
            var ebOpt: Option<EnumBinding> = resolve_enum_binding(
                state,
                &id.Value,
            )

            switch ebOpt {
                case Some(_) {
                    return true
                }
                case None {
                }
            }

            switch enum_variant_tag_from_name(
                &id.Value,
                state,
            ) {
                case Some(_) {
                    return true
                }
                case None {
                }
            }

            switch resolve_local_type(
                state,
                &id.Value,
            ) {
                case Some(typeName) {
                    if is_known_enum_type_name(
                        &typeName,
                        state,
                    ) {
                        return true
                    }
                }
                case None {
                }
            }
        }
        case ast.Expression.FieldAccess(fe) {
            switch enum_variant_tag_from_name(
                &fe.Field.Value,
                state,
            ) {
                case Some(_) {
                    return true
                }
                case None {
                }
            }

            switch struct_literal_name(
                &fe.Object,
                state,
            ) {
                case Some(struct_name) {
                    switch find_struct_decl(
                        &state.structs,
                        &struct_name,
                    ) {
                        case Some(decl) {
                            switch find_struct_field(
                                &decl,
                                &fe.Field.Value,
                            ) {
                                case Some(field_decl) {
                                    switch field_decl.Type {
                                        case ast.TypeExpression.Simple(st) {
                                            if is_known_enum_type_name(
                                                &st.Name,
                                                state,
                                            ) {
                                                return true
                                            }
                                        }
                                        case ast.TypeExpression.BorrowRef(bt) {
                                            switch bt.Inner {
                                                case ast.TypeExpression.Simple(st2) {
                                                    if is_known_enum_type_name(
                                                        &st2.Name,
                                                        state,
                                                    ) {
                                                        return true
                                                    }
                                                }
                                                default {
                                                }
                                            }
                                        }
                                        default {
                                        }
                                    }
                                }
                                case None {
                                }
                            }
                        }
                        case None {
                        }
                    }
                }
                case None {
                }
            }
        }
        default {
        }
    }

    return false
}

func is_enum_like_expr(
    expr: &ast.Expression,
    state: &mut BackendEmitState,
) -> (bool) {
    if is_enum_expr(
        expr,
        state,
    ) {
        return true
    }

    switch enum_variant_tag_from_expr(
        expr,
        state,
    ) {
        case Some(_) {
            return true
        }
        case None {
        }
    }

    return false
}

func emit_enum_tag_expr(
    expr: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    switch enum_variant_tag_from_expr(
        expr,
        state,
    ) {
        case Some(tagVal) {
            x86.emit_mov_rax_imm32(
                code,
                tagVal,
            )

            return Ok(void)
        }
        case None {
        }
    }

    var exprRes: Result<void, string> = emit_expr(
        expr,
        state,
        code,
    )

    switch exprRes {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    if is_enum_expr(
        expr,
        state,
    ) {
        x86.emit_mov_reg_mem_base_disp(
            code,
            x86.RAX,
            x86.RAX,
            0,
        )
    }

    return Ok(void)
}

func emit_enum_equals(
    left: &ast.Expression,
    right: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
    negate: bool,
) -> (Result<void, string>) {
    var leftRes: Result<void, string> = emit_enum_tag_expr(
        left,
        state,
        code,
    )

    switch leftRes {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_push_reg(
        code,
        x86.RAX,
    )

    var rightRes: Result<void, string> = emit_enum_tag_expr(
        right,
        state,
        code,
    )

    switch rightRes {
        case Err(msg2) {
            return Err(msg2)
        }
        case Ok(_) {
        }
    }

    x86.emit_pop_reg(
        code,
        x86.RCX,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.RCX,
        x86.RAX,
    )

    if negate {
        x86.emit_setne(code)
    } else {
        x86.emit_sete(code)
    }

    x86.emit_movzx_rax_al(code)

    return Ok(void)
}

func emit_builtin_println(
    ce: &ast.CallExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // debug trace removed
    if ce.Arguments.len() == 0 {
        x86.emit_mov_reg_imm32(
            code,
            x86.RAX,
            0x0a,
        )
        x86.emit_push_reg(
            code,
            x86.RAX,
        )
        x86.emit_mov_reg_reg(
            code,
            x86.RSI,
            x86.RSP,
        )
        // buf = rsp
        x86.emit_mov_reg_imm32(
            code,
            x86.RDX,
            1,
        )
        // len = 1
        x86.emit_mov_rdi_imm32(
            code,
            1,
        )
        // fd = stdout
        x86.emit_mov_rax_imm32(
            code,
            1,
        )
        // syscall write
        emit_raw_syscall(code)
        x86.emit_pop_reg(
            code,
            x86.RAX,
        )

        // clean stack
        return Ok(void)
    }

    if ce.Arguments.len() == 1 {
        // debug trace removed
        var res: Result<void, string> = emit_expr(
            &ce.Arguments[0],
            state,
            code,
        )

        // debug trace removed
        switch res {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        mut var print_target: string = "__rt_print_int"

        if is_string_expr(
            &ce.Arguments[0],
            state,
        ) {
            print_target = "__rt_print_str"
        } else if is_float_expr(
            &ce.Arguments[0],
            state,
        ) {
            emit_unscale_rax_float_to_int(code)
        }

        // debug trace removed
        x86.emit_mov_reg_reg(
            code,
            x86.RDI,
            x86.RAX,
        )

        var call_site: int = code.len()

        x86.emit_call_rel32(
            code,
            0,
        )
        add_call_patch(
            state,
            call_site + 1,
            print_target,
        )
        // Now print newline
        x86.emit_mov_reg_imm32(
            code,
            x86.RAX,
            0x0a,
        )
        x86.emit_push_reg(
            code,
            x86.RAX,
        )
        x86.emit_mov_reg_reg(
            code,
            x86.RSI,
            x86.RSP,
        )
        x86.emit_mov_reg_imm32(
            code,
            x86.RDX,
            1,
        )
        x86.emit_mov_rdi_imm32(
            code,
            1,
        )
        x86.emit_mov_rax_imm32(
            code,
            1,
        )
        emit_raw_syscall(code)
        x86.emit_pop_reg(
            code,
            x86.RAX,
        )

        return Ok(void)
    }

    // println with multiple args: print each separated by space, then newline
    mut var i: int = 0

    // debug trace removed
    while i < ce.Arguments.len() {
        // debug trace removed
        if i > 0 {
            // Write a space between arguments
            x86.emit_mov_reg_imm32(
                code,
                x86.RAX,
                0x20,
            )
            x86.emit_push_reg(
                code,
                x86.RAX,
            )
            x86.emit_mov_reg_reg(
                code,
                x86.RSI,
                x86.RSP,
            )
            x86.emit_mov_reg_imm32(
                code,
                x86.RDX,
                1,
            )
            x86.emit_mov_rdi_imm32(
                code,
                1,
            )
            x86.emit_mov_rax_imm32(
                code,
                1,
            )
            emit_raw_syscall(code)
            x86.emit_pop_reg(
                code,
                x86.RAX,
            )
        }

        var res: Result<void, string> = emit_expr(
            &ce.Arguments[i],
            state,
            code,
        )

        // debug trace removed
        switch res {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        mut var multi_target: string = "__rt_print_int"

        if is_string_expr(
            &ce.Arguments[i],
            state,
        ) {
            multi_target = "__rt_print_str"
        } else if is_float_expr(
            &ce.Arguments[i],
            state,
        ) {
            emit_unscale_rax_float_to_int(code)
        }

        // debug trace removed
        x86.emit_mov_reg_reg(
            code,
            x86.RDI,
            x86.RAX,
        )

        var call_site: int = code.len()

        x86.emit_call_rel32(
            code,
            0,
        )
        add_call_patch(
            state,
            call_site + 1,
            multi_target,
        )
        i = i + 1
    }

    // debug trace removed
    // Write trailing newline
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        0x0a,
    )
    x86.emit_push_reg(
        code,
        x86.RAX,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RSI,
        x86.RSP,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDX,
        1,
    )
    x86.emit_mov_rdi_imm32(
        code,
        1,
    )
    x86.emit_mov_rax_imm32(
        code,
        1,
    )
    emit_raw_syscall(code)
    x86.emit_pop_reg(
        code,
        x86.RAX,
    )

    return Ok(void)
}

func emit_builtin_print(
    ce: &ast.CallExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    mut var i: int = 0

    while i < ce.Arguments.len() {
        if i > 0 {
            // Write a space between arguments
            x86.emit_mov_reg_imm32(
                code,
                x86.RAX,
                0x20,
            )
            x86.emit_push_reg(
                code,
                x86.RAX,
            )
            x86.emit_mov_reg_reg(
                code,
                x86.RSI,
                x86.RSP,
            )
            x86.emit_mov_reg_imm32(
                code,
                x86.RDX,
                1,
            )
            x86.emit_mov_rdi_imm32(
                code,
                1,
            )
            x86.emit_mov_rax_imm32(
                code,
                1,
            )
            emit_raw_syscall(code)
            x86.emit_pop_reg(
                code,
                x86.RAX,
            )
        }

        var res: Result<void, string> = emit_expr(
            &ce.Arguments[i],
            state,
            code,
        )

        switch res {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        mut var print_target: string = "__rt_print_int"

        if is_string_expr(
            &ce.Arguments[i],
            state,
        ) {
            print_target = "__rt_print_str"
        } else if is_float_expr(
            &ce.Arguments[i],
            state,
        ) {
            emit_unscale_rax_float_to_int(code)
        }

        x86.emit_mov_reg_reg(
            code,
            x86.RDI,
            x86.RAX,
        )

        var call_site: int = code.len()

        x86.emit_call_rel32(
            code,
            0,
        )
        add_call_patch(
            state,
            call_site + 1,
            print_target,
        )
        i = i + 1
    }

    return Ok(void)
}

func emit_short_circuit_and(
    ie: &ast.InfixExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // Evaluate left; if false (0), skip right and result is 0.
    var resL: Result<void, string> = emit_expr(
        &ie.Left,
        state,
        code,
    )

    switch resL {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_imm: int = emit_jz_placeholder(code)
    // Left was truthy, evaluate right.
    var resR: Result<void, string> = emit_expr(
        &ie.Right,
        state,
        code,
    )

    switch resR {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    // Normalize to 0/1.
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )
    x86.emit_setne(code)
    x86.emit_movzx_rax_al(code)

    var jmp_imm: int = emit_jmp_placeholder(code)

    // Left was falsy: result = 0.
    patch_rel32(
        code,
        jz_imm,
        code.len(),
    )
    x86.emit_mov_rax_imm32(
        code,
        0,
    )
    patch_rel32(
        code,
        jmp_imm,
        code.len(),
    )

    return Ok(void)
}

func emit_short_circuit_or(
    ie: &ast.InfixExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // Evaluate left; if true (nonzero), skip right and result is 1.
    var resL: Result<void, string> = emit_expr(
        &ie.Left,
        state,
        code,
    )

    switch resL {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_imm: int = emit_jnz_placeholder(code)
    // Left was falsy, evaluate right.
    var resR: Result<void, string> = emit_expr(
        &ie.Right,
        state,
        code,
    )

    switch resR {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    // Normalize to 0/1.
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )
    x86.emit_setne(code)
    x86.emit_movzx_rax_al(code)

    var jmp_imm: int = emit_jmp_placeholder(code)

    // Left was truthy: result = 1.
    patch_rel32(
        code,
        jnz_imm,
        code.len(),
    )
    x86.emit_mov_rax_imm32(
        code,
        1,
    )
    patch_rel32(
        code,
        jmp_imm,
        code.len(),
    )

    return Ok(void)
}

func emit_jnz_placeholder(mut code: &mut Vec<int, _>) -> (int) {
    var start: int = code.len()

    x86.emit_jnz_rel32(
        code,
        0,
    )

    return start + 2
}

func emit_int_literal(
    v: int,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    if v >= -2147483648 && v <= 2147483647 {
        x86.emit_mov_rax_imm32(
            code,
            v,
        )

        return Ok(void)
    }

    x86.emit_mov_reg_imm64(
        code,
        x86.RAX,
        v,
    )

    return Ok(void)
}

func emit_char_literal(
    v: char,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    return emit_int_literal(
        int(v),
        code,
    )
}

func int_le_byte(value: int, byte_index: int) -> (int) {
    mut var v: int = value
    mut var i: int = 0

    while i < byte_index {
        v = v / 256
        i = i + 1
    }

    return v & 0xff
}

func should_cache_short_literal(value: &string) -> (bool) {
    if value.len() == 0 || value.len() > 96 {
        return false
    }

    if bootstrap_literal_looks_like_path(value) {
        return false
    }

    return true
}

func emit_string_literal(
    value: &string,
    mut state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    mut var litValue: string = *value

    if state.bootstrap_mode && should_compact_bootstrap_literal(value) {
        litValue = compact_bootstrap_literal(value)
    }

    if state.bootstrap_mode {
        var cached_header_idx: int = bootstrap_cached_string_header(
            state,
            &litValue,
        )

        if cached_header_idx >= 0 {
            emit_data_addr(
                state,
                code,
                cached_header_idx,
            )

            return Ok(void)
        }
    }

    var cacheable_literal: bool = should_cache_short_literal(&litValue)

    if cacheable_literal {
        switch find_string_header_in_cache(
            &state.string_literal_cache,
            &litValue,
            &state.data_items,
        ) {
            case Some(cached_header_idx2) {
                emit_data_addr(
                    state,
                    code,
                    cached_header_idx2,
                )

                return Ok(void)
            }
            case None {
            }
        }
    }

    var data_len: int = litValue.len()
    var data_idx: int = add_data_item(
        state,
        string_bytes(&litValue),
        1,
    )
    var header_idx: int = add_data_item(
        state,
        zero_bytes(16),
        8,
    )
    mut var header_item: &mut DataItem = &mut state.data_items[header_idx]

    patch_u64(
        &mut header_item.bytes,
        8,
        data_len,
    )
    state.data_patches.push(header_idx)
    state.data_patches.push(0)
    // Using `header_idx - 1` avoids relying on local `data_idx` surviving across
    // later local allocations (some stages have overlapping local slots).
    state.data_patches.push(header_idx - 1)

    if state.bootstrap_mode {
        set_bootstrap_cached_string_header(
            state,
            &litValue,
            header_idx,
        )
    }

    if cacheable_literal && state.string_literal_cache.len() < 2048 {
        state.string_literal_cache.push(
            StringHeaderCacheEntry{
                data_idx:   data_idx,
                header_idx: header_idx,
                value_hash: string_literal_hash(&litValue),
                value_len:  litValue.len(),
            },
        )
    }

    emit_data_addr(
        state,
        code,
        header_idx,
    )

    return Ok(void)
}

func compact_bootstrap_literal(value: &string) -> (string) {
    if is_native_error_literal(value) {
        return "native: error"
    }

    if is_line_error_literal(value) {
        return "line error"
    }

    if bootstrap_literal_has_space(value) && !bootstrap_literal_looks_like_path(value) {
        return "msg"
    }

    if value.len() >= 48 {
        return "msg"
    }

    return "error"
}

func should_compact_bootstrap_literal(value: &string) -> (bool) {
    if value.len() < 16 {
        return false
    }

    if value.len() >= 48 {
        return true
    }

    if bootstrap_literal_has_space(value) && !bootstrap_literal_looks_like_path(value) {
        return true
    }

    if is_native_error_literal(value) {
        return true
    }

    if is_line_error_literal(value) {
        return true
    }

    return is_error_literal(value)
}

func bootstrap_literal_has_space(value: &string) -> (bool) {
    mut var i: int = 0

    while i < value.len() {
        if (*value)[i] == ' ' {
            return true
        }

        i = i + 1
    }

    return false
}

func bootstrap_literal_looks_like_path(value: &string) -> (bool) {
    var slash: string = "/"
    var srcPrefix: string = "src/"
    var stdPrefix: string = "std/"
    var bakExt: string = ".bak"

    return contains_substring(
        value,
        &slash,
    ) || contains_substring(
        value,
        &srcPrefix,
    ) || contains_substring(
        value,
        &stdPrefix,
    ) || contains_substring(
        value,
        &bakExt,
    )
}

func is_native_error_literal(value: &string) -> (bool) {
    return value.len() >= 8 && (*value)[0] == 'n' && (*value)[1] == 'a' && (*value)[2] == 't' && (*value)[3] == 'i' && (*value)[4] == 'v' && (*value)[5] == 'e' && (*value)[6] == ':' && (*value)[7] == ' '
}

func is_line_error_literal(value: &string) -> (bool) {
    return value.len() >= 5 && (*value)[0] == 'l' && (*value)[1] == 'i' && (*value)[2] == 'n' && (*value)[3] == 'e' && (*value)[4] == ' '
}

func is_error_literal(value: &string) -> (bool) {
    return value.len() >= 6 && (*value)[0] == 'e' && (*value)[1] == 'r' && (*value)[2] == 'r' && (*value)[3] == 'o' && (*value)[4] == 'r' && (*value)[5] == ' '
}

func string_literal_hash(value: &string) -> (int) {
    mut var h: int = 216613626
    mut var i: int = 0

    while i < value.len() {
        h = h * 16777619 ^ int((*value)[i])
        i = i + 1
    }

    if h < 0 {
        h = -h
    }

    return h
}

func string_matches_data_item(value: &string, item: &DataItem) -> (bool) {
    if value.len() != item.bytes.len() {
        return false
    }

    mut var i: int = 0

    while i < value.len() {
        if int((*value)[i]) != item.bytes[i] {
            return false
        }

        i = i + 1
    }

    return true
}

func find_string_header_in_cache(
    cache: &Vec<StringHeaderCacheEntry, _>,
    value: &string,
    data_items: &Vec<DataItem, _>,
) -> (Option<int>) {
    var wanted_hash: int = string_literal_hash(value)
    var wanted_len: int = value.len()
    mut var i: int = 0

    while i < cache.len() {
        var ent: &StringHeaderCacheEntry = &(*cache)[i]

        if ent.value_hash == wanted_hash && ent.value_len == wanted_len && ent.data_idx >= 0 && ent.data_idx < data_items.len() {
            if string_matches_data_item(
                value,
                &(*data_items)[ent.data_idx],
            ) {
                return Some(ent.header_idx)
            }
        }

        i = i + 1
    }

    return None
}

func bootstrap_cached_string_header(
    state: &mut BackendEmitState,
    value: &string,
) -> (int) {
    if *value == "msg" {
        return state.bootstrap_msg_header
    }

    if *value == "error" {
        return state.bootstrap_error_header
    }

    if *value == "native: error" {
        return state.bootstrap_native_header
    }

    if *value == "line error" {
        return state.bootstrap_line_header
    }

    return -1
}

func set_bootstrap_cached_string_header(
    mut state: &mut BackendEmitState,
    value: &string,
    header_idx: int,
) -> (void) {
    if *value == "msg" {
        state.bootstrap_msg_header = header_idx

        return
    }

    if *value == "error" {
        state.bootstrap_error_header = header_idx

        return
    }

    if *value == "native: error" {
        state.bootstrap_native_header = header_idx

        return
    }

    if *value == "line error" {
        state.bootstrap_line_header = header_idx

        return
    }

    return
}

func emit_vec_literal(
    elems: &Vec<ast.Expression, _>,
    mut state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var vecRes: Result<VecDataInfo, string> = emit_vec_data(
        elems,
        state,
    )

    switch vecRes {
        case Err(msg) {
            if msg == ERR_NATIVE_UNSUPPORTED || msg == "native: vec literal element type not supported" {
                // Bootstrap fallback for runtime-only vec literals (e.g. [dynamicArg]).
                return emit_vec_new(
                    state,
                    code,
                )
            }

            return Err(msg)
        }
        case Ok(info) {
            var data_idx: int = info.data_index
            var elem_len: int = info.length
            var header_idx: int = add_data_item(
                state,
                zero_bytes(24),
                8,
            )
            mut var header_item: &mut DataItem = &mut state.data_items[header_idx]

            patch_u64(
                &mut header_item.bytes,
                8,
                elem_len,
            )
            patch_u64(
                &mut header_item.bytes,
                16,
                elem_len,
            )
            state.data_patches.push(header_idx)
            state.data_patches.push(0)
            state.data_patches.push(data_idx)
            emit_data_addr(
                state,
                code,
                header_idx,
            )

            return Ok(void)
        }
    }
}

// Check if expression is a compile-time literal (can be placed in data section)
func is_literal_expr(expr: &ast.Expression) -> (bool) {
    switch *expr {
        case ast.Expression.IntegerLiteral(_) {
            return true
        }
        case ast.Expression.BooleanLiteral(_) {
            return true
        }
        case ast.Expression.CharLiteral(_) {
            return true
        }
        case ast.Expression.StringLiteral(_) {
            return true
        }
        case ast.Expression.VecLiteral(vl) {
            for e in vl.Elements {
                if !is_literal_expr(&e) {
                    return false
                }
            }

            return true
        }
        case ast.Expression.StructLiteral(sl) {
            for fv in sl.Fields {
                if !is_literal_expr(&fv.Value) {
                    return false
                }
            }

            return true
        }
        default {
            return false
        }
    }
}

// Check if struct literal has any runtime (non-literal) field values
func struct_literal_has_runtime_fields(sl: &ast.StructLiteral) -> (bool) {
    for fv in sl.Fields {
        if !is_literal_expr(&fv.Value) {
            return true
        }
    }

    return false
}

func emit_struct_literal(
    sl: &ast.StructLiteral,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    mut var declOpt: Option<ast.StructDecl> = find_struct_decl_for_pkg(
        &state.structs,
        &sl.Name.Value,
        &state.current_pkg,
    )

    if declOpt.is_none() && sl.Name.Value.len() == 0 {
        declOpt = find_struct_decl_by_literal_fields(
            &state.structs,
            sl,
        )
    }

    switch declOpt {
        case None {
            return Err("native: unknown struct " + sl.Name.Value + " [struct_literal]")
        }
        case Some(decl) {
            var layoutRes: Result<layout.StructLayout, string> = layout.struct_layout(
                &decl,
                &state.structs,
            )

            switch layoutRes {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(st_layout) {
                    if st_layout.size <= 0 {
                        return Err("native: struct layout size invalid")
                    }

                    // Heap-allocate struct literal via __rt_alloc (matches Go backend).
                    // Each execution gets a fresh allocation, preventing stale-pointer
                    // bugs when struct literals appear inside loops.
                    mut var alloc_size: int = st_layout.size

                    if alloc_size < 8 {
                        alloc_size = 8
                    }

                    x86.emit_mov_reg_imm32(
                        code,
                        x86.RDI,
                        alloc_size,
                    )

                    var alloc_call: int = code.len()

                    x86.emit_call_rel32(
                        code,
                        0,
                    )
                    add_call_patch(
                        state,
                        alloc_call + 1,
                        "__rt_alloc",
                    )
                    // RAX = pointer to freshly-allocated struct
                    // Zero-initialize the allocated memory
                    x86.emit_push_reg(
                        code,
                        x86.RAX,
                    )
                    x86.emit_xor_reg_reg(
                        code,
                        x86.RDX,
                        x86.RDX,
                    )

                    mut var zi: int = 0

                    while zi < alloc_size {
                        x86.emit_mov_mem_base_disp_reg(
                            code,
                            x86.RAX,
                            zi,
                            x86.RDX,
                        )
                        zi = zi + 8
                    }

                    // Write field values
                    for fv in sl.Fields {
                        var flOpt: Option<layout.FieldLayout> = find_field_layout(
                            &st_layout,
                            &fv.Name.Value,
                        )

                        switch flOpt {
                            case None {
                                return Err("native: layout missing field " + fv.Name.Value)
                            }
                            case Some(fl) {
                                var exprRes: Result<void, string> = emit_expr(
                                    &fv.Value,
                                    state,
                                    code,
                                )

                                switch exprRes {
                                    case Err(msg) {
                                        return Err(msg)
                                    }
                                    case Ok(_) {
                                    }
                                }

                                // Load struct base from stack into R8
                                x86.emit_mov_reg_mem_base_disp(
                                    code,
                                    x86.R8,
                                    x86.RSP,
                                    0,
                                )
                                // Store field value (RAX) at [R8 + offset]
                                x86.emit_mov_mem_base_disp_reg(
                                    code,
                                    x86.R8,
                                    fl.offset,
                                    x86.RAX,
                                )
                            }
                        }
                    }

                    x86.emit_pop_reg(
                        code,
                        x86.RAX,
                    )

                    return Ok(void)
                }
            }
        }
    }
}

// emit_address_of computes the address of an expression (for & operator)
func emit_address_of(
    expr: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // debug trace removed
    switch *expr {
        case ast.Expression.Identifier(id) {
            // debug trace removed
            // Address of a local variable: LEA rax, [rbp + offset]
            var localOpt: Option<int> = resolve_local(
                state,
                &id.Value,
            )

            // debug trace removed
            switch localOpt {
                case Some(offset) {
                    // debug trace removed
                    x86.emit_lea_reg_mem_rbp(
                        code,
                        x86.RAX,
                        offset,
                    )

                    return Ok(void)
                }
                case None {
                    // debug trace removed
                    // Global or constant - just evaluate (it's already a pointer)
                    return emit_expr(
                        expr,
                        state,
                        code,
                    )
                }
            }
        }
        case ast.Expression.MutableIdentifier(id) {
            // Address of a local variable: LEA rax, [rbp + offset]
            var localOpt: Option<int> = resolve_local(
                state,
                &id.Value,
            )

            switch localOpt {
                case Some(offset) {
                    x86.emit_lea_reg_mem_rbp(
                        code,
                        x86.RAX,
                        offset,
                    )

                    return Ok(void)
                }
                case None {
                    // Global or constant - just evaluate (it's already a pointer)
                    return emit_expr(
                        expr,
                        state,
                        code,
                    )
                }
            }
        }
        case ast.Expression.FieldAccess(fe) {
            var addrStructOpt: Option<string> = struct_literal_name(
                &fe.Object,
                state,
            )

            switch addrStructOpt {
                case Some(addrStructName) {
                    if fe.Field.Value == "Statements" && (addrStructName == "BlockStatement" || addrStructName.endsWith(".BlockStatement")) {
                        var bsAddrRes: Result<void, string> = emit_expr(
                            &fe.Object,
                            state,
                            code,
                        )

                        switch bsAddrRes {
                            case Err(msg) {
                                return Err(msg)
                            }
                            case Ok(_) {
                            }
                        }

                        if is_ref_expr(
                            &fe.Object,
                            state,
                        ) {
                            emit_safe_load_rax_from_rax_disp(
                                0,
                                code,
                            )
                        }

                        x86.emit_mov_reg_imm32(
                            code,
                            x86.RCX,
                            8,
                        )
                        x86.emit_add_reg_reg(
                            code,
                            x86.RAX,
                            x86.RCX,
                        )

                        return Ok(void)
                    }
                }
                case None {
                }
            }

            // Address of a field: base + offset
            // Evaluate the object to get struct pointer
            var res: Result<void, string> = emit_expr(
                &fe.Object,
                state,
                code,
            )

            switch res {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            // If object is a reference (&Struct), dereference once to get the struct pointer.
            if is_ref_expr(
                &fe.Object,
                state,
            ) {
                emit_safe_load_rax_from_rax_disp(
                    0,
                    code,
                )
            }

            // Find struct and field offset
            var structOpt: Option<string> = struct_literal_name(
                &fe.Object,
                state,
            )

            switch structOpt {
                case Some(struct_name) {
                    var declOpt: Option<ast.StructDecl> = find_struct_decl(
                        &state.structs,
                        &struct_name,
                    )

                    switch declOpt {
                        case Some(decl) {
                            var layoutRes: Result<layout.StructLayout, string> = layout.struct_layout(
                                &decl,
                                &state.structs,
                            )

                            switch layoutRes {
                                case Ok(st_layout) {
                                    var flOpt: Option<layout.FieldLayout> = find_field_layout(
                                        &st_layout,
                                        &fe.Field.Value,
                                    )

                                    switch flOpt {
                                        case Some(fl) {
                                            // RAX = struct ptr, add offset
                                            if fl.offset != 0 {
                                                x86.emit_mov_reg_imm32(
                                                    code,
                                                    x86.RCX,
                                                    fl.offset,
                                                )
                                                x86.emit_add_reg_reg(
                                                    code,
                                                    x86.RAX,
                                                    x86.RCX,
                                                )
                                            }

                                            return Ok(void)
                                        }
                                        case None {
                                            switch find_any_struct_field_offset(
                                                &fe.Field.Value,
                                                &state.structs,
                                            ) {
                                                case Some(any_off2) {
                                                    if any_off2 != 0 {
                                                        x86.emit_mov_reg_imm32(
                                                            code,
                                                            x86.RCX,
                                                            any_off2,
                                                        )
                                                        x86.emit_add_reg_reg(
                                                            code,
                                                            x86.RAX,
                                                            x86.RCX,
                                                        )
                                                    }

                                                    return Ok(void)
                                                }
                                                case None {
                                                    return Err("native: cannot find field layout for address-of (" + struct_name + "." + fe.Field.Value + ")")
                                                }
                                            }
                                        }
                                    }
                                }
                                case Err(msg) {
                                    return Err(msg)
                                }
                            }
                        }
                        case None {
                            switch find_any_struct_field_offset(
                                &fe.Field.Value,
                                &state.structs,
                            ) {
                                case Some(any_off) {
                                    if any_off != 0 {
                                        x86.emit_mov_reg_imm32(
                                            code,
                                            x86.RCX,
                                            any_off,
                                        )
                                        x86.emit_add_reg_reg(
                                            code,
                                            x86.RAX,
                                            x86.RCX,
                                        )
                                    }

                                    return Ok(void)
                                }
                                case None {
                                    return Err("native: unknown struct for address-of (" + struct_name + "." + fe.Field.Value + ")")
                                }
                            }
                        }
                    }
                }
                case None {
                    var fallbackStructOpt: Option<string> = fallback_struct_name_by_field_name(
                        &fe.Field.Value,
                        &state.structs,
                    )

                    switch fallbackStructOpt {
                        case Some(fstruct) {
                            switch find_struct_decl(
                                &state.structs,
                                &fstruct,
                            ) {
                                case Some(fdecl) {
                                    switch layout.struct_layout(
                                        &fdecl,
                                        &state.structs,
                                    ) {
                                        case Ok(flayout) {
                                            switch find_field_layout(
                                                &flayout,
                                                &fe.Field.Value,
                                            ) {
                                                case Some(ff) {
                                                    if ff.offset != 0 {
                                                        x86.emit_mov_reg_imm32(
                                                            code,
                                                            x86.RCX,
                                                            ff.offset,
                                                        )
                                                        x86.emit_add_reg_reg(
                                                            code,
                                                            x86.RAX,
                                                            x86.RCX,
                                                        )
                                                    }

                                                    return Ok(void)
                                                }
                                                case None {
                                                }
                                            }
                                        }
                                        case Err(_) {
                                        }
                                    }
                                }
                                case None {
                                }
                            }
                        }
                        case None {
                        }
                    }

                    if fe.Field.Value == "Program" {
                        var objRes2: Result<void, string> = emit_expr(
                            &fe.Object,
                            state,
                            code,
                        )

                        switch objRes2 {
                            case Err(msg) {
                                return Err(msg)
                            }
                            case Ok(_) {
                            }
                        }

                        // Heuristic: in module-like structs, Program is commonly the
                        // second 8-byte slot (after Path).
                        x86.emit_mov_reg_imm32(
                            code,
                            x86.RCX,
                            8,
                        )
                        x86.emit_add_reg_reg(
                            code,
                            x86.RAX,
                            x86.RCX,
                        )

                        return Ok(void)
                    }

                    switch find_any_struct_field_offset(
                        &fe.Field.Value,
                        &state.structs,
                    ) {
                        case Some(any_off4) {
                            if any_off4 != 0 {
                                x86.emit_mov_reg_imm32(
                                    code,
                                    x86.RCX,
                                    any_off4,
                                )
                                x86.emit_add_reg_reg(
                                    code,
                                    x86.RAX,
                                    x86.RCX,
                                )
                            }

                            return Ok(void)
                        }
                        case None {
                        }
                    }

                    return Err("native: cannot determine struct type for address-of (" + fe.Field.Value + ")")
                }
            }
        }
        case ast.Expression.Index(ix) {
            // Address of vec[idx]: data_ptr + idx * 8
            var idxRes: Result<void, string> = emit_expr(
                &ix.Index,
                state,
                code,
            )

            switch idxRes {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            x86.emit_push_reg(
                code,
                x86.RAX,
            )

            var leftRes: Result<void, string> = emit_expr(
                &ix.Left,
                state,
                code,
            )

            switch leftRes {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            if is_ref_expr(
                &ix.Left,
                state,
            ) {
                emit_safe_load_rax_from_rax_disp(
                    0,
                    code,
                )
            }

            // RAX = Vec header ptr, load data ptr
            x86.emit_mov_reg_mem_base_disp(
                code,
                x86.R11,
                x86.RAX,
                0,
            )
            x86.emit_pop_reg(
                code,
                x86.RDX,
            )
            // RDX = index * 8
            x86.emit_shl_reg_imm8(
                code,
                x86.RDX,
                3,
            )
            // RAX = data_ptr + index*8
            x86.emit_add_reg_reg(
                code,
                x86.RDX,
                x86.R11,
            )
            x86.emit_mov_reg_reg(
                code,
                x86.RAX,
                x86.RDX,
            )

            return Ok(void)
        }
        default {
            // For other expressions, just evaluate (they're already pointers)
            return emit_expr(
                expr,
                state,
                code,
            )
        }
    }

    return Ok(void)
}

func emit_field_access(
    fe: &ast.FieldAccessExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // debug trace removed
    mut var structOpt: Option<string> = struct_literal_name(
        &fe.Object,
        state,
    )

    // debug trace removed
    if structOpt.is_none() {
        structOpt = fallback_struct_name_by_field_name(
            &fe.Field.Value,
            &state.structs,
        )
    }

    // debug trace removed
    switch structOpt {
        case None {
            return Err("native: field access on non-struct value (" + fe.Field.Value + ")")
        }
        case Some(struct_name) {
            // debug trace removed
            mut var declOpt: Option<ast.StructDecl> = find_struct_decl(
                &state.structs,
                &struct_name,
            )

            // debug trace removed
            if declOpt.is_none() {
                var fbNameOpt: Option<string> = fallback_struct_name_by_field_name(
                    &fe.Field.Value,
                    &state.structs,
                )

                switch fbNameOpt {
                    case Some(fb_name) {
                        declOpt = find_struct_decl(
                            &state.structs,
                            &fb_name,
                        )
                    }
                    case None {
                    }
                }
            }

            switch declOpt {
                case None {
                    return Err("native: unknown struct " + struct_name + " [field_access]")
                }
                case Some(decl) {
                    // debug trace removed
                    mut var selected_decl: ast.StructDecl = decl
                    mut var fieldDeclOpt: Option<ast.StructField> = find_struct_field(
                        &selected_decl,
                        &fe.Field.Value,
                    )
                    // debug trace removed
                    mut var field_kind: int = 0

                    if fieldDeclOpt.is_none() {
                        var fbFieldStructOpt: Option<string> = fallback_struct_name_by_field_name(
                            &fe.Field.Value,
                            &state.structs,
                        )

                        switch fbFieldStructOpt {
                            case Some(fb_field_struct) {
                                switch find_struct_decl(
                                    &state.structs,
                                    &fb_field_struct,
                                ) {
                                    case Some(fb_decl) {
                                        selected_decl = fb_decl
                                        fieldDeclOpt = find_struct_field(
                                            &selected_decl,
                                            &fe.Field.Value,
                                        )
                                    }
                                    case None {
                                    }
                                }
                            }
                            case None {
                            }
                        }
                    }

                    switch fieldDeclOpt {
                        case None {
                            switch find_any_struct_field_offset(
                                &fe.Field.Value,
                                &state.structs,
                            ) {
                                case Some(any_off4) {
                                    var anyRes: Result<void, string> = emit_expr(
                                        &fe.Object,
                                        state,
                                        code,
                                    )

                                    switch anyRes {
                                        case Err(msg) {
                                            return Err(msg)
                                        }
                                        case Ok(_) {
                                        }
                                    }

                                    if is_ref_expr(
                                        &fe.Object,
                                        state,
                                    ) {
                                        emit_struct_ref_base_rax(code)
                                    }

                                    emit_safe_load_direct_rax_disp(
                                        any_off4,
                                        code,
                                    )

                                    return Ok(void)
                                }
                                case None {
                                    return Err("native: unknown field " + fe.Field.Value)
                                }
                            }
                        }
                        case Some(field_decl) {
                            if !is_struct_field_supported(
                                &field_decl.Type,
                                &state.structs,
                            ) {
                                return Err(ERR_NATIVE_UNSUPPORTED)
                            }

                            field_kind = field_access_kind(
                                &field_decl.Type,
                                &state.structs,
                            )
                        }
                    }

                    // BlockStatement.Statements: use uniform 8-byte slot offset.
                    // In the Bak AST, BlockStatement = { Token(0), Statements(8) }.
                    if fe.Field.Value == "Statements" && (selected_decl.Name.Value == "BlockStatement" || selected_decl.Name.Value.endsWith(".BlockStatement")) {
                        var bsRes: Result<void, string> = emit_expr(
                            &fe.Object,
                            state,
                            code,
                        )

                        switch bsRes {
                            case Err(msg) {
                                return Err(msg)
                            }
                            case Ok(_) {
                            }
                        }

                        if is_ref_expr(
                            &fe.Object,
                            state,
                        ) {
                            emit_struct_ref_base_rax(code)
                        }

                        emit_safe_load_direct_rax_disp(
                            8,
                            code,
                        )

                        return Ok(void)
                    }

                    var layoutRes: Result<layout.StructLayout, string> = layout.struct_layout(
                        &selected_decl,
                        &state.structs,
                    )

                    switch layoutRes {
                        case Err(msg) {
                            return Err(msg)
                        }
                        case Ok(st_layout) {
                            var flOpt: Option<layout.FieldLayout> = find_field_layout(
                                &st_layout,
                                &fe.Field.Value,
                            )

                            switch flOpt {
                                case None {
                                    switch find_any_struct_field_offset(
                                        &fe.Field.Value,
                                        &state.structs,
                                    ) {
                                        case Some(any_off3) {
                                            var resAny: Result<void, string> = emit_expr(
                                                &fe.Object,
                                                state,
                                                code,
                                            )

                                            switch resAny {
                                                case Err(msg) {
                                                    return Err(msg)
                                                }
                                                case Ok(_) {
                                                }
                                            }

                                            if is_ref_expr(
                                                &fe.Object,
                                                state,
                                            ) {
                                                emit_struct_ref_base_rax(code)
                                            }

                                            emit_safe_load_direct_rax_disp(
                                                any_off3,
                                                code,
                                            )

                                            return Ok(void)
                                        }
                                        case None {
                                            return Err("native: layout missing field " + fe.Field.Value)
                                        }
                                    }
                                }
                                case Some(fl) {
                                    var res: Result<void, string> = emit_expr(
                                        &fe.Object,
                                        state,
                                        code,
                                    )

                                    switch res {
                                        case Err(msg) {
                                            return Err(msg)
                                        }
                                        case Ok(_) {
                                        }
                                    }

                                    // If object is a reference (&Struct), dereference once
                                    if is_ref_expr(
                                        &fe.Object,
                                        state,
                                    ) {
                                        emit_struct_ref_base_rax(code)
                                    }

                                    // Uniform 8-byte load: all struct fields are 8-byte slots
                                    emit_safe_load_direct_rax_disp(
                                        fl.offset,
                                        code,
                                    )

                                    return Ok(void)
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

func string_bytes(s: &string) -> (Vec<int, _>) {
    mut var out: Vec<int, _> = Vec.with_cap(s.len())
    mut var i: int = 0

    while i < s.len() {
        out.push(int(s[i]))
        i = i + 1
    }

    return out
}

func zero_bytes(size: int) -> (Vec<int, _>) {
    mut var out: Vec<int, _> = Vec.with_cap(size)
    mut var i: int = 0

    while i < size {
        out.push(0)
        i = i + 1
    }

    return out
}

func add_data_item(
    mut state: &mut BackendEmitState,
    bytes: Vec<int, _>,
    align: int,
) -> (int) {
    var idx: int = state.data_items.len()
    var di: DataItem = DataItem{align: align, bytes: bytes}

    state.data_items.push(di)

    return idx
}

func is_all_zero_bytes(bytes: &Vec<int, _>) -> (bool) {
    for b in *bytes {
        if b != 0 {
            return false
        }
    }

    return true
}

func find_zero_data_item(
    state: &mut BackendEmitState,
    size: int,
    align: int,
) -> (Option<int>) {
    mut var i: int = 0

    while i < state.data_items.len() {
        var di: &DataItem = &state.data_items[i]

        if di.align == align && di.bytes.len() == size && is_all_zero_bytes(&di.bytes) {
            return Some(i)
        }

        i = i + 1
    }

    return None
}

func emit_struct_literal_into(
    struct_idx: int,
    base_offset: int,
    decl: &ast.StructDecl,
    sl: &ast.StructLiteral,
    state: &mut BackendEmitState,
) -> (Result<void, string>) {
    if struct_idx >= state.data_items.len() {
        return Err("native: struct data index out of range")
    }

    var layoutRes: Result<layout.StructLayout, string> = layout.struct_layout(
        decl,
        &state.structs,
    )

    switch layoutRes {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(st_layout) {
            if base_offset < 0 || base_offset + st_layout.size > (state.data_items[struct_idx]).bytes.len() {
                return Err("native: struct literal offset out of range")
            }

            for fv in sl.Fields {
                var fieldDeclOpt: Option<ast.StructField> = find_struct_field(
                    decl,
                    &fv.Name.Value,
                )

                switch fieldDeclOpt {
                    case None {
                        return Err("native: unknown field " + fv.Name.Value)
                    }
                    case Some(field_decl) {
                        if !is_struct_field_supported(
                            &field_decl.Type,
                            &state.structs,
                        ) {
                            return Err(ERR_NATIVE_UNSUPPORTED)
                        }

                        var flOpt: Option<layout.FieldLayout> = find_field_layout(
                            &st_layout,
                            &fv.Name.Value,
                        )

                        switch flOpt {
                            case None {
                                return Err("native: layout missing field " + fv.Name.Value)
                            }
                            case Some(fl) {
                                var field_off: int = base_offset + fl.offset
                                var res: Result<void, string> = write_struct_field_value(
                                    struct_idx,
                                    field_off,
                                    fl.size,
                                    &field_decl.Type,
                                    &fv.Value,
                                    state,
                                )

                                switch res {
                                    case Err(msg) {
                                        return Err(msg)
                                    }
                                    case Ok(_) {
                                    }
                                }
                            }
                        }
                    }
                }
            }

            return Ok(void)
        }
    }
}

func write_struct_field_value(
    struct_idx: int,
    offset: int,
    _size: int,
    field_type: &ast.TypeExpression,
    expr: &ast.Expression,
    state: &mut BackendEmitState,
) -> (Result<void, string>) {
    // Uniform 8-byte model: all struct fields are 8-byte slots.
    if struct_idx >= state.data_items.len() {
        return Err("native: struct data index out of range")
    }

    mut var item: &mut DataItem = &mut state.data_items[struct_idx]

    if offset < 0 || offset + 8 > item.bytes.len() {
        return Err("native: struct field patch out of range")
    }

    switch *field_type {
        case ast.TypeExpression.Simple(st) {
            if st.Name == "int" {
                switch *expr {
                    case ast.Expression.IntegerLiteral(il) {
                        patch_u64(
                            &mut item.bytes,
                            offset,
                            il.Value,
                        )

                        return Ok(void)
                    }
                    default {
                    }
                }

                return Err(ERR_NATIVE_BAD_ARGS)
            }

            if st.Name == "bool" {
                switch *expr {
                    case ast.Expression.BooleanLiteral(bl) {
                        if bl.Value {
                            patch_u64(
                                &mut item.bytes,
                                offset,
                                1,
                            )
                        } else {
                            patch_u64(
                                &mut item.bytes,
                                offset,
                                0,
                            )
                        }

                        return Ok(void)
                    }
                    default {
                    }
                }

                return Err(ERR_NATIVE_BAD_ARGS)
            }

            if st.Name == "char" {
                switch *expr {
                    case ast.Expression.CharLiteral(cl) {
                        patch_u64(
                            &mut item.bytes,
                            offset,
                            int(cl.Value),
                        )

                        return Ok(void)
                    }
                    default {
                    }
                }

                return Err(ERR_NATIVE_BAD_ARGS)
            }

            if st.Name == "string" {
                switch *expr {
                    case ast.Expression.StringLiteral(sl) {
                        // Create string content data item
                        var data_len: int = sl.Value.len()
                        var content_idx: int = add_data_item(
                            state,
                            string_bytes(&sl.Value),
                            1,
                        )
                        // Create 16-byte string header {ptr, len}
                        var hdr_idx: int = add_data_item(
                            state,
                            zero_bytes(16),
                            8,
                        )

                        // Patch header: ptr → content (via data_patch), len → direct
                        state.data_patches.push(hdr_idx)
                        state.data_patches.push(0)
                        state.data_patches.push(content_idx)

                        mut var hdr_item: &mut DataItem = &mut state.data_items[hdr_idx]

                        patch_u64(
                            &mut hdr_item.bytes,
                            8,
                            data_len,
                        )
                        // Patch struct field: 8-byte pointer → header
                        state.data_patches.push(struct_idx)
                        state.data_patches.push(offset)
                        state.data_patches.push(hdr_idx)

                        return Ok(void)
                    }
                    default {
                    }
                }

                return Err(ERR_NATIVE_BAD_ARGS)
            }

            var declOpt: Option<ast.StructDecl> = find_struct_decl(
                &state.structs,
                &st.Name,
            )

            switch declOpt {
                case None {
                }
                case Some(decl) {
                    switch *expr {
                        case ast.Expression.StructLiteral(sl) {
                            if sl.Name.Value != st.Name {
                                return Err("native: struct field type mismatch")
                            }

                            // Create nested struct as separate data item
                            var nested_layout_res: Result<layout.StructLayout, string> = layout.struct_layout(
                                &decl,
                                &state.structs,
                            )

                            switch nested_layout_res {
                                case Err(msg) {
                                    return Err(msg)
                                }
                                case Ok(nested_layout) {
                                    var nested_idx: int = add_data_item(
                                        state,
                                        zero_bytes(nested_layout.size),
                                        nested_layout.align,
                                    )
                                    var fillRes: Result<void, string> = emit_struct_literal_into(
                                        nested_idx,
                                        0,
                                        &decl,
                                        &sl,
                                        state,
                                    )

                                    switch fillRes {
                                        case Err(msg) {
                                            return Err(msg)
                                        }
                                        case Ok(_) {
                                        }
                                    }

                                    // Patch struct field: 8-byte pointer → nested struct
                                    state.data_patches.push(struct_idx)
                                    state.data_patches.push(offset)
                                    state.data_patches.push(nested_idx)

                                    return Ok(void)
                                }
                            }
                        }
                        default {
                        }
                    }

                    return Err(ERR_NATIVE_BAD_ARGS)
                }
            }
        }
        case ast.TypeExpression.Generic(gt) {
            if gt.Name == "Vec" {
                switch *expr {
                    case ast.Expression.VecLiteral(vl) {
                        var vecRes: Result<VecDataInfo, string> = emit_vec_data(
                            &vl.Elements,
                            state,
                        )

                        switch vecRes {
                            case Err(msg) {
                                return Err(msg)
                            }
                            case Ok(info) {
                                // Create 24-byte Vec header {ptr, len, cap}
                                var hdr_idx: int = add_data_item(
                                    state,
                                    zero_bytes(24),
                                    8,
                                )

                                // Patch header: ptr → data, len/cap → direct
                                state.data_patches.push(hdr_idx)
                                state.data_patches.push(0)
                                state.data_patches.push(info.data_index)

                                mut var hdr_item: &mut DataItem = &mut state.data_items[hdr_idx]

                                patch_u64(
                                    &mut hdr_item.bytes,
                                    8,
                                    info.length,
                                )
                                patch_u64(
                                    &mut hdr_item.bytes,
                                    16,
                                    info.length,
                                )
                                // Patch struct field: 8-byte pointer → header
                                state.data_patches.push(struct_idx)
                                state.data_patches.push(offset)
                                state.data_patches.push(hdr_idx)

                                return Ok(void)
                            }
                        }
                    }
                    default {
                    }
                }

                return Err(ERR_NATIVE_BAD_ARGS)
            }
        }
        default {
        }
    }

    return Err(ERR_NATIVE_UNSUPPORTED)
}

pub struct VecDataInfo {
    data_index: int
    length:     int
}

func emit_vec_data(
    elems: &Vec<ast.Expression, _>,
    state: &mut BackendEmitState,
) -> (Result<VecDataInfo, string>) {
    var elem_len: int = elems.len()

    if elem_len == 0 {
        var data_idx_empty: int = add_data_item(
            state,
            Vec.new(),
            1,
        )

        return Ok(VecDataInfo{data_index: data_idx_empty, length: 0})
    }

    var first: ast.Expression = (*elems)[0]
    mut var elem_size: int = 8
    mut var elem_align: int = 8
    mut var elem_kind: int = ELEM_KIND_SCALAR
    mut var elem_struct: string = ""
    mut var struct_decl: Option<ast.StructDecl> = None

    switch first {
        case ast.Expression.IntegerLiteral(_) {
            elem_size = 8
            elem_align = 8
            elem_kind = ELEM_KIND_SCALAR
        }
        case ast.Expression.BooleanLiteral(_) {
            elem_size = 8
            elem_align = 8
            elem_kind = ELEM_KIND_SCALAR
        }
        case ast.Expression.CharLiteral(_) {
            elem_size = 8
            elem_align = 8
            elem_kind = ELEM_KIND_SCALAR
        }
        case ast.Expression.StringLiteral(_) {
            elem_size = 8
            elem_align = 8
            elem_kind = ELEM_KIND_STRING
        }
        case ast.Expression.StructLiteral(sl) {
            mut var declOpt: Option<ast.StructDecl> = find_struct_decl(
                &state.structs,
                &sl.Name.Value,
            )

            if declOpt.is_none() {
                declOpt = find_struct_decl_by_literal_fields(
                    &state.structs,
                    &sl,
                )
            }

            switch declOpt {
                case None {
                    return Err("native: unknown struct " + sl.Name.Value + " [vec_data]")
                }
                case Some(decl) {
                    var layoutRes: Result<layout.StructLayout, string> = layout.struct_layout(
                        &decl,
                        &state.structs,
                    )

                    switch layoutRes {
                        case Err(msg) {
                            return Err(msg)
                        }
                        case Ok(st_layout) {
                            elem_size = 8
                            elem_align = 8
                            elem_kind = ELEM_KIND_STRUCT
                            elem_struct = sl.Name.Value
                            struct_decl = Some(decl)
                        }
                    }
                }
            }
        }
        default {
            return Err(ERR_NATIVE_UNSUPPORTED)
        }
    }

    var data_idx: int = add_data_item(
        state,
        zero_bytes(elem_size * elem_len),
        elem_align,
    )
    mut var i: int = 0

    while i < elem_len {
        var offset: int = i * elem_size
        var e: ast.Expression = (*elems)[i]

        if elem_kind == ELEM_KIND_STRING {
            switch e {
                case ast.Expression.StringLiteral(sl) {
                    var str_len: int = sl.Value.len()
                    var str_data_idx: int = add_data_item(
                        state,
                        string_bytes(&sl.Value),
                        1,
                    )
                    var header_idx: int = add_data_item(
                        state,
                        zero_bytes(16),
                        8,
                    )
                    mut var header_item: &mut DataItem = &mut state.data_items[header_idx]

                    patch_u64(
                        &mut header_item.bytes,
                        8,
                        str_len,
                    )
                    state.data_patches.push(header_idx)
                    state.data_patches.push(0)
                    state.data_patches.push(str_data_idx)
                    state.data_patches.push(data_idx)
                    state.data_patches.push(offset)
                    state.data_patches.push(header_idx)
                }
                default {
                    return Err(ERR_NATIVE_BAD_ARGS)
                }
            }
        } else if elem_kind == ELEM_KIND_STRUCT {
            switch e {
                case ast.Expression.StructLiteral(sl) {
                    if sl.Name.Value != elem_struct {
                        return Err("native: vec struct literal element type mismatch")
                    }

                    switch struct_decl {
                        case None {
                            return Err("native: vec struct literal missing declaration")
                        }
                        case Some(decl) {
                            // Create a separate data item for the struct instance
                            var sLayoutRes: Result<layout.StructLayout, string> = layout.struct_layout(
                                &decl,
                                &state.structs,
                            )

                            switch sLayoutRes {
                                case Err(msg) {
                                    return Err(msg)
                                }
                                case Ok(s_layout) {
                                    var struct_data_idx: int = add_data_item(
                                        state,
                                        zero_bytes(s_layout.size),
                                        s_layout.align,
                                    )
                                    var res: Result<void, string> = emit_struct_literal_into(
                                        struct_data_idx,
                                        0,
                                        &decl,
                                        &sl,
                                        state,
                                    )

                                    switch res {
                                        case Err(msg2) {
                                            return Err(msg2)
                                        }
                                        case Ok(_) {
                                        }
                                    }

                                    // Patch Vec element slot to point to struct data item
                                    state.data_patches.push(data_idx)
                                    state.data_patches.push(offset)
                                    state.data_patches.push(struct_data_idx)
                                }
                            }
                        }
                    }
                }
                default {
                    return Err(ERR_NATIVE_BAD_ARGS)
                }
            }
        } else {
            // Uniform 8-byte scalar elements (int, bool, char)
            switch e {
                case ast.Expression.IntegerLiteral(il) {
                    var item: &mut DataItem = &mut state.data_items[data_idx]

                    patch_u64(
                        &mut item.bytes,
                        offset,
                        il.Value,
                    )
                }
                case ast.Expression.BooleanLiteral(bl) {
                    var item: &mut DataItem = &mut state.data_items[data_idx]

                    if bl.Value {
                        patch_u64(
                            &mut item.bytes,
                            offset,
                            1,
                        )
                    }
                }
                case ast.Expression.CharLiteral(cl) {
                    var item: &mut DataItem = &mut state.data_items[data_idx]

                    patch_u64(
                        &mut item.bytes,
                        offset,
                        int(cl.Value),
                    )
                }
                default {
                    return Err(ERR_NATIVE_BAD_ARGS)
                }
            }
        }

        i = i + 1
    }

    return Ok(VecDataInfo{data_index: data_idx, length: elem_len})
}

func find_struct_decl(
    structs: &Vec<ast.StructDecl, _>,
    name: &string,
) -> (Option<ast.StructDecl>) {
    var idx: int = find_struct_decl_index(
        structs,
        name,
    )

    if idx >= 0 {
        return Some((*structs)[idx])
    }

    return None
}

func find_struct_decl_index(
    structs: &Vec<ast.StructDecl, _>,
    name: &string,
) -> (int) {
    // debug trace removed
    var simple: string = struct_name_suffix(name)
    // debug trace removed
    mut var si: int = 0

    while si < structs.len() {
        var s: ast.StructDecl = (*structs)[si]

        // debug trace removed
        if s.Name.Value == *name || s.Name.Value == simple {
            // debug trace removed
            return si
        }

        var s_simple: string = struct_name_suffix(&s.Name.Value)

        // debug trace removed
        if s_simple == *name || s_simple == simple {
            // debug trace removed
            return si
        }

        si = si + 1
    }

    return -1
}

func find_struct_decl_for_pkg(
    structs: &Vec<ast.StructDecl, _>,
    name: &string,
    current_pkg: &string,
) -> (Option<ast.StructDecl>) {
    var simple: string = struct_name_suffix(name)

    if current_pkg.len() > 0 {
        var qualified: string = *current_pkg + "." + simple
        mut var si0: int = 0

        while si0 < structs.len() {
            if ((*structs)[si0]).Name.Value == qualified {
                return Some((*structs)[si0])
            }

            si0 = si0 + 1
        }

        // Prefer exact local-name matches before broad suffix fallback.
        mut var si1: int = 0

        while si1 < structs.len() {
            if ((*structs)[si1]).Name.Value == simple {
                return Some((*structs)[si1])
            }

            si1 = si1 + 1
        }

        mut var si2: int = 0

        while si2 < structs.len() {
            var s_name: string = ((*structs)[si2]).Name.Value

            if s_name.startsWith(*current_pkg + ".") && struct_name_suffix(&s_name) == simple {
                return Some((*structs)[si2])
            }

            si2 = si2 + 1
        }
    }

    return find_struct_decl(
        structs,
        name,
    )
}

func find_struct_decl_by_literal_fields(
    structs: &Vec<ast.StructDecl, _>,
    sl: &ast.StructLiteral,
) -> (Option<ast.StructDecl>) {
    mut var si: int = 0

    while si < structs.len() {
        var s: &ast.StructDecl = &(*structs)[si]
        mut var all_fields_match: bool = true

        for fv in sl.Fields {
            mut var field_found: bool = false

            for sf in s.Fields {
                if sf.Name.Value == fv.Name.Value {
                    field_found = true
                    break
                }
            }

            if !field_found {
                all_fields_match = false
                break
            }
        }

        if all_fields_match {
            return Some(*s)
        }

        si = si + 1
    }

    return None
}

func struct_name_suffix(name: &string) -> (string) {
    mut var last_dot: int = -1
    mut var i: int = 0

    while i < name.len() {
        if name[i] == '.' {
            last_dot = i
        }

        i = i + 1
    }

    if last_dot >= 0 && last_dot + 1 < name.len() {
        mut var out: string = ""
        mut var j: int = last_dot + 1

        while j < name.len() {
            out = out + char(name[j]).toString()
            j = j + 1
        }

        return out
    }

    mut var whole: string = ""
    mut var k: int = 0

    while k < name.len() {
        whole = whole + char(name[k]).toString()
        k = k + 1
    }

    return whole
}

func find_struct_field(
    decl: &ast.StructDecl,
    name: &string,
) -> (Option<ast.StructField>) {
    for f in decl.Fields {
        if f.Name.Value == *name {
            return Some(f)
        }
    }

    return None
}

func find_struct_field_index(decl: &ast.StructDecl, name: &string) -> (int) {
    mut var i: int = 0

    while i < decl.Fields.len() {
        if (decl.Fields[i]).Name.Value == *name {
            return i
        }

        i = i + 1
    }

    return -1
}

func uniform_struct_field_offset(
    decl: &ast.StructDecl,
    name: &string,
) -> (Option<int>) {
    mut var i: int = 0

    while i < decl.Fields.len() {
        if (decl.Fields[i]).Name.Value == *name {
            return Some(i * 8)
        }

        i = i + 1
    }

    return None
}

func find_any_struct_field_offset(
    field_name: &string,
    structs: &Vec<ast.StructDecl, _>,
) -> (Option<int>) {
    mut var si: int = 0

    while si < structs.len() {
        var sd: &ast.StructDecl = &(*structs)[si]
        var layoutRes: Result<layout.StructLayout, string> = layout.struct_layout(
            sd,
            structs,
        )

        switch layoutRes {
            case Ok(st_layout) {
                switch find_field_layout(
                    &st_layout,
                    field_name,
                ) {
                    case Some(fl) {
                        return Some(fl.offset)
                    }
                    case None {
                    }
                }
            }
            case Err(_) {
            }
        }

        si = si + 1
    }

    return None
}

func find_field_layout(
    st_layout: &layout.StructLayout,
    name: &string,
) -> (Option<layout.FieldLayout>) {
    for f in st_layout.fields {
        if f.name == *name {
            return Some(f)
        }
    }

    return None
}

func is_struct_field_supported(
    t: &ast.TypeExpression,
    structs: &Vec<ast.StructDecl, _>,
) -> (bool) {
    switch *t {
        case ast.TypeExpression.Simple(st) {
            if st.Name == "int" || st.Name == "bool" || st.Name == "char" || st.Name == "string" {
                return true
            }

            var declOpt: Option<ast.StructDecl> = find_struct_decl(
                structs,
                &st.Name,
            )

            switch declOpt {
                case Some(_) {
                    return true
                }
                case None {
                }
            }
        }
        case ast.TypeExpression.Generic(gt) {
            if gt.Name == "Vec" || gt.Name == "Option" || gt.Name == "Result" {
                return true
            }
        }
        case ast.TypeExpression.BorrowRef(_) {
            return true
        }
        case ast.TypeExpression.BoxRef(_) {
            return true
        }
        case ast.TypeExpression.BoxOptional(_) {
            return true
        }
        case ast.TypeExpression.TupleRef(_) {
            return true
        }
        case ast.TypeExpression.Size(_) {
            return true
        }
        case ast.TypeExpression.Error(_) {
            return true
        }
        case ast.TypeExpression.Function(_) {
            return true
        }
        case ast.TypeExpression.Void(_) {
            return true
        }
        default {
        }
    }

    return true
}

func field_access_kind(
    t: &ast.TypeExpression,
    structs: &Vec<ast.StructDecl, _>,
) -> (int) {
    switch *t {
        case ast.TypeExpression.Simple(st) {
            if st.Name == "int" || st.Name == "bool" || st.Name == "char" {
                return 0
            }

            if st.Name == "string" {
                return 1
            }

            var declOpt: Option<ast.StructDecl> = find_struct_decl(
                structs,
                &st.Name,
            )

            switch declOpt {
                case Some(_) {
                    return 1
                }
                case None {
                }
            }
        }
        case ast.TypeExpression.Generic(gt) {
            if gt.Name == "Vec" {
                return 1
            }
        }
        default {
        }
    }

    return 0
}

func emit_data_addr(
    mut state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
    data_index: int,
) -> (void) {
    var start: int = code.len()

    // mov rax, imm32 (zero-extended)
    code.push(0x48)
    code.push(0xC7)
    code.push(0xC0)
    code.push(0x00)
    code.push(0x00)
    code.push(0x00)
    code.push(0x00)

    var imm_off: int = start + 3

    state.code_patches.push(data_index)
    state.code_patches.push(imm_off)

    return
}

func finalize_data(
    mut state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    if state.data_items.len() == 0 {
        return Ok(void)
    }

    mut var offsets: Vec<int, _> = Vec.with_cap(state.data_items.len())
    mut var data_pos: int = code.len()
    mut var i: int = 0

    while i < state.data_items.len() {
        var item: &DataItem = &state.data_items[i]
        mut var align: int = (*item).align

        if align < 1 {
            align = 1
        }

        mut var pad: int = 0

        if data_pos % align != 0 {
            pad = align - data_pos % align
        }

        data_pos = data_pos + pad
        offsets.push(data_pos)
        data_pos = data_pos + (*item).bytes.len()
        i = i + 1
    }

    if state.data_patches.len() % 3 != 0 {
        return Err("native: corrupted data patch list")
    }

    mut var pi: int = 0

    while pi < state.data_patches.len() {
        var data_index: int = state.data_patches[pi]
        var patch_off: int = state.data_patches[pi + 1]
        var target_index: int = state.data_patches[pi + 2]

        if data_index >= state.data_items.len() || target_index >= state.data_items.len() {
            return Err("native: data patch index out of range")
        }

        var addr: int = CODE_BASE_ADDR + offsets[target_index]
        mut var item: &mut DataItem = &mut state.data_items[data_index]

        if patch_off + 8 > (*item).bytes.len() {
            return Err("native: data patch out of range")
        }

        patch_u64(
            &mut (*item).bytes,
            patch_off,
            addr,
        )
        pi = pi + 3
    }

    data_pos = code.len()
    i = 0

    while i < state.data_items.len() {
        var item2: &DataItem = &state.data_items[i]
        mut var align2: int = (*item2).align

        if align2 < 1 {
            align2 = 1
        }

        if data_pos % align2 != 0 {
            var pad2: int = align2 - data_pos % align2
            mut var j: int = 0

            while j < pad2 {
                code.push(0)
                j = j + 1
            }

            data_pos = data_pos + pad2
        }

        mut var bi: int = 0

        while bi < (*item2).bytes.len() {
            code.push((*item2).bytes[bi])
            bi = bi + 1
        }

        data_pos = data_pos + (*item2).bytes.len()
        i = i + 1
    }

    mut var cpi: int = 0

    if state.code_patches.len() % 2 != 0 {
        return Err("native: corrupted code patch list")
    }

    while cpi < state.code_patches.len() {
        var data_index: int = state.code_patches[cpi]
        var patch_off: int = state.code_patches[cpi + 1]

        if data_index >= offsets.len() {
            return Err("native: code patch index out of range")
        }

        var addr2: int = CODE_BASE_ADDR + offsets[data_index]

        patch_u32(
            code,
            patch_off,
            addr2,
        )
        cpi = cpi + 2
    }

    return Ok(void)
}

func emit_jz_placeholder(mut code: &mut Vec<int, _>) -> (int) {
    var start: int = code.len()

    x86.emit_jz_rel32(
        code,
        0,
    )

    return start + 2
}

func emit_jge_placeholder(mut code: &mut Vec<int, _>) -> (int) {
    var start: int = code.len()

    x86.emit_jge_rel32(
        code,
        0,
    )

    return start + 2
}

func emit_jl_placeholder(mut code: &mut Vec<int, _>) -> (int) {
    var start: int = code.len()

    x86.emit_jl_rel32(
        code,
        0,
    )

    return start + 2
}

func emit_jmp_placeholder(mut code: &mut Vec<int, _>) -> (int) {
    var start: int = code.len()

    x86.emit_jmp_rel32(
        code,
        0,
    )

    return start + 1
}

func emit_jmp_to(mut code: &mut Vec<int, _>, target: int) -> (void) {
    var start: int = code.len()

    x86.emit_jmp_rel32(
        code,
        0,
    )
    patch_rel32(
        code,
        start + 1,
        target,
    )

    return
}

func patch_sites(
    mut code: &mut Vec<int, _>,
    sites: &Vec<int, _>,
    target: int,
) -> (void) {
    for s in *sites {
        patch_rel32(
            code,
            s,
            target,
        )
    }

    return
}

func push_loop(stack: &mut Vec<LoopContext, _>, ctx: LoopContext) -> (void) {
    stack.push(ctx)

    return
}

func pop_loop(
    stack: &mut Vec<LoopContext, _>,
) -> (Result<LoopContext, string>) {
    switch stack.pop() {
        case Some(ctx) {
            return Ok(ctx)
        }
        case None {
            return Err("native: loop stack empty")
        }
    }
}

func add_break_site(
    stack: &mut Vec<LoopContext, _>,
    imm_offset: int,
) -> (Result<void, string>) {
    if stack.len() == 0 {
        return Err("native: break outside loop")
    }

    var idx: int = stack.len() - 1
    mut var ctx: LoopContext = stack[idx]

    ctx.break_sites.push(imm_offset)
    stack[idx] = ctx

    return Ok(void)
}

func add_continue_site(
    stack: &mut Vec<LoopContext, _>,
    imm_offset: int,
) -> (Result<void, string>) {
    if stack.len() == 0 {
        return Err("native: continue outside loop")
    }

    var idx: int = stack.len() - 1
    mut var ctx: LoopContext = stack[idx]

    ctx.continue_sites.push(imm_offset)
    stack[idx] = ctx

    return Ok(void)
}

func update_continue_target(
    stack: &mut Vec<LoopContext, _>,
    target: int,
) -> (void) {
    if stack.len() == 0 {
        return
    }

    var idx: int = stack.len() - 1
    mut var ctx: LoopContext = stack[idx]

    ctx.continue_target = target
    stack[idx] = ctx

    return
}

func is_range_expr(expr: &ast.Expression) -> (bool) {
    switch *expr {
        case ast.Expression.Range(_) {
            return true
        }
        default {
        }
    }

    return false
}

func extract_range(expr: &ast.Expression) -> (Option<ast.RangeExpression>) {
    switch *expr {
        case ast.Expression.Range(r) {
            return Some(r)
        }
        default {
        }
    }

    return None
}

func copyString(value: &string) -> (string) {
    return *value
}
