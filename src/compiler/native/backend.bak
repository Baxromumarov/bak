        }

        if mc.Method.Value == "to_string" || mc.Method.Value == "toString" {
            var res: Result<void, string> = emit_expr(
                &mc.Object,
                state,
                code,
            )

            switch res {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
