func resolve_local_type(
    state: &mut BackendEmitState,
    name: &string,
) -> (Option<string>) {
    if state.scopes.len() == 0 {
        return None
    }

    mut var i: int = state.scopes.len() - 1

    while i >= 0 {
        mut var j: int = 0
        var n: int = (state.scopes[i]).local_types.len()

        while j < n {
            if str_eq(
                &((state.scopes[i]).local_types[j]).name,
                name,
            ) {
                return Some(((state.scopes[i]).local_types[j]).type_name)
            }

            j = j + 1
        }

        if i == 0 {
            break
        }

        i = i - 1
    }

    return None
}

func local_type_is_float(
    state: &mut BackendEmitState,
    name: &string,
) -> (bool) {
    if state.scopes.len() == 0 {
        return false
    }

    mut var i: int = state.scopes.len() - 1

    while i >= 0 {
        mut var j: int = 0
        var n: int = (state.scopes[i]).local_types.len()

        while j < n {
            if str_eq(
                &((state.scopes[i]).local_types[j]).name,
                name,
            ) {
                return is_float_type_name(
                    &((state.scopes[i]).local_types[j]).type_name,
                )
            }

            j = j + 1
        }

        if i == 0 {
            break
        }

        i = i - 1
    }

    return false
}

func str_eq(a: &string, b: &string) -> (bool) {
    return *a == *b
}

func prefix_before_last_dot(name: &string) -> (Option<string>) {
    var first_dot_opt: Option<int> = name.indexOf(".")

    switch first_dot_opt {
        case None {
            return None
        }
        case Some(first_dot) {
            mut var last_dot: int = first_dot
            mut var search_from: int = first_dot + 1

            while search_from < name.len() {
                var rest: string = name.substring(
                    search_from,
                    name.len(),
                )
                var rel_dot_opt: Option<int> = rest.indexOf(".")

                switch rel_dot_opt {
                    case Some(rel_dot) {
                        last_dot = search_from + rel_dot
                        search_from = last_dot + 1
                    }
                    case None {
                        search_from = name.len()
                    }
                }
            }

            if last_dot <= 0 {
                return None
            }

            return Some(
                name.substring(
                    0,
                    last_dot,
                ),
            )
        }
    }
}

func emit_const_stmt_value(
    cs: &ast.ConstStatement,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    switch cs.Value {
        case ast.Expression.StringLiteral(_) {
            return emit_expr(
                &cs.Value,
                state,
                code,
            )
        }
        case ast.Expression.IntegerLiteral(_) {
            return emit_expr(
                &cs.Value,
                state,
                code,
            )
        }
        case ast.Expression.BooleanLiteral(_) {
            return emit_expr(
                &cs.Value,
                state,
                code,
            )
        }
        case ast.Expression.CharLiteral(_) {
            return emit_expr(
                &cs.Value,
                state,
                code,
            )
        }
        default {
        }
    }

    var prev_pkg: string = state.current_pkg
    var pkgOpt: Option<string> = prefix_before_last_dot(&cs.Name.Value)

    switch pkgOpt {
        case Some(pkg) {
            state.current_pkg = pkg
        }
        case None {
            state.current_pkg = "main"
        }
    }

    var res: Result<void, string> = emit_expr(
        &cs.Value,
        state,
        code,
    )

    state.current_pkg = prev_pkg

    return res
}

// emit_const_value looks up a top-level constant by name and emits its value into rax.
func emit_const_value(
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
    name: &string,
) -> (Result<void, string>) {
    mut var ci0: int = 0

    while ci0 < state.constants.len() {
        var cs0: &ast.ConstStatement = &state.constants[ci0]

        if str_eq(
            &cs0.Name.Value,
            name,
        ) {
            return emit_const_stmt_value(
                cs0,
                state,
                code,
            )
        }

        ci0 = ci0 + 1
    }

    // Try qualified name in current context, then trim one namespace
    // segment at a time (e.g. parser.lexer.NAME -> parser.NAME).
    if state.current_pkg != "" && state.current_pkg != "main" {
        mut var pkg_ctx: string = state.current_pkg
        mut var keep_searching: bool = true

        while keep_searching {
            var qualified: string = pkg_ctx + "." + *name
            mut var ci1: int = 0

            while ci1 < state.constants.len() {
                var cs1: &ast.ConstStatement = &state.constants[ci1]

                if str_eq(
                    &cs1.Name.Value,
                    &qualified,
                ) {
                    return emit_const_stmt_value(
                        cs1,
                        state,
                        code,
                    )
                }

                ci1 = ci1 + 1
            }

            var parentOpt: Option<string> = prefix_before_last_dot(&pkg_ctx)

            switch parentOpt {
                case Some(parent) {
                    pkg_ctx = parent
                }
                case None {
                    keep_searching = false
                }
            }
        }
    }

    // Fallback: allow suffix match on qualified constant names from other modules.
    // This handles cases where constants are stored as "pkg.NAME" while lookup is "NAME".
    mut var suffix_hits: int = 0
    mut var suffix_idx: int = -1
    mut var ci2: int = 0

    while ci2 < state.constants.len() {
        var cs2: &ast.ConstStatement = &state.constants[ci2]

        if bootstrap_target_matches(
            &cs2.Name.Value,
            name,
        ) {
            suffix_hits = suffix_hits + 1

            if suffix_idx < 0 {
                suffix_idx = ci2
            }
        }

        ci2 = ci2 + 1
    }

    if suffix_hits >= 1 && suffix_idx >= 0 {
        return emit_const_stmt_value(
            &state.constants[suffix_idx],
            state,
            code,
        )
    }

    return Err("native: unknown constant " + *name)
}

func add_iterable_binding(
    mut state: &mut BackendEmitState,
    name: string,
    elem_size: int,
    elem_kind: int,
    elem_struct: string,
    container_kind: int,
) -> (void) {
    if state.scopes.len() == 0 {
        return
    }

    var binding: IterableBinding = IterableBinding{
        container_kind: container_kind,
        elem_kind:      elem_kind,
        elem_size:      elem_size,
        elem_struct:    elem_struct,
        name:           name,
    }
    mut var scope: &mut Scope = &mut state.scopes[state.scopes.len() - 1]

    scope.iterables.push(binding)

    return
}

func add_struct_binding(
    mut state: &mut BackendEmitState,
    name: string,
