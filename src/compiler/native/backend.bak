package native

// AST -> machine code emitter (Phase 1).
import "src/compiler/ast/ast.bak" as ast
import "src/compiler/native/elf.bak" as elf
import "src/compiler/native/layout.bak" as layout
import "src/compiler/native/runtime.bak" as rt
import "src/compiler/native/x86_64.bak" as x86
import "src/std/fs/fs.bak" as fs

const CODE_BASE_ADDR: int = 0x400000 + 64 + 56 * 1
const IDENTIFIER_METHOD_FALLTHROUGH: string = "__native_identifier_method_fallthrough__"
const CALL_TARGET_FALLTHROUGH: string = "__native_call_target_fallthrough__"
const ERR_NATIVE_BAD_ARGS: string = "native: bad args"
const ERR_NATIVE_TOO_MANY_ARGS: string = "native: too many args"
const ERR_NATIVE_UNSUPPORTED: string = "native: unsupported"
const FLOAT_SCALE: int = 1000000
const MISSING_LOCAL_OFFSET: int = -2147483648
const TRACE_MAIN_STOP_SEQ: int = 0
const TRACE_ASSIGN_STOP_PHASE: int = 0
const ASSIGN_VALUE_HINT_NONE: int = 0
const ASSIGN_VALUE_HINT_INT: int = 1
const ASSIGN_VALUE_HINT_FLOAT: int = 2
const ASSIGN_VALUE_HINT_STRING: int = 3
const ASSIGN_VALUE_HINT_BOOL: int = 4
const ASSIGN_VALUE_HINT_CHAR: int = 5
const ASSIGN_VALUE_HINT_IDENT: int = 6
const ASSIGN_VALUE_HINT_BORROW_IDENT: int = 7
const ASSIGN_VALUE_HINT_VOID: int = 8

// keep in sync with elf.bak (1 PHDR)
// BuildProgram emits a minimal native binary for a Bak program.
// Phase 2: lower a tiny AST subset (int locals + arithmetic + return) into x86_64.
pub func BuildProgram(program: &ast.Program) -> (Result<Vec<int, _>, string>) {
    var res: Result<CodeResult, string> = build_program(program)

    switch res {
        case Ok(cr) {
            var code: Vec<int, _> = cr.code

            return elf.BuildELF(
                &code,
                cr.entry_offset,
                cr.text_size,
            )
        }
        case Err(msg) {
            return Err(msg)
        }
    }
}

// WriteProgramItems writes a minimal native binary from pre-collected program items.
pub func WriteProgramItems(
    funcsIn: Vec<ast.FunctionDecl, _>,
    structsIn: Vec<ast.StructDecl, _>,
    constsIn: Vec<ast.ConstStatement, _>,
    enumsIn: Vec<ast.EnumDecl, _>,
    path: string,
) -> (Result<void, string>) {
    mut var funcs: Vec<ast.FunctionDecl, _> = funcsIn
    mut var structs: Vec<ast.StructDecl, _> = structsIn
    mut var consts: Vec<ast.ConstStatement, _> = constsIn
    mut var enums: Vec<ast.EnumDecl, _> = enumsIn
    var res: Result<CodeResult, string> = emit_program_functions(
        &mut funcs,
        &mut structs,
        &mut consts,
        &mut enums,
    )

    switch res {
        case Ok(cr) {
            return elf.WriteELF(
                path,
                cr.code,
                cr.entry_offset,
                cr.text_size,
            )
        }
        case Err(msg) {
            return Err("wpi:emit " + msg)
        }
    }
}

pub func WriteProgramItemsRef(
    mut funcs: &mut Vec<ast.FunctionDecl, _>,
    mut structs: &mut Vec<ast.StructDecl, _>,
    mut consts: &mut Vec<ast.ConstStatement, _>,
    mut enums: &mut Vec<ast.EnumDecl, _>,
    path: string,
) -> (Result<void, string>) {
    var res: Result<CodeResult, string> = emit_program_functions(
        funcs,
        structs,
        consts,
        enums,
    )

    switch res {
        case Ok(cr) {
            return elf.WriteELF(
                path,
                cr.code,
                cr.entry_offset,
                cr.text_size,
            )
        }
        case Err(msg) {
            return Err("wpi:emit " + msg)
        }
    }
}

// WriteProgram writes a minimal native binary for a Bak program.
pub func WriteProgram(
    program: &ast.Program,
    path: string,
) -> (Result<void, string>) {
    var res: Result<Vec<int, _>, string> = BuildProgram(program)

    switch res {
        case Ok(bytes) {
            return fs.writeFileBytes(
                &path,
                bytes,
            )
        }
        case Err(msg) {
            return Err(msg)
        }
    }
}

