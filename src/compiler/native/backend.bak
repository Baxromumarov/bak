func update_iterable_binding(
    mut state: &mut BackendEmitState,
    name: string,
    elem_info: Option<IterableInfo>,
) -> (void) {
    switch elem_info {
        case None {
            return
        }
        case Some(info) {
            if state.scopes.len() == 0 {
                return
            }

            mut var i: int = state.scopes.len() - 1

            while i >= 0 {
                mut var j: int = 0
                var n: int = (state.scopes[i]).iterables.len()

                while j < n {
                    if str_eq(
                        &((state.scopes[i]).iterables[j]).name,
                        &name,
                    ) {
                        add_iterable_binding(
                            state,
                            name,
                            info.size,
                            info.kind,
                            info.struct_name,
                            info.container_kind,
                        )

                        return
                    }

                    j = j + 1
                }

                if i == 0 {
                    break
                }

                i = i - 1
            }

            add_iterable_binding(
                state,
                name,
                info.size,
                info.kind,
                info.struct_name,
                info.container_kind,
            )

            return
        }
    }
}

func update_struct_binding(
    mut state: &mut BackendEmitState,
    name: string,
    struct_name: Option<string>,
) -> (void) {
    switch struct_name {
        case None {
            return
        }
        case Some(sn) {
            if state.scopes.len() == 0 {
                return
            }

            mut var i: int = state.scopes.len() - 1

            while i >= 0 {
                mut var j: int = 0
                var n: int = (state.scopes[i]).structs.len()

                while j < n {
                    if str_eq(
                        &((state.scopes[i]).structs[j]).name,
                        &name,
                    ) {
                        add_struct_binding(
                            state,
                            name,
                            sn,
                        )

                        return
                    }

                    j = j + 1
                }

                if i == 0 {
                    break
                }

                i = i - 1
            }

            add_struct_binding(
                state,
                name,
                sn,
            )

            return
        }
    }
}

func qualify_payload_struct_name(
    type_name: &string,
    enum_name: &string,
    state: &mut BackendEmitState,
) -> (string) {
    if string_contains_dot(type_name) {
        return copyString(type_name)
    }

    mut var last_dot: int = -1
    mut var i: int = 0

    while i < enum_name.len() {
        if (*enum_name)[i] == 46 {
            last_dot = i
        }

        i = i + 1
    }

    if last_dot > 0 {
        var prefix: string = enum_name.substring(
            0,
            last_dot,
        )
        var qualified: string = copyString(&prefix) + "." + copyString(type_name)

        switch find_struct_decl(
            &state.structs,
            &qualified,
        ) {
            case Some(_) {
                return qualified
            }
            case None {
            }
        }
    }

    switch find_struct_decl(
        &state.structs,
        type_name,
    ) {
        case Some(_) {
            return copyString(type_name)
        }
        case None {
        }
    }

    return copyString(type_name)
}

func iterable_elem_size(
    expr: &ast.Expression,
    state: &mut BackendEmitState,
) -> (Option<int>) {
    var infoOpt: Option<IterableInfo> = iterable_elem_info(
        expr,
        &None,
        state,
    )

    switch infoOpt {
        case Some(info) {
            return Some(info.size)
        }
        case None {
        }
    }

    return None
}

func struct_literal_name(
    expr: &ast.Expression,
    state: &mut BackendEmitState,
) -> (Option<string>) {
    switch *expr {
        case ast.Expression.StructLiteral(sl) {
            return Some(sl.Name.Value)
        }
        case ast.Expression.Identifier(id) {
            var res: Option<string> = resolve_struct_binding(
                state,
                &id.Value,
            )

            switch res {
                case Some(_) {
                    return res
                }
                case None {
                    var tOpt: Option<string> = resolve_local_type(
                        state,
                        &id.Value,
                    )

                    switch tOpt {
                        case Some(tname) {
                            return Some(tname)
                        }
                        case None {
                        }
                    }

                    return None
                }
            }
        }
        case ast.Expression.MutableIdentifier(id) {
            var res2: Option<string> = resolve_struct_binding(
                state,
                &id.Value,
            )

            switch res2 {
                case Some(_) {
                    return res2
                }
                case None {
                    var tOpt2: Option<string> = resolve_local_type(
                        state,
                        &id.Value,
                    )

                    switch tOpt2 {
                        case Some(tname2) {
                            return Some(tname2)
                        }
                        case None {
                        }
                    }

                    return None
                }
            }
        }
        case ast.Expression.FieldAccess(fe) {
            return field_access_struct_name(
                &fe,
                state,
            )
        }
        case ast.Expression.Index(ix) {
            return index_struct_name(
                &ix,
                state,
            )
        }
        case ast.Expression.MethodCall(mc) {
        }
        default {
        }
    }

    return None
}

func field_access_struct_name(
    fe: &ast.FieldAccessExpression,
    state: &mut BackendEmitState,
) -> (Option<string>) {
    var structOpt: Option<string> = struct_literal_name(
        &fe.Object,
        state,
    )

    switch structOpt {
        case None {
            return None
        }
        case Some(struct_name) {
            var declOpt: Option<ast.StructDecl> = find_struct_decl(
                &state.structs,
                &struct_name,
            )

            switch declOpt {
                case None {
                    return None
                }
                case Some(decl) {
                    var fieldOpt: Option<ast.StructField> = find_struct_field(
                        &decl,
                        &fe.Field.Value,
                    )

                    switch fieldOpt {
                        case None {
                            return None
                        }
                        case Some(field_decl) {
                            switch field_decl.Type {
                                case ast.TypeExpression.Simple(st) {
                                    var nestedOpt: Option<ast.StructDecl> = find_struct_decl(
                                        &state.structs,
                                        &st.Name,
                                    )

                                    switch nestedOpt {
                                        case Some(_) {
                                            return Some(st.Name)
                                        }
                                        case None {
                                        }
                                    }
                                }
                                default {
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    return None
}

func iterable_elem_info(
    expr: &ast.Expression,
    typeOpt: &Option<ast.TypeExpression>,
    state: &mut BackendEmitState,
) -> (Option<IterableInfo>) {
    switch *expr {
        case ast.Expression.StringLiteral(_) {
            return Some(
                IterableInfo{
                    container_kind: CONTAINER_KIND_STRING,
                    kind:           ELEM_KIND_STRING,
                    size:           1,
                    struct_name:    "",
                },
            )
        }
        case ast.Expression.VecLiteral(vl) {
            return vec_info_from_vec_literal(
                &vl,
                state,
            )
        }
        case ast.Expression.MethodCall(mc) {
            var objOpt: Option<IterableInfo> = iterable_elem_info(
                &mc.Object,
                &None,
                state,
            )

            switch objOpt {
                case Some(info) {
                    if info.container_kind == CONTAINER_KIND_STRING {
                        if mc.Method.Value == "substring" {
                            return Some(
                                IterableInfo{
                                    container_kind: CONTAINER_KIND_STRING,
                                    kind:           ELEM_KIND_STRING,
                                    size:           1,
                                    struct_name:    "",
                                },
                            )
                        }
                    }
                }
                case None {
                }
            }

            var vecOpt: Option<IterableInfo> = vec_info_from_method_call(
                &mc,
                typeOpt,
                state,
            )

            switch vecOpt {
                case Some(info) {
                    return Some(info)
                }
                case None {
                    return type_iterable_info(
                        typeOpt,
                        state,
                    )
                }
            }
        }
        case ast.Expression.Call(ce) {
            // Module-qualified calls or local calls
            switch ce.Function {
                case ast.Expression.Identifier(id) {
                    // Try to guess based on name or resolved function
                    if id.Value == "os.args" {
                        return Some(
                            IterableInfo{
                                container_kind: CONTAINER_KIND_VEC,
                                kind:           ELEM_KIND_STRING,
                                size:           8,
                                struct_name:    "",
                            },
                        )
                    }
                }
                default {
                }
            }
        }
        case ast.Expression.Identifier(id) {
            return iterable_info_from_binding(
                state,
                &id.Value,
            )
        }
        case ast.Expression.MutableIdentifier(id) {
            return iterable_info_from_binding(
                state,
                &id.Value,
            )
        }
        case ast.Expression.FieldAccess(fe) {
            return field_access_iterable_info(
                &fe,
                state,
            )
        }
        case ast.Expression.Index(ie) {
            // e.g. args[1] where args is Vec<string> -> element is string
            var containerOpt: Option<IterableInfo> = iterable_elem_info(
                &ie.Left,
                &None,
                state,
            )

            switch containerOpt {
                case Some(info) {
                    if info.container_kind == CONTAINER_KIND_VEC && info.kind == ELEM_KIND_STRING {
                        return Some(
                            IterableInfo{
                                container_kind: CONTAINER_KIND_STRING,
                                kind:           ELEM_KIND_STRING,
                                size:           1,
                                struct_name:    "",
                            },
                        )
                    }

                    if info.container_kind == CONTAINER_KIND_VEC && info.kind == ELEM_KIND_STRUCT {
                        return Some(
                            IterableInfo{
                                container_kind: CONTAINER_KIND_VEC,
                                kind:           ELEM_KIND_STRUCT,
                                size:           info.size,
                                struct_name:    info.struct_name,
                            },
                        )
                    }

                    if info.container_kind == CONTAINER_KIND_STRING {
                        // Indexing a string yields a char (scalar)
                        return Some(
                            IterableInfo{
                                container_kind: CONTAINER_KIND_STRING,
                                kind:           ELEM_KIND_SCALAR,
                                size:           1,
                                struct_name:    "",
                            },
                        )
                    }
                }
                case None {
                }
            }
        }
        case ast.Expression.Infix(ie) {
            if ie.Operator == "+" {
                var leftOpt: Option<IterableInfo> = iterable_elem_info(
                    &ie.Left,
                    &None,
                    state,
                )
                var rightOpt: Option<IterableInfo> = iterable_elem_info(
                    &ie.Right,
                    &None,
                    state,
                )

                switch leftOpt {
                    case Some(li) {
                        switch rightOpt {
                            case Some(ri) {
                                if li.container_kind == CONTAINER_KIND_STRING && ri.container_kind == CONTAINER_KIND_STRING {
                                    return Some(
                                        IterableInfo{
                                            container_kind: CONTAINER_KIND_STRING,
                                            kind:           ELEM_KIND_STRING,
                                            size:           1,
                                            struct_name:    "",
                                        },
                                    )
                                }
                            }
                            case None {
                            }
                        }
                    }
                    case None {
                    }
                }
            }
        }
        case ast.Expression.Borrow(be) {
            return iterable_elem_info(
                &be.Value,
                typeOpt,
                state,
            )
        }
        case ast.Expression.Deref(de) {
            return iterable_elem_info(
                &de.Value,
                typeOpt,
                state,
            )
        }
        case ast.Expression.Box(be2) {
            return iterable_elem_info(
                &be2.Value,
                typeOpt,
                state,
            )
        }
        default {
        }
    }

    return type_iterable_info(
        typeOpt,
        state,
    )
}

func iterable_info_from_binding(
    state: &mut BackendEmitState,
    name: &string,
) -> (Option<IterableInfo>) {
    var szOpt: Option<int> = resolve_iterable_binding(
        state,
        name,
    )

    switch szOpt {
        case None {
            return None
        }
        case Some(sz) {
            var kindOpt: Option<int> = resolve_iterable_kind(
                state,
                name,
            )
            mut var kind: int = ELEM_KIND_SCALAR

            switch kindOpt {
                case Some(k) {
                    kind = k
                }
                case None {
                }
            }

            var contOpt: Option<int> = resolve_iterable_container_kind(
                state,
                name,
            )
            mut var cont: int = CONTAINER_KIND_VEC

            switch contOpt {
                case Some(k) {
                    cont = k
                }
                case None {
                }
            }

            var structOpt: Option<string> = resolve_iterable_struct(
                state,
                name,
            )

            switch structOpt {
                case Some(sn) {
                    return Some(
                        IterableInfo{
                            container_kind: cont,
                            kind:           kind,
                            size:           sz,
                            struct_name:    sn,
                        },
                    )
                }
                case None {
                    return Some(
                        IterableInfo{
                            container_kind: cont,
                            kind:           kind,
                            size:           sz,
                            struct_name:    "",
                        },
                    )
                }
            }
        }
    }
}

func type_iterable_info(
    typeOpt: &Option<ast.TypeExpression>,
    state: &mut BackendEmitState,
) -> (Option<IterableInfo>) {
    switch *typeOpt {
        case Some(t) {
            return iterable_info_from_type(
                &t,
                state,
            )
        }
        case None {
        }
    }

    return None
}

func iterable_info_from_type(
    t: &ast.TypeExpression,
    state: &mut BackendEmitState,
) -> (Option<IterableInfo>) {
    switch *t {
        case ast.TypeExpression.Simple(st) {
            if st.Name == "string" {
                return Some(
                    IterableInfo{
                        container_kind: CONTAINER_KIND_STRING,
                        kind:           ELEM_KIND_STRING,
                        size:           1,
                        struct_name:    "",
                    },
                )
            }

            return None
        }
        case ast.TypeExpression.BorrowRef(bt) {
            return iterable_info_from_type(
                &bt.Inner,
                state,
            )
        }
        case ast.TypeExpression.Generic(gt) {
            if gt.Name == "Vec" && gt.TypeParams.len() > 0 {
                var elemOpt: Option<IterableInfo> = vec_elem_info_from_type(
                    &gt.TypeParams[0],
                    &state.structs,
                )

                switch elemOpt {
                    case Some(info) {
                        return Some(
                            IterableInfo{
                                container_kind: CONTAINER_KIND_VEC,
                                kind:           info.kind,
                                size:           info.size,
                                struct_name:    info.struct_name,
                            },
                        )
                    }
                    case None {
                    }
                }
            }

            if gt.Name == "Option" {
                return Some(
                    IterableInfo{
                        container_kind: CONTAINER_KIND_OPTION,
                        kind:           ELEM_KIND_SCALAR,
                        size:           8,
                        struct_name:    "",
                    },
                )
            }

            if gt.Name == "Result" {
                return Some(
                    IterableInfo{
                        container_kind: CONTAINER_KIND_RESULT,
                        kind:           ELEM_KIND_SCALAR,
                        size:           8,
                        struct_name:    "",
                    },
                )
            }
        }
        default {
        }
    }

    return None
}

func struct_name_from_type(
    t: &ast.TypeExpression,
    state: &mut BackendEmitState,
) -> (Option<string>) {
    switch *t {
        case ast.TypeExpression.Simple(st) {
            if st.Name == "int" || st.Name == "bool" || st.Name == "char" || st.Name == "string" || st.Name == "void" {
                return None
            }

            if string_contains_dot(&st.Name) {
                return Some(st.Name)
            }

            var suffix: string = struct_name_suffix(&st.Name)
            var declOpt: Option<ast.StructDecl> = find_struct_decl(
                &state.structs,
                &st.Name,
            )

            switch declOpt {
                case Some(sd) {
                    return Some(sd.Name.Value)
                }
                case None {
                }
            }

            if suffix == "Duration" || suffix == "Time" {
                return Some(st.Name)
            }
        }
        case ast.TypeExpression.BorrowRef(bt) {
            return struct_name_from_type(
                &bt.Inner,
                state,
            )
        }
        default {
        }
    }

    return None
}

func struct_name_from_type_opt(
    typeOpt: &Option<ast.TypeExpression>,
    state: &mut BackendEmitState,
) -> (Option<string>) {
    switch *typeOpt {
        case Some(t) {
            return struct_name_from_type(
                &t,
                state,
            )
        }
        case None {
        }
    }

    return None
}

func vec_elem_info_from_type(
    t: &ast.TypeExpression,
    structs: &Vec<ast.StructDecl, _>,
) -> (Option<IterableInfo>) {
    switch *t {
        case ast.TypeExpression.Simple(st) {
            if st.Name == "int" {
                return Some(
                    IterableInfo{
                        container_kind: CONTAINER_KIND_VEC,
                        kind:           ELEM_KIND_SCALAR,
                        size:           8,
                        struct_name:    "",
                    },
                )
            }

            if st.Name == "bool" {
                return Some(
                    IterableInfo{
                        container_kind: CONTAINER_KIND_VEC,
                        kind:           ELEM_KIND_SCALAR,
                        size:           8,
                        struct_name:    "",
                    },
                )
            }

            if st.Name == "char" {
                return Some(
                    IterableInfo{
                        container_kind: CONTAINER_KIND_VEC,
                        kind:           ELEM_KIND_SCALAR,
                        size:           8,
                        struct_name:    "",
                    },
                )
            }

            if st.Name == "string" {
                return Some(
                    IterableInfo{
                        container_kind: CONTAINER_KIND_VEC,
                        kind:           ELEM_KIND_STRING,
                        size:           8,
                        struct_name:    "",
                    },
                )
            }

            if string_contains_dot(&st.Name) {
                return Some(
                    IterableInfo{
                        container_kind: CONTAINER_KIND_VEC,
                        kind:           ELEM_KIND_STRUCT,
                        size:           8,
                        struct_name:    st.Name,
                    },
                )
            }

            var declOpt: Option<ast.StructDecl> = find_struct_decl(
                structs,
                &st.Name,
            )

            switch declOpt {
                case Some(decl) {
                    var layoutRes: Result<layout.StructLayout, string> = layout.struct_layout(
                        &decl,
                        structs,
                    )

                    switch layoutRes {
                        case Ok(st_layout) {
                            return Some(
                                IterableInfo{
                                    container_kind: CONTAINER_KIND_VEC,
                                    kind:           ELEM_KIND_STRUCT,
                                    size:           8,
                                    struct_name:    st.Name,
                                },
                            )
                        }
                        case Err(_) {
                        }
                    }
                }
                case None {
                }
            }

            // Fallback: treat unknown/user simple types (e.g. enum payload types)
            // as scalar slots in Vec elements for iteration lowering.
            return Some(
                IterableInfo{
                    container_kind: CONTAINER_KIND_VEC,
                    kind:           ELEM_KIND_SCALAR,
                    size:           8,
                    struct_name:    "",
                },
            )
        }
        case ast.TypeExpression.Generic(gt) {
            if gt.Name == "Vec" {
                return Some(
                    IterableInfo{
                        container_kind: CONTAINER_KIND_VEC,
                        kind:           ELEM_KIND_VEC,
                        size:           8,
                        struct_name:    "",
                    },
                )
            }

            if gt.Name == "Option" || gt.Name == "Result" {
                return Some(
                    IterableInfo{
                        container_kind: CONTAINER_KIND_VEC,
                        kind:           ELEM_KIND_SCALAR,
                        size:           8,
                        struct_name:    "",
                    },
                )
            }
        }
        default {
        }
    }

    return None
}

func vec_info_from_vec_literal(
    vl: &ast.VecLiteral,
    state: &mut BackendEmitState,
) -> (Option<IterableInfo>) {
    if vl.Elements.len() == 0 {
        return Some(
            IterableInfo{
                container_kind: CONTAINER_KIND_VEC,
                kind:           ELEM_KIND_SCALAR,
                size:           8,
                struct_name:    "",
            },
        )
    }

    var first: ast.Expression = vl.Elements[0]

    switch first {
        case ast.Expression.IntegerLiteral(_) {
            return Some(
                IterableInfo{
                    container_kind: CONTAINER_KIND_VEC,
                    kind:           ELEM_KIND_SCALAR,
                    size:           8,
                    struct_name:    "",
                },
            )
        }
        case ast.Expression.BooleanLiteral(_) {
            return Some(
                IterableInfo{
                    container_kind: CONTAINER_KIND_VEC,
                    kind:           ELEM_KIND_SCALAR,
                    size:           8,
                    struct_name:    "",
                },
            )
        }
        case ast.Expression.CharLiteral(_) {
            return Some(
                IterableInfo{
                    container_kind: CONTAINER_KIND_VEC,
                    kind:           ELEM_KIND_SCALAR,
                    size:           8,
                    struct_name:    "",
                },
            )
        }
        case ast.Expression.StringLiteral(_) {
            return Some(
                IterableInfo{
                    container_kind: CONTAINER_KIND_VEC,
                    kind:           ELEM_KIND_STRING,
                    size:           8,
                    struct_name:    "",
                },
            )
        }
        case ast.Expression.StructLiteral(sl) {
            var declOpt: Option<ast.StructDecl> = find_struct_decl(
                &state.structs,
                &sl.Name.Value,
            )

            switch declOpt {
                case Some(decl) {
                    var layoutRes: Result<layout.StructLayout, string> = layout.struct_layout(
                        &decl,
                        &state.structs,
                    )

                    switch layoutRes {
                        case Ok(st_layout) {
                            return Some(
                                IterableInfo{
                                    container_kind: CONTAINER_KIND_VEC,
                                    kind:           ELEM_KIND_STRUCT,
                                    size:           8,
                                    struct_name:    sl.Name.Value,
                                },
                            )
                        }
                        case Err(_) {
                        }
                    }
                }
                case None {
                }
            }
        }
        default {
        }
    }

    return None
}

func vec_info_from_method_call(
    mc: &ast.MethodCallExpression,
    typeOpt: &Option<ast.TypeExpression>,
    state: &mut BackendEmitState,
) -> (Option<IterableInfo>) {
    switch mc.Object {
        case ast.Expression.Identifier(id) {
            if id.Value == "Vec" {
                if mc.Method.Value == "new" || mc.Method.Value == "with_cap" || mc.Method.Value == "from" {
                    return type_iterable_info(
                        typeOpt,
                        state,
                    )
                }
            }
        }
        default {
        }
    }

    return None
}

func field_access_iterable_info(
    fe: &ast.FieldAccessExpression,
    state: &mut BackendEmitState,
) -> (Option<IterableInfo>) {
    var structOpt: Option<string> = struct_literal_name(
        &fe.Object,
        state,
    )

    switch structOpt {
        case None {
            return fallback_iterable_info_by_field_name(
                &fe.Field.Value,
                &state.structs,
            )
        }
        case Some(struct_name) {
            var declOpt: Option<ast.StructDecl> = find_struct_decl(
                &state.structs,
                &struct_name,
            )

            switch declOpt {
                case None {
                    return fallback_iterable_info_by_field_name(
                        &fe.Field.Value,
                        &state.structs,
                    )
                }
                case Some(decl) {
                    var fieldOpt: Option<ast.StructField> = find_struct_field(
                        &decl,
                        &fe.Field.Value,
                    )

                    switch fieldOpt {
                        case None {
                            return fallback_iterable_info_by_field_name(
                                &fe.Field.Value,
                                &state.structs,
                            )
                        }
                        case Some(field_decl) {
                            switch field_decl.Type {
                                case ast.TypeExpression.Simple(st) {
                                    if st.Name == "string" {
                                        return Some(
                                            IterableInfo{
                                                container_kind: CONTAINER_KIND_STRING,
                                                kind:           ELEM_KIND_STRING,
                                                size:           1,
                                                struct_name:    "",
                                            },
                                        )
                                    }
                                }
                                case ast.TypeExpression.Generic(gt) {
                                    if gt.Name == "Vec" && gt.TypeParams.len() > 0 {
                                        var elemOpt: Option<IterableInfo> = vec_elem_info_from_type(
                                            &gt.TypeParams[0],
                                            &state.structs,
                                        )

                                        switch elemOpt {
                                            case Some(info) {
                                                return Some(
                                                    IterableInfo{
                                                        container_kind: CONTAINER_KIND_VEC,
                                                        kind:           info.kind,
                                                        size:           info.size,
                                                        struct_name:    info.struct_name,
                                                    },
                                                )
                                            }
                                            case None {
                                            }
                                        }
                                    }
                                }
                                default {
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    return None
}

func fallback_iterable_info_by_field_name(
    field_name: &string,
    structs: &Vec<ast.StructDecl, _>,
) -> (Option<IterableInfo>) {
    mut var hits: int = 0
    mut var found: Option<IterableInfo> = None
    mut var si: int = 0

    while si < structs.len() {
        var sd: &ast.StructDecl = &(*structs)[si]
        mut var fi: int = 0

        while fi < (*sd).Fields.len() {
            var f: &ast.StructField = &(*sd).Fields[fi]

            if !str_eq(
                &(*f).Name.Value,
                field_name,
            ) {
                fi = fi + 1
                continue
            }

            switch (*f).Type {
                case ast.TypeExpression.Simple(st) {
                    if st.Name == "string" {
                        hits = hits + 1
                        found = Some(
                            IterableInfo{
                                container_kind: CONTAINER_KIND_STRING,
                                kind:           ELEM_KIND_STRING,
                                size:           1,
                                struct_name:    "",
                            },
                        )
                    }
                }
                case ast.TypeExpression.Generic(gt) {
                    if gt.Name == "Vec" && gt.TypeParams.len() > 0 {
                        var elemOpt: Option<IterableInfo> = vec_elem_info_from_type(
                            &gt.TypeParams[0],
                            structs,
                        )

                        switch elemOpt {
                            case Some(info) {
                                hits = hits + 1
                                found = Some(
                                    IterableInfo{
                                        container_kind: CONTAINER_KIND_VEC,
                                        kind:           info.kind,
                                        size:           info.size,
                                        struct_name:    info.struct_name,
                                    },
                                )
                            }
                            case None {
                            }
                        }
                    }
                }
                default {
                }
            }

            fi = fi + 1
        }

        si = si + 1
    }

    if hits > 0 {
        return found
    }

    return None
}

func fallback_struct_name_by_field_name(
    field_name: &string,
    structs: &Vec<ast.StructDecl, _>,
) -> (Option<string>) {
    mut var si: int = 0

    while si < structs.len() {
        var sd: &ast.StructDecl = &(*structs)[si]
        mut var fi: int = 0

        while fi < (*sd).Fields.len() {
            var f: &ast.StructField = &(*sd).Fields[fi]

            if str_eq(
                &(*f).Name.Value,
                field_name,
            ) {
                return Some((*sd).Name.Value)
            }

            fi = fi + 1
        }

        si = si + 1
    }

    return None
}

func index_struct_name(
    ix: &ast.IndexExpression,
    state: &mut BackendEmitState,
) -> (Option<string>) {
    var infoOpt: Option<IterableInfo> = iterable_elem_info(
        &ix.Left,
        &None,
        state,
    )

    switch infoOpt {
        case Some(info) {
            if info.kind == ELEM_KIND_STRUCT && info.struct_name != "" {
                return Some(info.struct_name)
            }
        }
        case None {
        }
    }

    return None
}

func emit_for_range(
    fs: &ast.ForStatement,
    r: ast.RangeExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var loop_off: int = declare_for_variable(
        state,
        fs.Variable.Value,
    )
    var resStart: Result<void, string> = emit_expr(
        &r.Start,
        state,
        code,
    )

    switch resStart {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    if !r.StartInclusive {
        x86.emit_mov_reg_imm32(
            code,
            x86.RCX,
            1,
        )
        x86.emit_add_reg_reg(
            code,
            x86.RAX,
            x86.RCX,
        )
    }

    x86.emit_mov_mem_rbp_reg(
        code,
        loop_off,
        x86.RAX,
    )

    var loop_start: int = code.len()
    var resEnd: Result<void, string> = emit_expr(
        &r.End,
        state,
        code,
    )

    switch resEnd {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_mov_reg_mem_rbp(
        code,
        x86.RCX,
        loop_off,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.RCX,
        x86.RAX,
    )

    if r.EndInclusive {
        x86.emit_setle(code)
    } else {
        x86.emit_setl(code)
    }

    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_imm: int = emit_jz_placeholder(code)
    mut var for_range_break_sites: Vec<int, _> = Vec.with_cap(8)
    mut var for_range_continue_sites: Vec<int, _> = Vec.with_cap(8)
    mut var for_range_ctx: LoopContext = LoopContext{
        break_sites:     for_range_break_sites,
        continue_sites:  for_range_continue_sites,
        continue_target: 0,
    }

    for_range_ctx.break_sites = for_range_break_sites
    for_range_ctx.continue_sites = for_range_continue_sites
    push_loop(
        &mut state.loop_stack,
        for_range_ctx,
    )

    var resBody: Result<void, string> = emit_block(
        &fs.Body,
        state,
        code,
    )

    switch resBody {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    var inc_start: int = code.len()

    update_continue_target(
        &mut state.loop_stack,
        inc_start,
    )
    x86.emit_mov_reg_mem_rbp(
        code,
        x86.RAX,
        loop_off,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        1,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RAX,
        x86.RCX,
    )
    x86.emit_mov_mem_rbp_reg(
        code,
        loop_off,
        x86.RAX,
    )
    emit_jmp_to(
        code,
        loop_start,
    )

    var end: int = code.len()

    patch_rel32(
        code,
        jz_imm,
        end,
    )

    var ctxRes: Result<LoopContext, string> = pop_loop(&mut state.loop_stack)

    switch ctxRes {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(ctx) {
            patch_sites(
                code,
                &ctx.break_sites,
                end,
            )
            patch_sites(
                code,
                &ctx.continue_sites,
                ctx.continue_target,
            )
        }
    }

    return Ok(void)
}

func emit_for_iterable(
    fs: &ast.ForStatement,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var infoOpt: Option<IterableInfo> = iterable_elem_info(
        &fs.Iterable,
        &None,
        state,
    )
    mut var elem_size: int = 0
    mut var elem_kind: int = ELEM_KIND_SCALAR
    mut var elem_struct: string = ""

    switch infoOpt {
        case None {
            return Err(ERR_NATIVE_UNSUPPORTED)
        }
        case Some(info) {
            elem_size = info.size
            elem_kind = info.kind
            elem_struct = info.struct_name
        }
    }

    var loop_off: int = declare_for_variable(
        state,
        fs.Variable.Value,
    )
    var idx_off: int = declare_local(
        state,
        "__for_idx__",
    )
    var len_off: int = declare_local(
        state,
        "__for_len__",
    )
    var data_off: int = declare_local(
        state,
        "__for_data__",
    )

    if elem_kind == ELEM_KIND_STRUCT {
        update_struct_binding(
            state,
            fs.Variable.Value,
            Some(elem_struct),
        )
    } else {
        update_struct_binding(
            state,
            fs.Variable.Value,
            None,
        )
    }

    x86.emit_mov_rax_imm32(
        code,
        0,
    )
    x86.emit_mov_mem_rbp_reg(
        code,
        idx_off,
        x86.RAX,
    )

    var resIter: Result<void, string> = emit_expr(
        &fs.Iterable,
        state,
        code,
    )

    switch resIter {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    // header layout: [ptr, len]
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RCX,
        x86.RAX,
        0,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RDX,
        x86.RAX,
        8,
    )
    x86.emit_mov_mem_rbp_reg(
        code,
        data_off,
        x86.RCX,
    )
    x86.emit_mov_mem_rbp_reg(
        code,
        len_off,
        x86.RDX,
    )

    var loop_start: int = code.len()

    x86.emit_mov_reg_mem_rbp(
        code,
        x86.RAX,
        idx_off,
    )
    x86.emit_mov_reg_mem_rbp(
        code,
        x86.RCX,
        len_off,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.RAX,
        x86.RCX,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_imm: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_mem_rbp(
        code,
        x86.RCX,
        data_off,
    )
    x86.emit_mov_reg_mem_rbp(
        code,
        x86.RAX,
        idx_off,
    )
    // Uniform 8-byte element load: all Vec elements are 8 bytes
    // RAX = index, RCX = data_ptr -> RAX = data_ptr[index * 8]
    x86.emit_mov_reg_mem_base_index(
        code,
        x86.RAX,
        x86.RCX,
        x86.RAX,
        8,
    )
    x86.emit_mov_mem_rbp_reg(
        code,
        loop_off,
        x86.RAX,
    )

    mut var for_iter_break_sites: Vec<int, _> = Vec.with_cap(8)
    mut var for_iter_continue_sites: Vec<int, _> = Vec.with_cap(8)
    mut var for_iter_ctx: LoopContext = LoopContext{
        break_sites:     for_iter_break_sites,
        continue_sites:  for_iter_continue_sites,
        continue_target: 0,
    }

    for_iter_ctx.break_sites = for_iter_break_sites
    for_iter_ctx.continue_sites = for_iter_continue_sites
    push_loop(
        &mut state.loop_stack,
        for_iter_ctx,
    )

    var resBody: Result<void, string> = emit_block(
        &fs.Body,
        state,
        code,
    )

    switch resBody {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    var inc_start: int = code.len()

    update_continue_target(
        &mut state.loop_stack,
        inc_start,
    )
    x86.emit_mov_reg_mem_rbp(
        code,
        x86.RAX,
        idx_off,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        1,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RAX,
        x86.RCX,
    )
    x86.emit_mov_mem_rbp_reg(
        code,
        idx_off,
        x86.RAX,
    )
    emit_jmp_to(
        code,
        loop_start,
    )

    var end: int = code.len()

    patch_rel32(
        code,
        jz_imm,
        end,
    )

    var ctxRes: Result<LoopContext, string> = pop_loop(&mut state.loop_stack)

    switch ctxRes {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(ctx) {
            patch_sites(
                code,
                &ctx.break_sites,
                end,
            )
            patch_sites(
                code,
                &ctx.continue_sites,
                ctx.continue_target,
            )
        }
    }

    return Ok(void)
}

func debug_expr_kind(expr: &ast.Expression) -> (string) {
    switch *expr {
        case ast.Expression.Identifier(id) {
            return "identifier:" + id.Value
        }
        case ast.Expression.MutableIdentifier(id) {
            return "mutable_identifier:" + id.Value
        }
        case ast.Expression.FieldAccess(fe) {
            return "field_access:" + fe.Field.Value
        }
        case ast.Expression.MethodCall(mc) {
            return "method_call:" + mc.Method.Value
        }
        case ast.Expression.Call(_) {
            return "call"
        }
        case ast.Expression.Deref(de) {
            return "deref(" + debug_expr_kind(&de.Value) + ")"
        }
        case ast.Expression.Borrow(be) {
            return "borrow(" + debug_expr_kind(&be.Value) + ")"
        }
        case ast.Expression.Index(_) {
            return "index"
        }
        case ast.Expression.Range(_) {
            return "range"
        }
        case ast.Expression.VecLiteral(_) {
            return "vec_literal"
        }
        case ast.Expression.StringLiteral(_) {
            return "string_literal"
        }
        case ast.Expression.StructLiteral(sl) {
            return "struct_literal:" + sl.Name.Value
        }
        case ast.Expression.EnumVariant(ev) {
            return "enum_variant:" + ev.Variant.Value
        }
        case ast.Expression.TypeConversion(tc) {
            return "type_conversion:" + tc.TypeName
        }
        case ast.Expression.Box(_) {
            return "box"
        }
        case ast.Expression.FunctionLiteral(_) {
            return "function_literal"
        }
        default {
        }
    }

    return "other"
}

func expr_case_id(expr: &ast.Expression) -> (int) {
    switch *expr {
        case ast.Expression.Identifier(_) {
            return 1
        }
        case ast.Expression.MutableIdentifier(_) {
            return 2
        }
        case ast.Expression.IntegerLiteral(_) {
            return 3
        }
        case ast.Expression.FloatLiteral(_) {
            return 4
        }
        case ast.Expression.StringLiteral(_) {
            return 5
        }
        case ast.Expression.CharLiteral(_) {
            return 6
        }
        case ast.Expression.BooleanLiteral(_) {
            return 7
        }
        case ast.Expression.VoidLiteral(_) {
            return 8
        }
        case ast.Expression.Prefix(_) {
            return 9
        }
        case ast.Expression.Infix(_) {
            return 10
        }
        case ast.Expression.Call(_) {
            return 11
        }
        case ast.Expression.TypeConversion(_) {
            return 12
        }
        case ast.Expression.MethodCall(_) {
            return 13
        }
        case ast.Expression.FieldAccess(_) {
            return 14
        }
        case ast.Expression.Index(_) {
            return 15
        }
        case ast.Expression.StructLiteral(_) {
            return 16
        }
        case ast.Expression.VecLiteral(_) {
            return 17
        }
        case ast.Expression.Tuple(_) {
            return 18
        }
        case ast.Expression.Range(_) {
            return 19
        }
        case ast.Expression.EnumVariant(_) {
            return 20
        }
        case ast.Expression.Borrow(_) {
            return 21
        }
        case ast.Expression.Box(_) {
            return 22
        }
        case ast.Expression.Deref(_) {
            return 23
        }
        case ast.Expression.FunctionLiteral(_) {
            return 24
        }
        default {
        }
    }

    return 0
}

func expr_qualified_name(expr: &ast.Expression) -> (Option<string>) {
    switch *expr {
        case ast.Expression.Identifier(id) {
            return Some(id.Value)
        }
        case ast.Expression.MutableIdentifier(id) {
            return Some(id.Value)
        }
        case ast.Expression.FieldAccess(fe) {
            switch expr_qualified_name(&fe.Object) {
                case Some(base) {
                    return Some(base + "." + fe.Field.Value)
                }
                case None {
                }
            }
        }
        default {
        }
    }

    return None
}

func quick_is_local_type(
    expr: &ast.Expression,
    type_name: &string,
    state: &mut BackendEmitState,
) -> (bool) {
    switch *expr {
        case ast.Expression.Identifier(id) {
            switch resolve_local_type(
                state,
                &id.Value,
            ) {
                case Some(tname) {
                    return tname == *type_name
                }
                case None {
                }
            }
        }
        case ast.Expression.MutableIdentifier(id) {
            switch resolve_local_type(
                state,
                &id.Value,
            ) {
                case Some(tname) {
                    return tname == *type_name
                }
                case None {
                }
            }
        }
        default {
        }
    }

    return false
}

func quick_is_string_eq_expr(
    expr: &ast.Expression,
    state: &mut BackendEmitState,
) -> (bool) {
    switch *expr {
        case ast.Expression.StringLiteral(_) {
            return true
        }
        default {
            return quick_is_local_type(
                expr,
                &"string",
                state,
            )
        }
    }
}

func quick_is_scalar_eq_expr(
    expr: &ast.Expression,
    state: &mut BackendEmitState,
) -> (bool) {
    switch *expr {
        case ast.Expression.IntegerLiteral(_) {
            return true
        }
        case ast.Expression.BooleanLiteral(_) {
            return true
        }
        case ast.Expression.CharLiteral(_) {
            return true
        }
        default {
            if quick_is_local_type(
                expr,
                &"int",
                state,
            ) {
                return true
            }

            if quick_is_local_type(
                expr,
                &"bool",
                state,
            ) {
                return true
            }

            if quick_is_local_type(
                expr,
                &"char",
                state,
            ) {
                return true
            }
        }
    }

    return false
}

func has_eq_literal_operand(
    left: &ast.Expression,
    right: &ast.Expression,
) -> (bool) {
    switch *left {
        case ast.Expression.IntegerLiteral(_) {
            return true
        }
        case ast.Expression.BooleanLiteral(_) {
            return true
        }
        case ast.Expression.CharLiteral(_) {
            return true
        }
        case ast.Expression.StringLiteral(_) {
            return true
        }
        default {
        }
    }

    switch *right {
        case ast.Expression.IntegerLiteral(_) {
            return true
        }
        case ast.Expression.BooleanLiteral(_) {
            return true
        }
        case ast.Expression.CharLiteral(_) {
            return true
        }
        case ast.Expression.StringLiteral(_) {
            return true
        }
        default {
        }
    }

    return false
}

func emit_scalar_equals_exprs(
    left: &ast.Expression,
    right: &ast.Expression,
    negate: bool,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var leftRes: Result<void, string> = emit_expr(
        left,
        state,
        code,
    )

    switch leftRes {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_push_reg(
        code,
        x86.RAX,
    )

    var rightRes: Result<void, string> = emit_expr(
        right,
        state,
        code,
    )

    switch rightRes {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_pop_reg(
        code,
        x86.RCX,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.RCX,
        x86.RAX,
    )

    if negate {
        x86.emit_setne(code)
    } else {
        x86.emit_sete(code)
    }

    x86.emit_movzx_rax_al(code)

    return Ok(void)
}

func qualified_field_access_name(
    fe: &ast.FieldAccessExpression,
) -> (Option<string>) {
    switch expr_qualified_name(&fe.Object) {
        case Some(base) {
            return Some(base + "." + fe.Field.Value)
        }
        case None {
        }
    }

    return None
}

func field_access_root_is_local(
    expr: &ast.Expression,
    state: &mut BackendEmitState,
) -> (bool) {
    switch *expr {
        case ast.Expression.Identifier(id) {
            switch resolve_local(
                state,
                &id.Value,
            ) {
                case Some(_) {
                    return true
                }
                case None {
                }
            }
        }
        case ast.Expression.MutableIdentifier(id) {
            switch resolve_local(
                state,
                &id.Value,
            ) {
                case Some(_) {
                    return true
                }
                case None {
                }
            }
        }
        case ast.Expression.FieldAccess(fe) {
            return field_access_root_is_local(
                &fe.Object,
                state,
            )
        }
        default {
        }
    }

    return false
}

func assignment_target_name(expr: &ast.Expression) -> (Option<string>) {
    switch *expr {
        case ast.Expression.Identifier(id) {
            return Some(id.Value)
        }
        case ast.Expression.MutableIdentifier(id) {
            return Some(id.Value)
        }
        default {
        }
    }

    return None
}

func call_target_name(expr: &ast.Expression) -> (Option<string>) {
    switch *expr {
        case ast.Expression.Identifier(id) {
            return Some(id.Value)
        }
        case ast.Expression.MutableIdentifier(id) {
            return Some(id.Value)
        }
        default {
        }
    }

    return None
}

func emit_call(
    ce: &ast.CallExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // debug trace removed
    var nameOpt: Option<string> = call_target_name(&ce.Function)

    // debug trace removed
    switch nameOpt {
        case None {
            return Err("native: unsupported @emit_call_expr target")
        }
        case Some(name) {
            // debug trace removed
            var dispatchRes: Result<void, string> = emit_call_builtin_dispatch(
                &name,
                ce,
                state,
                code,
            )

            // debug trace removed
            switch dispatchRes {
                case Ok(_) {
                    return Ok(void)
                }
                case Err(msg) {
                    if msg != CALL_TARGET_FALLTHROUGH {
                        return Err(msg)
                    }
                }
            }

            return emit_call_named_function(
                &name,
                ce,
                state,
                code,
            )
        }
    }
}

func emit_call_builtin_dispatch(
    name: &string,
    ce: &ast.CallExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // debug trace removed
    var langRes: Result<void, string> = emit_call_builtin_language(
        name,
        ce,
        state,
        code,
    )

    // debug trace removed
    switch langRes {
        case Ok(_) {
            return Ok(void)
        }
        case Err(msg) {
            if msg != CALL_TARGET_FALLTHROUGH {
                return Err(msg)
            }
        }
    }

    var osRes: Result<void, string> = emit_call_builtin_os(
        name,
        ce,
        state,
        code,
    )

    // debug trace removed
    switch osRes {
        case Ok(_) {
            return Ok(void)
        }
        case Err(msg) {
            if msg != CALL_TARGET_FALLTHROUGH {
                return Err(msg)
            }
        }
    }

    // debug trace removed
    return emit_call_builtin_fs(
        name,
        ce,
        state,
        code,
    )
}

func emit_call_builtin_language(
    name: &string,
    ce: &ast.CallExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // Handle built-in println/print
    if *name == "println" {
        return emit_builtin_println(
            ce,
            state,
            code,
        )
    }

    if *name == "print" {
        return emit_builtin_print(
            ce,
            state,
            code,
        )
    }

    // Treat primitive type constructors as casts (int/char/bool).
    if *name == "int" || *name == "char" || *name == "bool" {
        if ce.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_expr(
            &ce.Arguments[0],
            state,
            code,
        )
    }

    // Built-in len(x) for strings/Vecs
    if *name == "len" {
        if ce.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        if is_vec_expr(
            &ce.Arguments[0],
            state,
        ) {
            return emit_vec_len(
                &ce.Arguments[0],
                state,
                code,
            )
        }

        if is_string_expr(
            &ce.Arguments[0],
            state,
        ) {
            return emit_string_len(
                &ce.Arguments[0],
                state,
                code,
            )
        }

        return Err(ERR_NATIVE_BAD_ARGS)
    }

    return Err(CALL_TARGET_FALLTHROUGH)
}

func emit_call_builtin_stub_result_ok_int(
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        0,
    )

    return emit_result_ok_int_from_reg(
        x86.RAX,
        state,
        code,
    )
}

func emit_call_builtin_empty_string_result(
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var empty: string = ""
    var res: Result<void, string> = emit_string_literal(
        &empty,
        state,
        code,
    )

    switch res {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    return emit_result_ok_int_from_reg(
        x86.RAX,
        state,
        code,
    )
}

func emit_call_builtin_os(
    name: &string,
    ce: &ast.CallExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    if *name == "__builtin_args" {
        return emit_os_args(
            state,
            code,
        )
    }

    if *name == "__builtin_string_from_bytes" {
        if ce.Arguments.len() != 3 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_builtin_string_from_bytes(
            &ce.Arguments[0],
            &ce.Arguments[1],
            &ce.Arguments[2],
            state,
            code,
        )
    }

    if *name == "__builtin_exit" {
        if ce.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        var res: Result<void, string> = emit_expr(
            &ce.Arguments[0],
            state,
            code,
        )

        switch res {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        x86.emit_mov_reg_reg(
            code,
            x86.RDI,
            x86.RAX,
        )
        x86.emit_mov_rax_imm32(
            code,
            60,
        )
        emit_raw_syscall(code)

        return Ok(void)
    }

    if *name == "__builtin_getenv" {
        if ce.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_os_getenv(
            &ce.Arguments[0],
            state,
            code,
        )
    }

    if *name == "__builtin_cwd" {
        if ce.Arguments.len() != 0 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_os_cwd(
            state,
            code,
        )
    }

    if *name == "__builtin_setenv" {
        if ce.Arguments.len() != 2 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_call_builtin_stub_result_ok_int(
            state,
            code,
        )
    }

    if *name == "__builtin_chdir" {
        if ce.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_call_builtin_stub_result_ok_int(
            state,
            code,
        )
    }

    if *name == "__builtin_chmod" {
        if ce.Arguments.len() != 2 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_os_chmod(
            &ce.Arguments[0],
            &ce.Arguments[1],
            state,
            code,
        )
    }

    if *name == "__builtin_executable" {
        if ce.Arguments.len() != 0 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_call_builtin_empty_string_result(
            state,
            code,
        )
    }

    if *name == "__builtin_user_home_dir" {
        if ce.Arguments.len() != 0 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_call_builtin_empty_string_result(
            state,
            code,
        )
    }

    if *name == "__builtin_hostname" {
        if ce.Arguments.len() != 0 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_call_builtin_empty_string_result(
            state,
            code,
        )
    }

    if *name == "__builtin_temp_dir" {
        if ce.Arguments.len() != 0 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        var tmp: string = "/tmp"

        return emit_string_literal(
            &tmp,
            state,
            code,
        )
    }

    if *name == "__builtin_exec" {
        if ce.Arguments.len() != 2 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        var msg: string = ERR_NATIVE_UNSUPPORTED

        return emit_result_err_string_literal(
            &msg,
            state,
            code,
        )
    }

    return Err(CALL_TARGET_FALLTHROUGH)
}

func emit_call_builtin_fs(
    name: &string,
    ce: &ast.CallExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var ioRes: Result<void, string> = emit_call_builtin_fs_io(
        name,
        ce,
        state,
        code,
    )

    switch ioRes {
        case Ok(_) {
            return Ok(void)
        }
        case Err(msg) {
            if msg != CALL_TARGET_FALLTHROUGH {
                return Err(msg)
            }
        }
    }

    var queryRes: Result<void, string> = emit_call_builtin_fs_query(
        name,
        ce,
        state,
        code,
    )

    switch queryRes {
        case Ok(_) {
            return Ok(void)
        }
        case Err(msg) {
            if msg != CALL_TARGET_FALLTHROUGH {
                return Err(msg)
            }
        }
    }

    return emit_call_builtin_fs_mutation(
        name,
        ce,
        state,
        code,
    )
}

func emit_call_builtin_fs_io(
    name: &string,
    ce: &ast.CallExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    if *name == "__builtin_read_file" || *name == "__builtin_read_all" {
        if ce.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_fs_read_file(
            &ce.Arguments[0],
            state,
            code,
        )
    }

    if *name == "__builtin_write_file" {
        if ce.Arguments.len() != 2 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_fs_write_file(
            &ce.Arguments[0],
            &ce.Arguments[1],
            state,
            code,
        )
    }

    if *name == "__builtin_write_file_bytes" {
        if ce.Arguments.len() != 2 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_fs_write_file_bytes(
            &ce.Arguments[0],
            &ce.Arguments[1],
            state,
            code,
        )
    }

    if *name == "__builtin_append_file" {
        if ce.Arguments.len() != 2 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        // Stub: treat as write_file
        return emit_fs_write_file(
            &ce.Arguments[0],
            &ce.Arguments[1],
            state,
            code,
        )
    }

    return Err(CALL_TARGET_FALLTHROUGH)
}

func emit_call_builtin_fs_query(
    name: &string,
    ce: &ast.CallExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    if *name == "__builtin_file_exists" {
        if ce.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_fs_exists(
            &ce.Arguments[0],
            state,
            code,
        )
    }

    if *name == "__builtin_is_file" {
        if ce.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_fs_is_file(
            &ce.Arguments[0],
            state,
            code,
        )
    }

    if *name == "__builtin_is_dir" {
        if ce.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_fs_is_dir(
            &ce.Arguments[0],
            state,
            code,
        )
    }

    if *name == "__builtin_read_dir" {
        if ce.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_fs_read_dir(
            &ce.Arguments[0],
            state,
            code,
        )
    }

    return Err(CALL_TARGET_FALLTHROUGH)
}

func emit_call_builtin_fs_mutation(
    name: &string,
    ce: &ast.CallExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    if *name == "__builtin_remove" {
        if ce.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_call_builtin_stub_result_ok_int(
            state,
            code,
        )
    }

    if *name == "__builtin_mkdir" {
        if ce.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_call_builtin_stub_result_ok_int(
            state,
            code,
        )
    }

    return Err(CALL_TARGET_FALLTHROUGH)
}

func emit_call_named_function(
    name: &string,
    ce: &ast.CallExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // debug trace removed
    // Check if this is an enum variant constructor (e.g., Circle(5), Rectangle(3, 4))
    if looks_like_enum_variant_name(name) {
        var enumOpt: Option<ast.EnumDecl> = find_enum_by_variant(
            &state.enums,
            name,
        )

        // debug trace removed
        switch enumOpt {
            case Some(_) {
                return emit_call_as_enum_variant(
                    name,
                    &ce.Arguments,
                    state,
                    code,
                )
            }
            case None {
            }
        }
    }

    // debug trace removed
    var arg_count: int = ce.Arguments.len()

    if arg_count > 6 {
        return Err(ERR_NATIVE_TOO_MANY_ARGS)
    }

    mut var i: int = arg_count

    // debug trace removed
    while i > 0 {
        i = i - 1

        // debug trace removed
        var res: Result<void, string> = emit_module_call_arg(
            &state.current_pkg,
            name,
            i,
            &ce.Arguments[i],
            state,
            code,
        )

        // debug trace removed
        switch res {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        x86.emit_push_reg(
            code,
            x86.RAX,
        )
    }

    mut var j: int = 0

    // debug trace removed
    while j < arg_count {
        var regOpt: Option<int> = arg_register(j)

        switch regOpt {
            case None {
                return Err(ERR_NATIVE_TOO_MANY_ARGS)
            }
            case Some(reg) {
                x86.emit_pop_reg(
                    code,
                    reg,
                )
            }
        }

        j = j + 1
    }

    mut var patch_target: string = *name

    if !string_contains_dot(name) && state.current_pkg != "" {
        var qualified_target: string = state.current_pkg + "." + *name

        switch function_offset(
            &state.functions,
            &qualified_target,
        ) {
            case Some(_) {
                patch_target = qualified_target
            }
            case None {
            }
        }
    }

    var call_site: int = code.len()

    // debug trace removed
    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_site + 1,
        patch_target,
    )

    return Ok(void)
}

func arg_mask_bit(arg_index: int) -> (int) {
    mut var bit: int = 1
    mut var i: int = 0

    while i < arg_index {
        bit = bit + bit
        i = i + 1
    }

    return bit
}

func emit_module_call_arg(
    module_name: &string,
    method_name: &string,
    arg_index: int,
    arg_expr: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    mut var borrow_mask: int = 0
    mut var target_name: string = *method_name

    if *module_name != "" {
        target_name = *module_name + "." + *method_name
    }

    switch function_param_borrow_mask(
        &state.functions,
        &target_name,
    ) {
        case Some(mask) {
            borrow_mask = mask
        }
        case None {
            switch function_param_borrow_mask(
                &state.functions,
                method_name,
            ) {
                case Some(mask2) {
                    borrow_mask = mask2
                }
                case None {
                }
            }
        }
    }

    if borrow_mask & arg_mask_bit(arg_index) != 0 {
        switch *arg_expr {
            case ast.Expression.Borrow(_) {
                return emit_expr(
                    arg_expr,
                    state,
                    code,
                )
            }
            default {
            }
        }

        if is_ref_expr(
            arg_expr,
            state,
        ) {
            return emit_expr(
                arg_expr,
                state,
                code,
            )
        }

        return emit_address_of(
            arg_expr,
            state,
            code,
        )
    }

    return emit_expr(
        arg_expr,
        state,
        code,
    )
}

func emit_method_call(
    mc: &ast.MethodCallExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    if mc.Method.Value == "toString" || mc.Method.Value == "to_string" {
        switch mc.Object {
            case ast.Expression.MethodCall(inner_len_mc) {
                if inner_len_mc.Method.Value == "len" && inner_len_mc.Arguments.len() == 0 {
                    var lenRes: Result<void, string> = emit_expr(
                        &mc.Object,
                        state,
                        code,
                    )

                    switch lenRes {
                        case Err(msg) {
                            return Err(msg)
                        }
                        case Ok(_) {
                        }
                    }

                    return emit_int_to_string_from_reg(
                        x86.RAX,
                        state,
                        code,
                    )
                }
            }
            default {
            }
        }
    }

    if mc.Method.Value == "len" {
        if mc.Arguments.len() != 0 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_vec_len(
            &mc.Object,
            state,
            code,
        )
    }

    var idDispatchRes: Result<void, string> = emit_method_call_identifier_object(
        mc,
        state,
        code,
    )

    switch idDispatchRes {
        case Ok(_) {
            return Ok(void)
        }
        case Err(msg) {
            if msg != IDENTIFIER_METHOD_FALLTHROUGH {
                return Err(msg)
            }
        }
    }

    if mc.Method.Value == "toString" || mc.Method.Value == "to_string" {
        switch mc.Object {
            case ast.Expression.Identifier(id_fast) {
                switch resolve_local_type(
                    state,
                    &id_fast.Value,
                ) {
                    case Some(t_fast) {
                        if t_fast == "string" {
                            return emit_expr(
                                &mc.Object,
                                state,
                                code,
                            )
                        }

                        if t_fast == "int" {
                            var fastRes: Result<void, string> = emit_expr(
                                &mc.Object,
                                state,
                                code,
                            )

                            switch fastRes {
                                case Err(msg) {
                                    return Err(msg)
                                }
                                case Ok(_) {
                                }
                            }

                            return emit_int_to_string_from_reg(
                                x86.RAX,
                                state,
                                code,
                            )
                        }
                    }
                    case None {
                    }
                }
            }
            case ast.Expression.MutableIdentifier(id_fast_mut) {
                switch resolve_local_type(
                    state,
                    &id_fast_mut.Value,
                ) {
                    case Some(t_fast_mut) {
                        if t_fast_mut == "string" {
                            return emit_expr(
                                &mc.Object,
                                state,
                                code,
                            )
                        }

                        if t_fast_mut == "int" {
                            var fastResMut: Result<void, string> = emit_expr(
                                &mc.Object,
                                state,
                                code,
                            )

                            switch fastResMut {
                                case Err(msg) {
                                    return Err(msg)
                                }
                                case Ok(_) {
                                }
                            }

                            return emit_int_to_string_from_reg(
                                x86.RAX,
                                state,
                                code,
                            )
                        }
                    }
                    case None {
                    }
                }
            }
            default {
            }
        }
    }

    // Namespace-qualified enum constructor call:
    // `Result.Ok(v)` or `ast.Statement.FunctionDecl(fd)`.
    if looks_like_enum_variant_name(&mc.Method.Value) {
        var enumMethodOpt: Option<ast.EnumDecl> = find_enum_by_variant(
            &state.enums,
            &mc.Method.Value,
        )

        switch enumMethodOpt {
            case Some(_) {
                mut var allow_enum_ctor: bool = false

                switch mc.Object {
                    case ast.Expression.Identifier(id2) {
                        if !(resolve_local(
                            state,
                            &id2.Value,
                        )).is_some(
                        ) {
                            allow_enum_ctor = true
                        }
                    }
                    case ast.Expression.FieldAccess(_) {
                        allow_enum_ctor = true
                    }
                    default {
                    }
                }

                if allow_enum_ctor {
                    return emit_call_as_enum_variant(
                        &mc.Method.Value,
                        &mc.Arguments,
                        state,
                        code,
                    )
                }
            }
            case None {
            }
        }
    }

    // Option/Result instance methods
    if is_option_expr(
        &mc.Object,
        state,
    ) {
        return emit_option_method(
            mc,
            state,
            code,
        )
    }

    if is_result_expr(
        &mc.Object,
        state,
    ) {
        return emit_result_method(
            mc,
            state,
            code,
        )
    }

    // String instance methods
    if is_string_expr(
        &mc.Object,
        state,
    ) {
        if mc.Method.Value == "len" {
            if mc.Arguments.len() != 0 {
                return Err(ERR_NATIVE_BAD_ARGS)
            }

            return emit_string_len(
                &mc.Object,
                state,
                code,
            )
        }

        if mc.Method.Value == "substring" {
            if mc.Arguments.len() != 2 {
                return Err(ERR_NATIVE_BAD_ARGS)
            }

            return emit_string_substring(
                &mc.Object,
                &mc.Arguments[0],
                &mc.Arguments[1],
                state,
                code,
            )
        }
    }

    var timeDispatchRes: Result<void, string> = emit_method_call_time_types(
        mc,
        state,
        code,
    )

    switch timeDispatchRes {
        case Ok(_) {
            return Ok(void)
        }
        case Err(msg) {
            if msg != IDENTIFIER_METHOD_FALLTHROUGH {
                return Err(msg)
            }
        }
    }

    return emit_method_call_tail_dispatch(
        mc,
        state,
        code,
    )
}

func emit_method_call_tail_dispatch(
    mc: &ast.MethodCallExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var stringTailRes: Result<void, string> = emit_method_call_tail_string_option(
        mc,
        state,
        code,
    )

    switch stringTailRes {
        case Ok(_) {
            return Ok(void)
        }
        case Err(msg) {
            if msg != IDENTIFIER_METHOD_FALLTHROUGH {
                return Err(msg)
            }
        }
    }

    return emit_method_call_tail_receiver_vec(
        mc,
        state,
        code,
    )
}

func emit_method_call_tail_string_option(
    mc: &ast.MethodCallExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // String-method dispatch should be name-gated. In deep self-host stages
    // some Vec receivers can be misclassified as string; don't route unknown
    // methods (e.g. push/pop) through string fallback.
    if mc.Method.Value == "contains" || mc.Method.Value == "startsWith" || mc.Method.Value == "endsWith" || mc.Method.Value == "split" || mc.Method.Value == "trim" || mc.Method.Value == "toLower" || mc.Method.Value == "toUpper" || mc.Method.Value == "indexOf" || mc.Method.Value == "parseInt" || mc.Method.Value == "parseFloat" {
        return emit_string_instance_method(
            mc,
            state,
            code,
        )
    }

    var toStringDispatchRes: Result<void, string> = emit_method_call_tail_tostring(
        mc,
        state,
        code,
    )

    switch toStringDispatchRes {
        case Ok(_) {
            return Ok(void)
        }
        case Err(msg) {
            if msg != IDENTIFIER_METHOD_FALLTHROUGH {
                return Err(msg)
            }
        }
    }

    // Fallback dispatch by method name when enum bindings were not inferred.
    if mc.Method.Value == "is_ok" || mc.Method.Value == "is_err" || mc.Method.Value == "unwrap_err" {
        return emit_result_method(
            mc,
            state,
            code,
        )
    }

    if mc.Method.Value == "unwrap" {
        if is_option_expr(
            &mc.Object,
            state,
        ) {
            return emit_option_method(
                mc,
                state,
                code,
            )
        }

        return emit_result_method(
            mc,
            state,
            code,
        )
    }

    if mc.Method.Value == "is_some" || mc.Method.Value == "is_none" || mc.Method.Value == "unwrapOr" {
        return emit_option_method(
            mc,
            state,
            code,
        )
    }

    return Err(IDENTIFIER_METHOD_FALLTHROUGH)
}

func emit_method_call_tail_tostring(
    mc: &ast.MethodCallExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    if mc.Method.Value == "toString" {
        var as_char: bool = emit_method_call_tail_tostring_is_char(
            mc,
            state,
        )

        if as_char {
            var charRes: Result<void, string> = emit_expr(
                &mc.Object,
                state,
                code,
            )

            switch charRes {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            var charBufRes: Result<void, string> = emit_char_to_string_alloc_byte(
                state,
                code,
            )

            switch charBufRes {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            return emit_char_to_string_alloc_header(
                state,
                code,
            )
        }

        var toStrRes: Result<void, string> = emit_expr(
            &mc.Object,
            state,
            code,
        )

        switch toStrRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        return emit_int_to_string_from_reg(
            x86.RAX,
            state,
            code,
        )
    }

    return Err(IDENTIFIER_METHOD_FALLTHROUGH)
}

func emit_method_call_tail_tostring_is_char(
    mc: &ast.MethodCallExpression,
    state: &mut BackendEmitState,
) -> (bool) {
    if emit_method_call_tail_tostring_is_char_conversion(mc) {
        return true
    }

    return emit_method_call_tail_tostring_is_char_local(
        mc,
        state,
    )
}

func emit_char_to_string_alloc_byte(
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    x86.emit_mov_reg_reg(
        code,
        x86.R8,
        x86.RAX,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        8,
    )

    var call_buf: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_buf + 1,
        "__rt_alloc",
    )
    x86.emit_mov_reg_reg(
        code,
        x86.R9,
        x86.RAX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.R9,
        0,
        x86.R8,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RAX,
        x86.R9,
    )

    return Ok(void)
}

func emit_char_to_string_alloc_header(
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    x86.emit_push_reg(
        code,
        x86.RAX,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        16,
    )

    var call_hdr: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_hdr + 1,
        "__rt_alloc",
    )
    x86.emit_pop_reg(
        code,
        x86.R9,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.R9,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        1,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.RCX,
    )

    return Ok(void)
}

func emit_method_call_tail_tostring_is_char_conversion(
    mc: &ast.MethodCallExpression,
) -> (bool) {
    switch mc.Object {
        case ast.Expression.TypeConversion(tc2) {
            return tc2.TypeName == "char"
        }
        default {
            return false
        }
    }
}

func emit_method_call_tail_tostring_is_char_local(
    mc: &ast.MethodCallExpression,
    state: &mut BackendEmitState,
) -> (bool) {
    switch mc.Object {
        case ast.Expression.Identifier(id3) {
            return is_char_local_name(
                &id3.Value,
                state,
            )
        }
        case ast.Expression.MutableIdentifier(id4) {
            return is_char_local_name(
                &id4.Value,
                state,
            )
        }
        default {
            return false
        }
    }
}

func is_char_local_name(name: &string, state: &mut BackendEmitState) -> (bool) {
    switch resolve_local_type(
        state,
        name,
    ) {
        case Some(tname) {
            return tname == "char"
        }
        case None {
            return false
        }
    }
}

func emit_method_call_tail_receiver_vec(
    mc: &ast.MethodCallExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var recvIsVec: bool = is_vec_expr(
        &mc.Object,
        state,
    )

    if recvIsVec {
        if mc.Method.Value == "len" {
            if mc.Arguments.len() != 0 {
                return Err(ERR_NATIVE_BAD_ARGS)
            }

            return emit_vec_len(
                &mc.Object,
                state,
                code,
            )
        }

        if mc.Method.Value == "push" {
            if mc.Arguments.len() != 1 {
                return Err(ERR_NATIVE_BAD_ARGS)
            }

            return emit_vec_push(
                &mc.Object,
                &mc.Arguments[0],
                state,
                code,
            )
        }

        if mc.Method.Value == "pop" {
            if mc.Arguments.len() != 0 {
                return Err(ERR_NATIVE_BAD_ARGS)
            }

            return emit_vec_pop(
                &mc.Object,
                state,
                code,
            )
        }

        if mc.Method.Value == "remove" {
            if mc.Arguments.len() != 1 {
                return Err(ERR_NATIVE_BAD_ARGS)
            }

            return emit_vec_remove(
                &mc.Object,
                &mc.Arguments[0],
                state,
                code,
            )
        }

        return Err("native: unsupported Vec method " + mc.Method.Value)
    }

    var recvFallbackRes: Result<void, string> = emit_method_call_tail_receiver_fallback(
        mc,
        state,
        code,
    )

    switch recvFallbackRes {
        case Ok(_) {
            return Ok(void)
        }
        case Err(msg) {
            if msg != IDENTIFIER_METHOD_FALLTHROUGH {
                return Err(msg)
            }
        }
    }

    // Optimistic vec method dispatch: if the method is a known Vec method,
    // treat the receiver as a Vec even if is_vec_expr failed (matches Go backend behavior).
    if mc.Method.Value == "push" {
        if mc.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_vec_push(
            &mc.Object,
            &mc.Arguments[0],
            state,
            code,
        )
    }

    if mc.Method.Value == "pop" {
        if mc.Arguments.len() != 0 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_vec_pop(
            &mc.Object,
            state,
            code,
        )
    }

    if mc.Method.Value == "remove" {
        if mc.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_vec_remove(
            &mc.Object,
            &mc.Arguments[0],
            state,
            code,
        )
    }

    if mc.Method.Value == "is_empty" {
        // is_empty = len() == 0: emit len then compare
        var isEmptyRes: Result<void, string> = emit_vec_len(
            &mc.Object,
            state,
            code,
        )

        switch isEmptyRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        // test rax, rax (REX.W 0x85 mod=11 rax rax)
        code.push(0x48)
        code.push(0x85)
        code.push(0xC0)
        // sete al
        code.push(0x0F)
        code.push(0x94)
        code.push(0xC0)
        // movzx rax, al
        x86.emit_movzx_rax_al(code)

        return Ok(void)
    }

    if mc.Method.Value == "bytes" || mc.Method.Value == "chars" {
        return emit_string_instance_method(
            mc,
            state,
            code,
        )
    }

    if mc.Method.Value != "len" {
        return Err("native: unsupported @emit_method_call non_vec_method '" + mc.Method.Value + "'")
    }

    return emit_vec_len(
        &mc.Object,
        state,
        code,
    )
}

func emit_method_call_tail_receiver_fallback(
    mc: &ast.MethodCallExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // Generic receiver fallback for chained/non-identifier receivers.
    var recvFuncOpt2: Option<int> = function_param_count(
        &state.functions,
        &mc.Method.Value,
    )

    switch recvFuncOpt2 {
        case Some(expected_recv2) {
            var recv_arg_count2: int = mc.Arguments.len() + 1

            if expected_recv2 == recv_arg_count2 && recv_arg_count2 <= 6 {
                mut var ri2: int = mc.Arguments.len()

                while ri2 > 0 {
                    ri2 = ri2 - 1

                    var res_recv_arg2: Result<void, string> = emit_expr(
                        &mc.Arguments[ri2],
                        state,
                        code,
                    )

                    switch res_recv_arg2 {
                        case Err(msg) {
                            return Err(msg)
                        }
                        case Ok(_) {
                        }
                    }

                    x86.emit_push_reg(
                        code,
                        x86.RAX,
                    )
                }

                var recvObjRes2: Result<void, string> = emit_expr(
                    &mc.Object,
                    state,
                    code,
                )

                switch recvObjRes2 {
                    case Err(msg) {
                        return Err(msg)
                    }
                    case Ok(_) {
                    }
                }

                x86.emit_push_reg(
                    code,
                    x86.RAX,
                )

                mut var rj2: int = 0

                while rj2 < recv_arg_count2 {
                    switch arg_register(rj2) {
                        case Some(reg) {
                            x86.emit_pop_reg(
                                code,
                                reg,
                            )
                        }
                        case None {
                            return Err(ERR_NATIVE_TOO_MANY_ARGS)
                        }
                    }

                    rj2 = rj2 + 1
                }

                var recv_call_site2: int = code.len()

                x86.emit_call_rel32(
                    code,
                    0,
                )
                add_call_patch(
                    state,
                    recv_call_site2 + 1,
                    mc.Method.Value,
                )

                return Ok(void)
            }
        }
        case None {
        }
    }

    return Err(IDENTIFIER_METHOD_FALLTHROUGH)
}

func emit_method_call_time_types(
    mc: &ast.MethodCallExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // time.Duration methods (partial)
    if is_time_duration_expr(
        &mc.Object,
        state,
    ) {
        if mc.Method.Value == "as_nanos" {
            var res: Result<void, string> = emit_expr(
                &mc.Object,
                state,
                code,
            )

            switch res {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            x86.emit_mov_reg_mem_base_disp(
                code,
                x86.RAX,
                x86.RAX,
                0,
            )

            return Ok(void)
        }

        if mc.Method.Value == "as_micros" {
            var res: Result<void, string> = emit_expr(
                &mc.Object,
                state,
                code,
            )

            switch res {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            x86.emit_mov_reg_mem_base_disp(
                code,
                x86.RAX,
                x86.RAX,
                0,
            )
            x86.emit_mov_reg_imm32(
                code,
                x86.RCX,
                1000,
            )
            x86.emit_cqo(code)
            x86.emit_idiv_reg(
                code,
                x86.RCX,
            )

            return Ok(void)
        }

        if mc.Method.Value == "as_millis" {
            var res: Result<void, string> = emit_expr(
                &mc.Object,
                state,
                code,
            )

            switch res {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            x86.emit_mov_reg_mem_base_disp(
                code,
                x86.RAX,
                x86.RAX,
                0,
            )
            x86.emit_mov_reg_imm32(
                code,
                x86.RCX,
                1000000,
            )
            x86.emit_cqo(code)
            x86.emit_idiv_reg(
                code,
                x86.RCX,
            )

            return Ok(void)
        }

        if mc.Method.Value == "as_secs" {
            var res: Result<void, string> = emit_expr(
                &mc.Object,
                state,
                code,
            )

            switch res {
                case Err(msg) {
                    return Err(msg)
