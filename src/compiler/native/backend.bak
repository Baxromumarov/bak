                }
            }

            x86.emit_mov_reg_mem_base_disp(
                code,
                x86.R9,
                x86.RAX,
                0,
            )
            x86.emit_add_rsp_imm8(
                code,
                8,
            )
            x86.emit_pop_reg(
                code,
                x86.R8,
            )
            x86.emit_sub_reg_reg(
                code,
                x86.R9,
                x86.R8,
            )
            x86.emit_mov_reg_reg(
                code,
                x86.R8,
                x86.R9,
            )

            return emit_time_alloc_from_r8(
                state,
                code,
            )
        }

        if mc.Method.Value == "unix_nanos" {
            var res: Result<void, string> = emit_expr(
                &mc.Object,
                state,
                code,
            )

            switch res {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            x86.emit_mov_reg_mem_base_disp(
                code,
                x86.RAX,
                x86.RAX,
                0,
            )

            return Ok(void)
        }

        if mc.Method.Value == "unix_millis" {
            var res: Result<void, string> = emit_expr(
                &mc.Object,
                state,
                code,
            )

            switch res {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            x86.emit_mov_reg_mem_base_disp(
                code,
                x86.RAX,
                x86.RAX,
                0,
            )
            x86.emit_mov_reg_imm32(
                code,
                x86.RCX,
                1000000,
            )
            x86.emit_cqo(code)
            x86.emit_idiv_reg(
                code,
                x86.RCX,
            )

            return Ok(void)
        }

        if mc.Method.Value == "unix" {
            var res: Result<void, string> = emit_expr(
                &mc.Object,
                state,
                code,
            )

            switch res {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            x86.emit_mov_reg_mem_base_disp(
                code,
                x86.RAX,
                x86.RAX,
                0,
            )
            x86.emit_mov_reg_imm32(
                code,
                x86.RCX,
                1000000000,
            )
            x86.emit_cqo(code)
            x86.emit_idiv_reg(
                code,
                x86.RCX,
            )

            return Ok(void)
        }

        if mc.Method.Value == "eq" {
            if mc.Arguments.len() != 1 {
                return Err(ERR_NATIVE_BAD_ARGS)
            }

            var res: Result<void, string> = emit_expr(
                &mc.Object,
                state,
                code,
            )

            switch res {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            x86.emit_mov_reg_mem_base_disp(
                code,
                x86.R8,
                x86.RAX,
                0,
            )
            x86.emit_push_reg(
                code,
                x86.R8,
            )
            x86.emit_sub_rsp_imm8(
                code,
                8,
            )

            var resOther: Result<void, string> = emit_expr(
                &mc.Arguments[0],
                state,
                code,
            )

            switch resOther {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            x86.emit_mov_reg_mem_base_disp(
                code,
                x86.R9,
                x86.RAX,
                0,
            )
            x86.emit_add_rsp_imm8(
                code,
                8,
            )
            x86.emit_pop_reg(
                code,
                x86.R8,
            )
            x86.emit_cmp_reg_reg(
                code,
                x86.R8,
                x86.R9,
            )
            x86.emit_sete(code)
            x86.emit_movzx_rax_al(code)

            return Ok(void)
        }

        if mc.Method.Value == "is_zero" {
            var res: Result<void, string> = emit_expr(
                &mc.Object,
                state,
                code,
            )

            switch res {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            x86.emit_mov_reg_mem_base_disp(
                code,
                x86.RAX,
                x86.RAX,
                0,
            )
            x86.emit_test_reg_reg(
                code,
                x86.RAX,
                x86.RAX,
            )
            x86.emit_sete(code)
            x86.emit_movzx_rax_al(code)

            return Ok(void)
        }

        if mc.Method.Value == "before" {
            if mc.Arguments.len() != 1 {
                return Err(ERR_NATIVE_BAD_ARGS)
            }

            var res: Result<void, string> = emit_expr(
                &mc.Object,
                state,
                code,
            )

            switch res {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            x86.emit_mov_reg_mem_base_disp(
                code,
                x86.R8,
                x86.RAX,
                0,
            )
            x86.emit_push_reg(
                code,
                x86.R8,
            )
            x86.emit_sub_rsp_imm8(
                code,
                8,
            )

            var resOther: Result<void, string> = emit_expr(
                &mc.Arguments[0],
                state,
                code,
            )

            switch resOther {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            x86.emit_mov_reg_mem_base_disp(
                code,
                x86.R9,
                x86.RAX,
                0,
            )
            x86.emit_add_rsp_imm8(
                code,
                8,
            )
            x86.emit_pop_reg(
                code,
                x86.R8,
            )
            x86.emit_cmp_reg_reg(
                code,
                x86.R8,
                x86.R9,
            )
            x86.emit_setl(code)
            x86.emit_movzx_rax_al(code)

            return Ok(void)
        }

        if mc.Method.Value == "after" {
            if mc.Arguments.len() != 1 {
                return Err(ERR_NATIVE_BAD_ARGS)
            }

            var res: Result<void, string> = emit_expr(
                &mc.Object,
                state,
                code,
            )

            switch res {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            x86.emit_mov_reg_mem_base_disp(
                code,
                x86.R8,
                x86.RAX,
                0,
            )
            x86.emit_push_reg(
                code,
                x86.R8,
            )
            x86.emit_sub_rsp_imm8(
                code,
                8,
            )

            var resOther: Result<void, string> = emit_expr(
                &mc.Arguments[0],
                state,
                code,
            )

            switch resOther {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            x86.emit_mov_reg_mem_base_disp(
                code,
                x86.R9,
                x86.RAX,
                0,
            )
            x86.emit_add_rsp_imm8(
                code,
                8,
            )
            x86.emit_pop_reg(
                code,
                x86.R8,
            )
            x86.emit_cmp_reg_reg(
                code,
                x86.R8,
                x86.R9,
            )
            x86.emit_setg(code)
            x86.emit_movzx_rax_al(code)

            return Ok(void)
        }

        if mc.Method.Value == "format" {
            if mc.Arguments.len() != 1 {
                return Err(ERR_NATIVE_BAD_ARGS)
            }

            // Partial: return empty string for now.
            var emptyRes: Result<void, string> = emit_string_literal(
                &"",
                state,
                code,
            )

            switch emptyRes {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            return Ok(void)
        }

        return Err("native: unsupported Time method " + mc.Method.Value)
    }

    return Err(IDENTIFIER_METHOD_FALLTHROUGH)
}

func emit_method_call_identifier_object(
    mc: &ast.MethodCallExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // Static Vec constructors: Vec.new(), Vec.with_cap(n), Vec.from([...])
    switch mc.Object {
        case ast.Expression.Identifier(id) {
            if mc.Method.Value == "toString" || mc.Method.Value == "to_string" {
                return Err(IDENTIFIER_METHOD_FALLTHROUGH)
            }

            if id.Value == "Box" {
                if mc.Method.Value != "new" {
                    return Err("native: unsupported Box static method " + mc.Method.Value)
                }

                if mc.Arguments.len() != 1 {
                    return Err(ERR_NATIVE_BAD_ARGS)
                }

                var boxArgRes: Result<void, string> = emit_expr(
                    &mc.Arguments[0],
                    state,
                    code,
                )

                switch boxArgRes {
                    case Err(msg) {
                        return Err(msg)
                    }
                    case Ok(_) {
                    }
                }

                x86.emit_push_reg(
                    code,
                    x86.RAX,
                )
                x86.emit_sub_rsp_imm8(
                    code,
                    8,
                )
                x86.emit_mov_reg_imm32(
                    code,
                    x86.RDI,
                    8,
                )

                var boxCallSite: int = code.len()

                x86.emit_call_rel32(
                    code,
                    0,
                )
                add_call_patch(
                    state,
                    boxCallSite + 1,
                    "__rt_alloc",
                )
                x86.emit_add_rsp_imm8(
                    code,
                    8,
                )
                x86.emit_pop_reg(
                    code,
                    x86.RCX,
                )
                x86.emit_mov_mem_base_disp_reg(
                    code,
                    x86.RAX,
                    0,
                    x86.RCX,
                )

                return Ok(void)
            }

            if id.Value == "Vec" {
                if mc.Method.Value == "new" {
                    if mc.Arguments.len() != 0 {
                        return Err(ERR_NATIVE_BAD_ARGS)
                    }

                    return emit_vec_new(
                        state,
                        code,
                    )
                }

                if mc.Method.Value == "with_cap" {
                    if mc.Arguments.len() != 1 {
                        return Err(ERR_NATIVE_BAD_ARGS)
                    }

                    return emit_vec_with_cap(
                        &mc.Arguments[0],
                        state,
                        code,
                    )
                }

                if mc.Method.Value == "from" {
                    if mc.Arguments.len() != 1 {
                        return Err(ERR_NATIVE_BAD_ARGS)
                    }

                    switch mc.Arguments[0] {
                        case ast.Expression.VecLiteral(vl) {
                            return emit_vec_literal(
                                &vl.Elements,
                                state,
                                code,
                            )
                        }
                        default {
                            return Err(ERR_NATIVE_BAD_ARGS)
                        }
                    }
                }

                return Err("native: unsupported Vec static method " + mc.Method.Value)
            }

            // Module-qualified function call: module.func(args)
            var qual_name: string = id.Value + "." + mc.Method.Value
            var qualFuncOpt: Option<int> = function_param_count(
                &state.functions,
                &qual_name,
            )

            switch qualFuncOpt {
                case Some(expected_count) {
                    if mc.Arguments.len() == expected_count && mc.Arguments.len() <= 6 {
                        mut var ai: int = mc.Arguments.len()

                        while ai > 0 {
                            ai = ai - 1

                            var argRes: Result<void, string> = emit_expr(
                                &mc.Arguments[ai],
                                state,
                                code,
                            )

                            switch argRes {
                                case Err(msg) {
                                    return Err(msg)
                                }
                                case Ok(_) {
                                }
                            }

                            x86.emit_push_reg(
                                code,
                                x86.RAX,
                            )
                        }

                        mut var ri: int = 0

                        while ri < mc.Arguments.len() {
                            switch arg_register(ri) {
                                case None {
                                    return Err(ERR_NATIVE_TOO_MANY_ARGS)
                                }
                                case Some(reg) {
                                    x86.emit_pop_reg(
                                        code,
                                        reg,
                                    )
                                }
                            }

                            ri = ri + 1
                        }

                        var qual_call_site: int = code.len()

                        x86.emit_call_rel32(
                            code,
                            0,
                        )
                        add_call_patch(
                            state,
                            qual_call_site + 1,
                            qual_name,
                        )

                        return Ok(void)
                    }

                    return Err("native: argument count mismatch for " + qual_name)
                }
                case None {
                }
            }

            // String-method dispatch should be name-gated. Deep self-host
            // stages can occasionally misclassify Vec receivers as string.
            if mc.Method.Value == "len" || mc.Method.Value == "substring" || mc.Method.Value == "contains" || mc.Method.Value == "startsWith" || mc.Method.Value == "endsWith" || mc.Method.Value == "split" || mc.Method.Value == "trim" || mc.Method.Value == "toLower" || mc.Method.Value == "toUpper" || mc.Method.Value == "indexOf" || mc.Method.Value == "parseInt" || mc.Method.Value == "parseFloat" {
                if is_string_expr(
                    &mc.Object,
                    state,
                ) {
                    return emit_string_instance_method(
                        mc,
                        state,
                        code,
                    )
                }
            }

            if mc.Method.Value == "contains" || mc.Method.Value == "startsWith" || mc.Method.Value == "endsWith" || mc.Method.Value == "split" || mc.Method.Value == "trim" || mc.Method.Value == "toLower" || mc.Method.Value == "toUpper" || mc.Method.Value == "indexOf" {
                switch resolve_local(
                    state,
                    &id.Value,
                ) {
                    case Some(_) {
                        return emit_string_instance_method(
                            mc,
                            state,
                            code,
                        )
                    }
                    case None {
                    }
                }
            }

            if is_vec_expr(
                &mc.Object,
                state,
            ) {
                if mc.Method.Value == "len" {
                    return emit_vec_len(
                        &mc.Object,
                        state,
                        code,
                    )
                }

                if mc.Method.Value == "push" {
                    return emit_vec_push(
                        &mc.Object,
                        &mc.Arguments[0],
                        state,
                        code,
                    )
                }

                if mc.Method.Value == "pop" {
                    return emit_vec_pop(
                        &mc.Object,
                        state,
                        code,
                    )
                }

                if mc.Method.Value == "remove" {
                    if mc.Arguments.len() != 1 {
                        return Err(ERR_NATIVE_BAD_ARGS)
                    }

                    return emit_vec_remove(
                        &mc.Object,
                        &mc.Arguments[0],
                        state,
                        code,
                    )
                }

                return Err("native: unsupported Vec method " + mc.Method.Value)
            }

            // Struct instance method call: c.GetValue() -> GetValue(&c)
            var structOptMC: Option<string> = struct_literal_name(
                &mc.Object,
                state,
            )

            switch structOptMC {
                case Some(struct_name_mc) {
                    // Found a struct instance, prefer receiver-qualified target first.
                    mut var method_target: string = struct_name_mc + "." + mc.Method.Value
                    mut var funcOpt: Option<int> = function_param_count(
                        &state.functions,
                        &method_target,
                    )

                    switch funcOpt {
                        case Some(_) {
                        }
                        case None {
                            mut var has_dot: bool = false
                            mut var sni: int = 0

                            while sni < struct_name_mc.len() {
                                if struct_name_mc[sni] == '.' {
                                    has_dot = true
                                    sni = struct_name_mc.len()
                                } else {
                                    sni = sni + 1
                                }
                            }

                            if !has_dot {
                                var tail_target: string = struct_name_mc + "." + mc.Method.Value
                                mut var qfi: int = 0

                                while qfi < state.functions.len() {
                                    if bootstrap_target_matches(
                                        &(state.functions[qfi]).name,
                                        &tail_target,
                                    ) {
                                        method_target = (state.functions[qfi]).name
                                        funcOpt = Some((state.functions[qfi]).param_count)
                                        qfi = state.functions.len()
                                    } else {
                                        qfi = qfi + 1
                                    }
                                }
                            }
                        }
                    }

                    switch funcOpt {
                        case Some(_) {
                        }
                        case None {
                            method_target = mc.Method.Value
                            funcOpt = function_param_count(
                                &state.functions,
                                &method_target,
                            )
                        }
                    }

                    switch funcOpt {
                        case Some(expected) {
                            // Method should take struct pointer as first arg plus any explicit args
                            var arg_count: int = mc.Arguments.len() + 1

                            if arg_count > 6 {
                                return Err(ERR_NATIVE_TOO_MANY_ARGS)
                            }

                            if expected != arg_count {
                                return Err("native: argument count mismatch for method " + method_target)
                            }

                            // Push explicit arguments in reverse order
                            mut var i: int = mc.Arguments.len()

                            while i > 0 {
                                i = i - 1

                                var res: Result<void, string> = emit_expr(
                                    &mc.Arguments[i],
                                    state,
                                    code,
                                )

                                switch res {
                                    case Err(msg) {
                                        return Err(msg)
                                    }
                                    case Ok(_) {
                                    }
                                }

                                x86.emit_push_reg(
                                    code,
                                    x86.RAX,
                                )
                            }

                            // Push struct address (emit_expr on struct identifier gives address)
                            var objRes: Result<void, string> = emit_expr(
                                &mc.Object,
                                state,
                                code,
                            )

                            switch objRes {
                                case Err(msg) {
                                    return Err(msg)
                                }
                                case Ok(_) {
                                }
                            }

                            x86.emit_push_reg(
                                code,
                                x86.RAX,
                            )

                            // Pop arguments into registers
                            mut var j: int = 0

                            while j < arg_count {
                                var regOpt: Option<int> = arg_register(j)

                                switch regOpt {
                                    case None {
                                        return Err(ERR_NATIVE_TOO_MANY_ARGS)
                                    }
                                    case Some(reg) {
                                        x86.emit_pop_reg(
                                            code,
                                            reg,
                                        )
                                    }
                                }

                                j = j + 1
                            }

                            var call_site: int = code.len()

                            x86.emit_call_rel32(
                                code,
                                0,
                            )
                            add_call_patch(
                                state,
                                call_site + 1,
                                method_target,
                            )

                            return Ok(void)
                        }
                        case None {
                        }
                    }
                }
                case None {
                }
            }

            // Generic receiver fallback: if `obj.method(args...)` matches a
            // function named `method` with one extra receiver parameter, lower
            // it as `method(obj, args...)`.
            var recvFuncOpt: Option<int> = function_param_count(
                &state.functions,
                &mc.Method.Value,
            )

            switch recvFuncOpt {
                case Some(expected_recv) {
                    var recv_arg_count: int = mc.Arguments.len() + 1

                    if expected_recv == recv_arg_count && recv_arg_count <= 6 {
                        mut var ri: int = mc.Arguments.len()

                        while ri > 0 {
                            ri = ri - 1

                            var res_recv_arg: Result<void, string> = emit_expr(
                                &mc.Arguments[ri],
                                state,
                                code,
                            )

                            switch res_recv_arg {
                                case Err(msg) {
                                    return Err(msg)
                                }
                                case Ok(_) {
                                }
                            }

                            x86.emit_push_reg(
                                code,
                                x86.RAX,
                            )
                        }

                        var recvObjRes: Result<void, string> = emit_expr(
                            &mc.Object,
                            state,
                            code,
                        )

                        switch recvObjRes {
                            case Err(msg) {
                                return Err(msg)
                            }
                            case Ok(_) {
                            }
                        }

                        x86.emit_push_reg(
                            code,
                            x86.RAX,
                        )

                        mut var rj: int = 0

                        while rj < recv_arg_count {
                            switch arg_register(rj) {
                                case Some(reg) {
                                    x86.emit_pop_reg(
                                        code,
                                        reg,
                                    )
                                }
                                case None {
                                    return Err(ERR_NATIVE_TOO_MANY_ARGS)
                                }
                            }

                            rj = rj + 1
                        }

                        var recv_call_site: int = code.len()

                        x86.emit_call_rel32(
                            code,
                            0,
                        )
                        add_call_patch(
                            state,
                            recv_call_site + 1,
                            mc.Method.Value,
                        )

                        return Ok(void)
                    }
                }
                case None {
                }
            }

            // Module-qualified function call: module.func(...)
            mut var qual_name: string = id.Value + "." + mc.Method.Value
            var paramOpt: Option<int> = function_param_count(
                &state.functions,
                &qual_name,
            )

            switch paramOpt {
                case Some(expected) {
                    var arg_count: int = mc.Arguments.len()

                    if arg_count > 6 {
                        return Err(ERR_NATIVE_TOO_MANY_ARGS)
                    }

                    if expected != arg_count {
                        return Err("native: argument count mismatch for " + qual_name)
                    }

                    mut var i: int = arg_count

                    while i > 0 {
                        i = i - 1

                        var res: Result<void, string> = emit_module_call_arg(
                            &id.Value,
                            &mc.Method.Value,
                            i,
                            &mc.Arguments[i],
                            state,
                            code,
                        )

                        switch res {
                            case Err(msg) {
                                return Err(msg)
                            }
                            case Ok(_) {
                            }
                        }

                        x86.emit_push_reg(
                            code,
                            x86.RAX,
                        )
                    }

                    mut var j: int = 0

                    while j < arg_count {
                        var regOpt: Option<int> = arg_register(j)

                        switch regOpt {
                            case None {
                                return Err(ERR_NATIVE_TOO_MANY_ARGS)
                            }
                            case Some(reg) {
                                x86.emit_pop_reg(
                                    code,
                                    reg,
                                )
                            }
                        }

                        j = j + 1
                    }

                    var call_site: int = code.len()

                    x86.emit_call_rel32(
                        code,
                        0,
                    )
                    add_call_patch(
                        state,
                        call_site + 1,
                        qual_name,
                    )

                    return Ok(void)
                }
                case None {
                    // Try without module prefix (local function or method call on local struct instance)
                    qual_name = mc.Method.Value

                    var paramOpt2: Option<int> = function_param_count(
                        &state.functions,
                        &qual_name,
                    )

                    switch paramOpt2 {
                        case Some(expected) {
                            var arg_count: int = mc.Arguments.len()

                            if arg_count > 6 {
                                return Err(ERR_NATIVE_TOO_MANY_ARGS)
                            }

                            if expected != arg_count {
                                return Err("native: argument count mismatch for " + qual_name)
                            }

                            mut var i: int = arg_count

                            while i > 0 {
                                i = i - 1

                                var res: Result<void, string> = emit_module_call_arg(
                                    &id.Value,
                                    &mc.Method.Value,
                                    i,
                                    &mc.Arguments[i],
                                    state,
                                    code,
                                )

                                switch res {
                                    case Err(msg) {
                                        return Err(msg)
                                    }
                                    case Ok(_) {
                                    }
                                }

                                x86.emit_push_reg(
                                    code,
                                    x86.RAX,
                                )
                            }

                            mut var j: int = 0

                            while j < arg_count {
                                var regOpt: Option<int> = arg_register(j)

                                switch regOpt {
                                    case None {
                                        return Err(ERR_NATIVE_TOO_MANY_ARGS)
                                    }
                                    case Some(reg) {
                                        x86.emit_pop_reg(
                                            code,
                                            reg,
                                        )
                                    }
                                }

                                j = j + 1
                            }

                            var call_site: int = code.len()

                            x86.emit_call_rel32(
                                code,
                                0,
                            )
                            add_call_patch(
                                state,
                                call_site + 1,
                                qual_name,
                            )

                            return Ok(void)
                        }
                        case None {
                        }
                    }
                }
            }

            // If it's an identifier, it might be a module or a local variable.
            // If it's a local variable, it must be a method call.
            if mc.Method.Value == "len" || mc.Method.Value == "substring" || mc.Method.Value == "contains" || mc.Method.Value == "startsWith" || mc.Method.Value == "endsWith" || mc.Method.Value == "split" || mc.Method.Value == "trim" || mc.Method.Value == "toLower" || mc.Method.Value == "toUpper" || mc.Method.Value == "indexOf" || mc.Method.Value == "parseInt" || mc.Method.Value == "parseFloat" {
                if (resolve_local(
                    state,
                    &id.Value,
                )).is_some(
                ) {
                    if is_string_expr(
                        &mc.Object,
                        state,
                    ) {
                        return emit_string_instance_method(
                            mc,
                            state,
                            code,
                        )
                    }
                } else if is_string_expr(
                    &mc.Object,
                    state,
                ) {
                    // fallthrough to Vec instance methods
                    return emit_string_instance_method(
                        mc,
                        state,
                        code,
                    )
                }
            }

            // If not a local, and not a recognized module-qualified call, 
            // it might still be a module-qualified call to a function that hasn't been added yet?
            // Actually, BuildProgram should have all functions in state.functions already.
            // Let's check if it's a known module name.
            if id.Value == "bytes" {
                return emit_method_call_bytes(
                    mc,
                    state,
                    code,
                )
            }

            if id.Value == "strconv" {
                return emit_method_call_strconv(
                    mc,
                    state,
                    code,
                )
            }

            if id.Value == "strings" || id.Value == "string" {
                return emit_method_call_strings(
                    mc,
                    state,
                    code,
                )
            }

            if id.Value == "os" {
                return emit_method_call_os(
                    mc,
                    state,
                    code,
                )
            }

            if id.Value == "fs" {
                return emit_method_call_fs(
                    mc,
                    state,
                    code,
                )
            }

            if id.Value == "time" {
                return emit_method_call_time_namespace(
                    mc,
                    state,
                    code,
                )
            }
        }
        default {
        }
    }

    return Err(IDENTIFIER_METHOD_FALLTHROUGH)
}

func emit_method_call_bytes(
    mc: &ast.MethodCallExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    if mc.Method.Value == "from_string" {
        if mc.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_bytes_from_string(
            &mc.Arguments[0],
            state,
            code,
        )
    }

    if mc.Method.Value == "to_string" {
        if mc.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_bytes_to_string(
            &mc.Arguments[0],
            state,
            code,
        )
    }

    if mc.Method.Value == "length" {
        if mc.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_bytes_length(
            &mc.Arguments[0],
            state,
            code,
        )
    }

    if mc.Method.Value == "get" {
        if mc.Arguments.len() != 2 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_bytes_get(
            &mc.Arguments[0],
            &mc.Arguments[1],
            state,
            code,
        )
    }

    if mc.Method.Value == "set" {
        if mc.Arguments.len() != 3 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_bytes_set(
            &mc.Arguments[0],
            &mc.Arguments[1],
            &mc.Arguments[2],
            state,
            code,
        )
    }

    return Err("native: unsupported bytes method " + mc.Method.Value)
}

func emit_method_call_strconv(
    mc: &ast.MethodCallExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    if mc.Method.Value == "itoa" {
        if mc.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        var argRes0: Result<void, string> = emit_expr(
            &mc.Arguments[0],
            state,
            code,
        )

        switch argRes0 {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        return emit_int_to_string_from_reg(
            x86.RAX,
            state,
            code,
        )
    }

    if mc.Method.Value == "intToString" {
        if mc.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        var argRes1: Result<void, string> = emit_expr(
            &mc.Arguments[0],
            state,
            code,
        )

        switch argRes1 {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        return emit_int_to_string_from_reg(
            x86.RAX,
            state,
            code,
        )
    }

    if mc.Method.Value == "formatInt" {
        if mc.Arguments.len() != 2 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_strconv_format_int(
            &mc.Arguments[0],
            &mc.Arguments[1],
            state,
            code,
        )
    }

    if mc.Method.Value == "formatBinary" {
        if mc.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_strconv_format_int_const(
            &mc.Arguments[0],
            2,
            state,
            code,
        )
    }

    if mc.Method.Value == "formatOctal" {
        if mc.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_strconv_format_int_const(
            &mc.Arguments[0],
            8,
            state,
            code,
        )
    }

    if mc.Method.Value == "formatHex" {
        if mc.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_strconv_format_int_const(
            &mc.Arguments[0],
            16,
            state,
            code,
        )
    }

    if mc.Method.Value == "parseInt" {
        if mc.Arguments.len() != 2 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_strconv_parse_int(
            &mc.Arguments[0],
            &mc.Arguments[1],
            state,
            code,
        )
    }

    if mc.Method.Value == "atoi" {
        if mc.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_strconv_parse_int_const(
            &mc.Arguments[0],
            10,
            state,
            code,
        )
    }

    if mc.Method.Value == "parseBinary" {
        if mc.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_strconv_parse_int_const(
            &mc.Arguments[0],
            2,
            state,
            code,
        )
    }

    if mc.Method.Value == "parseOctal" {
        if mc.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_strconv_parse_int_const(
            &mc.Arguments[0],
            8,
            state,
            code,
        )
    }

    if mc.Method.Value == "parseHex" {
        if mc.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_strconv_parse_int_const(
            &mc.Arguments[0],
            16,
            state,
            code,
        )
    }

    return Err("native: unsupported strconv method " + mc.Method.Value)
}

