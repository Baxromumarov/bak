// Triples: [data_index, offset, target_index] repeated.
const ELEM_KIND_SCALAR: int = 0
const ELEM_KIND_STRING: int = 1
const ELEM_KIND_STRUCT: int = 2
const ELEM_KIND_VEC: int = 3
const CONTAINER_KIND_STRING: int = 1
const CONTAINER_KIND_VEC: int = 2
const CONTAINER_KIND_OPTION: int = 3
const CONTAINER_KIND_RESULT: int = 4
// Keep runtime slots away from low data indices. Some self-host stages still
// mis-patch a few data references to index 0, so reserving a gap prevents those
// stray stores from clobbering runtime state like init_rsp.
const RUNTIME_DATA_INIT_RSP_INDEX: int = 32
const RUNTIME_DATA_ARGS_CACHE_INDEX: int = 33
const RUNTIME_DATA_TIME_COUNTER_INDEX: int = 34
const RUNTIME_DATA_HEAP_POS_INDEX: int = 35
const RUNTIME_DATA_HEAP_END_INDEX: int = 36

func is_valid_symbol_char(ch: int) -> (bool) {
    if ch >= 65 && ch <= 90 {
        return true
    }

    if ch >= 97 && ch <= 122 {
        return true
    }

    if ch >= 48 && ch <= 57 {
        return true
    }

    if ch == 95 || ch == 46 {
        return true
    }

    return false
}

func is_valid_symbol_name(name: &string) -> (bool) {
    if name.len() == 0 {
        return false
    }

    if (*name)[0] >= 48 && (*name)[0] <= 57 {
        return false
    }

    mut var i: int = 0

    while i < name.len() {
        if !is_valid_symbol_char(int((*name)[i])) {
            return false
        }

        i = i + 1
    }

    return true
}

func find_main_function_index(
    functions: &Vec<FunctionSymbol, _>,
) -> (Option<int>) {
    mut var i: int = 0

    while i < functions.len() {
        var name: &string = &(functions[i]).name

        if *name == "main" || (*name).endsWith(".main") {
            return Some(i)
        }

        i = i + 1
    }

    return None
}

func param_borrow_mask_from_decl(fd: &ast.FunctionDecl) -> (int) {
    mut var mask: int = 0
    mut var i: int = 0

    while i < fd.Parameters.len() && i < 6 {
        switch (fd.Parameters[i]).Type {
            case ast.TypeExpression.BorrowRef(_) {
                // bit i
                mut var bit: int = 1
                mut var b: int = 0

                while b < i {
                    bit = bit + bit
                    b = b + 1
                }

                mask = mask | bit
            }
            default {
            }
        }

        i = i + 1
    }

    return mask
}

pub struct IterableInfo {
    size:           int
    kind:           int
    struct_name:    string
    container_kind: int
}

pub struct CodeResult {
    code:         Vec<int, _>
    entry_offset: int
    text_size:    int
}

func build_program(program: &ast.Program) -> (Result<CodeResult, string>) {
    var res: Result<ProgramItems, string> = collect_program_items(program)

    switch res {
        case Err(msg) {
            return Err("epf:emit " + fd_name)
        }
        case Ok(items) {
            mut var ownedItems: ProgramItems = items

            debug_program_items(&ownedItems)

            var emitRes: Result<CodeResult, string> = emit_program_functions(
                &mut ownedItems.functions,
                &mut ownedItems.structs,
                &mut ownedItems.constants,
                &mut ownedItems.enums,
            )

            switch emitRes {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(out) {
                    return Ok(out)
                }
            }
        }
    }
}

pub struct ProgramItems {
    functions: Vec<ast.FunctionDecl, _>
    structs:   Vec<ast.StructDecl, _>
    constants: Vec<ast.ConstStatement, _>
    enums:     Vec<ast.EnumDecl, _>
}

func debug_program_items(items: &ProgramItems) -> (void) {
    return void
}

func copy_statement_vec(
    src: &Vec<ast.Statement, _>,
) -> (Vec<ast.Statement, _>) {
    mut var out: Vec<ast.Statement, _> = Vec.with_cap(src.len())
    mut var i: int = 0

    while i < src.len() {
        out.push((*src)[i])
        i = i + 1
    }

    return out
}

func copy_block_statement(src: ast.BlockStatement) -> (ast.BlockStatement) {
    return src
}

func collect_program_items(
    program: &ast.Program,
) -> (Result<ProgramItems, string>) {
    mut var stmt_cap: int = program.Statements.len() + 64
    mut var funcs: Vec<ast.FunctionDecl, _> = Vec.with_cap(stmt_cap + stmt_cap)
    mut var structs: Vec<ast.StructDecl, _> = Vec.with_cap(stmt_cap)
    mut var consts: Vec<ast.ConstStatement, _> = Vec.with_cap(stmt_cap + stmt_cap)
    mut var enums: Vec<ast.EnumDecl, _> = Vec.with_cap(stmt_cap)
    mut var si: int = 0

    while si < program.Statements.len() {
        var stmt: &ast.Statement = &program.Statements[si]

        switch *stmt {
            case ast.Statement.FunctionDecl(fd) {
                mut var fn_copy: ast.FunctionDecl = fd

                funcs.push(fn_copy)
            }
            case ast.Statement.StructDecl(sd) {
                structs.push(sd)
            }
            case ast.Statement.Const(cs) {
                consts.push(cs)
            }
            case ast.Statement.ConstBlock(cb) {
                mut var ci: int = 0

                while ci < cb.Constants.len() {
                    consts.push(cb.Constants[ci])
                    ci = ci + 1
                }
            }
            case ast.Statement.EnumDecl(ed) {
                enums.push(ed)
            }
            case ast.Statement.Package(_) {
            }
            case ast.Statement.Import(_) {
            }
            case ast.Statement.ImportBlock(_) {
            }
            case ast.Statement.Var(_) {
            }
            case ast.Statement.MultiVar(_) {
            }
            case ast.Statement.VarBlock(_) {
            }
            case ast.Statement.Return(_) {
            }
            case ast.Statement.Expression(_) {
            }
            case ast.Statement.Block(_) {
            }
            case ast.Statement.If(_) {
            }
            case ast.Statement.While(_) {
            }
            case ast.Statement.For(_) {
            }
            case ast.Statement.Switch(_) {
            }
            case ast.Statement.Defer(_) {
            }
            case ast.Statement.Panic(_) {
            }
            case ast.Statement.Unsafe(_) {
            }
            case ast.Statement.Break(_) {
            }
            case ast.Statement.Continue(_) {
            }
            case ast.Statement.Assignment(_) {
            }
            case ast.Statement.TypeDecl(_) {
            }
            case ast.Statement.AliasDecl(_) {
            }
            case ast.Statement.ImplDecl(id) {
                mut var mi: int = 0

                while mi < id.Methods.len() {
                    var md: ast.MethodDecl = id.Methods[mi]
                    var method_fn: ast.FunctionDecl = ast.LowerImplMethod(
                        "main",
                        id.TypeName,
                        id.Receiver,
                        id.Token,
                        md,
                    )

                    funcs.push(method_fn)
                    mi = mi + 1
                }
            }
            default {
            }
        }

        // Keep collection permissive; backend only needs top-level decl buckets.
        si = si + 1
    }

    return Ok(
        ProgramItems{
            constants: consts,
            enums:     enums,
            functions: funcs,
            structs:   structs,
        },
    )
}

func emit_program_functions(
    mut funcs: &mut Vec<ast.FunctionDecl, _>,
    mut structs: &mut Vec<ast.StructDecl, _>,
    mut consts: &mut Vec<ast.ConstStatement, _>,
    mut enums: &mut Vec<ast.EnumDecl, _>,
) -> (Result<CodeResult, string>) {
    if funcs.len() == 0 {
        return Err("epf:empty")
    }

    mut var bootstrap_mode: bool = false
    mut var bootstrap_detect_i: int = 0

    while bootstrap_detect_i < funcs.len() {
        var bootstrap_name: string = (funcs[bootstrap_detect_i]).Name.Value

        if bootstrap_name.startsWith("bakc.") || bootstrap_name.startsWith("driver.") || bootstrap_name.startsWith("parser.") || bootstrap_name.startsWith("lexer.") || bootstrap_name.startsWith("token.") || bootstrap_name.startsWith("ast.") || bootstrap_name.startsWith("native.") {
            bootstrap_mode = true
            bootstrap_detect_i = funcs.len()
        } else {
            bootstrap_detect_i = bootstrap_detect_i + 1
        }
    }
    mut var skip_flags: Vec<int, _> = Vec.with_cap(funcs.len())
    mut var skip_init_i: int = 0
    mut var param_counts: Vec<int, _> = Vec.with_cap(funcs.len())

    while skip_init_i < funcs.len() {
        skip_flags.push(0)
        param_counts.push((funcs[skip_init_i]).Parameters.len())
        skip_init_i = skip_init_i + 1
    }

    mut var skip_count: int = 0

    if bootstrap_mode {
        mut var preclear_i: int = 0

        while preclear_i < funcs.len() {
            var preclear_name: string = (funcs[preclear_i]).Name.Value
            var preclear_skip: bool = should_skip_bootstrap_function(
                &preclear_name,
                bootstrap_mode,
            )

            if preclear_skip {
                // Param counts are captured in param_counts before this pass.
                // Clear skipped declarations aggressively to reduce retained AST.
                clear_function_decl(&mut funcs[preclear_i])
                skip_flags[preclear_i] = 1
                skip_count = skip_count + 1
            }

            preclear_i = preclear_i + 1
        }
    }

    var emit_target_count: int = funcs.len() - skip_count

    mut var state_scopes: Vec<Scope, _> = Vec.with_cap(16)
    mut var state_scope_pool: Vec<Scope, _> = Vec.with_cap(16)
    mut var state_local_slots: Vec<int, _> = Vec.with_cap(64)
    mut var state_local_names: Vec<string, _> = Vec.with_cap(64)
    mut var state_local_hashes: Vec<int, _> = Vec.with_cap(64)
    mut var state_local_name_lens: Vec<int, _> = Vec.with_cap(64)
    mut var state_local_offsets: Vec<int, _> = Vec.with_cap(64)
    mut var state_local_scope_markers: Vec<int, _> = Vec.with_cap(32)
    mut var state_ref_scope_markers: Vec<int, _> = Vec.with_cap(32)
    mut var state_loop_stack: Vec<LoopContext, _> = Vec.with_cap(32)
    mut var state_data_items: Vec<DataItem, _> = Vec.with_cap(128)
    mut var state_code_patches: Vec<int, _> = Vec.with_cap(256)
    mut var state_data_patches: Vec<int, _> = Vec.with_cap(128)
    mut var state_call_patches: Vec<CallPatch, _> = Vec.with_cap(128)
    mut var state_call_target_pool: Vec<string, _> = Vec.with_cap(64)
    mut var state_string_literal_cache: Vec<StringHeaderCacheEntry, _> = Vec.with_cap(64)
    mut var state_structs: Vec<ast.StructDecl, _> = Vec.with_cap(16)
    mut var state_constants: Vec<ast.ConstStatement, _> = Vec.with_cap(16)
    mut var state_enums: Vec<ast.EnumDecl, _> = Vec.with_cap(16)
    mut var state_functions: Vec<FunctionSymbol, _> = Vec.with_cap(funcs.len() + 64)
    mut var state_ref_param_names: Vec<string, _> = Vec.with_cap(64)
    mut var state_ref_param_hashes: Vec<int, _> = Vec.with_cap(64)
    mut var state_ref_param_name_lens: Vec<int, _> = Vec.with_cap(64)
    mut var state: BackendEmitState = BackendEmitState{
        args_cache_data_index:   -1,
        bootstrap_error_header:  -1,
        bootstrap_line_header:   -1,
        bootstrap_mode:          bootstrap_mode,
        bootstrap_msg_header:    -1,
        bootstrap_native_header: -1,
        call_patches:            state_call_patches,
        call_target_pool:        state_call_target_pool,
        code_patches:            state_code_patches,
        constants:               state_constants,
        current_function:        "",
        current_pkg:             "main",
        data_items:              state_data_items,
        data_patches:            state_data_patches,
        entry_offset:            0,
        enums:                   state_enums,
        functions:               state_functions,
        init_rsp_data_index:     -1,
        local_hashes:            state_local_hashes,
        local_name_lens:         state_local_name_lens,
        local_names:             state_local_names,
        local_offsets:           state_local_offsets,
        local_scope_markers:     state_local_scope_markers,
        local_slots:             state_local_slots,
        loop_stack:              state_loop_stack,
        main_stmt_seq:           0,
        ref_param_hashes:        state_ref_param_hashes,
        ref_param_name_lens:     state_ref_param_name_lens,
        ref_param_names:         state_ref_param_names,
        ref_scope_markers:       state_ref_scope_markers,
        scope_pool:              state_scope_pool,
        scopes:                  state_scopes,
        string_literal_cache:    state_string_literal_cache,
        structs:                 state_structs,
        time_counter_data_index: -1,
        trace_assign_rhs:        false,
    }
    mut var init_struct_i: int = 0

    while init_struct_i < structs.len() {
        state_structs.push((*structs)[init_struct_i])
        init_struct_i = init_struct_i + 1
    }

    mut var init_const_i: int = 0

    while init_const_i < consts.len() {
        state_constants.push((*consts)[init_const_i])
        init_const_i = init_const_i + 1
    }

    mut var init_enum_i: int = 0

    while init_enum_i < enums.len() {
        state_enums.push((*enums)[init_enum_i])
        init_enum_i = init_enum_i + 1
    }

    mut var fi: int = 0

    while fi < funcs.len() {
        var fnName: string = (funcs[fi]).Name.Value


        mut var userRetType: string = ""

        if !bootstrap_mode {
            switch type_name_from_type_expr(&(funcs[fi]).ReturnType) {
                case Some(rtName) {
                    if rtName == "string" || is_float_type_name(&rtName) {
                        userRetType = rtName
                    }
                }
                case None {
                }
            }
        }

        mut var fnBorrowMask: int = 0

        if !bootstrap_mode {
            fnBorrowMask = param_borrow_mask_from_decl(&funcs[fi])
        }

        var fnParamCount: int = param_counts[fi]

        state.functions.push(
            FunctionSymbol{
                name:              fnName,
                offset:            -1,
                param_borrow_mask: fnBorrowMask,
                param_count:       fnParamCount,
                return_type:       userRetType,
            },
        )
        fi = fi + 1
    }

    // Param counts are only needed while seeding function symbols.
    param_counts = Vec.with_cap(0)


    mut var has_main: bool = false
    mut var main_scan_i: int = 0

    while main_scan_i < funcs.len() {
        var scan_name: string = (funcs[main_scan_i]).Name.Value

        if scan_name == "main" {
            has_main = true
            main_scan_i = funcs.len()
        } else if scan_name.endsWith(".main") {
            has_main = true
            main_scan_i = funcs.len()
        } else {
            main_scan_i = main_scan_i + 1
        }
    }

    if !has_main {
        return Err("epf:main")
    }

    ensure_runtime_data_slots(&mut state)

    // Keep reserve below the 2GB cgroup edge while still avoiding frequent grows.
    mut var code: Vec<int, _> = Vec.with_cap(131072)

    emit_runtime_stubs(
        &mut state,
        &mut code,
    )
    var weighted_emit_order: bool = false

    if bootstrap_mode && weighted_emit_order {
        mut var emit_ord_i: int = 0

        while emit_ord_i < emit_target_count {
            mut var best_idx: int = -1
            mut var best_weight: int = -1
            mut var cand_i: int = 0

            while cand_i < funcs.len() {
                if skip_flags[cand_i] == 0 {
                    var cand_weight: int = function_emit_weight(&funcs[cand_i])

                    if best_idx < 0 || cand_weight > best_weight {
                        best_idx = cand_i
                        best_weight = cand_weight
                    }
                }

                cand_i = cand_i + 1
            }

            if best_idx < 0 {
                return Err("epf:emit-order")
            }

            skip_flags[best_idx] = 1

            var emitRes: Result<void, string> = emit_program_function_at(
                &mut code,
                &mut state,
                funcs,
                best_idx,
            )

            switch emitRes {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                    clear_function_decl_emit_done(&mut funcs[best_idx])
                }
            }

            emit_ord_i = emit_ord_i + 1

            if !bootstrap_mode || emit_ord_i % 32 == 0 {
                compact_resolved_call_patches(
                    &mut state,
                    &mut code,
                )
            }
        }
    } else {
        mut var emit_scan_i: int = 0
        mut var emit_ord_i: int = 0

        while emit_scan_i < funcs.len() {
            if skip_flags[emit_scan_i] != 0 {
                emit_scan_i = emit_scan_i + 1
                continue
            }

            var emitRes: Result<void, string> = emit_program_function_at(
                &mut code,
                &mut state,
                funcs,
                emit_scan_i,
            )

            switch emitRes {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                    clear_function_decl_emit_done(&mut funcs[emit_scan_i])
                }
            }

            emit_scan_i = emit_scan_i + 1
            emit_ord_i = emit_ord_i + 1

            if !bootstrap_mode || emit_ord_i % 32 == 0 {
                compact_resolved_call_patches(
                    &mut state,
                    &mut code,
                )
            }
        }
    }


    compact_resolved_call_patches(
        &mut state,
        &mut code,
    )


    var main_name: string = "main"
    mut var main_off: int = -1
    mut var main_i: int = 0

    while main_i < state.functions.len() {
        var main_sym_name: &string = &(state.functions[main_i]).name

        if *main_sym_name == main_name {
            if (state.functions[main_i]).offset >= 0 {
                main_off = (state.functions[main_i]).offset
                main_i = state.functions.len()
            }
        } else if (*main_sym_name).endsWith(".main") {
            if (state.functions[main_i]).offset >= 0 {
                main_off = (state.functions[main_i]).offset
                main_i = state.functions.len()
            }
        }

        if main_i < state.functions.len() {
            main_i = main_i + 1
        }
    }

    if main_off < 0 {
        return Err("epf:main-off")
    }

    state.entry_offset = code.len()
    emit_entry_stub(
        &mut code,
        &mut state,
        main_off,
    )
    // Self-host fallback: patch init-rsp slot directly from finalized text start.
    // finalize_data later may apply the structured relocation to the same value.
    patch_u32(
        &mut code,
        state.entry_offset + 3,
        0x400000 + code.len(),
    )

    var patchRes: Result<void, string> = patch_calls(
        &state.functions,
        &state.call_patches,
        &state.call_target_pool,
        &mut code,
        bootstrap_mode,
    )


    switch patchRes {
        case Err(msg) {
            return Err("epf:patch " + msg)
        }
        case Ok(_) {
        }
    }


    var text_size: int = code.len()
    var dataRes: Result<void, string> = finalize_data(
        &mut state,
        &mut code,
    )

    switch dataRes {
        case Err(msg) {
            return Err("epf:data " + msg)
        }
        case Ok(_) {
        }
    }


    return Ok(
        CodeResult{
            code:         code,
            entry_offset: state.entry_offset,
            text_size:    text_size,
        },
    )
}

func emit_program_function_at(
    mut code: &mut Vec<int, _>,
    mut state: &mut BackendEmitState,
    mut funcs: &mut Vec<ast.FunctionDecl, _>,
    emit_idx: int,
) -> (Result<void, string>) {
    var fd_name: string = (funcs[emit_idx]).Name.Value

    mut var i: int = 0
    mut var recovered: bool = false

    while i < state.functions.len() {
        if bootstrap_target_matches(
            &(state.functions[i]).name,
            &fd_name,
        ) {
            (state.functions[i]).offset = code.len()
            recovered = true
        }

        i = i + 1
    }

    if !recovered && (fd_name == "main" || fd_name.endsWith(".main")) {
        i = 0

        while i < state.functions.len() {
            if (state.functions[i]).name == "main" || (state.functions[i]).name.endsWith(".main") {
                (state.functions[i]).offset = code.len()
                recovered = true
            }

            i = i + 1
        }
    }

    if !recovered {
        i = 0

        while i < state.functions.len() {
            if (state.functions[i]).offset < 0 && !(state.functions[i]).name.startsWith("__rt_") {
                (state.functions[i]).offset = code.len()
                recovered = true
                break
            }

            i = i + 1
        }
    }

    if !recovered {
        return Err("epf:offset " + fd_name)
    }

    var res: Result<void, string> = emit_function(
        code,
        state,
        &funcs[emit_idx],
    )


    switch res {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }


    if !state.bootstrap_mode {
        clear_function_decl_emit_done(&mut funcs[emit_idx])
    }


    return Ok(void)
}

func emit_program_items_into(
    items: &ProgramItems,
    mut out: &mut CodeResult,
) -> (Result<void, string>) {
    mut var funcsCopy: Vec<ast.FunctionDecl, _> = items.functions
    mut var structsCopy: Vec<ast.StructDecl, _> = items.structs
    mut var constsCopy: Vec<ast.ConstStatement, _> = items.constants
    mut var enumsCopy: Vec<ast.EnumDecl, _> = items.enums
    var res: Result<CodeResult, string> = emit_program_functions(
        &mut funcsCopy,
        &mut structsCopy,
        &mut constsCopy,
        &mut enumsCopy,
    )

    switch res {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(cr) {
            out.code = cr.code
            out.entry_offset = cr.entry_offset
            out.text_size = cr.text_size

            return Ok(void)
        }
    }
}

func emit_program_items(items: &ProgramItems) -> (Result<CodeResult, string>) {
    mut var funcsCopy: Vec<ast.FunctionDecl, _> = items.functions
    mut var structsCopy: Vec<ast.StructDecl, _> = items.structs
    mut var constsCopy: Vec<ast.ConstStatement, _> = items.constants
    mut var enumsCopy: Vec<ast.EnumDecl, _> = items.enums

    return emit_program_functions(
        &mut funcsCopy,
        &mut structsCopy,
        &mut constsCopy,
        &mut enumsCopy,
    )
}

func emit_program_functions_ref(
    funcs: &Vec<ast.FunctionDecl, _>,
    structs: &Vec<ast.StructDecl, _>,
    consts: &Vec<ast.ConstStatement, _>,
    enums: &Vec<ast.EnumDecl, _>,
) -> (Result<CodeResult, string>) {
    mut var funcsCopy: Vec<ast.FunctionDecl, _> = Vec.with_cap(funcs.len())
    mut var structsCopy: Vec<ast.StructDecl, _> = Vec.with_cap(structs.len())
    mut var constsCopy: Vec<ast.ConstStatement, _> = Vec.with_cap(consts.len())
    mut var enumsCopy: Vec<ast.EnumDecl, _> = Vec.with_cap(enums.len())
    mut var funcsCopyI: int = 0

    while funcsCopyI < funcs.len() {
        funcsCopy.push((*funcs)[funcsCopyI])
        funcsCopyI = funcsCopyI + 1
    }

    mut var structsCopyI: int = 0

    while structsCopyI < structs.len() {
        structsCopy.push((*structs)[structsCopyI])
        structsCopyI = structsCopyI + 1
    }

    mut var constsCopyI: int = 0

    while constsCopyI < consts.len() {
        constsCopy.push((*consts)[constsCopyI])
        constsCopyI = constsCopyI + 1
    }

    mut var enumsCopyI: int = 0

    while enumsCopyI < enums.len() {
        enumsCopy.push((*enums)[enumsCopyI])
        enumsCopyI = enumsCopyI + 1
    }

    return emit_program_functions(
        &mut funcsCopy,
        &mut structsCopy,
        &mut constsCopy,
        &mut enumsCopy,
    )
}

func clear_function_decl_body(fd: &mut ast.FunctionDecl) -> (void) {
    fd.Body.Statements = Vec.with_cap(0)
}

func clear_function_decl(fd: &mut ast.FunctionDecl) -> (void) {
    mut var empty_params: Vec<ast.Parameter, _> = Vec.with_cap(0)
    mut var empty_type_params: Vec<ast.Identifier, _> = Vec.with_cap(0)

    clear_function_decl_body(fd)
    fd.Parameters = empty_params
    fd.TypeParams = empty_type_params
}

func clear_function_decl_emit_done(fd: &mut ast.FunctionDecl) -> (void) {
    clear_function_decl(fd)
    fd.Name.Value = ""
}

func function_emit_weight(fd: &ast.FunctionDecl) -> (int) {
    return fd.Body.Statements.len() * 16 + fd.Parameters.len() * 4 + fd.TypeParams.len()
}

func should_skip_bootstrap_function(
    name: &string,
    bootstrap_mode: bool,
) -> (bool) {
    if !bootstrap_mode {
        return false
    }

    if *name == "main" || (*name).endsWith(".main") {
        return false
    }

    if (*name).startsWith("__rt_") {
        return false
    }

    if (*name).startsWith("bakc.") || (*name).startsWith("driver.") || (*name).startsWith("parser.") || (*name).startsWith("lexer.") || (*name).startsWith("token.") || (*name).startsWith("ast.") || (*name).startsWith("native.") || (*name).startsWith("fs.") || (*name).startsWith("os.") || (*name).startsWith("strconv.") || (*name).startsWith("strings.") || (*name).startsWith("bytes.") || (*name).startsWith("time.") {
        return false
    }

    if (*name).startsWith("codegen.") || (*name).startsWith("bytecode.") || (*name).startsWith("emit.") || (*name).startsWith("typecheck.") || (*name).startsWith("thread.") || (*name).startsWith("rand.") || (*name).startsWith("log.") || (*name).startsWith("crypto.") || (*name).startsWith("fmt.") {
        return true
    }

    return true
}

pub func ShouldSkipBootstrapFunction(name: &string) -> (bool) {
    return should_skip_bootstrap_function(
        name,
        true,
    )
}

func contains_substring(haystack: &string, needle: &string) -> (bool) {
    if needle.len() == 0 {
        return true
    }

    if haystack.len() < needle.len() {
        return false
    }

    mut var i: int = 0

    while i + needle.len() <= haystack.len() {
        mut var j: int = 0
        mut var matched: bool = true

        while j < needle.len() {
            if haystack[i + j] != needle[j] {
                matched = false
                break
            }

            j = j + 1
        }

        if matched {
            return true
        }

        i = i + 1
    }

    return false
}

func intern_call_target(
    mut state: &mut BackendEmitState,
    target: &string,
) -> (int) {
    mut var i: int = 0

    while i < state.call_target_pool.len() {
        if str_eq(
            &state.call_target_pool[i],
            target,
        ) {
            return i
        }

        i = i + 1
    }

    state.call_target_pool.push(copyString(target))

    return state.call_target_pool.len() - 1
}

func add_call_patch(
    mut state: &mut BackendEmitState,
    imm_offset: int,
    target: string,
) -> (void) {
    var target_id: int = intern_call_target(
        state,
        &target,
    )

    state.call_patches.push(
        CallPatch{
            imm_offset: imm_offset,
            target_id:  target_id,
        },
    )

    return
}

func is_skipped_call_target(
    target: &string,
    functions: &Vec<FunctionSymbol, _>,
    bootstrap_mode: bool,
) -> (bool) {
    if should_skip_bootstrap_function(
        target,
        bootstrap_mode,
    ) {
        return true
    }

    for fsym in *functions {
        if should_skip_bootstrap_function(
            &fsym.name,
            bootstrap_mode,
        ) && bootstrap_target_matches(
            &fsym.name,
            target,
        ) {
            return true
        }
    }

    return false
}

func add_runtime_stub(
    mut functions: &mut Vec<FunctionSymbol, _>,
    name: string,
    offset: int,
    param_count: int,
) -> (void) {
    functions.push(
        FunctionSymbol{
            name:              name,
            offset:            offset,
            param_borrow_mask: 0,
            param_count:       param_count,
            return_type:       "",
        },
    )

    return
}

func emit_runtime_brk_local(mut code: &mut Vec<int, _>) -> (void) {
    x86.emit_mov_rax_imm32(
        code,
        12,
    )
    emit_raw_syscall(code)
    x86.emit_ret(code)
}

func emit_runtime_str_eq_local(mut code: &mut Vec<int, _>) -> (void) {
    x86.emit_push_reg(
        code,
        x86.RBP,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RBP,
        x86.RSP,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0x400000,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.RDI,
        x86.RCX,
    )

    var jl_scalar_a: int = code.len()

    x86.emit_jl_rel32(
        code,
        0,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.RSI,
        x86.RCX,
    )

    var jl_scalar_b: int = code.len()

    x86.emit_jl_rel32(
        code,
        0,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.RDI,
        x86.RSI,
    )

    var jz_equal_same: int = code.len()

    x86.emit_jz_rel32(
        code,
        0,
    )
    x86.emit_test_reg_reg(
        code,
        x86.RDI,
        x86.RDI,
    )

    var jz_not_a: int = code.len()

    x86.emit_jz_rel32(
        code,
        0,
    )
    x86.emit_test_reg_reg(
        code,
        x86.RSI,
        x86.RSI,
    )

    var jz_not_b: int = code.len()

    x86.emit_jz_rel32(
        code,
        0,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RAX,
        x86.RDI,
        8,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RCX,
        x86.RSI,
        8,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.RAX,
        x86.RCX,
    )

    var jnz_not_len: int = code.len()

    x86.emit_jnz_rel32(
        code,
        0,
    )
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_equal_len0: int = code.len()

    x86.emit_jz_rel32(
        code,
        0,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RDX,
        x86.RDI,
        0,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R8,
        x86.RSI,
        0,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RSI,
        x86.RDX,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.R8,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RCX,
        x86.RAX,
    )
    x86.emit_repe_cmpsb(code)

    var jnz_not_bytes: int = code.len()

    x86.emit_jnz_rel32(
        code,
        0,
    )

    var equal_label: int = code.len()

    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        1,
    )

    var jmp_equal_end: int = code.len()

    x86.emit_jmp_rel32(
        code,
        0,
    )

    var not_label: int = code.len()

    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        0,
    )

    var jmp_not_end: int = code.len()

    x86.emit_jmp_rel32(
        code,
        0,
    )

    var scalar_label: int = code.len()

    x86.emit_cmp_reg_reg(
        code,
        x86.RDI,
        x86.RSI,
    )
    x86.emit_sete(code)
    x86.emit_movzx_rax_al(code)

    var jmp_scalar_end: int = code.len()

    x86.emit_jmp_rel32(
        code,
        0,
    )

    var end_label: int = code.len()

    patch_rel32(
        code,
        jl_scalar_a + 2,
        scalar_label,
    )
    patch_rel32(
        code,
        jl_scalar_b + 2,
        scalar_label,
    )
    patch_rel32(
        code,
        jz_equal_same + 2,
        equal_label,
    )
    patch_rel32(
        code,
        jz_not_a + 2,
        not_label,
    )
    patch_rel32(
        code,
        jz_not_b + 2,
        not_label,
    )
    patch_rel32(
        code,
        jnz_not_len + 2,
        not_label,
    )
    patch_rel32(
        code,
        jz_equal_len0 + 2,
        equal_label,
    )
    patch_rel32(
        code,
        jnz_not_bytes + 2,
        not_label,
    )
    patch_rel32(
        code,
        jmp_equal_end + 1,
        end_label,
    )
    patch_rel32(
        code,
        jmp_not_end + 1,
        end_label,
    )
    patch_rel32(
        code,
        jmp_scalar_end + 1,
        end_label,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RSP,
        x86.RBP,
    )
    x86.emit_pop_reg(
        code,
        x86.RBP,
    )
    x86.emit_ret(code)
}

func emit_runtime_stubs(
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (void) {
    mut var off: int = 0
    mut var alloc_off: int = 0

    code.push(0x48)
    code.push(0xc7)
    code.push(0xc0)
    code.push(12)
    code.push(0)
    code.push(0)
    code.push(0)
    code.push(0x0f)
    code.push(0x05)
    code.push(0xc3)
    state.functions.push(
        FunctionSymbol{
            name:              "__rt_brk",
            offset:            0,
            param_borrow_mask: 0,
            param_count:       1,
            return_type:       "",
        },
    )
    off = code.len()
    rt.emit_runtime_mmap(code)
    state.functions.push(
        FunctionSymbol{
            name:              "__rt_mmap",
            offset:            off,
            param_borrow_mask: 0,
            param_count:       6,
            return_type:       "",
        },
    )
    off = code.len()
    // Inline bump allocator with heap_pos/heap_end data slots.
    // __rt_alloc(size in RDI) -> pointer in RAX
    x86.emit_push_reg(
        code,
        x86.RBP,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RBP,
        x86.RSP,
    )
    x86.emit_push_reg(
        code,
        x86.RBX,
    )
    x86.emit_push_reg(
        code,
        x86.R12,
    )
    x86.emit_push_reg(
        code,
        x86.R13,
    )
    // Align size: rdi = (rdi + 7) & ~7
    x86.emit_add_reg_imm8(
        code,
        x86.RDI,
        7,
    )
    code.push(0x48)
    code.push(0x83)
    code.push(0xE7)
    code.push(0xF8)
    x86.emit_mov_reg_reg(
        code,
        x86.RBX,
        x86.RDI,
    )
    // Load address of heap_pos slot into R12 (mov r12, sign-extended-imm32)
    code.push(0x49)
    code.push(0xC7)
    code.push(0xC4)

    var heap_pos_patch_off: int = code.len()

    code.push(0)
    code.push(0)
    code.push(0)
    code.push(0)
    state.code_patches.push(RUNTIME_DATA_HEAP_POS_INDEX)
    state.code_patches.push(heap_pos_patch_off)
    // Load address of heap_end slot into R13 (mov r13, sign-extended-imm32)
    code.push(0x49)
    code.push(0xC7)
    code.push(0xC5)

    var heap_end_patch_off: int = code.len()

    code.push(0)
    code.push(0)
    code.push(0)
    code.push(0)
    state.code_patches.push(RUNTIME_DATA_HEAP_END_INDEX)
    state.code_patches.push(heap_end_patch_off)
    // Load heap_pos: rcx = [r12]
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RCX,
        x86.R12,
        0,
    )
    // If heap_pos == 0 -> initialize
    x86.emit_test_reg_reg(
        code,
        x86.RCX,
        x86.RCX,
    )

    var jnz_has_heap: int = emit_jnz_placeholder(code)

    // Init: brk(0)
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        0,
    )
    x86.emit_mov_rax_imm32(
        code,
        12,
    )
    emit_raw_syscall(code)
    // Align initial break
    x86.emit_add_reg_imm8(
        code,
        x86.RAX,
        7,
    )
    code.push(0x48)
    code.push(0x83)
    code.push(0xE0)
    code.push(0xF8)
    x86.emit_mov_reg_reg(
        code,
        x86.RCX,
        x86.RAX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.R12,
        0,
        x86.RCX,
    )
    // heap_end = heap_pos + 4MB, brk(heap_end)
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.RCX,
    )
    x86.emit_mov_rax_imm32(
        code,
        4194304,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RDI,
        x86.RAX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.R13,
        0,
        x86.RDI,
    )
    x86.emit_mov_rax_imm32(
        code,
        12,
    )
    emit_raw_syscall(code)
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RCX,
        x86.R12,
        0,
    )

    // .has_heap:
    var has_heap_pos: int = code.len()

    patch_rel32(
        code,
        jnz_has_heap,
        has_heap_pos,
    )
    // rdx = new_pos = heap_pos + aligned_size
    x86.emit_mov_reg_reg(
        code,
        x86.RDX,
        x86.RCX,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RDX,
        x86.RBX,
    )
    // rdi = heap_end
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RDI,
        x86.R13,
        0,
    )
    // if new_pos <= heap_end -> fast path
    x86.emit_cmp_reg_reg(
        code,
        x86.RDX,
        x86.RDI,
    )
    // jbe .fits (unsigned below or equal)
    code.push(0x0F)
    code.push(0x86)

    var jbe_fits_off: int = code.len()

    code.push(0)
    code.push(0)
    code.push(0)
    code.push(0)
    // Slow path: new_end = max(new_pos, heap_end + 4MB)
    x86.emit_mov_rax_imm32(
        code,
        4194304,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RDI,
        x86.RAX,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.RDX,
        x86.RDI,
    )
    // jbe .use_chunk
    code.push(0x0F)
    code.push(0x86)

    var jbe_chunk_off: int = code.len()

    code.push(0)
    code.push(0)
    code.push(0)
    code.push(0)
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.RDX,
    )

    var use_chunk_pos: int = code.len()

    patch_rel32(
        code,
        jbe_chunk_off,
        use_chunk_pos,
    )
    // brk(rdi) — syscall clobbers rcx,r11, so save
    x86.emit_push_reg(
        code,
        x86.RCX,
    )
    x86.emit_push_reg(
        code,
        x86.RDX,
    )
    x86.emit_push_reg(
        code,
        x86.RDI,
    )
    x86.emit_mov_rax_imm32(
        code,
        12,
    )
    emit_raw_syscall(code)
    x86.emit_pop_reg(
        code,
        x86.RDI,
    )
    x86.emit_pop_reg(
        code,
        x86.RDX,
    )
    x86.emit_pop_reg(
        code,
        x86.RCX,
    )
    // Check brk success
    x86.emit_cmp_reg_reg(
        code,
        x86.RAX,
        x86.RDI,
    )
    // jge .ok
    code.push(0x0F)
    code.push(0x8D)

    var jge_ok_off: int = code.len()

    code.push(0)
    code.push(0)
    code.push(0)
    code.push(0)
    // OOM: exit(1)
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        1,
    )
    x86.emit_mov_rax_imm32(
        code,
        60,
    )
    emit_raw_syscall(code)

    // .ok: update heap_end
    var ok_pos: int = code.len()

    patch_rel32(
        code,
        jge_ok_off,
        ok_pos,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.R13,
        0,
        x86.RDI,
    )

    // .fits: update heap_pos, return old heap_pos
    var fits_pos: int = code.len()

    patch_rel32(
        code,
        jbe_fits_off,
        fits_pos,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.R12,
        0,
        x86.RDX,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RAX,
        x86.RCX,
    )
    x86.emit_pop_reg(
        code,
        x86.R13,
    )
    x86.emit_pop_reg(
        code,
        x86.R12,
    )
    x86.emit_pop_reg(
        code,
        x86.RBX,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RSP,
        x86.RBP,
    )
    x86.emit_pop_reg(
        code,
        x86.RBP,
    )
    x86.emit_ret(code)
    state.functions.push(
        FunctionSymbol{
            name:              "__rt_alloc",
            offset:            off,
            param_borrow_mask: 0,
            param_count:       1,
            return_type:       "",
        },
    )
    alloc_off = off
    off = code.len()
    rt.emit_runtime_realloc(
        code,
        alloc_off,
    )
    state.functions.push(
        FunctionSymbol{
            name:              "__rt_realloc",
            offset:            off,
            param_borrow_mask: 0,
            param_count:       3,
            return_type:       "",
        },
    )
    off = code.len()
    rt.emit_runtime_itoa(
        code,
        alloc_off,
    )
    state.functions.push(
        FunctionSymbol{
            name:              "__rt_itoa",
            offset:            off,
            param_borrow_mask: 0,
            param_count:       1,
            return_type:       "",
        },
    )
    off = code.len()
    rt.emit_runtime_write(code)
    state.functions.push(
        FunctionSymbol{
            name:              "__rt_write",
            offset:            off,
            param_borrow_mask: 0,
            param_count:       3,
            return_type:       "",
        },
    )
    off = code.len()
    rt.emit_runtime_println_str(code)
    state.functions.push(
        FunctionSymbol{
            name:              "__rt_println_str",
            offset:            off,
            param_borrow_mask: 0,
            param_count:       1,
            return_type:       "",
        },
    )
    off = code.len()
    rt.emit_runtime_print_str(code)
    state.functions.push(
        FunctionSymbol{
            name:              "__rt_print_str",
            offset:            off,
            param_borrow_mask: 0,
            param_count:       1,
            return_type:       "",
        },
    )
    off = code.len()
    rt.emit_runtime_panic(code)
    state.functions.push(
        FunctionSymbol{
            name:              "__rt_panic",
            offset:            off,
            param_borrow_mask: 0,
            param_count:       1,
            return_type:       "",
        },
    )
    off = code.len()
    rt.emit_runtime_print_int(code)
    state.functions.push(
        FunctionSymbol{
            name:              "__rt_print_int",
            offset:            off,
            param_borrow_mask: 0,
            param_count:       1,
            return_type:       "",
        },
    )
    off = code.len()
    rt.emit_runtime_str_eq(code)
    state.functions.push(
        FunctionSymbol{
            name:              "__rt_str_eq",
            offset:            off,
            param_borrow_mask: 0,
            param_count:       2,
            return_type:       "",
        },
    )
    off = code.len()
    rt.emit_runtime_open(code)
    state.functions.push(
        FunctionSymbol{
            name:              "__rt_open",
            offset:            off,
            param_borrow_mask: 0,
            param_count:       3,
            return_type:       "",
        },
    )
    off = code.len()
    rt.emit_runtime_read(code)
    state.functions.push(
        FunctionSymbol{
            name:              "__rt_read",
            offset:            off,
            param_borrow_mask: 0,
            param_count:       3,
            return_type:       "",
        },
    )
    off = code.len()
    rt.emit_runtime_close(code)
    state.functions.push(
        FunctionSymbol{
            name:              "__rt_close",
            offset:            off,
            param_borrow_mask: 0,
            param_count:       1,
            return_type:       "",
        },
    )
    off = code.len()
    rt.emit_runtime_stat(code)
    state.functions.push(
        FunctionSymbol{
            name:              "__rt_stat",
            offset:            off,
            param_borrow_mask: 0,
            param_count:       2,
            return_type:       "",
        },
    )
    off = code.len()
    rt.emit_runtime_fstat(code)
    state.functions.push(
        FunctionSymbol{
            name:              "__rt_fstat",
            offset:            off,
            param_borrow_mask: 0,
            param_count:       2,
            return_type:       "",
        },
    )
    off = code.len()
    rt.emit_runtime_lseek(code)
    state.functions.push(
        FunctionSymbol{
            name:              "__rt_lseek",
            offset:            off,
            param_borrow_mask: 0,
            param_count:       3,
            return_type:       "",
        },
    )
    off = code.len()
    rt.emit_runtime_getcwd(code)
    state.functions.push(
        FunctionSymbol{
            name:              "__rt_getcwd",
            offset:            off,
            param_borrow_mask: 0,
            param_count:       2,
            return_type:       "",
        },
    )
    off = code.len()
    rt.emit_runtime_getdents64(code)
    state.functions.push(
        FunctionSymbol{
            name:              "__rt_getdents64",
            offset:            off,
            param_borrow_mask: 0,
            param_count:       3,
            return_type:       "",
        },
    )
    off = code.len()
    rt.emit_runtime_mkdir(code)
    state.functions.push(
        FunctionSymbol{
            name:              "__rt_mkdir",
            offset:            off,
            param_borrow_mask: 0,
            param_count:       2,
            return_type:       "",
        },
    )
    off = code.len()
    rt.emit_runtime_unlink(code)
    state.functions.push(
        FunctionSymbol{
            name:              "__rt_unlink",
            offset:            off,
            param_borrow_mask: 0,
            param_count:       1,
            return_type:       "",
        },
    )
    off = code.len()
    rt.emit_runtime_rename(code)
    state.functions.push(
        FunctionSymbol{
            name:              "__rt_rename",
            offset:            off,
            param_borrow_mask: 0,
            param_count:       2,
            return_type:       "",
        },
    )
    off = code.len()
    rt.emit_runtime_vec_clone(
        code,
        alloc_off,
    )
    state.functions.push(
        FunctionSymbol{
            name:              "__rt_vec_clone",
            offset:            off,
            param_borrow_mask: 0,
            param_count:       3,
            return_type:       "",
        },
    )

    return
}

func emit_entry_stub(
    mut code: &mut Vec<int, _>,
    state: &mut BackendEmitState,
    main_off: int,
) -> (void) {
    // Save initial stack pointer for os.args().
    var init_rsp_idx: int = ensure_init_rsp_index(state)
    var init_rsp_start: int = code.len()

    // mov rax, imm32 (relocated to runtime data slot)
    code.push(0x48)
    code.push(0xC7)
    code.push(0xC0)
    code.push(0x00)
    code.push(0x00)
    code.push(0x00)
    code.push(0x00)
    state.code_patches.push(init_rsp_idx)
    state.code_patches.push(init_rsp_start + 3)
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.RSP,
    )
    x86.emit_call_rel32(
        code,
        0,
    )
    patch_rel32(
        code,
        code.len() - 4,
        main_off,
    )
    x86.emit_mov_rdi_rax(code)
    x86.emit_mov_rax_imm32(
        code,
        60,
    )
    emit_raw_syscall(code)

    return
}

func emit_raw_syscall(mut code: &mut Vec<int, _>) -> (void) {
    code.push(0x0f)
    code.push(0x05)

    return
}

func reset_function_state(mut state: &mut BackendEmitState) -> (void) {
    while state.scopes.len() > 0 {
        var last_scope_i: int = state.scopes.len() - 1

        state.scopes[last_scope_i] = Scope{
            enum_bindings: Vec.with_cap(0),
            iterables:     Vec.with_cap(0),
            local_types:   Vec.with_cap(0),
            locals:        Vec.with_cap(0),
            structs:       Vec.with_cap(0),
        }

        var _ = state.scopes.pop()
    }

    while state.local_slots.len() > 0 {
        var _ = state.local_slots.pop()
    }

    while state.local_names.len() > 0 {
        var last_local_name_i: int = state.local_names.len() - 1

        state.local_names[last_local_name_i] = ""

        var _ = state.local_names.pop()
    }

    while state.local_hashes.len() > 0 {
        var _ = state.local_hashes.pop()
    }

    while state.local_name_lens.len() > 0 {
        var _ = state.local_name_lens.pop()
    }

    while state.local_offsets.len() > 0 {
        var _ = state.local_offsets.pop()
    }

    while state.local_scope_markers.len() > 0 {
        var _ = state.local_scope_markers.pop()
    }

    while state.ref_scope_markers.len() > 0 {
        var _ = state.ref_scope_markers.pop()
    }

    while state.loop_stack.len() > 0 {
        var last_loop_i: int = state.loop_stack.len() - 1

        state.loop_stack[last_loop_i] = LoopContext{
            break_sites:     Vec.with_cap(0),
            continue_sites:  Vec.with_cap(0),
            continue_target: 0,
        }

        var _ = state.loop_stack.pop()
    }

    while state.ref_param_names.len() > 0 {
        var last_ref_param_i: int = state.ref_param_names.len() - 1

        state.ref_param_names[last_ref_param_i] = ""

        var _ = state.ref_param_names.pop()
    }

    while state.ref_param_hashes.len() > 0 {
        var _ = state.ref_param_hashes.pop()
    }

    while state.ref_param_name_lens.len() > 0 {
        var _ = state.ref_param_name_lens.pop()
    }

    state.main_stmt_seq = 0
    state.trace_assign_rhs = false

    return
}

func patch_u32(mut code: &mut Vec<int, _>, idx: int, v: int) -> (void) {
    var n: int = code.len()

    if n == 0 {
        return
    }

    if idx < 0 {
        return
    }

    if idx >= n {
        return
    }

    if idx + 1 >= n {
        return
    }

    if idx + 2 >= n {
        return
    }

    if idx + 3 >= n {
        return
    }

    mut var p: int = idx

    code[p] = v & 0xff
    p = p + 1
    code[p] = v >> 8 & 0xff
    p = p + 1
    code[p] = v >> 16 & 0xff
    p = p + 1
    code[p] = v >> 24 & 0xff

    return
}

func patch_u64(mut code: &mut Vec<int, _>, idx: int, v: int) -> (void) {
    var n: int = code.len()

    if n == 0 {
        return
    }

    if idx < 0 {
        return
    }

    if idx >= n {
        return
    }

    if idx + 1 >= n {
        return
    }

    if idx + 2 >= n {
        return
    }

    if idx + 3 >= n {
        return
    }

    if idx + 4 >= n {
        return
    }

    if idx + 5 >= n {
        return
    }

    if idx + 6 >= n {
        return
    }

    if idx + 7 >= n {
        return
    }

    mut var p2: int = idx

    code[p2] = v & 0xff
    p2 = p2 + 1
    code[p2] = v >> 8 & 0xff
    p2 = p2 + 1
    code[p2] = v >> 16 & 0xff
    p2 = p2 + 1
    code[p2] = v >> 24 & 0xff
    p2 = p2 + 1
    code[p2] = v >> 32 & 0xff
    p2 = p2 + 1
    code[p2] = v >> 40 & 0xff
    p2 = p2 + 1
    code[p2] = v >> 48 & 0xff
    p2 = p2 + 1
    code[p2] = v >> 56 & 0xff

    return
}

// patch_rel32 computes a rel32 displacement from the end of the imm32 field.
func patch_rel32(
    mut code: &mut Vec<int, _>,
    imm_offset: int,
    target: int,
) -> (void) {
    var n: int = code.len()

    if n == 0 {
        return
    }

    if imm_offset < 0 {
        return
    }

    if imm_offset >= n {
        return
    }

    if imm_offset + 1 >= n {
        return
    }

    if imm_offset + 2 >= n {
        return
    }

    if imm_offset + 3 >= n {
        return
    }

    var rel: int = target - (imm_offset + 4)

    patch_u32(
        code,
        imm_offset,
        rel,
    )

    return
}

func emit_function(
    mut code: &mut Vec<int, _>,
    mut state: &mut BackendEmitState,
    fd: &ast.FunctionDecl,
) -> (Result<void, string>) {
    if state.bootstrap_mode {
        state.current_function = "main"
        state.current_pkg = "main"
    } else {
        state.current_function = fd.Name.Value

        // Track current package for qualified constant resolution without
        // depending on string index helpers in the self-host path.
        mut var last_dot: int = -1
        mut var pkg_scan_i: int = 0

        while pkg_scan_i < fd.Name.Value.len() {
            if fd.Name.Value[pkg_scan_i] == char('.') {
                last_dot = pkg_scan_i
            }

            pkg_scan_i = pkg_scan_i + 1
        }

        if last_dot > 0 {
            state.current_pkg = fd.Name.Value.substring(
                0,
                last_dot,
            )
        } else {
            state.current_pkg = "main"
        }
    }

    if fd.TypeParams.len() != 0 {
        return Err("native: unsupported @emit_function type_params")
    }


    if fd.Parameters.len() > 6 {
        return Err("native: too many parameters (max 6)")
    }

    if !state.bootstrap_mode && fd.Name.Value == "main" && fd.Parameters.len() != 0 {
        return Err("native: unsupported @emit_function main_params")
    }

    if !state.bootstrap_mode && fd.Name.Value.len() > 0 && !is_supported_return_type(fd.ReturnType) {
        return Err("native: return type not supported for " + fd.Name.Value)
    }

    mut var i: int = 0

    while i < fd.Parameters.len() {
        if !is_supported_param_type((fd.Parameters[i]).Type) {
            switch (fd.Parameters[i]).Type {
                case ast.TypeExpression.Simple(st) {
                }
                case ast.TypeExpression.Generic(gt) {
                }
                case ast.TypeExpression.BorrowRef(bt) {
                    switch bt.Inner {
                        case ast.TypeExpression.Simple(st2) {
                        }
                        case ast.TypeExpression.Generic(gt2) {
                        }
                        default {
                        }
                    }
                }
                case ast.TypeExpression.BoxRef(_) {
                }
                case ast.TypeExpression.BoxOptional(_) {
                }
                case ast.TypeExpression.TupleRef(_) {
                }
                case ast.TypeExpression.Function(_) {
                }
                case ast.TypeExpression.Size(_) {
                }
                case ast.TypeExpression.Void(_) {
                }
                case ast.TypeExpression.Error(_) {
                }
            }

            return Err("native: unsupported @emit_function param_type")
        }

        i = i + 1
    }

    mut var param_locals: int = 0

    i = 0

    while i < fd.Parameters.len() {
        if (fd.Parameters[i]).Name.Value != "_" {
            param_locals = param_locals + 1
        }

        i = i + 1
    }

    mut var body_locals: int = 128

    if !state.bootstrap_mode {
        var bodyLocalsRes: Result<int, string> = count_locals(&fd.Body)

        switch bodyLocalsRes {
            case Ok(n) {
                body_locals = n + 64

                if body_locals < 128 {
                    body_locals = 128
                }

                if body_locals > 1024 {
                    body_locals = 1024
                }
            }
            case Err(_) {
            }
        }
    }


    mut var stack_size: int = (param_locals + body_locals + 32) * 8

    if stack_size % 16 != 0 {
        stack_size = stack_size + (16 - stack_size % 16)
    }

    reset_function_state(state)
    // prologue
    code.push(0x55)
    code.push(0x48)
    code.push(0x89)
    code.push(0xe5)

    if stack_size > 0 {
        if stack_size <= 127 {
            x86.emit_sub_rsp_imm8(
                code,
                stack_size,
            )
        } else {
            x86.emit_sub_rsp_imm32(
                code,
                stack_size,
            )
        }
    }

    enter_scope(state)

    if fd.Parameters.len() > 0 {
        var bindRes: Result<void, string> = bind_parameters(
            &fd.Parameters,
            state,
            code,
        )

        switch bindRes {
            case Err(msg) {
                leave_scope(state)

                return Err(msg)
            }
            case Ok(_) {
            }
        }
    }

    var emitRes: Result<void, string> = emit_block_in_scope(
        &fd.Body,
        state,
        code,
    )


    switch emitRes {
        case Err(msg) {
            leave_scope(state)

            return Err(msg)
        }
        case Ok(_) {
        }
    }

    leave_scope(state)
    // default return 0
    x86.emit_mov_rax_imm32(
        code,
        0,
    )
    // epilogue
    x86.emit_mov_reg_reg(
        code,
        x86.RSP,
        x86.RBP,
    )
    x86.emit_pop_reg(
        code,
        x86.RBP,
    )
    x86.emit_ret(code)

    return Ok(void)
}

func emit_function_bridge(
    mut code: &mut Vec<int, _>,
    state: &mut BackendEmitState,
    fd: &ast.FunctionDecl,
) -> (Result<void, string>) {
    return emit_function(
        code,
        state,
        fd,
    )
}

func is_supported_return_type(t: ast.TypeExpression) -> (bool) {
    switch t {
        case ast.TypeExpression.Void(_) {
            return true
        }
        case ast.TypeExpression.Simple(st) {
            // int, bool, char are scalar; enum names are heap pointers (8 bytes)
            return true
        }
        case ast.TypeExpression.Generic(gt) {
            // Option<T>, Result<T,E>, Vec<T,_> are all heap pointers
            return gt.Name == "Option" || gt.Name == "Result" || gt.Name == "Vec"
        }
        case ast.TypeExpression.TupleRef(tt) {
            // multi-return (T1, T2, ...) is supported up to 2 values in RAX, RDX
            return tt.Elements.len() <= 2
        }
        case ast.TypeExpression.BorrowRef(_) {
            return true
        }
        default {
        }
    }

    return false
}

func is_supported_param_type(t: ast.TypeExpression) -> (bool) {
    switch t {
        case ast.TypeExpression.Simple(st) {
            // All simple types pass as 8-byte values (scalars or heap pointers)
            return true
        }
        case ast.TypeExpression.Generic(gt) {
            return gt.Name == "Option" || gt.Name == "Result" || gt.Name == "Vec"
        }
        case ast.TypeExpression.BorrowRef(_) {
            return true
        }
        default {
        }
    }

    return false
}

func count_param_locals(params: &Vec<ast.Parameter, _>) -> (int) {
    mut var count: int = 0
    mut var i: int = 0

    while i < params.len() {
        if ((*params)[i]).Name.Value != "_" {
            count = count + 1
        }

        i = i + 1
    }

    return count
}

func arg_register(index: int) -> (Option<int>) {
    switch index {
        case 0 {
            return Some(x86.RDI)
        }
        case 1 {
            return Some(x86.RSI)
        }
        case 2 {
            return Some(x86.RDX)
        }
        case 3 {
            return Some(x86.RCX)
        }
        case 4 {
            return Some(x86.R8)
        }
        case 5 {
            return Some(x86.R9)
        }
        default {
        }
    }

    return None
}

func bind_parameters(
    params: &Vec<ast.Parameter, _>,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    mut var idx: int = 0

    while idx < params.len() {
        var p: ast.Parameter = (*params)[idx]
        var regOpt: Option<int> = arg_register(idx)

        switch regOpt {
            case None {
                return Err("native: too many parameters (max 6)")
            }
            case Some(reg) {
                var param_name: string = p.Name.Value
                var is_discard: bool = is_discard_name(param_name)

                if !is_discard {
                    var off: int = declare_local(
                        state,
                        copyString(&param_name),
                    )
                    var tnameOpt: Option<string> = type_name_from_type_expr(&p.Type)

                    switch tnameOpt {
                        case Some(tname) {
                            add_local_type(
                                state,
                                copyString(&param_name),
                                tname,
                            )
                        }
                        case None {
                        }
                    }

                    x86.emit_mov_mem_rbp_reg(
                        code,
                        off,
                        reg,
                    )

                    var infoOpt: Option<IterableInfo> = iterable_info_from_type(
                        &p.Type,
                        state,
                    )

                    update_iterable_binding(
                        state,
                        copyString(&param_name),
                        infoOpt,
                    )

                    var structOpt: Option<string> = struct_name_from_type(
                        &p.Type,
                        state,
                    )

                    update_struct_binding(
                        state,
                        param_name,
                        structOpt,
                    )

                    // Track reference parameters for dereference in method calls
                    switch p.Type {
                        case ast.TypeExpression.BorrowRef(_) {
                            state.ref_param_names.push(copyString(&p.Name.Value))
                            state.ref_param_hashes.push(local_name_hash(&p.Name.Value))
                            state.ref_param_name_lens.push(p.Name.Value.len())
                        }
                        default {
                        }
                    }
                }
            }
        }

        // Avoid constructing synthetic enum payload expressions during
        // parameter binding in bootstrap mode; it can trigger excessive
        // compiler memory growth while self-hosting.
        idx = idx + 1
    }

    return Ok(void)
}

func count_locals(body: &ast.BlockStatement) -> (Result<int, string>) {
    mut var count: int = 0
    var res: Result<void, string> = count_locals_block(
        body,
        &mut count,
    )

    switch res {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    return Ok(count)
}

func count_locals_block(
    body: &ast.BlockStatement,
    count: &mut int,
) -> (Result<void, string>) {
    mut var i: int = 0

    while i < body.Statements.len() {
        var res: Result<void, string> = count_locals_stmt(
            &body.Statements[i],
            count,
        )

        switch res {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        i = i + 1
    }

    return Ok(void)
}

func add_function_symbol(
    functions: &mut Vec<FunctionSymbol, _>,
    fd: &ast.FunctionDecl,
    pkgName: string,
) -> (Result<void, string>) {
    mut var name: string = copyString(&fd.Name.Value)
    mut var ret_type_name: string = ""

    switch type_name_from_type_expr(&fd.ReturnType) {
        case Some(tname) {
            ret_type_name = tname
        }
        case None {
        }
    }

    if pkgName != "main" && pkgName != "" {
        name = pkgName + "." + name
    }

    mut var i: int = 0

    while i < (*functions).len() {
        if str_eq(
            &((*functions)[i]).name,
            &name,
        ) {
            // If it's already there, just return Ok. This allows for intrinsics or duplicate collection.
            return Ok(void)
        }

        i = i + 1
    }

    (*functions).push(
        FunctionSymbol{
            name:              name,
            offset:            -1,
            param_borrow_mask: param_borrow_mask_from_decl(fd),
            param_count:       fd.Parameters.len(),
            return_type:       ret_type_name,
        },
    )

    return Ok(void)
}

func find_function_index(
    functions: &Vec<FunctionSymbol, _>,
    name: string,
) -> (Option<int>) {
    mut var i: int = 0

    while i < (*functions).len() {
        if str_eq(
            &((*functions)[i]).name,
            &name,
        ) {
            return Some(i)
        }

        i = i + 1
    }

    return None
}

func update_function_offset(
    functions: &mut Vec<FunctionSymbol, _>,
    name: &string,
    offset: int,
) -> (Result<void, string>) {
    mut var i: int = 0
    mut var found: bool = false

    while i < (*functions).len() {
        if str_eq(
            &((*functions)[i]).name,
            name,
        ) {
            ((*functions)[i]).offset = offset
            found = true
        }

        // Don't return yet, there might be multiple (bridge vs actual)
        i = i + 1
    }

    if found {
        return Ok(void)
    }

    return Err("native: function not found " + *name)
}

func function_param_count(
    functions: &Vec<FunctionSymbol, _>,
    name: &string,
) -> (Option<int>) {
    mut var i: int = 0

    while i < (*functions).len() {
        if str_eq(
            &((*functions)[i]).name,
            name,
        ) {
            return Some(((*functions)[i]).param_count)
        }

        i = i + 1
    }

    var lenName: string = "len"

    if str_eq(
        name,
        &lenName,
    ) {
        return None
    }

    // Built-in len() is not in functions
    // Try qualified if name is unqualified
    i = 0

    while i < (*functions).len() {
        if bootstrap_target_matches(
            &((*functions)[i]).name,
            name,
        ) {
            return Some(((*functions)[i]).param_count)
        }

        i = i + 1
    }

    return None
}

func function_param_borrow_mask(
    functions: &Vec<FunctionSymbol, _>,
    name: &string,
) -> (Option<int>) {
    mut var i: int = 0

    while i < (*functions).len() {
        if str_eq(
            &((*functions)[i]).name,
            name,
        ) {
            return Some(((*functions)[i]).param_borrow_mask)
        }

        i = i + 1
    }

    i = 0

    while i < (*functions).len() {
        if bootstrap_target_matches(
            &((*functions)[i]).name,
            name,
        ) {
            return Some(((*functions)[i]).param_borrow_mask)
        }

        i = i + 1
    }

    return None
}

func looks_like_enum_variant_name(name: &string) -> (bool) {
    if name.len() == 0 {
        return false
    }

    var ch0: int = int((*name)[0])

    return ch0 >= 65 && ch0 <= 90
}

func function_offset(
    functions: &Vec<FunctionSymbol, _>,
    name: &string,
) -> (Option<int>) {
    mut var i: int = 0

    while i < (*functions).len() {
        if str_eq(
            &((*functions)[i]).name,
            name,
        ) {
            if ((*functions)[i]).offset >= 0 {
                return Some(((*functions)[i]).offset)
            }
        }

        i = i + 1
    }

    // Try qualified if name is unqualified
    i = 0
    mut var match_count: int = 0
    mut var matched_off: int = -1

    while i < (*functions).len() {
        if bootstrap_target_matches(
            &((*functions)[i]).name,
            name,
        ) {
            if ((*functions)[i]).offset >= 0 {
                match_count = match_count + 1
                matched_off = ((*functions)[i]).offset
            }
        }

        i = i + 1
    }

    if match_count == 1 {
        return Some(matched_off)
    }

    return None
}

func bootstrap_target_matches(full: &string, target: &string) -> (bool) {
    if str_eq(
        full,
        target,
    ) {
        return true
    }

    if full.len() <= target.len() {
        return false
    }

    var dot_i: int = full.len() - target.len() - 1

    if dot_i < 0 {
        return false
    }

    if (*full)[dot_i] != '.' {
        return false
    }

    mut var i: int = 0

    while i < target.len() {
        if (*full)[dot_i + 1 + i] != (*target)[i] {
            return false
        }

        i = i + 1
    }

    return true
}

func bootstrap_target_tail(target: &string) -> (string) {
    mut var last_dot: int = -1
    mut var i: int = 0

    while i < target.len() {
        if (*target)[i] == '.' {
            last_dot = i
        }

        i = i + 1
    }

    if last_dot < 0 || last_dot + 1 >= target.len() {
        return *target
    }

    return target.substring(
        last_dot + 1,
        target.len(),
    )
}

func bootstrap_lookup_offset(
    functions: &Vec<FunctionSymbol, _>,
    target: &string,
) -> (int) {
    mut var unresolved: int = -2
    mut var match_count: int = 0
    mut var matched_off: int = -2
    mut var i: int = 0

    while i < (*functions).len() {
        if bootstrap_target_matches(
            &((*functions)[i]).name,
            target,
        ) {
            if ((*functions)[i]).offset >= 0 {
                match_count = match_count + 1
                matched_off = ((*functions)[i]).offset
            }

            if unresolved == -2 {
                unresolved = ((*functions)[i]).offset
            }
        }

        i = i + 1
    }

    if match_count == 1 {
        return matched_off
    }

    return unresolved
}

pub struct BootstrapTargetOffset {
    target: string
    offset: int
}

func contains_string_ref(items: &Vec<string, _>, value: &string) -> (bool) {
    mut var i: int = 0

    while i < items.len() {
        if str_eq(
            &items[i],
            value,
        ) {
            return true
        }

        i = i + 1
    }

    return false
}

func bootstrap_offset_from_cache(
    cached: &Vec<BootstrapTargetOffset, _>,
    target: &string,
) -> (int) {
    mut var i: int = 0

    while i < cached.len() {
        if str_eq(
            &(cached[i]).target,
            target,
        ) {
            return (cached[i]).offset
        }

        i = i + 1
    }

    return -2
}

func first_call_imm_offset(code: &Vec<int, _>) -> (Option<int>) {
    mut var i: int = 0

    while i + 4 < code.len() {
        if code[i] == 0xE8 || code[i] == -24 {
            return Some(i + 1)
        }

        i = i + 1
    }

    return None
}

func compact_resolved_call_patches(
    mut state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (void) {
    if state.call_patches.len() == 0 {
        return
    }

    mut var write_i: int = 0
    mut var pi: int = 0

    while pi < state.call_patches.len() {
        var p: CallPatch = state.call_patches[pi]
        mut var patched: bool = false

        if p.target_id >= 0 && p.target_id < state.call_target_pool.len() {
            var target: &string = &state.call_target_pool[p.target_id]
            var offOpt: Option<int> = function_offset(
                &state.functions,
                target,
            )

            switch offOpt {
                case Some(off) {
                    if off >= 0 && p.imm_offset >= 0 && p.imm_offset + 4 <= code.len() {
                        patch_rel32(
                            code,
                            p.imm_offset,
                            off,
                        )
                        patched = true
                    }
                }
                case None {
                }
            }
        }

        if !patched {
            if write_i != pi {
                state.call_patches[write_i] = p
            }

            write_i = write_i + 1
        }

        pi = pi + 1
    }

    while state.call_patches.len() > write_i {
        var last_patch_i: int = state.call_patches.len() - 1

        state.call_patches[last_patch_i] = CallPatch{
            imm_offset: 0,
            target_id:  -1,
        }

        switch state.call_patches.pop() {
            case Some(_) {
            }
            case None {
                break
            }
        }
    }

    if state.call_patches.len() == 0 {
        mut var empty_target_pool: Vec<string, _> = Vec.with_cap(0)

        state.call_target_pool = empty_target_pool
    }

    return
}

func patch_calls_bootstrap(
    functions: &Vec<FunctionSymbol, _>,
    patches: &Vec<CallPatch, _>,
    target_pool: &Vec<string, _>,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var panic_name: string = "__rt_panic"
    mut var panic_off: int = -1
    var panicOffOpt: Option<int> = function_offset(
        functions,
        &panic_name,
    )

    switch panicOffOpt {
        case Some(po) {
            panic_off = po
        }
        case None {
            panic_off = bootstrap_lookup_offset(
                functions,
                &panic_name,
            )
        }
    }

    mut var pi: int = 0
    mut var miss_printed: int = 0

    while pi < (*patches).len() {
        var p: &CallPatch = &(*patches)[pi]

        if (*p).target_id < 0 || (*p).target_id >= target_pool.len() {
            return Err("cpb:tid2")
        }

        var target: &string = &(*target_pool)[(*p).target_id]
        mut var effective_off: int = -1
        var offOpt: Option<int> = function_offset(
            functions,
            target,
        )

        switch offOpt {
            case Some(value) {
                effective_off = value
            }
            case None {
            }
        }

        if effective_off < 0 {
            effective_off = bootstrap_lookup_offset(
                functions,
                target,
            )
        }

        if effective_off < 0 {
            var tail: string = bootstrap_target_tail(target)

            if tail != *target {
                effective_off = bootstrap_lookup_offset(
                    functions,
                    &tail,
                )
            }
        }

        if effective_off < 0 {
            if panic_off >= 0 {
                if miss_printed < 64 {
                    miss_printed = miss_printed + 1
                }
                effective_off = panic_off
            } else {
                return Err("native: unknown function " + *target)
            }
        }

        if (*p).imm_offset < 0 || (*p).imm_offset + 4 > code.len() {
            return Err("cpb")
        }

        patch_rel32(
            code,
            (*p).imm_offset,
            effective_off,
        )
        pi = pi + 1
    }

    return Ok(void)
}

func patch_calls(
    functions: &Vec<FunctionSymbol, _>,
    patches: &Vec<CallPatch, _>,
    target_pool: &Vec<string, _>,
    mut code: &mut Vec<int, _>,
    bootstrap_mode: bool,
) -> (Result<void, string>) {
    var _bootstrap_mode: bool = bootstrap_mode

    var panic_name: string = "__rt_panic"
    mut var panic_off: int = -1

    switch function_offset(
        functions,
        &panic_name,
    ) {
        case Some(po) {
            panic_off = po
        }
        case None {
        }
    }

    mut var pi: int = 0

    while pi < (*patches).len() {
        var p: &CallPatch = &(*patches)[pi]

        if (*p).target_id < 0 || (*p).target_id >= target_pool.len() {
            return Err("cp:tid")
        }

        var target: &string = &(*target_pool)[(*p).target_id]
        mut var offOpt: Option<int> = function_offset(
            functions,
            target,
        )
        var main_name: string = "main"

        if str_eq(
            target,
            &main_name,
        ) {
            offOpt = None

            mut var mi: int = 0

            while mi < (*functions).len() {
                var fname: &string = &((*functions)[mi]).name

                if str_eq(
                    fname,
                    &main_name,
                ) || (*fname).endsWith(".main") {
                    if ((*functions)[mi]).offset >= 0 {
                        offOpt = Some(((*functions)[mi]).offset)
                        mi = (*functions).len()
                    }
                }

                if mi < (*functions).len() {
                    mi = mi + 1
                }
            }
        }

        if offOpt.is_none() {
            // Try without qualification if it's a call to a local function that was qualified during collection
            // wait, p.target is what was used in the call site.
            // If the call site used "printUsage", and it was collected as "driver.printUsage"
            mut var i: int = 0

            while i < (*functions).len() {
                if bootstrap_target_matches(
                    &((*functions)[i]).name,
                    target,
                ) {
                    offOpt = Some(((*functions)[i]).offset)
                    break
                }

                i = i + 1
            }
        }

        if offOpt.is_none() {
            var tail_target: string = bootstrap_target_tail(target)

            if tail_target != *target {
                mut var ti2: int = 0

                while ti2 < (*functions).len() {
                    if bootstrap_target_matches(
                        &((*functions)[ti2]).name,
                        &tail_target,
                    ) {
                        offOpt = Some(((*functions)[ti2]).offset)
                        break
                    }

                    ti2 = ti2 + 1
                }
            }
        }

        switch offOpt {
            case None {
                if panic_off >= 0 && is_skipped_call_target(
                    target,
                    functions,
                    bootstrap_mode,
                ) {
                    if (*p).imm_offset < 0 || (*p).imm_offset + 4 > code.len() {
                        return Err("cpor1:" + *target)
                    }

                    patch_rel32(
                        code,
                        (*p).imm_offset,
                        panic_off,
                    )
                    pi = pi + 1
                    continue
                }

                return Err("nf:" + *target)
            }
            case Some(target_off) {
                mut var effective_off: int = target_off

                if effective_off < 0 {
                    if panic_off >= 0 && is_skipped_call_target(
                        target,
                        functions,
                        bootstrap_mode,
                    ) {
                        effective_off = panic_off
                    } else {
                        return Err("nfu1:" + *target)
                    }
                }

                if effective_off < 0 {
                    return Err("nfu2:" + *target)
                }

                if (*p).imm_offset < 0 || (*p).imm_offset + 4 > code.len() {
                    return Err("cpor2:" + *target)
                }

                patch_rel32(
                    code,
                    (*p).imm_offset,
                    effective_off,
                )
            }
        }

        pi = pi + 1
    }

    return Ok(void)
}

func count_locals_stmt(
    stmt: &ast.Statement,
    count: &mut int,
) -> (Result<void, string>) {
    switch *stmt {
        case ast.Statement.Var(vs) {
            if !is_discard_name(vs.Name.Value) {
                *count = *count + 1
            }

            return Ok(void)
        }
        case ast.Statement.Const(cs) {
            if !is_discard_name(cs.Name.Value) {
                *count = *count + 1
            }

            return Ok(void)
        }
        case ast.Statement.MultiVar(mvs) {
            mut var i: int = 0

            while i < mvs.Names.len() {
                if !is_discard_name((mvs.Names[i]).Value) {
                    *count = *count + 1
                }

                i = i + 1
            }

            return Ok(void)
        }
        case ast.Statement.VarBlock(vb) {
            mut var i: int = 0

            while i < vb.Variables.len() {
                if !is_discard_name((vb.Variables[i]).Name.Value) {
                    *count = *count + 1
                }

                i = i + 1
            }

            return Ok(void)
        }
        case ast.Statement.ConstBlock(cb) {
            mut var i: int = 0

            while i < cb.Constants.len() {
                if !is_discard_name((cb.Constants[i]).Name.Value) {
                    *count = *count + 1
                }

                i = i + 1
            }

            return Ok(void)
        }
        case ast.Statement.Block(bs) {
            return count_locals_block(
                &bs,
                count,
            )
        }
        case ast.Statement.If(is) {
            var consRes: Result<void, string> = count_locals_block(
                &is.Consequence,
                count,
            )

            switch consRes {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            switch is.Alternative {
                case Some(alt) {
                    return count_locals_block(
                        &alt,
                        count,
                    )
                }
                case None {
                    return Ok(void)
                }
            }
        }
        case ast.Statement.While(ws) {
            return count_locals_block(
                &ws.Body,
                count,
            )
        }
        case ast.Statement.For(fs) {
            if !is_discard_name(fs.Variable.Value) {
                *count = *count + 1
            }

            return count_locals_block(
                &fs.Body,
                count,
            )
        }
        case ast.Statement.Switch(ss) {
            mut var i: int = 0

            while i < ss.Cases.len() {
                var caseRes: Result<void, string> = count_locals_block(
                    &(ss.Cases[i]).Body,
                    count,
                )

                switch caseRes {
                    case Err(msg) {
                        return Err(msg)
                    }
                    case Ok(_) {
                    }
                }

                i = i + 1
            }

            return Ok(void)
        }
        case ast.Statement.Defer(ds) {
            return count_locals_block(
                &ds.Body,
                count,
            )
        }
        case ast.Statement.Unsafe(us) {
            return count_locals_block(
                &us.Body,
                count,
            )
        }
        default {
            return Ok(void)
        }
    }
}

func count_pattern_bindings(expr: &ast.Expression) -> (int) {
    switch *expr {
        case ast.Expression.EnumVariant(ev) {
            return ev.Values.len()
        }
        case ast.Expression.Call(ce) {
            return ce.Arguments.len()
        }
        default {
        }
    }

    return 0
}

func emit_block(
    body: &ast.BlockStatement,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    enter_scope(state)

    var res: Result<void, string> = emit_block_in_scope(
        body,
        state,
        code,
    )

    leave_scope(state)

    return res
}

func emit_block_in_scope(
    body: &ast.BlockStatement,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {

    var n: int = body.Statements.len()


    if n <= 0 {
        return Ok(void)
    }

    mut var i: int = 0

    while i < n {
        if TRACE_MAIN_STOP_SEQ > 0 && is_trace_main_context(state) {
            state.main_stmt_seq = state.main_stmt_seq + 1

            if state.main_stmt_seq == TRACE_MAIN_STOP_SEQ {
                var stmt_for_trace: &ast.Statement = &body.Statements[i]
                var trace_kind: int = stmt_case_id(stmt_for_trace)

                return Err(
                    "trace-main-stop seq=" + state.main_stmt_seq.toString() + " kind=" + trace_kind.toString(),
                )
            }
        }

        var stmt: &ast.Statement = &body.Statements[i]

        var res: Result<void, string> = emit_stmt(
            stmt,
            state,
            code,
        )

        switch res {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        i = i + 1
    }

    return Ok(void)
}

func is_trace_main_context(state: &BackendEmitState) -> (bool) {
    return !state.bootstrap_mode && state.current_pkg == "main" && state.current_function == "main"
}

func stmt_case_id(stmt: &ast.Statement) -> (int) {
    switch *stmt {
        case ast.Statement.Var(_) {
            return 1
        }
        case ast.Statement.Assignment(_) {
            return 2
        }
        case ast.Statement.Const(_) {
            return 3
        }
        case ast.Statement.MultiVar(_) {
            return 4
        }
        case ast.Statement.VarBlock(_) {
            return 5
        }
        case ast.Statement.ConstBlock(_) {
            return 6
        }
        case ast.Statement.If(_) {
            return 7
        }
        case ast.Statement.While(_) {
            return 8
        }
        case ast.Statement.For(_) {
            return 9
        }
        case ast.Statement.Break(_) {
            return 10
        }
        case ast.Statement.Continue(_) {
            return 11
        }
        case ast.Statement.Block(_) {
            return 12
        }
        case ast.Statement.Switch(_) {
            return 13
        }
        case ast.Statement.Return(_) {
            return 14
        }
        case ast.Statement.Expression(_) {
            return 15
        }
        case ast.Statement.Panic(_) {
            return 16
        }
        case ast.Statement.Unsafe(_) {
            return 17
        }
        case ast.Statement.Defer(_) {
            return 18
        }
        default {
        }
    }

    return 0
}

func emit_stmt_var(
    vs: ast.VarStatement,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var var_name: string = vs.Name.Value
    mut var off: int = -1
    var is_discard: bool = is_discard_name(var_name)
    mut var declared_float: bool = false
    mut var is_borrow_local: bool = false

    switch vs.Type {
        case Some(texpr_for_declared) {
            switch type_name_from_type_expr(&texpr_for_declared) {
                case Some(tname_for_declared) {
                    declared_float = is_float_type_name(&tname_for_declared)
                }
                case None {
                }
            }
        }
        case None {
        }
    }

    if is_discard {
        switch vs.Value {
            case Some(discardExpr) {
                var discardRes: Result<void, string> = emit_expr(
                    &discardExpr,
                    state,
                    code,
                )

                switch discardRes {
                    case Err(msg) {
                        return Err(msg)
                    }
                    case Ok(_) {
                    }
                }

                if declared_float && !is_float_expr(
                    &discardExpr,
                    state,
                ) {
                    emit_scale_reg_for_float(
                        code,
                        x86.RAX,
                    )
                }
            }
            case None {
            }
        }

        return Ok(void)
    }

    if !is_discard {
        off = declare_local(
            state,
            copyString(&var_name),
        )

        switch vs.Type {
            case Some(t) {
                switch t {
                    case ast.TypeExpression.BorrowRef(_) {
                        is_borrow_local = true
                    }
                    default {
                    }
                }

                var tnameOpt: Option<string> = type_name_from_type_expr(&t)

                switch tnameOpt {
                    case Some(tname) {
                        add_local_type(
                            state,
                            copyString(&var_name),
                            tname,
                        )
                    }
                    case None {
                    }
                }
            }
            case None {
            }
        }
    }

    switch vs.Value {
        case Some(expr) {
            var res: Result<void, string> = emit_expr(
                &expr,
                state,
                code,
            )

            switch res {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            if declared_float && !is_float_expr(
                &expr,
                state,
            ) {
                emit_scale_reg_for_float(
                    code,
                    x86.RAX,
                )
            }

            // Track iterable literal bindings for loop iteration.
            if !is_discard {
                mut var infoOpt: Option<IterableInfo> = iterable_elem_info(
                    &expr,
                    &vs.Type,
                    state,
                )

                switch infoOpt {
                    case None {
                        infoOpt = type_iterable_info(
                            &vs.Type,
                            state,
                        )
                    }
                    case Some(_) {
                    }
                }

                switch infoOpt {
                    case Some(info) {
                    }
                    case None {
                    }
                }

                update_iterable_binding(
                    state,
                    copyString(&var_name),
                    infoOpt,
                )

                mut var structOpt: Option<string> = struct_literal_name(
                    &expr,
                    state,
                )

                switch structOpt {
                    case None {
                        structOpt = struct_name_from_type_opt(
                            &vs.Type,
                            state,
                        )
                    }
                    case Some(_) {
                    }
                }

                update_struct_binding(
                    state,
                    var_name,
                    structOpt,
                )
                // Track enum bindings from type annotation or expression
                track_enum_binding_from_var(
                    state,
                    var_name,
                    &vs.Type,
                    &expr,
                )

                if !is_borrow_local {
                    switch expr {
                        case ast.Expression.Borrow(_) {
                            is_borrow_local = true
                        }
                        default {
                        }
                    }
                }
            }
        }
        case None {
            x86.emit_mov_rax_imm32(
                code,
                0,
            )

            if !is_discard {
                var infoOpt2: Option<IterableInfo> = type_iterable_info(
                    &vs.Type,
                    state,
                )

                update_iterable_binding(
                    state,
                    var_name,
                    infoOpt2,
                )

                var structOpt2: Option<string> = struct_name_from_type_opt(
                    &vs.Type,
                    state,
                )

                update_struct_binding(
                    state,
                    var_name,
                    structOpt2,
                )
            }
        }
    }

    if is_borrow_local {
        state.ref_param_names.push(copyString(&var_name))
        state.ref_param_hashes.push(local_name_hash(&var_name))
        state.ref_param_name_lens.push(var_name.len())
    }

    x86.emit_mov_mem_rbp_reg(
        code,
        off,
        x86.RAX,
    )

    return Ok(void)
}

func emit_stmt_assignment(
    assign: &ast.AssignmentStatement,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    if TRACE_ASSIGN_STOP_PHASE == 1 && is_trace_main_context(state) {
        return Err("trace-assign-stop")
    }

    if TRACE_ASSIGN_STOP_PHASE == 2 && is_trace_main_context(state) {
        return Err("trace-assign-stop")
    }

    if TRACE_ASSIGN_STOP_PHASE == 8 && is_trace_main_context(state) {
        return Err("trace-assign-stop")
    }

    if TRACE_ASSIGN_STOP_PHASE == 23 && is_trace_main_context(state) {
        if assign.TargetName != "" {
            return Err("trace-target-hit")
        }

        return Err("trace-target-miss")
    }

    if assign.TargetName != "" {
        return emit_stmt_assignment_local_named(
            assign.TargetName,
            assign,
            state,
            code,
        )
    }

    switch assign.Left {
        case ast.Expression.FieldAccess(_) {
            if TRACE_ASSIGN_STOP_PHASE == 5 && is_trace_main_context(state) {
                return Err("trace-assign-stop")
            }

            return emit_stmt_assignment_field_impl(
                assign,
                state,
                code,
            )
        }
        case ast.Expression.Deref(_) {
            if TRACE_ASSIGN_STOP_PHASE == 6 && is_trace_main_context(state) {
                return Err("trace-assign-stop")
            }

            return emit_stmt_assignment_deref_impl(
                assign,
                state,
                code,
            )
        }
        case ast.Expression.Index(_) {
            if TRACE_ASSIGN_STOP_PHASE == 7 && is_trace_main_context(state) {
                return Err("trace-assign-stop")
            }

            return emit_stmt_assignment_index_impl(
                assign,
                state,
                code,
            )
        }
        case ast.Expression.Identifier(id2) {
            if TRACE_ASSIGN_STOP_PHASE == 3 && is_trace_main_context(state) {
                return Err("trace-assign-stop")
            }

            return emit_stmt_assignment_local_named(
                id2.Value,
                assign,
                state,
                code,
            )
        }
        case ast.Expression.MutableIdentifier(idm2) {
            if TRACE_ASSIGN_STOP_PHASE == 4 && is_trace_main_context(state) {
                return Err("trace-assign-stop")
            }

            return emit_stmt_assignment_local_named(
                idm2.Value,
                assign,
                state,
                code,
            )
        }
        default {
            return Err(ERR_NATIVE_UNSUPPORTED)
        }
    }
}

func is_assignment_field(assign: &ast.AssignmentStatement) -> (bool) {
    switch assign.Left {
        case ast.Expression.FieldAccess(_) {
            return true
        }
        default {
        }
    }

    return false
}

func is_assignment_deref(assign: &ast.AssignmentStatement) -> (bool) {
    switch assign.Left {
        case ast.Expression.Deref(_) {
            return true
        }
        default {
        }
    }

    return false
}

func is_assignment_index(assign: &ast.AssignmentStatement) -> (bool) {
    switch assign.Left {
        case ast.Expression.Index(_) {
            return true
        }
        default {
        }
    }

    return false
}

func emit_stmt_assignment_field_impl(
    assign: &ast.AssignmentStatement,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var res_val: Result<void, string> = emit_expr(
        &assign.Value,
        state,
        code,
    )

    switch res_val {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_push_reg(
        code,
        x86.RAX,
    )

    var res_addr: Result<void, string> = emit_address_of(
        &assign.Left,
        state,
        code,
    )

    switch res_addr {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_pop_reg(
        code,
        x86.RCX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.RCX,
    )

    return Ok(void)
}

func emit_stmt_assignment_deref_impl(
    assign: &ast.AssignmentStatement,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    switch assign.Left {
        case ast.Expression.Deref(de) {
            var res_ptr: Result<void, string> = emit_expr(
                &de.Value,
                state,
                code,
            )

            switch res_ptr {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            x86.emit_push_reg(
                code,
                x86.RAX,
            )

            var res_val: Result<void, string> = emit_expr(
                &assign.Value,
                state,
                code,
            )

            switch res_val {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            x86.emit_pop_reg(
                code,
                x86.RCX,
            )
            x86.emit_mov_mem_base_disp_reg(
                code,
                x86.RCX,
                0,
                x86.RAX,
            )

            return Ok(void)
        }
        default {
            return Err(ERR_NATIVE_UNSUPPORTED)
        }
    }
}

func emit_stmt_assignment_index_impl(
    assign: &ast.AssignmentStatement,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    switch assign.Left {
        case ast.Expression.Index(ix) {
            var res_val_idx: Result<void, string> = emit_expr(
                &assign.Value,
                state,
                code,
            )

            switch res_val_idx {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            x86.emit_push_reg(
                code,
                x86.RAX,
            )

            var res_left_idx: Result<void, string> = emit_expr(
                &ix.Left,
                state,
                code,
            )

            switch res_left_idx {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            if is_ref_expr(
                &ix.Left,
                state,
            ) {
                emit_safe_ref_deref_rax(code)
            }

            x86.emit_push_reg(
                code,
                x86.RAX,
            )

            var res_index_idx: Result<void, string> = emit_expr(
                &ix.Index,
                state,
                code,
            )

            switch res_index_idx {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            x86.emit_mov_reg_reg(
                code,
                x86.R8,
                x86.RAX,
            )
            x86.emit_pop_reg(
                code,
                x86.RCX,
            )
            x86.emit_mov_reg_mem_base_disp(
                code,
                x86.RDX,
                x86.RCX,
                0,
            )
            x86.emit_pop_reg(
                code,
                x86.R11,
            )
            x86.emit_mov_mem_base_index_reg(
                code,
                x86.RDX,
                x86.R8,
                8,
                x86.R11,
            )

            return Ok(void)
        }
        default {
            return Err(ERR_NATIVE_UNSUPPORTED)
        }
    }
}

func emit_stmt_assignment_local(
    assign: &ast.AssignmentStatement,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    switch assign.Left {
        case ast.Expression.Identifier(id) {
            return emit_stmt_assignment_local_named(
                id.Value,
                assign,
                state,
                code,
            )
        }
        case ast.Expression.MutableIdentifier(id) {
            return emit_stmt_assignment_local_named(
                id.Value,
                assign,
                state,
                code,
            )
        }
        default {
            return Err(ERR_NATIVE_UNSUPPORTED)
        }
    }
}

func emit_identifier_name(
    name: &string,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    if *name == "_" {
        x86.emit_mov_rax_imm32(
            code,
            0,
        )

        return Ok(void)
    }

    var offOpt: Option<int> = resolve_local(
        state,
        name,
    )

    switch offOpt {
        case Some(off) {
            x86.emit_mov_reg_mem_rbp(
                code,
                x86.RAX,
                off,
            )

            return Ok(void)
        }
        case None {
            if *name == "ast" {
                x86.emit_mov_rax_imm32(
                    code,
                    0,
                )

                return Ok(void)
            }

            var constRes: Result<void, string> = emit_const_value(
                state,
                code,
                name,
            )

            switch constRes {
                case Ok(_) {
                    return Ok(void)
                }
                case Err(_) {
                    var enumRes: Result<void, string> = emit_fieldless_variant(
                        name,
                        state,
                        code,
                    )

                    switch enumRes {
                        case Ok(_) {
                            return Ok(void)
                        }
                        case Err(_) {
                            return Err("native: unknown local " + *name + " (pkg=" + state.current_pkg + ")")
                        }
                    }
                }
            }
        }
    }
}

func emit_borrow_identifier_name(
    name: &string,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var localOpt: Option<int> = resolve_local(
        state,
        name,
    )

    switch localOpt {
        case Some(offset) {
            x86.emit_lea_reg_mem_rbp(
                code,
                x86.RAX,
                offset,
            )

            return Ok(void)
        }
        case None {
            return emit_identifier_name(
                name,
                state,
                code,
            )
        }
    }
}

func emit_assignment_value_hint(
    assign: &ast.AssignmentStatement,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<int, string>) {
    switch assign.ValueKind {
        case ASSIGN_VALUE_HINT_NONE {
            return Ok(0)
        }
        case ASSIGN_VALUE_HINT_INT {
            var res: Result<void, string> = emit_int_literal(
                assign.ValueInt,
                code,
            )

            switch res {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                    return Ok(1)
                }
            }
        }
        case ASSIGN_VALUE_HINT_FLOAT {
            var scaled: int = int(assign.ValueFloat * 1000000.0)

            x86.emit_mov_reg_imm64(
                code,
                x86.RAX,
                scaled,
            )

            return Ok(1)
        }
        case ASSIGN_VALUE_HINT_STRING {
            var res2: Result<void, string> = emit_string_literal(
                &assign.ValueText,
                state,
                code,
            )

            switch res2 {
                case Err(msg2) {
                    return Err(msg2)
                }
                case Ok(_) {
                    return Ok(1)
                }
            }
        }
        case ASSIGN_VALUE_HINT_BOOL {
            if assign.ValueBool {
                x86.emit_mov_rax_imm32(
                    code,
                    1,
                )
            } else {
                x86.emit_mov_rax_imm32(
                    code,
                    0,
                )
            }

            return Ok(1)
        }
        case ASSIGN_VALUE_HINT_CHAR {
            var res3: Result<void, string> = emit_char_literal(
                assign.ValueChar,
                code,
            )

            switch res3 {
                case Err(msg3) {
                    return Err(msg3)
                }
                case Ok(_) {
                    return Ok(1)
                }
            }
        }
        case ASSIGN_VALUE_HINT_IDENT {
            var res4: Result<void, string> = emit_identifier_name(
                &assign.ValueText,
                state,
                code,
            )

            switch res4 {
                case Err(msg4) {
                    return Err(msg4)
                }
                case Ok(_) {
                    return Ok(1)
                }
            }
        }
        case ASSIGN_VALUE_HINT_BORROW_IDENT {
            var res5: Result<void, string> = emit_borrow_identifier_name(
                &assign.ValueText,
                state,
                code,
            )

            switch res5 {
                case Err(msg5) {
                    return Err(msg5)
                }
                case Ok(_) {
                    return Ok(1)
                }
            }
        }
        case ASSIGN_VALUE_HINT_VOID {
            x86.emit_mov_rax_imm32(
                code,
                0,
            )

            return Ok(1)
        }
        default {
            return Ok(0)
        }
    }
}

func assignment_value_hint_is_float(assign: &ast.AssignmentStatement) -> (bool) {
    return assign.ValueKind == ASSIGN_VALUE_HINT_FLOAT
}

func assignment_value_hint_iterable_info(
    assign: &ast.AssignmentStatement,
    state: &mut BackendEmitState,
) -> (Option<IterableInfo>) {
    if assign.ValueKind == ASSIGN_VALUE_HINT_IDENT || assign.ValueKind == ASSIGN_VALUE_HINT_BORROW_IDENT {
        return iterable_info_from_binding(
            state,
            &assign.ValueText,
        )
    }

    return None
}

func assignment_value_hint_struct_name(
    assign: &ast.AssignmentStatement,
    state: &mut BackendEmitState,
) -> (Option<string>) {
    if assign.ValueKind == ASSIGN_VALUE_HINT_IDENT || assign.ValueKind == ASSIGN_VALUE_HINT_BORROW_IDENT {
        var structOpt: Option<string> = resolve_struct_binding(
            state,
            &assign.ValueText,
        )

        switch structOpt {
            case Some(_) {
                return structOpt
            }
            case None {
                return resolve_local_type(
                    state,
                    &assign.ValueText,
                )
            }
        }
    }

    return None
}

func emit_stmt_assignment_local_named(
    name: string,
    assign: &ast.AssignmentStatement,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    if TRACE_ASSIGN_STOP_PHASE == 19 && is_trace_main_context(state) {
        return Err("trace-assign-entry")
    }

    if TRACE_ASSIGN_STOP_PHASE == 22 && is_trace_main_context(state) {
        if assign.ValueKind == ASSIGN_VALUE_HINT_NONE {
            return Err("trace-hint-none")
        }

        if assign.ValueKind == ASSIGN_VALUE_HINT_INT {
            return Err("trace-hint-int")
        }

        if assign.ValueKind == ASSIGN_VALUE_HINT_FLOAT {
            return Err("trace-hint-float")
        }

        if assign.ValueKind == ASSIGN_VALUE_HINT_STRING {
            return Err("trace-hint-string")
        }

        if assign.ValueKind == ASSIGN_VALUE_HINT_BOOL {
            return Err("trace-hint-bool")
        }

        if assign.ValueKind == ASSIGN_VALUE_HINT_CHAR {
            return Err("trace-hint-char")
        }

        if assign.ValueKind == ASSIGN_VALUE_HINT_IDENT {
            return Err("trace-hint-ident")
        }

        if assign.ValueKind == ASSIGN_VALUE_HINT_BORROW_IDENT {
            return Err("trace-hint-borrow-ident")
        }

        if assign.ValueKind == ASSIGN_VALUE_HINT_VOID {
            return Err("trace-hint-void")
        }

        return Err("trace-hint-unknown")
    }

    if TRACE_ASSIGN_STOP_PHASE == 10 && is_trace_main_context(state) {
        return Err("trace-assign-stop")
    }

    if name == "_" {
        return emit_expr(
            &assign.Value,
            state,
            code,
        )
    }

    if TRACE_ASSIGN_STOP_PHASE == 11 && is_trace_main_context(state) {
        return Err("trace-assign-stop")
    }

    var rhsPtr: &ast.Expression = &assign.Value
    var hintHandled: bool = false
    var hintRes: Result<int, string> = emit_assignment_value_hint(
        assign,
        state,
        code,
    )

    switch hintRes {
        case Err(msg_hint) {
            return Err(msg_hint)
        }
        case Ok(hint_status) {
            hintHandled = hint_status == 1
        }
    }

    if TRACE_ASSIGN_STOP_PHASE == 20 && is_trace_main_context(state) {
        if hintHandled {
            return Err("trace-assign-hint-hit")
        }

        return Err("trace-assign-hint-miss")
    }

    if TRACE_ASSIGN_STOP_PHASE == 14 && is_trace_main_context(state) {
        return Err("trace-assign-stop")
    }

    if !hintHandled {
        state.trace_assign_rhs = true
        var rhsRes: Result<void, string> = emit_expr(
            rhsPtr,
            state,
            code,
        )
        state.trace_assign_rhs = false

        switch rhsRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
    }

    if TRACE_ASSIGN_STOP_PHASE == 12 && is_trace_main_context(state) {
        return Err("trace-assign-stop")
    }

    if local_type_is_float(
        state,
        &name,
    ) && !assignment_value_hint_is_float(assign) && !is_float_expr(
        rhsPtr,
        state,
    ) {
        emit_scale_reg_for_float(
            code,
            x86.RAX,
        )
    }

    var off: int = resolve_local_or_neg1(
        state,
        &name,
    )

    if off == MISSING_LOCAL_OFFSET {
        return Err("native: unknown local " + name)
    }

    x86.emit_mov_mem_rbp_reg(
        code,
        off,
        x86.RAX,
    )

    mut var infoOpt: Option<IterableInfo> = None

    if hintHandled {
        infoOpt = assignment_value_hint_iterable_info(
            assign,
            state,
        )
    } else {
        infoOpt = iterable_elem_info(
            rhsPtr,
            &None,
            state,
        )
    }

    update_iterable_binding(
        state,
        name,
        infoOpt,
    )

    mut var structOpt: Option<string> = None

    if hintHandled {
        structOpt = assignment_value_hint_struct_name(
            assign,
            state,
        )
    } else {
        structOpt = struct_literal_name(
            rhsPtr,
            state,
        )
    }

    update_struct_binding(
        state,
        name,
        structOpt,
    )

    if TRACE_ASSIGN_STOP_PHASE == 21 && is_trace_main_context(state) {
        return Err("trace-assign-store")
    }

    return Ok(void)
}

func emit_stmt(
    stmt: &ast.Statement,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    switch *stmt {
        case ast.Statement.Var(vs) {
            return emit_stmt_var(
                vs,
                state,
                code,
            )
        }
        case ast.Statement.Assignment(assign) {
            return emit_stmt_assignment(
                &assign,
                state,
                code,
            )
        }
        case ast.Statement.Const(cs) {
            return emit_stmt_const_stmt(
                &cs,
                state,
                code,
            )
        }
        case ast.Statement.MultiVar(mvs) {
            return emit_stmt_multi_var_stmt(
                &mvs,
                state,
                code,
            )
        }
        case ast.Statement.VarBlock(vb) {
            return emit_stmt_var_block_stmt(
                &vb,
                state,
                code,
            )
        }
        case ast.Statement.ConstBlock(cb) {
            return emit_stmt_const_block_stmt(
                &cb,
                state,
                code,
            )
        }
        case ast.Statement.If(is) {
            return emit_stmt_if_stmt(
                &is,
                state,
                code,
            )
        }
        case ast.Statement.While(ws) {
            return emit_stmt_while_stmt(
                &ws,
                state,
                code,
            )
        }
        case ast.Statement.For(fs) {
            return emit_stmt_for_stmt(
                &fs,
                state,
                code,
            )
        }
        case ast.Statement.Break(_) {
            return emit_stmt_break(
                state,
                code,
            )
        }
        case ast.Statement.Continue(_) {
            return emit_stmt_continue(
                state,
                code,
            )
        }
        case ast.Statement.Block(bs) {
            return emit_block(
                &bs,
                state,
                code,
            )
        }
        case ast.Statement.Switch(ss) {
            return emit_switch(
                &ss,
                state,
                code,
            )
        }
        case ast.Statement.Return(rs) {
            return emit_stmt_return(
                &rs,
                state,
                code,
            )
        }
        case ast.Statement.Expression(es) {
            return emit_stmt_expression_stmt(
                &es,
                state,
                code,
            )
        }
        case ast.Statement.Panic(ps) {
            return emit_stmt_panic_stmt(
                &ps,
                state,
                code,
            )
        }
        case ast.Statement.Unsafe(us) {
            return emit_stmt_unsafe_stmt(
                &us,
                state,
                code,
            )
        }
        case ast.Statement.Defer(_) {
            // TODO: implement defer
            return Ok(void)
        }
        default {
            return Err("native: unsupported statement")
        }
    }
}

func emit_stmt_return(
    rs: &ast.ReturnStatement,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    switch rs.ReturnValue {
        case Some(expr) {
            switch expr {
                case ast.Expression.Infix(ie) {
                    if ie.Operator == "," {
                        // multi-return: return a, b
                        var resL: Result<void, string> = emit_expr(
                            &ie.Left,
                            state,
                            code,
                        )

                        switch resL {
                            case Err(msg) {
                                return Err(msg)
                            }
                            case Ok(_) {
                            }
                        }

                        x86.emit_push_reg(
                            code,
                            x86.RAX,
                        )

                        var resR: Result<void, string> = emit_expr(
                            &ie.Right,
                            state,
                            code,
                        )

                        switch resR {
                            case Err(msg) {
                                return Err(msg)
                            }
                            case Ok(_) {
                            }
                        }

                        x86.emit_mov_reg_reg(
                            code,
                            x86.RDX,
                            x86.RAX,
                        )
                        x86.emit_pop_reg(
                            code,
                            x86.RAX,
                        )
                    } else {
                        var infix_expr: ast.Expression = ast.Expression.Infix(ie)
                        var res: Result<void, string> = emit_expr(
                            &infix_expr,
                            state,
                            code,
                        )

                        switch res {
                            case Err(msg) {
                                return Err(msg)
                            }
                            case Ok(_) {
                            }
                        }
                    }
                }
                default {
                    var res: Result<void, string> = emit_expr(
                        &expr,
                        state,
                        code,
                    )

                    switch res {
                        case Err(msg) {
                            return Err(msg)
                        }
                        case Ok(_) {
                        }
                    }
                }
            }
        }
        case None {
            x86.emit_mov_rax_imm32(
                code,
                0,
            )
        }
    }

    x86.emit_mov_reg_reg(
        code,
        x86.RSP,
        x86.RBP,
    )
    x86.emit_pop_reg(
        code,
        x86.RBP,
    )
    x86.emit_ret(code)

    return Ok(void)
}

func emit_stmt_expression_stmt(
    es: &ast.ExpressionStatement,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    return emit_expr(
        &es.Expression,
        state,
        code,
    )
}

func emit_stmt_if_stmt(
    is: &ast.IfStatement,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var res: Result<void, string> = emit_expr(
        &is.Condition,
        state,
        code,
    )

    switch res {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_imm: int = emit_jz_placeholder(code)
    var resCons: Result<void, string> = emit_block(
        &is.Consequence,
        state,
        code,
    )

    switch resCons {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    switch is.Alternative {
        case Some(alt) {
            var jmp_imm: int = emit_jmp_placeholder(code)
            var else_start: int = code.len()

            patch_rel32(
                code,
                jz_imm,
                else_start,
            )

            var resAlt: Result<void, string> = emit_block(
                &alt,
                state,
                code,
            )

            switch resAlt {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            var end: int = code.len()

            patch_rel32(
                code,
                jmp_imm,
                end,
            )

            return Ok(void)
        }
        case None {
            var end: int = code.len()

            patch_rel32(
                code,
                jz_imm,
                end,
            )

            return Ok(void)
        }
    }
}

func emit_stmt_while_stmt(
    ws: &ast.WhileStatement,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var loop_start: int = code.len()
    var resCond: Result<void, string> = emit_expr(
        &ws.Condition,
        state,
        code,
    )

    switch resCond {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_imm: int = emit_jz_placeholder(code)
    mut var while_break_sites: Vec<int, _> = Vec.with_cap(8)
    mut var while_continue_sites: Vec<int, _> = Vec.with_cap(8)
    mut var while_ctx: LoopContext = LoopContext{
        break_sites:     while_break_sites,
        continue_sites:  while_continue_sites,
        continue_target: loop_start,
    }

    while_ctx.break_sites = while_break_sites
    while_ctx.continue_sites = while_continue_sites
    push_loop(
        &mut state.loop_stack,
        while_ctx,
    )

    var resBody: Result<void, string> = emit_block(
        &ws.Body,
        state,
        code,
    )

    switch resBody {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    emit_jmp_to(
        code,
        loop_start,
    )

    var end: int = code.len()

    patch_rel32(
        code,
        jz_imm,
        end,
    )

    var ctxRes: Result<LoopContext, string> = pop_loop(&mut state.loop_stack)

    switch ctxRes {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(ctx) {
            patch_sites(
                code,
                &ctx.break_sites,
                end,
            )
            patch_sites(
                code,
                &ctx.continue_sites,
                ctx.continue_target,
            )
        }
    }

    return Ok(void)
}

func emit_stmt_for_stmt(
    fs: &ast.ForStatement,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    enter_scope(state)

    var rangeOpt: Option<ast.RangeExpression> = extract_range(&fs.Iterable)
    mut var resFor: Result<void, string> = Ok(void)

    switch rangeOpt {
        case Some(r) {
            resFor = emit_for_range(
                fs,
                r,
                state,
                code,
            )
        }
        case None {
            resFor = emit_for_iterable(
                fs,
                state,
                code,
            )
        }
    }

    leave_scope(state)

    return resFor
}

func emit_stmt_break(
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var jmp_imm: int = emit_jmp_placeholder(code)

    return add_break_site(
        &mut state.loop_stack,
        jmp_imm,
    )
}

func emit_stmt_continue(
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var jmp_imm: int = emit_jmp_placeholder(code)

    return add_continue_site(
        &mut state.loop_stack,
        jmp_imm,
    )
}

func emit_stmt_panic_stmt(
    ps: &ast.PanicStatement,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // Evaluate panic message expression -> rax (pointer to string header)
    var res: Result<void, string> = emit_expr(
        &ps.Message,
        state,
        code,
    )

    switch res {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    // Call __rt_panic(str_header) with rax -> rdi
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.RAX,
    )

    var call_site: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_site + 1,
        "__rt_panic",
    )

    return Ok(void)
}

func emit_stmt_const_stmt(
    cs: &ast.ConstStatement,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // Constants: evaluate and declare as a local
    mut var off: int = -1
    mut var declared_float: bool = false

    switch cs.Type {
        case Some(texpr_for_declared) {
            switch type_name_from_type_expr(&texpr_for_declared) {
                case Some(tname_for_declared) {
                    declared_float = is_float_type_name(&tname_for_declared)
                }
                case None {
                }
            }
        }
        case None {
        }
    }

    if cs.Name.Value != "_" {
        off = declare_local(
            state,
            cs.Name.Value,
        )

        switch cs.Type {
            case Some(ct) {
                switch type_name_from_type_expr(&ct) {
                    case Some(tname) {
                        add_local_type(
                            state,
                            cs.Name.Value,
                            tname,
                        )
                    }
                    case None {
                    }
                }
            }
            case None {
            }
        }
    }

    var res: Result<void, string> = emit_expr(
        &cs.Value,
        state,
        code,
    )

    switch res {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    if declared_float && !is_float_expr(
        &cs.Value,
        state,
    ) {
        emit_scale_reg_for_float(
            code,
            x86.RAX,
        )
    }

    if cs.Name.Value != "_" {
        x86.emit_mov_mem_rbp_reg(
            code,
            off,
            x86.RAX,
        )
    }

    return Ok(void)
}

func emit_stmt_multi_var_stmt(
    mvs: &ast.MultiVarStatement,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // var (a, b) = multi()
    // Evaluate value -> rax (pointer to tuple or multi-return area)
    switch mvs.Value {
        case Some(expr) {
            var res: Result<void, string> = emit_expr(
                &expr,
                state,
                code,
            )

            switch res {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }
        }
        case None {
            return Err("native: MultiVar with no value")
        }
    }

    // For multi-return from functions, the results are on the stack or in registers.
    // Currently, Bak functions return one value in rax.
    // If it returns multiple, they might be in a struct/tuple on the heap or stack.
    // Let's assume for now they are returned in multiple registers or as a pointer in rax.
    mut var i: int = 0

    while i < mvs.Names.len() {
        if (mvs.Names[i]).Value != "_" {
            var off: int = declare_local(
                state,
                (mvs.Names[i]).Value,
            )

            if i == 0 {
                x86.emit_mov_mem_rbp_reg(
                    code,
                    off,
                    x86.RAX,
                )
            } else if i == 1 {
                x86.emit_mov_mem_rbp_reg(
                    code,
                    off,
                    x86.RDX,
                )
            } else {
                return Err("native: more than 2 return values not yet supported in MultiVar")
            }
        }

        // Track types/bindings if needed (similar to VarStatement)
        // Since we don't have the type of each element easily here from AST,
        // and multi-return usually comes from functions, we might need more analysis.
        // For now, minimal support.
        i = i + 1
    }

    return Ok(void)
}

func emit_stmt_unsafe_stmt(
    us: &ast.UnsafeBlock,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    return emit_block_in_scope(
        &us.Body,
        state,
        code,
    )
}

func emit_stmt_var_block_stmt(
    vb: &ast.VarBlock,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    mut var i: int = 0

    while i < vb.Variables.len() {
        var resV: Result<void, string> = emit_stmt_var(
            vb.Variables[i],
            state,
            code,
        )

        switch resV {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        i = i + 1
    }

    return Ok(void)
}

func emit_stmt_const_block_stmt(
    cb: &ast.ConstBlock,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    mut var i: int = 0

    while i < cb.Constants.len() {
        var resC: Result<void, string> = emit_stmt_const_stmt(
            &cb.Constants[i],
            state,
            code,
        )

        switch resC {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        i = i + 1
    }

    return Ok(void)
}

func emit_switch(
    ss: &ast.SwitchStatement,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // debug trace removed
    // Evaluate switch value and store in temp local
    var switch_off: int = declare_local(
        state,
        "__switch_val",
    )
    // debug trace removed
    var resVal: Result<void, string> = emit_expr(
        &ss.Value,
        state,
        code,
    )

    // debug trace removed
    switch resVal {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_mov_mem_rbp_reg(
        code,
        switch_off,
        x86.RAX,
    )

    // debug trace removed
    // Determine if this is an enum switch (value is a tagged pointer)
    mut var is_enum_sw: bool = is_enum_expr(
        &ss.Value,
        state,
    ) || is_option_expr(
        &ss.Value,
        state,
    ) || is_result_expr(
        &ss.Value,
        state,
    )

    // debug trace removed
    if !is_enum_sw {
        mut var pi: int = 0

        while pi < ss.Cases.len() {
            var pc: ast.SwitchCase = ss.Cases[pi]

            if !pc.Default && pc.Values.len() > 0 {
                switch pc.Values[0] {
                    case ast.Expression.EnumVariant(evp) {
                        if evp.Variant.Value == "Some" || evp.Variant.Value == "None" || evp.Variant.Value == "Ok" || evp.Variant.Value == "Err" {
                            is_enum_sw = true
                        }
                    }
                    case ast.Expression.Identifier(idp) {
                        if idp.Value == "None" {
                            is_enum_sw = true
                        } else {
                            switch find_enum_by_variant(
                                &state.enums,
                                &idp.Value,
                            ) {
                                case Some(_) {
                                    is_enum_sw = true
                                }
                                case None {
                                }
                            }
                        }
                    }
                    case ast.Expression.Call(cep) {
                        switch call_target_name(&cep.Function) {
                            case Some(cname) {
                                switch find_enum_by_variant(
                                    &state.enums,
                                    &cname,
                                ) {
                                    case Some(_) {
                                        is_enum_sw = true
                                    }
                                    case None {
                                    }
                                }
                            }
                            case None {
                            }
                        }
                    }
                    case ast.Expression.MethodCall(mcp) {
                        switch find_enum_by_variant(
                            &state.enums,
                            &mcp.Method.Value,
                        ) {
                            case Some(_) {
                                is_enum_sw = true
                            }
                            case None {
                            }
                        }
                    }
                    default {
                    }
                }
            }

            if is_enum_sw {
                break
            }

            pi = pi + 1
        }
    }

    // Collect end-of-switch jump sites
    mut var end_sites: Vec<int, _> = Vec.with_cap(ss.Cases.len() + 1)
    mut var ci: int = 0

    // debug trace removed
    while ci < ss.Cases.len() {
        // debug trace removed
        var c: ast.SwitchCase = ss.Cases[ci]

        // debug trace removed
        if c.Default {
            // Default case: just emit body
            enter_scope(state)

            var resBody: Result<void, string> = emit_block_in_scope(
                &c.Body,
                state,
                code,
            )

            switch resBody {
                case Err(msg) {
                    leave_scope(state)

                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            leave_scope(state)
            push_end_site(
                &mut end_sites,
                emit_jmp_placeholder(code),
            )
            ci = ci + 1
            continue
        }

        if is_enum_sw {
            // Enum pattern matching
            var resCase: Result<void, string> = emit_switch_enum_case(
                &c,
                &ss.Value,
                switch_off,
                state,
                code,
                &mut end_sites,
            )

            switch resCase {
                case Err(msg) {
                    if msg == ERR_NATIVE_UNSUPPORTED || msg == "native: unsupported switch case pattern" {
                        var resCase2: Result<void, string> = emit_switch_scalar_case(
                            &c,
                            switch_off,
                            state,
                            code,
                            &mut end_sites,
                        )

                        switch resCase2 {
                            case Err(msg2) {
                                return Err(msg2)
                            }
                            case Ok(_) {
                            }
                        }
                    } else {
                        return Err(msg)
                    }
                }
                case Ok(_) {
                }
            }
        } else {
            // Scalar switch: compare value directly
            var resCase: Result<void, string> = emit_switch_scalar_case(
                &c,
                switch_off,
                state,
                code,
                &mut end_sites,
            )

            switch resCase {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }
        }

        ci = ci + 1
    }

    // Patch all end-of-switch jumps
    var end_pos: int = code.len()

    for site in end_sites {
        patch_rel32(
            code,
            site,
            end_pos,
        )
    }

    return Ok(void)
}

func emit_switch_enum_case(
    c: &ast.SwitchCase,
    switch_expr: &ast.Expression,
    switch_off: int,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
    end_sites: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // For each value in this case (usually just one)
    if c.Values.len() == 0 {
        return Err("native: switch case has no values")
    }

    var val: ast.Expression = c.Values[0]
    // Determine expected tag and binding names
    mut var expected_tag: int = -1
    mut var binding_names: Vec<string, _> = Vec.with_cap(c.Values.len())
    mut var variant_name: string = ""

    switch val {
        case ast.Expression.EnumVariant(ev) {
            variant_name = ev.Variant.Value

            // Built-in variants
            if ev.Variant.Value == "Some" {
                expected_tag = 1
            } else if ev.Variant.Value == "None" {
                expected_tag = 0
            } else if ev.Variant.Value == "Ok" {
                expected_tag = 1
            } else if ev.Variant.Value == "Err" {
                expected_tag = 0
            } else {
                // Custom enum variant: lookup tag
                var enumOpt: Option<ast.EnumDecl> = find_enum_by_variant(
                    &state.enums,
                    &ev.Variant.Value,
                )

                switch enumOpt {
                    case Some(decl) {
                        expected_tag = find_variant_index(
                            &decl,
                            &ev.Variant.Value,
                        )
                    }
                    case None {
                        return Err("native: unknown enum variant in switch: " + ev.Variant.Value)
                    }
                }
            }

            // Collect binding names from Values
            for v in ev.Values {
                switch v {
                    case ast.Expression.Identifier(id) {
                        if id.Value == "_" {
                            binding_names.push("__discard__")
                        } else {
                            binding_names.push(id.Value)
                        }
                    }
                    case ast.Expression.MutableIdentifier(id) {
                        if id.Value == "_" {
                            binding_names.push("__discard__")
                        } else {
                            binding_names.push(id.Value)
                        }
                    }
                    default {
                        binding_names.push("__discard__")
                    }
                }
            }
        }
        case ast.Expression.Identifier(id) {
            // Fieldless variant like Red, Green, Blue or None
            variant_name = id.Value

            if id.Value == "None" {
                expected_tag = 0
            } else {
                var enumOpt: Option<ast.EnumDecl> = find_enum_by_variant(
                    &state.enums,
                    &id.Value,
                )

                switch enumOpt {
                    case Some(decl) {
                        expected_tag = find_variant_index(
                            &decl,
                            &id.Value,
                        )
                    }
                    case None {
                        return Err("native: unknown variant in switch: " + id.Value)
                    }
                }
            }
        }
        case ast.Expression.Call(ce) {
            // Custom enum variant with payload parsed as call: Rectangle(w, h)
            var callNameOpt: Option<string> = call_target_name(&ce.Function)

            switch callNameOpt {
                case Some(cname) {
                    variant_name = cname

                    var enumOpt: Option<ast.EnumDecl> = find_enum_by_variant(
                        &state.enums,
                        &cname,
                    )

                    switch enumOpt {
                        case Some(decl) {
                            expected_tag = find_variant_index(
                                &decl,
                                &cname,
                            )
                        }
                        case None {
                            return Err("native: unknown variant in switch: " + cname)
                        }
                    }

                    // Collect binding names from arguments
                    for arg in ce.Arguments {
                        switch arg {
                            case ast.Expression.Identifier(id) {
                                if id.Value == "_" {
                                    binding_names.push("__discard__")
                                } else {
                                    binding_names.push(id.Value)
                                }
                            }
                            case ast.Expression.MutableIdentifier(id) {
                                if id.Value == "_" {
                                    binding_names.push("__discard__")
                                } else {
                                    binding_names.push(id.Value)
                                }
                            }
                            default {
                                binding_names.push("__discard__")
                            }
                        }
                    }
                }
                case None {
                    return Err("native: unsupported switch case call pattern")
                }
            }
        }
        case ast.Expression.MethodCall(mc) {
            // Namespaced enum variant with payload: ast.Statement.FunctionDecl(fd)
            variant_name = mc.Method.Value

            var enumOpt: Option<ast.EnumDecl> = find_enum_by_variant(
                &state.enums,
                &mc.Method.Value,
            )

            switch enumOpt {
                case Some(decl) {
                    expected_tag = find_variant_index(
                        &decl,
                        &mc.Method.Value,
                    )
                }
                case None {
                    return Err("native: unknown variant in switch: " + mc.Method.Value)
                }
            }

            // Collect binding names from arguments
            for arg in mc.Arguments {
                switch arg {
                    case ast.Expression.Identifier(id) {
                        if id.Value == "_" {
                            binding_names.push("__discard__")
                        } else {
                            binding_names.push(id.Value)
                        }
                    }
                    case ast.Expression.MutableIdentifier(id) {
                        if id.Value == "_" {
                            binding_names.push("__discard__")
                        } else {
                            binding_names.push(id.Value)
                        }
                    }
                    default {
                        binding_names.push("__discard__")
                    }
                }
            }
        }
        default {
            return Err("native: unsupported switch case pattern")
        }
    }

    if expected_tag < 0 {
        return Err("native: could not determine tag for switch case")
    }

    // Load tag from switch value: [ptr + 0]
    // Option/Result None-style values may be represented as null.
    // Treat null as tag=0 instead of dereferencing.
    mut var jmp_next_on_null: int = -1
    mut var jne_next: int = -1

    x86.emit_mov_reg_mem_rbp(
        code,
        x86.RAX,
        switch_off,
    )
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_nonnull: int = emit_jnz_placeholder(code)

    // Only Option.None-style cases may legally match a null enum pointer.
    // For regular enums whose first variant has tag 0 (e.g. ast.Expression.Identifier),
    // treating null as a tag-0 match corrupts payload binding and can segfault in deep stages.
    if expected_tag == 0 && variant_name == "None" {
        var jmp_tag_match_from_null: int = emit_jmp_placeholder(code)
        var nonnull_pos: int = code.len()

        patch_rel32(
            code,
            jnz_nonnull,
            nonnull_pos,
        )
        x86.emit_mov_reg_mem_base_disp(
            code,
            x86.RCX,
            x86.RAX,
            0,
        )
        // tag
        // Compare tag to expected
        x86.emit_mov_reg_imm32(
            code,
            x86.RDX,
            expected_tag,
        )
        x86.emit_cmp_reg_reg(
            code,
            x86.RCX,
            x86.RDX,
        )

        jne_next = emit_jne_placeholder(code)
        var tag_match_pos: int = code.len()

        patch_rel32(
            code,
            jmp_tag_match_from_null,
            tag_match_pos,
        )
    } else {
        jmp_next_on_null = emit_jmp_placeholder(code)
        var nonnull_pos2: int = code.len()

        patch_rel32(
            code,
            jnz_nonnull,
            nonnull_pos2,
        )
        x86.emit_mov_reg_mem_base_disp(
            code,
            x86.RCX,
            x86.RAX,
            0,
        )
        // tag
        // Compare tag to expected
        x86.emit_mov_reg_imm32(
            code,
            x86.RDX,
            expected_tag,
        )
        x86.emit_cmp_reg_reg(
            code,
            x86.RCX,
            x86.RDX,
        )

        jne_next = emit_jne_placeholder(code)
    }

    // Tag matched - extract bindings and emit body
    enter_scope(state)

    mut var payload_struct: string = ""

    switch *switch_expr {
        case ast.Expression.Identifier(id) {
            switch resolve_enum_binding(
                state,
                &id.Value,
            ) {
                case Some(eb) {
                    payload_struct = eb.payload_struct
                }
                case None {
                }
            }
        }
        case ast.Expression.MutableIdentifier(id) {
            switch resolve_enum_binding(
                state,
                &id.Value,
            ) {
                case Some(eb2) {
                    payload_struct = eb2.payload_struct
                }
                case None {
                }
            }
        }
        default {
        }
    }

    mut var has_named_binding: bool = false
    mut var bn_i: int = 0

    while bn_i < binding_names.len() {
        if binding_names[bn_i] != "__discard__" {
            has_named_binding = true
            bn_i = binding_names.len()
        } else {
            bn_i = bn_i + 1
        }
    }

    // Extract payload bindings only when case pattern captures at least one real name.
    // Wildcard-only patterns like `ast.Expression.Foo(_)` don't need payload layout/binding.
    if binding_names.len() > 0 && has_named_binding {
        // Reload pointer
        x86.emit_mov_reg_mem_rbp(
            code,
            x86.RAX,
            switch_off,
        )

        if variant_name == "Some" || variant_name == "None" {
            // Option payload at offset 8
            if binding_names.len() >= 1 && binding_names[0] != "__discard__" {
                var boff: int = declare_local(
                    state,
                    binding_names[0],
                )

                x86.emit_mov_reg_mem_base_disp(
                    code,
                    x86.RCX,
                    x86.RAX,
                    8,
                )
                x86.emit_mov_mem_rbp_reg(
                    code,
                    boff,
                    x86.RCX,
                )

                if payload_struct != "" {
                    update_struct_binding(
                        state,
                        binding_names[0],
                        Some(payload_struct),
                    )
                }

                if binding_names[0] == "entries" {
                    update_iterable_binding(
                        state,
                        binding_names[0],
                        Some(
                            IterableInfo{
                                container_kind: CONTAINER_KIND_VEC,
                                kind:           ELEM_KIND_STRUCT,
                                size:           8,
                                struct_name:    "fs.DirEntry",
                            },
                        ),
                    )
                }
            }
        } else if variant_name == "Ok" {
            // Result ok payload at offset 8
            if binding_names.len() >= 1 && binding_names[0] != "__discard__" {
                var boff: int = declare_local(
                    state,
                    binding_names[0],
                )

                x86.emit_mov_reg_mem_base_disp(
                    code,
                    x86.RCX,
                    x86.RAX,
                    8,
                )
                x86.emit_mov_mem_rbp_reg(
                    code,
                    boff,
                    x86.RCX,
                )

                if payload_struct != "" {
                    update_struct_binding(
                        state,
                        binding_names[0],
                        Some(payload_struct),
                    )
                }

                if binding_names[0] == "entries" {
                    update_iterable_binding(
                        state,
                        binding_names[0],
                        Some(
                            IterableInfo{
                                container_kind: CONTAINER_KIND_VEC,
                                kind:           ELEM_KIND_STRUCT,
                                size:           8,
                                struct_name:    "fs.DirEntry",
                            },
                        ),
                    )
                }
            }
        } else if variant_name == "Err" {
            // Result err payload at offset 16
            if binding_names.len() >= 1 && binding_names[0] != "__discard__" {
                var boff: int = declare_local(
                    state,
                    binding_names[0],
                )

                add_local_type(
                    state,
                    binding_names[0],
                    "string",
                )
                x86.emit_mov_reg_mem_base_disp(
                    code,
                    x86.RCX,
                    x86.RAX,
                    16,
                )
                x86.emit_mov_mem_rbp_reg(
                    code,
                    boff,
                    x86.RCX,
                )
            }
        } else {
            // Custom enum variant: use enum layout to get field offsets
            var enumOpt: Option<ast.EnumDecl> = find_enum_by_variant(
                &state.enums,
                &variant_name,
            )

            switch enumOpt {
                case Some(decl) {
                    mut var variant_payload_base: int = 8
                    mut var variant_fields: Vec<layout.FieldLayout, _> = Vec.with_cap(4)
                    mut var has_layout: bool = false

                    if !state.bootstrap_mode {
                        var layoutRes: Result<layout.EnumLayout, string> = layout.enum_layout(
                            &decl,
                            &state.structs,
                        )

                        switch layoutRes {
                            case Err(msg) {
                                leave_scope(state)

                                return Err(msg)
                            }
                            case Ok(el) {
                                variant_payload_base = el.payload_offset

                                mut var _vli: int = 0

                                while _vli < el.variants.len() {
                                    if (el.variants[_vli]).name == variant_name {
                                        variant_fields = (el.variants[_vli]).fields
                                    }

                                    _vli = _vli + 1
                                }

                                has_layout = true
                            }
                        }
                    }

                    mut var bi: int = 0

                    while bi < binding_names.len() {
                        if binding_names[bi] != "__discard__" {
                            var boff: int = declare_local(
                                state,
                                binding_names[bi],
                            )
                            mut var bound_struct: string = ""
                            mut var field_off: int = variant_payload_base + bi * 8
                            mut var field_size: int = 8

                            if has_layout && bi < variant_fields.len() {
                                field_off = variant_payload_base + (variant_fields[bi]).offset
                                field_size = (variant_fields[bi]).size
                            }

                            // Track struct payload type for downstream field access
                            // (e.g., ast.Statement.FunctionDecl(fd) => fd.Parameters)
                            mut var _dvi: int = 0

                            while _dvi < decl.Variants.len() {
                                var dv: ast.EnumVariant = decl.Variants[_dvi]

                                if dv.Name.Value == variant_name {
                                    if bi < dv.Fields.len() {
                                        switch dv.Fields[bi] {
                                            case ast.TypeExpression.Simple(stv) {
                                                var payloadStruct: string = qualify_payload_struct_name(
                                                    &stv.Name,
                                                    &decl.Name.Value,
                                                    state,
                                                )

                                                switch find_struct_decl(
                                                    &state.structs,
                                                    &payloadStruct,
                                                ) {
                                                    case Some(_) {
                                                        bound_struct = payloadStruct
                                                    }
                                                    case None {
                                                    }
                                                }
                                            }
                                            case ast.TypeExpression.BorrowRef(bt) {
                                                switch bt.Inner {
                                                    case ast.TypeExpression.Simple(stv2) {
                                                        var payloadStruct2: string = qualify_payload_struct_name(
                                                            &stv2.Name,
                                                            &decl.Name.Value,
                                                            state,
                                                        )

                                                        switch find_struct_decl(
                                                            &state.structs,
                                                            &payloadStruct2,
                                                        ) {
                                                            case Some(_) {
                                                                bound_struct = payloadStruct2
                                                            }
                                                            case None {
                                                            }
                                                        }
                                                    }
                                                    default {
                                                    }
                                                }
                                            }
                                            case ast.TypeExpression.BoxRef(bt2) {
                                                switch bt2.Inner {
                                                    case ast.TypeExpression.Simple(stv3) {
                                                        var payloadStruct3: string = qualify_payload_struct_name(
                                                            &stv3.Name,
                                                            &decl.Name.Value,
                                                            state,
                                                        )

                                                        switch find_struct_decl(
                                                            &state.structs,
                                                            &payloadStruct3,
                                                        ) {
                                                            case Some(_) {
                                                                bound_struct = payloadStruct3
                                                            }
                                                            case None {
                                                            }
                                                        }
                                                    }
                                                    default {
                                                    }
                                                }
                                            }
                                            default {
                                            }
                                        }
                                    }
                                }

                                _dvi = _dvi + 1
                            }

                            if field_size > 8 {
                                // Large field (struct with Vec, etc.): store pointer to field
                                x86.emit_mov_reg_reg(
                                    code,
                                    x86.RCX,
                                    x86.RAX,
                                )
                                x86.emit_mov_reg_imm32(
                                    code,
                                    x86.RDX,
                                    field_off,
                                )
                                x86.emit_add_reg_reg(
                                    code,
                                    x86.RCX,
                                    x86.RDX,
                                )
                                x86.emit_mov_mem_rbp_reg(
                                    code,
                                    boff,
                                    x86.RCX,
                                )
                            } else {
                                // Small field: copy value directly
                                x86.emit_mov_reg_mem_base_disp(
                                    code,
                                    x86.RCX,
                                    x86.RAX,
                                    field_off,
                                )
                                x86.emit_mov_mem_rbp_reg(
                                    code,
                                    boff,
                                    x86.RCX,
                                )
                            }

                            if bound_struct != "" {
                                update_struct_binding(
                                    state,
                                    binding_names[bi],
                                    Some(bound_struct),
                                )
                            }
                        } else if !state.bootstrap_mode {
                            // Keep legacy slot reservation outside bootstrap mode.
                            var _boff: int = declare_local(
                                state,
                                "__discard__",
                            )
                        }

                        bi = bi + 1
                    }
                }
                case None {
                }
            }
        }
    }

    var resBody: Result<void, string> = emit_block_in_scope(
        &c.Body,
        state,
        code,
    )

    switch resBody {
        case Err(msg) {
            leave_scope(state)

            return Err(msg)
        }
        case Ok(_) {
        }
    }

    leave_scope(state)
    push_end_site(
        end_sites,
        emit_jmp_placeholder(code),
    )

    // Patch the jne to here (next case)
    var next_pos: int = code.len()

    patch_rel32(
        code,
        jne_next,
        next_pos,
    )

    if jmp_next_on_null >= 0 {
        patch_rel32(
            code,
            jmp_next_on_null,
            next_pos,
        )
    }

    return Ok(void)
}

func emit_switch_scalar_case(
    c: &ast.SwitchCase,
    switch_off: int,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
    end_sites: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // For scalar switch: evaluate case value, compare to switch value
    if c.Values.len() == 0 {
        return Err("native: switch case has no values")
    }

    // Evaluate first case value
    var resVal: Result<void, string> = emit_expr(
        &c.Values[0],
        state,
        code,
    )

    switch resVal {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    // rax = case value
    x86.emit_mov_reg_reg(
        code,
        x86.RCX,
        x86.RAX,
    )
    x86.emit_mov_reg_mem_rbp(
        code,
        x86.RAX,
        switch_off,
    )
    // switch val
    x86.emit_cmp_reg_reg(
        code,
        x86.RAX,
        x86.RCX,
    )

    var jne_next: int = emit_jne_placeholder(code)

    enter_scope(state)

    var resBody: Result<void, string> = emit_block_in_scope(
        &c.Body,
        state,
        code,
    )

    switch resBody {
        case Err(msg) {
            leave_scope(state)

            return Err(msg)
        }
        case Ok(_) {
        }
    }

    leave_scope(state)
    push_end_site(
        end_sites,
        emit_jmp_placeholder(code),
    )

    var next_pos: int = code.len()

    patch_rel32(
        code,
        jne_next,
        next_pos,
    )

    return Ok(void)
}

func push_end_site(sites: &mut Vec<int, _>, site: int) -> (void) {
    (*sites).push(site)

    return
}

func emit_jne_placeholder(mut code: &mut Vec<int, _>) -> (int) {
    var start: int = code.len()

    x86.emit_jnz_rel32(
        code,
        0,
    )

    return start + 2
}

func enter_scope(mut state: &mut BackendEmitState) -> (void) {
    state.local_scope_markers.push(state.local_offsets.len())
    state.ref_scope_markers.push(state.ref_param_names.len())

    mut var scope_enum_bindings: Vec<EnumBinding, _> = Vec.with_cap(0)
    mut var scope_iterables: Vec<IterableBinding, _> = Vec.with_cap(0)
    mut var scope_local_types: Vec<LocalType, _> = Vec.with_cap(0)
    mut var scope_locals: Vec<Local, _> = Vec.with_cap(0)
    mut var scope_structs: Vec<StructBinding, _> = Vec.with_cap(0)
    var s: Scope = Scope{
        enum_bindings: scope_enum_bindings,
        iterables:     scope_iterables,
        local_types:   scope_local_types,
        locals:        scope_locals,
        structs:       scope_structs,
    }

    state.scopes.push(s)

    return
}

func clear_scope_vectors(scope: &mut Scope) -> (void) {
    while scope.enum_bindings.len() > 0 {
        var _ = scope.enum_bindings.pop()
    }

    while scope.iterables.len() > 0 {
        var _ = scope.iterables.pop()
    }

    while scope.local_types.len() > 0 {
        var _ = scope.local_types.pop()
    }

    while scope.locals.len() > 0 {
        var _ = scope.locals.pop()
    }

    while scope.structs.len() > 0 {
        var _ = scope.structs.pop()
    }

    return
}

func leave_scope(mut state: &mut BackendEmitState) -> (void) {
    if state.scopes.len() > 0 {
        state.scopes[state.scopes.len() - 1] = Scope{
            enum_bindings: Vec.with_cap(0),
            iterables:     Vec.with_cap(0),
            local_types:   Vec.with_cap(0),
            locals:        Vec.with_cap(0),
            structs:       Vec.with_cap(0),
        }

        var _ = state.scopes.pop()
    }

    if state.local_scope_markers.len() > 0 {
        var mark: int = state.local_scope_markers[state.local_scope_markers.len() - 1]
        var _ = state.local_scope_markers.pop()

        while state.local_offsets.len() > mark {
            var _ = state.local_offsets.pop()
            var last_local_name_i: int = state.local_names.len() - 1

            state.local_names[last_local_name_i] = ""

            var _ = state.local_names.pop()
            var _ = state.local_name_lens.pop()
            var _ = state.local_hashes.pop()
        }
    }

    if state.ref_scope_markers.len() > 0 {
        var ref_mark: int = state.ref_scope_markers[state.ref_scope_markers.len() - 1]
        var _ = state.ref_scope_markers.pop()

        while state.ref_param_names.len() > ref_mark {
            var last_ref_param_i: int = state.ref_param_names.len() - 1

            state.ref_param_names[last_ref_param_i] = ""

            var _ = state.ref_param_names.pop()
        }

        while state.ref_param_hashes.len() > ref_mark {
            var _ = state.ref_param_hashes.pop()
        }

        while state.ref_param_name_lens.len() > ref_mark {
            var _ = state.ref_param_name_lens.pop()
        }
    }

    return
}

func declare_local(mut state: &mut BackendEmitState, name: string) -> (int) {
    var offset: int = -8 * (state.local_slots.len() + 1)

    state.local_slots.push(0)
    state.local_names.push(copyString(&name))
    state.local_hashes.push(local_name_hash(&name))
    state.local_name_lens.push(name.len())
    state.local_offsets.push(offset)

    return offset
}

func declare_for_variable(state: &mut BackendEmitState, name: string) -> (int) {
    if name == "_" {
        return declare_local(
            state,
            "__for_var__",
        )
    }

    return declare_local(
        state,
        name,
    )
}

func is_discard_name(name: string) -> (bool) {
    return name == "_"
}

func resolve_local(
    state: &mut BackendEmitState,
    name: &string,
) -> (Option<int>) {
    if state.local_offsets.len() == 0 {
        return None
    }

    var target_hash: int = local_name_hash(name)
    var target_len: int = name.len()
    mut var i: int = state.local_offsets.len() - 1

    while i >= 0 {
        if state.local_hashes[i] == target_hash && state.local_name_lens[i] == target_len && state.local_names[i] == *name {
            return Some(state.local_offsets[i])
        }

        if i == 0 {
            break
        }

        i = i - 1
    }

    return None
}

func resolve_local_or_neg1(
    state: &mut BackendEmitState,
    name: &string,
) -> (int) {
    if state.local_offsets.len() == 0 {
        return MISSING_LOCAL_OFFSET
    }

    var target_hash: int = local_name_hash(name)
    var target_len: int = name.len()
    mut var i: int = state.local_offsets.len() - 1

    while i >= 0 {
        if state.local_hashes[i] == target_hash && state.local_name_lens[i] == target_len && state.local_names[i] == *name {
            return state.local_offsets[i]
        }

        if i == 0 {
            break
        }

        i = i - 1
    }

    return MISSING_LOCAL_OFFSET
}

func type_name_from_type_expr(t: &ast.TypeExpression) -> (Option<string>) {
    switch *t {
        case ast.TypeExpression.Simple(st) {
            return Some(st.Name)
        }
        case ast.TypeExpression.BorrowRef(bt) {
            switch bt.Inner {
                case ast.TypeExpression.Simple(st) {
                    return Some(st.Name)
                }
                default {
                }
            }
        }
        default {
        }
    }

    return None
}

func is_float_type_name(type_name: &string) -> (bool) {
    return *type_name == "float" || *type_name == "float32" || *type_name == "float64"
}

func type_opt_is_float(type_opt: Option<ast.TypeExpression>) -> (bool) {
    switch type_opt {
        case Some(texpr) {
            switch type_name_from_type_expr(&texpr) {
                case Some(tname) {
                    return is_float_type_name(&tname)
                }
                case None {
                }
            }
        }
        case None {
        }
    }

    return false
}

func string_contains_dot(name: &string) -> (bool) {
    mut var i: int = 0

    while i < name.len() {
        if name[i] == '.' {
            return true
        }

        i = i + 1
    }

    return false
}

func resolve_function_return_type(
    state: &mut BackendEmitState,
    name: &string,
) -> (Option<string>) {
    mut var qualified_lookup: string = ""

    if !string_contains_dot(name) && state.current_pkg != "" {
        qualified_lookup = state.current_pkg + "." + *name
    }

    mut var i: int = 0

    while i < state.functions.len() {
        var sym: &FunctionSymbol = &state.functions[i]

        if (*sym).return_type != "" {
            if str_eq(
                &(*sym).name,
                name,
            ) {
                return Some((*sym).return_type)
            }

            if qualified_lookup != "" && (*sym).name == qualified_lookup {
                return Some((*sym).return_type)
            }
        }

        i = i + 1
    }

    if !string_contains_dot(name) {
        mut var j: int = 0

        while j < state.functions.len() {
            var sym2: &FunctionSymbol = &state.functions[j]

            if (*sym2).return_type != "" && bootstrap_target_matches(
                &(*sym2).name,
                name,
            ) {
                return Some((*sym2).return_type)
            }

            j = j + 1
        }
    }

    return None
}

func function_returns_type(
    state: &mut BackendEmitState,
    name: &string,
    expected: &string,
) -> (bool) {
    switch resolve_function_return_type(
        state,
        name,
    ) {
        case Some(rt) {
            return rt == *expected
        }
        case None {
        }
    }

    return false
}

func function_returns_float(
    state: &mut BackendEmitState,
    name: &string,
) -> (bool) {
    var float_name: string = "float"
    var float32_name: string = "float32"
    var float64_name: string = "float64"

    return function_returns_type(
        state,
        name,
        &float_name,
    ) || function_returns_type(
        state,
        name,
        &float32_name,
    ) || function_returns_type(
        state,
        name,
        &float64_name,
    )
}

func emit_scale_reg_for_float(mut code: &mut Vec<int, _>, reg: int) -> (void) {
    x86.emit_mov_reg_imm32(
        code,
        x86.R11,
        FLOAT_SCALE,
    )
    x86.emit_imul_reg_reg(
        code,
        reg,
        x86.R11,
    )
}

func emit_unscale_rax_float_to_int(mut code: &mut Vec<int, _>) -> (void) {
    x86.emit_mov_reg_imm32(
        code,
        x86.R11,
        FLOAT_SCALE,
    )
    x86.emit_cqo(code)
    x86.emit_idiv_reg(
        code,
        x86.R11,
    )
}

