        }
    }

    return false
}

func emit_string_instance_method(
    mc: &ast.MethodCallExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    if mc.Method.Value == "toString" || mc.Method.Value == "to_string" {
        if mc.Arguments.len() != 0 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_expr(
            &mc.Object,
            state,
            code,
        )
    }

    if mc.Method.Value == "len" {
        if mc.Arguments.len() != 0 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_string_len(
            &mc.Object,
            state,
            code,
        )
    }

    if mc.Method.Value == "substring" {
        if mc.Arguments.len() != 2 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_string_substring(
            &mc.Object,
            &mc.Arguments[0],
            &mc.Arguments[1],
            state,
            code,
        )
    }

    if mc.Method.Value == "endsWith" {
        if mc.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_strings_ends_with(
            &mc.Object,
            &mc.Arguments[0],
            state,
            code,
        )
    }

    if mc.Method.Value == "startsWith" {
        if mc.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_strings_starts_with(
            &mc.Object,
            &mc.Arguments[0],
            state,
            code,
        )
    }

    if mc.Method.Value == "indexOf" {
        if mc.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_strings_index_of(
            &mc.Object,
            &mc.Arguments[0],
            state,
            code,
        )
    }

    if mc.Method.Value == "contains" {
        if mc.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_strings_contains(
            &mc.Object,
            &mc.Arguments[0],
            state,
            code,
        )
    }

    if mc.Method.Value == "trim" {
        if mc.Arguments.len() != 0 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_strings_trim(
            &mc.Object,
            state,
            code,
        )
    }

    if mc.Method.Value == "toLower" {
        if mc.Arguments.len() != 0 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        var lowerObjRes: Result<void, string> = emit_expr(
            &mc.Object,
            state,
            code,
        )

        switch lowerObjRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        x86.emit_mov_reg_reg(
            code,
            x86.RDI,
            x86.RAX,
        )

        var lowerCallSite: int = code.len()

        x86.emit_call_rel32(
            code,
            0,
        )
        add_call_patch(
            state,
            lowerCallSite + 1,
            "strings.toLower",
        )

        return Ok(void)
    }

    if mc.Method.Value == "toUpper" {
        if mc.Arguments.len() != 0 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        var upperObjRes: Result<void, string> = emit_expr(
            &mc.Object,
            state,
            code,
        )

        switch upperObjRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        x86.emit_mov_reg_reg(
            code,
            x86.RDI,
            x86.RAX,
        )

        var upperCallSite: int = code.len()

        x86.emit_call_rel32(
            code,
            0,
        )
        add_call_patch(
            state,
            upperCallSite + 1,
            "strings.toUpper",
        )

        return Ok(void)
    }

    if mc.Method.Value == "split" {
        if mc.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        var splitObjRes: Result<void, string> = emit_expr(
            &mc.Object,
            state,
            code,
        )

        switch splitObjRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        x86.emit_push_reg(
            code,
            x86.RAX,
        )

        var splitArgRes: Result<void, string> = emit_expr(
            &mc.Arguments[0],
            state,
            code,
        )

        switch splitArgRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        x86.emit_mov_reg_reg(
            code,
            x86.RSI,
            x86.RAX,
        )
        x86.emit_pop_reg(
            code,
            x86.RDI,
        )

        var splitCallSite: int = code.len()

        x86.emit_call_rel32(
            code,
            0,
        )
        add_call_patch(
            state,
            splitCallSite + 1,
            "strings.split",
        )

        return Ok(void)
    }

    if mc.Method.Value == "bytes" {
        if mc.Arguments.len() != 0 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_bytes_from_string(
            &mc.Object,
            state,
            code,
        )
    }

    if mc.Method.Value == "parseFloat" {
        if mc.Arguments.len() != 0 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        var objRes: Result<void, string> = emit_expr(
            &mc.Object,
            state,
            code,
        )

        switch objRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        x86.emit_mov_reg_reg(
            code,
            x86.RDI,
            x86.RAX,
        )

        var call_site: int = code.len()

        x86.emit_call_rel32(
            code,
            0,
        )
        add_call_patch(
            state,
            call_site + 1,
            "strconv.atof",
        )

        return Ok(void)
    }

    return Err("native: unsupported string instance method " + mc.Method.Value)
}

func emit_vec_new(
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // Allocate Vec header {ptr,len,cap} (24 bytes)
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        24,
    )

    var call_site: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_site + 1,
        "__rt_alloc",
    )
    // Zero header fields.
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.RCX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.RCX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        16,
        x86.RCX,
    )

    return Ok(void)
}

func emit_vec_with_cap(
    cap_expr: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // Evaluate cap into rax.
    var res: Result<void, string> = emit_expr(
        cap_expr,
        state,
        code,
    )

    switch res {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_zero: int = emit_jz_placeholder(code)

    // Save cap on stack (alignment via sub/add rsp 8).
    x86.emit_mov_reg_reg(
        code,
        x86.R11,
        x86.RAX,
    )
    x86.emit_push_reg(
        code,
        x86.R11,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    // bytes = cap * 8
    x86.emit_mov_reg_reg(
        code,
        x86.RDX,
        x86.R11,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RDX,
        x86.RDX,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RDX,
        x86.RDX,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RDX,
        x86.RDX,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.RDX,
    )

    var call_data: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_data + 1,
        "__rt_alloc",
    )
    // Save data_ptr on stack, align, allocate header.
    x86.emit_push_reg(
        code,
        x86.RAX,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    x86.emit_push_reg(
        code,
        x86.R11,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        24,
    )

    var call_hdr: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_hdr + 1,
        "__rt_alloc",
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.R11,
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.RCX,
    )
    // data_ptr
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.R11,
    )
    // cap
    // Initialize header.
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.RCX,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDX,
        0,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.RDX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        16,
        x86.R11,
    )

    var jmp_done: int = emit_jmp_placeholder(code)
    var zero_start: int = code.len()

    patch_rel32(
        code,
        jz_zero,
        zero_start,
    )

    var zeroRes: Result<void, string> = emit_vec_new(
        state,
        code,
    )

    switch zeroRes {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    var done: int = code.len()

    patch_rel32(
        code,
        jmp_done,
        done,
    )

    return Ok(void)
}

// is_ref_expr checks if an expression is a reference parameter that needs extra dereference
func is_ref_expr(obj: &ast.Expression, state: &mut BackendEmitState) -> (bool) {
    switch *obj {
        case ast.Expression.Identifier(id) {
            mut var i: int = 0

            while i < state.ref_param_names.len() {
                if state.ref_param_names[i] == id.Value {
                    return true
                }

                i = i + 1
            }

            return false
        }
        case ast.Expression.MutableIdentifier(id) {
            mut var i: int = 0

            while i < state.ref_param_names.len() {
                if state.ref_param_names[i] == id.Value {
                    return true
                }

                i = i + 1
            }

            return false
        }
        default {
            return false
        }
    }
}

func is_addressable_receiver_expr(obj: &ast.Expression) -> (bool) {
    switch *obj {
        case ast.Expression.Identifier(_) {
            return true
        }
        case ast.Expression.MutableIdentifier(_) {
            return true
        }
        case ast.Expression.FieldAccess(_) {
            return true
        }
        case ast.Expression.Index(_) {
            return true
        }
        default {
            return false
        }
    }
}

func emit_safe_ref_deref_rax(mut code: &mut Vec<int, _>) -> (void) {
    // Match the Go backend's logic: dereference RAX when it looks like a
    // valid user-space pointer (non-null, upper 16 bits zero, 8-byte aligned,
    // and >= 0x400000).  Previous code only dereferenced stack-like addresses
    // (>= 0x700000000000), which missed heap/data-section references.
    // 1. test rax, rax  →  jz skip  (null guard)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_skip: int = emit_jz_placeholder(code)

    // 2. mov rcx, rax; shr rcx, 48; test rcx, rcx  →  jnz skip
    //    Reject values with any bits set above bit-47 (tagged immediates,
    //    kernel addresses, etc.)
    x86.emit_mov_reg_reg(
        code,
        x86.RCX,
        x86.RAX,
    )
    x86.emit_shr_reg_imm8(
        code,
        x86.RCX,
        48,
    )
    x86.emit_test_reg_reg(
        code,
        x86.RCX,
        x86.RCX,
    )

    var jnz_skip_high: int = emit_jnz_placeholder(code)

    // 3. test rax, 7  →  jnz skip  (alignment check)
    //    Encoding: REX.W test rax, imm32  = 48 a9 07 00 00 00
    code.push(0x48)
    code.push(0xa9)
    code.push(0x07)
    code.push(0x00)
    code.push(0x00)
    code.push(0x00)

    var jnz_skip_align: int = emit_jnz_placeholder(code)

    // 4. cmp rax, 0x400000  →  jb skip  (low-address guard)
    //    Encoding: REX.W cmp rax, imm32  = 48 3d <imm32>
    code.push(0x48)
    code.push(0x3d)
    code.push(0x00)
    code.push(0x00)
    code.push(0x40)
    code.push(0x00)

    //    jb rel32  = 0f 82 <rel32>
    var jb_start: int = code.len()

    code.push(0x0f)
    code.push(0x82)
    code.push(0x00)
    code.push(0x00)
    code.push(0x00)
    code.push(0x00)

    var jb_skip_low: int = jb_start + 2

    // 5. Dereference: mov rax, [rax]
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RAX,
        x86.RAX,
        0,
    )

    // Patch all skip jump targets to here.
    var skip_pos: int = code.len()

    patch_rel32(
        code,
        jz_skip,
        skip_pos,
    )
    patch_rel32(
        code,
        jnz_skip_high,
        skip_pos,
    )
    patch_rel32(
        code,
        jnz_skip_align,
        skip_pos,
    )
    patch_rel32(
        code,
        jb_skip_low,
        skip_pos,
    )

    return
}

// For reference-typed struct receivers, accept both layouts:
// 1) stack slot containing a heap pointer
// 2) stack slot containing an inline struct value
// If dereferencing the stack slot does not produce a plausible pointer,
// keep the original stack address as the base.
func emit_struct_ref_base_rax(mut code: &mut Vec<int, _>) -> (void) {
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_done: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_imm64(
        code,
        x86.RCX,
        0x0000000000400000,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.RAX,
        x86.RCX,
    )

    var jl_done: int = emit_jl_placeholder(code)

    // Save original address in case it already points to inline struct bytes.
    x86.emit_mov_reg_reg(
        code,
        x86.RDX,
        x86.RAX,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RAX,
        x86.RAX,
        0,
    )
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_restore: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0x00400000,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.RAX,
        x86.RCX,
    )

    var jge_done: int = emit_jge_placeholder(code)
    var restore_pos: int = code.len()

    patch_rel32(
        code,
        jz_restore,
        restore_pos,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RAX,
        x86.RDX,
    )

    var done_pos: int = code.len()

    patch_rel32(
        code,
        jz_done,
        done_pos,
    )
    patch_rel32(
        code,
        jl_done,
        done_pos,
    )
    patch_rel32(
        code,
        jge_done,
        done_pos,
    )

    return
}

func emit_safe_load_direct_rax_disp(
    disp: int,
    mut code: &mut Vec<int, _>,
) -> (void) {
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_zero: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0x00400000,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.RAX,
        x86.RCX,
    )

    var jge_load: int = emit_jge_placeholder(code)
    var jmp_zero_low: int = emit_jmp_placeholder(code)
    var load_pos: int = code.len()

    patch_rel32(
        code,
        jge_load,
        load_pos,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RAX,
        x86.RAX,
        disp,
    )

    var jmp_done: int = emit_jmp_placeholder(code)
    var zero_pos: int = code.len()

    patch_rel32(
        code,
        jz_zero,
        zero_pos,
    )
    patch_rel32(
        code,
        jmp_zero_low,
        zero_pos,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        0,
    )

    var done_pos: int = code.len()

    patch_rel32(
        code,
        jmp_done,
        done_pos,
    )

    return
}

func emit_safe_load_rax_from_rax_disp(
    disp: int,
    mut code: &mut Vec<int, _>,
) -> (void) {
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_zero: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0x00400000,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.RAX,
        x86.RCX,
    )

    var jge_load: int = emit_jge_placeholder(code)
    var jmp_zero_low: int = emit_jmp_placeholder(code)
    var load_pos: int = code.len()

    patch_rel32(
        code,
        jge_load,
        load_pos,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RAX,
        x86.RAX,
        disp,
    )

    var jmp_done: int = emit_jmp_placeholder(code)
    var zero_pos: int = code.len()

    patch_rel32(
        code,
        jz_zero,
        zero_pos,
    )
    patch_rel32(
        code,
        jmp_zero_low,
        zero_pos,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        0,
    )

    var done_pos: int = code.len()

    patch_rel32(
        code,
        jmp_done,
        done_pos,
    )

    return
}

func emit_add_imm_to_rax_if_nonzero(
    imm: int,
    mut code: &mut Vec<int, _>,
) -> (void) {
    if imm == 0 {
        return
    }

    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_skip: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        imm,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RAX,
        x86.RCX,
    )

    var skip_pos: int = code.len()

    patch_rel32(
        code,
        jz_skip,
        skip_pos,
    )

    return
}

func emit_vec_len(
    obj: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var res: Result<void, string> = emit_expr(
        obj,
        state,
        code,
    )

    switch res {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    // If obj is a reference (&Vec), dereference first
    if is_ref_expr(
        obj,
        state,
    ) {
        emit_safe_ref_deref_rax(code)
    }

    emit_safe_load_rax_from_rax_disp(
        8,
        code,
    )

    return Ok(void)
}

func emit_string_len(
    obj: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var res: Result<void, string> = emit_expr(
        obj,
        state,
        code,
    )

    switch res {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    if is_ref_expr(
        obj,
        state,
    ) {
        emit_safe_ref_deref_rax(code)
    }

    emit_safe_load_rax_from_rax_disp(
        8,
        code,
    )

    return Ok(void)
}

func emit_string_substring(
    obj: &ast.Expression,
    start: &ast.Expression,
    end: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var resObj: Result<void, string> = emit_expr(
        obj,
        state,
        code,
    )

    switch resObj {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_push_reg(
        code,
        x86.RAX,
    )

    var resStart: Result<void, string> = emit_expr(
        start,
        state,
        code,
    )

    switch resStart {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_push_reg(
        code,
        x86.RAX,
    )

    var resEnd: Result<void, string> = emit_expr(
        end,
        state,
        code,
    )

    switch resEnd {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_mov_reg_reg(
        code,
        x86.RDX,
        x86.RAX,
    )
    // end
    x86.emit_pop_reg(
        code,
        x86.RCX,
    )
    // start
    x86.emit_pop_reg(
        code,
        x86.R8,
    )
    // header ptr
    x86.emit_mov_reg_reg(
        code,
        x86.R9,
        x86.RDX,
    )
    x86.emit_sub_reg_reg(
        code,
        x86.R9,
        x86.RCX,
    )
    // len
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R10,
        x86.R8,
        0,
    )
    // base ptr
    x86.emit_add_reg_reg(
        code,
        x86.R10,
        x86.RCX,
    )
    // ptr + start
    x86.emit_push_reg(
        code,
        x86.R10,
    )
    x86.emit_push_reg(
        code,
        x86.R9,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        16,
    )

    var call_site: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_site + 1,
        "__rt_alloc",
    )
    x86.emit_pop_reg(
        code,
        x86.R9,
    )
    x86.emit_pop_reg(
        code,
        x86.R10,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.R10,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.R9,
    )

    return Ok(void)
}

func emit_string_equals(
    left: &ast.Expression,
    right: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
    invert: bool,
) -> (Result<void, string>) {
    var resL: Result<void, string> = emit_expr(
        left,
        state,
        code,
    )

    switch resL {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_push_reg(
        code,
        x86.RAX,
    )

    var resR: Result<void, string> = emit_expr(
        right,
        state,
        code,
    )

    switch resR {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_pop_reg(
        code,
        x86.RCX,
    )
    // RCX=left, RAX=right
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.RCX,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RSI,
        x86.RAX,
    )

    var call_site: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_site + 1,
        "__rt_str_eq",
    )

    // RAX = 1 if equal, 0 if not
    if invert {
        x86.emit_xor_reg_imm32(
            code,
            x86.RAX,
            1,
        )
    }

    return Ok(void)
}

func emit_string_concat(
    left: &ast.Expression,
    right: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var resL: Result<void, string> = emit_expr(
        left,
        state,
        code,
    )

    switch resL {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_push_reg(
        code,
        x86.RAX,
    )

    var resR: Result<void, string> = emit_expr(
        right,
        state,
        code,
    )

    switch resR {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_pop_reg(
        code,
        x86.RCX,
    )
    // left header
    // Load ptr/len for both strings.
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R8,
        x86.RCX,
        0,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R9,
        x86.RCX,
        8,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R10,
        x86.RAX,
        0,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R11,
        x86.RAX,
        8,
    )
    // total_len = left_len + right_len
    x86.emit_mov_reg_reg(
        code,
        x86.RDX,
        x86.R9,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RDX,
        x86.R11,
    )
    // Allocate buffer for concatenated bytes.
    x86.emit_push_reg(
        code,
        x86.R8,
    )
    x86.emit_push_reg(
        code,
        x86.R9,
    )
    x86.emit_push_reg(
        code,
        x86.R10,
    )
    x86.emit_push_reg(
        code,
        x86.R11,
    )
    x86.emit_push_reg(
        code,
        x86.RDX,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.RDX,
    )

    var call_buf: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_buf + 1,
        "__rt_alloc",
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.RDX,
    )
    x86.emit_pop_reg(
        code,
        x86.R11,
    )
    x86.emit_pop_reg(
        code,
        x86.R10,
    )
    x86.emit_pop_reg(
        code,
        x86.R9,
    )
    x86.emit_pop_reg(
        code,
        x86.R8,
    )
    // Copy left bytes.
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.RAX,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RSI,
        x86.R8,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RCX,
        x86.R9,
    )
    x86.emit_rep_movsb(code)
    // Copy right bytes.
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.RAX,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RDI,
        x86.R9,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RSI,
        x86.R10,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RCX,
        x86.R11,
    )
    x86.emit_rep_movsb(code)
    // Allocate header {ptr,len}.
    x86.emit_push_reg(
        code,
        x86.RAX,
    )
    // new_buf
    x86.emit_push_reg(
        code,
        x86.RDX,
    )
    // total_len
    x86.emit_push_reg(
        code,
        x86.R11,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        16,
    )

    var call_hdr: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_hdr + 1,
        "__rt_alloc",
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.R11,
    )
    x86.emit_pop_reg(
        code,
        x86.RDX,
    )
    x86.emit_pop_reg(
        code,
        x86.R8,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.R8,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.RDX,
    )

    return Ok(void)
}

// Concatenate two string headers already in registers (left_reg, right_reg).
// Returns new string header in RAX.
func emit_string_concat_regs(
    left_reg: int,
    right_reg: int,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    if left_reg != x86.RCX {
        x86.emit_mov_reg_reg(
            code,
            x86.RCX,
            left_reg,
        )
    }

    if right_reg != x86.RAX {
        x86.emit_mov_reg_reg(
            code,
            x86.RAX,
            right_reg,
        )
    }

    // Load ptr/len for both strings.
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R8,
        x86.RCX,
        0,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R9,
        x86.RCX,
        8,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R10,
        x86.RAX,
        0,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R11,
        x86.RAX,
        8,
    )
    // total_len = left_len + right_len
    x86.emit_mov_reg_reg(
        code,
        x86.RDX,
        x86.R9,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RDX,
        x86.R11,
    )
    // Allocate buffer for concatenated bytes.
    x86.emit_push_reg(
        code,
        x86.R8,
    )
    x86.emit_push_reg(
        code,
        x86.R9,
    )
    x86.emit_push_reg(
        code,
        x86.R10,
    )
    x86.emit_push_reg(
        code,
        x86.R11,
    )
    x86.emit_push_reg(
        code,
        x86.RDX,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.RDX,
    )

    var call_buf: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_buf + 1,
        "__rt_alloc",
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.RDX,
    )
    x86.emit_pop_reg(
        code,
        x86.R11,
    )
    x86.emit_pop_reg(
        code,
        x86.R10,
    )
    x86.emit_pop_reg(
        code,
        x86.R9,
    )
    x86.emit_pop_reg(
        code,
        x86.R8,
    )
    // Copy left bytes.
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.RAX,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RSI,
        x86.R8,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RCX,
        x86.R9,
    )
    x86.emit_rep_movsb(code)
    // Copy right bytes.
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.RAX,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RDI,
        x86.R9,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RSI,
        x86.R10,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RCX,
        x86.R11,
    )
    x86.emit_rep_movsb(code)
    // Allocate header {ptr,len}.
    x86.emit_push_reg(
        code,
        x86.RAX,
    )
    // new_buf
    x86.emit_push_reg(
        code,
        x86.RDX,
    )
    // total_len
    x86.emit_push_reg(
        code,
        x86.R11,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        16,
    )

    var call_hdr: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_hdr + 1,
        "__rt_alloc",
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.R11,
    )
    x86.emit_pop_reg(
        code,
        x86.RDX,
    )
    x86.emit_pop_reg(
        code,
        x86.R8,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.R8,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.RDX,
    )

    return Ok(void)
}

// Allocate a string header {ptr,len} from registers containing ptr/len.
// Requires ptr_reg and len_reg to not be RAX (RAX holds return header).
func emit_string_header_from_regs(
    ptr_reg: int,
    len_reg: int,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    x86.emit_push_reg(
        code,
        ptr_reg,
    )
    x86.emit_push_reg(
        code,
        len_reg,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        16,
    )

    var call_hdr: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_hdr + 1,
        "__rt_alloc",
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        len_reg,
    )
    x86.emit_pop_reg(
        code,
        ptr_reg,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        ptr_reg,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        len_reg,
    )

    return Ok(void)
}

// Push a string header value (R11) into a Vec<string> header (RCX).
// Uses elem_size=8 and grows via __rt_realloc when needed.
func emit_vec_push_string_from_regs(
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // vec_ptr in rcx, elem in r11, len in r10, cap in r8, data_ptr in r9
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R10,
        x86.RCX,
        8,
    )
    // len
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R8,
        x86.RCX,
        16,
    )
    // cap
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R9,
        x86.RCX,
        0,
    )
    // data_ptr
    x86.emit_cmp_reg_reg(
        code,
        x86.R10,
        x86.R8,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_grow: int = emit_jz_placeholder(code)
    var jmp_insert: int = emit_jmp_placeholder(code)
    var grow_start: int = code.len()

    // old_size = cap * 8
    x86.emit_mov_reg_reg(
        code,
        x86.RSI,
        x86.R8,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RSI,
        x86.RSI,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RSI,
        x86.RSI,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RSI,
        x86.RSI,
    )
    // new_cap = (cap == 0) ? 4 : cap * 2
    x86.emit_test_reg_reg(
        code,
        x86.R8,
        x86.R8,
    )

    var jz_newcap: int = emit_jz_placeholder(code)

    x86.emit_add_reg_reg(
        code,
        x86.R8,
        x86.R8,
    )

    var jmp_newcap_done: int = emit_jmp_placeholder(code)
    var newcap_zero: int = code.len()

    x86.emit_mov_reg_imm32(
        code,
        x86.R8,
        4,
    )

    var newcap_done: int = code.len()

    patch_rel32(
        code,
        jz_newcap,
        newcap_zero,
    )
    patch_rel32(
        code,
        jmp_newcap_done,
        newcap_done,
    )
    // new_size = new_cap * 8
    x86.emit_mov_reg_reg(
        code,
        x86.RDX,
        x86.R8,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RDX,
        x86.RDX,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RDX,
        x86.RDX,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RDX,
        x86.RDX,
    )
    // Preserve vec_ptr, elem, len, data_ptr, new_cap across call.
    x86.emit_push_reg(
        code,
        x86.RCX,
    )
    x86.emit_push_reg(
        code,
        x86.R11,
    )
    x86.emit_push_reg(
        code,
        x86.R10,
    )
    x86.emit_push_reg(
        code,
        x86.R9,
    )
    x86.emit_push_reg(
        code,
        x86.R8,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.R9,
    )

    // old_ptr
    var call_site: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_site + 1,
        "__rt_realloc",
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.R8,
    )
    x86.emit_pop_reg(
        code,
        x86.R9,
    )
    x86.emit_pop_reg(
        code,
        x86.R10,
    )
    x86.emit_pop_reg(
        code,
        x86.R11,
    )
    x86.emit_pop_reg(
        code,
        x86.RCX,
    )
    // Update vec header with new data_ptr and cap.
    x86.emit_mov_reg_reg(
        code,
        x86.R9,
        x86.RAX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RCX,
        0,
        x86.R9,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RCX,
        16,
        x86.R8,
    )

    var insert_start: int = code.len()

    patch_rel32(
        code,
        jz_grow,
        grow_start,
    )
    patch_rel32(
        code,
        jmp_insert,
        insert_start,
    )
    // Store element at data_ptr[len]
    x86.emit_mov_mem_base_index_reg(
        code,
        x86.R9,
        x86.R10,
        8,
        x86.R11,
    )
    // len++
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        1,
    )
    x86.emit_add_reg_reg(
        code,
        x86.R10,
        x86.RAX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RCX,
        8,
        x86.R10,
    )

    return Ok(void)
}

// Push a struct value (R11 points to struct bytes) into a Vec<T> header in RCX.
// Uses elem_size for sizing and grows via __rt_realloc when needed.
func emit_vec_push_struct_from_regs(
    elem_size: int,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // vec_ptr in rcx, elem in r11, len in r10, cap in r8, data_ptr in r9
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R10,
        x86.RCX,
        8,
    )
    // len
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R8,
        x86.RCX,
        16,
    )
    // cap
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R9,
        x86.RCX,
        0,
    )
    // data_ptr
    x86.emit_cmp_reg_reg(
        code,
        x86.R10,
        x86.R8,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_grow: int = emit_jz_placeholder(code)
    var jmp_insert: int = emit_jmp_placeholder(code)
    var grow_start: int = code.len()

    // Grow: compute old_size and new_cap/new_size, call __rt_realloc
    // old_size = cap * elem_size
    x86.emit_mov_reg_reg(
        code,
        x86.RSI,
        x86.R8,
    )

    var scale_old: int = vec_elem_scale(elem_size)

    if scale_old == 4 {
        x86.emit_add_reg_reg(
            code,
            x86.RSI,
            x86.RSI,
        )
        x86.emit_add_reg_reg(
            code,
            x86.RSI,
            x86.RSI,
        )
    } else if scale_old == 8 {
        x86.emit_add_reg_reg(
            code,
            x86.RSI,
            x86.RSI,
        )
        x86.emit_add_reg_reg(
            code,
            x86.RSI,
            x86.RSI,
        )
        x86.emit_add_reg_reg(
            code,
            x86.RSI,
            x86.RSI,
        )
    } else if scale_old == 0 {
        x86.emit_mov_reg_imm32(
            code,
            x86.RAX,
            elem_size,
        )
        x86.emit_imul_reg_reg(
            code,
            x86.RSI,
            x86.RAX,
        )
    }

    // new_cap = (cap == 0) ? 4 : cap * 2
    x86.emit_test_reg_reg(
        code,
        x86.R8,
        x86.R8,
    )

    var jz_newcap: int = emit_jz_placeholder(code)

    x86.emit_add_reg_reg(
        code,
        x86.R8,
        x86.R8,
    )

    var jmp_newcap_done: int = emit_jmp_placeholder(code)
    var newcap_zero: int = code.len()

    x86.emit_mov_reg_imm32(
        code,
        x86.R8,
        4,
    )

    var newcap_done: int = code.len()

    patch_rel32(
        code,
        jz_newcap,
        newcap_zero,
    )
    patch_rel32(
        code,
        jmp_newcap_done,
        newcap_done,
    )
    // new_size = new_cap * elem_size
    x86.emit_mov_reg_reg(
        code,
        x86.RDX,
        x86.R8,
    )

    var scale_new: int = vec_elem_scale(elem_size)

    if scale_new == 4 {
        x86.emit_add_reg_reg(
            code,
            x86.RDX,
            x86.RDX,
        )
        x86.emit_add_reg_reg(
            code,
            x86.RDX,
            x86.RDX,
        )
    } else if scale_new == 8 {
        x86.emit_add_reg_reg(
            code,
            x86.RDX,
            x86.RDX,
        )
        x86.emit_add_reg_reg(
            code,
            x86.RDX,
            x86.RDX,
        )
        x86.emit_add_reg_reg(
            code,
            x86.RDX,
            x86.RDX,
        )
    } else if scale_new == 0 {
        x86.emit_mov_reg_imm32(
            code,
            x86.RAX,
            elem_size,
        )
        x86.emit_imul_reg_reg(
            code,
            x86.RDX,
            x86.RAX,
        )
    }

    // Preserve vec_ptr, elem, len, data_ptr, new_cap across call.
    x86.emit_push_reg(
        code,
        x86.RCX,
    )
    x86.emit_push_reg(
        code,
        x86.R11,
    )
    x86.emit_push_reg(
        code,
        x86.R10,
    )
    x86.emit_push_reg(
        code,
        x86.R9,
    )
    x86.emit_push_reg(
        code,
        x86.R8,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    // Call __rt_realloc(old_ptr, old_size, new_size)
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.R9,
    )

    var call_site: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_site + 1,
        "__rt_realloc",
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.R8,
    )
    x86.emit_pop_reg(
        code,
        x86.R9,
    )
    x86.emit_pop_reg(
        code,
        x86.R10,
    )
    x86.emit_pop_reg(
        code,
        x86.R11,
    )
    x86.emit_pop_reg(
        code,
        x86.RCX,
    )
    // Update header with new_ptr and new_cap
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RCX,
        0,
        x86.RAX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RCX,
        16,
        x86.R8,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.R9,
        x86.RAX,
    )

    var insert_start: int = code.len()

    patch_rel32(
        code,
        jz_grow,
        grow_start,
    )
    patch_rel32(
        code,
        jmp_insert,
        insert_start,
    )
    // Uniform 8-byte element store: data_ptr[index * 8] = R11 (struct pointer)
    // R9 = data_ptr, R10 = index (len), R11 = element
    x86.emit_mov_mem_base_index_reg(
        code,
        x86.R9,
        x86.R10,
        8,
        x86.R11,
    )
    // len++
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        1,
    )
    x86.emit_add_reg_reg(
        code,
        x86.R10,
        x86.RAX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RCX,
        8,
        x86.R10,
    )

    return Ok(void)
}

func emit_bytes_length(
    obj: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var res: Result<void, string> = emit_expr(
        obj,
        state,
        code,
    )

    switch res {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    // Bytes is treated as Vec<int> header pointer.
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RAX,
        x86.RAX,
        8,
    )

    return Ok(void)
}

func emit_bytes_from_string(
    arg: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var res: Result<void, string> = emit_expr(
        arg,
        state,
        code,
    )

    switch res {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    // rax = string header
    x86.emit_mov_reg_reg(
        code,
        x86.R8,
        x86.RAX,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R9,
        x86.R8,
        0,
    )
    // str ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R10,
        x86.R8,
        8,
    )
    // len
    // Allocate data: len * 8
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.R10,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RDI,
        x86.RDI,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RDI,
        x86.RDI,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RDI,
        x86.RDI,
    )

    var call_data: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_data + 1,
        "__rt_alloc",
    )
    x86.emit_mov_reg_reg(
        code,
        x86.R11,
        x86.RAX,
    )
    // data ptr
    // i = 0
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )

    var loop_start: int = code.len()

    x86.emit_cmp_reg_reg(
        code,
        x86.RCX,
        x86.R10,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_done: int = emit_jz_placeholder(code)

    // load byte -> r8
    x86.emit_movzx_reg_mem_base_index(
        code,
        x86.R8,
        x86.R9,
        x86.RCX,
        1,
    )
    // store into data_ptr[i] (as 64-bit int)
    x86.emit_mov_mem_base_index_reg(
        code,
        x86.R11,
        x86.RCX,
        8,
        x86.R8,
    )
    // i++
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        1,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RCX,
        x86.RAX,
    )
    emit_jmp_to(
        code,
        loop_start,
    )

    var loop_end: int = code.len()

    patch_rel32(
        code,
        jz_done,
        loop_end,
    )
    // Allocate Vec header {ptr,len,cap}
    x86.emit_push_reg(
        code,
        x86.R11,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        24,
    )

    var call_hdr: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_hdr + 1,
        "__rt_alloc",
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.R11,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.R11,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.R10,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        16,
        x86.R10,
    )

    return Ok(void)
}

func emit_bytes_to_string(
    arg: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var res: Result<void, string> = emit_expr(
        arg,
        state,
        code,
    )

    switch res {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    // rax = vec header
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R9,
        x86.RAX,
        0,
    )
    // data ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R10,
        x86.RAX,
        8,
    )
    // len
    // Allocate byte buffer len
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.R10,
    )

    var call_buf: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_buf + 1,
        "__rt_alloc",
    )
    x86.emit_mov_reg_reg(
        code,
        x86.R11,
        x86.RAX,
    )
    // buf
    // i = 0
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )

    var loop_start: int = code.len()

    x86.emit_cmp_reg_reg(
        code,
        x86.RCX,
        x86.R10,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_done: int = emit_jz_placeholder(code)

    // load int element -> r8
    x86.emit_mov_reg_mem_base_index(
        code,
        x86.R8,
        x86.R9,
        x86.RCX,
        8,
    )
    // store byte into buf[i]
    x86.emit_mov_mem_base_index_reg8(
        code,
        x86.R11,
        x86.RCX,
        1,
        x86.R8,
    )
    // i++
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        1,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RCX,
        x86.RAX,
    )
    emit_jmp_to(
        code,
        loop_start,
    )

    var loop_end: int = code.len()

    patch_rel32(
        code,
        jz_done,
        loop_end,
    )
    // Allocate string header {ptr,len}
    x86.emit_push_reg(
        code,
        x86.R11,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        16,
    )

    var call_hdr: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_hdr + 1,
        "__rt_alloc",
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.R11,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.R11,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.R10,
    )

    return Ok(void)
}

func emit_bytes_get(
    obj: &ast.Expression,
    index: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var resObj: Result<void, string> = emit_expr(
        obj,
        state,
        code,
    )

    switch resObj {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_push_reg(
        code,
        x86.RAX,
    )

    var resIdx: Result<void, string> = emit_expr(
        index,
        state,
        code,
    )

    switch resIdx {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_mov_reg_reg(
        code,
        x86.R8,
        x86.RAX,
    )
    // idx
    x86.emit_pop_reg(
        code,
        x86.R11,
    )
    // vec header
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R10,
        x86.R11,
        8,
    )
    // len
    x86.emit_cmp_reg_reg(
        code,
        x86.R8,
        x86.R10,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_none: int = emit_jz_placeholder(code)

    // load data_ptr and value
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RDX,
        x86.R11,
        0,
    )
    x86.emit_mov_reg_mem_base_index(
        code,
        x86.R9,
        x86.RDX,
        x86.R8,
        8,
    )
    // allocate Option<int>
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        16,
    )

    var call_some: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_some + 1,
        "__rt_alloc",
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        1,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.RCX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.R9,
    )

    var jmp_done: int = emit_jmp_placeholder(code)
    var none_start: int = code.len()

    patch_rel32(
        code,
        jz_none,
        none_start,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        16,
    )

    var call_none: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_none + 1,
        "__rt_alloc",
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.RCX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.RCX,
    )

    var done: int = code.len()

    patch_rel32(
        code,
        jmp_done,
        done,
    )

    return Ok(void)
}

func emit_bytes_set(
    obj: &ast.Expression,
    index: &ast.Expression,
    value: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var resObj: Result<void, string> = emit_expr(
        obj,
        state,
        code,
    )

    switch resObj {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_push_reg(
        code,
        x86.RAX,
    )

    var resIdx: Result<void, string> = emit_expr(
        index,
        state,
        code,
    )

    switch resIdx {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_mov_reg_reg(
        code,
        x86.R8,
        x86.RAX,
    )

    // idx
    var resVal: Result<void, string> = emit_expr(
        value,
        state,
        code,
    )

    switch resVal {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_mov_reg_reg(
        code,
        x86.R9,
        x86.RAX,
    )
    // value
    x86.emit_pop_reg(
        code,
        x86.R11,
    )
    // vec header
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R10,
        x86.R11,
        8,
    )
    // len
    x86.emit_cmp_reg_reg(
        code,
        x86.R8,
        x86.R10,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_done: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RDX,
        x86.R11,
        0,
    )
    x86.emit_mov_mem_base_index_reg(
        code,
        x86.RDX,
        x86.R8,
        8,
        x86.R9,
    )

    var done: int = code.len()

    patch_rel32(
        code,
        jz_done,
        done,
    )
    x86.emit_mov_rax_imm32(
        code,
        0,
    )

    return Ok(void)
}

func emit_strings_index_of(
    s: &ast.Expression,
    sub: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var resS: Result<void, string> = emit_expr(
        s,
        state,
        code,
    )

    switch resS {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    x86.emit_push_reg(
        code,
        x86.RAX,
    )

    var resSub: Result<void, string> = emit_expr(
        sub,
        state,
        code,
    )

    switch resSub {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    x86.emit_pop_reg(
        code,
        x86.RCX,
    )
    // s header
    // load ptr/len
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R8,
        x86.RCX,
        0,
    )
    // s_ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R9,
        x86.RCX,
        8,
    )
    // s_len
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R10,
        x86.RAX,
        0,
    )
    // sub_ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R11,
        x86.RAX,
        8,
    )
    // sub_len
    // sub_len == 0 -> return 0
    x86.emit_test_reg_reg(
        code,
        x86.R11,
        x86.R11,
    )

    var jnz_has_sub: int = emit_jnz_placeholder(code)

    x86.emit_mov_rax_imm32(
        code,
        0,
    )

    var jmp_done: int = emit_jmp_placeholder(code)
    var has_sub: int = code.len()

    patch_rel32(
        code,
        jnz_has_sub,
        has_sub,
    )
    // sub_len > s_len -> return -1
    x86.emit_cmp_reg_reg(
        code,
        x86.R11,
        x86.R9,
    )
    x86.emit_setg(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_not_found: int = emit_jnz_placeholder(code)

    // limit = s_len - sub_len
    x86.emit_mov_reg_reg(
        code,
        x86.R12,
        x86.R9,
    )
    x86.emit_sub_reg_reg(
        code,
        x86.R12,
        x86.R11,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.R13,
        0,
    )

    // i
    var loop_i: int = code.len()

    // if i > limit -> not found
    x86.emit_cmp_reg_reg(
        code,
        x86.R13,
        x86.R12,
    )
    x86.emit_setle(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_not_found2: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.R14,
        0,
    )

    // j
    var loop_j: int = code.len()

    x86.emit_cmp_reg_reg(
        code,
        x86.R14,
        x86.R11,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_found: int = emit_jz_placeholder(code)

    // load s[i+j] and sub[j]
    x86.emit_mov_reg_reg(
        code,
        x86.RAX,
        x86.R13,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RAX,
        x86.R14,
    )
    x86.emit_movzx_reg_mem_base_index(
        code,
        x86.R15,
        x86.R8,
        x86.RAX,
        1,
    )
    x86.emit_movzx_reg_mem_base_index(
        code,
        x86.RDX,
        x86.R10,
        x86.R14,
        1,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R15,
        x86.RDX,
    )
    x86.emit_setne(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_next_i: int = emit_jnz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        1,
    )
    x86.emit_add_reg_reg(
        code,
        x86.R14,
        x86.RAX,
    )
    emit_jmp_to(
        code,
        loop_j,
    )

    var found_pos: int = code.len()

    patch_rel32(
        code,
        jz_found,
        found_pos,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RAX,
        x86.R13,
    )

    var jmp_done2: int = emit_jmp_placeholder(code)
    var next_i_pos: int = code.len()

    patch_rel32(
        code,
        jnz_next_i,
        next_i_pos,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        1,
    )
    x86.emit_add_reg_reg(
        code,
        x86.R13,
        x86.RAX,
    )
    emit_jmp_to(
        code,
        loop_i,
    )

    var not_found: int = code.len()

    patch_rel32(
        code,
        jnz_not_found,
        not_found,
    )
    patch_rel32(
        code,
        jz_not_found2,
        not_found,
    )
    x86.emit_mov_rax_imm32(
        code,
        -1,
    )

    var done: int = code.len()

    patch_rel32(
        code,
        jmp_done,
        done,
    )
    patch_rel32(
        code,
        jmp_done2,
        done,
    )
    // Wrap raw result in Option<int>
    // RAX = -1 (not found) or >= 0 (found index)
    x86.emit_push_reg(
        code,
        x86.RAX,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        -1,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.RAX,
        x86.RCX,
    )

    var jne_some_wrap: int = emit_jne_placeholder(code)

    // None path
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        16,
    )

    var call_none_io: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_none_io + 1,
        "__rt_alloc",
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.RCX,
    )

    var jmp_wrap_done_io: int = emit_jmp_placeholder(code)
    // Some path
    var some_wrap_pos_io: int = code.len()

    patch_rel32(
        code,
        jne_some_wrap,
        some_wrap_pos_io,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        16,
    )

    var call_some_io: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_some_io + 1,
        "__rt_alloc",
    )
    x86.emit_pop_reg(
        code,
        x86.RCX,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDX,
        1,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.RDX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.RCX,
    )

    var wrap_done_pos_io: int = code.len()

    patch_rel32(
        code,
        jmp_wrap_done_io,
        wrap_done_pos_io,
    )

    return Ok(void)
}

func emit_strings_last_index_of(
    s: &ast.Expression,
    sub: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var resS: Result<void, string> = emit_expr(
        s,
        state,
        code,
    )

    switch resS {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    x86.emit_push_reg(
        code,
        x86.RAX,
    )

    var resSub: Result<void, string> = emit_expr(
        sub,
        state,
        code,
    )

    switch resSub {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    x86.emit_pop_reg(
        code,
        x86.RCX,
    )
    // s header
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R8,
        x86.RCX,
        0,
    )
    // s_ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R9,
        x86.RCX,
        8,
    )
    // s_len
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R10,
        x86.RAX,
        0,
    )
    // sub_ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R11,
        x86.RAX,
        8,
    )
    // sub_len
    // sub_len == 0 -> return s_len
    x86.emit_test_reg_reg(
        code,
        x86.R11,
        x86.R11,
    )

    var jnz_has_sub: int = emit_jnz_placeholder(code)

    x86.emit_mov_reg_reg(
        code,
        x86.RAX,
        x86.R9,
    )

    var jmp_done: int = emit_jmp_placeholder(code)
    var has_sub: int = code.len()

    patch_rel32(
        code,
        jnz_has_sub,
        has_sub,
    )
    // sub_len > s_len -> return -1
    x86.emit_cmp_reg_reg(
        code,
        x86.R11,
        x86.R9,
    )
    x86.emit_setg(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_not_found: int = emit_jnz_placeholder(code)

    // i = s_len - sub_len
    x86.emit_mov_reg_reg(
        code,
        x86.R13,
        x86.R9,
    )
    x86.emit_sub_reg_reg(
        code,
        x86.R13,
        x86.R11,
    )

    var loop_i: int = code.len()

    // if i < 0 -> not found
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        0,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R13,
        x86.RAX,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_not_found2: int = emit_jnz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.R14,
        0,
    )

    // j
    var loop_j: int = code.len()

    x86.emit_cmp_reg_reg(
        code,
        x86.R14,
        x86.R11,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_found: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_reg(
        code,
        x86.RAX,
        x86.R13,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RAX,
        x86.R14,
    )
    x86.emit_movzx_reg_mem_base_index(
        code,
        x86.R15,
        x86.R8,
        x86.RAX,
        1,
    )
    x86.emit_movzx_reg_mem_base_index(
        code,
        x86.RDX,
        x86.R10,
        x86.R14,
        1,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R15,
        x86.RDX,
    )
    x86.emit_setne(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_prev_i: int = emit_jnz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        1,
    )
    x86.emit_add_reg_reg(
        code,
        x86.R14,
        x86.RAX,
    )
    emit_jmp_to(
        code,
        loop_j,
    )

    var found_pos: int = code.len()

    patch_rel32(
        code,
        jz_found,
        found_pos,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RAX,
        x86.R13,
    )

    var jmp_done2: int = emit_jmp_placeholder(code)
    var prev_i_pos: int = code.len()

    patch_rel32(
        code,
        jnz_prev_i,
        prev_i_pos,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        1,
    )
    x86.emit_sub_reg_reg(
        code,
        x86.R13,
        x86.RAX,
    )
    emit_jmp_to(
        code,
        loop_i,
    )

    var not_found: int = code.len()

    patch_rel32(
        code,
        jnz_not_found,
        not_found,
    )
    patch_rel32(
        code,
        jnz_not_found2,
        not_found,
    )
    x86.emit_mov_rax_imm32(
        code,
        -1,
    )

    var done: int = code.len()

    patch_rel32(
        code,
        jmp_done,
        done,
    )
    patch_rel32(
        code,
        jmp_done2,
        done,
    )
    // Wrap raw result in Option<int>
    x86.emit_push_reg(
        code,
        x86.RAX,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        -1,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.RAX,
        x86.RCX,
    )

    var jne_some_wrap_li: int = emit_jne_placeholder(code)

    // None path
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        16,
    )

    var call_none_li: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_none_li + 1,
        "__rt_alloc",
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.RCX,
    )

    var jmp_wrap_done_li: int = emit_jmp_placeholder(code)
    // Some path
    var some_wrap_pos_li: int = code.len()

    patch_rel32(
        code,
        jne_some_wrap_li,
        some_wrap_pos_li,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        16,
    )

    var call_some_li: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_some_li + 1,
        "__rt_alloc",
    )
    x86.emit_pop_reg(
        code,
        x86.RCX,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDX,
        1,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.RDX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.RCX,
    )

    var wrap_done_pos_li: int = code.len()

    patch_rel32(
        code,
        jmp_wrap_done_li,
        wrap_done_pos_li,
    )

    return Ok(void)
}

func emit_strings_contains(
    s: &ast.Expression,
    sub: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var res: Result<void, string> = emit_strings_index_of(
        s,
        sub,
        state,
        code,
    )

    switch res {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    // RAX = pointer to Option<int>; tag=1 means found
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RAX,
        x86.RAX,
        0,
    )

    return Ok(void)
}

func emit_strings_starts_with(
    s: &ast.Expression,
    prefix: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var resS: Result<void, string> = emit_expr(
        s,
        state,
        code,
    )

    switch resS {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    x86.emit_push_reg(
        code,
        x86.RAX,
    )

    var resP: Result<void, string> = emit_expr(
        prefix,
        state,
        code,
    )

    switch resP {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    x86.emit_pop_reg(
        code,
        x86.RCX,
    )
    // s header
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R8,
        x86.RCX,
        0,
    )
    // s_ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R9,
        x86.RCX,
        8,
    )
    // s_len
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R10,
        x86.RAX,
        0,
    )
    // p_ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R11,
        x86.RAX,
        8,
    )
    // p_len
    // if prefix_len > s_len -> false
    x86.emit_cmp_reg_reg(
        code,
        x86.R11,
        x86.R9,
    )
    x86.emit_setg(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_false: int = emit_jnz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.R12,
        0,
    )

    // i
    var loop_i: int = code.len()

    x86.emit_cmp_reg_reg(
        code,
        x86.R12,
        x86.R11,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_true: int = emit_jz_placeholder(code)

    x86.emit_movzx_reg_mem_base_index(
        code,
        x86.R13,
        x86.R8,
        x86.R12,
        1,
    )
    x86.emit_movzx_reg_mem_base_index(
        code,
        x86.R14,
        x86.R10,
        x86.R12,
        1,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R13,
        x86.R14,
    )
    x86.emit_setne(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_false2: int = emit_jnz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        1,
    )
    x86.emit_add_reg_reg(
        code,
        x86.R12,
        x86.RAX,
    )
    emit_jmp_to(
        code,
        loop_i,
    )

    var true_pos: int = code.len()

    patch_rel32(
        code,
        jz_true,
        true_pos,
    )
    x86.emit_mov_rax_imm32(
        code,
        1,
    )

    var jmp_done: int = emit_jmp_placeholder(code)
    var false_pos: int = code.len()

    patch_rel32(
        code,
        jnz_false,
        false_pos,
    )
    patch_rel32(
        code,
        jnz_false2,
        false_pos,
    )
    x86.emit_mov_rax_imm32(
        code,
        0,
    )

    var done: int = code.len()

    patch_rel32(
        code,
        jmp_done,
        done,
    )

    return Ok(void)
}

func emit_strings_ends_with(
    s: &ast.Expression,
    suffix: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var resS: Result<void, string> = emit_expr(
        s,
        state,
        code,
    )

    switch resS {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    x86.emit_push_reg(
        code,
        x86.RAX,
    )

    var resP: Result<void, string> = emit_expr(
        suffix,
        state,
        code,
    )

    switch resP {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    x86.emit_pop_reg(
        code,
        x86.RCX,
    )
    // s header
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R8,
        x86.RCX,
        0,
    )
    // s_ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R9,
        x86.RCX,
        8,
    )
    // s_len
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R10,
        x86.RAX,
        0,
    )
    // p_ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R11,
        x86.RAX,
        8,
    )
    // p_len
    // if suffix_len > s_len -> false
    x86.emit_cmp_reg_reg(
        code,
        x86.R11,
        x86.R9,
    )
    x86.emit_setg(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_false: int = emit_jnz_placeholder(code)

    // offset = s_len - suffix_len
    x86.emit_mov_reg_reg(
        code,
        x86.R12,
        x86.R9,
    )
    x86.emit_sub_reg_reg(
        code,
        x86.R12,
        x86.R11,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.R13,
        0,
    )

    // i
    var loop_i: int = code.len()

    x86.emit_cmp_reg_reg(
        code,
        x86.R13,
        x86.R11,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_true: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_reg(
        code,
        x86.RAX,
        x86.R12,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RAX,
        x86.R13,
    )
    x86.emit_movzx_reg_mem_base_index(
        code,
        x86.R14,
        x86.R8,
        x86.RAX,
        1,
    )
    x86.emit_movzx_reg_mem_base_index(
        code,
        x86.R15,
        x86.R10,
        x86.R13,
        1,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R14,
        x86.R15,
    )
    x86.emit_setne(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_false2: int = emit_jnz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        1,
    )
    x86.emit_add_reg_reg(
        code,
        x86.R13,
        x86.RAX,
    )
    emit_jmp_to(
        code,
        loop_i,
    )

    var true_pos: int = code.len()

    patch_rel32(
        code,
        jz_true,
        true_pos,
    )
    x86.emit_mov_rax_imm32(
        code,
        1,
    )

    var jmp_done: int = emit_jmp_placeholder(code)
    var false_pos: int = code.len()

    patch_rel32(
        code,
        jnz_false,
        false_pos,
    )
    patch_rel32(
        code,
        jnz_false2,
        false_pos,
    )
    x86.emit_mov_rax_imm32(
        code,
        0,
    )

    var done: int = code.len()

    patch_rel32(
        code,
        jmp_done,
        done,
    )

    return Ok(void)
}

func emit_strings_compare(
    a: &ast.Expression,
    b: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var resA: Result<void, string> = emit_expr(
        a,
        state,
        code,
    )

    switch resA {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    x86.emit_push_reg(
        code,
        x86.RAX,
    )

    var resB: Result<void, string> = emit_expr(
        b,
        state,
        code,
    )

    switch resB {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    x86.emit_pop_reg(
        code,
        x86.RCX,
    )
    // a header
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R8,
        x86.RCX,
        0,
    )
    // a_ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R9,
        x86.RCX,
        8,
    )
    // a_len
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R10,
        x86.RAX,
        0,
    )
    // b_ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R11,
        x86.RAX,
        8,
    )
    // b_len
    // min_len = min(a_len, b_len) in r12
    x86.emit_mov_reg_reg(
        code,
        x86.R12,
        x86.R9,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R9,
        x86.R11,
    )
    x86.emit_setg(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_min: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_reg(
        code,
        x86.R12,
        x86.R11,
    )

    var min_pos: int = code.len()

    patch_rel32(
        code,
        jz_min,
        min_pos,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.R13,
        0,
    )

    // i
    var loop_i: int = code.len()

    x86.emit_cmp_reg_reg(
        code,
        x86.R13,
        x86.R12,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_after: int = emit_jz_placeholder(code)

    x86.emit_movzx_reg_mem_base_index(
        code,
        x86.R14,
        x86.R8,
        x86.R13,
        1,
    )
    x86.emit_movzx_reg_mem_base_index(
        code,
        x86.R15,
        x86.R10,
        x86.R13,
        1,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R14,
        x86.R15,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_less: int = emit_jnz_placeholder(code)

    x86.emit_cmp_reg_reg(
        code,
        x86.R14,
        x86.R15,
    )
    x86.emit_setg(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_greater: int = emit_jnz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        1,
    )
    x86.emit_add_reg_reg(
        code,
        x86.R13,
        x86.RAX,
    )
    emit_jmp_to(
        code,
        loop_i,
    )

    var less_pos: int = code.len()

    patch_rel32(
        code,
        jnz_less,
        less_pos,
    )
    x86.emit_mov_rax_imm32(
        code,
        -1,
    )

    var jmp_done: int = emit_jmp_placeholder(code)
    var greater_pos: int = code.len()

    patch_rel32(
        code,
        jnz_greater,
        greater_pos,
    )
    x86.emit_mov_rax_imm32(
        code,
        1,
    )

    var jmp_done2: int = emit_jmp_placeholder(code)
    var after_pos: int = code.len()

    patch_rel32(
        code,
        jz_after,
        after_pos,
    )
    // compare lengths
    x86.emit_cmp_reg_reg(
        code,
        x86.R9,
        x86.R11,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_len_less: int = emit_jnz_placeholder(code)

    x86.emit_cmp_reg_reg(
        code,
        x86.R9,
        x86.R11,
    )
    x86.emit_setg(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_len_greater: int = emit_jnz_placeholder(code)

    x86.emit_mov_rax_imm32(
        code,
        0,
    )

    var jmp_done3: int = emit_jmp_placeholder(code)
    var len_less_pos: int = code.len()

    patch_rel32(
        code,
        jnz_len_less,
        len_less_pos,
    )
    x86.emit_mov_rax_imm32(
        code,
        -1,
    )

    var jmp_done4: int = emit_jmp_placeholder(code)
    var len_greater_pos: int = code.len()

    patch_rel32(
        code,
        jnz_len_greater,
        len_greater_pos,
    )
    x86.emit_mov_rax_imm32(
        code,
        1,
    )

    var done: int = code.len()

    patch_rel32(
        code,
        jmp_done,
        done,
    )
    patch_rel32(
        code,
        jmp_done2,
        done,
    )
    patch_rel32(
        code,
        jmp_done3,
        done,
    )
    patch_rel32(
        code,
        jmp_done4,
        done,
    )

    return Ok(void)
}

func emit_strings_trim_left(
    s: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var resS: Result<void, string> = emit_expr(
        s,
        state,
        code,
    )

    switch resS {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    x86.emit_mov_reg_reg(
        code,
        x86.R8,
        x86.RAX,
    )
    // header
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R9,
        x86.R8,
        0,
    )
    // ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R10,
        x86.R8,
        8,
    )
    // len
    x86.emit_mov_reg_imm32(
        code,
        x86.R11,
        0,
    )

    // left
    var loop_left: int = code.len()

    x86.emit_cmp_reg_reg(
        code,
        x86.R11,
        x86.R10,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_done: int = emit_jz_placeholder(code)

    x86.emit_movzx_reg_mem_base_index(
        code,
        x86.R12,
        x86.R9,
        x86.R11,
        1,
    )
    // is space? (32,9,10,13)
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        32,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R12,
        x86.RAX,
    )

    var jz_space1: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        9,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R12,
        x86.RAX,
    )

    var jz_space2: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        10,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R12,
        x86.RAX,
    )

    var jz_space3: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        13,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R12,
        x86.RAX,
    )

    var jz_space4: int = emit_jz_placeholder(code)
    var jmp_break: int = emit_jmp_placeholder(code)
    var space_pos: int = code.len()

    patch_rel32(
        code,
        jz_space1,
        space_pos,
    )
    patch_rel32(
        code,
        jz_space2,
        space_pos,
    )
    patch_rel32(
        code,
        jz_space3,
        space_pos,
    )
    patch_rel32(
        code,
        jz_space4,
        space_pos,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        1,
    )
    x86.emit_add_reg_reg(
        code,
        x86.R11,
        x86.RAX,
    )
    emit_jmp_to(
        code,
        loop_left,
    )

    var break_pos: int = code.len()

    patch_rel32(
        code,
        jmp_break,
        break_pos,
    )

    var done_pos: int = code.len()

    patch_rel32(
        code,
        jz_done,
        done_pos,
    )
    // ptr = s_ptr + left, len = s_len - left
    x86.emit_mov_reg_reg(
        code,
        x86.R14,
        x86.R9,
    )
    x86.emit_add_reg_reg(
        code,
        x86.R14,
        x86.R11,
    )
    // ptr
    x86.emit_mov_reg_reg(
        code,
        x86.R15,
        x86.R10,
    )
    x86.emit_sub_reg_reg(
        code,
        x86.R15,
        x86.R11,
    )

    // len
    return emit_string_header_from_regs(
        x86.R14,
        x86.R15,
        state,
        code,
    )
}

func emit_strings_trim_right(
    s: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var resS: Result<void, string> = emit_expr(
        s,
        state,
        code,
    )

    switch resS {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    x86.emit_mov_reg_reg(
        code,
        x86.R8,
        x86.RAX,
    )
    // header
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R9,
        x86.R8,
        0,
    )
    // ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R10,
        x86.R8,
        8,
    )
    // len
    x86.emit_mov_reg_reg(
        code,
        x86.R11,
        x86.R10,
    )

    // right = len
    var loop_right: int = code.len()

    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        0,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R11,
        x86.RAX,
    )
    x86.emit_setg(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_done: int = emit_jz_placeholder(code)

    // ch = s[right-1]
    x86.emit_mov_reg_reg(
        code,
        x86.R12,
        x86.R11,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        1,
    )
    x86.emit_sub_reg_reg(
        code,
        x86.R12,
        x86.RAX,
    )
    x86.emit_movzx_reg_mem_base_index(
        code,
        x86.R13,
        x86.R9,
        x86.R12,
        1,
    )
    // is space? (32,9,10,13)
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        32,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R13,
        x86.RAX,
    )

    var jz_space1: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        9,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R13,
        x86.RAX,
    )

    var jz_space2: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        10,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R13,
        x86.RAX,
    )

    var jz_space3: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        13,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R13,
        x86.RAX,
    )

    var jz_space4: int = emit_jz_placeholder(code)
    var jmp_break: int = emit_jmp_placeholder(code)
    var space_pos: int = code.len()

    patch_rel32(
        code,
        jz_space1,
        space_pos,
    )
    patch_rel32(
        code,
        jz_space2,
        space_pos,
    )
    patch_rel32(
        code,
        jz_space3,
        space_pos,
    )
    patch_rel32(
        code,
        jz_space4,
        space_pos,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        1,
    )
    x86.emit_sub_reg_reg(
        code,
        x86.R11,
        x86.RAX,
    )
    emit_jmp_to(
        code,
        loop_right,
    )

    var break_pos: int = code.len()

    patch_rel32(
        code,
        jmp_break,
        break_pos,
    )

    var done_pos: int = code.len()

    patch_rel32(
        code,
        jz_done,
        done_pos,
    )

    // ptr = s_ptr, len = right
    return emit_string_header_from_regs(
        x86.R9,
        x86.R11,
        state,
        code,
    )
}

func emit_strings_trim(
    s: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var resS: Result<void, string> = emit_expr(
        s,
        state,
        code,
    )

    switch resS {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    x86.emit_mov_reg_reg(
        code,
        x86.R8,
        x86.RAX,
    )
    // header
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R9,
        x86.R8,
        0,
    )
    // ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R10,
        x86.R8,
        8,
    )
    // len
    x86.emit_mov_reg_imm32(
        code,
        x86.R11,
        0,
    )
    // left
    x86.emit_mov_reg_reg(
        code,
        x86.R12,
        x86.R10,
    )

    // right
    // left scan
    var loop_left: int = code.len()

    x86.emit_cmp_reg_reg(
        code,
        x86.R11,
        x86.R12,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_left_done: int = emit_jz_placeholder(code)

    x86.emit_movzx_reg_mem_base_index(
        code,
        x86.R13,
        x86.R9,
        x86.R11,
        1,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        32,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R13,
        x86.RAX,
    )

    var jz_space1: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        9,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R13,
        x86.RAX,
    )

    var jz_space2: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        10,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R13,
        x86.RAX,
    )

    var jz_space3: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        13,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R13,
        x86.RAX,
    )

    var jz_space4: int = emit_jz_placeholder(code)
    var jmp_left_break: int = emit_jmp_placeholder(code)
    var left_space_pos: int = code.len()

    patch_rel32(
        code,
        jz_space1,
        left_space_pos,
    )
    patch_rel32(
        code,
        jz_space2,
        left_space_pos,
    )
    patch_rel32(
        code,
        jz_space3,
        left_space_pos,
    )
    patch_rel32(
        code,
        jz_space4,
        left_space_pos,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        1,
    )
    x86.emit_add_reg_reg(
        code,
        x86.R11,
        x86.RAX,
    )
    emit_jmp_to(
        code,
        loop_left,
    )

    var left_break_pos: int = code.len()

    patch_rel32(
        code,
        jmp_left_break,
        left_break_pos,
    )

    var left_done_pos: int = code.len()

    patch_rel32(
        code,
        jz_left_done,
        left_done_pos,
    )

    // right scan
    var loop_right: int = code.len()

    x86.emit_cmp_reg_reg(
        code,
        x86.R12,
        x86.R11,
    )
    x86.emit_setg(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_right_done: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_reg(
        code,
        x86.R13,
        x86.R12,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        1,
    )
    x86.emit_sub_reg_reg(
        code,
        x86.R13,
        x86.RAX,
    )
    x86.emit_movzx_reg_mem_base_index(
        code,
        x86.R14,
        x86.R9,
        x86.R13,
        1,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        32,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R14,
        x86.RAX,
    )

    var jz_space1: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        9,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R14,
        x86.RAX,
    )

    var jz_space2: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        10,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R14,
        x86.RAX,
    )

    var jz_space3: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        13,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R14,
        x86.RAX,
    )

    var jz_space4: int = emit_jz_placeholder(code)
    var jmp_right_break: int = emit_jmp_placeholder(code)
    var right_space_pos: int = code.len()

    patch_rel32(
        code,
        jz_space1,
        right_space_pos,
    )
    patch_rel32(
        code,
        jz_space2,
        right_space_pos,
    )
    patch_rel32(
        code,
        jz_space3,
        right_space_pos,
    )
    patch_rel32(
        code,
        jz_space4,
        right_space_pos,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        1,
    )
    x86.emit_sub_reg_reg(
        code,
        x86.R12,
        x86.RAX,
    )
    emit_jmp_to(
        code,
        loop_right,
    )

    var right_break_pos: int = code.len()

    patch_rel32(
        code,
        jmp_right_break,
        right_break_pos,
    )

    var right_done_pos: int = code.len()

    patch_rel32(
        code,
        jz_right_done,
        right_done_pos,
    )
    // if left >= right -> empty
    x86.emit_cmp_reg_reg(
        code,
        x86.R11,
        x86.R12,
    )
    x86.emit_setge(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_nonempty: int = emit_jz_placeholder(code)
    var emptyRes: Result<void, string> = emit_string_literal(
        &"",
        state,
        code,
    )

    switch emptyRes {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    var jmp_done: int = emit_jmp_placeholder(code)
    var nonempty_pos: int = code.len()

    patch_rel32(
        code,
        jz_nonempty,
        nonempty_pos,
    )
    // ptr = s_ptr + left, len = right - left
    x86.emit_mov_reg_reg(
        code,
        x86.R13,
        x86.R9,
    )
    x86.emit_add_reg_reg(
        code,
        x86.R13,
        x86.R11,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.R14,
        x86.R12,
    )
    x86.emit_sub_reg_reg(
        code,
        x86.R14,
        x86.R11,
    )

    var sliceRes: Result<void, string> = emit_string_header_from_regs(
        x86.R13,
        x86.R14,
        state,
        code,
    )

    switch sliceRes {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    var done: int = code.len()

    patch_rel32(
        code,
        jmp_done,
        done,
    )

    return Ok(void)
}

func emit_strings_repeat(
    s: &ast.Expression,
    count: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var resS: Result<void, string> = emit_expr(
        s,
        state,
        code,
    )

    switch resS {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    x86.emit_push_reg(
        code,
        x86.RAX,
    )

    var resC: Result<void, string> = emit_expr(
        count,
        state,
        code,
    )

    switch resC {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    x86.emit_mov_reg_reg(
        code,
        x86.R8,
        x86.RAX,
    )
    // count
    x86.emit_pop_reg(
        code,
        x86.R9,
    )
    // header
    x86.emit_test_reg_reg(
        code,
        x86.R8,
        x86.R8,
    )

    var jnz_nonzero: int = emit_jnz_placeholder(code)
    var emptyRes: Result<void, string> = emit_string_literal(
        &"",
        state,
        code,
    )

    switch emptyRes {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    var jmp_done_zero: int = emit_jmp_placeholder(code)
    var nonzero_pos: int = code.len()

    patch_rel32(
        code,
        jnz_nonzero,
        nonzero_pos,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R10,
        x86.R9,
        0,
    )
    // ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R11,
        x86.R9,
        8,
    )
    // len
    x86.emit_test_reg_reg(
        code,
        x86.R11,
        x86.R11,
    )

    var jnz_has_len: int = emit_jnz_placeholder(code)
    var emptyRes2: Result<void, string> = emit_string_literal(
        &"",
        state,
        code,
    )

    switch emptyRes2 {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    var jmp_done: int = emit_jmp_placeholder(code)
    var has_len_pos: int = code.len()

    patch_rel32(
        code,
        jnz_has_len,
        has_len_pos,
    )
    // total_len = len * count
    x86.emit_mov_reg_reg(
        code,
        x86.R12,
        x86.R11,
    )
    x86.emit_imul_reg_reg(
        code,
        x86.R12,
        x86.R8,
    )
    // allocate buffer total_len
    x86.emit_push_reg(
        code,
        x86.R10,
    )
    x86.emit_push_reg(
        code,
        x86.R11,
    )
    x86.emit_push_reg(
        code,
        x86.R8,
    )
    x86.emit_push_reg(
        code,
        x86.R12,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.R12,
    )

    var call_buf: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_buf + 1,
        "__rt_alloc",
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.R12,
    )
    x86.emit_pop_reg(
        code,
        x86.R8,
    )
    x86.emit_pop_reg(
        code,
        x86.R11,
    )
    x86.emit_pop_reg(
        code,
        x86.R10,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.R13,
        x86.RAX,
    )
    // buf
    // i = 0
    x86.emit_mov_reg_imm32(
        code,
        x86.R14,
        0,
    )

    var loop_i: int = code.len()

    x86.emit_cmp_reg_reg(
        code,
        x86.R14,
        x86.R8,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_copy_done: int = emit_jz_placeholder(code)

    // dest = buf + i*len
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.R13,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RAX,
        x86.R14,
    )
    x86.emit_imul_reg_reg(
        code,
        x86.RAX,
        x86.R11,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RDI,
        x86.RAX,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RSI,
        x86.R10,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RCX,
        x86.R11,
    )
    x86.emit_rep_movsb(code)
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        1,
    )
    x86.emit_add_reg_reg(
        code,
        x86.R14,
        x86.RAX,
    )
    emit_jmp_to(
        code,
        loop_i,
    )

    var copy_done: int = code.len()

    patch_rel32(
        code,
        jz_copy_done,
        copy_done,
    )
    // header {buf, total_len}
    x86.emit_mov_reg_reg(
        code,
        x86.R8,
        x86.R13,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.R9,
        x86.R12,
    )

    var hdrRes: Result<void, string> = emit_string_header_from_regs(
        x86.R8,
        x86.R9,
        state,
        code,
    )

    switch hdrRes {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    var done: int = code.len()

    patch_rel32(
        code,
        jmp_done,
        done,
    )
    patch_rel32(
        code,
        jmp_done_zero,
        done,
    )

    return Ok(void)
}

func emit_strings_from_bytes(
    bytes_expr: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var res: Result<void, string> = emit_expr(
        bytes_expr,
        state,
        code,
    )

    switch res {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    // Vec<int> header in rax
    x86.emit_mov_reg_reg(
        code,
        x86.R8,
        x86.RAX,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R9,
        x86.R8,
        0,
    )
    // data_ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R10,
        x86.R8,
        8,
    )
    // len
    // allocate buffer len
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.R10,
    )

    var call_buf: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_buf + 1,
        "__rt_alloc",
    )
    x86.emit_mov_reg_reg(
        code,
        x86.R11,
        x86.RAX,
    )
    // buf
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )

    // i
    var loop_i: int = code.len()

    x86.emit_cmp_reg_reg(
        code,
        x86.RCX,
        x86.R10,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_done: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_mem_base_index(
        code,
        x86.RDX,
        x86.R9,
        x86.RCX,
        8,
    )
    x86.emit_mov_mem_base_index_reg8(
        code,
        x86.R11,
        x86.RCX,
        1,
        x86.RDX,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        1,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RCX,
        x86.RAX,
    )
    emit_jmp_to(
        code,
        loop_i,
    )

    var done_pos: int = code.len()

    patch_rel32(
        code,
        jz_done,
        done_pos,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.R8,
        x86.R11,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.R9,
        x86.R10,
    )

    return emit_string_header_from_regs(
        x86.R8,
        x86.R9,
        state,
        code,
    )
}

func emit_builtin_string_from_bytes(
    vec_expr: &ast.Expression,
    start_expr: &ast.Expression,
    end_expr: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var resVec: Result<void, string> = emit_expr(
        vec_expr,
        state,
        code,
    )

    switch resVec {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    x86.emit_push_reg(
        code,
        x86.RAX,
    )

    var resStart: Result<void, string> = emit_expr(
        start_expr,
        state,
        code,
    )

    switch resStart {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    x86.emit_push_reg(
        code,
        x86.RAX,
    )

    var resEnd: Result<void, string> = emit_expr(
        end_expr,
        state,
        code,
    )

    switch resEnd {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    x86.emit_mov_reg_reg(
        code,
        x86.R10,
        x86.RAX,
    )
    // end
    x86.emit_pop_reg(
        code,
        x86.R8,
    )
    // start
    x86.emit_pop_reg(
        code,
        x86.R11,
    )
    // vec_ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R9,
        x86.R11,
        0,
    )
    // data_ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R12,
        x86.R11,
        8,
    )
    // vec_len
    // Clamp start to [0, vec_len].
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R8,
        x86.RCX,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_start_nonneg: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.R8,
        0,
    )

    var start_nonneg_pos: int = code.len()

    patch_rel32(
        code,
        jz_start_nonneg,
        start_nonneg_pos,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R8,
        x86.R12,
    )
    x86.emit_setg(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_start_ok: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_reg(
        code,
        x86.R8,
        x86.R12,
    )

    var start_ok_pos: int = code.len()

    patch_rel32(
        code,
        jz_start_ok,
        start_ok_pos,
    )
    // Clamp end to [start, vec_len].
    x86.emit_cmp_reg_reg(
        code,
        x86.R10,
        x86.R8,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_end_ge_start: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_reg(
        code,
        x86.R10,
        x86.R8,
    )

    var end_ge_start_pos: int = code.len()

    patch_rel32(
        code,
        jz_end_ge_start,
        end_ge_start_pos,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R10,
        x86.R12,
    )
    x86.emit_setg(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_end_ok: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_reg(
        code,
        x86.R10,
        x86.R12,
    )

    var end_ok_pos: int = code.len()

    patch_rel32(
        code,
        jz_end_ok,
        end_ok_pos,
    )
    // len = end - start
    x86.emit_sub_reg_reg(
        code,
        x86.R10,
        x86.R8,
    )
    // Allocate destination buffer of size len.
    x86.emit_push_reg(
        code,
        x86.R8,
    )
    x86.emit_push_reg(
        code,
        x86.R9,
    )
    x86.emit_push_reg(
        code,
        x86.R10,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.R10,
    )

    var call_buf: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_buf + 1,
        "__rt_alloc",
    )
    x86.emit_pop_reg(
        code,
        x86.R10,
    )
    x86.emit_pop_reg(
        code,
        x86.R9,
    )
    x86.emit_pop_reg(
        code,
        x86.R8,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.R11,
        x86.RAX,
    )
    // dst buffer
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )

    // i
    var loop_i: int = code.len()

    x86.emit_cmp_reg_reg(
        code,
        x86.RCX,
        x86.R10,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_done: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_reg(
        code,
        x86.RDX,
        x86.R8,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RDX,
        x86.RCX,
    )
    x86.emit_mov_reg_mem_base_index(
        code,
        x86.RAX,
        x86.R9,
        x86.RDX,
        8,
    )
    x86.emit_mov_mem_base_index_reg8(
        code,
        x86.R11,
        x86.RCX,
        1,
        x86.RAX,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        1,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RCX,
        x86.RDI,
    )
    emit_jmp_to(
        code,
        loop_i,
    )

    var done_pos: int = code.len()

    patch_rel32(
        code,
        jz_done,
        done_pos,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.R8,
        x86.R11,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.R9,
        x86.R10,
    )

    return emit_string_header_from_regs(
        x86.R8,
        x86.R9,
        state,
        code,
    )
}

func ensure_runtime_data_slots(mut state: &mut BackendEmitState) -> (void) {
    if state.data_items.len() <= RUNTIME_DATA_HEAP_END_INDEX {
        while state.data_items.len() <= RUNTIME_DATA_HEAP_END_INDEX {
            mut var bytes: Vec<int, _> = zero_bytes(8)

            state.data_items.push(
                DataItem{
                    align: 8,
                    bytes: bytes,
                },
            )
        }
    }

    // Keep runtime slot indices deterministic to avoid drift if state fields are clobbered.
    state.init_rsp_data_index = RUNTIME_DATA_INIT_RSP_INDEX
    state.args_cache_data_index = RUNTIME_DATA_ARGS_CACHE_INDEX
    state.time_counter_data_index = RUNTIME_DATA_TIME_COUNTER_INDEX

    return
}

func ensure_time_counter_index(mut state: &mut BackendEmitState) -> (int) {
    ensure_runtime_data_slots(state)

    return RUNTIME_DATA_TIME_COUNTER_INDEX
}

func ensure_init_rsp_index(mut state: &mut BackendEmitState) -> (int) {
    ensure_runtime_data_slots(state)

    return RUNTIME_DATA_INIT_RSP_INDEX
}

func ensure_args_cache_index(mut state: &mut BackendEmitState) -> (int) {
    ensure_runtime_data_slots(state)

    return RUNTIME_DATA_ARGS_CACHE_INDEX
}

func emit_init_rsp_addr(
    mut state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (void) {
    var idx: int = ensure_init_rsp_index(state)

    emit_data_addr(
        state,
        code,
        idx,
    )

    return
}

func emit_args_cache_addr(
    mut state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (void) {
    var idx: int = ensure_args_cache_index(state)

    emit_data_addr(
        state,
        code,
        idx,
    )

    return
}

func emit_time_counter_addr(
    mut state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (void) {
    var idx: int = ensure_time_counter_index(state)

    emit_data_addr(
        state,
        code,
        idx,
    )

    return
}

// Expect nanos value in R8; returns ptr to {nanos} in RAX.
func emit_time_alloc_from_r8(
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    x86.emit_push_reg(
        code,
        x86.R8,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        8,
    )

    var call_site: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_site + 1,
        "__rt_alloc",
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.R8,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.R8,
    )

    return Ok(void)
}

func emit_int_to_string_from_reg(
    value_reg: int,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        value_reg,
    )

    var call_site: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_site + 1,
        "__rt_itoa",
    )

    return Ok(void)
}

func emit_time_duration_nanos(
    n: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var res: Result<void, string> = emit_expr(
        n,
        state,
        code,
    )

    switch res {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    x86.emit_mov_reg_reg(
        code,
        x86.R8,
        x86.RAX,
    )

    return emit_time_alloc_from_r8(
        state,
        code,
    )
}

func emit_time_duration_scaled(
    n: &ast.Expression,
    scale: int,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var res: Result<void, string> = emit_expr(
        n,
        state,
        code,
    )

    switch res {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    x86.emit_mov_reg_reg(
        code,
        x86.R8,
        x86.RAX,
    )

    if scale != 1 {
        x86.emit_mov_reg_imm32(
            code,
            x86.RCX,
            scale,
        )
        x86.emit_imul_reg_reg(
            code,
            x86.R8,
            x86.RCX,
        )
    }

    return emit_time_alloc_from_r8(
        state,
        code,
    )
}

func emit_time_from_unix(
    n: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    return emit_time_duration_scaled(
        n,
        1000000000,
        state,
        code,
    )
}

func emit_time_from_unix_millis(
    n: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    return emit_time_duration_scaled(
        n,
        1000000,
        state,
        code,
    )
}

func emit_time_from_unix_nanos(
    n: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    return emit_time_duration_nanos(
        n,
        state,
        code,
    )
}

func emit_time_clock_gettime(
    clock_id: int,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // Allocate timespec {sec, nsec} (16 bytes).
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        16,
    )

    var call_site: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_site + 1,
        "__rt_alloc",
    )
    // Keep pointer in R10 (R11 is clobbered by syscall).
    x86.emit_mov_reg_reg(
        code,
        x86.R10,
        x86.RAX,
    )
    // syscall clock_gettime(clock_id, timespec*)
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        228,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        clock_id,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RSI,
        x86.R10,
    )
    emit_raw_syscall(code)
    // nanos = sec*1e9 + nsec
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R8,
        x86.R10,
        0,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R9,
        x86.R10,
        8,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RAX,
        x86.R8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        1000000000,
    )
    x86.emit_imul_reg_reg(
        code,
        x86.RAX,
        x86.RCX,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RAX,
        x86.R9,
    )

    return Ok(void)
}

func emit_time_monotonic_now(
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    return emit_time_clock_gettime(
        1,
        state,
        code,
    )
}

func emit_time_monotonic_since(
    start: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var res: Result<void, string> = emit_expr(
        start,
        state,
        code,
    )

    switch res {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    x86.emit_mov_reg_reg(
        code,
        x86.R8,
        x86.RAX,
    )
    // start
    x86.emit_push_reg(
        code,
        x86.R8,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )

    var nowRes: Result<void, string> = emit_time_clock_gettime(
        1,
        state,
        code,
    )

    switch nowRes {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.R8,
    )
    x86.emit_sub_reg_reg(
        code,
        x86.RAX,
        x86.R8,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.R8,
        x86.RAX,
    )

    return emit_time_alloc_from_r8(
        state,
        code,
    )
}

func emit_time_sleep_ms(
    ms: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var res: Result<void, string> = emit_expr(
        ms,
        state,
        code,
    )

    switch res {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    // secs = ms / 1000, nsec = (ms % 1000) * 1e6
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        1000,
    )
    x86.emit_cqo(code)
    x86.emit_idiv_reg(
        code,
        x86.RCX,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.R10,
        x86.RAX,
    )
    // secs
    x86.emit_mov_reg_reg(
        code,
        x86.R11,
        x86.RDX,
    )
    // rem ms
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        1000000,
    )
    x86.emit_imul_reg_reg(
        code,
        x86.R11,
        x86.RCX,
    )
    // nsec
    // Allocate timespec and store values.
    x86.emit_push_reg(
        code,
        x86.R10,
    )
    x86.emit_push_reg(
        code,
        x86.R11,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        16,
    )

    var call_site: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_site + 1,
        "__rt_alloc",
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.R11,
    )
    x86.emit_pop_reg(
        code,
        x86.R10,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.R10,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.R11,
    )
    // syscall nanosleep(timespec*, null)
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.RAX,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RSI,
        0,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        35,
    )
    emit_raw_syscall(code)
    x86.emit_mov_rax_imm32(
        code,
        0,
    )

    return Ok(void)
}

func emit_time_now(
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var res: Result<void, string> = emit_time_clock_gettime(
        0,
        state,
        code,
    )

    switch res {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    x86.emit_mov_reg_reg(
        code,
        x86.R8,
        x86.RAX,
    )

    return emit_time_alloc_from_r8(
        state,
        code,
    )
}

func emit_time_now_ms(
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var res: Result<void, string> = emit_time_clock_gettime(
        0,
        state,
        code,
    )

    switch res {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        1000000,
    )
    x86.emit_cqo(code)
    x86.emit_idiv_reg(
        code,
        x86.RCX,
    )

    return Ok(void)
}

func emit_os_args(
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // Return cached args if already built.
    emit_args_cache_addr(
        state,
        code,
    )
    // rax = &cache
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R8,
        x86.RAX,
        0,
    )
    x86.emit_test_reg_reg(
        code,
        x86.R8,
        x86.R8,
    )

    var jz_build: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_reg(
        code,
        x86.RAX,
        x86.R8,
    )

    var jmp_done: int = emit_jmp_placeholder(code)
    var build_pos: int = code.len()

    patch_rel32(
        code,
        jz_build,
        build_pos,
    )
    // Load initial rsp -> argc/argv.
    emit_init_rsp_addr(
        state,
        code,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R10,
        x86.RAX,
        0,
    )
    // init rsp
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R8,
        x86.R10,
        0,
    )
    // argc
    x86.emit_mov_reg_reg(
        code,
        x86.R11,
        x86.R10,
    )
    // argv base
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        8,
    )
    x86.emit_add_reg_reg(
        code,
        x86.R11,
        x86.RAX,
    )
    // Allocate data array (argc * 8).
    x86.emit_mov_reg_reg(
        code,
        x86.RDX,
        x86.R8,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RDX,
        x86.RDX,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RDX,
        x86.RDX,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RDX,
        x86.RDX,
    )
    x86.emit_push_reg(
        code,
        x86.R8,
    )
    x86.emit_push_reg(
        code,
        x86.R11,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.RDX,
    )

    var call_data: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_data + 1,
        "__rt_alloc",
    )
    x86.emit_pop_reg(
        code,
        x86.R11,
    )
    x86.emit_pop_reg(
        code,
        x86.R8,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.R9,
        x86.RAX,
    )
    // data ptr
    // Allocate Vec header.
    x86.emit_push_reg(
        code,
        x86.R8,
    )
    x86.emit_push_reg(
        code,
        x86.R9,
    )
    x86.emit_push_reg(
        code,
        x86.R11,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        24,
    )

    var call_hdr: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_hdr + 1,
        "__rt_alloc",
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.R11,
    )
    x86.emit_pop_reg(
        code,
        x86.R9,
    )
    x86.emit_pop_reg(
        code,
        x86.R8,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.R10,
        x86.RAX,
    )
    // header ptr
    // for i in 0..argc
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )

    var loop_start: int = code.len()

    x86.emit_cmp_reg_reg(
        code,
        x86.RCX,
        x86.R8,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_done: int = emit_jz_placeholder(code)

    // cstr_ptr = argv[i]
    x86.emit_mov_reg_mem_base_index(
        code,
        x86.RDX,
        x86.R11,
        x86.RCX,
        8,
    )
    // len loop
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        0,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RSI,
        1,
    )

    var len_loop: int = code.len()

    x86.emit_movzx_reg_mem_base_index(
        code,
        x86.RDI,
        x86.RDX,
        x86.RAX,
        1,
    )
    x86.emit_test_reg_reg(
        code,
        x86.RDI,
        x86.RDI,
    )

    var jz_len_done: int = emit_jz_placeholder(code)

    x86.emit_add_reg_reg(
        code,
        x86.RAX,
        x86.RSI,
    )
    emit_jmp_to(
        code,
        len_loop,
    )

    var len_done_pos: int = code.len()

    patch_rel32(
        code,
        jz_len_done,
        len_done_pos,
    )
    // Allocate string header (16 bytes).
    x86.emit_push_reg(
        code,
        x86.R8,
    )
    x86.emit_push_reg(
        code,
        x86.R9,
    )
    x86.emit_push_reg(
        code,
        x86.R10,
    )
    x86.emit_push_reg(
        code,
        x86.R11,
    )
    x86.emit_push_reg(
        code,
        x86.RCX,
    )
    x86.emit_push_reg(
        code,
        x86.RDX,
    )
    x86.emit_push_reg(
        code,
        x86.RAX,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        16,
    )

    var call_str: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_str + 1,
        "__rt_alloc",
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.RAX,
    )
    // header ptr
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.RAX,
    )
    // len
    x86.emit_pop_reg(
        code,
        x86.RDX,
    )
    // cstr ptr
    x86.emit_pop_reg(
        code,
        x86.RCX,
    )
    // index
    x86.emit_pop_reg(
        code,
        x86.R11,
    )
    x86.emit_pop_reg(
        code,
        x86.R10,
    )
    x86.emit_pop_reg(
        code,
        x86.R9,
    )
    x86.emit_pop_reg(
        code,
        x86.R8,
    )
    // store header fields
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RDI,
        0,
        x86.RDX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RDI,
        8,
        x86.RAX,
    )
    // store header ptr into data array
    x86.emit_mov_mem_base_index_reg(
        code,
        x86.R9,
        x86.RCX,
        8,
        x86.RDI,
    )
    // i++
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        1,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RCX,
        x86.RAX,
    )
    emit_jmp_to(
        code,
        loop_start,
    )

    var done_pos: int = code.len()

    patch_rel32(
        code,
        jz_done,
        done_pos,
    )
    // fill Vec header {ptr,len,cap}
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.R10,
        0,
        x86.R9,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.R10,
        8,
        x86.R8,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.R10,
        16,
        x86.R8,
    )
    // cache and return
    emit_args_cache_addr(
        state,
        code,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.R10,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RAX,
        x86.R10,
    )

    var done2: int = code.len()

    patch_rel32(
        code,
        jmp_done,
        done2,
    )

    return Ok(void)
}

// emit_os_exit calls __rt_exit with the given exit code.
func emit_os_exit(
    code_expr: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // Evaluate exit code
    var res: Result<void, string> = emit_expr(
        code_expr,
        state,
        code,
    )

    switch res {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    // rax = exit code, move to rdi
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.RAX,
    )
    // syscall exit (60)
    x86.emit_mov_rax_imm32(
        code,
        60,
    )
    emit_raw_syscall(code)

    return Ok(void)
}

// emit_os_cwd returns the current working directory as a string.
func emit_os_cwd(
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // Allocate buffer on stack (4096 bytes, PATH_MAX)
    x86.emit_sub_rsp_imm32(
        code,
        4096,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.RSP,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RSI,
        4096,
    )
    // syscall getcwd (79)
    x86.emit_mov_rax_imm32(
        code,
        79,
    )
    emit_raw_syscall(code)
    // rax = pointer to path on success, negative on error
    // Save the buffer pointer
    x86.emit_mov_reg_reg(
        code,
        x86.R12,
        x86.RSP,
    )
    // Calculate string length (strlen)
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.R12,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.R13,
        0,
    )

    var strlen_loop: int = code.len()

    // Load byte at [rdi + r13]
    x86.emit_movzx_reg_mem_base_index(
        code,
        x86.RAX,
        x86.RDI,
        x86.R13,
        1,
    )
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_done: int = emit_jz_placeholder(code)

    // Increment length
    x86.emit_add_reg_imm8(
        code,
        x86.R13,
        1,
    )

    var jmp_strlen_loop: int = code.len()

    x86.emit_jmp_rel32(
        code,
        0,
    )
    patch_rel32(
        code,
        jmp_strlen_loop + 1,
        strlen_loop,
    )

    var done_pos: int = code.len()

    patch_rel32(
        code,
        jz_done,
        done_pos,
    )
    // r13 = length, r12 = ptr
    // Allocate string buffer and copy
    x86.emit_push_reg(
        code,
        x86.R12,
    )
    x86.emit_push_reg(
        code,
        x86.R13,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.R13,
    )

    var call_alloc: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_alloc + 1,
        "__rt_alloc",
    )
    x86.emit_pop_reg(
        code,
        x86.R13,
    )
    x86.emit_pop_reg(
        code,
        x86.R12,
    )
    // rax = new buffer
    x86.emit_mov_reg_reg(
        code,
        x86.R14,
        x86.RAX,
    )
    // Copy string: memcpy(r14, r12, r13)
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )

    var copy_loop: int = code.len()

    x86.emit_cmp_reg_reg(
        code,
        x86.RCX,
        x86.R13,
    )

    var jge_copy_done: int = emit_jge_placeholder(code)

    // Load byte from source
    x86.emit_movzx_reg_mem_base_index(
        code,
        x86.RAX,
        x86.R12,
        x86.RCX,
        1,
    )
    // Store byte to dest
    x86.emit_mov_mem_base_index_reg8(
        code,
        x86.R14,
        x86.RCX,
        1,
        x86.RAX,
    )
    x86.emit_add_reg_imm8(
        code,
        x86.RCX,
        1,
    )

    var jmp_copy_loop: int = code.len()

    x86.emit_jmp_rel32(
        code,
        0,
    )
    patch_rel32(
        code,
        jmp_copy_loop + 1,
        copy_loop,
    )

    var copy_done: int = code.len()

    patch_rel32(
        code,
        jge_copy_done,
        copy_done,
    )
    // Create string header {ptr, len}
    x86.emit_push_reg(
        code,
        x86.R14,
    )
    x86.emit_push_reg(
        code,
        x86.R13,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        16,
    )

    var call_hdr: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_hdr + 1,
        "__rt_alloc",
    )
    x86.emit_pop_reg(
        code,
        x86.R13,
    )
    x86.emit_pop_reg(
        code,
        x86.R14,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.R14,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.R13,
    )
    // Restore stack (remove 4096 byte buffer)
    x86.emit_add_rsp_imm32(
        code,
        4096,
    )

    return Ok(void)
}

// emit_os_chmod changes file mode bits.
// Uses chmod syscall (90).
func emit_os_chmod(
    path: &ast.Expression,
    mode: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // Evaluate path expression
    var pathRes: Result<void, string> = emit_expr(
        path,
        state,
        code,
    )

    switch pathRes {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    // rax = path string header, push it
    x86.emit_push_reg(
        code,
        x86.RAX,
    )

    // Evaluate mode expression
    var modeRes: Result<void, string> = emit_expr(
        mode,
        state,
        code,
    )

    switch modeRes {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    // rax = mode value, save to RSI
    x86.emit_mov_reg_reg(
        code,
        x86.RSI,
        x86.RAX,
    )
    // Pop path string header
    x86.emit_pop_reg(
        code,
        x86.R8,
    )
    // Get raw path pointer (string header is {ptr, len})
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RDI,
        x86.R8,
        0,
    )
    // syscall chmod(path, mode) - syscall 90
    x86.emit_mov_rax_imm32(
        code,
        90,
    )
    emit_raw_syscall(code)
    // rax < 0 means error
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.RAX,
        x86.RCX,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_err: int = emit_jnz_placeholder(code)

    // Success: return Ok(void) - allocate Result with tag=1 (Ok)
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        24,
    )

    var call_ok: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_ok + 1,
        "__rt_alloc",
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        1,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.RCX,
    )
    // Zero out value fields
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.RCX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        16,
        x86.RCX,
    )

    var jmp_done: int = emit_jmp_placeholder(code)
    var err_pos: int = code.len()

    patch_rel32(
        code,
        jnz_err,
        err_pos,
    )

    // Return Err("chmod failed")
    var err_msg: string = "chmod failed"
    var litRes: Result<void, string> = emit_string_literal(
        &err_msg,
        state,
        code,
    )

    switch litRes {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_push_reg(
        code,
        x86.RAX,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        24,
    )

    var call_err: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_err + 1,
        "__rt_alloc",
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.R8,
    )
    // tag = 0 (Err)
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.RCX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.RCX,
    )
    // error string ptr at offset 16
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        16,
        x86.R8,
    )

    var done: int = code.len()

    patch_rel32(
        code,
        jmp_done,
        done,
    )

    return Ok(void)
}

// emit_os_getenv gets an environment variable.
// Returns Option<string>: Some(value) or None.
func emit_os_getenv(
    key: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // Evaluate key string
    var res: Result<void, string> = emit_expr(
        key,
        state,
        code,
    )

    switch res {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    // rax = key string header
    x86.emit_push_reg(
        code,
        x86.RAX,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    // Load environ pointer from after argv null terminator
    // environs are at [init_rsp + 8 + 8*argc + 8]
    emit_init_rsp_addr(
        state,
        code,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R10,
        x86.RAX,
        0,
    )
    // r10 = initial rsp
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R8,
        x86.R10,
        0,
    )
    // r8 = argc
    // envp = init_rsp + 8 + 8*(argc+1) = init_rsp + 8 + 8*argc + 8 = init_rsp + 16 + 8*argc
    x86.emit_mov_reg_reg(
        code,
        x86.R9,
        x86.R8,
    )
    x86.emit_add_reg_imm8(
        code,
        x86.R9,
        2,
    )
    // r9 = argc + 2
    // shl r9, 3 (multiply by 8)
    x86.emit_shl_reg_imm8(
        code,
        x86.R9,
        3,
    )
    x86.emit_add_reg_reg(
        code,
        x86.R9,
        x86.R10,
    )
    // r9 = envp pointer (points to first env string pointer)
    // Restore key
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.R11,
    )
    // r11 = key string header
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R12,
        x86.R11,
        0,
    )
    // r12 = key ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R13,
        x86.R11,
        8,
    )

    // r13 = key len
    // Loop through environ
    var env_loop: int = code.len()

    // Load envp[i]
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R14,
        x86.R9,
        0,
    )
    // r14 = current env string (C string)
    x86.emit_test_reg_reg(
        code,
        x86.R14,
        x86.R14,
    )

    var jz_not_found: int = emit_jz_placeholder(code)

    // Compare first r13 bytes with key
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )

    var cmp_loop: int = code.len()

    x86.emit_cmp_reg_reg(
        code,
        x86.RCX,
        x86.R13,
    )

    var jge_cmp_done: int = emit_jge_placeholder(code)

    // Load key byte
    x86.emit_movzx_reg_mem_base_index(
        code,
        x86.RAX,
        x86.R12,
        x86.RCX,
        1,
    )
    // Load env byte
    x86.emit_movzx_reg_mem_base_index(
        code,
        x86.RDX,
        x86.R14,
        x86.RCX,
        1,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.RAX,
        x86.RDX,
    )

    var jne_next_env: int = emit_jne_placeholder(code)

    x86.emit_add_reg_imm8(
        code,
        x86.RCX,
        1,
    )

    var jmp_cmp_loop: int = code.len()

    x86.emit_jmp_rel32(
        code,
        0,
    )
    patch_rel32(
        code,
        jmp_cmp_loop + 1,
        cmp_loop,
    )

    var cmp_done: int = code.len()

    patch_rel32(
        code,
        jge_cmp_done,
        cmp_done,
    )
    // Check if env[key_len] == '='
    x86.emit_movzx_reg_mem_base_index(
        code,
        x86.RAX,
        x86.R14,
        x86.R13,
        1,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDX,
        61,
    )
    // '=' = 61
    x86.emit_cmp_reg_reg(
        code,
        x86.RAX,
        x86.RDX,
    )

    var jne_next_env2: int = emit_jne_placeholder(code)

    // Found match! Extract value after '='
    // value_ptr = r14 + key_len + 1
    x86.emit_mov_reg_reg(
        code,
        x86.R15,
        x86.R14,
    )
    x86.emit_add_reg_reg(
        code,
        x86.R15,
        x86.R13,
    )
    x86.emit_add_reg_imm8(
        code,
        x86.R15,
        1,
    )
    // r15 = value ptr
    // Calculate value length (strlen)
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.R15,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RBX,
        0,
    )

    var val_strlen: int = code.len()

    x86.emit_movzx_reg_mem_base_index(
        code,
        x86.RAX,
        x86.RDI,
        x86.RBX,
        1,
    )
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_val_done: int = emit_jz_placeholder(code)

    x86.emit_add_reg_imm8(
        code,
        x86.RBX,
        1,
    )

    var jmp_val_strlen: int = code.len()

    x86.emit_jmp_rel32(
        code,
        0,
    )
    patch_rel32(
        code,
        jmp_val_strlen + 1,
        val_strlen,
    )

    var val_done: int = code.len()

    patch_rel32(
        code,
        jz_val_done,
        val_done,
    )
    // rbx = value length, r15 = value ptr
    // Create string header for value
    x86.emit_push_reg(
        code,
        x86.R15,
    )
    x86.emit_push_reg(
        code,
        x86.RBX,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        16,
    )

    var call_val_hdr: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_val_hdr + 1,
        "__rt_alloc",
    )
    x86.emit_pop_reg(
        code,
        x86.RBX,
    )
    x86.emit_pop_reg(
        code,
        x86.R15,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.R15,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.RBX,
    )
    // Create Option<string> = Some(value)
    // Layout: {tag: 1, value: string_ptr}
    x86.emit_push_reg(
        code,
        x86.RAX,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        16,
    )

    var call_option: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_option + 1,
        "__rt_alloc",
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.R8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        1,
    )
    // Some
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.RCX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.R8,
    )

    var jmp_end: int = emit_jmp_placeholder(code)
    var next_env: int = code.len()

    patch_rel32(
        code,
        jne_next_env,
        next_env,
    )
    patch_rel32(
        code,
        jne_next_env2,
        next_env,
    )
    // Move to next env
    x86.emit_add_reg_imm8(
        code,
        x86.R9,
        8,
    )

    var jmp_env_loop: int = code.len()

    x86.emit_jmp_rel32(
        code,
        0,
    )
    patch_rel32(
        code,
        jmp_env_loop + 1,
        env_loop,
    )

    var not_found: int = code.len()

    patch_rel32(
        code,
        jz_not_found,
        not_found,
    )
    // Return None
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        16,
    )

    var call_none: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_none + 1,
        "__rt_alloc",
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )
    // None
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.RCX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.RCX,
    )

    var end: int = code.len()

    patch_rel32(
        code,
        jmp_end,
        end,
    )

    return Ok(void)
}

// ============================================================================
// Native File System Functions (fs.*)
// ============================================================================
// Convert string header in RAX to a NUL-terminated C path.
// Returns pointer in RDI (and RAX).
func emit_cstring_ptr_from_string_header(
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (void) {
    // Preserve source string header across allocator call.
    x86.emit_sub_rsp_imm8(
        code,
        16,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RSP,
        0,
        x86.RAX,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RDI,
        x86.RAX,
        8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        1,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RDI,
        x86.RCX,
    )

    var call_alloc: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_alloc + 1,
        "__rt_alloc",
    )
    x86.emit_mov_reg_reg(
        code,
        x86.R11,
        x86.RAX,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R8,
        x86.RSP,
        0,
    )
    x86.emit_add_rsp_imm8(
        code,
        16,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RSI,
        x86.R8,
        0,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RCX,
        x86.R8,
        8,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.R11,
    )
    x86.emit_rep_movsb(code)
    x86.emit_mov_reg_imm32(
        code,
        x86.R10,
        0,
    )
    x86.emit_mov_mem_base_disp_reg8(
        code,
        x86.RDI,
        0,
        x86.R10,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RAX,
        x86.R11,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.R11,
    )

    return
}

// emit_fs_exists checks if a path exists using stat syscall.
// Returns bool: 1 if exists, 0 if not.
func emit_fs_exists(
    path: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // Evaluate path (string header ptr in RAX)
    var res: Result<void, string> = emit_expr(
        path,
        state,
        code,
    )

    switch res {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    emit_cstring_ptr_from_string_header(
        state,
        code,
    )
    // Allocate stat buffer on stack (144 bytes, 16-byte aligned = 160)
    x86.emit_sub_rsp_imm8(
        code,
        160,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RSI,
        x86.RSP,
    )
    // syscall stat(path, statbuf)
    x86.emit_mov_rax_imm32(
        code,
        4,
    )
    emit_raw_syscall(code)
    // Restore stack
    x86.emit_add_rsp_imm8(
        code,
        160,
    )
    // rax >= 0 means success (exists)
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.RAX,
        x86.RCX,
    )
    x86.emit_setge(code)
    x86.emit_movzx_rax_al(code)

    return Ok(void)
}

// emit_fs_is_file checks if path is a regular file.
// S_ISREG: (mode & 0xF000) == 0x8000
func emit_fs_is_file(
    path: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var res: Result<void, string> = emit_expr(
        path,
        state,
        code,
    )

    switch res {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    emit_cstring_ptr_from_string_header(
        state,
        code,
    )
    x86.emit_sub_rsp_imm8(
        code,
        160,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RSI,
        x86.RSP,
    )
    x86.emit_mov_rax_imm32(
        code,
        4,
    )
    emit_raw_syscall(code)
    // Check if stat succeeded
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.RAX,
        x86.RCX,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_fail: int = emit_jnz_placeholder(code)

    // Load st_mode from offset 24 (u32)
    x86.emit_mov_reg_mem_base_disp32(
        code,
        x86.RAX,
        x86.RSP,
        24,
    )
    x86.emit_and_reg_imm32(
        code,
        x86.RAX,
        0xF000,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0x8000,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.RAX,
        x86.RCX,
    )
    x86.emit_sete(code)
    x86.emit_movzx_rax_al(code)

    var jmp_done: int = emit_jmp_placeholder(code)
    var fail_pos: int = code.len()

    patch_rel32(
        code,
        jnz_fail,
        fail_pos,
    )
    x86.emit_mov_rax_imm32(
        code,
        0,
    )

    var done: int = code.len()

    patch_rel32(
        code,
        jmp_done,
        done,
    )
    x86.emit_add_rsp_imm8(
        code,
        160,
    )

    return Ok(void)
}

// emit_fs_is_dir checks if path is a directory.
// S_ISDIR: (mode & 0xF000) == 0x4000
func emit_fs_is_dir(
    path: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var res: Result<void, string> = emit_expr(
        path,
        state,
        code,
    )

    switch res {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    emit_cstring_ptr_from_string_header(
        state,
        code,
    )
    x86.emit_sub_rsp_imm8(
        code,
        160,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RSI,
        x86.RSP,
    )
    x86.emit_mov_rax_imm32(
        code,
        4,
    )
    emit_raw_syscall(code)
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.RAX,
        x86.RCX,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_fail: int = emit_jnz_placeholder(code)

    x86.emit_mov_reg_mem_base_disp32(
        code,
        x86.RAX,
        x86.RSP,
        24,
    )
    x86.emit_and_reg_imm32(
        code,
        x86.RAX,
        0xF000,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0x4000,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.RAX,
        x86.RCX,
    )
    x86.emit_sete(code)
    x86.emit_movzx_rax_al(code)

    var jmp_done: int = emit_jmp_placeholder(code)
    var fail_pos: int = code.len()

    patch_rel32(
        code,
        jnz_fail,
        fail_pos,
    )
    x86.emit_mov_rax_imm32(
        code,
        0,
    )

    var done: int = code.len()

    patch_rel32(
        code,
        jmp_done,
        done,
    )
    x86.emit_add_rsp_imm8(
        code,
        160,
    )

    return Ok(void)
}

// emit_fs_read_file reads entire file as string.
// Returns Result<string, string>: {tag, value/error_str}
func emit_fs_read_file(
    path: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // Evaluate path string header
    var res: Result<void, string> = emit_expr(
        path,
        state,
        code,
    )

    switch res {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    // Save path header ptr
    x86.emit_push_reg(
        code,
        x86.RAX,
    )
    emit_cstring_ptr_from_string_header(
        state,
        code,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.R10,
        x86.RDI,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    // Allocate stat buffer
    x86.emit_sub_rsp_imm8(
        code,
        160,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RSI,
        x86.RSP,
    )
    // stat(path, buf)
    x86.emit_mov_rax_imm32(
        code,
        4,
    )
    emit_raw_syscall(code)
    // Check stat result
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.RAX,
        x86.RCX,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_err_stat: int = emit_jnz_placeholder(code)

    // Get file size from st_size (offset 48)
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R12,
        x86.RSP,
        48,
    )
    // Restore stack (stat buffer)
    x86.emit_add_rsp_imm8(
        code,
        160,
    )
    // Open file: open(path, O_RDONLY=0, 0)
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.RAX,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.R10,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RSI,
        0,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDX,
        0,
    )
    x86.emit_mov_rax_imm32(
        code,
        2,
    )
    emit_raw_syscall(code)
    x86.emit_mov_reg_reg(
        code,
        x86.R10,
        x86.RAX,
    )
    // Check open result
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.RAX,
        x86.RCX,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_err_open: int = emit_jnz_placeholder(code)

    // Save fd and size across allocator call.
    x86.emit_push_reg(
        code,
        x86.R10,
    )
    x86.emit_push_reg(
        code,
        x86.R12,
    )
    // Allocate buffer for file content
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.R12,
    )

    var call_alloc: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_alloc + 1,
        "__rt_alloc",
    )
    x86.emit_pop_reg(
        code,
        x86.R12,
    )
    x86.emit_pop_reg(
        code,
        x86.RDI,
    )
    // rax = buffer ptr
    x86.emit_mov_reg_reg(
        code,
        x86.RSI,
        x86.RAX,
    )
    // Read file: read(fd, buf, size)
    x86.emit_mov_reg_reg(
        code,
        x86.RDX,
        x86.R12,
    )
    x86.emit_mov_rax_imm32(
        code,
        0,
    )
    emit_raw_syscall(code)
    // Save bytes read across close syscall.
    x86.emit_push_reg(
        code,
        x86.RAX,
    )
    // Close file: close(fd)
    x86.emit_mov_rax_imm32(
        code,
        3,
    )
    emit_raw_syscall(code)
    x86.emit_pop_reg(
        code,
        x86.RCX,
    )
    // Create string header {ptr, len}
    x86.emit_push_reg(
        code,
        x86.RSI,
    )
    x86.emit_push_reg(
        code,
        x86.RCX,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        16,
    )

    var call_str_hdr: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_str_hdr + 1,
        "__rt_alloc",
    )
    x86.emit_pop_reg(
        code,
        x86.RCX,
    )
    x86.emit_pop_reg(
        code,
        x86.RSI,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.RSI,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.RCX,
    )
    // Create Result<string, string> = Ok(str_header)
    // Layout: {tag: 1 (Ok), value: string_ptr, error: 0}
    x86.emit_push_reg(
        code,
        x86.RAX,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        24,
    )

    var call_result: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_result + 1,
        "__rt_alloc",
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.R8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        1,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.RCX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.R8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        16,
        x86.RCX,
    )

    var jmp_done: int = emit_jmp_placeholder(code)
    var err_stat_pos: int = code.len()

    patch_rel32(
        code,
        jnz_err_stat,
        err_stat_pos,
    )
    // Clean up stat buffer
    x86.emit_add_rsp_imm8(
        code,
        160,
    )
    x86.emit_add_rsp_imm8(
        code,
        16,
    )

    var err_open_pos: int = code.len()

    patch_rel32(
        code,
        jnz_err_open,
        err_open_pos,
    )

    // Return Err("file not found")
    var err_msg: string = "file not found"
    var litRes: Result<void, string> = emit_string_literal(
        &err_msg,
        state,
        code,
    )

    switch litRes {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_push_reg(
        code,
        x86.RAX,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        24,
    )

    var call_err_result: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_err_result + 1,
        "__rt_alloc",
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.R8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.RCX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.RCX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        16,
        x86.R8,
    )

    var done: int = code.len()

    patch_rel32(
        code,
        jmp_done,
        done,
    )

    return Ok(void)
}

// emit_fs_read_file_bytes reads file as Vec<int> of bytes.
func emit_fs_read_file_bytes(
    path: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // Read as string, then convert Ok value to Vec<int> (bytes).
    var readRes: Result<void, string> = emit_fs_read_file(
        path,
        state,
        code,
    )

    switch readRes {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    // rax = Result<string, string> ptr
    x86.emit_mov_reg_reg(
        code,
        x86.R12,
        x86.RAX,
    )
    // Check tag == 1 (Ok)
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R8,
        x86.R12,
        0,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        1,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R8,
        x86.RCX,
    )

    var jnz_done: int = emit_jnz_placeholder(code)

    // Load string header ptr from Result
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RAX,
        x86.R12,
        8,
    )
    // Convert string -> Vec<int>
    x86.emit_mov_reg_reg(
        code,
        x86.R8,
        x86.RAX,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R9,
        x86.R8,
        0,
    )
    // str ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R10,
        x86.R8,
        8,
    )
    // len
    // Allocate data: len * 8
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.R10,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RDI,
        x86.RDI,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RDI,
        x86.RDI,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RDI,
        x86.RDI,
    )

    var call_data: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_data + 1,
        "__rt_alloc",
    )
    x86.emit_mov_reg_reg(
        code,
        x86.R11,
        x86.RAX,
    )
    // data ptr
    // i = 0
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )

    var loop_start: int = code.len()

    x86.emit_cmp_reg_reg(
        code,
        x86.RCX,
        x86.R10,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_loop_done: int = emit_jz_placeholder(code)

    // load byte -> r8
    x86.emit_movzx_reg_mem_base_index(
        code,
        x86.R8,
        x86.R9,
        x86.RCX,
        1,
    )
    // store into data_ptr[i] (as 64-bit int)
    x86.emit_mov_mem_base_index_reg(
        code,
        x86.R11,
        x86.RCX,
        8,
        x86.R8,
    )
    // i++
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        1,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RCX,
        x86.RAX,
    )
    emit_jmp_to(
        code,
        loop_start,
    )

    var loop_end: int = code.len()

    patch_rel32(
        code,
        jz_loop_done,
        loop_end,
    )
    // Allocate Vec header {ptr,len,cap}
    x86.emit_push_reg(
        code,
        x86.R11,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        24,
    )

    var call_hdr: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_hdr + 1,
        "__rt_alloc",
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.R11,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.R11,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.R10,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        16,
        x86.R10,
    )
    // Store Vec header into Result value
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.R12,
        8,
        x86.RAX,
    )

    var done_pos: int = code.len()

    patch_rel32(
        code,
        jnz_done,
        done_pos,
    )
    // Return Result pointer
    x86.emit_mov_reg_reg(
        code,
        x86.RAX,
        x86.R12,
    )

    return Ok(void)
}

// emit_fs_write_file writes string content to file.
func emit_fs_write_file(
    path: &ast.Expression,
    content: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // Evaluate path
    var pathRes: Result<void, string> = emit_expr(
        path,
        state,
        code,
    )

    switch pathRes {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_push_reg(
        code,
        x86.RAX,
    )

    // Evaluate content
    var contentRes: Result<void, string> = emit_expr(
        content,
        state,
        code,
    )

    switch contentRes {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_push_reg(
        code,
        x86.RAX,
    )
    // Pop content header, path header
    x86.emit_pop_reg(
        code,
        x86.R8,
    )
    // content header
    x86.emit_pop_reg(
        code,
        x86.R9,
    )
    // path header
    x86.emit_mov_reg_reg(
        code,
        x86.R12,
        x86.R8,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RAX,
        x86.R9,
    )
    emit_cstring_ptr_from_string_header(
        state,
        code,
    )
    // Open file: open(path, O_WRONLY|O_CREAT|O_TRUNC, 0644)
    // O_WRONLY=1, O_CREAT=0x40, O_TRUNC=0x200 => 0x241
    x86.emit_mov_reg_imm32(
        code,
        x86.RSI,
        0x241,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDX,
        0x1a4,
    )
    // 0644 octal = 420 decimal = 0x1a4
    x86.emit_push_reg(
        code,
        x86.R12,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_rax_imm32(
        code,
        2,
    )
    emit_raw_syscall(code)
    x86.emit_mov_reg_reg(
        code,
        x86.R10,
        x86.RAX,
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.R12,
    )
    // Check open result
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.RAX,
        x86.RCX,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_err: int = emit_jnz_placeholder(code)

    // Save fd
    x86.emit_mov_reg_reg(
        code,
        x86.R9,
        x86.R10,
    )
    // Write content: write(fd, ptr, len)
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.R9,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RSI,
        x86.R12,
        0,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RDX,
        x86.R12,
        8,
    )
    x86.emit_mov_rax_imm32(
        code,
        1,
    )
    emit_raw_syscall(code)
    // Close file
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.R9,
    )
    x86.emit_mov_rax_imm32(
        code,
        3,
    )
    emit_raw_syscall(code)
    // Return Ok(void) - allocate Result with tag=1
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        24,
    )

    var call_ok: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_ok + 1,
        "__rt_alloc",
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        1,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.RCX,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.RCX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        16,
        x86.RCX,
    )

    var jmp_done: int = emit_jmp_placeholder(code)
    var err_pos: int = code.len()

    patch_rel32(
        code,
        jnz_err,
        err_pos,
    )

    // Return Err("failed to write file")
    var err_msg: string = "failed to write file"
    var litRes: Result<void, string> = emit_string_literal(
        &err_msg,
        state,
        code,
    )

    switch litRes {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_push_reg(
        code,
        x86.RAX,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        24,
    )

    var call_err: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_err + 1,
        "__rt_alloc",
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.R8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.RCX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.RCX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        16,
        x86.R8,
    )

    var done: int = code.len()

    patch_rel32(
        code,
        jmp_done,
        done,
    )

    return Ok(void)
}

// emit_fs_write_file_bytes writes Vec<int> as bytes to file.
func emit_fs_write_file_bytes(
    path: &ast.Expression,
    bytes: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // Evaluate path
    var pathRes: Result<void, string> = emit_expr(
        path,
        state,
        code,
    )

    switch pathRes {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_push_reg(
        code,
        x86.RAX,
    )

    // Evaluate bytes vec
    var bytesRes: Result<void, string> = emit_expr(
        bytes,
        state,
        code,
    )

    switch bytesRes {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    // Convert Vec<int> -> string (raw bytes)
    // rax = vec header
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R9,
        x86.RAX,
        0,
    )
    // data ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R10,
        x86.RAX,
        8,
    )
    // len
    // Allocate byte buffer len
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.R10,
    )

    var call_buf: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_buf + 1,
        "__rt_alloc",
    )
    x86.emit_mov_reg_reg(
        code,
        x86.R11,
        x86.RAX,
    )
    // buf
    // i = 0
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )

    var loop_start: int = code.len()

    x86.emit_cmp_reg_reg(
        code,
        x86.RCX,
        x86.R10,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_done: int = emit_jz_placeholder(code)

    // load int element -> r8
    x86.emit_mov_reg_mem_base_index(
        code,
        x86.R8,
        x86.R9,
        x86.RCX,
        8,
    )
    // store byte into buf[i]
    x86.emit_mov_mem_base_index_reg8(
        code,
        x86.R11,
        x86.RCX,
        1,
        x86.R8,
    )
    // i++
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        1,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RCX,
        x86.RAX,
    )
    emit_jmp_to(
        code,
        loop_start,
    )

    var loop_end: int = code.len()

    patch_rel32(
        code,
        jz_done,
        loop_end,
    )
    // Allocate string header {ptr,len}
    x86.emit_push_reg(
        code,
        x86.R11,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        16,
    )

    var call_hdr: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_hdr + 1,
        "__rt_alloc",
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.R11,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.R11,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.R10,
    )
    // rax = string header
    x86.emit_mov_reg_reg(
        code,
        x86.R8,
        x86.RAX,
    )
    // Pop path header
    x86.emit_pop_reg(
        code,
        x86.R9,
    )
    // path header
    // Get raw path ptr
    x86.emit_mov_reg_reg(
        code,
        x86.R12,
        x86.R8,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RAX,
        x86.R9,
    )
    emit_cstring_ptr_from_string_header(
        state,
        code,
    )
    // Open file: open(path, O_WRONLY|O_CREAT|O_TRUNC, 0644)
    // O_WRONLY=1, O_CREAT=0x40, O_TRUNC=0x200 => 0x241
    x86.emit_mov_reg_imm32(
        code,
        x86.RSI,
        0x241,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDX,
        0x1a4,
    )
    // 0644 octal = 420 decimal = 0x1a4
    x86.emit_push_reg(
        code,
        x86.R12,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_rax_imm32(
        code,
        2,
    )
    emit_raw_syscall(code)
    x86.emit_mov_reg_reg(
        code,
        x86.R10,
        x86.RAX,
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.R12,
    )
    // Check open result
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.RAX,
        x86.RCX,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_err: int = emit_jnz_placeholder(code)

    // Save fd
    x86.emit_mov_reg_reg(
        code,
        x86.R9,
        x86.R10,
    )
    // Write content: write(fd, ptr, len)
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.R9,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RSI,
        x86.R12,
        0,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RDX,
        x86.R12,
        8,
    )
    x86.emit_mov_rax_imm32(
        code,
        1,
    )
    emit_raw_syscall(code)
    // Close file
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.R9,
    )
    x86.emit_mov_rax_imm32(
        code,
        3,
    )
    emit_raw_syscall(code)
    // Return Ok(void) - allocate Result with tag=1
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        24,
    )

    var call_ok: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_ok + 1,
        "__rt_alloc",
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        1,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.RCX,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.RCX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        16,
        x86.RCX,
    )

    var jmp_done: int = emit_jmp_placeholder(code)
    var err_pos: int = code.len()

    patch_rel32(
        code,
        jnz_err,
        err_pos,
    )

    // Return Err("failed to write file")
    var err_msg: string = "failed to write file"
    var litRes: Result<void, string> = emit_string_literal(
        &err_msg,
        state,
        code,
    )

    switch litRes {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_push_reg(
        code,
        x86.RAX,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        24,
    )

    var call_err: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_err + 1,
        "__rt_alloc",
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.R8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.RCX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.RCX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        16,
        x86.R8,
    )

    var done: int = code.len()

    patch_rel32(
        code,
        jmp_done,
        done,
    )

    return Ok(void)
}

// emit_fs_read_dir lists directory contents.
func emit_fs_read_dir(
    path: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // Bootstrap-safe fallback: avoid the complex native read_dir lowering path,
    // which is still unstable in self-host stage2.
    var pathRes: Result<void, string> = emit_expr(
        path,
        state,
        code,
    )

    switch pathRes {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    var msg: string = "read_dir not supported in bootstrap"

    return emit_result_err_string_literal(
        &msg,
        state,
        code,
    )

    // Resolve DirEntry layout
    var declOpt: Option<ast.StructDecl> = find_struct_decl(
        &state.structs,
        &"fs.DirEntry",
    )
    mut var name_off: int = 0
    mut var isdir_off: int = 0
    mut var struct_size: int = 0

    switch declOpt {
        case None {
            return Err("native: fs.DirEntry not found")
        }
        case Some(decl) {
            var layoutRes: Result<layout.StructLayout, string> = layout.struct_layout(
                &decl,
                &state.structs,
            )

            switch layoutRes {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(st_layout) {
                    struct_size = st_layout.size

                    var nameOpt: Option<layout.FieldLayout> = find_field_layout(
                        &st_layout,
                        &"name",
                    )
                    var dirOpt: Option<layout.FieldLayout> = find_field_layout(
                        &st_layout,
                        &"isDir",
                    )

                    switch nameOpt {
                        case None {
                            return Err("native: fs.DirEntry missing field name")
                        }
                        case Some(fl) {
                            name_off = fl.offset
                        }
                    }

                    switch dirOpt {
                        case None {
                            return Err("native: fs.DirEntry missing field isDir")
                        }
                        case Some(fl2) {
                            isdir_off = fl2.offset
                        }
                    }
                }
            }
        }
    }

    // Evaluate path
    var res: Result<void, string> = emit_expr(
        path,
        state,
        code,
    )

    switch res {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    // Save path header ptr
    x86.emit_mov_reg_reg(
        code,
        x86.R12,
        x86.RAX,
    )
    // Open directory: open(path, O_RDONLY|O_DIRECTORY, 0)
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RDI,
        x86.R12,
        0,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RSI,
        0x10000,
    )
    // O_DIRECTORY
    x86.emit_mov_reg_imm32(
        code,
        x86.RDX,
        0,
    )
    x86.emit_mov_rax_imm32(
        code,
        2,
    )
    emit_raw_syscall(code)
    // Check open result
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.RAX,
        x86.RCX,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_open_err: int = emit_jnz_placeholder(code)

    // Save fd
    x86.emit_mov_reg_reg(
        code,
        x86.R13,
        x86.RAX,
    )
    // Allocate buffer for getdents64
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        4096,
    )

    var call_buf: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_buf + 1,
        "__rt_alloc",
    )
    x86.emit_mov_reg_reg(
        code,
        x86.R14,
        x86.RAX,
    )

    // buf ptr
    // Create empty Vec<DirEntry>
    var vecRes: Result<void, string> = emit_vec_new(
        state,
        code,
    )

    switch vecRes {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_mov_reg_reg(
        code,
        x86.R12,
        x86.RAX,
    )

    // vec header
    var loop_sys: int = code.len()

    // getdents64(fd, buf, 4096)
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.R13,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RSI,
        x86.R14,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDX,
        4096,
    )
    x86.emit_mov_rax_imm32(
        code,
        217,
    )
    emit_raw_syscall(code)
    // rax = bytes read
    x86.emit_mov_reg_reg(
        code,
        x86.R15,
        x86.RAX,
    )
    // if rax < 0 -> error
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R15,
        x86.RCX,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_read_err: int = emit_jnz_placeholder(code)

    // if rax == 0 -> done
    x86.emit_cmp_reg_reg(
        code,
        x86.R15,
        x86.RCX,
    )

    var jz_done: int = emit_jz_placeholder(code)

    // offset = 0 (rbx)
    x86.emit_mov_reg_imm32(
        code,
        x86.RBX,
        0,
    )

    var entry_loop: int = code.len()

    // if offset >= bytes_read -> next getdents
    x86.emit_cmp_reg_reg(
        code,
        x86.RBX,
        x86.R15,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_entries_done: int = emit_jz_placeholder(code)

    // record_ptr = buf + offset
    x86.emit_mov_reg_reg(
        code,
        x86.R9,
        x86.R14,
    )
    x86.emit_add_reg_reg(
        code,
        x86.R9,
        x86.RBX,
    )
    // d_reclen (u16) at +16
    x86.emit_mov_reg_mem_base_disp32(
        code,
        x86.R10,
        x86.R9,
        16,
    )
    x86.emit_and_reg_imm32(
        code,
        x86.R10,
        0xFFFF,
    )
    // d_type (u8) at +18
    x86.emit_movzx_reg_mem_base_disp(
        code,
        x86.R11,
        x86.R9,
        18,
    )
    // name_ptr = record_ptr + 19
    x86.emit_mov_reg_reg(
        code,
        x86.RDX,
        x86.R9,
    )
    x86.emit_add_reg_imm8(
        code,
        x86.RDX,
        19,
    )
    // name length
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )

    var name_loop: int = code.len()

    x86.emit_movzx_reg_mem_base_index(
        code,
        x86.RAX,
        x86.RDX,
        x86.RCX,
        1,
    )
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_name_done: int = emit_jz_placeholder(code)

    x86.emit_add_reg_imm8(
        code,
        x86.RCX,
        1,
    )
    emit_jmp_to(
        code,
        name_loop,
    )

    var name_done: int = code.len()

    patch_rel32(
        code,
        jz_name_done,
        name_done,
    )
    // len in rcx, save in r8
    x86.emit_mov_reg_reg(
        code,
        x86.R8,
        x86.RCX,
    )
    // save name_ptr, reclen, d_type
    x86.emit_push_reg(
        code,
        x86.RDX,
    )
    x86.emit_push_reg(
        code,
        x86.R10,
    )
    x86.emit_push_reg(
        code,
        x86.R11,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.R8,
    )

    var call_name_buf: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_name_buf + 1,
        "__rt_alloc",
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.R11,
    )
    x86.emit_pop_reg(
        code,
        x86.R10,
    )
    x86.emit_pop_reg(
        code,
        x86.RDX,
    )
    // r8=len, rax=buf
    x86.emit_mov_reg_reg(
        code,
        x86.R9,
        x86.R8,
    )
    // len
    x86.emit_mov_reg_reg(
        code,
        x86.R8,
        x86.RAX,
    )
    // buf
    // copy name bytes
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.R8,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RSI,
        x86.RDX,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RCX,
        x86.R9,
    )
    x86.emit_rep_movsb(code)

    // create string header from buf/len
    var strRes: Result<void, string> = emit_string_header_from_regs(
        x86.R8,
        x86.R9,
        state,
        code,
    )

    switch strRes {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    // rax = string header
    x86.emit_mov_reg_reg(
        code,
        x86.R9,
        x86.RAX,
    )
    // name header
    // isDir = (d_type == 4)
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        4,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R11,
        x86.RCX,
    )
    x86.emit_sete(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_mov_reg_reg(
        code,
        x86.R8,
        x86.RAX,
    )
    // isDir bool
    // Allocate DirEntry struct
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        struct_size,
    )

    var call_struct: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_struct + 1,
        "__rt_alloc",
    )
    // store fields
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        name_off,
        x86.R9,
    )
    x86.emit_mov_mem_base_disp_reg8(
        code,
        x86.RAX,
        isdir_off,
        x86.R8,
    )
    // advance offset before pushing (reclen in r10)
    x86.emit_add_reg_reg(
        code,
        x86.RBX,
        x86.R10,
    )
    // push into vec
    x86.emit_mov_reg_reg(
        code,
        x86.RCX,
        x86.R12,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.R11,
        x86.RAX,
    )

    var pushRes: Result<void, string> = emit_vec_push_struct_from_regs(
        struct_size,
        state,
        code,
    )

    switch pushRes {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    emit_jmp_to(
        code,
        entry_loop,
    )

    var entries_done: int = code.len()

    patch_rel32(
        code,
        jz_entries_done,
        entries_done,
    )
    emit_jmp_to(
        code,
        loop_sys,
    )

    var done_pos: int = code.len()

    patch_rel32(
        code,
        jz_done,
        done_pos,
    )
    // close fd
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.R13,
    )
    x86.emit_mov_rax_imm32(
        code,
        3,
    )
    emit_raw_syscall(code)
    // Return Ok(vec)
    x86.emit_push_reg(
        code,
        x86.R12,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        24,
    )

    var call_ok: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_ok + 1,
        "__rt_alloc",
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.R8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        1,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.RCX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.R8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        16,
        x86.RCX,
    )

    var jmp_done: int = emit_jmp_placeholder(code)
    // read error path (close fd)
    var read_err_pos: int = code.len()

    patch_rel32(
        code,
        jnz_read_err,
        read_err_pos,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.R13,
    )
    x86.emit_mov_rax_imm32(
        code,
        3,
    )
    emit_raw_syscall(code)

    // open error path (and after read_err close)
    var open_err_pos: int = code.len()

    patch_rel32(
        code,
        jnz_open_err,
        open_err_pos,
    )

    var err_msg: string = "failed to read dir"
    var errRes: Result<void, string> = emit_result_err_string_literal(
        &err_msg,
        state,
        code,
    )

    switch errRes {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    var done: int = code.len()

    patch_rel32(
        code,
        jmp_done,
        done,
    )

    return Ok(void)
}

func emit_result_ok_int_from_reg(
    value_reg: int,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    x86.emit_mov_reg_reg(
        code,
        x86.R8,
        value_reg,
    )
    x86.emit_push_reg(
        code,
        x86.R8,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        24,
    )

    var call_site: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_site + 1,
        "__rt_alloc",
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.R8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        1,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.RCX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.R8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        16,
        x86.RCX,
    )

    return Ok(void)
}

func emit_result_err_string_literal(
    msg: &string,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var res: Result<void, string> = emit_string_literal(
        msg,
        state,
        code,
    )

    switch res {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    x86.emit_mov_reg_reg(
        code,
        x86.R8,
        x86.RAX,
    )
    x86.emit_push_reg(
        code,
        x86.R8,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        24,
    )

    var call_site: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_site + 1,
        "__rt_alloc",
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.R8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.RCX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.RCX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        16,
        x86.R8,
    )

    return Ok(void)
}

func emit_strconv_format_int(
    n: &ast.Expression,
    base: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var resN: Result<void, string> = emit_expr(
        n,
        state,
        code,
    )

    switch resN {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    x86.emit_push_reg(
        code,
        x86.RAX,
    )

    var resB: Result<void, string> = emit_expr(
        base,
        state,
        code,
    )

    switch resB {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    x86.emit_pop_reg(
        code,
        x86.RAX,
    )

    return emit_int_to_string_from_reg(
        x86.RAX,
        state,
        code,
    )
}

func emit_strconv_format_int_const(
    n: &ast.Expression,
    _base: int,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var resN: Result<void, string> = emit_expr(
        n,
        state,
        code,
    )

    switch resN {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    return emit_int_to_string_from_reg(
        x86.RAX,
        state,
        code,
    )
}

func emit_strconv_parse_int_body(
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // Inputs: rax = string header, r8 = base
    x86.emit_mov_reg_reg(
        code,
        x86.R15,
        x86.RAX,
    )
    // save header (base checks clobber rax)
    // base check
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        2,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R8,
        x86.RCX,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_invalid1: int = emit_jnz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        36,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R8,
        x86.RCX,
    )
    x86.emit_setg(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_invalid2: int = emit_jnz_placeholder(code)

    // load ptr/len
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R9,
        x86.R15,
        0,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R10,
        x86.R15,
        8,
    )
    x86.emit_test_reg_reg(
        code,
        x86.R10,
        x86.R10,
    )

    var jz_invalid3: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.R11,
        0,
    )
    // idx
    x86.emit_mov_reg_imm32(
        code,
        x86.R12,
        0,
    )
    // result
    x86.emit_mov_reg_imm32(
        code,
        x86.R13,
        0,
    )
    // negative
    // sign check
    x86.emit_movzx_reg_mem_base_index(
        code,
        x86.R14,
        x86.R9,
        x86.R11,
        1,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        45,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R14,
        x86.RCX,
    )

    var jz_neg: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        43,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R14,
        x86.RCX,
    )

    var jz_pos: int = emit_jz_placeholder(code)
    var jmp_after_sign_default: int = emit_jmp_placeholder(code)
    var neg_pos: int = code.len()

    patch_rel32(
        code,
        jz_neg,
        neg_pos,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.R13,
        1,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.R11,
        1,
    )

    var jmp_after_sign_neg: int = emit_jmp_placeholder(code)
    var pos_pos: int = code.len()

    patch_rel32(
        code,
        jz_pos,
        pos_pos,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.R11,
        1,
    )

    var after_sign_pos: int = code.len()

    patch_rel32(
        code,
        jmp_after_sign_default,
        after_sign_pos,
    )
    patch_rel32(
        code,
        jmp_after_sign_neg,
        after_sign_pos,
    )
    // if idx >= len -> invalid
    x86.emit_cmp_reg_reg(
        code,
        x86.R11,
        x86.R10,
    )
    x86.emit_setge(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_invalid4: int = emit_jnz_placeholder(code)
    var loop_start: int = code.len()

    x86.emit_cmp_reg_reg(
        code,
        x86.R11,
        x86.R10,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_loop_end: int = emit_jz_placeholder(code)

    x86.emit_movzx_reg_mem_base_index(
        code,
        x86.R14,
        x86.R9,
        x86.R11,
        1,
    )
    // digit in r15
    // '0'..'9'
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        48,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R14,
        x86.RCX,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_check_lower: int = emit_jnz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        57,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R14,
        x86.RCX,
    )
    x86.emit_setg(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_check_lower2: int = emit_jnz_placeholder(code)

    x86.emit_mov_reg_reg(
        code,
        x86.R15,
        x86.R14,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        48,
    )
    x86.emit_sub_reg_reg(
        code,
        x86.R15,
        x86.RCX,
    )

    var jmp_digit_ok: int = emit_jmp_placeholder(code)
    var check_lower: int = code.len()

    patch_rel32(
        code,
        jnz_check_lower,
        check_lower,
    )
    patch_rel32(
        code,
        jnz_check_lower2,
        check_lower,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        97,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R14,
        x86.RCX,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_check_upper: int = emit_jnz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        122,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R14,
        x86.RCX,
    )
    x86.emit_setg(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_check_upper2: int = emit_jnz_placeholder(code)

    x86.emit_mov_reg_reg(
        code,
        x86.R15,
        x86.R14,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        97,
    )
    x86.emit_sub_reg_reg(
        code,
        x86.R15,
        x86.RCX,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        10,
    )
    x86.emit_add_reg_reg(
        code,
        x86.R15,
        x86.RCX,
    )

    var jmp_digit_ok2: int = emit_jmp_placeholder(code)
    var check_upper: int = code.len()

    patch_rel32(
        code,
        jnz_check_upper,
        check_upper,
    )
    patch_rel32(
        code,
        jnz_check_upper2,
        check_upper,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        65,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R14,
        x86.RCX,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_invalid5: int = emit_jnz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        90,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.R14,
        x86.RCX,
    )
    x86.emit_setg(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_invalid6: int = emit_jnz_placeholder(code)

    x86.emit_mov_reg_reg(
        code,
        x86.R15,
        x86.R14,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        65,
    )
    x86.emit_sub_reg_reg(
        code,
        x86.R15,
        x86.RCX,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        10,
    )
    x86.emit_add_reg_reg(
        code,
        x86.R15,
        x86.RCX,
    )

    var digit_ok: int = code.len()

    patch_rel32(
        code,
        jmp_digit_ok,
        digit_ok,
    )
    patch_rel32(
        code,
        jmp_digit_ok2,
        digit_ok,
    )
    // digit >= base -> invalid
    x86.emit_cmp_reg_reg(
        code,
        x86.R15,
        x86.R8,
    )
    x86.emit_setge(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_invalid7: int = emit_jnz_placeholder(code)

    // result = result*base + digit
    x86.emit_imul_reg_reg(
        code,
        x86.R12,
        x86.R8,
    )
    x86.emit_add_reg_reg(
        code,
        x86.R12,
        x86.R15,
    )
    // idx++
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        1,
    )
    x86.emit_add_reg_reg(
        code,
        x86.R11,
        x86.RCX,
    )
    emit_jmp_to(
        code,
        loop_start,
    )

    var loop_end: int = code.len()

    patch_rel32(
        code,
        jz_loop_end,
        loop_end,
    )
    // if negative -> negate result
    x86.emit_test_reg_reg(
        code,
        x86.R13,
        x86.R13,
    )

    var jz_nonneg: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_reg(
        code,
        x86.RAX,
        x86.R12,
    )
    x86.emit_neg_reg(
        code,
        x86.RAX,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.R12,
        x86.RAX,
    )

    var nonneg_pos: int = code.len()

    patch_rel32(
        code,
        jz_nonneg,
        nonneg_pos,
    )

    var okRes: Result<void, string> = emit_result_ok_int_from_reg(
        x86.R12,
        state,
        code,
    )

    switch okRes {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    var jmp_done: int = emit_jmp_placeholder(code)
    var invalid_start: int = code.len()

    patch_rel32(
        code,
        jnz_invalid1,
        invalid_start,
    )
    patch_rel32(
        code,
        jnz_invalid2,
        invalid_start,
    )
    patch_rel32(
        code,
        jz_invalid3,
        invalid_start,
    )
    patch_rel32(
        code,
        jnz_invalid4,
        invalid_start,
    )
    patch_rel32(
        code,
        jnz_invalid5,
        invalid_start,
    )
    patch_rel32(
        code,
        jnz_invalid6,
        invalid_start,
    )
    patch_rel32(
        code,
        jnz_invalid7,
        invalid_start,
    )

    var errRes: Result<void, string> = emit_result_err_string_literal(
        &"invalid",
        state,
        code,
    )

    switch errRes {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    var done: int = code.len()

    patch_rel32(
        code,
        jmp_done,
        done,
    )

    return Ok(void)
}

func emit_strconv_parse_int(
    s: &ast.Expression,
    base: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var resS: Result<void, string> = emit_expr(
        s,
        state,
        code,
    )

    switch resS {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    x86.emit_push_reg(
        code,
        x86.RAX,
    )

    var resB: Result<void, string> = emit_expr(
        base,
        state,
        code,
    )

    switch resB {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    x86.emit_mov_reg_reg(
        code,
        x86.R8,
        x86.RAX,
    )
    // base
    x86.emit_pop_reg(
        code,
        x86.RAX,
    )

    // string header
    return emit_strconv_parse_int_body(
        state,
        code,
    )
}

func emit_strconv_parse_int_const(
    s: &ast.Expression,
    base: int,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var resS: Result<void, string> = emit_expr(
        s,
        state,
        code,
    )

    switch resS {
        case Err(m) {
            return Err(m)
        }
        case Ok(_) {
        }
    }

    x86.emit_mov_reg_imm32(
        code,
        x86.R8,
        base,
    )

    return emit_strconv_parse_int_body(
        state,
        code,
    )
}

func emit_type_conversion(
    tc: &ast.TypeConversion,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // Fast path: int(char/bool) for locals - load a single byte.
    if tc.TypeName == "int" {
        switch tc.Value {
            case ast.Expression.Identifier(id) {
                var tOpt: Option<string> = resolve_local_type(
                    state,
                    &id.Value,
                )

                switch tOpt {
                    case Some(tname) {
                        if tname == "char" || tname == "bool" {
                            var offOpt: Option<int> = resolve_local(
                                state,
                                &id.Value,
                            )

                            switch offOpt {
                                case Some(off) {
                                    x86.emit_movzx_reg_mem_base_disp(
                                        code,
                                        x86.RAX,
                                        x86.RBP,
                                        off,
                                    )

                                    return Ok(void)
                                }
                                case None {
                                }
                            }
                        }
                    }
                    case None {
                    }
                }
            }
            case ast.Expression.MutableIdentifier(id) {
                var tOpt2: Option<string> = resolve_local_type(
                    state,
                    &id.Value,
                )

                switch tOpt2 {
                    case Some(tname2) {
                        if tname2 == "char" || tname2 == "bool" {
                            var offOpt2: Option<int> = resolve_local(
                                state,
                                &id.Value,
                            )

                            switch offOpt2 {
                                case Some(off2) {
                                    x86.emit_movzx_reg_mem_base_disp(
                                        code,
                                        x86.RAX,
                                        x86.RBP,
                                        off2,
                                    )

                                    return Ok(void)
                                }
                                case None {
                                }
                            }
                        }
                    }
                    case None {
                    }
                }
            }
            default {
            }
        }
    }

    var res: Result<void, string> = emit_expr(
        &tc.Value,
        state,
        code,
    )

    switch res {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    if tc.TypeName == "int" {
        if is_float_expr(
            &tc.Value,
            state,
        ) {
            emit_unscale_rax_float_to_int(code)
        }

        return Ok(void)
    }

    if tc.TypeName == "char" || tc.TypeName == "bool" {
        return Ok(void)
    }

    if tc.TypeName == "float" || tc.TypeName == "float32" || tc.TypeName == "float64" {
        if !is_float_expr(
            &tc.Value,
            state,
        ) {
            emit_scale_reg_for_float(
                code,
                x86.RAX,
            )
        }

        return Ok(void)
    }

    if tc.TypeName == "string" {
        // Treat value as a byte/char and allocate a 1-byte string.
        x86.emit_mov_reg_reg(
            code,
            x86.R8,
            x86.RAX,
        )
        // value
        x86.emit_mov_reg_imm32(
            code,
            x86.RDI,
            1,
        )

        var call_buf: int = code.len()

        x86.emit_call_rel32(
            code,
            0,
        )
        add_call_patch(
            state,
            call_buf + 1,
            "__rt_alloc",
        )
        x86.emit_mov_reg_reg(
            code,
            x86.R9,
            x86.RAX,
        )
        // buf
        x86.emit_mov_reg_imm32(
            code,
            x86.R10,
            0,
        )
        x86.emit_mov_mem_base_index_reg8(
            code,
            x86.R9,
            x86.R10,
            1,
            x86.R8,
        )
        x86.emit_push_reg(
            code,
            x86.R9,
        )
        x86.emit_mov_reg_imm32(
            code,
            x86.RDI,
            16,
        )

        var call_hdr: int = code.len()

        x86.emit_call_rel32(
            code,
            0,
        )
        add_call_patch(
            state,
            call_hdr + 1,
            "__rt_alloc",
        )
        x86.emit_pop_reg(
            code,
            x86.R9,
        )
        x86.emit_mov_mem_base_disp_reg(
            code,
            x86.RAX,
            0,
            x86.R9,
        )
        x86.emit_mov_reg_imm32(
            code,
            x86.RCX,
            1,
        )
        x86.emit_mov_mem_base_disp_reg(
            code,
            x86.RAX,
            8,
            x86.RCX,
        )

        return Ok(void)
    }

    return Err("native: unsupported type conversion " + tc.TypeName)
}

func emit_vec_push(
    obj: &ast.Expression,
    value: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var refRecv: bool = is_ref_expr(
        obj,
        state,
    )
    mut var helper_kind: int = ELEM_KIND_SCALAR
    var helperInfoRes: Result<IterableInfo, string> = vec_elem_info(
        obj,
        state,
    )

    switch helperInfoRes {
        case Ok(info) {
            helper_kind = info.kind
        }
        case Err(_) {
        }
    }

    var resObj: Result<void, string> = emit_expr(
        obj,
        state,
        code,
    )

    switch resObj {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    if refRecv {
        emit_safe_ref_deref_rax(code)
    }

    x86.emit_push_reg(
        code,
        x86.R12,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.R12,
        x86.RAX,
    )
    // Lazily materialize vec header when receiver pointer is null.
    x86.emit_test_reg_reg(
        code,
        x86.R12,
        x86.R12,
    )

    var jnz_vec_ready: int = emit_jnz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        24,
    )

    var call_site_header: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_site_header + 1,
        "__rt_alloc",
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.RCX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        8,
        x86.RCX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        16,
        x86.RCX,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.R12,
        x86.RAX,
    )

    if is_addressable_receiver_expr(obj) {
        x86.emit_push_reg(
            code,
            x86.R12,
        )

        var addrRes: Result<void, string> = emit_address_of(
            obj,
            state,
            code,
        )

        switch addrRes {
            case Ok(_) {
                x86.emit_pop_reg(
                    code,
                    x86.R12,
                )
                x86.emit_test_reg_reg(
                    code,
                    x86.RAX,
                    x86.RAX,
                )

                var jz_skip_store: int = emit_jz_placeholder(code)

                x86.emit_mov_mem_base_disp_reg(
                    code,
                    x86.RAX,
                    0,
                    x86.R12,
                )

                var skip_store_pos: int = code.len()

                patch_rel32(
                    code,
                    jz_skip_store,
                    skip_store_pos,
                )
            }
            case Err(_) {
                x86.emit_pop_reg(
                    code,
                    x86.R12,
                )
            }
        }
    }

    var vec_ready_pos: int = code.len()

    patch_rel32(
        code,
        jnz_vec_ready,
        vec_ready_pos,
    )

    if refRecv {
        // Ref receiver reload can be unstable; preserve resolved pointer instead.
        // Keep 16-byte call alignment for nested calls emitted by value expression.
        x86.emit_push_reg(
            code,
            x86.R12,
        )
        x86.emit_sub_rsp_imm8(
            code,
            8,
        )
    }

    var resVal: Result<void, string> = emit_expr(
        value,
        state,
        code,
    )

    switch resVal {
        case Err(msg) {
            if refRecv {
                x86.emit_add_rsp_imm8(
                    code,
                    8,
                )
                x86.emit_pop_reg(
                    code,
                    x86.R12,
                )
            }

            x86.emit_pop_reg(
                code,
                x86.R12,
            )

            return Err(msg)
        }
        case Ok(_) {
        }
    }

    if refRecv {
        x86.emit_add_rsp_imm8(
            code,
            8,
        )
        x86.emit_pop_reg(
            code,
            x86.R12,
        )
    }

    // Preserve push value.
    x86.emit_push_reg(
        code,
        x86.R13,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.R13,
        x86.RAX,
    )

    if !refRecv {
        // Re-load receiver after evaluating value expressions that may perform calls.
        var reloadObj: Result<void, string> = emit_expr(
            obj,
            state,
            code,
        )

        switch reloadObj {
            case Err(msg) {
                x86.emit_pop_reg(
                    code,
                    x86.R13,
                )
                x86.emit_pop_reg(
                    code,
                    x86.R12,
                )

                return Err(msg)
            }
            case Ok(_) {
            }
        }

        x86.emit_mov_reg_reg(
            code,
            x86.R12,
            x86.RAX,
        )
    }

    if helper_kind == ELEM_KIND_STRUCT || helper_kind == ELEM_KIND_STRING {
        x86.emit_mov_reg_reg(
            code,
            x86.RCX,
            x86.R12,
        )
        x86.emit_mov_reg_reg(
            code,
            x86.R11,
            x86.R13,
        )

        if helper_kind == ELEM_KIND_STRING {
            var helperStrRes: Result<void, string> = emit_vec_push_string_from_regs(
                state,
                code,
            )

            switch helperStrRes {
                case Err(msg) {
                    x86.emit_pop_reg(
                        code,
                        x86.R13,
                    )
                    x86.emit_pop_reg(
                        code,
                        x86.R12,
                    )

                    return Err(msg)
                }
                case Ok(_) {
                }
            }
        } else {
            var helperStructRes: Result<void, string> = emit_vec_push_struct_from_regs(
                8,
                state,
                code,
            )

            switch helperStructRes {
                case Err(msg) {
                    x86.emit_pop_reg(
                        code,
                        x86.R13,
                    )
                    x86.emit_pop_reg(
                        code,
                        x86.R12,
                    )

                    return Err(msg)
                }
                case Ok(_) {
                }
            }
        }

        x86.emit_pop_reg(
            code,
            x86.R13,
        )
        x86.emit_pop_reg(
            code,
            x86.R12,
        )

        return Ok(void)
    }

    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R8,
        x86.R12,
        8,
    )
    // len
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R9,
        x86.R12,
        16,
    )
    // cap
    x86.emit_cmp_reg_reg(
        code,
        x86.R8,
        x86.R9,
    )

    var jl_no_grow: int = emit_jl_placeholder(code)

    // new_cap = (cap == 0) ? 8 : cap * 2
    x86.emit_mov_reg_reg(
        code,
        x86.R10,
        x86.R9,
    )
    // old cap
    x86.emit_test_reg_reg(
        code,
        x86.R9,
        x86.R9,
    )

    var jnz_nonzero_cap: int = emit_jnz_placeholder(code)

    x86.emit_mov_reg_imm32(
        code,
        x86.R9,
        8,
    )

    var jmp_after_cap: int = emit_jmp_placeholder(code)
    var nonzero_cap_pos: int = code.len()

    patch_rel32(
        code,
        jnz_nonzero_cap,
        nonzero_cap_pos,
    )
    x86.emit_add_reg_reg(
        code,
        x86.R9,
        x86.R9,
    )

    var after_cap_pos: int = code.len()

    patch_rel32(
        code,
        jmp_after_cap,
        after_cap_pos,
    )
    x86.emit_push_reg(
        code,
        x86.R8,
    )
    // len
    x86.emit_push_reg(
        code,
        x86.R9,
    )
    // new cap
    x86.emit_push_reg(
        code,
        x86.R10,
    )
    // old cap
    x86.emit_push_reg(
        code,
        x86.R12,
    )
    // vec_ptr across call
    x86.emit_push_reg(
        code,
        x86.R13,
    )
    // push value across call
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.R9,
    )
    x86.emit_shl_reg_imm8(
        code,
        x86.RDI,
        3,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )

    var call_site_alloc: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    add_call_patch(
        state,
        call_site_alloc + 1,
        "__rt_alloc",
    )
    x86.emit_pop_reg(
        code,
        x86.R13,
    )
    x86.emit_pop_reg(
        code,
        x86.R12,
    )
    x86.emit_pop_reg(
        code,
        x86.R10,
    )
    x86.emit_pop_reg(
        code,
        x86.R9,
    )
    x86.emit_pop_reg(
        code,
        x86.R8,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.R11,
        x86.RAX,
    )
    // new data ptr
    x86.emit_test_reg_reg(
        code,
        x86.R8,
        x86.R8,
    )

    // len
    var jz_skip_copy: int = emit_jz_placeholder(code)

    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RSI,
        x86.R12,
        0,
    )
    // old data ptr
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.R11,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RCX,
        x86.R8,
    )
    x86.emit_shl_reg_imm8(
        code,
        x86.RCX,
        3,
    )
    x86.emit_rep_movsb(code)

    var skip_copy_pos: int = code.len()

    patch_rel32(
        code,
        jz_skip_copy,
        skip_copy_pos,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.R12,
        0,
        x86.R11,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.R12,
        16,
        x86.R9,
    )

    var no_grow_pos: int = code.len()

    patch_rel32(
        code,
        jl_no_grow,
        no_grow_pos,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R8,
        x86.R12,
        8,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R11,
        x86.R12,
        0,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RDX,
        x86.R8,
    )
    x86.emit_shl_reg_imm8(
        code,
        x86.RDX,
        3,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RDX,
        x86.R11,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RDX,
        0,
        x86.R13,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        1,
    )
    x86.emit_add_reg_reg(
        code,
        x86.R8,
        x86.RAX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.R12,
        8,
        x86.R8,
    )
    x86.emit_pop_reg(
        code,
        x86.R13,
    )
    x86.emit_pop_reg(
        code,
        x86.R12,
    )

    return Ok(void)
}

func emit_vec_pop(
    obj: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var infoRes: Result<IterableInfo, string> = vec_elem_info(
        obj,
        state,
    )
    mut var elem_size: int = 8
    mut var elem_kind: int = ELEM_KIND_SCALAR
    mut var elem_struct: string = ""

    switch infoRes {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(info) {
            elem_size = info.size
            elem_kind = info.kind
            elem_struct = info.struct_name
        }
    }

    var optRes: Result<OptionLayoutInfo, string> = option_layout_for_info(
        elem_kind,
        elem_size,
        &elem_struct,
        state,
    )
    mut var opt_size: int = 16
    mut var payload_off: int = 8

    switch optRes {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(layout) {
            opt_size = layout.total_size
            payload_off = layout.payload_offset
        }
    }

    var res: Result<void, string> = emit_expr(
        obj,
        state,
        code,
    )

    switch res {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_mov_reg_reg(
        code,
        x86.R11,
        x86.RAX,
    )
    // vec_ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R10,
        x86.R11,
        8,
    )
    // len
    x86.emit_test_reg_reg(
        code,
        x86.R10,
        x86.R10,
    )

    var jz_empty: int = emit_jz_placeholder(code)

    // Non-empty: len--, load element.
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        1,
    )
    x86.emit_sub_reg_reg(
        code,
        x86.R10,
        x86.RCX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.R11,
        8,
        x86.R10,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RDX,
        x86.R11,
        0,
    )
    // Uniform 8-byte element load: R8 = data_ptr[index * 8]
    // RDX = data_ptr, R10 = index (len-1)
    x86.emit_mov_reg_mem_base_index(
        code,
        x86.R8,
        x86.RDX,
        x86.R10,
        8,
    )
    // Allocate Option for Some.
    x86.emit_push_reg(
        code,
        x86.R8,
    )
    x86.emit_sub_rsp_imm8(
        code,
        8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        opt_size,
    )

    var call_some: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_some + 1,
        "__rt_alloc",
    )
    x86.emit_add_rsp_imm8(
        code,
        8,
    )
    x86.emit_pop_reg(
        code,
        x86.R8,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        1,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.RCX,
    )
    // Uniform 8-byte payload store into Option
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        payload_off,
        x86.R8,
    )

    var jmp_done: int = emit_jmp_placeholder(code)
    var empty_start: int = code.len()

    patch_rel32(
        code,
        jz_empty,
        empty_start,
    )
    // Empty: return Option::None.
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        opt_size,
    )

    var call_none: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_none + 1,
        "__rt_alloc",
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        0,
        x86.RCX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RAX,
        payload_off,
        x86.RCX,
    )

    var done: int = code.len()

    patch_rel32(
        code,
        jmp_done,
        done,
    )

    return Ok(void)
}

func emit_vec_remove(
    obj: &ast.Expression,
    index: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var res_obj: Result<void, string> = emit_expr(
        obj,
        state,
        code,
    )

    switch res_obj {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    if is_ref_expr(
        obj,
        state,
    ) {
        emit_safe_ref_deref_rax(code)
    }

    x86.emit_push_reg(
        code,
        x86.RAX,
    )

    var res_idx: Result<void, string> = emit_expr(
        index,
        state,
        code,
    )

    switch res_idx {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_mov_reg_reg(
        code,
        x86.R10,
        x86.RAX,
    )
    // idx
    x86.emit_pop_reg(
        code,
        x86.R11,
    )
    // vec_ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R8,
        x86.R11,
        8,
    )
    // len
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.R9,
        x86.R11,
        0,
    )
    // data_ptr
    x86.emit_mov_rax_imm32(
        code,
        0,
    )
    // default return for out-of-bounds
    x86.emit_cmp_reg_reg(
        code,
        x86.R10,
        x86.R8,
    )

    var jge_oob: int = emit_jge_placeholder(code)

    // removed value
    x86.emit_mov_reg_mem_base_index(
        code,
        x86.RAX,
        x86.R9,
        x86.R10,
        8,
    )
    // i = idx
    x86.emit_mov_reg_reg(
        code,
        x86.RCX,
        x86.R10,
    )

    var loop_start: int = code.len()

    // next = i + 1
    x86.emit_mov_reg_reg(
        code,
        x86.RDX,
        x86.RCX,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        1,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RDX,
        x86.RDI,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.RDX,
        x86.R8,
    )

    var jge_shift_done: int = emit_jge_placeholder(code)

    // data[i] = data[next]
    x86.emit_mov_reg_mem_base_index(
        code,
        x86.RSI,
        x86.R9,
        x86.RDX,
        8,
    )
    x86.emit_mov_mem_base_index_reg(
        code,
        x86.R9,
        x86.RCX,
        8,
        x86.RSI,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RCX,
        x86.RDX,
    )
    emit_jmp_to(
        code,
        loop_start,
    )

    var shift_done: int = code.len()

    patch_rel32(
        code,
        jge_shift_done,
        shift_done,
    )
    // len--
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        1,
    )
    x86.emit_sub_reg_reg(
        code,
        x86.R8,
        x86.RDI,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.R11,
        8,
        x86.R8,
    )

    var jmp_done: int = emit_jmp_placeholder(code)
    var oob_pos: int = code.len()

    patch_rel32(
        code,
        jge_oob,
        oob_pos,
    )
    x86.emit_mov_rax_imm32(
        code,
        0,
    )

    var done_pos: int = code.len()

    patch_rel32(
        code,
        jmp_done,
        done_pos,
    )

    return Ok(void)
}

func emit_index_expression(
    ix: &ast.IndexExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    if is_vec_expr(
        &ix.Left,
        state,
    ) {
        var infoRes: Result<IterableInfo, string> = vec_elem_info(
            &ix.Left,
            state,
        )
        mut var elem_size: int = 8
        mut var elem_kind: int = ELEM_KIND_SCALAR

        switch infoRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(info) {
                elem_size = info.size
                elem_kind = info.kind
            }
        }

        var resLeft: Result<void, string> = emit_expr(
            &ix.Left,
            state,
            code,
        )

        switch resLeft {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        // If ix.Left is a reference (&Vec), dereference first
        if is_ref_expr(
            &ix.Left,
            state,
        ) {
            emit_safe_ref_deref_rax(code)
        }

        x86.emit_push_reg(
            code,
            x86.RAX,
        )

        var resIdx: Result<void, string> = emit_expr(
            &ix.Index,
            state,
            code,
        )

        switch resIdx {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        x86.emit_mov_reg_reg(
            code,
            x86.R8,
            x86.RAX,
        )
        // index
        x86.emit_pop_reg(
            code,
            x86.RCX,
        )
        // vec_ptr
        x86.emit_mov_reg_mem_base_disp(
            code,
            x86.RDX,
            x86.RCX,
            0,
        )
        // Uniform 8-byte element load: RAX = data_ptr[index * 8]
        // RDX = data_ptr, R8 = index
        x86.emit_mov_reg_mem_base_index(
            code,
            x86.RAX,
            x86.RDX,
            x86.R8,
            8,
        )

        return Ok(void)
    }

    if is_string_expr(
        &ix.Left,
        state,
    ) {
        var resLeft: Result<void, string> = emit_expr(
            &ix.Left,
            state,
            code,
        )

        switch resLeft {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        x86.emit_push_reg(
            code,
            x86.RAX,
        )

        var resIdx: Result<void, string> = emit_expr(
            &ix.Index,
            state,
            code,
        )

        switch resIdx {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        x86.emit_mov_reg_reg(
            code,
            x86.R8,
            x86.RAX,
        )
        // index
        x86.emit_pop_reg(
            code,
            x86.RCX,
        )
        // str header
        x86.emit_mov_reg_mem_base_disp(
            code,
            x86.RDX,
            x86.RCX,
            0,
        )
        // data_ptr
        x86.emit_movzx_reg_mem_base_index(
            code,
            x86.RAX,
            x86.RDX,
            x86.R8,
            1,
        )

        return Ok(void)
    }

    // Bootstrap fallback: treat unknown indexable as Vec-like header {data,len,cap}.
    var resLeftFallback: Result<void, string> = emit_expr(
        &ix.Left,
        state,
        code,
    )

    switch resLeftFallback {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    if is_ref_expr(
        &ix.Left,
        state,
    ) {
        emit_safe_ref_deref_rax(code)
    }

    x86.emit_push_reg(
        code,
        x86.RAX,
    )

    var resIdxFallback: Result<void, string> = emit_expr(
        &ix.Index,
        state,
        code,
    )

    switch resIdxFallback {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(_) {
        }
    }

    x86.emit_mov_reg_reg(
        code,
        x86.R8,
        x86.RAX,
    )
    x86.emit_pop_reg(
        code,
        x86.RCX,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RDX,
        x86.RCX,
        0,
    )
    x86.emit_mov_reg_mem_base_index(
        code,
        x86.RAX,
        x86.RDX,
        x86.R8,
        8,
    )

    return Ok(void)
}

func vec_elem_info(
    expr: &ast.Expression,
    state: &mut BackendEmitState,
) -> (Result<IterableInfo, string>) {
    var infoOpt: Option<IterableInfo> = iterable_elem_info(
        expr,
        &None,
        state,
    )

    switch infoOpt {
        case Some(info) {
            if info.container_kind != CONTAINER_KIND_VEC {
                return Ok(
                    IterableInfo{
                        container_kind: CONTAINER_KIND_VEC,
                        kind:           ELEM_KIND_SCALAR,
                        size:           8,
                        struct_name:    "",
                    },
                )
            }

            return Ok(info)
        }
        case None {
            return Ok(
                IterableInfo{
                    container_kind: CONTAINER_KIND_VEC,
                    kind:           ELEM_KIND_SCALAR,
                    size:           8,
                    struct_name:    "",
                },
            )
        }
    }
}

func vec_elem_scale(elem_size: int) -> (int) {
    if elem_size == 1 {
        return 1
    }

    if elem_size == 4 {
        return 4
    }

    if elem_size == 8 {
        return 8
    }

    return 0
}

pub struct OptionLayoutInfo {
    total_size:     int
    payload_offset: int
}

pub struct ResultLayoutInfo {
    total_size: int
    ok_offset:  int
    err_offset: int
}

func result_layout_for_type(
    ok_type: &ast.TypeExpression,
    err_type: &ast.TypeExpression,
    state: &mut BackendEmitState,
) -> (Result<ResultLayoutInfo, string>) {
    var okRes: Result<layout.TypeLayout, string> = layout.type_layout(
        ok_type,
        &state.structs,
    )

    switch okRes {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(ok_tl) {
            var errRes: Result<layout.TypeLayout, string> = layout.type_layout(
                err_type,
                &state.structs,
            )

            switch errRes {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(err_tl) {
                    mut var offset: int = 8
                    // tag size
                    mut var max_align: int = 8

                    offset = align_to(
                        offset,
                        ok_tl.align,
                    )

                    var ok_off: int = offset

                    offset = offset + ok_tl.size

                    if ok_tl.align > max_align {
                        max_align = ok_tl.align
                    }

                    offset = align_to(
                        offset,
                        err_tl.align,
                    )

                    var err_off: int = offset

                    offset = offset + err_tl.size

                    if err_tl.align > max_align {
                        max_align = err_tl.align
                    }

                    offset = align_to(
                        offset,
                        max_align,
                    )

                    return Ok(
                        ResultLayoutInfo{
                            err_offset: err_off,
                            ok_offset:  ok_off,
                            total_size: offset,
                        },
                    )
                }
            }
        }
    }
}

func align_to(value: int, align: int) -> (int) {
    if align <= 1 {
        return value
    }

    var rem: int = value % align

    if rem == 0 {
        return value
    }

    return value + (align - rem)
}

func option_layout_for_info(
    elem_kind: int,
    elem_size: int,
    elem_struct: &string,
    state: &mut BackendEmitState,
) -> (Result<OptionLayoutInfo, string>) {
    if elem_size <= 0 {
        return Err("native: Option element size invalid")
    }

    mut var payload_align: int = 8

    if elem_kind == ELEM_KIND_STRUCT {
        if *elem_struct == "" {
            return Err("native: Option struct element missing name")
        }

        var declOpt: Option<ast.StructDecl> = find_struct_decl(
            &state.structs,
            elem_struct,
        )

        switch declOpt {
            case None {
                // Bootstrap fallback: unknown struct payloads are treated as pointer-sized.
                payload_align = 8
            }
            case Some(decl) {
                var layoutRes: Result<layout.StructLayout, string> = layout.struct_layout(
                    &decl,
                    &state.structs,
                )

                switch layoutRes {
                    case Err(msg) {
                        return Err(msg)
                    }
                    case Ok(st_layout) {
                        payload_align = st_layout.align
                    }
                }
            }
        }
    } else if elem_kind == ELEM_KIND_STRING || elem_kind == ELEM_KIND_VEC {
        payload_align = 8
    } else if elem_size == 1 {
        payload_align = 1
    } else if elem_size == 4 {
        payload_align = 4
    } else {
        payload_align = 8
    }

    var payload_off: int = align_to(
        8,
        payload_align,
    )
    mut var max_align: int = 8

    if payload_align > max_align {
        max_align = payload_align
    }

    var total: int = align_to(
        payload_off + elem_size,
        max_align,
    )

    return Ok(OptionLayoutInfo{payload_offset: payload_off, total_size: total})
}

func emit_expr(
    expr: &ast.Expression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    if TRACE_ASSIGN_STOP_PHASE == 15 && state.trace_assign_rhs && is_trace_main_context(state) {
        return Err("trace-assign-stop")
    }

    if TRACE_ASSIGN_STOP_PHASE == 16 && state.trace_assign_rhs && is_trace_main_context(state) {
        return Err(
            "trace-expr-case=" + expr_case_id(expr).toString(),
        )
    }

    switch *expr {
        case ast.Expression.IntegerLiteral(il) {
            return emit_int_literal(
                il.Value,
                code,
            )
        }
        case ast.Expression.CharLiteral(cl) {
            return emit_char_literal(
                cl.Value,
                code,
            )
        }
        case ast.Expression.StringLiteral(sl) {
            return emit_string_literal(
                &sl.Value,
                state,
                code,
            )
        }
        case ast.Expression.VecLiteral(vl) {
            return emit_vec_literal(
                &vl.Elements,
                state,
                code,
            )
        }
        case ast.Expression.StructLiteral(sl) {
            return emit_struct_literal(
                &sl,
                state,
                code,
            )
        }
        case ast.Expression.BooleanLiteral(bl) {
            if bl.Value {
                x86.emit_mov_rax_imm32(
                    code,
                    1,
                )
            } else {
                x86.emit_mov_rax_imm32(
                    code,
                    0,
                )
            }

            return Ok(void)
        }
        case ast.Expression.Identifier(id) {
            if id.Value == "_" {
                x86.emit_mov_rax_imm32(
                    code,
                    0,
                )

                return Ok(void)
            }

            var offOpt: Option<int> = resolve_local(
                state,
                &id.Value,
            )

            switch offOpt {
                case Some(off) {
                    x86.emit_mov_reg_mem_rbp(
                        code,
                        x86.RAX,
                        off,
                    )

                    return Ok(void)
                }
                case None {
                    if id.Value == "ast" {
                        x86.emit_mov_rax_imm32(
                            code,
                            0,
                        )

                        return Ok(void)
                    }

                    // Try top-level constants
                    var constRes: Result<void, string> = emit_const_value(
                        state,
                        code,
                        &id.Value,
                    )

                    switch constRes {
                        case Ok(_) {
                            return Ok(void)
                        }
                        case Err(_) {
                            // Try fieldless enum variant (e.g., Red, Green, None)
                            var enumRes: Result<void, string> = emit_fieldless_variant(
                                &id.Value,
                                state,
                                code,
                            )

                            switch enumRes {
                                case Ok(_) {
                                    return Ok(void)
                                }
                                case Err(_) {
                                    return Err("native: unknown local " + id.Value + " (pkg=" + state.current_pkg + ")")
                                }
                            }
                        }
                    }
                }
            }
        }
        case ast.Expression.MutableIdentifier(id) {
            if id.Value == "_" {
                x86.emit_mov_rax_imm32(
                    code,
                    0,
                )

                return Ok(void)
            }

            var offOpt: Option<int> = resolve_local(
                state,
                &id.Value,
            )

            switch offOpt {
                case Some(off) {
                    x86.emit_mov_reg_mem_rbp(
                        code,
                        x86.RAX,
                        off,
                    )

                    return Ok(void)
                }
                case None {
                    var constRes: Result<void, string> = emit_const_value(
                        state,
                        code,
                        &id.Value,
                    )

                    switch constRes {
                        case Ok(_) {
                            return Ok(void)
                        }
                        case Err(_) {
                            return Err("native: unknown local " + id.Value + " (pkg=" + state.current_pkg + ")")
                        }
                    }
                }
            }
        }
        case ast.Expression.Prefix(pe) {
            if pe.Operator == "-" {
                var res: Result<void, string> = emit_expr(
                    &pe.Right,
                    state,
                    code,
                )

                switch res {
                    case Err(msg) {
                        return Err(msg)
                    }
                    case Ok(_) {
                    }
                }

                x86.emit_neg_reg(
                    code,
                    x86.RAX,
                )

                return Ok(void)
            }

            if pe.Operator == "!" {
                var res: Result<void, string> = emit_expr(
                    &pe.Right,
                    state,
                    code,
                )

                switch res {
                    case Err(msg) {
                        return Err(msg)
                    }
                    case Ok(_) {
                    }
                }

                x86.emit_test_reg_reg(
                    code,
                    x86.RAX,
                    x86.RAX,
                )
                x86.emit_sete(code)
                x86.emit_movzx_rax_al(code)

                return Ok(void)
            }

            if pe.Operator == "&" {
                // Address-of operator: compute address instead of loading value
                return emit_address_of(
                    &pe.Right,
                    state,
                    code,
                )
            }

            if pe.Operator == "*" {
                // Dereference operator: load the value at the pointer
                var res: Result<void, string> = emit_expr(
                    &pe.Right,
                    state,
                    code,
                )

                switch res {
                    case Err(msg) {
                        return Err(msg)
                    }
                    case Ok(_) {
                    }
                }

                // Safe dereference: treat null/low addresses as zero.
                emit_safe_load_rax_from_rax_disp(
                    0,
                    code,
                )

                return Ok(void)
            }

            return Err("native: unsupported prefix operator " + pe.Operator)
        }
        case ast.Expression.Infix(ie) {
            // debug trace removed
            // Short-circuit && and ||
            if ie.Operator == "&&" {
                return emit_short_circuit_and(
                    &ie,
                    state,
                    code,
                )
            }

            if ie.Operator == "||" {
                return emit_short_circuit_or(
                    &ie,
                    state,
                    code,
                )
            }

            var left_is_float: bool = is_float_expr(
                &ie.Left,
                state,
            )
            var right_is_float: bool = is_float_expr(
                &ie.Right,
                state,
            )
            var is_float_op: bool = left_is_float || right_is_float

            // debug trace removed
            if (ie.Operator == "==" || ie.Operator == "!=") && !is_float_op {
                // debug trace removed
                if has_eq_literal_operand(
                    &ie.Left,
                    &ie.Right,
                ) {
                    // debug trace removed
                    if quick_is_string_eq_expr(
                        &ie.Left,
                        state,
                    ) || quick_is_string_eq_expr(
                        &ie.Right,
                        state,
                    ) {
                        // debug trace removed
                        return emit_string_equals(
                            &ie.Left,
                            &ie.Right,
                            state,
                            code,
                            ie.Operator == "!=",
                        )
                    }

                    // debug trace removed
                    return emit_scalar_equals_exprs(
                        &ie.Left,
                        &ie.Right,
                        ie.Operator == "!=",
                        state,
                        code,
                    )
                }

                if quick_is_string_eq_expr(
                    &ie.Left,
                    state,
                ) || quick_is_string_eq_expr(
                    &ie.Right,
                    state,
                ) {
                    // debug trace removed
                    return emit_string_equals(
                        &ie.Left,
                        &ie.Right,
                        state,
                        code,
                        ie.Operator == "!=",
                    )
                }

                if quick_is_scalar_eq_expr(
                    &ie.Left,
                    state,
                ) && quick_is_scalar_eq_expr(
                    &ie.Right,
                    state,
                ) {
                    // debug trace removed
                    return emit_scalar_equals_exprs(
                        &ie.Left,
                        &ie.Right,
                        ie.Operator == "!=",
                        state,
                        code,
                    )
                }
            }

            // debug trace removed
            if ie.Operator == "==" || ie.Operator == "!=" {
                var leftEnumLike: bool = is_enum_like_expr(
                    &ie.Left,
                    state,
                )
                var rightEnumLike: bool = is_enum_like_expr(
                    &ie.Right,
                    state,
                )

                if leftEnumLike && rightEnumLike {
                    return emit_enum_equals(
                        &ie.Left,
                        &ie.Right,
                        state,
                        code,
                        ie.Operator == "!=",
                    )
                }
            }

            if ie.Operator == "==" && (is_string_expr(
                &ie.Left,
                state,
            ) || is_string_expr(
                &ie.Right,
                state,
            )) {
                return emit_string_equals(
                    &ie.Left,
                    &ie.Right,
                    state,
                    code,
                    false,
                )
            }

            if ie.Operator == "!=" && (is_string_expr(
                &ie.Left,
                state,
            ) || is_string_expr(
                &ie.Right,
                state,
            )) {
                return emit_string_equals(
                    &ie.Left,
                    &ie.Right,
                    state,
                    code,
                    true,
                )
            }

            if ie.Operator == "+" && is_string_expr(
                &ie.Left,
                state,
            ) && is_string_expr(
                &ie.Right,
                state,
            ) {
                return emit_string_concat(
                    &ie.Left,
                    &ie.Right,
                    state,
                    code,
                )
            }

            var resL: Result<void, string> = emit_expr(
                &ie.Left,
                state,
                code,
            )

            switch resL {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            x86.emit_push_reg(
                code,
                x86.RAX,
            )

            var resR: Result<void, string> = emit_expr(
                &ie.Right,
                state,
                code,
            )

            switch resR {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            x86.emit_pop_reg(
                code,
                x86.RCX,
            )

            if is_float_op {
                if !left_is_float {
                    emit_scale_reg_for_float(
                        code,
                        x86.RCX,
                    )
                }

                if !right_is_float {
                    emit_scale_reg_for_float(
                        code,
                        x86.RAX,
                    )
                }

                if ie.Operator == "+" {
                    x86.emit_add_reg_reg(
                        code,
                        x86.RCX,
                        x86.RAX,
                    )
                    x86.emit_mov_reg_reg(
                        code,
                        x86.RAX,
                        x86.RCX,
                    )

                    return Ok(void)
                }

                if ie.Operator == "-" {
                    x86.emit_sub_reg_reg(
                        code,
                        x86.RCX,
                        x86.RAX,
                    )
                    x86.emit_mov_reg_reg(
                        code,
                        x86.RAX,
                        x86.RCX,
                    )

                    return Ok(void)
                }

                if ie.Operator == "*" {
                    x86.emit_imul_reg_reg(
                        code,
                        x86.RCX,
                        x86.RAX,
                    )
                    x86.emit_mov_reg_reg(
                        code,
                        x86.RAX,
                        x86.RCX,
                    )
                    emit_unscale_rax_float_to_int(code)

                    return Ok(void)
                }

                if ie.Operator == "/" {
                    x86.emit_mov_reg_reg(
                        code,
                        x86.R8,
                        x86.RAX,
                    )
                    x86.emit_mov_reg_reg(
                        code,
                        x86.RAX,
                        x86.RCX,
                    )
                    x86.emit_mov_reg_imm32(
                        code,
                        x86.R11,
                        FLOAT_SCALE,
                    )
                    x86.emit_imul_reg_reg(
                        code,
                        x86.RAX,
                        x86.R11,
                    )
                    x86.emit_mov_reg_reg(
                        code,
                        x86.RCX,
                        x86.R8,
                    )
                    x86.emit_cqo(code)
                    x86.emit_idiv_reg(
                        code,
                        x86.RCX,
                    )

                    return Ok(void)
                }

                if ie.Operator == "==" {
                    x86.emit_cmp_reg_reg(
                        code,
                        x86.RCX,
                        x86.RAX,
                    )
                    x86.emit_sete(code)
                    x86.emit_movzx_rax_al(code)

                    return Ok(void)
                }

                if ie.Operator == "!=" {
                    x86.emit_cmp_reg_reg(
                        code,
                        x86.RCX,
                        x86.RAX,
                    )
                    x86.emit_setne(code)
                    x86.emit_movzx_rax_al(code)

                    return Ok(void)
                }

                if ie.Operator == "<" {
                    x86.emit_cmp_reg_reg(
                        code,
                        x86.RCX,
                        x86.RAX,
                    )
                    x86.emit_setl(code)
                    x86.emit_movzx_rax_al(code)

                    return Ok(void)
                }

                if ie.Operator == "<=" {
                    x86.emit_cmp_reg_reg(
                        code,
                        x86.RCX,
                        x86.RAX,
                    )
                    x86.emit_setle(code)
                    x86.emit_movzx_rax_al(code)

                    return Ok(void)
                }

                if ie.Operator == ">" {
                    x86.emit_cmp_reg_reg(
                        code,
                        x86.RCX,
                        x86.RAX,
                    )
                    x86.emit_setg(code)
                    x86.emit_movzx_rax_al(code)

                    return Ok(void)
                }

                if ie.Operator == ">=" {
                    x86.emit_cmp_reg_reg(
                        code,
                        x86.RCX,
                        x86.RAX,
                    )
                    x86.emit_setge(code)
                    x86.emit_movzx_rax_al(code)

                    return Ok(void)
                }

                return Err("native: unsupported float infix operator " + ie.Operator)
            }

            if ie.Operator == "+" {
                x86.emit_add_reg_reg(
                    code,
                    x86.RCX,
                    x86.RAX,
                )
                x86.emit_mov_reg_reg(
                    code,
                    x86.RAX,
                    x86.RCX,
                )

                return Ok(void)
            }

            if ie.Operator == "-" {
                x86.emit_sub_reg_reg(
                    code,
                    x86.RCX,
                    x86.RAX,
                )
                x86.emit_mov_reg_reg(
                    code,
                    x86.RAX,
                    x86.RCX,
                )

                return Ok(void)
            }

            if ie.Operator == "*" {
                x86.emit_imul_reg_reg(
                    code,
                    x86.RCX,
                    x86.RAX,
                )
                x86.emit_mov_reg_reg(
                    code,
                    x86.RAX,
                    x86.RCX,
                )

                return Ok(void)
            }

            if ie.Operator == "/" {
                x86.emit_push_reg(
                    code,
                    x86.RAX,
                )
                x86.emit_mov_reg_reg(
                    code,
                    x86.RAX,
                    x86.RCX,
                )
                x86.emit_pop_reg(
                    code,
                    x86.RCX,
                )
                x86.emit_cqo(code)
                x86.emit_idiv_reg(
                    code,
                    x86.RCX,
                )

                return Ok(void)
            }

            if ie.Operator == "%" {
                x86.emit_push_reg(
                    code,
                    x86.RAX,
                )
                x86.emit_mov_reg_reg(
                    code,
                    x86.RAX,
                    x86.RCX,
                )
                x86.emit_pop_reg(
                    code,
                    x86.RCX,
                )
                x86.emit_cqo(code)
                x86.emit_idiv_reg(
                    code,
                    x86.RCX,
                )
                x86.emit_mov_reg_reg(
                    code,
                    x86.RAX,
                    x86.RDX,
                )

                return Ok(void)
            }

            if ie.Operator == "&" {
                x86.emit_and_reg_reg(
                    code,
                    x86.RCX,
                    x86.RAX,
                )
                x86.emit_mov_reg_reg(
                    code,
                    x86.RAX,
                    x86.RCX,
                )

                return Ok(void)
            }

            if ie.Operator == "|" {
                x86.emit_or_reg_reg(
                    code,
                    x86.RCX,
                    x86.RAX,
                )
                x86.emit_mov_reg_reg(
                    code,
                    x86.RAX,
                    x86.RCX,
                )

                return Ok(void)
            }

            if ie.Operator == "^" {
                x86.emit_xor_reg_reg(
                    code,
                    x86.RCX,
                    x86.RAX,
                )
                x86.emit_mov_reg_reg(
                    code,
                    x86.RAX,
                    x86.RCX,
                )

                return Ok(void)
            }

            if ie.Operator == "<<" || ie.Operator == ">>" {
                switch ie.Right {
                    case ast.Expression.IntegerLiteral(shift_lit) {
                        if shift_lit.Value < 0 || shift_lit.Value > 63 {
                            return Err("native: shift count out of range")
                        }

                        if ie.Operator == "<<" {
                            x86.emit_shl_reg_imm8(
                                code,
                                x86.RCX,
                                shift_lit.Value,
                            )
                        } else {
                            x86.emit_shr_reg_imm8(
                                code,
                                x86.RCX,
                                shift_lit.Value,
                            )
                        }

                        x86.emit_mov_reg_reg(
                            code,
                            x86.RAX,
                            x86.RCX,
                        )

                        return Ok(void)
                    }
                    default {
                        return Err("native: shift count must be integer literal")
                    }
                }
            }

            if ie.Operator == "==" {
                x86.emit_cmp_reg_reg(
                    code,
                    x86.RCX,
                    x86.RAX,
                )
                x86.emit_sete(code)
                x86.emit_movzx_rax_al(code)

                return Ok(void)
            }

            if ie.Operator == "!=" {
                x86.emit_cmp_reg_reg(
                    code,
                    x86.RCX,
                    x86.RAX,
                )
                x86.emit_setne(code)
                x86.emit_movzx_rax_al(code)

                return Ok(void)
            }

            if ie.Operator == "<" {
                x86.emit_cmp_reg_reg(
                    code,
                    x86.RCX,
                    x86.RAX,
                )
                x86.emit_setl(code)
                x86.emit_movzx_rax_al(code)

                return Ok(void)
            }

            if ie.Operator == "<=" {
                x86.emit_cmp_reg_reg(
                    code,
                    x86.RCX,
                    x86.RAX,
                )
                x86.emit_setle(code)
                x86.emit_movzx_rax_al(code)

                return Ok(void)
            }

            if ie.Operator == ">" {
                x86.emit_cmp_reg_reg(
                    code,
                    x86.RCX,
                    x86.RAX,
                )
                x86.emit_setg(code)
                x86.emit_movzx_rax_al(code)

                return Ok(void)
            }

            if ie.Operator == ">=" {
                x86.emit_cmp_reg_reg(
                    code,
                    x86.RCX,
                    x86.RAX,
                )
                x86.emit_setge(code)
                x86.emit_movzx_rax_al(code)

                return Ok(void)
            }

            return Err("native: unsupported infix operator " + ie.Operator)
        }
        case ast.Expression.FieldAccess(fe) {
            if !field_access_root_is_local(
                &fe.Object,
                state,
            ) {
                if looks_like_enum_variant_name(&fe.Field.Value) {
                    switch find_enum_by_variant(
                        &state.enums,
                        &fe.Field.Value,
                    ) {
                        case Some(_) {
                            return emit_fieldless_variant(
                                &fe.Field.Value,
                                state,
                                code,
                            )
                        }
                        case None {
                        }
                    }
                }

                switch qualified_field_access_name(&fe) {
                    case Some(qconst) {
                        var constRes: Result<void, string> = emit_const_value(
                            state,
                            code,
                            &qconst,
                        )

                        switch constRes {
                            case Ok(_) {
                                return Ok(void)
                            }
                            case Err(_) {
                                var bareConstRes: Result<void, string> = emit_const_value(
                                    state,
                                    code,
                                    &fe.Field.Value,
                                )

                                switch bareConstRes {
                                    case Ok(_) {
                                        return Ok(void)
                                    }
                                    case Err(_) {
                                    }
                                }
                            }
                        }
                    }
                    case None {
                    }
                }
            }

            return emit_field_access(
                &fe,
                state,
                code,
            )
        }
        case ast.Expression.Index(ix) {
            return emit_index_expression(
                &ix,
                state,
                code,
            )
        }
        case ast.Expression.MethodCall(mc) {

            return emit_method_call(
                &mc,
                state,
                code,
            )
        }
        case ast.Expression.Call(ce) {

            return emit_call(
                &ce,
                state,
                code,
            )
        }
        case ast.Expression.EnumVariant(ev) {
            return emit_enum_variant(
                &ev,
                state,
                code,
            )
        }
        case ast.Expression.TypeConversion(tc) {
            return emit_type_conversion(
                &tc,
                state,
                code,
            )
        }
        case ast.Expression.Borrow(be) {
            if TRACE_ASSIGN_STOP_PHASE == 17 && state.trace_assign_rhs && is_trace_main_context(state) {
                return Err(
                    "trace-borrow-inner=" + expr_case_id(&be.Value).toString(),
                )
            }

            if TRACE_ASSIGN_STOP_PHASE == 18 && state.trace_assign_rhs && is_trace_main_context(state) {
                switch be.Value {
                    case ast.Expression.Identifier(idInner) {
                        return Err(
                            "trace-borrow-id-len=" + idInner.Value.len().toString(),
                        )
                    }
                    case ast.Expression.MutableIdentifier(idmInner) {
                        return Err(
                            "trace-borrow-idm-len=" + idmInner.Value.len().toString(),
                        )
                    }
                    default {
                        return Err("trace-borrow-id-len=-1")
                    }
                }
            }

            // Borrow expressions always produce an address.
            return emit_address_of(
                &be.Value,
                state,
                code,
            )
        }
        case ast.Expression.Box(be) {
            var boxRes: Result<void, string> = emit_expr(
                &be.Value,
                state,
                code,
            )

            switch boxRes {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            x86.emit_push_reg(
                code,
                x86.RAX,
            )
            x86.emit_sub_rsp_imm8(
                code,
                8,
            )
            x86.emit_mov_reg_imm32(
                code,
                x86.RDI,
                8,
            )

            var box_call_site: int = code.len()

            x86.emit_call_rel32(
                code,
                0,
            )
            add_call_patch(
                state,
                box_call_site + 1,
                "__rt_alloc",
            )
            x86.emit_add_rsp_imm8(
                code,
                8,
            )
            x86.emit_pop_reg(
                code,
                x86.RCX,
            )
            x86.emit_mov_mem_base_disp_reg(
                code,
                x86.RAX,
                0,
                x86.RCX,
            )

            return Ok(void)
        }
        case ast.Expression.Deref(de) {
            var derefRes: Result<void, string> = emit_expr(
                &de.Value,
                state,
                code,
            )

            switch derefRes {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }

            emit_safe_load_rax_from_rax_disp(
                0,
                code,
            )

            return Ok(void)
        }
        case ast.Expression.FloatLiteral(fl) {
            // Fixed-point float representation in integer registers.
            var scaled: int = int(fl.Value * 1000000.0)

            x86.emit_mov_reg_imm64(
                code,
                x86.RAX,
                scaled,
            )

            return Ok(void)
        }
        case ast.Expression.Tuple(te) {
            // Minimal tuple support: for multi-return return a, b
            // We evaluate each element and keep them in registers if possible.
            // For now, only 2 elements: RAX, RDX.
            if te.Elements.len() == 2 {
                var res1: Result<void, string> = emit_expr(
                    &te.Elements[0],
                    state,
                    code,
                )

                switch res1 {
                    case Err(msg) {
                        return Err(msg)
                    }
                    case Ok(_) {
                    }
                }

                x86.emit_push_reg(
                    code,
                    x86.RAX,
                )

                var res2: Result<void, string> = emit_expr(
                    &te.Elements[1],
                    state,
                    code,
                )

                switch res2 {
                    case Err(msg) {
                        return Err(msg)
                    }
                    case Ok(_) {
                    }
                }

                x86.emit_mov_reg_reg(
                    code,
                    x86.RDX,
                    x86.RAX,
                )
                x86.emit_pop_reg(
                    code,
                    x86.RAX,
                )

                return Ok(void)
            }

            return Err(ERR_NATIVE_UNSUPPORTED)
        }
        case ast.Expression.VoidLiteral(_) {
            x86.emit_mov_rax_imm32(
                code,
                0,
            )

            return Ok(void)
        }
        default {
        }
    }

    return Err("native: unsupported expression " + debug_expr_kind(expr))
}

// --- Enum variant construction ---
func find_enum_by_variant(
    enums: &Vec<ast.EnumDecl, _>,
    variant_name: &string,
) -> (Option<ast.EnumDecl>) {
    mut var ei: int = 0

    while ei < enums.len() {
        var e: &ast.EnumDecl = &(*enums)[ei]
        mut var vi: int = 0

        while vi < e.Variants.len() {
            if (e.Variants[vi]).Name.Value == *variant_name {
                return Some(*e)
            }

            vi = vi + 1
        }

        ei = ei + 1
    }

    return None
}

func find_variant_index(decl: &ast.EnumDecl, variant_name: &string) -> (int) {
    mut var i: int = 0

    while i < decl.Variants.len() {
        if (decl.Variants[i]).Name.Value == *variant_name {
            return i
        }

        i = i + 1
    }

    return -1
}

func emit_enum_variant(
    ev: &ast.EnumVariantExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var vname: string = ev.Variant.Value

    // Option::None
    if vname == "None" {
        // Allocate Option with default int payload size (16 bytes)
        var opt_size: int = 16
        var payload_off: int = 8

        x86.emit_mov_reg_imm32(
            code,
            x86.RDI,
            opt_size,
        )

        var call_site: int = code.len()

        x86.emit_call_rel32(
            code,
            0,
        )
        add_call_patch(
            state,
            call_site + 1,
            "__rt_alloc",
        )
        // tag = 0 (None)
        x86.emit_mov_reg_imm32(
            code,
            x86.RCX,
            0,
        )
        x86.emit_mov_mem_base_disp_reg(
            code,
            x86.RAX,
            0,
            x86.RCX,
        )
        // zero payload
        x86.emit_mov_mem_base_disp_reg(
            code,
            x86.RAX,
            payload_off,
            x86.RCX,
        )

        return Ok(void)
    }

    // Option::Some(val)
    if vname == "Some" {
        if ev.Values.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        // Evaluate payload value
        var res: Result<void, string> = emit_expr(
            &ev.Values[0],
            state,
            code,
        )

        switch res {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        // Save payload in R8
        x86.emit_mov_reg_reg(
            code,
            x86.R8,
            x86.RAX,
        )

        // Allocate Option (default 16 bytes for Option<int>)
        var opt_size: int = 16
        var payload_off: int = 8

        x86.emit_push_reg(
            code,
            x86.R8,
        )
        x86.emit_sub_rsp_imm8(
            code,
            8,
        )
        // align
        x86.emit_mov_reg_imm32(
            code,
            x86.RDI,
            opt_size,
        )

        var call_site: int = code.len()

        x86.emit_call_rel32(
            code,
            0,
        )
        add_call_patch(
            state,
            call_site + 1,
            "__rt_alloc",
        )
        x86.emit_add_rsp_imm8(
            code,
            8,
        )
        x86.emit_pop_reg(
            code,
            x86.R8,
        )
        // tag = 1 (Some)
        x86.emit_mov_reg_imm32(
            code,
            x86.RCX,
            1,
        )
        x86.emit_mov_mem_base_disp_reg(
            code,
            x86.RAX,
            0,
            x86.RCX,
        )
        // payload
        x86.emit_mov_mem_base_disp_reg(
            code,
            x86.RAX,
            payload_off,
            x86.R8,
        )

        return Ok(void)
    }

    // Result::Ok(val)
    if vname == "Ok" {
        if ev.Values.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        var res: Result<void, string> = emit_expr(
            &ev.Values[0],
            state,
            code,
        )

        switch res {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        x86.emit_mov_reg_reg(
            code,
            x86.R8,
            x86.RAX,
        )

        // Default Result<int,int> layout: tag(8) + ok(8) + err(8) = 24
        var result_size: int = 24
        var ok_off: int = 8

        x86.emit_push_reg(
            code,
            x86.R8,
        )
        x86.emit_sub_rsp_imm8(
            code,
            8,
        )
        x86.emit_mov_reg_imm32(
            code,
            x86.RDI,
            result_size,
        )

        var call_site: int = code.len()

        x86.emit_call_rel32(
            code,
            0,
        )
        add_call_patch(
            state,
            call_site + 1,
            "__rt_alloc",
        )
        x86.emit_add_rsp_imm8(
            code,
            8,
        )
        x86.emit_pop_reg(
            code,
            x86.R8,
        )
        // tag = 1 (Ok)
        x86.emit_mov_reg_imm32(
            code,
            x86.RCX,
            1,
        )
        x86.emit_mov_mem_base_disp_reg(
            code,
            x86.RAX,
            0,
            x86.RCX,
        )
        // ok payload
        x86.emit_mov_mem_base_disp_reg(
            code,
            x86.RAX,
            ok_off,
            x86.R8,
        )

        return Ok(void)
    }

    // Result::Err(val)
    if vname == "Err" {
        if ev.Values.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        var res: Result<void, string> = emit_expr(
            &ev.Values[0],
            state,
            code,
        )

        switch res {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        x86.emit_mov_reg_reg(
            code,
            x86.R8,
            x86.RAX,
        )

        // Default Result<int,int> layout: tag(8) + ok(8) + err(8) = 24
        var result_size: int = 24
        var err_off: int = 16

        x86.emit_push_reg(
            code,
            x86.R8,
        )
        x86.emit_sub_rsp_imm8(
            code,
            8,
        )
        x86.emit_mov_reg_imm32(
            code,
            x86.RDI,
            result_size,
        )

        var call_site: int = code.len()

        x86.emit_call_rel32(
            code,
            0,
        )
        add_call_patch(
            state,
            call_site + 1,
            "__rt_alloc",
        )
        x86.emit_add_rsp_imm8(
            code,
            8,
        )
        x86.emit_pop_reg(
            code,
            x86.R8,
        )
        // tag = 0 (Err)
        x86.emit_mov_reg_imm32(
            code,
            x86.RCX,
            0,
        )
        x86.emit_mov_mem_base_disp_reg(
            code,
            x86.RAX,
            0,
            x86.RCX,
        )
        // err payload
        x86.emit_mov_mem_base_disp_reg(
            code,
            x86.RAX,
            err_off,
            x86.R8,
        )

        return Ok(void)
    }

    // Custom enum variant
    var enumOpt: Option<ast.EnumDecl> = find_enum_by_variant(
        &state.enums,
        &vname,
    )

    switch enumOpt {
        case Some(decl) {
            var layoutRes: Result<layout.EnumLayout, string> = layout.enum_layout(
                &decl,
                &state.structs,
            )

            switch layoutRes {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(el) {
                    var tag_val: int = find_variant_index(
                        &decl,
                        &vname,
                    )

                    if tag_val < 0 {
                        return Err("native: variant not found " + vname)
                    }

                    // Evaluate payload values and push them on stack
                    mut var vi: int = 0

                    while vi < ev.Values.len() {
                        var res: Result<void, string> = emit_expr(
                            &ev.Values[vi],
                            state,
                            code,
                        )

                        switch res {
                            case Err(msg) {
                                return Err(msg)
                            }
                            case Ok(_) {
                            }
                        }

                        x86.emit_push_reg(
                            code,
                            x86.RAX,
                        )
                        vi = vi + 1
                    }

                    // Align stack if needed for call
                    mut var stack_pad: int = 0

                    if ev.Values.len() % 2 != 0 {
                        x86.emit_sub_rsp_imm8(
                            code,
                            8,
                        )
                        stack_pad = 8
                    }

                    // Allocate enum
                    x86.emit_mov_reg_imm32(
                        code,
                        x86.RDI,
                        el.size,
                    )

                    var call_site: int = code.len()

                    x86.emit_call_rel32(
                        code,
                        0,
                    )
                    add_call_patch(
                        state,
                        call_site + 1,
                        "__rt_alloc",
                    )

                    // Remove stack padding
                    if stack_pad > 0 {
                        x86.emit_add_rsp_imm8(
                            code,
                            stack_pad,
                        )
                    }

                    // Set tag
                    x86.emit_mov_reg_imm32(
                        code,
                        x86.RCX,
                        tag_val,
                    )
                    x86.emit_mov_mem_base_disp_reg(
                        code,
                        x86.RAX,
                        0,
                        x86.RCX,
                    )

                    // Pop payload values in reverse and store at field offsets
                    // Find the variant layout
                    mut var vl_fields: Vec<layout.FieldLayout, _> = Vec.new()
                    mut var _vli2: int = 0

                    while _vli2 < el.variants.len() {
                        if (el.variants[_vli2]).name == vname {
                            vl_fields = (el.variants[_vli2]).fields
                        }

                        _vli2 = _vli2 + 1
                    }

                    mut var ri: int = ev.Values.len() - 1

                    while ri >= 0 {
                        x86.emit_pop_reg(
                            code,
                            x86.RCX,
                        )

                        if ri < vl_fields.len() {
                            var foff: int = el.payload_offset + (vl_fields[ri]).offset

                            x86.emit_mov_mem_base_disp_reg(
                                code,
                                x86.RAX,
                                foff,
                                x86.RCX,
                            )
                        }

                        ri = ri - 1
                    }

                    return Ok(void)
                }
            }
        }
        case None {
            return Err("native: unknown enum variant " + vname)
        }
    }
}

func emit_call_as_enum_variant(
    name: &string,
    args: &Vec<ast.Expression, _>,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    var enumOpt: Option<ast.EnumDecl> = find_enum_by_variant(
        &state.enums,
        name,
    )

    switch enumOpt {
        case Some(decl) {
            var layoutRes: Result<layout.EnumLayout, string> = layout.enum_layout(
                &decl,
                &state.structs,
            )

            switch layoutRes {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(el) {
                    var tag_val: int = find_variant_index(
                        &decl,
                        name,
                    )

                    if tag_val < 0 {
                        return Err("native: variant not found " + *name)
                    }

                    // Evaluate args and push on stack
                    mut var vi: int = 0

                    while vi < args.len() {
                        var res: Result<void, string> = emit_expr(
                            &(*args)[vi],
                            state,
                            code,
                        )

                        switch res {
                            case Err(msg) {
                                return Err(msg)
                            }
                            case Ok(_) {
                            }
                        }

                        x86.emit_push_reg(
                            code,
                            x86.RAX,
                        )
                        vi = vi + 1
                    }

                    // Align stack for call
                    mut var stack_pad: int = 0

                    if args.len() % 2 != 0 {
                        x86.emit_sub_rsp_imm8(
                            code,
                            8,
                        )
                        stack_pad = 8
                    }

                    // Allocate enum
                    x86.emit_mov_reg_imm32(
                        code,
                        x86.RDI,
                        el.size,
                    )

                    var call_site: int = code.len()

                    x86.emit_call_rel32(
                        code,
                        0,
                    )
                    add_call_patch(
                        state,
                        call_site + 1,
                        "__rt_alloc",
                    )

                    if stack_pad > 0 {
                        x86.emit_add_rsp_imm8(
                            code,
                            stack_pad,
                        )
                    }

                    // Set tag
                    x86.emit_mov_reg_imm32(
                        code,
                        x86.RCX,
                        tag_val,
                    )
                    x86.emit_mov_mem_base_disp_reg(
                        code,
                        x86.RAX,
                        0,
                        x86.RCX,
                    )

                    // Pop args in reverse and store at field offsets
                    mut var vl_fields: Vec<layout.FieldLayout, _> = Vec.new()
                    mut var _vli3: int = 0

                    while _vli3 < el.variants.len() {
                        if (el.variants[_vli3]).name == *name {
                            vl_fields = (el.variants[_vli3]).fields
                        }

                        _vli3 = _vli3 + 1
                    }

                    mut var ri: int = args.len() - 1

                    while ri >= 0 {
                        x86.emit_pop_reg(
                            code,
                            x86.RCX,
                        )

                        if ri < vl_fields.len() {
                            var foff: int = el.payload_offset + (vl_fields[ri]).offset

                            x86.emit_mov_mem_base_disp_reg(
                                code,
                                x86.RAX,
                                foff,
                                x86.RCX,
                            )
                        }

                        ri = ri - 1
                    }

                    return Ok(void)
                }
            }
        }
        case None {
            return Err("native: unknown enum variant " + *name)
        }
    }
}

func emit_fieldless_variant(
    name: &string,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // Check if this is None
    if *name == "None" {
        var opt_size: int = 16

        x86.emit_mov_reg_imm32(
            code,
            x86.RDI,
            opt_size,
        )

        var call_site: int = code.len()

        x86.emit_call_rel32(
            code,
            0,
        )
        add_call_patch(
            state,
            call_site + 1,
            "__rt_alloc",
        )
        x86.emit_mov_reg_imm32(
            code,
            x86.RCX,
            0,
        )
        x86.emit_mov_mem_base_disp_reg(
            code,
            x86.RAX,
            0,
            x86.RCX,
        )
        x86.emit_mov_mem_base_disp_reg(
            code,
            x86.RAX,
            8,
            x86.RCX,
        )

        return Ok(void)
    }

    // Check user-defined enums
    var enumOpt: Option<ast.EnumDecl> = find_enum_by_variant(
        &state.enums,
        name,
    )

    switch enumOpt {
        case Some(decl) {
            var layoutRes: Result<layout.EnumLayout, string> = layout.enum_layout(
                &decl,
                &state.structs,
            )

            switch layoutRes {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(el) {
                    var tag_val: int = find_variant_index(
                        &decl,
                        name,
                    )

                    if tag_val < 0 {
                        return Err("native: variant not found " + *name)
                    }

                    // Allocate enum and set tag (no payload)
                    x86.emit_mov_reg_imm32(
                        code,
                        x86.RDI,
                        el.size,
                    )

                    var call_site: int = code.len()

                    x86.emit_call_rel32(
                        code,
                        0,
                    )
                    add_call_patch(
                        state,
                        call_site + 1,
                        "__rt_alloc",
                    )
                    x86.emit_mov_reg_imm32(
                        code,
                        x86.RCX,
                        tag_val,
                    )
                    x86.emit_mov_mem_base_disp_reg(
                        code,
                        x86.RAX,
                        0,
                        x86.RCX,
                    )

                    return Ok(void)
                }
            }
        }
        case None {
            return Err("native: not an enum variant: " + *name)
        }
    }
}

// --- Enum binding helpers ---
func update_enum_binding(
    state: &mut BackendEmitState,
    name: string,
    kind: int,
    enum_name: string,
    payload_struct: string,
) -> (void) {
    if state.scopes.len() == 0 {
        return
    }

    mut var i: int = state.scopes.len() - 1

    while i >= 0 {
        mut var j: int = 0
        var n: int = (state.scopes[i]).enum_bindings.len()

        while j < n {
            if str_eq(
                &((state.scopes[i]).enum_bindings[j]).name,
                &name,
            ) {
                add_enum_binding(
                    state,
                    name,
                    kind,
                    enum_name,
                    payload_struct,
                )

                return
            }

            j = j + 1
        }

        if i == 0 {
            break
        }

        i = i - 1
    }

    (state.scopes[state.scopes.len() - 1]).enum_bindings.push(
        EnumBinding{
            enum_kind:      kind,
            enum_name:      enum_name,
            name:           name,
            payload_struct: payload_struct,
        },
    )

    return
}

func resolve_enum_binding(
    state: &mut BackendEmitState,
    name: &string,
) -> (Option<EnumBinding>) {
    if state.scopes.len() == 0 {
        return None
    }

    mut var i: int = state.scopes.len() - 1

    while i >= 0 {
        mut var j: int = 0
        var n: int = (state.scopes[i]).enum_bindings.len()

        while j < n {
            if str_eq(
                &((state.scopes[i]).enum_bindings[j]).name,
                name,
            ) {
                return Some((state.scopes[i]).enum_bindings[j])
            }

            j = j + 1
        }

        if i == 0 {
            break
        }

        i = i - 1
    }

    return None
}

func track_enum_binding_from_var(
    state: &mut BackendEmitState,
    name: string,
    typeOpt: &Option<ast.TypeExpression>,
    expr: &ast.Expression,
) -> (void) {
    mut var kind: int = -1
    mut var enum_name: string = ""
    mut var payload_struct: string = ""

    switch *typeOpt {
        case Some(t) {
            switch t {
                case ast.TypeExpression.Simple(st0) {
                    if st0.Name == "int" || st0.Name == "bool" || st0.Name == "char" || st0.Name == "string" || st0.Name == "void" {
                        return
                    }
                }
                case ast.TypeExpression.BorrowRef(bt0) {
                    switch bt0.Inner {
                        case ast.TypeExpression.Simple(stb0) {
                            if stb0.Name == "int" || stb0.Name == "bool" || stb0.Name == "char" || stb0.Name == "string" || stb0.Name == "void" {
                                return
                            }
                        }
                        default {
                        }
                    }
                }
                case ast.TypeExpression.Generic(gt) {
                    if gt.Name == "Vec" {
                        return
                    }

                    if gt.Name == "Option" {
                        kind = ENUM_KIND_OPTION
                        enum_name = "Option"

                        if gt.TypeParams.len() > 0 {
                            switch struct_name_from_type(
                                &gt.TypeParams[0],
                                state,
                            ) {
                                case Some(sn) {
                                    payload_struct = sn
                                }
                                case None {
                                }
                            }
                        }
                    } else if gt.Name == "Result" {
                        kind = ENUM_KIND_RESULT
                        enum_name = "Result"

                        if gt.TypeParams.len() > 0 {
                            switch struct_name_from_type(
                                &gt.TypeParams[0],
                                state,
                            ) {
                                case Some(sn2) {
                                    payload_struct = sn2
                                }
                                case None {
                                }
                            }
                        }
                    } else {
                        var enumOpt: Option<ast.EnumDecl> = find_enum_by_name(
                            &state.enums,
                            &gt.Name,
                        )

                        switch enumOpt {
                            case Some(_) {
                                kind = ENUM_KIND_CUSTOM
                                enum_name = gt.Name
                            }
                            case None {
                            }
                        }
                    }
                }
                case ast.TypeExpression.Simple(st) {
                    if st.Name == "Option" {
                        kind = ENUM_KIND_OPTION
                        enum_name = "Option"
                    } else if st.Name == "Result" {
                        kind = ENUM_KIND_RESULT
                        enum_name = "Result"
                    } else {
                        var enumOpt2: Option<ast.EnumDecl> = find_enum_by_name(
                            &state.enums,
                            &st.Name,
                        )

                        switch enumOpt2 {
                            case Some(_) {
                                kind = ENUM_KIND_CUSTOM
                                enum_name = st.Name
                            }
                            case None {
                            }
                        }
                    }
                }
                case ast.TypeExpression.BorrowRef(bt) {
                    switch bt.Inner {
                        case ast.TypeExpression.Generic(gt2) {
                            if gt2.Name == "Option" {
                                kind = ENUM_KIND_OPTION
                                enum_name = "Option"

                                if gt2.TypeParams.len() > 0 {
                                    switch struct_name_from_type(
                                        &gt2.TypeParams[0],
                                        state,
                                    ) {
                                        case Some(sn3) {
                                            payload_struct = sn3
                                        }
                                        case None {
                                        }
                                    }
                                }
                            } else if gt2.Name == "Result" {
                                kind = ENUM_KIND_RESULT
                                enum_name = "Result"

                                if gt2.TypeParams.len() > 0 {
                                    switch struct_name_from_type(
                                        &gt2.TypeParams[0],
                                        state,
                                    ) {
                                        case Some(sn4) {
                                            payload_struct = sn4
                                        }
                                        case None {
                                        }
                                    }
                                }
                            } else {
                                var enumOpt3: Option<ast.EnumDecl> = find_enum_by_name(
                                    &state.enums,
                                    &gt2.Name,
                                )

                                switch enumOpt3 {
                                    case Some(_) {
                                        kind = ENUM_KIND_CUSTOM
                                        enum_name = gt2.Name
                                    }
                                    case None {
                                    }
                                }
                            }
                        }
                        case ast.TypeExpression.Simple(st2) {
                            if st2.Name == "Option" {
                                kind = ENUM_KIND_OPTION
                                enum_name = "Option"
                            } else if st2.Name == "Result" {
                                kind = ENUM_KIND_RESULT
                                enum_name = "Result"
                            } else {
                                var enumOpt4: Option<ast.EnumDecl> = find_enum_by_name(
                                    &state.enums,
                                    &st2.Name,
                                )

                                switch enumOpt4 {
                                    case Some(_) {
                                        kind = ENUM_KIND_CUSTOM
                                        enum_name = st2.Name
                                    }
                                    case None {
                                    }
                                }
                            }
                        }
                        default {
                        }
                    }
                }
                default {
                }
            }
        }
        case None {
        }
    }

    if kind < 0 {
        switch *expr {
            case ast.Expression.EnumVariant(ev) {
                if ev.Variant.Value == "Some" || ev.Variant.Value == "None" {
                    kind = ENUM_KIND_OPTION
                    enum_name = "Option"
                } else if ev.Variant.Value == "Ok" || ev.Variant.Value == "Err" {
                    kind = ENUM_KIND_RESULT
                    enum_name = "Result"
                } else {
                    var enumOpt5: Option<ast.EnumDecl> = find_enum_by_variant(
                        &state.enums,
                        &ev.Variant.Value,
                    )

                    switch enumOpt5 {
                        case Some(decl) {
                            kind = ENUM_KIND_CUSTOM
                            enum_name = decl.Name.Value
                        }
                        case None {
                        }
                    }
                }
            }
            case ast.Expression.Identifier(id) {
                var ebOpt: Option<EnumBinding> = resolve_enum_binding(
                    state,
                    &id.Value,
                )

                switch ebOpt {
                    case Some(eb) {
                        kind = eb.enum_kind
                        enum_name = eb.enum_name
                        payload_struct = eb.payload_struct
                    }
                    case None {
                    }
                }
            }
            case ast.Expression.MutableIdentifier(id) {
                var ebOpt2: Option<EnumBinding> = resolve_enum_binding(
                    state,
                    &id.Value,
                )

                switch ebOpt2 {
                    case Some(eb2) {
                        kind = eb2.enum_kind
                        enum_name = eb2.enum_name
                        payload_struct = eb2.payload_struct
                    }
                    case None {
                    }
                }
            }
            default {
            }
        }
    }

    if kind >= 0 && enum_name != "" {
        update_enum_binding(
            state,
            name,
            kind,
            enum_name,
            payload_struct,
        )
    }

    return
}

func find_enum_by_name(
    enums: &Vec<ast.EnumDecl, _>,
    name: &string,
) -> (Option<ast.EnumDecl>) {
    mut var ei: int = 0

    while ei < enums.len() {
        var e: &ast.EnumDecl = &(*enums)[ei]

        if e.Name.Value == *name {
            return Some(*e)
        }

        ei = ei + 1
    }

    return None
}

func is_option_expr(
    expr: &ast.Expression,
    state: &mut BackendEmitState,
) -> (bool) {
    switch *expr {
        case ast.Expression.Identifier(id) {
            var ebOpt: Option<EnumBinding> = resolve_enum_binding(
                state,
                &id.Value,
            )

            switch ebOpt {
                case Some(eb) {
                    return eb.enum_kind == ENUM_KIND_OPTION
                }
                case None {
                }
            }

            var infoOpt: Option<IterableInfo> = iterable_info_from_binding(
                state,
                &id.Value,
            )

            switch infoOpt {
                case Some(info) {
                    return info.container_kind == CONTAINER_KIND_OPTION
                }
                case None {
                }
            }
        }
        case ast.Expression.MutableIdentifier(id) {
            var ebOpt: Option<EnumBinding> = resolve_enum_binding(
                state,
                &id.Value,
            )

            switch ebOpt {
                case Some(eb) {
                    return eb.enum_kind == ENUM_KIND_OPTION
                }
                case None {
                }
            }

            var infoOpt: Option<IterableInfo> = iterable_info_from_binding(
                state,
                &id.Value,
            )

            switch infoOpt {
                case Some(info) {
                    return info.container_kind == CONTAINER_KIND_OPTION
                }
                case None {
                }
            }
        }
        default {
        }
    }

    return false
}

func is_result_expr(
    expr: &ast.Expression,
