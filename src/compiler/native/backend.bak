func emit_method_call_time_namespace(
    mc: &ast.MethodCallExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    if mc.Method.Value == "nanos" {
        if mc.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_time_duration_nanos(
            &mc.Arguments[0],
            state,
            code,
        )
    }

    if mc.Method.Value == "micros" {
        if mc.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_time_duration_scaled(
            &mc.Arguments[0],
            1000,
            state,
            code,
        )
    }

    if mc.Method.Value == "millis" {
        if mc.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_time_duration_scaled(
            &mc.Arguments[0],
            1000000,
            state,
            code,
        )
    }

    if mc.Method.Value == "secs" {
        if mc.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_time_duration_scaled(
            &mc.Arguments[0],
            1000000000,
            state,
            code,
        )
    }

    if mc.Method.Value == "from_unix" {
        if mc.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_time_from_unix(
            &mc.Arguments[0],
            state,
            code,
        )
    }

    if mc.Method.Value == "from_unix_millis" {
        if mc.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_time_from_unix_millis(
            &mc.Arguments[0],
            state,
            code,
        )
    }

    if mc.Method.Value == "from_unix_nanos" {
        if mc.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_time_from_unix_nanos(
            &mc.Arguments[0],
            state,
            code,
        )
    }

    if mc.Method.Value == "monotonic_now" {
        if mc.Arguments.len() != 0 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_time_monotonic_now(
            state,
            code,
        )
    }

    if mc.Method.Value == "monotonic_since" {
        if mc.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_time_monotonic_since(
            &mc.Arguments[0],
            state,
            code,
        )
    }

    if mc.Method.Value == "sleep_ms" {
        if mc.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_time_sleep_ms(
            &mc.Arguments[0],
            state,
            code,
        )
    }

    if mc.Method.Value == "now" {
        if mc.Arguments.len() != 0 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_time_now(
            state,
            code,
        )
    }

    if mc.Method.Value == "now_ms" {
        if mc.Arguments.len() != 0 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        return emit_time_now_ms(
            state,
            code,
        )
    }

    return Err("native: unsupported time method " + mc.Method.Value)
}

func emit_option_method(
    mc: &ast.MethodCallExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    if mc.Method.Value == "is_some" {
        // Load object ptr, read tag, return tag == 1
        var res: Result<void, string> = emit_expr(
            &mc.Object,
            state,
            code,
        )

        switch res {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        x86.emit_mov_reg_mem_base_disp(
            code,
            x86.RAX,
            x86.RAX,
            0,
        )
        // tag
        x86.emit_mov_reg_imm32(
            code,
            x86.RCX,
            1,
        )
        x86.emit_cmp_reg_reg(
            code,
            x86.RAX,
            x86.RCX,
        )
        x86.emit_sete(code)
        x86.emit_movzx_rax_al(code)

        return Ok(void)
    }

    if mc.Method.Value == "is_none" {
        var res: Result<void, string> = emit_expr(
            &mc.Object,
            state,
            code,
        )

        switch res {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        x86.emit_mov_reg_mem_base_disp(
            code,
            x86.RAX,
            x86.RAX,
            0,
        )
        // tag
        x86.emit_test_reg_reg(
            code,
            x86.RAX,
            x86.RAX,
        )
        x86.emit_sete(code)
        x86.emit_movzx_rax_al(code)

        return Ok(void)
    }

    if mc.Method.Value == "unwrap" {
        // Load ptr, check tag. If 0 (None) -> panic. If 1 (Some) -> return payload.
        var res: Result<void, string> = emit_expr(
            &mc.Object,
            state,
            code,
        )

        switch res {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        x86.emit_mov_reg_reg(
            code,
            x86.R8,
            x86.RAX,
        )
        // save ptr
        x86.emit_mov_reg_mem_base_disp(
            code,
            x86.RAX,
            x86.R8,
            0,
        )
        // tag
        x86.emit_test_reg_reg(
            code,
            x86.RAX,
            x86.RAX,
        )

        var jnz_ok: int = emit_jnz_placeholder(code)
        // tag == 0 -> panic
        var panicRes: Result<void, string> = emit_panic_string(
            "unwrap called on None",
            state,
            code,
        )

        switch panicRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        // tag != 0 -> load payload
        var ok_pos: int = code.len()

        patch_rel32(
            code,
            jnz_ok,
            ok_pos,
        )
        x86.emit_mov_reg_mem_base_disp(
            code,
            x86.RAX,
            x86.R8,
            8,
        )

        // payload at offset 8
        return Ok(void)
    }

    if mc.Method.Value == "unwrapOr" {
        if mc.Arguments.len() != 1 {
            return Err(ERR_NATIVE_BAD_ARGS)
        }

        // Evaluate default value first, save it
        var resDefault: Result<void, string> = emit_expr(
            &mc.Arguments[0],
            state,
            code,
        )

        switch resDefault {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        x86.emit_push_reg(
            code,
            x86.RAX,
        )

        // save default
        // Evaluate option
        var resObj: Result<void, string> = emit_expr(
            &mc.Object,
            state,
            code,
        )

        switch resObj {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        x86.emit_mov_reg_reg(
            code,
            x86.R8,
            x86.RAX,
        )
        // option ptr
        x86.emit_mov_reg_mem_base_disp(
            code,
            x86.RAX,
            x86.R8,
            0,
        )
        // tag
        x86.emit_test_reg_reg(
            code,
            x86.RAX,
            x86.RAX,
        )

        var jz_none: int = emit_jz_placeholder(code)

        // Some: load payload, discard default
        x86.emit_mov_reg_mem_base_disp(
            code,
            x86.RAX,
            x86.R8,
            8,
        )
        x86.emit_add_rsp_imm8(
            code,
            8,
        )

        // discard default
        var jmp_done: int = emit_jmp_placeholder(code)
        // None: use default
        var none_pos: int = code.len()

        patch_rel32(
            code,
            jz_none,
            none_pos,
        )
        x86.emit_pop_reg(
            code,
            x86.RAX,
        )

        // default value
        var done_pos: int = code.len()

        patch_rel32(
            code,
            jmp_done,
            done_pos,
        )

        return Ok(void)
    }

    return Err("native: unsupported Option method " + mc.Method.Value)
}

func emit_result_method(
    mc: &ast.MethodCallExpression,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    if mc.Method.Value == "is_ok" {
        var res: Result<void, string> = emit_expr(
            &mc.Object,
            state,
            code,
        )

        switch res {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        x86.emit_mov_reg_mem_base_disp(
            code,
            x86.RAX,
            x86.RAX,
            0,
        )
        // tag
        x86.emit_mov_reg_imm32(
            code,
            x86.RCX,
            1,
        )
        x86.emit_cmp_reg_reg(
            code,
            x86.RAX,
            x86.RCX,
        )
        x86.emit_sete(code)
        x86.emit_movzx_rax_al(code)

        return Ok(void)
    }

    if mc.Method.Value == "is_err" {
        var res: Result<void, string> = emit_expr(
            &mc.Object,
            state,
            code,
        )

        switch res {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        x86.emit_mov_reg_mem_base_disp(
            code,
            x86.RAX,
            x86.RAX,
            0,
        )
        // tag
        x86.emit_test_reg_reg(
            code,
            x86.RAX,
            x86.RAX,
        )
        x86.emit_sete(code)
        x86.emit_movzx_rax_al(code)

        return Ok(void)
    }

    if mc.Method.Value == "unwrap" {
        var res: Result<void, string> = emit_expr(
            &mc.Object,
            state,
            code,
        )

        switch res {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        x86.emit_mov_reg_reg(
            code,
            x86.R8,
            x86.RAX,
        )
        x86.emit_mov_reg_mem_base_disp(
            code,
            x86.RAX,
            x86.R8,
            0,
        )
        // tag
        x86.emit_test_reg_reg(
            code,
            x86.RAX,
            x86.RAX,
        )

        var jnz_ok: int = emit_jnz_placeholder(code)
        // tag == 0 -> Err -> panic
        var panicRes: Result<void, string> = emit_panic_string(
            "unwrap called on Err",
            state,
            code,
        )

        switch panicRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        var ok_pos: int = code.len()

        patch_rel32(
            code,
            jnz_ok,
            ok_pos,
        )
        x86.emit_mov_reg_mem_base_disp(
            code,
            x86.RAX,
            x86.R8,
            8,
        )

        // ok payload
        return Ok(void)
    }

    if mc.Method.Value == "unwrap_err" {
        var res: Result<void, string> = emit_expr(
            &mc.Object,
            state,
            code,
        )

        switch res {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        x86.emit_mov_reg_reg(
            code,
            x86.R8,
            x86.RAX,
        )
        x86.emit_mov_reg_mem_base_disp(
            code,
            x86.RAX,
            x86.R8,
            0,
        )
        // tag
        x86.emit_test_reg_reg(
            code,
            x86.RAX,
            x86.RAX,
        )

        var jz_err: int = emit_jz_placeholder(code)
        // tag != 0 -> Ok -> panic
        var panicRes: Result<void, string> = emit_panic_string(
            "unwrap_err called on Ok",
            state,
            code,
        )

        switch panicRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }

        var err_pos: int = code.len()

        patch_rel32(
            code,
            jz_err,
            err_pos,
        )
        x86.emit_mov_reg_mem_base_disp(
            code,
            x86.RAX,
            x86.R8,
            16,
        )

        // err payload at offset 16
        return Ok(void)
    }

    return Err("native: unsupported Result method " + mc.Method.Value)
}

func emit_panic_string(
    msg: string,
    state: &mut BackendEmitState,
    mut code: &mut Vec<int, _>,
) -> (Result<void, string>) {
    // Create a string literal in data section and call __rt_panic
    var resStr: Result<void, string> = emit_string_literal(
        &msg,
        state,
        code,
    )

    switch resStr {
        case Err(emsg) {
            return Err(emsg)
        }
        case Ok(_) {
        }
    }

    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.RAX,
    )

    var call_site: int = code.len()

    x86.emit_call_rel32(
        code,
        0,
    )
    add_call_patch(
        state,
        call_site + 1,
        "__rt_panic",
    )

    return Ok(void)
}

func emit_jnz_placeholder(mut code: &mut Vec<int, _>) -> (int) {
    var start: int = code.len()

    x86.emit_jnz_rel32(
        code,
        0,
    )

    return start + 2
}

func is_vec_expr(
    expr: &ast.Expression,
    state: &mut BackendEmitState,
) -> (bool) {
    var infoOpt: Option<IterableInfo> = iterable_elem_info(
        expr,
        &None,
        state,
    )

    switch infoOpt {
        case Some(info) {
            return info.container_kind == CONTAINER_KIND_VEC
        }
        case None {
        }
    }

    return false
}

func local_name_hash(name: &string) -> (int) {
    mut var h: int = 2166136261
    mut var i: int = 0

    while i < name.len() {
        h = h ^ int(name[i])
        h = h * 16777619
        i = i + 1
    }

    if h < 0 {
        h = -h
    }

    return h
}

func is_float_expr(
    expr: &ast.Expression,
    state: &mut BackendEmitState,
) -> (bool) {
    switch *expr {
        case ast.Expression.FloatLiteral(_) {
            return true
        }
        case ast.Expression.Identifier(id) {
            switch resolve_local_type(
                state,
                &id.Value,
            ) {
                case Some(tname) {
                    return is_float_type_name(&tname)
                }
                case None {
                }
            }
        }
        case ast.Expression.MutableIdentifier(id) {
            switch resolve_local_type(
                state,
                &id.Value,
            ) {
                case Some(tname) {
                    return is_float_type_name(&tname)
                }
                case None {
                }
            }
        }
        case ast.Expression.Infix(ie) {
            if ie.Operator == "+" || ie.Operator == "-" || ie.Operator == "*" || ie.Operator == "/" {
                return is_float_expr(
                    &ie.Left,
                    state,
                ) || is_float_expr(
                    &ie.Right,
                    state,
                )
            }
        }
        case ast.Expression.TypeConversion(tc) {
            return is_float_type_name(&tc.TypeName)
        }
        default {
        }
    }

    return false
}

func is_string_expr(
    expr: &ast.Expression,
    state: &mut BackendEmitState,
) -> (bool) {
    switch *expr {
        case ast.Expression.StringLiteral(_) {
            return true
        }
        case ast.Expression.Identifier(id) {
            var kindOpt: Option<int> = resolve_iterable_container_kind(
                state,
                &id.Value,
            )

            switch kindOpt {
                case Some(kind) {
                    return kind == CONTAINER_KIND_STRING
                }
                case None {
                }
            }

            var localTypeOpt: Option<string> = resolve_local_type(
                state,
                &id.Value,
            )

            switch localTypeOpt {
                case Some(localType) {
                    return localType == "string"
                }
                case None {
                }
            }
        }
        case ast.Expression.MutableIdentifier(id) {
            var kindOpt: Option<int> = resolve_iterable_container_kind(
                state,
                &id.Value,
            )

            switch kindOpt {
                case Some(kind) {
                    return kind == CONTAINER_KIND_STRING
                }
                case None {
                }
            }

            var localTypeOpt: Option<string> = resolve_local_type(
                state,
                &id.Value,
            )

            switch localTypeOpt {
                case Some(localType) {
                    return localType == "string"
                }
                case None {
                }
            }
        }
        case ast.Expression.Index(ie) {
            // e.g. args[1] where args is Vec<string> -> element is string
            var objInfo: Option<IterableInfo> = iterable_elem_info(
                &ie.Left,
                &None,
                state,
            )

            switch objInfo {
                case Some(info) {
                    if info.kind == ELEM_KIND_STRING {
                        return true
                    }
                }
                case None {
                }
            }
        }
        case ast.Expression.Infix(ie) {
            if ie.Operator == "+" {
                return is_string_expr(
                    &ie.Left,
                    state,
                ) || is_string_expr(
                    &ie.Right,
                    state,
                )
            }
        }
        case ast.Expression.MethodCall(mc) {
            if mc.Method.Value == "substring" || mc.Method.Value == "to_string" || mc.Method.Value == "toString" || mc.Method.Value == "trim" || mc.Method.Value == "to_lowercase" || mc.Method.Value == "to_uppercase" {
                return true
            }

            // If the receiver is a string and the method returns a string
            if is_string_expr(
                &mc.Object,
                state,
            ) {
                if mc.Method.Value == "substring" {
                    return true
                }
            }
        }
        case ast.Expression.Call(ce) {
            // Module-qualified calls that return strings
            switch ce.Function {
                case ast.Expression.Identifier(id) {
                    if id.Value == "strconv.intToString" || id.Value == "strconv.int_to_string" {
                        return true
                    }

                    if id.Value == "fs.base" || id.Value == "fs.join" || id.Value == "fs.dir" {
                        return true
                    }

                    var string_name: string = "string"

                    if function_returns_type(
                        state,
                        &id.Value,
                        &string_name,
                    ) {
                        return true
                    }
                }
                case ast.Expression.MutableIdentifier(id) {
                    var string_name2: string = "string"

                    if function_returns_type(
                        state,
                        &id.Value,
                        &string_name2,
                    ) {
                        return true
                    }
                }
                case ast.Expression.FieldAccess(fe) {
                    switch qualified_field_access_name(&fe) {
                        case Some(qname) {
                            var string_name3: string = "string"

                            if function_returns_type(
                                state,
                                &qname,
                                &string_name3,
                            ) {
                                return true
                            }
                        }
                        case None {
                        }
                    }

                    var string_name4: string = "string"

                    if function_returns_type(
                        state,
                        &fe.Field.Value,
                        &string_name4,
                    ) {
                        return true
                    }
                }
                default {
                }
            }
        }
        case ast.Expression.TypeConversion(tc) {
            if tc.TypeName == "string" {
                return true
            }
        }
        case ast.Expression.Prefix(pe) {
            // Dereference *x: if the inner expression is a string, so is the deref
            if pe.Operator == "*" {
                return is_string_expr(
                    &pe.Right,
                    state,
                )
            }
        }
        case ast.Expression.FieldAccess(fe) {
            // Check if the field type is string by looking up struct declaration
            mut var structOpt: Option<string> = struct_literal_name(
                &fe.Object,
                state,
            )

            if structOpt.is_none() {
                structOpt = fallback_struct_name_by_field_name(
                    &fe.Field.Value,
                    &state.structs,
                )
            }

            switch structOpt {
                case Some(struct_name) {
                    var declOpt: Option<ast.StructDecl> = find_struct_decl(
                        &state.structs,
                        &struct_name,
                    )

                    switch declOpt {
                        case Some(decl) {
                            var fieldOpt: Option<ast.StructField> = find_struct_field(
                                &decl,
                                &fe.Field.Value,
                            )

                            switch fieldOpt {
                                case Some(field_decl) {
                                    switch field_decl.Type {
                                        case ast.TypeExpression.Simple(st) {
                                            if st.Name == "string" {
                                                return true
                                            }
                                        }
                                        default {
                                        }
                                    }
                                }
                                case None {
                                }
                            }
                        }
                        case None {
                        }
                    }
                }
                case None {
                }
            }

            // Fallback: scan all structs for a matching field name
            mut var _sdi: int = 0

            while _sdi < state.structs.len() {
                var sd: ast.StructDecl = state.structs[_sdi]
                mut var _fi: int = 0

                while _fi < sd.Fields.len() {
                    var f: ast.StructField = sd.Fields[_fi]

                    if f.Name.Value == fe.Field.Value {
                        switch f.Type {
                            case ast.TypeExpression.Simple(st) {
                                if st.Name == "string" {
                                    return true
                                }
                            }
                            default {
                            }
                        }
                    }

                    _fi = _fi + 1
                }

                _sdi = _sdi + 1
            }
        }
        default {
        }
    }

    var infoOpt: Option<IterableInfo> = iterable_elem_info(
        expr,
        &None,
        state,
    )

    switch infoOpt {
        case Some(info) {
            return info.container_kind == CONTAINER_KIND_STRING && info.kind == ELEM_KIND_STRING
        }
        case None {
        }
    }

    return false
}

func is_time_duration_expr(
    expr: &ast.Expression,
    state: &mut BackendEmitState,
) -> (bool) {
    var nameOpt: Option<string> = struct_literal_name(
        expr,
        state,
