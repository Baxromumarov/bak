package native

// Minimal runtime syscall stubs emitted as machine code.
// These are emitted into the code buffer before user functions and
// registered as callable symbols: __rt_write, __rt_exit, __rt_panic, __rt_println_str,
// __rt_brk, __rt_mmap, __rt_alloc, __rt_realloc, __rt_itoa.
import "src/compiler/native/x86_64.bak" as x86

func patch_runtime_u32(mut code: &mut Vec<int, _>, idx: int, v: int) -> (void) {
    var n: int = code.len()

    if n == 0 {
        return
    }

    if idx < 0 {
        return
    }

    if idx >= n {
        return
    }

    if idx + 1 >= n {
        return
    }

    if idx + 2 >= n {
        return
    }

    if idx + 3 >= n {
        return
    }

    mut var p: int = idx

    code[p] = v & 0xff
    p = p + 1
    code[p] = v >> 8 & 0xff
    p = p + 1
    code[p] = v >> 16 & 0xff
    p = p + 1
    code[p] = v >> 24 & 0xff

    return
}

func patch_runtime_rel32(
    mut code: &mut Vec<int, _>,
    imm_offset: int,
    target: int,
) -> (void) {
    var n: int = code.len()

    if n == 0 {
        return
    }

    if imm_offset < 0 {
        return
    }

    if imm_offset >= n {
        return
    }

    if imm_offset + 1 >= n {
        return
    }

    if imm_offset + 2 >= n {
        return
    }

    if imm_offset + 3 >= n {
        return
    }

    var rel: int = target - (imm_offset + 4)

    patch_runtime_u32(
        code,
        imm_offset,
        rel,
    )

    return
}

func emit_raw_syscall(mut code: &mut Vec<int, _>) -> (void) {
    code.push(0x0f)
    code.push(0x05)

    return
}

// emit_runtime_write emits __rt_write(fd: int, buf: *u8, len: int) -> int.
// Args already in SysV positions: rdi=fd, rsi=buf, rdx=len.
pub func emit_runtime_write(mut code: &mut Vec<int, _>) -> (void) {
    x86.emit_push_reg(
        code,
        x86.RBP,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RBP,
        x86.RSP,
    )
    x86.emit_mov_rax_imm32(
        code,
        1,
    )
    // syscall write
    emit_raw_syscall(code)
    x86.emit_mov_reg_reg(
        code,
        x86.RSP,
        x86.RBP,
    )
    x86.emit_pop_reg(
        code,
        x86.RBP,
    )
    x86.emit_ret(code)
}

// emit_runtime_exit emits __rt_exit(code: int) -> noreturn.
// code in rdi.
pub func emit_runtime_exit(mut code: &mut Vec<int, _>) -> (void) {
    x86.emit_mov_rax_imm32(
        code,
        60,
    )
    emit_raw_syscall(code)
}

// emit_runtime_println_str emits __rt_println_str(str_header: *{ptr,len}) -> void.
// str_header in rdi points to {ptr: *u8, len: int} (16 bytes).
// Writes the string bytes to stdout followed by a newline.
pub func emit_runtime_println_str(mut code: &mut Vec<int, _>) -> (void) {
    x86.emit_push_reg(
        code,
        x86.RBP,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RBP,
        x86.RSP,
    )
    x86.emit_sub_rsp_imm8(
        code,
        16,
    )
    // Load ptr and len from the string header at [rdi]
    // rdi points to {ptr: u64, len: u64}
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RSI,
        x86.RDI,
        0,
    )
    // rsi = ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RDX,
        x86.RDI,
        8,
    )
    // rdx = len
    // write(1, ptr, len)
    x86.emit_mov_rdi_imm32(
        code,
        1,
    )
    // fd = stdout
    x86.emit_mov_rax_imm32(
        code,
        1,
    )
    // syscall write
    emit_raw_syscall(code)
    // Write newline: store 0x0a on stack, write 1 byte
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        0x0a,
    )
    x86.emit_mov_mem_rbp_reg(
        code,
        -8,
        x86.RAX,
    )
    // lea rsi, [rbp-8]
    x86.emit_mov_reg_reg(
        code,
        x86.RSI,
        x86.RBP,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        8,
    )
    x86.emit_sub_reg_reg(
        code,
        x86.RSI,
        x86.RAX,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDX,
        1,
    )
    // len = 1
    x86.emit_mov_rdi_imm32(
        code,
        1,
    )
    // fd = stdout
    x86.emit_mov_rax_imm32(
        code,
        1,
    )
    // syscall write
    emit_raw_syscall(code)
    x86.emit_mov_reg_reg(
        code,
        x86.RSP,
        x86.RBP,
    )
    x86.emit_pop_reg(
        code,
        x86.RBP,
    )
    x86.emit_ret(code)
}

// emit_runtime_print_str emits __rt_print_str(str_header: *{ptr,len}) -> void.
// Same as println_str but without the trailing newline.
pub func emit_runtime_print_str(mut code: &mut Vec<int, _>) -> (void) {
    x86.emit_push_reg(
        code,
        x86.RBP,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RBP,
        x86.RSP,
    )
    // Load ptr and len from the string header at [rdi]
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RSI,
        x86.RDI,
        0,
    )
    // rsi = ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RDX,
        x86.RDI,
        8,
    )
    // rdx = len
    // write(1, ptr, len)
    x86.emit_mov_rdi_imm32(
        code,
        1,
    )
    // fd = stdout
    x86.emit_mov_rax_imm32(
        code,
        1,
    )
    // syscall write
    emit_raw_syscall(code)
    x86.emit_mov_reg_reg(
        code,
        x86.RSP,
        x86.RBP,
    )
    x86.emit_pop_reg(
        code,
        x86.RBP,
    )
    x86.emit_ret(code)
}

// emit_runtime_panic emits __rt_panic(str_header: *{ptr,len}) -> noreturn.
// str_header in rdi points to {ptr: *u8, len: int} (16 bytes).
// Writes the message to stderr followed by a newline, then exits with code 1.
pub func emit_runtime_panic(mut code: &mut Vec<int, _>) -> (void) {
    x86.emit_push_reg(
        code,
        x86.RBP,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RBP,
        x86.RSP,
    )
    x86.emit_sub_rsp_imm8(
        code,
        16,
    )
    // Null panic payload: skip message write and only emit newline + exit.
    x86.emit_test_reg_reg(
        code,
        x86.RDI,
        x86.RDI,
    )

    var jz_skip_msg: int = code.len()

    x86.emit_jz_rel32(
        code,
        0,
    )
    // Load ptr and len from string header at [rdi]
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RSI,
        x86.RDI,
        0,
    )
    // rsi = ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RDX,
        x86.RDI,
        8,
    )
    // rdx = len
    // write(2, ptr, len)  -- fd=2 for stderr
    x86.emit_mov_rdi_imm32(
        code,
        2,
    )
    // fd = stderr
    x86.emit_mov_rax_imm32(
        code,
        1,
    )
    // syscall write
    emit_raw_syscall(code)

    var skip_msg_pos: int = code.len()

    patch_runtime_rel32(
        code,
        jz_skip_msg + 2,
        skip_msg_pos,
    )
    // Write newline to stderr
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        0x0a,
    )
    x86.emit_mov_mem_rbp_reg(
        code,
        -8,
        x86.RAX,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RSI,
        x86.RBP,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        8,
    )
    x86.emit_sub_reg_reg(
        code,
        x86.RSI,
        x86.RAX,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDX,
        1,
    )
    x86.emit_mov_rdi_imm32(
        code,
        2,
    )
    // fd = stderr
    x86.emit_mov_rax_imm32(
        code,
        1,
    )
    // syscall write
    emit_raw_syscall(code)
    // Exit with code 1
    x86.emit_mov_rdi_imm32(
        code,
        1,
    )
    x86.emit_mov_rax_imm32(
        code,
        60,
    )
    emit_raw_syscall(code)
}

// emit_runtime_brk emits __rt_brk(addr: *u8) -> *u8.
// addr in rdi.
pub func emit_runtime_brk(mut code: &mut Vec<int, _>) -> (void) {
    x86.emit_mov_rax_imm32(
        code,
        12,
    )
    emit_raw_syscall(code)
    x86.emit_ret(code)
}

// emit_runtime_mmap emits __rt_mmap(addr, len, prot, flags, fd, off) -> *u8.
// Args in rdi, rsi, rdx, rcx, r8, r9.
pub func emit_runtime_mmap(mut code: &mut Vec<int, _>) -> (void) {
    x86.emit_push_reg(
        code,
        x86.RBP,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RBP,
        x86.RSP,
    )
    // Linux syscall expects flags in r10 instead of rcx.
    x86.emit_mov_reg_reg(
        code,
        x86.R10,
        x86.RCX,
    )
    x86.emit_mov_rax_imm32(
        code,
        9,
    )
    emit_raw_syscall(code)
    x86.emit_mov_reg_reg(
        code,
        x86.RSP,
        x86.RBP,
    )
    x86.emit_pop_reg(
        code,
        x86.RBP,
    )
    x86.emit_ret(code)
}

// emit_runtime_alloc emits __rt_alloc(size: int) -> *u8.
// size in rdi. Uses brk-based bump allocation with 8-byte alignment.
pub func emit_runtime_alloc(mut code: &mut Vec<int, _>) -> (void) {
    x86.emit_push_reg(
        code,
        x86.RBP,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RBP,
        x86.RSP,
    )
    x86.emit_push_reg(
        code,
        x86.RBX,
    )
    x86.emit_push_reg(
        code,
        x86.RDI,
    )
    // save size in stack
    // brk(0) -> current break in rax
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        12,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        0,
    )
    emit_raw_syscall(code)
    // rax = current brk (old break)
    // Align to 8 bytes: aligned = (old_break + 7) & ~7
    x86.emit_add_reg_imm8(
        code,
        x86.RAX,
        7,
    )
    // AND rax, -8 (sign-extended imm8): REX.W 0x83 /4 0xF8
    code.push(0x48)
    code.push(0x83)
    code.push(0xE0)
    code.push(0xF8)
    x86.emit_mov_reg_reg(
        code,
        x86.RBX,
        x86.RAX,
    )
    // rbx = aligned base (our return value)
    // new_brk = aligned_base + size
    x86.emit_pop_reg(
        code,
        x86.RCX,
    )
    // restore size
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.RBX,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RDI,
        x86.RCX,
    )
    x86.emit_mov_rax_imm32(
        code,
        12,
    )
    emit_raw_syscall(code)
    // return aligned base
    x86.emit_mov_reg_reg(
        code,
        x86.RAX,
        x86.RBX,
    )
    x86.emit_pop_reg(
        code,
        x86.RBX,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RSP,
        x86.RBP,
    )
    x86.emit_pop_reg(
        code,
        x86.RBP,
    )
    x86.emit_ret(code)
}

// emit_runtime_realloc emits __rt_realloc(old_ptr, old_size, new_size) -> *u8.
// old_ptr in rdi, old_size in rsi, new_size in rdx.
// Allocates via __rt_alloc (bump allocator safe), then copies old data.
pub func emit_runtime_realloc(
    mut code: &mut Vec<int, _>,
    alloc_off: int,
) -> (void) {
    x86.emit_push_reg(
        code,
        x86.RBP,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RBP,
        x86.RSP,
    )
    x86.emit_sub_rsp_imm8(
        code,
        48,
    )
    // Save args to stack
    x86.emit_mov_mem_rbp_reg(
        code,
        -8,
        x86.RDI,
    )
    x86.emit_mov_mem_rbp_reg(
        code,
        -16,
        x86.RSI,
    )
    x86.emit_mov_mem_rbp_reg(
        code,
        -24,
        x86.RDX,
    )
    // Call __rt_alloc(new_size): rdi = new_size (rdx)
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.RDX,
    )

    var call_site: int = code.len()

    code.push(0xE8)

    var disp: int = alloc_off - (call_site + 5)

    code.push(disp & 0xff)
    code.push(disp >> 8 & 0xff)
    code.push(disp >> 16 & 0xff)
    code.push(disp >> 24 & 0xff)
    // Save new_ptr
    x86.emit_mov_mem_rbp_reg(
        code,
        -32,
        x86.RAX,
    )
    // memcpy(dest=new_ptr, src=old_ptr, count=min(old_size,new_size))
    // Skip copy for null/invalid old pointers.
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RSI,
        x86.RBP,
        -8,
    )
    x86.emit_test_reg_reg(
        code,
        x86.RSI,
        x86.RSI,
    )

    var jz_skip_copy_null: int = code.len()
    x86.emit_jz_rel32(
        code,
        0,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RCX,
        x86.RBP,
        -16,
    )
    x86.emit_test_reg_reg(
        code,
        x86.RCX,
        x86.RCX,
    )

    var jz_skip_copy_zero: int = code.len()
    x86.emit_jz_rel32(
        code,
        0,
    )
    x86.emit_mov_rax_imm32(
        code,
        0x400000,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.RSI,
        x86.RAX,
    )
    x86.emit_setl(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_skip_copy_low: int = code.len()
    x86.emit_jnz_rel32(
        code,
        0,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RDX,
        x86.RBP,
        -24,
    )
    x86.emit_cmp_reg_reg(
        code,
        x86.RCX,
        x86.RDX,
    )
    x86.emit_setle(code)
    x86.emit_movzx_rax_al(code)
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_copy_count_ok: int = code.len()
    x86.emit_jnz_rel32(
        code,
        0,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RCX,
        x86.RDX,
    )

    var copy_count_ok: int = code.len()
    patch_runtime_rel32(
        code,
        jnz_copy_count_ok + 2,
        copy_count_ok,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RDI,
        x86.RBP,
        -32,
    )
    x86.emit_rep_movsb(code)

    var skip_copy: int = code.len()
    patch_runtime_rel32(
        code,
        jz_skip_copy_null + 2,
        skip_copy,
    )
    patch_runtime_rel32(
        code,
        jz_skip_copy_zero + 2,
        skip_copy,
    )
    patch_runtime_rel32(
        code,
        jnz_skip_copy_low + 2,
        skip_copy,
    )
    // Return new_ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RAX,
        x86.RBP,
        -32,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RSP,
        x86.RBP,
    )
    x86.emit_pop_reg(
        code,
        x86.RBP,
    )
    x86.emit_ret(code)
}

// emit_runtime_itoa emits __rt_itoa(value: int) -> *{ptr, len}.
// alloc_offset is the absolute offset of __rt_alloc in the shared code buffer.
pub func emit_runtime_itoa(
    mut code: &mut Vec<int, _>,
    alloc_offset: int,
) -> (void) {
    // Full itoa: converts int in RDI to a heap-allocated string {ptr, len}.
    // Uses mmap for allocation (self-contained, no call patches needed).
    // prologue
    x86.emit_push_reg(
        code,
        x86.RBP,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RBP,
        x86.RSP,
    )
    x86.emit_sub_rsp_imm8(
        code,
        64,
    )
    // Save callee-saved registers
    x86.emit_push_reg(
        code,
        x86.R12,
    )
    x86.emit_push_reg(
        code,
        x86.R13,
    )
    x86.emit_push_reg(
        code,
        x86.R14,
    )
    x86.emit_push_reg(
        code,
        x86.R15,
    )
    // r12 = value, r13 = is_negative
    x86.emit_mov_reg_reg(
        code,
        x86.R12,
        x86.RDI,
    )
    x86.emit_xor_reg_reg(
        code,
        x86.R13,
        x86.R13,
    )
    // test r12, r12 (check sign)
    x86.emit_test_reg_reg(
        code,
        x86.R12,
        x86.R12,
    )

    // jns +N (skip negate) — 0x79 rel8
    var jns_pos: int = code.len()

    code.push(0x79)
    code.push(0x00)
    // Negative: r13 = 1, negate r12
    x86.emit_mov_reg_imm32(
        code,
        x86.R13,
        1,
    )
    x86.emit_neg_reg(
        code,
        x86.R12,
    )

    // Patch jns
    var not_neg_pos: int = code.len()

    code[jns_pos + 1] = not_neg_pos - jns_pos - 2
    // r14 = end of stack buffer area, r15 = write position
    x86.emit_lea_reg_mem_rbp(
        code,
        x86.R14,
        -12,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.R15,
        x86.R14,
    )
    // test r12, r12 (check zero)
    x86.emit_test_reg_reg(
        code,
        x86.R12,
        x86.R12,
    )

    // jnz to digit_loop — 0x0F 0x85 rel32
    var jnz_loop_pos: int = code.len()

    code.push(0x0f)
    code.push(0x85)
    code.push(0x00)
    code.push(0x00)
    code.push(0x00)
    code.push(0x00)
    // Zero case: store '0'
    // sub r15, 1
    code.push(0x49)
    code.push(0x83)
    code.push(0xc7)
    code.push(0xff)
    // mov byte [r15], 48 ('0')
    code.push(0x41)
    code.push(0xc6)
    code.push(0x07)
    code.push(48)

    // jmp done_digits
    var jmp_done_pos: int = code.len()

    code.push(0xe9)
    code.push(0x00)
    code.push(0x00)
    code.push(0x00)
    code.push(0x00)

    // digit_loop:
    var loop_start: int = code.len()

    patch_runtime_rel32(
        code,
        jnz_loop_pos + 2,
        loop_start,
    )
    // test r12, r12
    x86.emit_test_reg_reg(
        code,
        x86.R12,
        x86.R12,
    )

    // jz end_loop
    var jz_end_pos: int = code.len()

    code.push(0x0f)
    code.push(0x84)
    code.push(0x00)
    code.push(0x00)
    code.push(0x00)
    code.push(0x00)
    // xor rdx, rdx
    x86.emit_xor_reg_reg(
        code,
        x86.RDX,
        x86.RDX,
    )
    // mov rax, r12
    x86.emit_mov_reg_reg(
        code,
        x86.RAX,
        x86.R12,
    )
    // mov rcx, 10
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        10,
    )
    // idiv rcx (rax = quotient, rdx = remainder)
    x86.emit_idiv_reg(
        code,
        x86.RCX,
    )
    // mov r12, rax (quotient)
    x86.emit_mov_reg_reg(
        code,
        x86.R12,
        x86.RAX,
    )
    // add rdx, 48 ('0')
    x86.emit_add_reg_imm8(
        code,
        x86.RDX,
        48,
    )
    // sub r15, 1
    code.push(0x49)
    code.push(0x83)
    code.push(0xc7)
    code.push(0xff)
    // mov byte [r15], dl
    code.push(0x41)
    code.push(0x88)
    code.push(0x17)

    // jmp loop_start
    var jmp_loop_pos: int = code.len()

    code.push(0xe9)
    code.push(0x00)
    code.push(0x00)
    code.push(0x00)
    code.push(0x00)
    patch_runtime_rel32(
        code,
        jmp_loop_pos + 1,
        loop_start,
    )

    // done_digits:
    var done_pos: int = code.len()

    patch_runtime_rel32(
        code,
        jz_end_pos + 2,
        done_pos,
    )
    patch_runtime_rel32(
        code,
        jmp_done_pos + 1,
        done_pos,
    )
    // Add '-' if negative
    x86.emit_test_reg_reg(
        code,
        x86.R13,
        x86.R13,
    )

    // jz skip_minus
    var jz_nominus_pos: int = code.len()

    code.push(0x74)
    code.push(0x00)
    // sub r15, 1
    code.push(0x49)
    code.push(0x83)
    code.push(0xc7)
    code.push(0xff)
    // mov byte [r15], '-' (45)
    code.push(0x41)
    code.push(0xc6)
    code.push(0x07)
    code.push(45)

    // Patch jz skip_minus
    var skip_minus_pos: int = code.len()

    code[jz_nominus_pos + 1] = skip_minus_pos - jz_nominus_pos - 2
    // Length = r14 - r15
    x86.emit_mov_reg_reg(
        code,
        x86.RCX,
        x86.R14,
    )
    x86.emit_sub_reg_reg(
        code,
        x86.RCX,
        x86.R15,
    )
    // Save length and source ptr
    x86.emit_push_reg(
        code,
        x86.RCX,
    )
    x86.emit_push_reg(
        code,
        x86.R15,
    )
    // mmap(NULL, 64, 3, 34, -1, 0) for header+data
    x86.emit_mov_reg_imm32(
        code,
        x86.RDI,
        0,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RSI,
        64,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDX,
        3,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.R10,
        34,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.R8,
        -1,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.R9,
        0,
    )
    x86.emit_mov_rax_imm32(
        code,
        9,
    )
    emit_raw_syscall(code)
    // rax = mmap result
    x86.emit_mov_reg_reg(
        code,
        x86.R12,
        x86.RAX,
    )
    x86.emit_pop_reg(
        code,
        x86.R15,
    )
    x86.emit_pop_reg(
        code,
        x86.RCX,
    )
    // header.ptr = r12 + 16
    // lea rdx, [r12 + 16]
    code.push(0x49)
    code.push(0x8d)
    code.push(0x54)
    code.push(0x24)
    code.push(16)
    // mov [r12], rdx  (header.ptr)
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.R12,
        0,
        x86.RDX,
    )
    // mov [r12+8], rcx  (header.len)
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.R12,
        8,
        x86.RCX,
    )
    // Copy digits: rep movsb (rdi=dest, rsi=src, rcx=count)
    x86.emit_push_reg(
        code,
        x86.RCX,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.RDX,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RSI,
        x86.R15,
    )
    x86.emit_rep_movsb(code)
    x86.emit_pop_reg(
        code,
        x86.RCX,
    )
    // Return header pointer in rax
    x86.emit_mov_reg_reg(
        code,
        x86.RAX,
        x86.R12,
    )
    // Restore callee-saved registers
    x86.emit_pop_reg(
        code,
        x86.R15,
    )
    x86.emit_pop_reg(
        code,
        x86.R14,
    )
    x86.emit_pop_reg(
        code,
        x86.R13,
    )
    x86.emit_pop_reg(
        code,
        x86.R12,
    )
    // epilogue
    x86.emit_mov_reg_reg(
        code,
        x86.RSP,
        x86.RBP,
    )
    x86.emit_pop_reg(
        code,
        x86.RBP,
    )
    x86.emit_ret(code)
}

// emit_runtime_open emits __rt_open(path: *u8, flags: int, mode: int) -> int.
// path in rdi, flags in rsi, mode in rdx.
// Returns fd on success, negative errno on error.
// syscall 2: open(path, flags, mode)
pub func emit_runtime_open(mut code: &mut Vec<int, _>) -> (void) {
    x86.emit_push_reg(
        code,
        x86.RBP,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RBP,
        x86.RSP,
    )
    x86.emit_mov_rax_imm32(
        code,
        2,
    )
    // syscall open
    emit_raw_syscall(code)
    x86.emit_mov_reg_reg(
        code,
        x86.RSP,
        x86.RBP,
    )
    x86.emit_pop_reg(
        code,
        x86.RBP,
    )
    x86.emit_ret(code)
}

