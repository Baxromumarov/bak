// ============================================================================
// STRING EQUALITY
// ============================================================================
// emit_runtime_str_eq emits __rt_str_eq(a_header: rdi, b_header: rsi) -> rax (1=equal, 0=not).
// a_header and b_header point to {ptr: *u8, len: int} (16 bytes each).
func emit_runtime_str_eq_blob0(mut code: &mut Vec<int, _>) -> (void) {
    code.push(0x55)
    code.push(0x48)
    code.push(0x89)
    code.push(0xe5)
    code.push(0xb9)
    code.push(0x00)
    code.push(0x00)
    code.push(0x40)
    code.push(0x00)
    code.push(0x48)
    code.push(0x39)
    code.push(0xcf)
    code.push(0x7c)
    code.push(0x44)
    code.push(0x48)
    code.push(0x39)
    code.push(0xce)
    code.push(0x7c)
    code.push(0x3f)
    code.push(0x48)
}

func emit_runtime_str_eq_blob1(mut code: &mut Vec<int, _>) -> (void) {
    code.push(0x39)
    code.push(0xf7)
    code.push(0x74)
    code.push(0x2f)
    code.push(0x48)
    code.push(0x85)
    code.push(0xff)
    code.push(0x74)
    code.push(0x31)
    code.push(0x48)
    code.push(0x85)
    code.push(0xf6)
    code.push(0x74)
    code.push(0x2c)
    code.push(0x48)
    code.push(0x8b)
    code.push(0x47)
    code.push(0x08)
    code.push(0x48)
    code.push(0x8b)
}

func emit_runtime_str_eq_blob2(mut code: &mut Vec<int, _>) -> (void) {
    code.push(0x4e)
    code.push(0x08)
    code.push(0x48)
    code.push(0x39)
    code.push(0xc8)
    code.push(0x75)
    code.push(0x1f)
    code.push(0x48)
    code.push(0x85)
    code.push(0xc0)
    code.push(0x74)
    code.push(0x13)
    code.push(0x48)
    code.push(0x8b)
    code.push(0x17)
    code.push(0x4c)
    code.push(0x8b)
    code.push(0x06)
    code.push(0x48)
    code.push(0x89)
}

func emit_runtime_str_eq_blob3(mut code: &mut Vec<int, _>) -> (void) {
    code.push(0xd6)
    code.push(0x4c)
    code.push(0x89)
    code.push(0xc7)
    code.push(0x48)
    code.push(0x89)
    code.push(0xc1)
    code.push(0xf3)
    code.push(0xa6)
    code.push(0x75)
    code.push(0x07)
    code.push(0xb8)
    code.push(0x01)
    code.push(0x00)
    code.push(0x00)
    code.push(0x00)
    code.push(0xeb)
    code.push(0x0e)
    code.push(0x31)
    code.push(0xc0)
}

func emit_runtime_str_eq_blob4(mut code: &mut Vec<int, _>) -> (void) {
    code.push(0xeb)
    code.push(0x0a)
    code.push(0x48)
    code.push(0x39)
    code.push(0xf7)
    code.push(0x0f)
    code.push(0x94)
    code.push(0xc0)
    code.push(0x48)
    code.push(0x0f)
    code.push(0xb6)
    code.push(0xc0)
    code.push(0x48)
    code.push(0x89)
    code.push(0xec)
    code.push(0x5d)
    code.push(0xc3)
}

pub func emit_runtime_str_eq(mut code: &mut Vec<int, _>) -> (void) {
    // Preassembled routine to avoid bootstrap instability in large jump patching
    // logic while preserving full string-equality semantics.
    emit_runtime_str_eq_blob0(code)
    emit_runtime_str_eq_blob1(code)
    emit_runtime_str_eq_blob2(code)
    emit_runtime_str_eq_blob3(code)
    emit_runtime_str_eq_blob4(code)

    return
}

// ============================================================================
// VEC DEEP-COPY SUPPORT
// ============================================================================
// emit_runtime_vec_clone emits __rt_vec_clone(src_vec_ptr: *VecHeader, elem_size: int, dst_vec_ptr: *VecHeader) -> void.
// src_vec_ptr in rdi points to {data_ptr: *u8, len: int, cap: int}.
// elem_size in rsi.
// dst_vec_ptr in rdx is where to write the cloned Vec header.
// Allocates new data buffer if len > 0, copies all elements, writes new header to dst_vec_ptr.
// Vec header layout: ptr(8) + len(8) + cap(8) = 24 bytes.
pub func emit_runtime_vec_clone(
    mut code: &mut Vec<int, _>,
    alloc_off: int,
) -> (void) {
    x86.emit_push_reg(
        code,
        x86.RBP,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RBP,
        x86.RSP,
    )
    // Reserve stack space for temporary storage: 48 bytes
    x86.emit_sub_rsp_imm8(
        code,
        48,
    )
    // Save arguments: [rbp-8]=src_vec_ptr (RDI), [rbp-16]=elem_size (RSI), [rbp-24]=dst_vec_ptr (RDX)
    x86.emit_mov_mem_rbp_reg(
        code,
        -8,
        x86.RDI,
    )
    x86.emit_mov_mem_rbp_reg(
        code,
        -16,
        x86.RSI,
    )
    x86.emit_mov_mem_rbp_reg(
        code,
        -24,
        x86.RDX,
    )
    // Load src len: [src_vec_ptr+8] and cap: [src_vec_ptr+16]
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RAX,
        x86.RDI,
        8,
    )
    // len
    x86.emit_mov_mem_rbp_reg(
        code,
        -32,
        x86.RAX,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RBX,
        x86.RDI,
        16,
    )
    // cap
    x86.emit_mov_mem_rbp_reg(
        code,
        -40,
        x86.RBX,
    )
    // If len == 0, write empty header and return
    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jnz_alloc: int = code.len()

    x86.emit_jnz_rel32(
        code,
        0,
    )
    // placeholder, will patch
    // Empty Vec path: write {0, 0, 0} to dst_vec_ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RDI,
        x86.RBP,
        -24,
    )
    x86.emit_xor_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RDI,
        0,
        x86.RAX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RDI,
        8,
        x86.RAX,
    )
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RDI,
        16,
        x86.RAX,
    )

    var jmp_end: int = code.len()

    x86.emit_jmp_rel32(
        code,
        0,
    )

    // placeholder, will patch
    // Alloc path: allocate cap * elem_size bytes
    var alloc_start: int = code.len()

    // Patch jnz to jump here
    patch_runtime_rel32(
        code,
        jnz_alloc + 2,
        alloc_start,
    )
    // alloc_size = cap * elem_size
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RAX,
        x86.RBP,
        -40,
    )
    // cap
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RCX,
        x86.RBP,
        -16,
    )
    // elem_size
    x86.emit_imul_reg_reg(
        code,
        x86.RAX,
        x86.RCX,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RDI,
        x86.RAX,
    )

    // Call __rt_alloc(alloc_size) instead of inline brk
    var clone_call_site: int = code.len()

    code.push(0xE8)

    var clone_disp: int = alloc_off - (clone_call_site + 5)

    code.push(clone_disp & 0xff)
    code.push(clone_disp >> 8 & 0xff)
    code.push(clone_disp >> 16 & 0xff)
    code.push(clone_disp >> 24 & 0xff)
    // new_ptr in RAX
    x86.emit_mov_mem_rbp_reg(
        code,
        -48,
        x86.RAX,
    )
    // save new_ptr
    // memcpy: copy len * elem_size bytes from src data to new data
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RCX,
        x86.RBP,
        -32,
    )
    // len
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RAX,
        x86.RBP,
        -16,
    )
    // elem_size
    x86.emit_imul_reg_reg(
        code,
        x86.RCX,
        x86.RAX,
    )
    // RCX = byte count
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RDI,
        x86.RBP,
        -48,
    )
    // dst = new_ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RAX,
        x86.RBP,
        -8,
    )
    // src_vec_ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RSI,
        x86.RAX,
        0,
    )
    // src data ptr
    x86.emit_rep_movsb(code)
    // Write new Vec header: {new_ptr, len, cap}
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RDI,
        x86.RBP,
        -24,
    )
    // dst_vec_ptr
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RAX,
        x86.RBP,
        -48,
    )
    // new_ptr
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RDI,
        0,
        x86.RAX,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RAX,
        x86.RBP,
        -32,
    )
    // len
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RDI,
        8,
        x86.RAX,
    )
    x86.emit_mov_reg_mem_base_disp(
        code,
        x86.RAX,
        x86.RBP,
        -40,
    )
    // cap
    x86.emit_mov_mem_base_disp_reg(
        code,
        x86.RDI,
        16,
        x86.RAX,
    )

    // End: patch jmp_end to here
    var end_target: int = code.len()

    patch_runtime_rel32(
        code,
        jmp_end + 1,
        end_target,
    )
    // Restore and return
    x86.emit_mov_reg_reg(
        code,
        x86.RSP,
        x86.RBP,
    )
    x86.emit_pop_reg(
        code,
        x86.RBP,
    )
    x86.emit_ret(code)
}

// emit_runtime_print_int emits __rt_print_int(value: rdi) -> void.
// Converts integer to decimal string and prints it to stdout.
pub func emit_runtime_print_int(mut code: &mut Vec<int, _>) -> (void) {
    x86.emit_push_reg(
        code,
        x86.RBP,
    )
    x86.emit_mov_reg_reg(
        code,
        x86.RBP,
        x86.RSP,
    )
    x86.emit_sub_rsp_imm8(
        code,
        32,
    )
    // Check for negative: test rdi, rdi
    x86.emit_test_reg_reg(
        code,
        x86.RDI,
        x86.RDI,
    )

    // jns rel32 (0x0F 0x89 + 4 bytes) — jump if not negative
    var jns_pos: int = code.len()

    code.push(0x0f)
    code.push(0x89)
    code.push(0)
    code.push(0)
    code.push(0)
    code.push(0)
    // Negative path: print '-' and negate
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        0x2d,
    )
    x86.emit_mov_mem_rbp_reg(
        code,
        -32,
        x86.RAX,
    )
    x86.emit_push_reg(
        code,
        x86.RDI,
    )
    x86.emit_lea_reg_mem_rbp(
        code,
        x86.RSI,
        -32,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDX,
        1,
    )
    x86.emit_mov_rdi_imm32(
        code,
        1,
    )
    x86.emit_mov_rax_imm32(
        code,
        1,
    )
    emit_raw_syscall(code)
    x86.emit_pop_reg(
        code,
        x86.RDI,
    )
    x86.emit_neg_reg(
        code,
        x86.RDI,
    )

    // Patch jns to here
    var jns_target: int = code.len()

    patch_runtime_rel32(
        code,
        jns_pos + 2,
        jns_target,
    )
    // Handle 0 specially: test rdi, rdi
    x86.emit_test_reg_reg(
        code,
        x86.RDI,
        x86.RDI,
    )

    var jnz_pos: int = code.len()

    x86.emit_jnz_rel32(
        code,
        0,
    )
    // Zero path: print '0'
    x86.emit_mov_reg_imm32(
        code,
        x86.RAX,
        0x30,
    )
    x86.emit_mov_mem_rbp_reg(
        code,
        -32,
        x86.RAX,
    )
    x86.emit_lea_reg_mem_rbp(
        code,
        x86.RSI,
        -32,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDX,
        1,
    )
    x86.emit_mov_rdi_imm32(
        code,
        1,
    )
    x86.emit_mov_rax_imm32(
        code,
        1,
    )
    emit_raw_syscall(code)

    var jmp_end_pos: int = code.len()

    x86.emit_jmp_rel32(
        code,
        0,
    )

    // Patch jnz to here (non-zero path)
    var nz_target: int = code.len()

    patch_runtime_rel32(
        code,
        jnz_pos + 2,
        nz_target,
    )
    // Convert digits: rax = value, rcx = digit count
    x86.emit_mov_reg_reg(
        code,
        x86.RAX,
        x86.RDI,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        0,
    )

    // Digit extraction loop
    var loop_start: int = code.len()

    x86.emit_test_reg_reg(
        code,
        x86.RAX,
        x86.RAX,
    )

    var jz_loop_end: int = code.len()

    x86.emit_jz_rel32(
        code,
        0,
    )
    // Divide rax by 10
    x86.emit_push_reg(
        code,
        x86.RCX,
    )
    x86.emit_xor_reg_reg(
        code,
        x86.RDX,
        x86.RDX,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RCX,
        10,
    )
    // div rcx (unsigned): REX.W F7 /6
    code.push(0x48)
    code.push(0xf7)
    code.push(0xf1)
    // rdx = remainder (digit), add '0'
    x86.emit_add_reg_imm8(
        code,
        x86.RDX,
        0x30,
    )
    x86.emit_pop_reg(
        code,
        x86.RCX,
    )
    // Store digit at [rbp - 24 + rcx]
    x86.emit_lea_reg_mem_rbp(
        code,
        x86.R8,
        -24,
    )
    x86.emit_add_reg_reg(
        code,
        x86.R8,
        x86.RCX,
    )
    // mov [r8], dl
    code.push(0x41)
    code.push(0x88)
    code.push(0x10)
    // inc rcx: REX.W FF /0
    code.push(0x48)
    code.push(0xff)
    code.push(0xc1)

    // jmp loop_start
    var jmp_loop_pos: int = code.len()

    x86.emit_jmp_rel32(
        code,
        0,
    )
    patch_runtime_rel32(
        code,
        jmp_loop_pos + 1,
        loop_start,
    )

    // Patch jz_loop_end to here
    var loop_end_target: int = code.len()

    patch_runtime_rel32(
        code,
        jz_loop_end + 2,
        loop_end_target,
    )

    // Print digits in reverse order
    var print_loop: int = code.len()

    x86.emit_test_reg_reg(
        code,
        x86.RCX,
        x86.RCX,
    )

    var jz_print_end: int = code.len()

    x86.emit_jz_rel32(
        code,
        0,
    )
    // dec rcx: REX.W FF /1
    code.push(0x48)
    code.push(0xff)
    code.push(0xc9)
    x86.emit_push_reg(
        code,
        x86.RCX,
    )
    x86.emit_lea_reg_mem_rbp(
        code,
        x86.RSI,
        -24,
    )
    x86.emit_add_reg_reg(
        code,
        x86.RSI,
        x86.RCX,
    )
    x86.emit_mov_reg_imm32(
        code,
        x86.RDX,
        1,
    )
    x86.emit_mov_rdi_imm32(
        code,
        1,
    )
    x86.emit_mov_rax_imm32(
        code,
        1,
    )
    emit_raw_syscall(code)
    x86.emit_pop_reg(
        code,
        x86.RCX,
    )

    // jmp print_loop
    var jmp_print_pos: int = code.len()

    x86.emit_jmp_rel32(
        code,
        0,
    )
    patch_runtime_rel32(
        code,
        jmp_print_pos + 1,
        print_loop,
    )

    // Patch jz_print_end to here
    var print_end_target: int = code.len()

    patch_runtime_rel32(
        code,
        jz_print_end + 2,
        print_end_target,
    )

    // Patch jmp_end (from zero path) to here
    var end_target: int = code.len()

    patch_runtime_rel32(
        code,
        jmp_end_pos + 1,
        end_target,
    )
    // Epilogue
    x86.emit_mov_reg_reg(
        code,
        x86.RSP,
        x86.RBP,
    )
    x86.emit_pop_reg(
        code,
        x86.RBP,
    )
    x86.emit_ret(code)
}
