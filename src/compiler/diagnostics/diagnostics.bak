// Diagnostics for bakc.
package diagnostics

import "src/std/strconv/strconv.bak"
import "src/std/fs/fs.bak" as fs
import "src/std/strings/strings.bak" as strings

// ANSI color codes for pretty printing — build ESC at runtime so literals
// Build color codes at runtime to ensure we emit actual ESC bytes
func ESC() -> (string) {
    return char(27).toString()
}

func ColorReset() -> (string) {
    return ESC() + "[0m"
}

func ColorRed() -> (string) {
    return ESC() + "[31m"
}

func ColorYellow() -> (string) {
    return ESC() + "[33m"
}

func ColorBlue() -> (string) {
    return ESC() + "[34m"
}

func ColorCyan() -> (string) {
    return ESC() + "[36m"
}

func ColorMagenta() -> (string) {
    return ESC() + "[35m"
}

func ColorWhite() -> (string) {
    return ESC() + "[97m"
}

func ColorBold() -> (string) {
    return ESC() + "[1m"
}

func ColorGray() -> (string) {
    return ESC() + "[90m"
}

pub enum DiagnosticLevel {
    Error
    Warning
    Hint
}

pub alias DiagnosticCode = string
// Ownership errors (E01xx)
pub const ErrUseAfterMove: DiagnosticCode = "E0100"
pub const ErrBorrowAfterMove: DiagnosticCode = "E0101"
pub const ErrMoveWhileBorrowed: DiagnosticCode = "E0102"
pub const ErrDoubleMutableBorrow: DiagnosticCode = "E0103"
pub const ErrBorrowConflict: DiagnosticCode = "E0104"
pub const ErrReturningBorrow: DiagnosticCode = "E0105"
pub const ErrBorrowInStruct: DiagnosticCode = "E0106"
// Mutability errors (E02xx)
pub const ErrMutabilityRequired: DiagnosticCode = "E0200"
pub const ErrAssignToImmutable: DiagnosticCode = "E0201"
pub const ErrMutBorrowImmutable: DiagnosticCode = "E0202"
// Type errors (E03xx)
pub const ErrTypeMismatch: DiagnosticCode = "E0300"
pub const ErrUnknownType: DiagnosticCode = "E0301"
pub const ErrGenericMismatch: DiagnosticCode = "E0302"
pub const ErrVecSizeMismatch: DiagnosticCode = "E0303"
// Function errors (E04xx)
pub const ErrArgumentCount: DiagnosticCode = "E0400"
pub const ErrArgumentType: DiagnosticCode = "E0401"
pub const ErrReturnType: DiagnosticCode = "E0402"
pub const ErrUndefinedFunction: DiagnosticCode = "E0403"
pub const ErrVisibility: DiagnosticCode = "E0404"
// Variable errors (E05xx)
pub const ErrUndefinedVariable: DiagnosticCode = "E0500"
pub const ErrDuplicateVariable: DiagnosticCode = "E0501"
pub const ErrMissingType: DiagnosticCode = "E0502"
pub const ErrCaptureViolation: DiagnosticCode = "E0503"
// Vec-specific errors (E06xx)
pub const ErrVecDynamicOnly: DiagnosticCode = "E0600"
pub const ErrVecFixedOnly: DiagnosticCode = "E0601"
pub const ErrVecInvalidInit: DiagnosticCode = "E0602"
pub struct Diagnostic {
    Code: DiagnosticCode
    Level: DiagnosticLevel
    Message: string
    Line: int
    Column: int
    File: string
    Notes: Vec<Note, _>
    Help: string
}

pub struct Note {
    Message: string
    Line: int
    Column: int
    File: string
}

pub struct DiagnosticEmitter {
    diagnostics: Vec<Diagnostic, _>
    file: string
    hasErrors: bool
}

pub func NewEmitter(file: string) -> (DiagnosticEmitter) {
    return DiagnosticEmitter{
        diagnostics: Vec.new(),
        file: file,
        hasErrors: false,
    }
}

impl Diagnostic as d {
    func format() -> (string) {
        mut var out: string = ""
        mut var levelStr: string = levelToString(d.Level)
        mut var levelColor: string = ColorWhite()
        switch d.Level {
            case Error {
                levelColor = ColorRed()
            }
            case Warning {
                levelColor = ColorYellow()
            }
            case Hint {
                levelColor = ColorCyan()
            }
            default {
                levelColor = ColorWhite()
            }
        }
        // Header: ERROR [E0123]: message
        out = out + ColorBold() + levelColor + levelStr + ColorReset() + " " + ColorMagenta() + "[" + d.Code + "]" + ColorReset() + ": " + ColorWhite() + d.Message + ColorReset() + "
"
        mut var file: string = d.File
        if file == "" {
            file = "<input>"
        }
        var lineStr: string = strconv.intToString(d.Line)
        var colStr: string = strconv.intToString(d.Column)
        out = out + "  " + ColorBlue() + "-->" + ColorReset() + " " + file + ":" + lineStr + ":" + colStr + "
"
        // Try to read the source line for a code snippet and caret
        var codeContent: Result<string, string> = fs.readFile(file)
        if codeContent.is_ok() {
            var content: string = codeContent.unwrap()
            // Split lines
            mut var lines: Vec<string, _> = Vec.new()
            mut var cur: string = ""
            mut var i: int = 0
            while i < content.len() {
                var ch: char = content[i]
                if ch == char('
') {
                    lines.push(cur)
                    cur = ""
                } else {
                    cur = cur + ch.toString()
                }
                i = i + 1
            }
            // push last
            lines.push(cur)
            if d.Line > 0 && d.Line <= lines.len() {
                var srcLine: string = lines[d.Line - 1]
                var lineNumStr: string = strconv.intToString(d.Line)
                mut var padding: string = ""
                mut var j: int = 0
                while j < lineNumStr.len() {
                    padding = padding + " "
                    j = j + 1
                }
                out = out + "  " + padding + ColorBlue() + " |" + ColorReset() + "
"
                out = out + "  " + ColorBlue() + " " + lineNumStr + " |" + ColorReset() + " " + srcLine + "
"
                // Caret underline (column is 1-based)
                mut var underline: string = ""
                mut var colIdx: int = d.Column - 1
                if colIdx < 0 {
                    colIdx = 0
                }
                mut var k: int = 0
                while k < colIdx {
                    underline = underline + " "
                    k = k + 1
                }
                underline = underline + "^"
                out = out + "  " + padding + ColorBlue() + " |" + ColorReset() + " " + levelColor + ColorBold() + underline + ColorReset() + "
"
                if d.Help != "" {
                    out = out + "  " + padding + ColorBlue() + " = help: " + ColorReset() + d.Help + "
"
                } else {
                    out = out + "
"
                }
            }
        } else if d.Help != "" {
            out = out + "  = help: " + d.Help + "
"
        }
        for note in d.Notes {
            out = out + "  " + ColorCyan() + "= note: " + note.Message + ColorReset() + "
"
            if note.Line > 0 {
                mut var noteFile: string = note.File
                if noteFile == "" {
                    noteFile = file
                }
                var noteLine: string = strconv.intToString(note.Line)
                var noteCol: string = strconv.intToString(note.Column)
                // try to show note snippet
                var noteContent: Result<string, string> = fs.readFile(noteFile)
                if noteContent.is_ok() {
                    var ncontent: string = noteContent.unwrap()
                    mut var nlines: Vec<string, _> = Vec.new()
                    mut var cur2: string = ""
                    mut var ii: int = 0
                    while ii < ncontent.len() {
                        var ch2: char = ncontent[ii]
                        if ch2 == char('
') {
                            nlines.push(cur2)
                            cur2 = ""
                        } else {
                            cur2 = cur2 + ch2.toString()
                        }
                        ii = ii + 1
                    }
                    nlines.push(cur2)
                    if note.Line > 0 && note.Line <= nlines.len() {
                        out = out + "  " + ColorBlue() + "--> " + noteFile + ":" + noteLine + ":" + noteCol + ColorReset() + "
"
                        var noteSrcLine: string = nlines[note.Line - 1]
                        out = out + "      " + ColorGray() + strings.trim(&noteSrcLine) + ColorReset() + "
"
                    }
                }
            }
        }
        return out
    }
}

impl DiagnosticEmitter as e {
    pub mut func emit(mut d: Diagnostic) -> (void) {
        if d.File == "" {
            d.File = e.file
        }
        e.diagnostics.push(d)
        if d.Level == Error {
            e.hasErrors = true
        }
        return
    }
    pub func hasErrors() -> (bool) {
        return e.hasErrors
    }
    pub func all() -> (Vec<Diagnostic, _>) {
        return e.diagnostics
    }
    pub func formatAll() -> (string) {
        // Sort diagnostics by file/line/col for stable output
        // (simple bubble-ish sort for small lists)
        mut var diags: Vec<Diagnostic, _> = Vec.new()
        for d in e.diagnostics {
            diags.push(d)
        }
        // Simple insertion sort
        mut var i: int = 1
        while i < diags.len() {
            mut var j: int = i
            while j > 0 {
                var a: Diagnostic = diags[j - 1]
                var b: Diagnostic = diags[j]
                mut var swap: bool = false
                if strings.compare(&a.File, &b.File) > 0 {
                    swap = true
                }
                if a.File == b.File && a.Line > b.Line {
                    swap = true
                }
                if a.File == b.File && a.Line == b.Line && a.Column > b.Column {
                    swap = true
                }
                if !swap {
                    break
                }
                // swap
                var tmp: Diagnostic = diags[j - 1]
                diags[j - 1] = diags[j]
                diags[j] = tmp
                j = j - 1
            }
            i = i + 1
        }
        mut var out: string = ""
        if diags.len() > 0 {
            out = out + ColorBold() + "Type errors:" + ColorReset() + "

"
        }
        for d in diags {
            out = out + d.format() + "
"
        }
        return out
    }
}

func levelToString(level: DiagnosticLevel) -> (string) {
    switch level {
        case Error {
            return "ERROR"
        }
        case Warning {
            return "WARNING"
        }
        case Hint {
            return "HINT"
        }
        default {
            return "unknown"
        }
    }
}

// =============================================================================
// Builder functions for common diagnostics
// =============================================================================
pub func UseAfterMove(varName: string, line: int, col: int, moveLine: int, moveCol: int, moveReason: string) -> (Diagnostic) {
    mut var d: Diagnostic = Diagnostic{
        Code: ErrUseAfterMove,
        Column: col,
        File: "",
        Help: "consider borrowing instead: &" + varName,
        Level: Error,
        Line: line,
        Message: "use of moved value '" + varName + "'",
        Notes: Vec.new(),
    }
    if moveLine > 0 {
        d.Notes.push(Note{
            Column: moveCol,
            File: "",
            Line: moveLine,
            Message: "value was " + moveReason,
        })
    }
    return d
}

pub func CannotMove(varName: string, line: int, col: int, reason: string) -> (Diagnostic) {
    return Diagnostic{
        Code: ErrMoveWhileBorrowed,
        Column: col,
        File: "",
        Help: "",
        Level: Error,
        Line: line,
        Message: "cannot move '" + varName + "' because it is " + reason,
        Notes: Vec.new(),
    }
}

pub func BorrowConflict(varName: string, line: int, col: int, attemptedBorrow: string, existingState: string) -> (Diagnostic) {
    return Diagnostic{
        Code: ErrBorrowConflict,
        Column: col,
        File: "",
        Help: "",
        Level: Error,
        Line: line,
        Message: "cannot borrow '" + varName + "' as " + attemptedBorrow + " because it is already " + existingState,
        Notes: Vec.new(),
    }
}

pub func MutabilityRequired(varName: string, line: int, col: int, operation: string) -> (Diagnostic) {
    return Diagnostic{
        Code: ErrMutabilityRequired,
        Column: col,
        File: "",
        Help: "declare the variable as 'mut var'",
        Level: Error,
        Line: line,
        Message: "cannot " + operation + " on immutable variable '" + varName + "'",
        Notes: Vec.new(),
    }
}

pub func TypeMismatch(line: int, col: int, expected: string, got: string, context: string) -> (Diagnostic) {
    mut var msg: string = "type mismatch: expected " + expected + ", got " + got
    if context != "" {
        msg = msg + " in " + context
    }
    return Diagnostic{
        Code: ErrTypeMismatch,
        Column: col,
        File: "",
        Help: "",
        Level: Error,
        Line: line,
        Message: msg,
        Notes: Vec.new(),
    }
}

pub func VecMutatingMethodOnImmutable(varName: string, method: string, line: int, col: int) -> (Diagnostic) {
    return Diagnostic{
        Code: ErrMutabilityRequired,
        Column: col,
        File: "",
        Help: "declare the variable as 'mut var'",
        Level: Error,
        Line: line,
        Message: "cannot call '" + method + "' on immutable variable '" + varName + "'",
        Notes: Vec.new(),
    }
}

pub func VecDynamicOnlyMethod(method: string, vecType: string, line: int, col: int) -> (Diagnostic) {
    return Diagnostic{
        Code: ErrVecDynamicOnly,
        Column: col,
        File: "",
        Help: "use Vec<T, _> for dynamic arrays",
        Level: Error,
        Line: line,
        Message: "cannot call '" + method + "' on fixed-size " + vecType,
        Notes: Vec.new(),
    }
}

pub func UndefinedVariable(varName: string, line: int, col: int) -> (Diagnostic) {
    return Diagnostic{
        Code: ErrUndefinedVariable,
        Column: col,
        File: "",
        Help: "",
        Level: Error,
        Line: line,
        Message: "undefined variable: " + varName,
        Notes: Vec.new(),
    }
}

pub func UndefinedFunction(funcName: string, line: int, col: int) -> (Diagnostic) {
    return Diagnostic{
        Code: ErrUndefinedFunction,
        Column: col,
        File: "",
        Help: "",
        Level: Error,
        Line: line,
        Message: "undefined function: " + funcName,
        Notes: Vec.new(),
    }
}

pub func DuplicateVariable(varName: string, line: int, col: int) -> (Diagnostic) {
    return Diagnostic{
        Code: ErrDuplicateVariable,
        Column: col,
        File: "",
        Help: "",
        Level: Error,
        Line: line,
        Message: "duplicate variable: " + varName,
        Notes: Vec.new(),
    }
}

pub func MissingType(varName: string, line: int, col: int) -> (Diagnostic) {
    return Diagnostic{
        Code: ErrMissingType,
        Column: col,
        File: "",
        Help: "",
        Level: Error,
        Line: line,
        Message: "variable '" + varName + "' requires a type annotation or an initial value",
        Notes: Vec.new(),
    }
}

pub func AssignToImmutable(varName: string, line: int, col: int) -> (Diagnostic) {
    return Diagnostic{
        Code: ErrAssignToImmutable,
        Column: col,
        File: "",
        Help: "",
        Level: Error,
        Line: line,
        Message: "cannot assign to immutable variable '" + varName + "'",
        Notes: Vec.new(),
    }
}

pub func UnusedVariable(varName: string, line: int, col: int) -> (Diagnostic) {
    return Diagnostic{
        Code: "E0503",
        Column: col,
        File: "",
        Help: "prefix with _ to ignore",
        Level: Warning,
        Line: line,
        Message: "unused variable: '" + varName + "'",
        Notes: Vec.new(),
    }
}

pub func ReturningBorrow(typeName: string, line: int, col: int) -> (Diagnostic) {
    return Diagnostic{
        Code: ErrReturningBorrow,
        Column: col,
        File: "",
        Help: "v1: borrowing values across function boundaries is prohibited. try passing by value or Box instead.",
        Level: Error,
        Line: line,
        Message: "cannot return borrowed value " + typeName,
        Notes: Vec.new(),
    }
}

pub func BorrowInStruct(fieldName: string, typeName: string, line: int, col: int) -> (Diagnostic) {
    return Diagnostic{
        Code: ErrBorrowInStruct,
        Column: col,
        File: "",
        Help: "v1: storing borrows in structs is prohibited. use owned values or Box instead.",
        Level: Error,
        Line: line,
        Message: "struct field '" + fieldName + "' cannot be a borrow type " + typeName,
        Notes: Vec.new(),
    }
}

pub func SimpleError(code: DiagnosticCode, msg: string, line: int, col: int) -> (Diagnostic) {
    return Diagnostic{
        Code: code,
        Column: col,
        File: "",
        Help: "",
        Level: Error,
        Line: line,
        Message: msg,
        Notes: Vec.new(),
    }
}
