// Parser for bakc.
package parser

import "src/compiler/ast/ast.bak" as ast
import "src/compiler/lexer/lexer.bak" as lexer
import "src/compiler/native/backend.bak" as native
import "src/compiler/token/token.bak" as token
import "src/std/fs/fs.bak" as fs
import "src/std/strconv/strconv.bak" as strconv

const PREC_LOWEST: int = 1
const PREC_OR: int = 2
const PREC_AND: int = 3
const PREC_EQUALS: int = 4
const PREC_LESSGREATER: int = 5
const PREC_BITOR: int = 6
const PREC_BITXOR: int = 7
const PREC_BITAND: int = 8
const PREC_SHIFT: int = 9
const PREC_SUM: int = 10
const PREC_PRODUCT: int = 11
const PREC_PREFIX: int = 12
const PREC_CALL: int = 13
const PREC_INDEX: int = 14
const PREC_DOT: int = 15
const CH_0: int = 48
const CH_9: int = 57
const CH_A: int = 65
const CH_F: int = 70
const CH_Z: int = 90
const CH_a: int = 97
const CH_f: int = 102
const CH_BACKSLASH: int = 92
const CH_n: int = 110
const CH_t: int = 116
const CH_r: int = 114
const CH_b: int = 98
const CH_o: int = 111
const CH_x: int = 120
const CH_QUOTE: int = 34
const CH_APOSTROPHE: int = 39
const EOF_LITERAL_SENTINEL: string = "<eof>"

pub struct Parser {
    l:               lexer.Lexer
    errors:          Vec<string, _>
    collectPkg:      string
    bootstrapSkipBodies: bool
    curType:         int
    curLiteral:      string
    curLine:         int
    curColumn:       int
    peekType:        int
    peekLiteral:     string
    peekLine:        int
    peekColumn:      int
    peek2Type:       int
    peek2Literal:    string
    peek2Line:       int
    peek2Column:     int
    peek3Type:       int
    peek3Literal:    string
    peek3Line:       int
    peek3Column:     int
    debugShiftCount: int
    debugEnabled:    bool
    inMainFunc:      bool
    tokenFastConstNext: int
    tokenBuffer:     Vec<token.Token, _>
    tokenNextIndex:  int
}

pub struct CollectedProgramItems {
    pub Funcs:   Vec<ast.FunctionDecl, _>
    pub Structs: Vec<ast.StructDecl, _>
    pub Consts:  Vec<ast.ConstStatement, _>
    pub Enums:   Vec<ast.EnumDecl, _>
}

pub func NewParserFromLexer(l: lexer.Lexer) -> (Parser) {
    return initParser(
        l,
        parseSourceDebugEnabled(),
    )
}

func initParser(l: lexer.Lexer, debugEnabled: bool) -> (Parser) {
    return initParserFromLexer(
        l,
        debugEnabled,
    )
}

func tokenBufferEOFToken(tokens: &Vec<token.Token, _>) -> (token.Token) {
    if tokens.len() == 0 {
        return token.MakeToken(
            token.EOF,
            "",
            0,
            0,
        )
    }

    var lastTok: token.Token = (*tokens)[tokens.len() - 1]

    return token.MakeToken(
        token.EOF,
        "",
        lastTok.Line,
        lastTok.Column,
    )
}

func tokenBufferAt(tokens: &Vec<token.Token, _>, index: int) -> (token.Token) {
    if index < 0 || index >= tokens.len() {
        return tokenBufferEOFToken(tokens)
    }

    return (*tokens)[index]
}

func collectTokenBufferFromLexer(mut l: &mut lexer.Lexer) -> (Vec<token.Token, _>) {
    mut var out: Vec<token.Token, _> = Vec.with_cap(512)
    mut var guard: int = 0

    while true {
        var tok: token.Token = lexer.nextTokenFrom(l)

        if guard < 6 {
        }

        out.push(tok)
        guard = guard + 1

        if token.TypeEq(
            tok.Type,
            token.EOF,
        ) {
            break
        }

        if guard >= 262144 {
            out.push(
                token.MakeToken(
                    token.EOF,
                    "",
                    tok.Line,
                    tok.Column,
                ),
            )
            break
        }
    }

    if out.len() == 0 {
        out.push(
            token.MakeToken(
                token.EOF,
                "",
                0,
                0,
            ),
        )
    }

    return out
}

func initParserFromLexer(l: lexer.Lexer, debugEnabled: bool) -> (Parser) {
    mut var errorsVec: Vec<string, _> = Vec.new()
    mut var p: Parser

    p = Parser{}
    p.curColumn = 0
    p.curLine = 0
    p.curLiteral = EOF_LITERAL_SENTINEL
    p.curType = token.ILLEGAL
    p.peekColumn = 0
    p.peekLine = 0
    p.peekLiteral = EOF_LITERAL_SENTINEL
    p.peekType = token.ILLEGAL
    p.peek2Column = 0
    p.peek2Line = 0
    p.peek2Literal = EOF_LITERAL_SENTINEL
    p.peek2Type = token.ILLEGAL
    p.peek3Column = 0
    p.peek3Line = 0
    p.peek3Literal = EOF_LITERAL_SENTINEL
    p.peek3Type = token.ILLEGAL
    p.debugShiftCount = 0
    p.inMainFunc = false
    p.tokenFastConstNext = 0
    p.collectPkg = ""
    p.bootstrapSkipBodies = false
    p.errors = errorsVec
    p.debugEnabled = debugEnabled
    p.l = l
    mut var emptyTokens0: Vec<token.Token, _> = Vec.with_cap(0)
    p.tokenBuffer = emptyTokens0
    p.tokenNextIndex = 0
    mut var tok0: token.Token = p.nextTokenFromLexer()
    mut var tok0Literal: string = copyString(&tok0.Literal)
    mut var tok0Type: int = stableTokenTypeFromParts(
        tok0.Type,
        &tok0Literal,
    )
    mut var tok0Line: int = tok0.Line
    mut var tok0Column: int = tok0.Column
    mut var tok1: token.Token = p.nextTokenFromLexer()
    mut var tok1Literal: string = copyString(&tok1.Literal)
    mut var tok1Type: int = stableTokenTypeFromParts(
        tok1.Type,
        &tok1Literal,
    )
    mut var tok1Line: int = tok1.Line
    mut var tok1Column: int = tok1.Column
    mut var tok2: token.Token = p.nextTokenFromLexer()
    mut var tok2Literal: string = copyString(&tok2.Literal)
    mut var tok2Type: int = stableTokenTypeFromParts(
        tok2.Type,
        &tok2Literal,
    )
    mut var tok2Line: int = tok2.Line
    mut var tok2Column: int = tok2.Column
    mut var tok3: token.Token = p.nextTokenFromLexer()
    mut var tok3Literal: string = copyString(&tok3.Literal)
    mut var tok3Type: int = stableTokenTypeFromParts(
        tok3.Type,
        &tok3Literal,
    )
    mut var tok3Line: int = tok3.Line
    mut var tok3Column: int = tok3.Column

    if token.TypeEq(
        tok0Type,
        token.EOF,
    ) {
        tok0Literal = EOF_LITERAL_SENTINEL
    }

    if token.TypeEq(
        tok1Type,
        token.EOF,
    ) {
        tok1Literal = EOF_LITERAL_SENTINEL
    }

    if token.TypeEq(
        tok2Type,
        token.EOF,
    ) {
        tok2Literal = EOF_LITERAL_SENTINEL
    }

    if token.TypeEq(
        tok3Type,
        token.EOF,
    ) {
        tok3Literal = EOF_LITERAL_SENTINEL
    }

    p.curType = tok0Type
    p.curLiteral = copyString(&tok0Literal)
    p.curLine = tok0Line
    p.curColumn = tok0Column
    p.peekType = tok1Type
    p.peekLiteral = copyString(&tok1Literal)
    p.peekLine = tok1Line
    p.peekColumn = tok1Column
    p.peek2Type = tok2Type
    p.peek2Literal = copyString(&tok2Literal)
    p.peek2Line = tok2Line
    p.peek2Column = tok2Column
    p.peek3Type = tok3Type
    p.peek3Literal = copyString(&tok3Literal)
    p.peek3Line = tok3Line
    p.peek3Column = tok3Column

    return p
}

func initParserFromSource(source: &string, debugEnabled: bool) -> (Parser) {
    return initParserOwnedBootstrap(
        copyString(source),
        debugEnabled,
    )
}

func initParserOwnedBootstrap(source: string, debugEnabled: bool) -> (Parser) {
    mut var errorsVec: Vec<string, _> = Vec.new()
    mut var p: Parser

    p = Parser{}
    p.curColumn = 0
    p.curLine = 0
    p.curLiteral = EOF_LITERAL_SENTINEL
    p.curType = token.ILLEGAL
    p.peekColumn = 0
    p.peekLine = 0
    p.peekLiteral = EOF_LITERAL_SENTINEL
    p.peekType = token.ILLEGAL
    p.peek2Column = 0
    p.peek2Line = 0
    p.peek2Literal = EOF_LITERAL_SENTINEL
    p.peek2Type = token.ILLEGAL
    p.peek3Column = 0
    p.peek3Line = 0
    p.peek3Literal = EOF_LITERAL_SENTINEL
    p.peek3Type = token.ILLEGAL
    p.debugShiftCount = 0
    p.inMainFunc = false
    p.tokenFastConstNext = 0
    p.collectPkg = ""
    p.bootstrapSkipBodies = false
    p.errors = errorsVec
    p.debugEnabled = debugEnabled
    // Deep self-host stages have shown instability with NewOwnedNoCopy on very
    // small sources; keep copy-elision for larger inputs and use clone path for tiny files.
    if source.len() <= 1024 {
        p.l = lexer.New(copyString(&source))
    } else {
        p.l = lexer.NewOwnedNoCopy(source)
    }
    mut var emptyTokens1: Vec<token.Token, _> = Vec.with_cap(0)
    p.tokenBuffer = emptyTokens1
    p.tokenNextIndex = 0
    mut var tok0: token.Token = p.nextTokenFromLexer()
    mut var tok0Literal: string = copyString(&tok0.Literal)
    mut var tok0Type: int = stableTokenTypeFromParts(
        tok0.Type,
        &tok0Literal,
    )
    mut var tok0Line: int = tok0.Line
    mut var tok0Column: int = tok0.Column

    mut var tok1: token.Token = p.nextTokenFromLexer()
    mut var tok1Literal: string = copyString(&tok1.Literal)
    mut var tok1Type: int = stableTokenTypeFromParts(
        tok1.Type,
        &tok1Literal,
    )
    mut var tok1Line: int = tok1.Line
    mut var tok1Column: int = tok1.Column

    mut var tok2: token.Token = p.nextTokenFromLexer()
    mut var tok2Literal: string = copyString(&tok2.Literal)
    mut var tok2Type: int = stableTokenTypeFromParts(
        tok2.Type,
        &tok2Literal,
    )
    mut var tok2Line: int = tok2.Line
    mut var tok2Column: int = tok2.Column

    mut var tok3: token.Token = p.nextTokenFromLexer()
    mut var tok3Literal: string = copyString(&tok3.Literal)
    mut var tok3Type: int = stableTokenTypeFromParts(
        tok3.Type,
        &tok3Literal,
    )
    mut var tok3Line: int = tok3.Line
    mut var tok3Column: int = tok3.Column

    if token.TypeEq(
        tok0Type,
        token.EOF,
    ) {
        tok0Literal = EOF_LITERAL_SENTINEL
    }

    if token.TypeEq(
        tok1Type,
        token.EOF,
    ) {
        tok1Literal = EOF_LITERAL_SENTINEL
    }

    if token.TypeEq(
        tok2Type,
        token.EOF,
    ) {
        tok2Literal = EOF_LITERAL_SENTINEL
    }

    if token.TypeEq(
        tok3Type,
        token.EOF,
    ) {
        tok3Literal = EOF_LITERAL_SENTINEL
    }

    p.curType = tok0Type
    p.curLiteral = copyString(&tok0Literal)
    p.curLine = tok0Line
    p.curColumn = tok0Column
    p.peekType = tok1Type
    p.peekLiteral = copyString(&tok1Literal)
    p.peekLine = tok1Line
    p.peekColumn = tok1Column
    p.peek2Type = tok2Type
    p.peek2Literal = copyString(&tok2Literal)
    p.peek2Line = tok2Line
    p.peek2Column = tok2Column
    p.peek3Type = tok3Type
    p.peek3Literal = copyString(&tok3Literal)
    p.peek3Line = tok3Line
    p.peek3Column = tok3Column
    return p
}

func parseSourceDebugEnabled() -> (bool) {
    return false
}

pub func emptyToken() -> (token.Token) {
    return token.MakeToken(
        token.ILLEGAL,
        "",
        0,
        0,
    )
}

pub func ParseSource(
    source: string,
    filePath: string,
) -> (Result<ast.Program, string>) {
    mut var p: Parser = initParserOwnedBootstrap(
        copyString(&source),
        parseSourceDebugEnabled(),
    )

    var program: ast.Program = p.ParseProgram()


    if p.errors.len() > 0 {
        mut var msg: string = "parse errors in " + filePath + ":
"
        mut var ei: int = 0

        while ei < p.errors.len() {
            msg = msg + "  " + p.errors[ei] + "
"
            ei = ei + 1
        }

        return Err(msg)
    }

    return Ok(program)
}

pub func ParseSourceIntoUnchecked(
    source: string,
    filePath: string,
    mut out: &mut ast.Program,
) -> (void) {
    var _filePath: string = filePath
    mut var p: Parser = initParserOwnedBootstrap(
        copyString(&source),
        parseSourceDebugEnabled(),
    )
    var program: ast.Program = p.ParseProgram()

    out.Statements = program.Statements

    return
}

pub func ParseSourceInto(
    source: string,
    filePath: string,
    mut out: &mut ast.Program,
) -> (Result<void, string>) {
    ParseSourceIntoUnchecked(
        source,
        filePath,
        out,
    )

    return Ok(void)
}

pub func ParseSourceCollectItemsUnchecked(
    source: string,
    filePath: string,
    mut funcsOut: &mut Vec<ast.FunctionDecl, _>,
    mut structsOut: &mut Vec<ast.StructDecl, _>,
    mut constsOut: &mut Vec<ast.ConstStatement, _>,
    mut enumsOut: &mut Vec<ast.EnumDecl, _>,
) -> (void) {
    mut var p: Parser = initParserOwnedBootstrap(
        copyString(&source),
        parseSourceDebugEnabled(),
    )

    mut var pkg: string = packageNameFromFilePath(&filePath)

    // TODO: what is the point of this if?
    if pkg == "" {
        pkg = "main"
    }
    var collectPkg: string = copyString(&pkg)
    p.ParseProgramCollectItemsInto(
        &collectPkg,
        funcsOut,
        structsOut,
        constsOut,
        enumsOut,
    )

    return
}

pub func ParseSourceCollectItemsBootstrapUnchecked(
    source: string,
    filePath: string,
    mut funcsOut: &mut Vec<ast.FunctionDecl, _>,
    mut structsOut: &mut Vec<ast.StructDecl, _>,
    mut constsOut: &mut Vec<ast.ConstStatement, _>,
    mut enumsOut: &mut Vec<ast.EnumDecl, _>,
) -> (void) {
    mut var p: Parser = initParserOwnedBootstrap(
        copyString(&source),
        parseSourceDebugEnabled(),
    )
    p.bootstrapSkipBodies = true

    mut var pkg: string = packageNameFromFilePath(&filePath)

    if pkg == "" {
        pkg = "main"
    }
    var collectPkg: string = copyString(&pkg)
    p.ParseProgramCollectItemsInto(
        &collectPkg,
        funcsOut,
        structsOut,
        constsOut,
        enumsOut,
    )

    return
}

pub func ParseSourceCollectItemsForPkgBootstrapUnchecked(
    source: string,
    pkg: string,
    mut funcsOut: &mut Vec<ast.FunctionDecl, _>,
    mut structsOut: &mut Vec<ast.StructDecl, _>,
    mut constsOut: &mut Vec<ast.ConstStatement, _>,
    mut enumsOut: &mut Vec<ast.EnumDecl, _>,
) -> (void) {
    mut var p: Parser = initParserOwnedBootstrap(
        copyString(&source),
        parseSourceDebugEnabled(),
    )
    p.bootstrapSkipBodies = true

    var collectPkg: string = copyString(&pkg)
    p.ParseProgramCollectItemsInto(
        &collectPkg,
        funcsOut,
        structsOut,
        constsOut,
        enumsOut,
    )

    return
}

pub func ParseSourceCollectItemsForPkgUnchecked(
    source: string,
    pkg: string,
    mut funcsOut: &mut Vec<ast.FunctionDecl, _>,
    mut structsOut: &mut Vec<ast.StructDecl, _>,
    mut constsOut: &mut Vec<ast.ConstStatement, _>,
    mut enumsOut: &mut Vec<ast.EnumDecl, _>,
) -> (void) {
    mut var p: Parser = initParserOwnedBootstrap(
        copyString(&source),
        parseSourceDebugEnabled(),
    )
    p.bootstrapSkipBodies = false

    var collectPkg: string = copyString(&pkg)
    p.ParseProgramCollectItemsInto(
        &collectPkg,
        funcsOut,
        structsOut,
        constsOut,
        enumsOut,
    )

    return
}

pub func ParseSourceCollectItemsOwnedUnchecked(
    source: string,
    filePath: string,
) -> (CollectedProgramItems) {
    mut var funcs: Vec<ast.FunctionDecl, _> = Vec.with_cap(32)
    mut var structs: Vec<ast.StructDecl, _> = Vec.with_cap(16)
    mut var consts: Vec<ast.ConstStatement, _> = Vec.with_cap(16)
    mut var enums: Vec<ast.EnumDecl, _> = Vec.with_cap(8)
    ParseSourceCollectItemsUnchecked(
        source,
        filePath,
        &mut funcs,
        &mut structs,
        &mut consts,
        &mut enums,
    )

    return CollectedProgramItems{
        Funcs:   funcs,
        Structs: structs,
        Consts:  consts,
        Enums:   enums,
    }
}

func collectProgramItemsFromProgram(
    pkg: string,
    program: &ast.Program,
    mut funcsOut: &mut Vec<ast.FunctionDecl, _>,
    mut structsOut: &mut Vec<ast.StructDecl, _>,
    mut constsOut: &mut Vec<ast.ConstStatement, _>,
    mut enumsOut: &mut Vec<ast.EnumDecl, _>,
) -> (void) {
    mut var si: int = 0

    while si < program.Statements.len() {
        var stmt: &ast.Statement = &program.Statements[si]

        switch *stmt {
            case ast.Statement.FunctionDecl(fd) {
                mut var fnDecl: ast.FunctionDecl = fd

                if pkg != "main" {
                    fnDecl.Name.Value = copyString(&pkg) + "." + copyString(&fnDecl.Name.Value)
                }

                funcsOut.push(fnDecl)
            }
            case ast.Statement.StructDecl(sd) {
                mut var sDecl: ast.StructDecl = sd

                if pkg != "main" {
                    sDecl.Name.Value = copyString(&pkg) + "." + copyString(&sDecl.Name.Value)
                }

                structsOut.push(sDecl)
            }
            case ast.Statement.EnumDecl(ed) {
                mut var eDecl: ast.EnumDecl = ed

                if pkg != "main" {
                    eDecl.Name.Value = copyString(&pkg) + "." + copyString(&eDecl.Name.Value)
                }

                enumsOut.push(eDecl)
            }
            case ast.Statement.Const(cs) {
                mut var cDecl: ast.ConstStatement = cs

                if pkg != "main" {
                    cDecl.Name.Value = copyString(&pkg) + "." + copyString(&cDecl.Name.Value)
                }

                constsOut.push(cDecl)
            }
            case ast.Statement.ConstBlock(cb) {
                mut var ci: int = 0

                while ci < cb.Constants.len() {
                    mut var cDecl2: ast.ConstStatement = cb.Constants[ci]

                    if pkg != "main" {
                        cDecl2.Name.Value = copyString(&pkg) + "." + copyString(&cDecl2.Name.Value)
                    }

                    constsOut.push(cDecl2)
                    ci = ci + 1
                }
            }
            case ast.Statement.ImplDecl(id) {
                collectParsedImplMethods(
                    pkg,
                    &id,
                    funcsOut,
                )
            }
            default {
            }
        }

        si = si + 1
    }

    return
}

pub func ParseFileCollectItemsUnchecked(
    filePath: string,
    mut funcsOut: &mut Vec<ast.FunctionDecl, _>,
    mut structsOut: &mut Vec<ast.StructDecl, _>,
    mut constsOut: &mut Vec<ast.ConstStatement, _>,
    mut enumsOut: &mut Vec<ast.EnumDecl, _>,
) -> (Result<void, string>) {
    var readRes: Result<string, string> = fs.readFile(filePath)

    switch readRes {
        case Err(err) {
            return Err("error reading file " + filePath + ": " + err)
        }
        case Ok(source) {
            ParseSourceCollectItemsUnchecked(
                source,
                filePath,
                funcsOut,
                structsOut,
                constsOut,
                enumsOut,
            )
            return Ok(void)
        }
    }
}

pub func ParseSourceCollectItems(
    source: string,
    filePath: string,
    mut funcsOut: &mut Vec<ast.FunctionDecl, _>,
    mut structsOut: &mut Vec<ast.StructDecl, _>,
    mut constsOut: &mut Vec<ast.ConstStatement, _>,
    mut enumsOut: &mut Vec<ast.EnumDecl, _>,
) -> (Result<void, string>) {
    ParseSourceCollectItemsUnchecked(
        source,
        filePath,
        funcsOut,
        structsOut,
        constsOut,
        enumsOut,
    )

    return Ok(void)
}

func collectParsedImplMethods(
    pkg: string,
    id: &ast.ImplDecl,
    mut funcsOut: &mut Vec<ast.FunctionDecl, _>,
) -> (void) {
    mut var mi: int = 0

    while mi < id.Methods.len() {
        var md: ast.MethodDecl = id.Methods[mi]
        var fnDecl: ast.FunctionDecl = ast.LowerImplMethod(
            pkg,
            id.TypeName,
            id.Receiver,
            id.Token,
            md,
        )

        funcsOut.push(fnDecl)
        mi = mi + 1
    }
}

pub func ParseSourceToNative(
    source: string,
    filePath: string,
    outPath: string,
) -> (Result<void, string>) {
    var parseRes: Result<ast.Program, string> = ParseSource(
        copyString(&source),
        copyString(&filePath),
    )

    switch parseRes {
        case Err(msg) {
            return Err(msg)
        }
        case Ok(program) {
            return native.WriteProgram(
                &program,
                outPath,
            )
        }
    }
}

pub func ParseFileToNative(
    filePath: string,
    outPath: string,
) -> (Result<void, string>) {
    var readRes: Result<string, string> = fs.readFile(filePath)

    switch readRes {
        case Err(err) {
            return Err("error reading file " + filePath + ": " + err)
        }
        case Ok(source) {
            return ParseSourceToNative(
                source,
                filePath,
                outPath,
            )
        }
    }
}

func tokenTypeEq(a: int, b: int) -> (bool) {
    return a == b
}

func tokenTypeEqRef(a: &int, b: int) -> (bool) {
    return *a == b
}

func precedenceForToken(t: int) -> (int) {
    if tokenTypeEqRef(
        &t,
        token.OR,
    ) {
        return PREC_OR
    }

    if tokenTypeEqRef(
        &t,
        token.AND,
    ) {
        return PREC_AND
    }

    if tokenTypeEqRef(
        &t,
        token.EQ,
    ) || tokenTypeEqRef(
        &t,
        token.NOT_EQ,
    ) {
        return PREC_EQUALS
    }

    if tokenTypeEqRef(
        &t,
        token.LT,
    ) || tokenTypeEqRef(
        &t,
        token.GT,
    ) || tokenTypeEqRef(
        &t,
        token.LT_EQ,
    ) || tokenTypeEqRef(
        &t,
        token.GT_EQ,
    ) {
        return PREC_LESSGREATER
    }

    if tokenTypeEqRef(
        &t,
        token.BITOR,
    ) {
        return PREC_BITOR
    }

    if tokenTypeEqRef(
        &t,
        token.BITXOR,
    ) {
        return PREC_BITXOR
    }

    if tokenTypeEqRef(
        &t,
        token.BITAND,
    ) || tokenTypeEqRef(
        &t,
        token.AMPERSAND,
    ) {
        return PREC_BITAND
    }

    if tokenTypeEqRef(
        &t,
        token.LSHIFT,
    ) || tokenTypeEqRef(
        &t,
        token.RSHIFT,
    ) {
        return PREC_SHIFT
    }

    if tokenTypeEqRef(
        &t,
        token.PLUS,
    ) || tokenTypeEqRef(
        &t,
        token.MINUS,
    ) {
        return PREC_SUM
    }

    if tokenTypeEqRef(
        &t,
        token.SLASH,
    ) || tokenTypeEqRef(
        &t,
        token.ASTERISK,
    ) || tokenTypeEqRef(
        &t,
        token.PERCENT,
    ) {
        return PREC_PRODUCT
    }

    if tokenTypeEqRef(
        &t,
        token.LPAREN,
    ) {
        return PREC_CALL
    }

    if tokenTypeEqRef(
        &t,
        token.LBRACKET,
    ) {
        return PREC_INDEX
    }

    if tokenTypeEqRef(
        &t,
        token.DOT,
    ) {
        return PREC_DOT
    }

    if tokenTypeEqRef(
        &t,
        token.DOTDOT,
    ) {
        return PREC_LESSGREATER
    }

    return PREC_LOWEST
}

func isTypeConversionToken(t: int) -> (bool) {
    return tokenTypeEqRef(
        &t,
        token.TYPE_BOOL,
    ) || tokenTypeEqRef(
        &t,
        token.TYPE_INT,
    ) || tokenTypeEqRef(
        &t,
        token.TYPE_INT8,
    ) || tokenTypeEqRef(
        &t,
        token.TYPE_INT16,
    ) || tokenTypeEqRef(
        &t,
        token.TYPE_INT32,
    ) || tokenTypeEqRef(
        &t,
        token.TYPE_INT64,
    ) || tokenTypeEqRef(
        &t,
        token.TYPE_UINT,
    ) || tokenTypeEqRef(
        &t,
        token.TYPE_UINT8,
    ) || tokenTypeEqRef(
        &t,
        token.TYPE_UINT16,
    ) || tokenTypeEqRef(
        &t,
        token.TYPE_UINT32,
    ) || tokenTypeEqRef(
        &t,
        token.TYPE_UINT64,
    ) || tokenTypeEqRef(
        &t,
        token.TYPE_FLOAT32,
    ) || tokenTypeEqRef(
        &t,
        token.TYPE_FLOAT64,
    ) || tokenTypeEqRef(
        &t,
        token.TYPE_CHAR,
    ) || tokenTypeEqRef(
        &t,
        token.TYPE_STRING,
    ) || tokenTypeEqRef(
        &t,
        token.TYPE_VOID,
    )
}

func isIdentifierLikeTokenType(t: int) -> (bool) {
    if tokenTypeEqRef(
        &t,
        token.IDENT,
    ) {
        return true
    }

    if token.IsKeywordRef(&t) || token.IsTypeRef(&t) {
        return true
    }

    return tokenTypeEqRef(
        &t,
        token.OK,
    ) || tokenTypeEqRef(
        &t,
        token.ERR,
    ) || tokenTypeEqRef(
        &t,
        token.SOME,
    ) || tokenTypeEqRef(
        &t,
        token.NONE,
    ) || tokenTypeEqRef(
        &t,
        token.BOX,
    )
}

func isIdentStartByte(ch: int) -> (bool) {
    if ch == 95 {
        return true
    }

    if ch >= CH_A && ch <= CH_Z {
        return true
    }

    if ch >= CH_a && ch <= 122 {
        return true
    }

    return false
}

func isIdentByte(ch: int) -> (bool) {
    if isIdentStartByte(ch) {
        return true
    }

    return ch >= CH_0 && ch <= CH_9
}

func looksLikeIdentLiteral(lit: &string) -> (bool) {
    if lit.len() == 0 {
        return false
    }

    mut var i: int = 0

    while i < lit.len() {
        var ch: int = (*lit).bytes()[i]

        if i == 0 {
            if !isIdentStartByte(ch) {
                return false
            }
        } else if !isIdentByte(ch) {
            return false
        }

        i = i + 1
    }

    return true
}

func looksLikeNumberLiteral(lit: &string) -> (bool) {
    if lit.len() == 0 {
        return false
    }

    mut var i: int = 0
    mut var seenDot: bool = false

    while i < lit.len() {
        var ch: int = (*lit).bytes()[i]

        if ch == 46 {
            if seenDot {
                return false
            }

            seenDot = true
        } else if !(ch >= CH_0 && ch <= CH_9) {
            return false
        }

        i = i + 1
    }

    return true
}

func canonicalToken(tok: token.Token) -> (token.Token) {
    mut var out: token.Token = tok
    var lit: string = tok.Literal

    if lit.len() == 0 {
        return out
    }

    if tokenTypeEqRef(
        &tok.Type,
        token.STRING,
    ) || tokenTypeEqRef(
        &tok.Type,
        token.CHAR,
    ) {
        return out
    }

    if lit == "=" {
        out.Type = token.ASSIGN

        return out
    }

    if lit == "+" {
        out.Type = token.PLUS

        return out
    }

    if lit == "-" {
        out.Type = token.MINUS

        return out
    }

    if lit == "!" {
        out.Type = token.BANG

        return out
    }

    if lit == "*" {
        out.Type = token.ASTERISK

        return out
    }

    if lit == "/" {
        out.Type = token.SLASH

        return out
    }

    if lit == "%" {
        out.Type = token.PERCENT

        return out
    }

    if lit == "<" {
        out.Type = token.LT

        return out
    }

    if lit == ">" {
        out.Type = token.GT

        return out
    }

    if lit == "==" {
        out.Type = token.EQ

        return out
    }

    if lit == "!=" {
        out.Type = token.NOT_EQ

        return out
    }

    if lit == "<=" {
        out.Type = token.LT_EQ

        return out
    }

    if lit == ">=" {
        out.Type = token.GT_EQ

        return out
    }

    if lit == "&&" {
        out.Type = token.AND

        return out
    }

    if lit == "||" {
        out.Type = token.OR

        return out
    }

    if lit == "&" {
        out.Type = token.AMPERSAND

        return out
    }

    if lit == "|" {
        out.Type = token.BITOR

        return out
    }

    if lit == "^" {
        out.Type = token.BITXOR

        return out
    }

    if lit == "~" {
        out.Type = token.BITNOT

        return out
    }

    if lit == "<<" {
        out.Type = token.LSHIFT

        return out
    }

    if lit == ">>" {
        out.Type = token.RSHIFT

        return out
    }

    if lit == "," {
        out.Type = token.COMMA

        return out
    }

    if lit == ";" {
        out.Type = token.SEMICOLON

        return out
    }

    if lit == ":" {
        out.Type = token.COLON

        return out
    }

    if lit == "." {
        out.Type = token.DOT

        return out
    }

    if lit == ".." {
        out.Type = token.DOTDOT

        return out
    }

    if lit == "->" {
        out.Type = token.ARROW

        return out
    }

    if lit == "(" {
        out.Type = token.LPAREN

        return out
    }

    if lit == ")" {
        out.Type = token.RPAREN

        return out
    }

    if lit == "{" {
        out.Type = token.LBRACE

        return out
    }

    if lit == "}" {
        out.Type = token.RBRACE

        return out
    }

    if lit == "[" {
        out.Type = token.LBRACKET

        return out
    }

    if lit == "]" {
        out.Type = token.RBRACKET

        return out
    }

    if lit == "_" {
        out.Type = token.UNDERSCORE

        return out
    }

    if lit == "?" {
        out.Type = token.QUESTION

        return out
    }

    if looksLikeIdentLiteral(&lit) {
        out.Type = token.LookupIdent(lit)

        return out
    }

    if looksLikeNumberLiteral(&lit) {
        mut var hasDot: bool = false
        mut var i: int = 0

        while i < lit.len() {
            if lit.bytes()[i] == 46 {
                hasDot = true
                i = lit.len()
            } else {
                i = i + 1
            }
        }

        if hasDot {
            out.Type = token.FLOAT
        } else {
            out.Type = token.INT
        }

        return out
    }

    if isIdentifierLikeTokenType(tok.Type) {
        if lit == "package" {
            out.Type = token.PACKAGE

            return out
        }

        if lit == "var" {
            out.Type = token.VAR

            return out
        }

        if lit == "const" {
            out.Type = token.CONST

            return out
        }

        if lit == "mut" {
            out.Type = token.MUT

            return out
        }

        if lit == "func" {
            out.Type = token.FUNC

            return out
        }

        if lit == "return" {
            out.Type = token.RETURN

            return out
        }

        if lit == "struct" {
            out.Type = token.STRUCT

            return out
        }

        if lit == "enum" {
            out.Type = token.ENUM

            return out
        }

        if lit == "impl" {
            out.Type = token.IMPL

            return out
        }

        if lit == "if" {
            out.Type = token.IF

            return out
        }

        if lit == "else" {
            out.Type = token.ELSE

            return out
        }

        if lit == "while" {
            out.Type = token.WHILE

            return out
        }

        if lit == "for" {
            out.Type = token.FOR

            return out
        }

        if lit == "in" {
            out.Type = token.IN

            return out
        }

        if lit == "switch" {
            out.Type = token.SWITCH

            return out
        }

        if lit == "case" {
            out.Type = token.CASE

            return out
        }

        if lit == "default" {
            out.Type = token.DEFAULT

            return out
        }

        if lit == "import" {
            out.Type = token.IMPORT

            return out
        }

        if lit == "unsafe" {
            out.Type = token.UNSAFE

            return out
        }

        if lit == "defer" {
            out.Type = token.DEFER

            return out
        }

        if lit == "panic" {
            out.Type = token.PANIC

            return out
        }

        if lit == "void" {
            out.Type = token.VOID

            return out
        }

        if lit == "as" {
            out.Type = token.AS

            return out
        }

        if lit == "break" {
            out.Type = token.BREAK

            return out
        }

        if lit == "continue" {
            out.Type = token.CONTINUE

            return out
        }

        if lit == "type" {
            out.Type = token.TYPE

            return out
        }

        if lit == "alias" {
            out.Type = token.ALIAS

            return out
        }

        if lit == "true" {
            out.Type = token.TRUE

            return out
        }

        if lit == "false" {
            out.Type = token.FALSE

            return out
        }

        if lit == "pub" {
            out.Type = token.PUB

            return out
        }

        if lit == "bool" {
            out.Type = token.TYPE_BOOL

            return out
        }

        if lit == "int" {
            out.Type = token.TYPE_INT

            return out
        }

        if lit == "int8" {
            out.Type = token.TYPE_INT8

            return out
        }

        if lit == "int16" {
            out.Type = token.TYPE_INT16

            return out
        }

        if lit == "int32" {
            out.Type = token.TYPE_INT32

            return out
        }

        if lit == "int64" {
            out.Type = token.TYPE_INT64

            return out
        }

        if lit == "uint" {
            out.Type = token.TYPE_UINT

            return out
        }

        if lit == "uint8" {
            out.Type = token.TYPE_UINT8

            return out
        }

        if lit == "uint16" {
            out.Type = token.TYPE_UINT16

            return out
        }

        if lit == "uint32" {
            out.Type = token.TYPE_UINT32

            return out
        }

        if lit == "uint64" {
            out.Type = token.TYPE_UINT64

            return out
        }

        if lit == "float32" {
            out.Type = token.TYPE_FLOAT32

            return out
        }

        if lit == "float64" {
            out.Type = token.TYPE_FLOAT64

            return out
        }

        if lit == "char" {
            out.Type = token.TYPE_CHAR

            return out
        }

        if lit == "string" {
            out.Type = token.TYPE_STRING

            return out
        }

        if lit == "Vec" {
            out.Type = token.VEC

            return out
        }

        if lit == "Result" {
            out.Type = token.RESULT

            return out
        }

        if lit == "Option" {
            out.Type = token.OPTION

            return out
        }

        if lit == "Ok" {
            out.Type = token.OK

            return out
        }

        if lit == "Err" {
            out.Type = token.ERR

            return out
        }

        if lit == "Some" {
            out.Type = token.SOME

            return out
        }

        if lit == "None" {
            out.Type = token.NONE

            return out
        }

        if lit == "box" {
            out.Type = token.BOX

            return out
        }

        out.Type = token.IDENT
    }

    return out
}

func stableTokenTypeFromParts(inType: int, lit: &string) -> (int) {
    if lit.len() == 0 {
        return inType
    }

    if tokenTypeEq(
        inType,
        token.STRING,
    ) || tokenTypeEq(
        inType,
        token.CHAR,
    ) {
        return inType
    }

    if *lit == "(" {
        return token.LPAREN
    }

    if *lit == ")" {
        return token.RPAREN
    }

    if *lit == "{" {
        return token.LBRACE
    }

    if *lit == "}" {
        return token.RBRACE
    }

    if *lit == "[" {
        return token.LBRACKET
    }

    if *lit == "]" {
        return token.RBRACKET
    }

    if *lit == "." {
        return token.DOT
    }

    if *lit == ".." {
        return token.DOTDOT
    }

    if *lit == "," {
        return token.COMMA
    }

    if *lit == ":" {
        return token.COLON
    }

    if *lit == ";" {
        return token.SEMICOLON
    }

    if *lit == "=" {
        return token.ASSIGN
    }

    if *lit == "==" {
        return token.EQ
    }

    if *lit == "!=" {
        return token.NOT_EQ
    }

    if *lit == "<" {
        return token.LT
    }

    if *lit == ">" {
        return token.GT
    }

    if *lit == "<=" {
        return token.LT_EQ
    }

    if *lit == ">=" {
        return token.GT_EQ
    }

    if *lit == "+" {
        return token.PLUS
    }

    if *lit == "-" {
        return token.MINUS
    }

    if *lit == "*" {
        return token.ASTERISK
    }

    if *lit == "/" {
        return token.SLASH
    }

    if *lit == "%" {
        return token.PERCENT
    }

    if *lit == "&&" {
        return token.AND
    }

    if *lit == "||" {
        return token.OR
    }

    if *lit == "&" {
        return token.AMPERSAND
    }

    if *lit == "|" {
        return token.BITOR
    }

    if *lit == "^" {
        return token.BITXOR
    }

    if *lit == "~" {
        return token.BITNOT
    }

    if *lit == "<<" {
        return token.LSHIFT
    }

    if *lit == ">>" {
        return token.RSHIFT
    }

    if *lit == "->" {
        return token.ARROW
    }

    if *lit == "?" {
        return token.QUESTION
    }

    if looksLikeIdentLiteral(lit) {
        return token.LookupIdent(*lit)
    }

    if looksLikeNumberLiteral(lit) {
        mut var hasDot: bool = false
        mut var i: int = 0

        while i < lit.len() {
            if lit.bytes()[i] == 46 {
                hasDot = true
                i = lit.len()
            } else {
                i = i + 1
            }
        }

        if hasDot {
            return token.FLOAT
        }

        return token.INT
    }

    return inType
}

func copyString(value: &string) -> (string) {
    if value.len() == 0 {
        return ""
    }

    return (*value).substring(
        0,
        value.len(),
    )
}

func packageNameFromFilePath(pathValue: &string) -> (string) {
    mut var start: int = 0
    mut var i: int = 0

    while i < pathValue.len() {
        if (*pathValue)[i] == '/' {
            start = i + 1
        }

        i = i + 1
    }

    mut var end: int = pathValue.len()
    mut var j: int = start

    while j < pathValue.len() {
        if (*pathValue)[j] == '.' {
            end = j
            j = pathValue.len()
        } else {
            j = j + 1
        }
    }

    if end <= start {
        return "main"
    }

    var base: string = pathValue.substring(
        start,
        end,
    )

    if base == "" {
        return "main"
    }

    return base
}

impl Parser as p {
    func curTokenValue() -> (token.Token) {
        return token.MakeToken(
            p.curType,
            p.curLiteral,
            p.curLine,
            p.curColumn,
        )
    }

    func peekTokenValue() -> (token.Token) {
        return token.MakeToken(
            p.peekType,
            p.peekLiteral,
            p.peekLine,
            p.peekColumn,
        )
    }

    func peek2TokenValue() -> (token.Token) {
        return token.MakeToken(
            p.peek2Type,
            p.peek2Literal,
            p.peek2Line,
            p.peek2Column,
        )
    }

    func peek3TokenValue() -> (token.Token) {
        return token.MakeToken(
            p.peek3Type,
            p.peek3Literal,
            p.peek3Line,
            p.peek3Column,
        )
    }

    pub func Errors() -> (Vec<string, _>) {
        return p.errors
    }

    mut func nextTokenFromLexer() -> (token.Token) {
        return lexer.nextTokenFrom(&mut p.l)
    }

    mut func advanceToken() -> (void) {
        if p.curTokenIs(token.EOF) {
            return
        }

        p.curType = p.peekType
        p.curLiteral = copyString(&p.peekLiteral)
        p.curLine = p.peekLine
        p.curColumn = p.peekColumn
        p.peekType = p.peek2Type
        p.peekLiteral = copyString(&p.peek2Literal)
        p.peekLine = p.peek2Line
        p.peekColumn = p.peek2Column
        p.peek2Type = p.peek3Type
        p.peek2Literal = copyString(&p.peek3Literal)
        p.peek2Line = p.peek3Line
        p.peek2Column = p.peek3Column

        var fetchedTok: token.Token = p.nextTokenFromLexer()
        var fetchedLiteral: string = fetchedTok.Literal
        var fetchedType: int = fetchedTok.Type
        var fetchedLine: int = fetchedTok.Line
        var fetchedColumn: int = fetchedTok.Column

        if tokenTypeEq(
            fetchedType,
            token.EOF,
        ) {
            p.peek3Type = token.EOF
            p.peek3Literal = EOF_LITERAL_SENTINEL
            p.peek3Line = fetchedLine
            p.peek3Column = fetchedColumn
        } else {
            p.peek3Type = fetchedType
            p.peek3Literal = copyString(&fetchedLiteral)
            p.peek3Line = fetchedLine
            p.peek3Column = fetchedColumn
        }

        p.debugShiftCount = p.debugShiftCount + 1

        return
    }

    mut func refillTokenWindowFromLexer() -> (void) {
        mut var baseIndex: int = p.tokenNextIndex - 4

        if baseIndex < 0 {
            baseIndex = 0
        }

        mut var tok0: token.Token = tokenBufferAt(
            &p.tokenBuffer,
            baseIndex,
        )
        mut var tok1: token.Token = tokenBufferAt(
            &p.tokenBuffer,
            baseIndex + 1,
        )
        mut var tok2: token.Token = tokenBufferAt(
            &p.tokenBuffer,
            baseIndex + 2,
        )
        mut var tok3: token.Token = tokenBufferAt(
            &p.tokenBuffer,
            baseIndex + 3,
        )

        mut var lit0: string = copyString(&tok0.Literal)
        mut var type0: int = stableTokenTypeFromParts(
            tok0.Type,
            &lit0,
        )
        mut var lit1: string = copyString(&tok1.Literal)
        mut var type1: int = stableTokenTypeFromParts(
            tok1.Type,
            &lit1,
        )
        mut var lit2: string = copyString(&tok2.Literal)
        mut var type2: int = stableTokenTypeFromParts(
            tok2.Type,
            &lit2,
        )
        mut var lit3: string = copyString(&tok3.Literal)
        mut var type3: int = stableTokenTypeFromParts(
            tok3.Type,
            &lit3,
        )

        if tokenTypeEq(
            type0,
            token.EOF,
        ) {
            lit0 = EOF_LITERAL_SENTINEL
        }

        if tokenTypeEq(
            type1,
            token.EOF,
        ) {
            lit1 = EOF_LITERAL_SENTINEL
        }

        if tokenTypeEq(
            type2,
            token.EOF,
        ) {
            lit2 = EOF_LITERAL_SENTINEL
        }

        if tokenTypeEq(
            type3,
            token.EOF,
        ) {
            lit3 = EOF_LITERAL_SENTINEL
        }

        p.curType = type0
        p.curLiteral = copyString(&lit0)
        p.curLine = tok0.Line
        p.curColumn = tok0.Column
        p.peekType = type1
        p.peekLiteral = copyString(&lit1)
        p.peekLine = tok1.Line
        p.peekColumn = tok1.Column
        p.peek2Type = type2
        p.peek2Literal = copyString(&lit2)
        p.peek2Line = tok2.Line
        p.peek2Column = tok2.Column
        p.peek3Type = type3
        p.peek3Literal = copyString(&lit3)
        p.peek3Line = tok3.Line
        p.peek3Column = tok3.Column
        p.tokenNextIndex = baseIndex + 4

        return
    }

    mut func skipCurrentLineAndResync() -> (void) {
        mut var targetLine: int = p.curLine

        while !p.curTokenIs(token.EOF) && p.curLine == targetLine {
            p.advanceToken()
        }

        return
    }

    mut func skipImportDeclForCollect() -> (void) {
        if !p.curKeywordIs(token.IMPORT, "import") {
            return
        }

        if p.peekTokenIs(token.LPAREN) {
            // import (...) block: advance until matching ')'
            p.advanceToken()
            mut var depth: int = 0

            if p.curTokenIs(token.LPAREN) {
                depth = 1
                p.advanceToken()
            }

            while !p.curTokenIs(token.EOF) && depth > 0 {
                if p.curTokenIs(token.LPAREN) {
                    depth = depth + 1
                } else if p.curTokenIs(token.RPAREN) {
                    depth = depth - 1
                }

                p.advanceToken()
            }

            return
        }

        // Single-line import.
        p.skipCurrentLineAndResync()
        return
    }

    func curTokenIs(t: int) -> (bool) {
        return tokenTypeEq(
            p.curType,
            t,
        )
    }

    func peekTokenIs(t: int) -> (bool) {
        return tokenTypeEq(
            p.peekType,
            t,
        )
    }

    func peek2TokenIs(t: int) -> (bool) {
        return tokenTypeEq(
            p.peek2Type,
            t,
        )
    }

    func peek3TokenIs(t: int) -> (bool) {
        return tokenTypeEq(
            p.peek3Type,
            t,
        )
    }

    func curKeywordIs(t: int, keyword: string) -> (bool) {
        var _keyword: string = keyword

        return p.curTokenIs(t)
    }

    func peekKeywordIs(t: int, keyword: string) -> (bool) {
        var _keyword: string = keyword

        return p.peekTokenIs(t)
    }

    mut func expectPeek(t: int) -> (bool) {
        if p.peekTokenIs(t) {
            p.advanceToken()

            return true
        }

        p.peekError(t)

        return false
    }

    func peekPrecedence() -> (int) {
        return precedenceForToken(p.peekType)
    }

    func curPrecedence() -> (int) {
        return precedenceForToken(p.curType)
    }

    mut func peekError(t: int) -> (void) {
        var _t: int = t

        p.errors.push("parse error P1")
    }

    mut func noPrefixParseFnError(t: int) -> (void) {
        var _t: int = t

        return
    }

    pub mut func ParseProgram() -> (ast.Program) {
        mut var statements: Vec<ast.Statement, _> = Vec.with_cap(256)

        while true {
            if p.curTokenIs(token.EOF) {
                break
            }

            var stmt: Option<ast.Statement> = p.parseStatement()

            switch stmt {
                case Some(s) {
                    statements.push(s)
                }
                case None {
                }
            }

            p.advanceToken()
        }

        return ast.ProgramFromStatements(statements)
    }

    pub mut func ParseProgramCollectItemsInto(
        pkg: &string,
        mut funcsOut: &mut Vec<ast.FunctionDecl, _>,
        mut structsOut: &mut Vec<ast.StructDecl, _>,
        mut constsOut: &mut Vec<ast.ConstStatement, _>,
        mut enumsOut: &mut Vec<ast.EnumDecl, _>,
    ) -> (void) {
        var pkgValue: string = copyString(pkg)
        p.collectPkg = copyString(&pkgValue)

        while true {
            if p.curTokenIs(token.EOF) {
                break
            }

            if p.curKeywordIs(token.PACKAGE, "package") {
                p.parsePackageStatement()
                p.advanceToken()
                continue
            }

            if p.curKeywordIs(token.IMPORT, "import") {
                p.skipImportDeclForCollect()
                continue
            }

            if p.curKeywordIs(token.PUB, "pub") {
                p.advanceToken()

                if p.curKeywordIs(token.FUNC, "func") {
                    var pubFn: Option<ast.FunctionDecl> = p.parseFunctionDeclWithVisibility(
                        ast.Visibility.Public,
                    )

                    switch pubFn {
                        case Some(fd) {
                            if pkgValue != "main" {
                                mut var outFd: ast.FunctionDecl = fd
                                var qName: string = pkgValue + "." + outFd.Name.Value
                                outFd.Name.Value = copyString(&qName)
                                funcsOut.push(outFd)
                            } else {
                                funcsOut.push(fd)
                            }
                        }
                        case None {
                        }
                    }

                    p.advanceToken()
                    continue
                }

                if p.curKeywordIs(token.STRUCT, "struct") {
                    var pubStruct: Option<ast.StructDecl> = p.parseStructDecl()

                    switch pubStruct {
                        case Some(sd) {
                            mut var qsd: ast.StructDecl = sd

                            qsd.Visibility = ast.Visibility.Public

                            if pkgValue != "main" {
                                qsd.Name.Value = pkgValue + "." + qsd.Name.Value
                            }

                            structsOut.push(qsd)
                        }
                        case None {
                        }
                    }

                    p.advanceToken()
                    continue
                }

                if p.curKeywordIs(token.ENUM, "enum") {
                    var pubEnum: Option<ast.EnumDecl> = p.parseEnumDecl()

                    switch pubEnum {
                        case Some(ed) {
                            mut var qed: ast.EnumDecl = ed

                            qed.Visibility = ast.Visibility.Public

                            if pkgValue != "main" {
                                qed.Name.Value = pkgValue + "." + qed.Name.Value
                            }

                            enumsOut.push(qed)
                        }
                        case None {
                        }
                    }

                    p.advanceToken()
                    continue
                }

                if p.curKeywordIs(token.CONST, "const") {
                    var constIsBlock: bool = p.peekTokenIs(token.LPAREN)

                    if constIsBlock {
                        var pubConstBlock: Option<ast.ConstBlock> = p.parseConstBlock()

                        switch pubConstBlock {
                            case Some(cbPub) {
                                mut var ciPub: int = 0

                                while ciPub < cbPub.Constants.len() {
                                    mut var cPub: ast.ConstStatement = cbPub.Constants[ciPub]

                                    cPub.Visibility = ast.Visibility.Public

                                    if pkgValue != "main" {
                                        cPub.Name.Value = pkgValue + "." + cPub.Name.Value
                                    }

                                    constsOut.push(cPub)
                                    ciPub = ciPub + 1
                                }
                            }
                            case None {
                            }
                        }
                    } else {
                        if pkgValue == "token" {
                            var fastConst: Option<ast.ConstStatement> = p.parseTokenFastConst(
                                &pkgValue,
                            )

                            switch fastConst {
                                case Some(csFast) {
                                    constsOut.push(csFast)
                                }
                                case None {
                                }
                            }

                            p.skipCurrentLineAndResync()
                            continue
                        }

                        var pubConst: Option<ast.ConstStatement> = p.parseConstStatement()

                        switch pubConst {
                            case Some(csPub) {
                                mut var qcsPub: ast.ConstStatement = csPub

                                qcsPub.Visibility = ast.Visibility.Public

                                if pkgValue != "main" {
                                    qcsPub.Name.Value = pkgValue + "." + qcsPub.Name.Value
                                }

                                constsOut.push(qcsPub)
                            }
                            case None {
                            }
                        }
                    }

                    p.advanceToken()
                    continue
                }

                if p.curKeywordIs(token.IMPL, "impl") {
                    var pubImplOpt: Option<ast.ImplDecl> = p.parseImplDecl()

                    switch pubImplOpt {
                        case Some(pubImpl) {
                            collectParsedImplMethods(
                                pkgValue,
                                &pubImpl,
                                funcsOut,
                            )
                        }
                        case None {
                        }
                    }

                    p.advanceToken()
                    continue
                }

                if p.curKeywordIs(token.TYPE, "type") {
                    p.parseTypeDecl()
                    p.advanceToken()
                    continue
                }

                if p.curKeywordIs(token.ALIAS, "alias") {
                    p.parseAliasDecl()
                    p.advanceToken()
                    continue
                }

                if p.curKeywordIs(token.IMPORT, "import") {
                    p.skipImportDeclForCollect()
                    continue
                }

                p.advanceToken()
                continue
            }

            if p.curKeywordIs(token.FUNC, "func") {
                var fn: Option<ast.FunctionDecl> = p.parseFunctionDecl()

                switch fn {
                    case Some(fd2) {
                        if pkgValue != "main" {
                            mut var outFd2: ast.FunctionDecl = fd2
                            var qName2: string = pkgValue + "." + outFd2.Name.Value
                            outFd2.Name.Value = copyString(&qName2)
                            funcsOut.push(outFd2)
                        } else {
                            funcsOut.push(fd2)
                        }
                    }
                    case None {
                    }
                }

                p.advanceToken()
                continue
            }

            if p.curKeywordIs(token.STRUCT, "struct") {
                var sd2Opt: Option<ast.StructDecl> = p.parseStructDecl()

                switch sd2Opt {
                    case Some(sd2) {
                        if pkgValue != "main" {
                            mut var qsd2: ast.StructDecl = sd2
                            qsd2.Name.Value = pkgValue + "." + qsd2.Name.Value
                            structsOut.push(qsd2)
                        } else {
                            structsOut.push(sd2)
                        }
                    }
                    case None {
                    }
                }

                p.advanceToken()
                continue
            }

            if p.curKeywordIs(token.ENUM, "enum") {
                var ed2Opt: Option<ast.EnumDecl> = p.parseEnumDecl()

                switch ed2Opt {
                    case Some(ed2) {
                        if pkgValue != "main" {
                            mut var qed2: ast.EnumDecl = ed2
                            qed2.Name.Value = pkgValue + "." + qed2.Name.Value
                            enumsOut.push(qed2)
                        } else {
                            enumsOut.push(ed2)
                        }
                    }
                    case None {
                    }
                }

                p.advanceToken()
                continue
            }

            if p.curKeywordIs(token.CONST, "const") {
                if p.peekTokenIs(token.LPAREN) {
                    var cb2Opt: Option<ast.ConstBlock> = p.parseConstBlock()

                    switch cb2Opt {
                        case Some(cb2) {
                            mut var ci2: int = 0

                            while ci2 < cb2.Constants.len() {
                                mut var c2: ast.ConstStatement = cb2.Constants[ci2]

                                if pkgValue != "main" {
                                    c2.Name.Value = pkgValue + "." + c2.Name.Value
                                }

                                constsOut.push(c2)
                                ci2 = ci2 + 1
                            }
                        }
                        case None {
                        }
                    }
                } else {
                    var cs2Opt: Option<ast.ConstStatement> = p.parseConstStatement()

                    switch cs2Opt {
                        case Some(cs2) {
                            if pkgValue != "main" {
                                mut var qcs2: ast.ConstStatement = cs2
                                qcs2.Name.Value = pkgValue + "." + qcs2.Name.Value
                                constsOut.push(qcs2)
                            } else {
                                constsOut.push(cs2)
                            }
                        }
                        case None {
                        }
                    }
                }

                p.advanceToken()
                continue
            }

            if p.curKeywordIs(token.IMPL, "impl") {
                var implOpt: Option<ast.ImplDecl> = p.parseImplDecl()

                switch implOpt {
                    case Some(id2) {
                        collectParsedImplMethods(
                            pkgValue,
                            &id2,
                            funcsOut,
                        )
                    }
                    case None {
                    }
                }

                p.advanceToken()
                continue
            }

            p.advanceToken()
        }


        return
    }

    mut func parseTokenFastConst(pkg: &string) -> (Option<ast.ConstStatement>) {
        if !p.peekTokenIs(token.IDENT) {
            return None
        }

        var nameValue: string = copyString(&p.peekLiteral)
        var intValue: int = p.tokenFastConstNext

        p.tokenFastConstNext = p.tokenFastConstNext + 1

        var constTok: token.Token = token.MakeToken(
            token.CONST,
            "const",
            p.curLine,
            p.curColumn,
        )
        var nameTok: token.Token = token.MakeToken(
            token.IDENT,
            copyString(&nameValue),
            p.peekLine,
            p.peekColumn,
        )
        var nameIdent: ast.Identifier = ast.IdentifierFromTokenValue(
            nameTok,
            copyString(&nameValue),
        )
        var intTypeTok: token.Token = token.MakeToken(
            token.TYPE_INT,
            "int",
            p.peekLine,
            p.peekColumn,
        )
        var intType: ast.TypeExpression = ast.TypeExpressionSimpleByName(
            intTypeTok,
            "int",
        )
        var intLitTok: token.Token = token.MakeToken(
            token.INT,
            intValue.toString(),
            p.peekLine,
            p.peekColumn,
        )
        var intLit: ast.IntegerLiteral = ast.IntegerLiteralFromParts(
            intLitTok,
            intValue,
        )
        mut var out: ast.ConstStatement = ast.ConstStatementFromParts(
            constTok,
            nameIdent,
            ast.Visibility.Public,
            Some(intType),
            ast.Expression.IntegerLiteral(intLit),
        )

        if *pkg != "main" {
            out.Name.Value = copyString(pkg) + "." + out.Name.Value
        }

        return Some(out)
    }

    mut func parseStatement() -> (Option<ast.Statement>) {
        if p.curKeywordIs(token.PUB, "pub") {
            return p.parsePubDecl()
        }

        if p.curKeywordIs(token.PACKAGE, "package") {
            return p.parsePackageStatement()
        }

        if p.curKeywordIs(token.IMPORT, "import") {
            return p.parseImportBlock()
        }

        if p.curKeywordIs(token.VAR, "var") || p.curKeywordIs(token.MUT, "mut") || p.curKeywordIs(token.CONST, "const") || p.curKeywordIs(token.FUNC, "func") || p.curKeywordIs(token.STRUCT, "struct") || p.curKeywordIs(token.ENUM, "enum") || p.curKeywordIs(token.TYPE, "type") || p.curKeywordIs(token.ALIAS, "alias") || p.curKeywordIs(token.IMPL, "impl") {
            return p.parseDeclStatement()
        }

        if p.curKeywordIs(token.RETURN, "return") || p.curKeywordIs(token.IF, "if") || p.curKeywordIs(token.WHILE, "while") || p.curKeywordIs(token.FOR, "for") || p.curKeywordIs(token.SWITCH, "switch") || p.curKeywordIs(token.DEFER, "defer") || p.curKeywordIs(token.PANIC, "panic") || p.curKeywordIs(token.UNSAFE, "unsafe") {
            return p.parseControlStatement()
        }

        if p.curKeywordIs(token.BREAK, "break") {
            return Some(
                ast.Statement.Break(
                    ast.BreakStatementFromToken(p.curTokenValue()),
                ),
            )
        }

        if p.curKeywordIs(token.CONTINUE, "continue") {
            return Some(
                ast.Statement.Continue(
                    ast.ContinueStatementFromToken(p.curTokenValue()),
                ),
            )
        }

        if p.curTokenIs(token.SEMICOLON) {
            return None
        }

        if p.curTokenIs(token.LBRACE) {
            var block: ast.BlockStatement = p.parseBlockStatement()

            return Some(ast.Statement.Block(block))
        }

        return p.parseExpressionOrAssignment()
    }

    mut func parseDeclStatement() -> (Option<ast.Statement>) {
        if p.curKeywordIs(token.VAR, "var") {
            return p.parseVarDeclStatement()
        }

        if p.curKeywordIs(token.MUT, "mut") {
            return p.parseMutDeclStatement()
        }

        if p.curKeywordIs(token.CONST, "const") {
            return p.parseConstDeclStatement()
        }

        if p.curKeywordIs(token.FUNC, "func") {
            return p.parseFunctionDeclStatement()
        }

        if p.curKeywordIs(token.STRUCT, "struct") {
            return p.parseStructDeclStatement()
        }

        if p.curKeywordIs(token.ENUM, "enum") {
            return p.parseEnumDeclStatement()
        }

        if p.curKeywordIs(token.TYPE, "type") {
            return p.parseTypeDeclStatement()
        }

        if p.curKeywordIs(token.ALIAS, "alias") {
            return p.parseAliasDeclStatement()
        }

        if p.curKeywordIs(token.IMPL, "impl") {
            return p.parseImplDeclStatement()
        }

        return None
    }

    mut func parseVarDeclStatement() -> (Option<ast.Statement>) {
        if p.peekTokenIs(token.LPAREN) {
            if p.peek2TokenIs(token.IDENT) || p.peek2TokenIs(token.UNDERSCORE) {
                return p.parseVarStatement(false)
            }

            var block: Option<ast.VarBlock> = p.parseVarBlock()

            switch block {
                case Some(vb) {
                    return Some(ast.Statement.VarBlock(vb))
                }
                case None {
                    return None
                }
            }
        }

        return p.parseVarStatement(false)
    }

    mut func parseMutDeclStatement() -> (Option<ast.Statement>) {
        if p.peekTokenIs(token.VAR) {
            p.advanceToken()

            return p.parseVarStatement(true)
        }

        if p.peekTokenIs(token.FUNC) {
            return None
        }

        return None
    }

    mut func parseConstDeclStatement() -> (Option<ast.Statement>) {
        if p.peekTokenIs(token.LPAREN) {
            var block: Option<ast.ConstBlock> = p.parseConstBlock()

            switch block {
                case Some(cb) {
                    return Some(ast.Statement.ConstBlock(cb))
                }
                case None {
                    return None
                }
            }
        }

        var cs: Option<ast.ConstStatement> = p.parseConstStatement()

        switch cs {
            case Some(c) {
                return Some(ast.Statement.Const(c))
            }
            case None {
                return None
            }
        }
    }

    mut func parseFunctionDeclStatement() -> (Option<ast.Statement>) {
        var fn: Option<ast.FunctionDecl> = p.parseFunctionDecl()

        switch fn {
            case Some(f) {
                return Some(ast.Statement.FunctionDecl(f))
            }
            case None {
                return None
            }
        }
    }

    mut func parseStructDeclStatement() -> (Option<ast.Statement>) {
        var sd: Option<ast.StructDecl> = p.parseStructDecl()

        switch sd {
            case Some(s) {
                return Some(ast.Statement.StructDecl(s))
            }
            case None {
                return None
            }
        }
    }

    mut func parseEnumDeclStatement() -> (Option<ast.Statement>) {
        var ed: Option<ast.EnumDecl> = p.parseEnumDecl()

        switch ed {
            case Some(e) {
                return Some(ast.Statement.EnumDecl(e))
            }
            case None {
                return None
            }
        }
    }

    mut func parseTypeDeclStatement() -> (Option<ast.Statement>) {
        var td: Option<ast.TypeDecl> = p.parseTypeDecl()

        switch td {
            case Some(t) {
                return Some(ast.Statement.TypeDecl(t))
            }
            case None {
                return None
            }
        }
    }

    mut func parseAliasDeclStatement() -> (Option<ast.Statement>) {
        var ad: Option<ast.AliasDecl> = p.parseAliasDecl()

        switch ad {
            case Some(a) {
                return Some(ast.Statement.AliasDecl(a))
            }
            case None {
                return None
            }
        }
    }

    mut func parseImplDeclStatement() -> (Option<ast.Statement>) {
        var id: Option<ast.ImplDecl> = p.parseImplDecl()

        switch id {
            case Some(i) {
                return Some(ast.Statement.ImplDecl(i))
            }
            case None {
                return None
            }
        }
    }

    mut func parseControlStatement() -> (Option<ast.Statement>) {
        if p.curTokenIs(token.RETURN) {
            return p.parseReturnStatement()
        }

        if p.curTokenIs(token.IF) {
            return p.parseIfControlStatement()
        }

        if p.curTokenIs(token.WHILE) {
            return p.parseWhileControlStatement()
        }

        if p.curTokenIs(token.FOR) {
            return p.parseForControlStatement()
        }

        if p.curTokenIs(token.SWITCH) {
            return p.parseSwitchControlStatement()
        }

        if p.curTokenIs(token.DEFER) {
            return p.parseDeferControlStatement()
        }

        if p.curTokenIs(token.PANIC) {
            return p.parsePanicControlStatement()
        }

        if p.curTokenIs(token.UNSAFE) {
            return p.parseUnsafeControlStatement()
        }

        return None
    }

    mut func parseIfControlStatement() -> (Option<ast.Statement>) {
        var stmt: Option<ast.IfStatement> = p.parseIfStatement()

        switch stmt {
            case Some(s) {
                return Some(ast.Statement.If(s))
            }
            case None {
                return None
            }
        }
    }

    mut func parseWhileControlStatement() -> (Option<ast.Statement>) {
        var stmt: Option<ast.WhileStatement> = p.parseWhileStatement()

        switch stmt {
            case Some(s) {
                return Some(ast.Statement.While(s))
            }
            case None {
                return None
            }
        }
    }

    mut func parseForControlStatement() -> (Option<ast.Statement>) {
        var stmt: Option<ast.ForStatement> = p.parseForStatement()

        switch stmt {
            case Some(s) {
                return Some(ast.Statement.For(s))
            }
            case None {
                return None
            }
        }
    }

    mut func parseSwitchControlStatement() -> (Option<ast.Statement>) {
        var stmt: Option<ast.SwitchStatement> = p.parseSwitchStatement()

        switch stmt {
            case Some(s) {
                return Some(ast.Statement.Switch(s))
            }
            case None {
                return None
            }
        }
    }

    mut func parseDeferControlStatement() -> (Option<ast.Statement>) {
        var stmt: Option<ast.DeferStatement> = p.parseDeferStatement()

        switch stmt {
            case Some(s) {
                return Some(ast.Statement.Defer(s))
            }
            case None {
                return None
            }
        }
    }

    mut func parsePanicControlStatement() -> (Option<ast.Statement>) {
        var stmt: Option<ast.PanicStatement> = p.parsePanicStatement()

        switch stmt {
            case Some(s) {
                return Some(ast.Statement.Panic(s))
            }
            case None {
                return None
            }
        }
    }

    mut func parseUnsafeControlStatement() -> (Option<ast.Statement>) {
        var stmt: Option<ast.UnsafeBlock> = p.parseUnsafeBlock()

        switch stmt {
            case Some(s) {
                return Some(ast.Statement.Unsafe(s))
            }
            case None {
                return None
            }
        }
    }

    mut func parsePackageStatement() -> (Option<ast.Statement>) {
        var pkgTok: token.Token = p.curTokenValue()

        // Accept either IDENT or UNDERSCORE for discard variable
        if p.peekTokenIs(token.IDENT) {
            if !p.expectPeek(token.IDENT) {
                return None
            }
        } else if p.peekTokenIs(token.UNDERSCORE) {
            if !p.expectPeek(token.UNDERSCORE) {
                return None
            }
        } else {
            // Debug: print unexpected peek token to help diagnose parsing issues
            p.peekError(token.IDENT)

            return None
        }

        var nameTok: token.Token = p.curTokenValue()
        var nameValue: string = copyString(&p.curLiteral)

        return Some(
            ast.Statement.Package(
                ast.PackageStatementFromTokenAndName(
                    pkgTok,
                    nameTok,
                    nameValue,
                ),
            ),
        )
    }

    mut func parsePubDecl() -> (Option<ast.Statement>) {
        var pubToken: token.Token = p.curTokenValue()

        p.advanceToken()

        if p.curTokenIs(token.FUNC) {
            var fn: Option<ast.FunctionDecl> = p.parseFunctionDeclWithVisibility(
                ast.Visibility.Public,
            )

            switch fn {
                case Some(f) {
                    return Some(ast.Statement.FunctionDecl(f))
                }
                case None {
                    return None
                }
            }
        }

        if p.curTokenIs(token.STRUCT) {
            var sd: Option<ast.StructDecl> = p.parseStructDecl()

            switch sd {
                case Some(s) {
                    mut var pubStruct: ast.StructDecl = s

                    pubStruct.Visibility = ast.Visibility.Public

                    return Some(ast.Statement.StructDecl(pubStruct))
                }
                case None {
                    return None
                }
            }
        }

        if p.curTokenIs(token.ENUM) {
            var ed: Option<ast.EnumDecl> = p.parseEnumDecl()

            switch ed {
                case Some(e) {
                    mut var pubEnum: ast.EnumDecl = e

                    pubEnum.Visibility = ast.Visibility.Public

                    return Some(ast.Statement.EnumDecl(pubEnum))
                }
                case None {
                    return None
                }
            }
        }

        if p.curTokenIs(token.CONST) {
            if p.peekTokenIs(token.LPAREN) {
                var block: Option<ast.ConstBlock> = p.parseConstBlock()

                switch block {
                    case Some(cb) {
                        mut var pubBlock: ast.ConstBlock = cb
                        mut var i: int = 0

                        while i < pubBlock.Constants.len() {
                            mut var c: ast.ConstStatement = pubBlock.Constants[i]

                            c.Visibility = ast.Visibility.Public
                            pubBlock.Constants[i] = c
                            i = i + 1
                        }

                        return Some(ast.Statement.ConstBlock(pubBlock))
                    }
                    case None {
                        return None
                    }
                }
            }

            var cs: Option<ast.ConstStatement> = p.parseConstStatement()

            switch cs {
                case Some(c) {
                    mut var pubConst: ast.ConstStatement = c

                    pubConst.Visibility = ast.Visibility.Public

                    return Some(ast.Statement.Const(pubConst))
                }
                case None {
                    return None
                }
            }
        }

        if p.curTokenIs(token.TYPE) {
            var td: Option<ast.TypeDecl> = p.parseTypeDecl()

            switch td {
                case Some(t) {
                    mut var pubType: ast.TypeDecl = t

                    pubType.Visibility = ast.Visibility.Public

                    return Some(ast.Statement.TypeDecl(pubType))
                }
                case None {
                    return None
                }
            }
        }

        if p.curTokenIs(token.ALIAS) {
            var ad: Option<ast.AliasDecl> = p.parseAliasDecl()

            switch ad {
                case Some(a) {
                    mut var pubAlias: ast.AliasDecl = a

                    pubAlias.Visibility = ast.Visibility.Public

                    return Some(ast.Statement.AliasDecl(pubAlias))
                }
                case None {
                    return None
                }
            }
        }

        if p.curTokenIs(token.IMPORT) {
            var im: Option<ast.Statement> = p.parseImportBlock()

            return im
        }

        var _pubTokenLine: int = pubToken.Line

        p.errors.push("parse error P3")

        return None
    }

    mut func parseImportBlock() -> (Option<ast.Statement>) {
        var importToken: token.Token = p.curTokenValue()

        if p.peekTokenIs(token.LPAREN) {
            p.advanceToken()

            mut var imports: Vec<ast.ImportStatement, _> = Vec.with_cap(8)

            while !p.curTokenIs(token.RPAREN) && !p.curTokenIs(token.EOF) {
                p.advanceToken()

                if p.curTokenIs(token.RPAREN) {
                    break
                }

                var imp: Option<ast.ImportStatement> = p.parseSingleImport()

                switch imp {
                    case Some(i) {
                        imports.push(i)
                    }
                    case None {
                    }
                }
            }

            return Some(
                ast.Statement.ImportBlock(
                    ast.ImportBlockFromImports(
                        importToken,
                        imports,
                    ),
                ),
            )
        }

        p.advanceToken()

        var imp: Option<ast.ImportStatement> = p.parseSingleImport()

        switch imp {
            case Some(i) {
                return Some(ast.Statement.Import(i))
            }
            case None {
                return None
            }
        }
    }

    mut func parseSingleImport() -> (Option<ast.ImportStatement>) {
        var importTok: token.Token = p.curTokenValue()

        if !p.curTokenIs(token.STRING) {
            p.peekError(token.STRING)

            return None
        }

        // Copy string literals eagerly: the native backend has shown instability when
        // reusing token literal storage across parsing steps.
        var importPath: string = copyString(&p.curLiteral)
        mut var importAlias: string = ""

        if p.peekTokenIs(token.AS) {
            p.advanceToken()

            if !p.expectPeek(token.IDENT) {
                return None
            }

            importAlias = copyString(&p.curLiteral)
        }

        return Some(
            ast.ImportStatementFromPathAlias(
                importTok,
                importPath,
                importAlias,
            ),
        )
    }

    mut func parseVarStatement(mutable: bool) -> (Option<ast.Statement>) {
        var varToken: token.Token = p.curTokenValue()

        if p.peekTokenIs(token.LPAREN) {
            var multi: Option<ast.MultiVarStatement> = p.parseMultiVarStatement(
                varToken,
                mutable,
            )

            switch multi {
                case Some(m) {
                    return Some(ast.Statement.MultiVar(m))
                }
                case None {
                    return None
                }
            }
        }

        // Accept either IDENT or UNDERSCORE for discard variable
        if p.peekTokenIs(token.IDENT) {
            if !p.expectPeek(token.IDENT) {
                return None
            }
        } else if p.peekTokenIs(token.UNDERSCORE) {
            if !p.expectPeek(token.UNDERSCORE) {
                return None
            }
        } else {
            p.peekError(token.IDENT)

            return None
        }

        var nameIdent: ast.Identifier = ast.IdentifierFromTokenValue(
            p.curTokenValue(),
            copyString(&p.curLiteral),
        )
        if p.peekTokenIs(token.COLON) {
            p.advanceToken()
            p.advanceToken()

            var parsedType: ast.TypeExpression = p.parseTypeExpression()

            if p.peekTokenIs(token.ASSIGN) {
                p.advanceToken()
                p.advanceToken()

                var parsedValueTyped: ast.Expression = p.parseExpression(PREC_LOWEST)

                return Some(
                    ast.Statement.Var(
                        ast.VarStatementFromPartsWithValue(
                            varToken,
                            nameIdent,
                            mutable,
                            Some(parsedType),
                            parsedValueTyped,
                        ),
                    ),
                )
            }

            return Some(
                ast.Statement.Var(
                    ast.VarStatementFromPartsNoValue(
                        varToken,
                        nameIdent,
                        mutable,
                        Some(parsedType),
                    ),
                ),
            )
        }

        if !p.peekTokenIs(token.ASSIGN) {
            p.peekError(token.COLON)

            return None
        }

        p.advanceToken()
        p.advanceToken()

        var parsedValue: ast.Expression = p.parseExpression(PREC_LOWEST)

        return Some(
            ast.Statement.Var(
                ast.VarStatementFromPartsWithValue(
                    varToken,
                    nameIdent,
                    mutable,
                    None,
                    parsedValue,
                ),
            ),
        )
    }

    mut func parseMultiVarStatement(
        varToken: token.Token,
        mutable: bool,
    ) -> (Option<ast.MultiVarStatement>) {
        mut var names: Vec<ast.Identifier, _> = Vec.with_cap(4)
        mut var types: Vec<Option<ast.TypeExpression>, _> = Vec.with_cap(4)

        p.advanceToken()

        if !p.peekTokenIs(token.IDENT) && !p.peekTokenIs(token.UNDERSCORE) {
            p.peekError(token.IDENT)

            return None
        }

        p.advanceToken()
        names.push(
            ast.IdentifierFromTokenValue(
                p.curTokenValue(),
                copyString(&p.curLiteral),
            ),
        )
        types.push(None)

        while p.peekTokenIs(token.COMMA) {
            p.advanceToken()

            // allow trailing comma before closing ')'
            if p.peekTokenIs(token.RPAREN) {
                p.advanceToken()
                break
            }

            if !p.peekTokenIs(token.IDENT) && !p.peekTokenIs(token.UNDERSCORE) {
                p.peekError(token.IDENT)

                return None
            }

            p.advanceToken()
            names.push(
                ast.IdentifierFromTokenValue(
                    p.curTokenValue(),
                    copyString(&p.curLiteral),
                ),
            )
            types.push(None)
        }

        if !p.expectPeek(token.RPAREN) {
            return None
        }

        if !p.expectPeek(token.ASSIGN) {
            return None
        }

        p.advanceToken()

        var valueExpr: ast.Expression = p.parseExpression(PREC_LOWEST)

        return Some(
            ast.MultiVarStatementFromParts(
                varToken,
                names,
                types,
                mutable,
                Some(valueExpr),
            ),
        )
    }

    mut func parseConstStatement() -> (Option<ast.ConstStatement>) {
        var constTok: token.Token = p.curTokenValue()

        if !p.expectPeek(token.IDENT) {
            return None
        }

        var nameIdent: ast.Identifier = ast.IdentifierFromTokenValue(
            p.curTokenValue(),
            copyString(&p.curLiteral),
        )

        if !p.expectPeek(token.COLON) {
            return None
        }

        p.advanceToken()
        var constType: ast.TypeExpression = p.parseTypeExpression()

        if !p.expectPeek(token.ASSIGN) {
            return None
        }

        p.advanceToken()
        var constValue: ast.Expression = p.parseExpression(PREC_LOWEST)

        return Some(
            ast.ConstStatementFromParts(
                constTok,
                nameIdent,
                ast.Visibility.Private,
                Some(constType),
                constValue,
            ),
        )
    }

    mut func parseVarBlock() -> (Option<ast.VarBlock>) {
        var blockToken: token.Token = p.curTokenValue()
        mut var variables: Vec<ast.VarStatement, _> = Vec.with_cap(8)

        if !p.expectPeek(token.LPAREN) {
            return None
        }

        while !p.peekTokenIs(token.RPAREN) && !p.peekTokenIs(token.EOF) {
            if !p.expectPeek(token.IDENT) {
                return None
            }

            var varNameTok: token.Token = p.curTokenValue()
            var varName: ast.Identifier = ast.IdentifierFromTokenValue(
                varNameTok,
                copyString(&p.curLiteral),
            )

            p.advanceToken()
            var varTypeOpt: Option<ast.TypeExpression> = Some(p.parseTypeExpression())
            mut var varValueOpt: Option<ast.Expression> = None

            if p.peekTokenIs(token.ASSIGN) {
                p.advanceToken()
                p.advanceToken()
                varValueOpt = Some(p.parseExpression(PREC_LOWEST))
            }

            switch varValueOpt {
                case Some(varValue) {
                    variables.push(
                        ast.VarStatementFromPartsWithValue(
                            varNameTok,
                            varName,
                            false,
                            varTypeOpt,
                            varValue,
                        ),
                    )
                }
                case None {
                    variables.push(
                        ast.VarStatementFromPartsNoValue(
                            varNameTok,
                            varName,
                            false,
                            varTypeOpt,
                        ),
                    )
                }
            }
        }

        if !p.expectPeek(token.RPAREN) {
            return None
        }

        return Some(
            ast.VarBlockFromVariables(
                blockToken,
                variables,
            ),
        )
    }

    mut func parseConstBlock() -> (Option<ast.ConstBlock>) {
        var blockToken: token.Token = p.curTokenValue()
        mut var constants: Vec<ast.ConstStatement, _> = Vec.with_cap(8)

        if !p.expectPeek(token.LPAREN) {
            return None
        }

        while !p.peekTokenIs(token.RPAREN) && !p.peekTokenIs(token.EOF) {
            if !p.expectPeek(token.IDENT) {
                return None
            }

            var constNameTok: token.Token = p.curTokenValue()
            var constName: ast.Identifier = ast.IdentifierFromTokenValue(
                constNameTok,
                copyString(&p.curLiteral),
            )

            if p.peekTokenIs(token.ASSIGN) {
                var _constName: string = constName.Value

                p.errors.push("parse error P4")

                return None
            }

            p.advanceToken()
            var constType: ast.TypeExpression = p.parseTypeExpression()

            if !p.expectPeek(token.ASSIGN) {
                return None
            }

            p.advanceToken()
            var constValue: ast.Expression = p.parseExpression(PREC_LOWEST)
            constants.push(
                ast.ConstStatementFromParts(
                    constNameTok,
                    constName,
                    ast.Visibility.Private,
                    Some(constType),
                    constValue,
                ),
            )
        }

        if !p.expectPeek(token.RPAREN) {
            return None
        }

        return Some(
            ast.ConstBlockFromConstants(
                blockToken,
                constants,
            ),
        )
    }

    mut func parseReturnStatement() -> (Option<ast.Statement>) {
        var returnTok: token.Token = p.curTokenValue()

        if p.peekTokenIs(token.RBRACE) || p.peekTokenIs(token.EOF) || p.peekTokenIs(token.SEMICOLON) {
            return Some(
                ast.Statement.Return(
                    ast.ReturnStatementFromParts(
                        returnTok,
                        None,
                    ),
                ),
            )
        }

        p.advanceToken()

        var first: ast.Expression = p.parseExpression(PREC_LOWEST)
        mut var returnValue: Option<ast.Expression> = None

        if p.peekTokenIs(token.COMMA) {
            mut var elements: Vec<ast.Expression, _> = Vec.with_cap(4)

            elements.push(first)

            while p.peekTokenIs(token.COMMA) {
                p.advanceToken()
                p.advanceToken()
                elements.push(p.parseExpression(PREC_LOWEST))
            }

            var tuple: ast.TupleExpression = ast.TupleExpressionFromElements(
                returnTok,
                elements,
            )

            returnValue = Some(ast.Expression.Tuple(tuple))
        } else {
            returnValue = Some(first)
        }

        return Some(
            ast.Statement.Return(
                ast.ReturnStatementFromParts(
                    returnTok,
                    returnValue,
                ),
            ),
        )
    }

    mut func parseExpressionOrAssignment() -> (Option<ast.Statement>) {
        var expr: ast.Expression = p.parseExpression(PREC_LOWEST)

        if p.peekTokenIs(token.ASSIGN) {
            mut var lhsStable: ast.Expression = expr

            switch expr {
                case ast.Expression.Identifier(idForAssign) {
                    lhsStable = ast.Expression.Identifier(
                        ast.IdentifierFromTokenValue(
                            idForAssign.Token,
                            copyString(&idForAssign.Value),
                        ),
                    )
                }
                case ast.Expression.MutableIdentifier(idmForAssign) {
                    lhsStable = ast.Expression.MutableIdentifier(
                        ast.MutableIdentifierFromTokenValue(
                            idmForAssign.Token,
                            copyString(&idmForAssign.Value),
                        ),
                    )
                }
                default {
                }
            }

            p.advanceToken()
            var assignTok: token.Token = p.curTokenValue()

            p.advanceToken()
            var rhs: ast.Expression = p.parseExpression(PREC_LOWEST)

            return Some(
                ast.Statement.Assignment(
                    ast.AssignmentStatementFromParts(
                        assignTok,
                        lhsStable,
                        rhs,
                    ),
                ),
            )
        }

        var stmtTok: token.Token = p.curTokenValue()
        var synthVarTok: token.Token = token.MakeToken(
            token.VAR,
            "var",
            stmtTok.Line,
            stmtTok.Column,
        )
        var discardTok: token.Token = token.MakeToken(
            token.IDENT,
            "_",
            stmtTok.Line,
            stmtTok.Column,
        )
        var discardIdent: ast.Identifier = ast.IdentifierFromTokenValue(
            discardTok,
            "_",
        )
        var discardVar: ast.VarStatement = ast.VarStatementFromPartsWithValue(
            synthVarTok,
            discardIdent,
            false,
            None,
            expr,
        )
        discardVar.Name.Value = "_"

        return ast.SomeStatement(ast.Statement.Var(discardVar))
    }

    mut func parseIfStatement() -> (Option<ast.IfStatement>) {
        var ifToken: token.Token = p.curTokenValue()

        p.advanceToken()

        var condition: ast.Expression = p.parseExpression(PREC_LOWEST)

        if !p.expectPeek(token.LBRACE) {
            return None
        }

        var consequence: ast.BlockStatement = p.parseBlockStatement()
        mut var alternative: Option<ast.BlockStatement> = None

        if p.peekTokenIs(token.ELSE) {
            p.advanceToken()

            if p.peekTokenIs(token.IF) {
                p.advanceToken()

                var elseIf: Option<ast.IfStatement> = p.parseIfStatement()

                switch elseIf {
                    case Some(ei) {
                        mut var stmts: Vec<ast.Statement, _> = Vec.with_cap(1)

                        stmts.push(ast.Statement.If(ei))

                        var block: ast.BlockStatement = ast.BlockStatementFromStatements(
                            ei.Token,
                            stmts,
                        )

                        alternative = Some(block)
                    }
                    case None {
                    }
                }

                var elseIfStmt: ast.IfStatement = ast.IfStatementFromParts(
                    ifToken,
                    condition,
                    consequence,
                    alternative,
                )

                return Some(elseIfStmt)
            }

            if !p.expectPeek(token.LBRACE) {
                return None
            }

            alternative = Some(p.parseBlockStatement())
        }

        return Some(
            ast.IfStatementFromParts(
                ifToken,
                condition,
                consequence,
                alternative,
            ),
        )
    }

    mut func parseWhileStatement() -> (Option<ast.WhileStatement>) {
        var whileToken: token.Token = p.curTokenValue()

        p.advanceToken()

        var condition: ast.Expression = p.parseExpression(PREC_LOWEST)

        if !p.expectPeek(token.LBRACE) {
            return None
        }

        var body: ast.BlockStatement = p.parseBlockStatement()

        return Some(
            ast.WhileStatementFromParts(
                whileToken,
                condition,
                body,
            ),
        )
    }

    mut func parseForStatement() -> (Option<ast.ForStatement>) {
        var forToken: token.Token = p.curTokenValue()

        if !p.expectPeek(token.IDENT) {
            return None
        }

        var loopVar: ast.Identifier = ast.IdentifierFromTokenValue(
            p.curTokenValue(),
            copyString(&p.curLiteral),
        )

        if !p.expectPeek(token.IN) {
            return None
        }

        p.advanceToken()

        var iterableExpr: ast.Expression = p.parseExpression(PREC_LOWEST)

        if !p.expectPeek(token.LBRACE) {
            return None
        }

        var body: ast.BlockStatement = p.parseBlockStatement()

        return Some(
            ast.ForStatementFromParts(
                forToken,
                loopVar,
                iterableExpr,
                body,
            ),
        )
    }

    mut func parseSwitchStatement() -> (Option<ast.SwitchStatement>) {
        var switchToken: token.Token = p.curTokenValue()
        mut var cases: Vec<ast.SwitchCase, _> = Vec.with_cap(8)

        p.advanceToken()

        var switchValue: ast.Expression = p.parseExpression(PREC_LOWEST)

        if !p.expectPeek(token.LBRACE) {
            return None
        }

        p.advanceToken()

        while !p.curTokenIs(token.RBRACE) && !p.curTokenIs(token.EOF) {
            var sc: Option<ast.SwitchCase> = p.parseSwitchCase()

            switch sc {
                case Some(c) {
                    cases.push(c)
                }
                case None {
                }
            }

            p.advanceToken()
        }

        return Some(
            ast.SwitchStatementFromParts(
                switchToken,
                switchValue,
                cases,
            ),
        )
    }

    mut func parseSwitchCase() -> (Option<ast.SwitchCase>) {
        var caseToken: token.Token = p.curTokenValue()
        mut var isDefault: bool = false
        mut var values: Vec<ast.Expression, _> = Vec.with_cap(4)

        if p.curTokenIs(token.DEFAULT) {
            isDefault = true
        } else if p.curTokenIs(token.CASE) {
            p.advanceToken()
            values.push(p.parseExpression(PREC_LOWEST))

            while p.peekTokenIs(token.COMMA) {
                p.advanceToken()
                p.advanceToken()
                values.push(p.parseExpression(PREC_LOWEST))
            }
        } else {
            return None
        }

        if !p.expectPeek(token.LBRACE) {
            return None
        }

        var body: ast.BlockStatement = p.parseBlockStatement()

        return Some(
            ast.SwitchCaseFromParts(
                caseToken,
                values,
                body,
                isDefault,
            ),
        )
    }

    mut func parseDeferStatement() -> (Option<ast.DeferStatement>) {
        var deferToken: token.Token = p.curTokenValue()

        if !p.expectPeek(token.LBRACE) {
            return None
        }

        var body: ast.BlockStatement = p.parseBlockStatement()

        return Some(
            ast.DeferStatementFromParts(
                deferToken,
                body,
            ),
        )
    }

    mut func parsePanicStatement() -> (Option<ast.PanicStatement>) {
        var panicTok: token.Token = p.curTokenValue()

        p.advanceToken()
        var message: ast.Expression = p.parseExpression(PREC_LOWEST)

        return Some(
            ast.PanicStatementFromParts(
                panicTok,
                message,
            ),
        )
    }

    mut func parseUnsafeBlock() -> (Option<ast.UnsafeBlock>) {
        var unsafeToken: token.Token = p.curTokenValue()

        if !p.expectPeek(token.LBRACE) {
            return None
        }

        var body: ast.BlockStatement = p.parseBlockStatement()

        return Some(
            ast.UnsafeBlockFromParts(
                unsafeToken,
                body,
            ),
        )
    }

    mut func parseBlockStatement() -> (ast.BlockStatement) {
        var blockToken: token.Token = p.curTokenValue()
        mut var statements: Vec<ast.Statement, _> = Vec.with_cap(64)

        p.advanceToken()

        while !p.curTokenIs(token.RBRACE) && !p.curTokenIs(token.EOF) {
            var stmt: Option<ast.Statement> = p.parseStatement()

            if stmt.is_some() {
                statements.push(stmt.unwrap())
            }

            p.advanceToken()
        }

        return ast.BlockStatementFromStatements(
            blockToken,
            statements,
        )
    }

    mut func parseTypeExpression() -> (ast.TypeExpression) {
        if p.curTokenIs(token.AMPERSAND) {
            var bt: ast.BorrowType = p.parseBorrowType()

            return ast.TypeExpression.BorrowRef(bt)
        }

        if p.curTokenIs(token.FUNC) {
            var ft: ast.FunctionType = p.parseFunctionType()

            return ast.TypeExpression.Function(ft)
        }

        if p.curTokenIs(token.VOID) {
            return ast.TypeExpressionSimpleByName(
                emptyToken(),
                "void",
            )
        }

        if !p.curTokenIs(token.IDENT) && !token.IsType(p.curType) {
            p.errors.push("parse error P5")

            return errorType(
                p.curTokenValue(),
                "invalid type",
            )
        }

        mut var name: string = p.curLiteral
        mut var tok: token.Token = p.curTokenValue()

        if p.peekTokenIs(token.DOT) {
            p.advanceToken()

            if !p.expectPeek(token.IDENT) {
                return errorType(
                    p.curTokenValue(),
                    "invalid qualified type",
                )
            }

            name = name + "." + p.curLiteral
            tok = p.curTokenValue()
        }

        mut var base: ast.TypeExpression = ast.TypeExpressionSimpleByName(
            tok,
            name,
        )

        if p.peekTokenIs(token.LT) {
            var gt: ast.GenericType = p.parseGenericType(
                tok,
                name,
            )

            base = ast.TypeExpression.Generic(gt)
        }

        if p.peekTokenIs(token.BOX) {
            p.advanceToken()

            var boxTok: token.Token = p.curTokenValue()

            if p.peekTokenIs(token.QUESTION) {
                p.advanceToken()

                return ast.TypeExpressionBoxOptionalFromInner(
                    boxTok,
                    base,
                )
            }

            return ast.TypeExpressionBoxRefFromInner(
                boxTok,
                base,
            )
        }

        return base
    }

    mut func parseBorrowType() -> (ast.BorrowType) {
        var borrowTok: token.Token = p.curTokenValue()
        mut var mutableBorrow: bool = false

        p.advanceToken()

        if p.curTokenIs(token.MUT) {
            mutableBorrow = true
            p.advanceToken()
        }

        var innerType: ast.TypeExpression = p.parseTypeExpression()

        return ast.BorrowTypeFromParts(
            borrowTok,
            mutableBorrow,
            innerType,
        )
    }

    mut func parseFunctionType() -> (ast.FunctionType) {
        var tok: token.Token = p.curTokenValue()

        if !p.expectPeek(token.LPAREN) {
            return ast.FunctionTypeFromParts(
                tok,
                Vec.with_cap(4),
                errorType(
                    tok,
                    "expected ( after func",
                ),
            )
        }

        mut var params: Vec<ast.TypeExpression, _> = Vec.with_cap(4)

        if !p.peekTokenIs(token.RPAREN) {
            p.advanceToken()
            params.push(p.parseTypeExpression())

            while p.peekTokenIs(token.COMMA) {
                p.advanceToken()
                // consume ,
                p.advanceToken()
                // to next type
                params.push(p.parseTypeExpression())
            }
        }

        if !p.expectPeek(token.RPAREN) {
            return ast.FunctionTypeFromParts(
                tok,
                params,
                errorType(
                    tok,
                    "expected ) after func params",
                ),
            )
        }

        if !p.expectPeek(token.ARROW) {
            return ast.FunctionTypeFromParts(
                tok,
                params,
                errorType(
                    tok,
                    "expected -> after func params",
                ),
            )
        }

        if !p.expectPeek(token.LPAREN) {
            return ast.FunctionTypeFromParts(
                tok,
                params,
                errorType(
                    tok,
                    "expected ( for return type",
                ),
            )
        }

        var returnType: ast.TypeExpression = p.parseReturnTypes()

        return ast.FunctionTypeFromParts(
            tok,
            params,
            returnType,
        )
    }

    mut func parseGenericType(
        tok: token.Token,
        name: string,
    ) -> (ast.GenericType) {
        mut var typeParams: Vec<ast.TypeExpression, _> = Vec.with_cap(2)

        p.advanceToken()
        p.advanceToken()

        if p.curTokenIs(token.GT) {
            p.errors.push("parse error P6")

            return ast.GenericTypeFromParams(
                tok,
                name,
                typeParams,
            )
        }

        if p.curTokenIs(token.UNDERSCORE) {
            typeParams.push(
                ast.TypeExpressionSizeFromParts(
                    p.curTokenValue(),
                    0,
                    true,
                ),
            )
        } else if p.curTokenIs(token.INT) {
            var parsed: int = parseIntLiteralValue(p.curLiteral)

            if parsed >= 0 {
                typeParams.push(
                    ast.TypeExpressionSizeFromParts(
                        p.curTokenValue(),
                        parsed,
                        false,
                    ),
                )
            } else {
                p.errors.push("parse error P7")
                typeParams.push(
                    ast.TypeExpressionSizeFromParts(
                        p.curTokenValue(),
                        0,
                        false,
                    ),
                )
            }
        } else {
            typeParams.push(p.parseTypeExpression())
        }

        while p.peekTokenIs(token.COMMA) {
            p.advanceToken()
            p.advanceToken()

            if p.curTokenIs(token.GT) {
                p.errors.push("parse error P8")

                return ast.GenericTypeFromParams(
                    tok,
                    name,
                    typeParams,
                )
            }

            if p.curTokenIs(token.UNDERSCORE) {
                typeParams.push(
                    ast.TypeExpressionSizeFromParts(
                        p.curTokenValue(),
                        0,
                        true,
                    ),
                )
            } else if p.curTokenIs(token.INT) {
                var parsed: int = parseIntLiteralValue(p.curLiteral)

                if parsed >= 0 {
                    typeParams.push(
                        ast.TypeExpressionSizeFromParts(
                            p.curTokenValue(),
                            parsed,
                            false,
                        ),
                    )
                } else {
                    p.errors.push("parse error P9")
                    typeParams.push(
                        ast.TypeExpressionSizeFromParts(
                            p.curTokenValue(),
                            0,
                            false,
                        ),
                    )
                }
            } else {
                typeParams.push(p.parseTypeExpression())
            }
        }

        mut var adjusted: bool = false

        if p.peekTokenIs(token.GT_EQ) {
            p.advanceToken()

            var nextToken: token.Token = p.peekTokenValue()
            var next2Token: token.Token = p.peek2TokenValue()
            var geLine: int = p.curLine
            var geColumn: int = p.curColumn

            var curTokGE: token.Token = token.MakeToken(
                token.GT,
                ">",
                geLine,
                geColumn,
            )
            p.curType = curTokGE.Type
            p.curLiteral = copyString(&curTokGE.Literal)
            p.curLine = curTokGE.Line
            p.curColumn = curTokGE.Column

            var peekTokGE: token.Token = token.MakeToken(
                token.ASSIGN,
                "=",
                geLine,
                geColumn + 1,
            )
            p.peekType = peekTokGE.Type
            p.peekLiteral = copyString(&peekTokGE.Literal)
            p.peekLine = peekTokGE.Line
            p.peekColumn = peekTokGE.Column

            p.peek2Type = nextToken.Type
            p.peek2Literal = copyString(&nextToken.Literal)
            p.peek2Line = nextToken.Line
            p.peek2Column = nextToken.Column

            p.peek3Type = next2Token.Type
            p.peek3Literal = copyString(&next2Token.Literal)
            p.peek3Line = next2Token.Line
            p.peek3Column = next2Token.Column
            adjusted = true
        }

        if !adjusted && p.peekTokenIs(token.RSHIFT) {
            p.advanceToken()

            var nextToken: token.Token = p.peekTokenValue()
            var next2Token: token.Token = p.peek2TokenValue()
            var shiftLine: int = p.curLine
            var shiftColumn: int = p.curColumn

            var curTokShift: token.Token = token.MakeToken(
                token.GT,
                ">",
                shiftLine,
                shiftColumn,
            )
            p.curType = curTokShift.Type
            p.curLiteral = copyString(&curTokShift.Literal)
            p.curLine = curTokShift.Line
            p.curColumn = curTokShift.Column

            var peekTokShift: token.Token = token.MakeToken(
                token.GT,
                ">",
                shiftLine,
                shiftColumn + 1,
            )
            p.peekType = peekTokShift.Type
            p.peekLiteral = copyString(&peekTokShift.Literal)
            p.peekLine = peekTokShift.Line
            p.peekColumn = peekTokShift.Column

            p.peek2Type = nextToken.Type
            p.peek2Literal = copyString(&nextToken.Literal)
            p.peek2Line = nextToken.Line
            p.peek2Column = nextToken.Column

            p.peek3Type = next2Token.Type
            p.peek3Literal = copyString(&next2Token.Literal)
            p.peek3Line = next2Token.Line
            p.peek3Column = next2Token.Column
            adjusted = true
        }

        if !adjusted {
            if !p.expectPeek(token.GT) {
            }
        }

        return ast.GenericTypeFromParams(
            tok,
            name,
            typeParams,
        )
    }

    mut func parseFunctionDeclWithVisibility(
        visibility: ast.Visibility,
    ) -> (Option<ast.FunctionDecl>) {
        if !p.expectPeek(token.IDENT) {
            return None
        }

        var fnNameValue: string = copyString(&p.curLiteral)
        mut var typeParams: Vec<ast.Identifier, _> = Vec.with_cap(4)

        if p.peekTokenIs(token.LT) {
            p.advanceToken()
            typeParams = p.parseTypeParams()
        }

        if !p.expectPeek(token.LPAREN) {
            return None
        }

        var parameters: Vec<ast.Parameter, _> = p.parseParameters()

        if !p.expectPeek(token.ARROW) {
            return None
        }

        if !p.expectPeek(token.LPAREN) {
            return None
        }

        var returnType: ast.TypeExpression = p.parseReturnTypes()

        if !p.expectPeek(token.LBRACE) {
            return None
        }

        var wasMainFunc: bool = p.inMainFunc

        if fnNameValue == "main" {
            p.inMainFunc = true
        }

        mut var body: ast.BlockStatement = ast.BlockStatementFromStatements(
            p.curTokenValue(),
            Vec.with_cap(0),
        )

        var doSkipBootstrapBody: bool = p.shouldSkipFunctionBodyForBootstrap(&fnNameValue)

        if doSkipBootstrapBody {
            body = p.skipBlockStatement()
        } else {
            body = p.parseBlockStatement()
        }

        p.inMainFunc = wasMainFunc

        mut var fnDecl: ast.FunctionDecl = ast.EmptyFunctionDecl()

        fnDecl.Token = emptyToken()
        fnDecl.Visibility = visibility
        fnDecl.Name = ast.IdentifierFromTokenValue(
            emptyToken(),
            fnNameValue,
        )
        fnDecl.Body = body
        fnDecl.Parameters = parameters
        fnDecl.ReturnType = returnType
        fnDecl.TypeParams = typeParams

        return Some(
            fnDecl,
        )
    }

    func shouldSkipFunctionBodyForBootstrap(name: &string) -> (bool) {
        if !p.bootstrapSkipBodies {
            return false
        }

        mut var targetName: string = copyString(name)
        if p.collectPkg != "" && p.collectPkg != "main" {
            targetName = copyString(&p.collectPkg) + "." + copyString(name)
        }

        return native.ShouldSkipBootstrapFunction(&targetName)
    }

    mut func skipBlockStatement() -> (ast.BlockStatement) {
        var blockToken: token.Token = p.curTokenValue()
        mut var depth: int = 1

        p.advanceToken()

        while depth > 0 && !p.curTokenIs(token.EOF) {
            if p.curTokenIs(token.LBRACE) {
                depth = depth + 1
            } else if p.curTokenIs(token.RBRACE) {
                depth = depth - 1
            }

            if depth == 0 {
                break
            }

            p.advanceToken()
        }

        return ast.BlockStatementFromStatements(
            blockToken,
            Vec.with_cap(0),
        )
    }

    mut func parseFunctionDecl() -> (Option<ast.FunctionDecl>) {
        return p.parseFunctionDeclWithVisibility(
            ast.Visibility.Private,
        )
    }

    mut func parseReturnTypes() -> (ast.TypeExpression) {
        var startToken: token.Token = p.curTokenValue()

        p.advanceToken()

        mut var closed: bool = false

        if p.curTokenIs(token.RPAREN) {
            return ast.TypeExpressionSimpleByName(
                emptyToken(),
                "void",
            )
        }

        var first: ast.TypeExpression = p.parseReturnTypeElement()

        if p.peekTokenIs(token.COMMA) {
            mut var types: Vec<ast.TypeExpression, _> = Vec.with_cap(4)

            types.push(first)

            while p.peekTokenIs(token.COMMA) {
                p.advanceToken()

                // allow trailing comma before closing ')'
                if p.peekTokenIs(token.RPAREN) {
                    p.advanceToken()
                    closed = true
                    break
                }

                p.advanceToken()
                types.push(p.parseReturnTypeElement())
            }

            if !closed {
                if !p.expectPeek(token.RPAREN) {
                    return ast.TypeExpressionTupleFromElements(
                        startToken,
                        types,
                    )
                }
            }

            return ast.TypeExpressionTupleFromElements(
                startToken,
                types,
            )
        }

        if !closed {
            if !p.expectPeek(token.RPAREN) {
            }
        }

        return first
    }

    mut func parseReturnTypeElement() -> (ast.TypeExpression) {
        if p.curTokenIs(token.IDENT) && !token.IsType(p.curType) {
            if p.peekTokenIs(token.IDENT) || token.IsType(p.peekType) {
                p.advanceToken()

                return p.parseTypeExpression()
            }
        }

        return p.parseTypeExpression()
    }

    mut func parseTypeParams() -> (Vec<ast.Identifier, _>) {
        mut var params: Vec<ast.Identifier, _> = Vec.with_cap(4)

        if p.peekTokenIs(token.GT) {
            p.advanceToken()
        } else {
            p.advanceToken()
            params.push(
                ast.IdentifierFromTokenValue(
                    p.curTokenValue(),
                    copyString(&p.curLiteral),
                ),
            )

            while p.peekTokenIs(token.COMMA) {
                p.advanceToken()

                // allow trailing comma before closing '>'
                if p.peekTokenIs(token.GT) {
                    p.advanceToken()
                    break
                }

                p.advanceToken()
                params.push(
                    ast.IdentifierFromTokenValue(
                        p.curTokenValue(),
                        copyString(&p.curLiteral),
                    ),
                )
            }

            if !p.expectPeek(token.GT) {
            }
        }

        return params
    }

    mut func parseParameters() -> (Vec<ast.Parameter, _>) {
        mut var params: Vec<ast.Parameter, _> = Vec.with_cap(8)
        mut var closed: bool = false

        if p.peekTokenIs(token.RPAREN) {
            p.advanceToken()
            closed = true
        } else {
            p.advanceToken()
            params.push(p.parseParameter())

            while p.peekTokenIs(token.COMMA) {
                p.advanceToken()

                // allow trailing comma before closing ')'
                if p.peekTokenIs(token.RPAREN) {
                    p.advanceToken()
                    closed = true
                    break
                }

                p.advanceToken()
                params.push(p.parseParameter())
            }

            if !closed {
                if !p.expectPeek(token.RPAREN) {
                    // tolerate missing closing paren when next token is ARROW (->)
                    if p.peekTokenIs(token.ARROW) {
                        return params
                    }
                }
            }
        }

        return params
    }

    mut func parseParameter() -> (ast.Parameter) {
        var paramTok: token.Token = p.curTokenValue()
        mut var isMutable: bool = false

        if p.curTokenIs(token.MUT) {
            isMutable = true
            p.advanceToken()
        }

        var paramName: ast.Identifier = ast.IdentifierFromTokenValue(
            p.curTokenValue(),
            copyString(&p.curLiteral),
        )
        mut var paramType: ast.TypeExpression = errorType(
            p.curTokenValue(),
            "missing parameter type",
        )

        if !p.expectPeek(token.COLON) {
            return ast.ParameterFromParts(
                paramTok,
                paramName,
                isMutable,
                paramType,
            )
        }

        p.advanceToken()
        paramType = p.parseTypeExpression()

        return ast.ParameterFromParts(
            paramTok,
            paramName,
            isMutable,
            paramType,
        )
    }

    mut func parseStructDecl() -> (Option<ast.StructDecl>) {
        var structToken: token.Token = p.curTokenValue()

        if !p.expectPeek(token.IDENT) {
            return None
        }

        var structName: ast.Identifier = ast.IdentifierFromTokenValue(
            p.curTokenValue(),
            copyString(&p.curLiteral),
        )
        mut var typeParams: Vec<ast.Identifier, _> = Vec.with_cap(4)

        if p.peekTokenIs(token.LT) {
            p.advanceToken()
            typeParams = p.parseTypeParams()
        }

        if !p.expectPeek(token.LBRACE) {
            return None
        }

        mut var fields: Vec<ast.StructField, _> = Vec.with_cap(8)

        p.advanceToken()

        while !p.curTokenIs(token.RBRACE) && !p.curTokenIs(token.EOF) {
            var field: Option<ast.StructField> = p.parseStructField()

            switch field {
                case Some(f) {
                    fields.push(f)
                }
                case None {
                }
            }

            p.advanceToken()
        }

        return Some(
            ast.StructDeclFromParts(
                structToken,
                ast.Visibility.Private,
                structName,
                typeParams,
                fields,
            ),
        )
    }

    mut func parseStructField() -> (Option<ast.StructField>) {
        var fieldTok: token.Token = p.curTokenValue()
        mut var fieldVisibility: ast.Visibility = ast.Visibility.Private

        if p.curTokenIs(token.PUB) {
            fieldVisibility = ast.Visibility.Public
            p.advanceToken()
        }

        if !p.curTokenIs(token.IDENT) {
            return None
        }

        var fieldName: ast.Identifier = ast.IdentifierFromTokenValue(
            p.curTokenValue(),
            copyString(&p.curLiteral),
        )

        if !p.expectPeek(token.COLON) {
            return None
        }

        p.advanceToken()
        var fieldType: ast.TypeExpression = p.parseTypeExpression()

        return Some(
            ast.StructFieldFromParts(
                fieldTok,
                fieldVisibility,
                fieldName,
                fieldType,
            ),
        )
    }

    mut func parseEnumDecl() -> (Option<ast.EnumDecl>) {
        var enumToken: token.Token = p.curTokenValue()

        if !p.expectPeek(token.IDENT) {
            return None
        }

        var enumName: ast.Identifier = ast.IdentifierFromTokenValue(
            p.curTokenValue(),
            copyString(&p.curLiteral),
        )
        mut var typeParams: Vec<ast.Identifier, _> = Vec.with_cap(4)

        if p.peekTokenIs(token.LT) {
            p.advanceToken()
            typeParams = p.parseTypeParams()
        }

        if !p.expectPeek(token.LBRACE) {
            return None
        }

        mut var variants: Vec<ast.EnumVariant, _> = Vec.with_cap(8)

        p.advanceToken()

        while !p.curTokenIs(token.RBRACE) && !p.curTokenIs(token.EOF) {
            var variant: Option<ast.EnumVariant> = p.parseEnumVariant()

            switch variant {
                case Some(v) {
                    variants.push(v)
                }
                case None {
                }
            }

            p.advanceToken()
        }

        return Some(
            ast.EnumDeclFromParts(
                enumToken,
                ast.Visibility.Private,
                enumName,
                typeParams,
                variants,
            ),
        )
    }

    mut func parseEnumVariant() -> (Option<ast.EnumVariant>) {
        if !p.curTokenIs(token.IDENT) {
            return None
        }

        var variantTok: token.Token = p.curTokenValue()
        var variantName: ast.Identifier = ast.IdentifierFromTokenValue(
            p.curTokenValue(),
            copyString(&p.curLiteral),
        )
        mut var variantFields: Vec<ast.TypeExpression, _> = Vec.with_cap(4)

        if p.peekTokenIs(token.LPAREN) {
            p.advanceToken()
            variantFields = p.parseEnumVariantFields()
        }

        return Some(
            ast.EnumVariantFromParts(
                variantTok,
                variantName,
                variantFields,
            ),
        )
    }

    mut func parseEnumVariantFields() -> (Vec<ast.TypeExpression, _>) {
        mut var fields: Vec<ast.TypeExpression, _> = Vec.with_cap(4)

        if p.peekTokenIs(token.RPAREN) {
            p.advanceToken()
        } else {
            p.advanceToken()
            fields.push(p.parseTypeExpression())

            while p.peekTokenIs(token.COMMA) {
                p.advanceToken()
                p.advanceToken()
                fields.push(p.parseTypeExpression())
            }

            if !p.expectPeek(token.RPAREN) {
            }
        }

        return fields
    }

    mut func parseTypeDecl() -> (Option<ast.TypeDecl>) {
        var typeTok: token.Token = p.curTokenValue()

        if !p.expectPeek(token.IDENT) {
            return None
        }

        var typeName: ast.Identifier = ast.IdentifierFromTokenValue(
            p.curTokenValue(),
            copyString(&p.curLiteral),
        )

        if !p.expectPeek(token.ASSIGN) {
            return None
        }

        p.advanceToken()
        var underlying: ast.TypeExpression = p.parseTypeExpression()

        return Some(
            ast.TypeDeclFromParts(
                typeTok,
                ast.Visibility.Private,
                typeName,
                underlying,
            ),
        )
    }

    mut func parseAliasDecl() -> (Option<ast.AliasDecl>) {
        var aliasTok: token.Token = p.curTokenValue()

        if !p.expectPeek(token.IDENT) {
            return None
        }

        var aliasName: ast.Identifier = ast.IdentifierFromTokenValue(
            p.curTokenValue(),
            copyString(&p.curLiteral),
        )

        if !p.expectPeek(token.ASSIGN) {
            return None
        }

        p.advanceToken()
        var underlying: ast.TypeExpression = p.parseTypeExpression()

        return Some(
            ast.AliasDeclFromParts(
                aliasTok,
                ast.Visibility.Private,
                aliasName,
                underlying,
            ),
        )
    }

    mut func parseImplDecl() -> (Option<ast.ImplDecl>) {
        var implToken: token.Token = p.curTokenValue()

        if !p.expectPeek(token.IDENT) {
            return None
        }

        var typeName: ast.Identifier = ast.IdentifierFromTokenValue(
            p.curTokenValue(),
            copyString(&p.curLiteral),
        )

        if !p.expectPeek(token.AS) {
            return None
        }

        if !p.expectPeek(token.IDENT) {
            return None
        }

        var receiver: ast.Identifier = ast.IdentifierFromTokenValue(
            p.curTokenValue(),
            copyString(&p.curLiteral),
        )

        if !p.expectPeek(token.LBRACE) {
            return None
        }

        mut var methods: Vec<ast.MethodDecl, _> = Vec.with_cap(8)

        p.advanceToken()

        while !p.curTokenIs(token.RBRACE) && !p.curTokenIs(token.EOF) {
            mut var methodMutable: bool = false
            mut var methodVisibility: ast.Visibility = ast.Visibility.Private

            while p.curTokenIs(token.PUB) || p.curTokenIs(token.MUT) {
                if p.curTokenIs(token.PUB) {
                    methodVisibility = ast.Visibility.Public
                    p.advanceToken()
                } else if p.curTokenIs(token.MUT) {
                    methodMutable = true
                    p.advanceToken()
                }
            }

            if p.curTokenIs(token.RBRACE) || p.curTokenIs(token.EOF) {
                break
            }

            if !p.curTokenIs(token.FUNC) {
                p.advanceToken()
                continue
            }

            var fnDecl: Option<ast.FunctionDecl> = p.parseFunctionDecl()

            switch fnDecl {
                case Some(fd) {
                    mut var method: ast.MethodDecl = ast.MethodDeclFromCore(
                        fd.Token,
                        methodVisibility,
                        fd.Name,
                        fd.Parameters,
                        fd.ReturnType,
                        fd.Body,
                    )

                    method.Mutable = methodMutable
                    methods.push(method)
                }
                case None {
                }
            }

            p.advanceToken()
        }

        return Some(
            ast.ImplDeclFromParts(
                implToken,
                typeName,
                receiver,
                methods,
            ),
        )
    }

    mut func parseMethodDecl() -> (Option<ast.MethodDecl>) {
        var methodToken: token.Token = p.curTokenValue()
        mut var methodMutable: bool = false
        mut var methodVisibility: ast.Visibility = ast.Visibility.Private

        while p.curTokenIs(token.PUB) || p.curTokenIs(token.MUT) {
            if p.curTokenIs(token.PUB) {
                methodVisibility = ast.Visibility.Public
                p.advanceToken()
            } else if p.curTokenIs(token.MUT) {
                methodMutable = true
                p.advanceToken()
            }
        }

        if !p.curTokenIs(token.FUNC) {
            p.errors.push("parse error P10")

            return None
        }

        if !p.expectPeek(token.IDENT) {
            return None
        }

        var methodName: ast.Identifier = ast.IdentifierFromTokenValue(
            p.curTokenValue(),
            copyString(&p.curLiteral),
        )

        if !p.expectPeek(token.LPAREN) {
            return None
        }

        var parameters: Vec<ast.Parameter, _> = p.parseParameters()

        if !p.expectPeek(token.ARROW) {
            return None
        }

        if !p.expectPeek(token.LPAREN) {
            return None
        }

        var returnType: ast.TypeExpression = p.parseReturnTypes()

        if !p.expectPeek(token.LBRACE) {
            return None
        }

        var body: ast.BlockStatement = p.parseBlockStatement()
        mut var method: ast.MethodDecl = ast.MethodDeclFromCore(
            methodToken,
            methodVisibility,
            methodName,
            parameters,
            returnType,
            body,
        )

        method.Mutable = methodMutable

        return Some(method)
    }

    mut func parseExpression(precedence: int) -> (ast.Expression) {
        var debugFlow: bool = p.debugEnabled

        if debugFlow && p.debugShiftCount < 120 {
        }

        mut var left: ast.Expression = errorExpression(p.curTokenValue())

        if p.curTokenIs(token.IDENT) {
            if debugFlow && p.debugShiftCount < 120 {
            }

            left = p.parseIdentifier()

            if debugFlow && p.debugShiftCount < 120 {
            }
        } else if p.curTokenIs(token.MUT) {
            left = p.parseMutableIdentifier()
        } else if p.curTokenIs(token.INT) {
            left = p.parseIntegerLiteral()
        } else if p.curTokenIs(token.FLOAT) {
            left = p.parseFloatLiteral()
        } else if p.curTokenIs(token.STRING) {
            left = p.parseStringLiteral()
        } else if p.curTokenIs(token.CHAR) {
            left = p.parseCharLiteral()
        } else if p.curTokenIs(token.TRUE) || p.curTokenIs(token.FALSE) {
            left = p.parseBooleanLiteral()
        } else if p.curTokenIs(token.VOID) {
            left = p.parseVoidLiteral()
        } else if p.curTokenIs(token.BANG) || p.curTokenIs(token.MINUS) || p.curTokenIs(token.BITNOT) {
            left = p.parsePrefixExpression()
        } else if p.curTokenIs(token.AMPERSAND) {
            left = p.parseBorrowExpression()
        } else if p.curTokenIs(token.ASTERISK) {
            left = p.parseDerefExpression()
        } else if p.curTokenIs(token.LPAREN) {
            left = p.parseGroupedExpression()
        } else if p.curTokenIs(token.LBRACKET) {
            left = p.parseVecLiteral()
        } else if p.curTokenIs(token.FUNC) {
            left = p.parseFunctionLiteral()
        } else if p.curTokenIs(token.OK) || p.curTokenIs(token.ERR) || p.curTokenIs(token.SOME) || p.curTokenIs(token.NONE) {
            left = p.parseEnumVariantExpression()
        } else if p.curTokenIs(token.BOX) {
            left = p.parseBoxExpression()
        } else if p.curTokenIs(token.UNDERSCORE) {
            left = p.parseWildcardExpression()
        } else if p.curTokenIs(token.VEC) || p.curTokenIs(token.RESULT) || p.curTokenIs(token.OPTION) {
            left = p.parseTypeIdentifier()
        } else if isTypeConversionToken(p.curType) {
            left = p.parseTypeConversion()
        } else {
            p.noPrefixParseFnError(p.curType)
            left = errorExpression(p.curTokenValue())
        }

        if debugFlow && p.debugShiftCount < 120 {
        }

        while !p.peekTokenIs(token.RBRACE) && precedence < p.peekPrecedence() {
            if debugFlow && p.debugShiftCount < 120 {
            }

            if p.peekTokenIs(token.PLUS) || p.peekTokenIs(token.MINUS) || p.peekTokenIs(token.SLASH) || p.peekTokenIs(token.ASTERISK) || p.peekTokenIs(token.PERCENT) || p.peekTokenIs(token.EQ) || p.peekTokenIs(token.NOT_EQ) || p.peekTokenIs(token.LT) || p.peekTokenIs(token.GT) || p.peekTokenIs(token.LT_EQ) || p.peekTokenIs(token.GT_EQ) || p.peekTokenIs(token.AND) || p.peekTokenIs(token.OR) || p.peekTokenIs(token.BITAND) || p.peekTokenIs(token.AMPERSAND) || p.peekTokenIs(token.BITOR) || p.peekTokenIs(token.BITXOR) || p.peekTokenIs(token.LSHIFT) || p.peekTokenIs(token.RSHIFT) {
                p.advanceToken()
                left = p.parseInfixExpression(left)
                continue
            }

            if p.peekTokenIs(token.LPAREN) {
                if debugFlow && p.debugShiftCount < 120 {
                }

                p.advanceToken()

                if debugFlow && p.debugShiftCount < 120 {
                }

                left = p.parseCallExpression(left)

                if debugFlow && p.debugShiftCount < 120 {
                }

                continue
            }

            if p.peekTokenIs(token.LBRACKET) {
                p.advanceToken()
                left = p.parseIndexExpression(left)
                continue
            }

            if p.peekTokenIs(token.DOT) {
                p.advanceToken()
                left = p.parseDotExpression(left)
                continue
            }

            if p.peekTokenIs(token.DOTDOT) {
                p.advanceToken()
                left = p.parseRangeExpression(left)
                continue
            }

            break
        }

        if debugFlow && p.debugShiftCount < 120 {
        }

        return left
    }

    mut func parseIdentifier() -> (ast.Expression) {
        if p.debugEnabled && p.debugShiftCount < 120 {
        }

        var ident: ast.Identifier = ast.IdentifierFromTokenValue(
            p.curTokenValue(),
            copyString(&p.curLiteral),
        )

        if p.peekTokenIs(token.LBRACE) && p.looksLikeStructLiteral() {
            return p.parseStructLiteral(ident)
        }

        return ast.Expression.Identifier(ident)
    }

    mut func parseMutableIdentifier() -> (ast.Expression) {
        var mutToken: token.Token = p.curTokenValue()

        if !p.expectPeek(token.IDENT) {
            return errorExpression(mutToken)
        }

        return ast.Expression.MutableIdentifier(
            ast.MutableIdentifierFromTokenValue(
                mutToken,
                copyString(&p.curLiteral),
            ),
        )
    }

    mut func parseWildcardExpression() -> (ast.Expression) {
        return ast.Expression.Identifier(
            ast.IdentifierFromTokenValue(
                p.curTokenValue(),
                "_",
            ),
        )
    }

    mut func parseTypeIdentifier() -> (ast.Expression) {
        var ident: ast.Identifier = ast.IdentifierFromTokenValue(
            p.curTokenValue(),
            copyString(&p.curLiteral),
        )

        if p.peekTokenIs(token.LBRACE) && p.looksLikeStructLiteral() {
            return p.parseStructLiteral(ident)
        }

        return ast.Expression.Identifier(ident)
    }

    func looksLikeStructLiteral() -> (bool) {
        if p.peek2TokenIs(token.RBRACE) {
            return isUppercaseIdent(p.curLiteral)
        }

        if p.peek2TokenIs(token.IDENT) && p.peek3TokenIs(token.COLON) {
            return true
        }

        return false
    }

    mut func parseIntegerLiteral() -> (ast.Expression) {
        mut var lit: ast.IntegerLiteral = ast.IntegerLiteralFromParts(
            p.curTokenValue(),
            0,
        )
        var parsed: int = parseIntLiteralValue(p.curLiteral)

        if parsed >= 0 {
            lit.Value = parsed
        } else {
            p.errors.push("parse error P11")

            return errorExpression(p.curTokenValue())
        }

        return ast.Expression.IntegerLiteral(lit)
    }

    mut func parseFloatLiteral() -> (ast.Expression) {
        mut var lit: ast.FloatLiteral = ast.FloatLiteralFromParts(
            p.curTokenValue(),
            0.0,
        )
        var parsed: Result<float64, string> = p.curLiteral.parseFloat()

        switch parsed {
            case Ok(value) {
                lit.Value = value
            }
            case Err(msg) {
                var _msg: string = msg

                p.errors.push("parse error P12")

                return errorExpression(p.curTokenValue())
            }
        }

        return ast.Expression.FloatLiteral(lit)
    }

    mut func parseStringLiteral() -> (ast.Expression) {
        if p.debugEnabled && p.debugShiftCount < 120 {
        }

        // Keep lexer-produced literal as-is. Stage2 native builds are unstable
        // in the per-byte escape reconstruction path.
        var value: string = p.curLiteral

        if p.debugEnabled && p.debugShiftCount < 120 {
        }

        var tok: token.Token = p.curTokenValue()

        if p.debugEnabled && p.debugShiftCount < 120 {
        }

        var lit: ast.StringLiteral = ast.StringLiteralFromParts(tok, value)

        if p.debugEnabled && p.debugShiftCount < 120 {
        }

        return ast.Expression.StringLiteral(lit)
    }

    func processStringEscapes(s: string) -> (string) {
        mut var out: string = ""
        var bytes: Vec<int, _> = s.bytes()
        mut var i: int = 0

        while i < bytes.len() {
            var ch: int = bytes[i]

            if ch == CH_BACKSLASH && i + 1 < bytes.len() {
                var next: int = bytes[i + 1]

                if next == CH_n {
                    out = out + "\n"
                } else if next == CH_t {
                    out = out + "\t"
                } else if next == CH_r {
                    out = out + "\r"
                } else if next == CH_BACKSLASH {
                    out = out + "\\"
                } else if next == CH_QUOTE {
                    out = out + "\""
                } else if next == CH_0 {
                    out = out + string(char(0))
                } else {
                    out = out + string(char(next))
                }

                i = i + 2
                continue
            }

            out = out + string(char(ch))
            i = i + 1
        }

        return out
    }

    mut func parseCharLiteral() -> (ast.Expression) {
        mut var lit: ast.CharLiteral = ast.CharLiteralFromParts(
            p.curTokenValue(),
            char(0),
        )
        var literal: string = p.curLiteral

        if literal.len() == 0 {
            return ast.Expression.CharLiteral(lit)
        }

        var bytes: Vec<int, _> = literal.bytes()

        if bytes.len() > 1 && bytes[0] == CH_BACKSLASH {
            var esc: int = bytes[1]

            // Old switch-based escape handling removed (was block-commented).
            if esc == CH_n {
                lit.Value = char(10)
            } else if esc == CH_t {
                lit.Value = char(9)
            } else if esc == CH_r {
                lit.Value = char(13)
            } else if esc == CH_BACKSLASH {
                lit.Value = char(CH_BACKSLASH)
            } else if esc == CH_APOSTROPHE {
                lit.Value = char(CH_APOSTROPHE)
            } else if esc == CH_QUOTE {
                lit.Value = char(CH_QUOTE)
            } else if esc == CH_0 {
                lit.Value = char(0)
            } else {
                lit.Value = char(esc)
            }
        } else {
            lit.Value = char(bytes[0])
        }

        return ast.Expression.CharLiteral(lit)
    }

    func parseBooleanLiteral() -> (ast.Expression) {
        return ast.Expression.BooleanLiteral(
            ast.BooleanLiteralFromParts(
                p.curTokenValue(),
                p.curTokenIs(token.TRUE),
            ),
        )
    }

    func parseVoidLiteral() -> (ast.Expression) {
        return ast.Expression.VoidLiteral(
            ast.VoidLiteralFromToken(p.curTokenValue()),
        )
    }

    mut func parseTypeConversion() -> (ast.Expression) {
        mut var tc: ast.TypeConversion = ast.TypeConversionFromParts(
            p.curTokenValue(),
            copyString(&p.curLiteral),
            errorExpression(p.curTokenValue()),
        )

        if !p.expectPeek(token.LPAREN) {
            return errorExpression(p.curTokenValue())
        }

        p.advanceToken()
        tc.Value = p.parseExpression(PREC_LOWEST)

        if !p.expectPeek(token.RPAREN) {
            return errorExpression(p.curTokenValue())
        }

        return ast.Expression.TypeConversion(tc)
    }

    mut func parsePrefixExpression() -> (ast.Expression) {
        mut var expr: ast.PrefixExpression = ast.PrefixExpressionFromParts(
            p.curTokenValue(),
            p.curLiteral,
            errorExpression(p.curTokenValue()),
        )

        p.advanceToken()
        expr.Right = p.parseExpression(PREC_PREFIX)

        return ast.Expression.Prefix(expr)
    }

    mut func parseBorrowExpression() -> (ast.Expression) {
        mut var expr: ast.BorrowExpression = ast.BorrowExpressionFromParts(
            p.curTokenValue(),
            false,
            errorExpression(p.curTokenValue()),
        )

        p.advanceToken()

        if p.curTokenIs(token.MUT) {
            expr.Mutable = true
            p.advanceToken()
        }

        expr.Value = p.parseExpression(PREC_PREFIX)

        return ast.Expression.Borrow(expr)
    }

    mut func parseDerefExpression() -> (ast.Expression) {
        mut var expr: ast.DerefExpression = ast.DerefExpressionFromParts(
            p.curTokenValue(),
            errorExpression(p.curTokenValue()),
        )

        p.advanceToken()
        expr.Value = p.parseExpression(PREC_PREFIX)

        return ast.Expression.Deref(expr)
    }

    mut func parseBoxExpression() -> (ast.Expression) {
        mut var expr: ast.BoxExpression = ast.BoxExpressionFromParts(
            p.curTokenValue(),
            errorExpression(p.curTokenValue()),
        )

        p.advanceToken()
        expr.Value = p.parseExpression(PREC_PREFIX)

        return ast.Expression.Box(expr)
    }

    mut func parseInfixExpression(left: ast.Expression) -> (ast.Expression) {
        var opToken: token.Token = p.curTokenValue()
        var opLiteral: string = p.curLiteral
        var precedence: int = p.curPrecedence()

        p.advanceToken()

        var rightExpr: ast.Expression = p.parseExpression(precedence)

        return ast.Expression.Infix(
            ast.InfixExpressionFromParts(
                opToken,
                left,
                opLiteral,
                rightExpr,
            ),
        )
    }

    mut func parseGroupedExpression() -> (ast.Expression) {
        var startToken: token.Token = p.curTokenValue()

        p.advanceToken()

        var exp: ast.Expression = p.parseExpression(PREC_LOWEST)

        if p.peekTokenIs(token.COMMA) {
            p.advanceToken()
            p.advanceToken()

            var end: ast.Expression = p.parseExpression(PREC_LOWEST)
            mut var endInclusive: bool = false

            if p.peekTokenIs(token.RBRACKET) {
                endInclusive = true
                p.advanceToken()
            } else if !p.expectPeek(token.RPAREN) {
            }

            return ast.Expression.Range(
                ast.RangeExpressionFromParts(
                    startToken,
                    exp,
                    end,
                    false,
                    endInclusive,
                ),
            )
        }

        if !p.expectPeek(token.RPAREN) {
            // tolerate missing closing paren when next token is LBRACE (function body)
            if p.peekTokenIs(token.LBRACE) {
                return exp
            }
        }

        return exp
    }

    mut func parseCallExpression(function: ast.Expression) -> (ast.Expression) {
        if p.debugEnabled && p.debugShiftCount < 120 {
        }

        mut var exp: ast.CallExpression = ast.CallExpressionFromParts(
            p.curTokenValue(),
            function,
            Vec.with_cap(4),
        )

        exp.Arguments = p.parseExpressionList(token.RPAREN)

        if p.debugEnabled && p.debugShiftCount < 120 {
        }

        return ast.Expression.Call(exp)
    }

    mut func parseExpressionList(end: int) -> (Vec<ast.Expression, _>) {
        if p.debugEnabled && p.debugShiftCount < 120 {
        }

        mut var list: Vec<ast.Expression, _> = Vec.with_cap(4)

        if p.peekTokenIs(end) {
            p.advanceToken()
        } else {
            if p.debugEnabled && p.debugShiftCount < 120 {
            }

            p.advanceToken()

            if p.debugEnabled && p.debugShiftCount < 120 {
            }

            list.push(p.parseExpression(PREC_LOWEST))

            while p.peekTokenIs(token.COMMA) {
                p.advanceToken()

                if p.peekTokenIs(end) {
                    break
                }

                p.advanceToken()
                list.push(p.parseExpression(PREC_LOWEST))
            }

            if !p.expectPeek(end) {
            }
        }

        if p.debugEnabled && p.debugShiftCount < 120 {
        }

        return list
    }

    mut func parseIndexExpression(left: ast.Expression) -> (ast.Expression) {
        mut var exp: ast.IndexExpression = ast.IndexExpressionFromParts(
            p.curTokenValue(),
            left,
            errorExpression(p.curTokenValue()),
        )

        p.advanceToken()
        exp.Index = p.parseExpression(PREC_LOWEST)

        if !p.expectPeek(token.RBRACKET) {
            return ast.Expression.Index(exp)
        }

        return ast.Expression.Index(exp)
    }

    mut func parseDotExpression(left: ast.Expression) -> (ast.Expression) {
        var tok: token.Token = p.curTokenValue()
        mut var result: ast.Expression = left
        mut var done: bool = false
        mut var field: ast.Identifier = ast.IdentifierFromTokenValue(
            emptyToken(),
            "",
        )

        if !p.expectPeek(token.IDENT) {
            done = true
        } else {
            field = ast.IdentifierFromTokenValue(
                p.curTokenValue(),
                copyString(&p.curLiteral),
            )
        }

        if !done && p.peekTokenIs(token.LPAREN) {
            p.advanceToken()

            mut var mc: ast.MethodCallExpression = ast.MethodCallExpressionFromParts(
                tok,
                result,
                field,
                Vec.with_cap(4),
            )

            mc.Arguments = p.parseExpressionList(token.RPAREN)
            result = ast.Expression.MethodCall(mc)
            done = true
        }

        if !done {
            result = ast.Expression.FieldAccess(
                ast.FieldAccessExpressionFromParts(
                    tok,
                    result,
                    field,
                ),
            )
        }

        return result
    }

    mut func parseRangeExpression(left: ast.Expression) -> (ast.Expression) {
        mut var re: ast.RangeExpression = ast.RangeExpressionFromParts(
            p.curTokenValue(),
            left,
            errorExpression(p.curTokenValue()),
            true,
            false,
        )
        var precedence: int = p.curPrecedence()

        p.advanceToken()
        re.End = p.parseExpression(precedence)

        return ast.Expression.Range(re)
    }

    mut func parseVecLiteral() -> (ast.Expression) {
        var startToken: token.Token = p.curTokenValue()

        if p.peekTokenIs(token.RBRACKET) {
            p.advanceToken()

            return ast.Expression.VecLiteral(
                ast.VecLiteralFromElements(
                    startToken,
                    Vec.with_cap(0),
                ),
            )
        }

        p.advanceToken()

        var first: ast.Expression = p.parseExpression(PREC_LOWEST)
        mut var result: ast.Expression = errorExpression(startToken)

        if p.peekTokenIs(token.COMMA) {
            p.advanceToken()

            if p.peekTokenIs(token.RBRACKET) {
                p.advanceToken()
                result = ast.Expression.VecLiteral(
                    ast.VecLiteralFromElements(
                        startToken,
                        Vec.from([first]),
                    ),
                )
            } else {
                p.advanceToken()

                var second: ast.Expression = p.parseExpression(PREC_LOWEST)

                if p.peekTokenIs(token.RBRACKET) {
                    p.advanceToken()

                    if isNumericExpression(&first) && isNumericExpression(&second) {
                        result = ast.Expression.Range(
                            ast.RangeExpressionFromParts(
                                startToken,
                                first,
                                second,
                                true,
                                true,
                            ),
                        )
                    } else {
                        result = ast.Expression.VecLiteral(
                            ast.VecLiteralFromElements(
                                startToken,
                                Vec.from([first, second]),
                            ),
                        )
                    }
                } else if p.peekTokenIs(token.RPAREN) {
                    p.advanceToken()
                    result = ast.Expression.Range(
                        ast.RangeExpressionFromParts(
                            startToken,
                            first,
                            second,
                            true,
                            false,
                        ),
                    )
                } else if p.peekTokenIs(token.COMMA) {
                    mut var elements: Vec<ast.Expression, _> = Vec.with_cap(8)

                    elements.push(first)
                    elements.push(second)

                    while p.peekTokenIs(token.COMMA) {
                        p.advanceToken()

                        if p.peekTokenIs(token.RBRACKET) {
                            break
                        }

                        p.advanceToken()
                        elements.push(p.parseExpression(PREC_LOWEST))
                    }

                    if !p.expectPeek(token.RBRACKET) {
                    }

                    result = ast.Expression.VecLiteral(
                        ast.VecLiteralFromElements(
                            startToken,
                            elements,
                        ),
                    )
                }
            }
        } else if p.peekTokenIs(token.RBRACKET) {
            p.advanceToken()

            if isRangeExpression(&first) {
                result = first
            } else {
                result = ast.Expression.VecLiteral(
                    ast.VecLiteralFromElements(
                        startToken,
                        Vec.from([first]),
                    ),
                )
            }
        } else {
            if !p.expectPeek(token.RBRACKET) {
            }

            if isRangeExpression(&first) {
                result = first
            } else {
                result = ast.Expression.VecLiteral(
                    ast.VecLiteralFromElements(
                        startToken,
                        Vec.from([first]),
                    ),
                )
            }
        }

        return result
    }

    mut func parseStructLiteral(name: ast.Identifier) -> (ast.Expression) {
        var structLitToken: token.Token = p.curTokenValue()
        mut var fields: Vec<ast.StructFieldValue, _> = Vec.with_cap(8)

        p.advanceToken()

        if p.peekTokenIs(token.RBRACE) {
            p.advanceToken()

            var emptyLit: ast.StructLiteral = ast.StructLiteralFromParts(
                structLitToken,
                name,
                fields,
            )

            return ast.Expression.StructLiteral(emptyLit)
        }

        p.advanceToken()

        var field: Option<ast.StructFieldValue> = p.parseStructFieldValue()

        switch field {
            case Some(f) {
                fields.push(f)
            }
            case None {
            }
        }

        while p.peekTokenIs(token.COMMA) {
            p.advanceToken()

            if p.peekTokenIs(token.RBRACE) {
                p.advanceToken()

                var trailingLit: ast.StructLiteral = ast.StructLiteralFromParts(
                    structLitToken,
                    name,
                    fields,
                )

                return ast.Expression.StructLiteral(trailingLit)
            }

            p.advanceToken()

            var nextField: Option<ast.StructFieldValue> = p.parseStructFieldValue()

            switch nextField {
                case Some(f) {
                    fields.push(f)
                }
                case None {
                }
            }
        }

        if !p.expectPeek(token.RBRACE) {
            var errLit: ast.StructLiteral = ast.StructLiteralFromParts(
                structLitToken,
                name,
                fields,
            )

            return ast.Expression.StructLiteral(errLit)
        }

        var lit: ast.StructLiteral = ast.StructLiteralFromParts(
            structLitToken,
            name,
            fields,
        )

        return ast.Expression.StructLiteral(lit)
    }

    mut func parseStructFieldValue() -> (Option<ast.StructFieldValue>) {
        if !p.curTokenIs(token.IDENT) {
            p.peekError(token.IDENT)

            return None
        }

        var name: ast.Identifier = ast.IdentifierFromTokenValue(
            p.curTokenValue(),
            copyString(&p.curLiteral),
        )

        if !p.expectPeek(token.COLON) {
            return None
        }

        p.advanceToken()

        var value: ast.Expression = p.parseExpression(PREC_LOWEST)

        return Some(
            ast.StructFieldValueFromParts(
                name,
                value,
            ),
        )
    }

    mut func parseEnumVariantExpression() -> (ast.Expression) {
        mut var values: Vec<ast.Expression, _> = Vec.with_cap(2)
        var variantIdent: ast.Identifier = ast.IdentifierFromTokenValue(
            p.curTokenValue(),
            copyString(&p.curLiteral),
        )

        if p.peekTokenIs(token.LPAREN) {
            p.advanceToken()
            values = p.parseExpressionList(token.RPAREN)
        }

        var ev: ast.EnumVariantExpression = ast.EnumVariantExpressionFromParts(
            p.curTokenValue(),
            variantIdent,
            values,
        )

        return ast.Expression.EnumVariant(ev)
    }

    mut func parseFunctionLiteral() -> (ast.Expression) {
        var fnToken: token.Token = p.curTokenValue()

        if !p.expectPeek(token.LPAREN) {
            return errorExpression(p.curTokenValue())
        }

        var parameters: Vec<ast.Parameter, _> = p.parseParameters()

        if !p.expectPeek(token.ARROW) {
            return errorExpression(p.curTokenValue())
        }

        if !p.expectPeek(token.LPAREN) {
            return errorExpression(p.curTokenValue())
        }

        var returnType: ast.TypeExpression = p.parseReturnTypes()

        if !p.expectPeek(token.LBRACE) {
            return errorExpression(p.curTokenValue())
        }

        var body: ast.BlockStatement = p.parseBlockStatement()
        var lit: ast.FunctionLiteral = ast.FunctionLiteralFromParts(
            fnToken,
            parameters,
            returnType,
            body,
        )

        return ast.Expression.FunctionLiteral(lit)
    }
}

func isUppercaseIdent(name: string) -> (bool) {
    if name.len() == 0 {
        return false
    }

    var bytes: Vec<int, _> = name.bytes()
    var ch: int = bytes[0]

    return ch >= CH_A && ch <= CH_Z
}

func isNumericExpression(expr: &ast.Expression) -> (bool) {
    mut var _il: ast.IntegerLiteral = ast.IntegerLiteralFromParts(
        emptyToken(),
        0,
    )
    mut var _re: ast.RangeExpression = ast.RangeExpressionFromParts(
        emptyToken(),
        errorExpression(emptyToken()),
        errorExpression(emptyToken()),
        false,
        false,
    )

    switch *expr {
        case ast.Expression.IntegerLiteral(_il) {
            return true
        }
        default {
            return false
        }
    }
}

func isRangeExpression(expr: &ast.Expression) -> (bool) {
    mut var _re: ast.RangeExpression = ast.RangeExpressionFromParts(
        emptyToken(),
        errorExpression(emptyToken()),
        errorExpression(emptyToken()),
        false,
        false,
    )

    switch *expr {
        case ast.Expression.Range(_re) {
            return true
        }
        default {
            return false
        }
    }
}

func parseIntLiteralValue(literal: string) -> (int) {
    // Keep base-specific math explicit to avoid fragile generic value*base lowering
    // in bootstrap stages.
    mut var parse_kind__intlit: int = 0
    mut var parse_start__intlit: int = 0

    if literal.len() >= 2 && int(literal[0]) == 48 && int(literal[1]) == 98 {
        parse_kind__intlit = 2
        parse_start__intlit = 2
    } else if literal.len() >= 2 && int(literal[0]) == 48 && int(literal[1]) == 111 {
        parse_kind__intlit = 8
        parse_start__intlit = 2
    } else if literal.len() >= 2 && int(literal[0]) == 48 && int(literal[1]) == 120 {
        parse_kind__intlit = 8 + 8
        parse_start__intlit = 2
    } else {
        // Decimal
        parse_kind__intlit = 8 + 2
    }

    if parse_start__intlit >= literal.len() {
        return -1
    }

    mut var parse_value__intlit: int = 0
    mut var parse_idx__intlit: int = parse_start__intlit

    while parse_idx__intlit < literal.len() {
        var parse_digit__intlit: int = digitValue(int(literal[parse_idx__intlit]))

        if parse_digit__intlit < 0 {
            return -2
        }

        if parse_kind__intlit == 2 {
            if parse_digit__intlit >= 2 {
                return -2
            }

            parse_value__intlit = parse_value__intlit * 2 + parse_digit__intlit
        } else if parse_kind__intlit == 8 {
            if parse_digit__intlit >= 8 {
                return -2
            }

            parse_value__intlit = parse_value__intlit * 8 + parse_digit__intlit
        } else if parse_kind__intlit == 8 + 8 {
            if parse_digit__intlit >= 8 + 8 {
                return -2
            }

            parse_value__intlit = parse_value__intlit * (8 + 8) + parse_digit__intlit
        } else {
            if parse_digit__intlit >= 8 + 2 {
                return -2
            }

            parse_value__intlit = parse_value__intlit * 8 + parse_value__intlit * 2 + parse_digit__intlit
        }

        parse_idx__intlit = parse_idx__intlit + 1
    }

    return parse_value__intlit
}

func parseIntLiteralError(code: int) -> (string) {
    if code == -1 {
        return "empty literal"
    }

    return "invalid digit"
}

func digitValue(ch: int) -> (int) {
    if ch >= CH_0 && ch <= CH_9 {
        return ch - CH_0
    }

    if ch >= CH_a && ch <= CH_f {
        return 10 + (ch - CH_a)
    }

    if ch >= CH_A && ch <= CH_F {
        return 10 + (ch - CH_A)
    }

    return -1
}

func errorExpression(tok: token.Token) -> (ast.Expression) {
    return ast.Expression.VoidLiteral(ast.VoidLiteralFromToken(tok))
}

func errorType(tok: token.Token, msg: string) -> (ast.TypeExpression) {
    return ast.TypeExpressionErrorFromMessage(tok, msg)
}
