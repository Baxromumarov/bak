    return Parameter{
        Token:   paramTok,
        Name:    name,
        Type:    paramType,
        Mutable: mutable,
    }
}

pub func EmptyFunctionDecl() -> (FunctionDecl) {
    var zeroTok: token.Token = token.MakeToken(
        token.ILLEGAL,
        "",
        0,
        0,
    )

    return FunctionDecl{
        Token:      zeroTok,
        Visibility: Visibility.Private,
        Name: Identifier{
            Token: zeroTok,
            Value: "",
        },
        TypeParams: Vec.with_cap(0),
        Parameters: Vec.with_cap(0),
        ReturnType: TypeExpression.Simple(
            SimpleType{
                Token: zeroTok,
                Name:  "void",
            },
        ),
        Body: BlockStatement{
            Token:      zeroTok,
            Statements: Vec.with_cap(0),
        },
    }
}

pub func FunctionDeclFromCore(
    visibility: Visibility,
    name: Identifier,
    typeParams: Vec<Identifier, _>,
    parameters: Vec<Parameter, _>,
    returnType: TypeExpression,
    body: BlockStatement,
) -> (FunctionDecl) {
    return FunctionDecl{
        Token:      name.Token,
        Visibility: visibility,
        Name:       name,
        TypeParams: typeParams,
        Parameters: parameters,
        ReturnType: returnType,
        Body:       body,
    }
}

