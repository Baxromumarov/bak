pub func FunctionLiteralFromParts(
    tok: token.Token,
    parameters: Vec<Parameter, _>,
    returnType: TypeExpression,
    body: BlockStatement,
) -> (FunctionLiteral) {
    return FunctionLiteral{
        Token:      tok,
        Parameters: parameters,
        ReturnType: returnType,
        Body:       body,
    }
}

pub func TypeExpressionErrorFromMessage(
    tok: token.Token,
    msg: string,
) -> (TypeExpression) {
    return TypeExpression.Error(
        ErrorType{
            Token:   tok,
            Message: msg,
        },
    )
}

