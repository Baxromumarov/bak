func cloneString(value: &string) -> (string) {
    return *value
}

func cloneIdentifier(id: &Identifier) -> (Identifier) {
    return Identifier{
        Token: id.Token,
        Value: cloneString(&id.Value),
    }
}

func cloneMutableIdentifier(id: &MutableIdentifier) -> (MutableIdentifier) {
    return MutableIdentifier{
        Token: id.Token,
        Value: cloneString(&id.Value),
    }
}

func cloneIdentifierVec(ids: &Vec<Identifier, _>) -> (Vec<Identifier, _>) {
    mut var out: Vec<Identifier, _> = Vec.with_cap(ids.len())
    mut var i: int = 0

    while i < ids.len() {
        out.push(
            cloneIdentifier(&(*ids)[i]),
        )
        i = i + 1
    }

    return out
}

func cloneTypeExpressionVec(types: &Vec<TypeExpression, _>) -> (Vec<TypeExpression, _>) {
    mut var out: Vec<TypeExpression, _> = Vec.with_cap(types.len())
    mut var i: int = 0

    while i < types.len() {
        out.push(
            cloneTypeExpression(&(*types)[i]),
        )
        i = i + 1
    }

    return out
}

func cloneOptionTypeExpression(typeOpt: &Option<TypeExpression>) -> (Option<TypeExpression>) {
    switch *typeOpt {
        case Some(t) {
            return Some(
                cloneTypeExpression(&t),
            )
        }
        case None {
            return None
        }
    }
}

func cloneParameter(param: &Parameter) -> (Parameter) {
    return Parameter{
        Token:   param.Token,
        Name:    cloneIdentifier(&param.Name),
        Type:    cloneTypeExpression(&param.Type),
        Mutable: param.Mutable,
    }
}

func cloneParameterVec(params: &Vec<Parameter, _>) -> (Vec<Parameter, _>) {
    mut var out: Vec<Parameter, _> = Vec.with_cap(params.len())
    mut var i: int = 0

    while i < params.len() {
        out.push(
            cloneParameter(&(*params)[i]),
        )
        i = i + 1
    }

    return out
}

func cloneTypeExpression(t: &TypeExpression) -> (TypeExpression) {
    switch *t {
        case TypeExpression.Simple(st) {
            return TypeExpression.Simple(
                SimpleType{
                    Token: st.Token,
                    Name:  cloneString(&st.Name),
                },
            )
        }
        case TypeExpression.Generic(gt) {
            return TypeExpression.Generic(
                GenericType{
                    Token:      gt.Token,
                    Name:       cloneString(&gt.Name),
                    TypeParams: cloneTypeExpressionVec(&gt.TypeParams),
                },
            )
        }
        case TypeExpression.BorrowRef(bt) {
            return TypeExpression.BorrowRef(
                BorrowType{
                    Token:   bt.Token,
                    Mutable: bt.Mutable,
                    Inner:   cloneTypeExpression(&bt.Inner),
                },
            )
        }
        case TypeExpression.BoxRef(bt) {
            return TypeExpression.BoxRef(
                BoxType{
                    Token: bt.Token,
                    Inner: cloneTypeExpression(&bt.Inner),
                },
            )
        }
        case TypeExpression.BoxOptional(bt) {
            return TypeExpression.BoxOptional(
                BoxOptionalType{
                    Token: bt.Token,
                    Inner: cloneTypeExpression(&bt.Inner),
                },
            )
        }
        case TypeExpression.Size(st) {
            return TypeExpression.Size(
                SizeExpression{
                    Token:     st.Token,
                    Value:     st.Value,
                    IsDynamic: st.IsDynamic,
                },
            )
        }
        case TypeExpression.Void(vt) {
            return TypeExpression.Void(
                VoidType{
                    Token: vt.Token,
                },
            )
        }
        case TypeExpression.Error(et) {
            return TypeExpression.Error(
                ErrorType{
                    Token:   et.Token,
                    Message: cloneString(&et.Message),
                },
            )
        }
        case TypeExpression.TupleRef(tt) {
            return TypeExpression.TupleRef(
                TupleType{
                    Token:    tt.Token,
                    Elements: cloneTypeExpressionVec(&tt.Elements),
                },
            )
        }
        case TypeExpression.Function(ft) {
            return TypeExpression.Function(
                FunctionType{
                    Token:      ft.Token,
                    Parameters: cloneTypeExpressionVec(&ft.Parameters),
                    ReturnType: cloneTypeExpression(&ft.ReturnType),
                },
            )
        }
        default {
            return *t
        }
    }
}

func cloneExpressionVec(values: &Vec<Expression, _>) -> (Vec<Expression, _>) {
    mut var out: Vec<Expression, _> = Vec.with_cap(values.len())
    mut var i: int = 0

    while i < values.len() {
        out.push(
            cloneExpression(&(*values)[i]),
        )
        i = i + 1
    }

    return out
}

func cloneStructFieldValueVec(fields: &Vec<StructFieldValue, _>) -> (Vec<StructFieldValue, _>) {
    mut var out: Vec<StructFieldValue, _> = Vec.with_cap(fields.len())
    mut var i: int = 0

    while i < fields.len() {
        out.push(
            StructFieldValue{
                Name:  cloneIdentifier(&((*fields)[i]).Name),
                Value: cloneExpression(&((*fields)[i]).Value),
            },
        )
        i = i + 1
    }

    return out
}

func cloneOptionExpression(exprOpt: &Option<Expression>) -> (Option<Expression>) {
    switch *exprOpt {
        case Some(expr) {
            return Some(
                cloneExpression(&expr),
            )
        }
        case None {
            return None
        }
    }
}

func cloneOptionBlockStatement(blockOpt: &Option<BlockStatement>) -> (Option<BlockStatement>) {
    switch *blockOpt {
        case Some(block) {
            return Some(
                cloneBlockStatement(&block),
            )
        }
        case None {
            return None
        }
    }
}

func cloneExpression(expr: &Expression) -> (Expression) {
    switch *expr {
        case Expression.Identifier(id) {
            return Expression.Identifier(
                cloneIdentifier(&id),
            )
        }
        case Expression.MutableIdentifier(idm) {
            return Expression.MutableIdentifier(
                cloneMutableIdentifier(&idm),
            )
        }
        case Expression.IntegerLiteral(il) {
            return Expression.IntegerLiteral(
                IntegerLiteral{
                    Token: il.Token,
                    Value: il.Value,
                },
            )
        }
        case Expression.FloatLiteral(fl) {
            return Expression.FloatLiteral(
                FloatLiteral{
                    Token: fl.Token,
                    Value: fl.Value,
                },
            )
        }
        case Expression.StringLiteral(sl) {
            return Expression.StringLiteral(
                StringLiteral{
                    Token: sl.Token,
                    Value: cloneString(&sl.Value),
                },
            )
        }
        case Expression.CharLiteral(cl) {
            return Expression.CharLiteral(
                CharLiteral{
                    Token: cl.Token,
                    Value: cl.Value,
                },
            )
        }
        case Expression.BooleanLiteral(bl) {
            return Expression.BooleanLiteral(
                BooleanLiteral{
                    Token: bl.Token,
                    Value: bl.Value,
                },
            )
        }
        case Expression.VoidLiteral(vl) {
            return Expression.VoidLiteral(
                VoidLiteral{
                    Token: vl.Token,
                },
            )
        }
        case Expression.Prefix(pe) {
            return Expression.Prefix(
                PrefixExpression{
                    Token:    pe.Token,
                    Operator: cloneString(&pe.Operator),
                    Right:    cloneExpression(&pe.Right),
                },
            )
        }
        case Expression.Infix(ie) {
            return Expression.Infix(
                InfixExpression{
                    Token:    ie.Token,
                    Left:     cloneExpression(&ie.Left),
                    Right:    cloneExpression(&ie.Right),
                    Operator: cloneString(&ie.Operator),
                },
            )
        }
        case Expression.Call(ce) {
            return Expression.Call(
                CallExpression{
                    Token:     ce.Token,
                    Function:  cloneExpression(&ce.Function),
                    Arguments: cloneExpressionVec(&ce.Arguments),
                },
            )
        }
        case Expression.TypeConversion(tc) {
            return Expression.TypeConversion(
                TypeConversion{
                    Token:    tc.Token,
                    TypeName: cloneString(&tc.TypeName),
                    Value:    cloneExpression(&tc.Value),
                },
            )
        }
        case Expression.MethodCall(mc) {
            return Expression.MethodCall(
                MethodCallExpression{
                    Token:     mc.Token,
                    Object:    cloneExpression(&mc.Object),
                    Method:    cloneIdentifier(&mc.Method),
                    Arguments: cloneExpressionVec(&mc.Arguments),
                },
            )
        }
        case Expression.FieldAccess(fe) {
            return Expression.FieldAccess(
                FieldAccessExpression{
                    Token:  fe.Token,
                    Object: cloneExpression(&fe.Object),
                    Field:  cloneIdentifier(&fe.Field),
                },
            )
        }
        case Expression.Index(ie) {
            return Expression.Index(
                IndexExpression{
                    Token: ie.Token,
                    Left:  cloneExpression(&ie.Left),
                    Index: cloneExpression(&ie.Index),
                },
            )
        }
        case Expression.StructLiteral(sl) {
            return Expression.StructLiteral(
                StructLiteral{
                    Token:  sl.Token,
                    Name:   cloneIdentifier(&sl.Name),
                    Fields: cloneStructFieldValueVec(&sl.Fields),
                },
            )
        }
        case Expression.VecLiteral(vl) {
            return Expression.VecLiteral(
                VecLiteral{
                    Token:    vl.Token,
                    Elements: cloneExpressionVec(&vl.Elements),
                },
            )
        }
        case Expression.Tuple(te) {
            return Expression.Tuple(
                TupleExpression{
                    Token:    te.Token,
                    Elements: cloneExpressionVec(&te.Elements),
                },
            )
        }
        case Expression.Range(re) {
            return Expression.Range(
                RangeExpression{
                    Token:          re.Token,
                    Start:          cloneExpression(&re.Start),
                    End:            cloneExpression(&re.End),
                    StartInclusive: re.StartInclusive,
                    EndInclusive:   re.EndInclusive,
                },
            )
        }
        case Expression.EnumVariant(ev) {
            return Expression.EnumVariant(
                EnumVariantExpression{
                    Token:   ev.Token,
                    Variant: cloneIdentifier(&ev.Variant),
                    Values:  cloneExpressionVec(&ev.Values),
                },
            )
        }
        case Expression.Borrow(be) {
            return Expression.Borrow(
                BorrowExpression{
                    Token:   be.Token,
                    Mutable: be.Mutable,
                    Value:   cloneExpression(&be.Value),
                },
            )
        }
        case Expression.Box(be) {
            return Expression.Box(
                BoxExpression{
                    Token: be.Token,
                    Value: cloneExpression(&be.Value),
                },
            )
        }
        case Expression.Deref(de) {
            return Expression.Deref(
                DerefExpression{
                    Token: de.Token,
                    Value: cloneExpression(&de.Value),
                },
            )
        }
        case Expression.FunctionLiteral(fl) {
            return Expression.FunctionLiteral(
                FunctionLiteral{
                    Token:      fl.Token,
                    Parameters: cloneParameterVec(&fl.Parameters),
                    ReturnType: cloneTypeExpression(&fl.ReturnType),
                    Body:       cloneBlockStatement(&fl.Body),
                },
            )
        }
        default {
            return *expr
        }
    }
}

func cloneStatementVec(stmts: &Vec<Statement, _>) -> (Vec<Statement, _>) {
    mut var out: Vec<Statement, _> = Vec.with_cap(stmts.len())
    mut var i: int = 0

    while i < stmts.len() {
        out.push(
            cloneStatement(&(*stmts)[i]),
        )
        i = i + 1
    }

    return out
}

func cloneSwitchCaseVec(cases: &Vec<SwitchCase, _>) -> (Vec<SwitchCase, _>) {
    mut var out: Vec<SwitchCase, _> = Vec.with_cap(cases.len())
    mut var i: int = 0

    while i < cases.len() {
        out.push(
            SwitchCase{
                Token:   (*cases)[i].Token,
                Values:  cloneExpressionVec(&((*cases)[i]).Values),
                Body:    cloneBlockStatement(&((*cases)[i]).Body),
                Default: (*cases)[i].Default,
            },
        )
        i = i + 1
    }

    return out
}

func cloneStatement(stmt: &Statement) -> (Statement) {
    switch *stmt {
        case Statement.Var(vs) {
            return Statement.Var(
                VarStatement{
                    Token:   vs.Token,
                    Name:    cloneIdentifier(&vs.Name),
                    Type:    cloneOptionTypeExpression(&vs.Type),
                    Value:   cloneOptionExpression(&vs.Value),
                    Mutable: vs.Mutable,
                },
            )
        }
        case Statement.MultiVar(mvs) {
            mut var outNames: Vec<Identifier, _> = Vec.with_cap(mvs.Names.len())
            mut var outTypes: Vec<Option<TypeExpression>, _> = Vec.with_cap(mvs.Types.len())
            mut var i: int = 0

            while i < mvs.Names.len() {
                outNames.push(
                    cloneIdentifier(&mvs.Names[i]),
                )
                i = i + 1
            }

            i = 0
            while i < mvs.Types.len() {
                outTypes.push(
                    cloneOptionTypeExpression(&mvs.Types[i]),
                )
                i = i + 1
            }

            return Statement.MultiVar(
                MultiVarStatement{
                    Token:   mvs.Token,
                    Names:   outNames,
                    Types:   outTypes,
                    Value:   cloneOptionExpression(&mvs.Value),
                    Mutable: mvs.Mutable,
                },
            )
        }
        case Statement.Const(cs) {
            return Statement.Const(
                ConstStatement{
                    Token:      cs.Token,
                    Visibility: cs.Visibility,
                    Name:       cloneIdentifier(&cs.Name),
                    Type:       cloneOptionTypeExpression(&cs.Type),
                    Value:      cloneExpression(&cs.Value),
                },
            )
        }
        case Statement.ConstBlock(cb) {
            mut var outConsts: Vec<ConstStatement, _> = Vec.with_cap(cb.Constants.len())
            mut var i2: int = 0

            while i2 < cb.Constants.len() {
                var c: ConstStatement = cb.Constants[i2]

                outConsts.push(
                    ConstStatement{
                        Token:      c.Token,
                        Visibility: c.Visibility,
                        Name:       cloneIdentifier(&c.Name),
                        Type:       cloneOptionTypeExpression(&c.Type),
                        Value:      cloneExpression(&c.Value),
                    },
                )

                i2 = i2 + 1
            }

            return Statement.ConstBlock(
                ConstBlock{
                    Token:     cb.Token,
                    Constants: outConsts,
                },
            )
        }
        case Statement.VarBlock(vb) {
            mut var outVars: Vec<VarStatement, _> = Vec.with_cap(vb.Variables.len())
            mut var i3: int = 0

            while i3 < vb.Variables.len() {
                var v: VarStatement = vb.Variables[i3]

                outVars.push(
                    VarStatement{
                        Token:   v.Token,
                        Name:    cloneIdentifier(&v.Name),
                        Type:    cloneOptionTypeExpression(&v.Type),
                        Value:   cloneOptionExpression(&v.Value),
                        Mutable: v.Mutable,
                    },
                )

                i3 = i3 + 1
            }

            return Statement.VarBlock(
                VarBlock{
                    Token:     vb.Token,
                    Variables: outVars,
                },
            )
        }
        case Statement.Return(rs) {
            return Statement.Return(
                ReturnStatement{
                    Token:       rs.Token,
                    ReturnValue: cloneOptionExpression(&rs.ReturnValue),
                },
            )
        }
        case Statement.Expression(es) {
            return Statement.Expression(
                ExpressionStatement{
                    Token:      es.Token,
                    Expression: cloneExpression(&es.Expression),
                },
            )
        }
        case Statement.Block(bs) {
            return Statement.Block(
                cloneBlockStatement(&bs),
            )
        }
        case Statement.If(is) {
            return Statement.If(
                IfStatement{
                    Token:       is.Token,
                    Condition:   cloneExpression(&is.Condition),
                    Consequence: cloneBlockStatement(&is.Consequence),
                    Alternative: cloneOptionBlockStatement(&is.Alternative),
                },
            )
        }
        case Statement.While(ws) {
            return Statement.While(
                WhileStatement{
                    Token:     ws.Token,
                    Condition: cloneExpression(&ws.Condition),
                    Body:      cloneBlockStatement(&ws.Body),
                },
            )
        }
        case Statement.For(fs) {
            return Statement.For(
                ForStatement{
                    Token:    fs.Token,
                    Variable: cloneIdentifier(&fs.Variable),
                    Iterable: cloneExpression(&fs.Iterable),
                    Body:     cloneBlockStatement(&fs.Body),
                },
            )
        }
        case Statement.Switch(ss) {
            return Statement.Switch(
                SwitchStatement{
                    Token: ss.Token,
                    Value: cloneExpression(&ss.Value),
                    Cases: cloneSwitchCaseVec(&ss.Cases),
                },
            )
        }
        case Statement.Defer(ds) {
            return Statement.Defer(
                DeferStatement{
                    Token: ds.Token,
                    Body:  cloneBlockStatement(&ds.Body),
                },
            )
        }
        case Statement.Panic(ps) {
            return Statement.Panic(
                PanicStatement{
                    Token:   ps.Token,
                    Message: cloneExpression(&ps.Message),
                },
            )
        }
        case Statement.Unsafe(us) {
            return Statement.Unsafe(
                UnsafeBlock{
                    Token: us.Token,
                    Body:  cloneBlockStatement(&us.Body),
                },
            )
        }
        case Statement.Break(bs) {
            return Statement.Break(
                BreakStatement{
                    Token: bs.Token,
                },
            )
        }
        case Statement.Continue(cs) {
            return Statement.Continue(
                ContinueStatement{
                    Token: cs.Token,
                },
            )
        }
        case Statement.Assignment(assignStmt) {
            return Statement.Assignment(
                AssignmentStatement{
                    Token:      assignStmt.Token,
                    Left:       cloneExpression(&assignStmt.Left),
                    Value:      cloneExpression(&assignStmt.Value),
                    TargetName: cloneString(&assignStmt.TargetName),
                    ValueKind:  assignStmt.ValueKind,
                    ValueInt:   assignStmt.ValueInt,
                    ValueFloat: assignStmt.ValueFloat,
                    ValueBool:  assignStmt.ValueBool,
                    ValueChar:  assignStmt.ValueChar,
                    ValueText:  cloneString(&assignStmt.ValueText),
                },
            )
        }
        default {
            return *stmt
        }
    }
}

func cloneBlockStatement(block: &BlockStatement) -> (BlockStatement) {
    return BlockStatement{
        Token:      block.Token,
        Statements: cloneStatementVec(&block.Statements),
    }
}

pub func CloneStatement(stmt: &Statement) -> (Statement) {
    return cloneStatement(stmt)
}

pub func CloneFunctionDecl(fd: &FunctionDecl) -> (FunctionDecl) {
    return FunctionDecl{
        Token:      fd.Token,
        Visibility: fd.Visibility,
        Name:       cloneIdentifier(&fd.Name),
        TypeParams: cloneIdentifierVec(&fd.TypeParams),
        Parameters: cloneParameterVec(&fd.Parameters),
        ReturnType: cloneTypeExpression(&fd.ReturnType),
        Body:       cloneBlockStatement(&fd.Body),
    }
}
