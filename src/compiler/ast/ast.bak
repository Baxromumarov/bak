    Simple(SimpleType)
    Generic(GenericType)
    BorrowRef(BorrowType)
    BoxRef(BoxType)
    BoxOptional(BoxOptionalType)
    Size(SizeExpression)
    Void(VoidType)
    Error(ErrorType)
    TupleRef(TupleType)
    Function(FunctionType)
}

