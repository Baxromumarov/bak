}

pub func LowerImplMethod(
    pkg: string,
    typeName: Identifier,
    receiver: Identifier,
    implTok: token.Token,
    md: MethodDecl,
) -> (FunctionDecl) {
    mut var methodName: string = typeName.Value + "." + md.Name.Value
    mut var recvTypeName: string = typeName.Value

    if pkg != "main" {
        methodName = pkg + "." + methodName
        recvTypeName = pkg + "." + recvTypeName
    }

    var recvType: TypeExpression = TypeExpression.Simple(
        SimpleType{
            Token: typeName.Token,
            Name:  recvTypeName,
        },
    )
    mut var methodParams: Vec<Parameter, _> = Vec.with_cap(md.Parameters.len() + 1)

    methodParams.push(
        Parameter{
            Token:   implTok,
            Name:    Identifier{
                Token: receiver.Token,
                Value: receiver.Value,
            },
            Type:    recvType,
            Mutable: md.Mutable,
        },
    )

    mut var pi: int = 0

    while pi < md.Parameters.len() {
        methodParams.push(md.Parameters[pi])
        pi = pi + 1
    }

    return FunctionDecl{
        Token:      md.Token,
        Visibility: md.Visibility,
        Name:       Identifier{
            Token: md.Name.Token,
            Value: methodName,
        },
        TypeParams: Vec.new(),
        Parameters: methodParams,
        ReturnType: md.ReturnType,
        Body:       md.Body,
    }
}

pub enum Expression {
    Identifier(Identifier)
    MutableIdentifier(MutableIdentifier)
    IntegerLiteral(IntegerLiteral)
    FloatLiteral(FloatLiteral)
    StringLiteral(StringLiteral)
    CharLiteral(CharLiteral)
    BooleanLiteral(BooleanLiteral)
    VoidLiteral(VoidLiteral)
    Prefix(PrefixExpression)
    Infix(InfixExpression)
    Call(CallExpression)
    TypeConversion(TypeConversion)
    MethodCall(MethodCallExpression)
    FieldAccess(FieldAccessExpression)
    Index(IndexExpression)
    StructLiteral(StructLiteral)
    VecLiteral(VecLiteral)
    Tuple(TupleExpression)
    Range(RangeExpression)
    EnumVariant(EnumVariantExpression)
    Borrow(BorrowExpression)
    Box(BoxExpression)
    Deref(DerefExpression)
    FunctionLiteral(FunctionLiteral)
}

