// AST nodes for bakc.
package ast

import "src/compiler/token/token.bak" as token

pub enum Visibility {
    Private
    Public
}

pub struct Program {
    pub Statements: Vec<Statement, _>
}

pub func ProgramFromStatements(statements: Vec<Statement, _>) -> (Program) {
    return Program{
        Statements: statements,
    }
}

pub func BreakStatementFromToken(tok: token.Token) -> (BreakStatement) {
    return BreakStatement{
        Token: tok,
    }
}

pub func ContinueStatementFromToken(tok: token.Token) -> (ContinueStatement) {
    return ContinueStatement{
        Token: tok,
    }
}

pub func PackageStatementFromTokenAndName(
    pkgTok: token.Token,
    nameTok: token.Token,
    nameValue: string,
) -> (PackageStatement) {
    return PackageStatement{
        Token: pkgTok,
        Name: Identifier{
            Token: nameTok,
            Value: nameValue,
        },
    }
}

pub func ImportStatementFromPathAlias(
    importTok: token.Token,
    path: string,
    aliasValue: string,
) -> (ImportStatement) {
    return ImportStatement{
        Token: importTok,
        Path:  path,
        Alias: aliasValue,
    }
}

pub func ImportBlockFromImports(
    importTok: token.Token,
    imports: Vec<ImportStatement, _>,
) -> (ImportBlock) {
    return ImportBlock{
        Token:   importTok,
        Imports: imports,
    }
}

pub func IdentifierFromTokenValue(tok: token.Token, value: string) -> (Identifier) {
    return Identifier{
        Token: tok,
        Value: value,
    }
}

pub func VarStatementFromParts(
    varTok: token.Token,
    name: Identifier,
    mutable: bool,
    varType: Option<TypeExpression>,
    value: Option<Expression>,
) -> (VarStatement) {
    return VarStatement{
        Token:   varTok,
        Name:    name,
        Type:    varType,
        Value:   value,
        Mutable: mutable,
    }
}

pub func VarStatementFromPartsNoValue(
    varTok: token.Token,
    name: Identifier,
    mutable: bool,
    varType: Option<TypeExpression>,
) -> (VarStatement) {
    return VarStatementFromParts(
        varTok,
        name,
        mutable,
        varType,
        None,
    )
}

pub func VarStatementFromPartsWithValue(
    varTok: token.Token,
    name: Identifier,
    mutable: bool,
    varType: Option<TypeExpression>,
    valueExpr: Expression,
) -> (VarStatement) {
    return VarStatementFromParts(
        varTok,
        name,
        mutable,
        varType,
        Some(valueExpr),
    )
}

pub func StatementVarFromParts(
    varTok: token.Token,
    name: Identifier,
    mutable: bool,
    varType: Option<TypeExpression>,
    value: Option<Expression>,
) -> (Statement) {
    return Statement.Var(
        VarStatementFromParts(
            varTok,
            name,
            mutable,
            varType,
            value,
        ),
    )
}

pub func SomeStatement(stmt: Statement) -> (Option<Statement>) {
    return Some(stmt)
}

pub func MultiVarStatementFromParts(
    varTok: token.Token,
    names: Vec<Identifier, _>,
    types: Vec<Option<TypeExpression>, _>,
    mutable: bool,
    value: Option<Expression>,
) -> (MultiVarStatement) {
    return MultiVarStatement{
        Token:   varTok,
        Names:   names,
        Types:   types,
        Value:   value,
        Mutable: mutable,
    }
}

pub func ConstStatementFromParts(
    constTok: token.Token,
    name: Identifier,
    visibility: Visibility,
    constType: Option<TypeExpression>,
    value: Expression,
) -> (ConstStatement) {
    mut var out: ConstStatement = ConstStatement{
        Token:      constTok,
        Visibility: visibility,
        Name:       name,
        Type:       constType,
        Value:      value,
    }

    return out
}

pub func VarBlockFromVariables(
    blockTok: token.Token,
    variables: Vec<VarStatement, _>,
) -> (VarBlock) {
    return VarBlock{
        Token:     blockTok,
        Variables: variables,
    }
}

pub func ConstBlockFromConstants(
    blockTok: token.Token,
    constants: Vec<ConstStatement, _>,
) -> (ConstBlock) {
    return ConstBlock{
        Token:     blockTok,
        Constants: constants,
    }
}

pub func ReturnStatementFromParts(
    returnTok: token.Token,
    returnValue: Option<Expression>,
) -> (ReturnStatement) {
    return ReturnStatement{
        Token:       returnTok,
        ReturnValue: returnValue,
    }
}

pub func TupleExpressionFromElements(
    tupleTok: token.Token,
    elements: Vec<Expression, _>,
) -> (TupleExpression) {
    return TupleExpression{
        Token:    tupleTok,
        Elements: elements,
    }
}

pub func AssignmentStatementFromParts(
    assignTok: token.Token,
    left: Expression,
    value: Expression,
) -> (AssignmentStatement) {
    var targetName: string = assignmentTargetName(
        &left,
    )
    mut var valueKind: int = 0
    mut var valueInt: int = 0
    mut var valueFloat: float64 = 0.0
    mut var valueBool: bool = false
    mut var valueChar: char = char(0)
    mut var valueText: string = ""
    mut var outTok: token.Token = assignTok

    switch value {
        case Expression.IntegerLiteral(il) {
            valueKind = 1
            valueInt = il.Value
        }
        case Expression.FloatLiteral(fl) {
            valueKind = 2
            valueFloat = fl.Value
        }
        case Expression.StringLiteral(sl) {
            valueKind = 3
            valueText = sl.Value
        }
        case Expression.BooleanLiteral(bl) {
            valueKind = 4
            valueBool = bl.Value
            if bl.Value {
                valueInt = 1
            } else {
                valueInt = 0
            }
        }
        case Expression.CharLiteral(cl) {
            valueKind = 5
            valueChar = cl.Value
            valueInt = int(cl.Value)
        }
        case Expression.Identifier(id) {
            valueKind = 6
            valueText = id.Value
        }
        case Expression.MutableIdentifier(idm) {
            valueKind = 6
            valueText = idm.Value
        }
        case Expression.Borrow(be) {
            switch be.Value {
                case Expression.Identifier(id2) {
                    valueKind = 7
                    valueText = id2.Value
                }
                case Expression.MutableIdentifier(idm2) {
                    valueKind = 7
                    valueText = idm2.Value
                }
                default {
                }
            }
        }
        case Expression.VoidLiteral(_) {
            valueKind = 8
            valueInt = 0
        }
        default {
        }
    }

    return AssignmentStatement{
        Token:      outTok,
        Left:       left,
        Value:      value,
        TargetName: targetName,
        ValueKind:  valueKind,
        ValueInt:   valueInt,
        ValueFloat: valueFloat,
        ValueBool:  valueBool,
        ValueChar:  valueChar,
        ValueText:  valueText,
    }
}

func assignmentTargetName(left: &Expression) -> (string) {
    switch *left {
        case Expression.Identifier(id) {
            return id.Value
        }
        case Expression.MutableIdentifier(idm) {
            return idm.Value
        }
        default {
            return ""
        }
    }
}

const ASSIGN_VALUE_HINT_NONE: int = 0
const ASSIGN_VALUE_HINT_INT: int = 1
const ASSIGN_VALUE_HINT_FLOAT: int = 2
const ASSIGN_VALUE_HINT_STRING: int = 3
const ASSIGN_VALUE_HINT_BOOL: int = 4
const ASSIGN_VALUE_HINT_CHAR: int = 5
const ASSIGN_VALUE_HINT_IDENT: int = 6
const ASSIGN_VALUE_HINT_BORROW_IDENT: int = 7
const ASSIGN_VALUE_HINT_VOID: int = 8

func emptyAssignmentValueHint() -> (AssignmentValueHint) {
    return AssignmentValueHint{
        Kind:       ASSIGN_VALUE_HINT_NONE,
        IntValue:   0,
        FloatValue: 0.0,
        BoolValue:  false,
        CharValue:  char(0),
        TextValue:  "",
    }
}

func assignmentValueHint(value: &Expression) -> (AssignmentValueHint) {
    switch *value {
        case Expression.IntegerLiteral(il) {
            return AssignmentValueHint{
                Kind:       ASSIGN_VALUE_HINT_INT,
                IntValue:   il.Value,
                FloatValue: 0.0,
                BoolValue:  false,
                CharValue:  char(0),
                TextValue:  "",
            }
        }
        case Expression.FloatLiteral(fl) {
            return AssignmentValueHint{
                Kind:       ASSIGN_VALUE_HINT_FLOAT,
                IntValue:   0,
                FloatValue: fl.Value,
                BoolValue:  false,
                CharValue:  char(0),
                TextValue:  "",
            }
        }
        case Expression.StringLiteral(sl) {
            return AssignmentValueHint{
                Kind:       ASSIGN_VALUE_HINT_STRING,
                IntValue:   0,
                FloatValue: 0.0,
                BoolValue:  false,
                CharValue:  char(0),
                TextValue:  sl.Value,
            }
        }
        case Expression.BooleanLiteral(bl) {
            return AssignmentValueHint{
                Kind:       ASSIGN_VALUE_HINT_BOOL,
                IntValue:   0,
                FloatValue: 0.0,
                BoolValue:  bl.Value,
                CharValue:  char(0),
                TextValue:  "",
            }
        }
        case Expression.CharLiteral(cl) {
            return AssignmentValueHint{
                Kind:       ASSIGN_VALUE_HINT_CHAR,
                IntValue:   0,
                FloatValue: 0.0,
                BoolValue:  false,
                CharValue:  cl.Value,
                TextValue:  "",
            }
        }
        case Expression.Identifier(id) {
            return AssignmentValueHint{
                Kind:       ASSIGN_VALUE_HINT_IDENT,
                IntValue:   0,
                FloatValue: 0.0,
                BoolValue:  false,
                CharValue:  char(0),
                TextValue:  id.Value,
            }
        }
        case Expression.MutableIdentifier(idm) {
            return AssignmentValueHint{
                Kind:       ASSIGN_VALUE_HINT_IDENT,
                IntValue:   0,
                FloatValue: 0.0,
                BoolValue:  false,
                CharValue:  char(0),
                TextValue:  idm.Value,
            }
        }
        case Expression.Borrow(be) {
            switch be.Value {
                case Expression.Identifier(id2) {
                    return AssignmentValueHint{
                        Kind:       ASSIGN_VALUE_HINT_BORROW_IDENT,
                        IntValue:   0,
                        FloatValue: 0.0,
                        BoolValue:  false,
                        CharValue:  char(0),
                        TextValue:  id2.Value,
                    }
                }
                case Expression.MutableIdentifier(idm2) {
                    return AssignmentValueHint{
                        Kind:       ASSIGN_VALUE_HINT_BORROW_IDENT,
                        IntValue:   0,
                        FloatValue: 0.0,
                        BoolValue:  false,
                        CharValue:  char(0),
                        TextValue:  idm2.Value,
                    }
                }
                default {
                }
            }
        }
        case Expression.VoidLiteral(_) {
            return AssignmentValueHint{
                Kind:       ASSIGN_VALUE_HINT_VOID,
                IntValue:   0,
                FloatValue: 0.0,
                BoolValue:  false,
                CharValue:  char(0),
                TextValue:  "",
            }
        }
        default {
        }
    }

    return emptyAssignmentValueHint()
}

pub func ExpressionStatementFromExpression(
    exprTok: token.Token,
    expression: Expression,
) -> (ExpressionStatement) {
    mut var out: ExpressionStatement = ExpressionStatement{
        Token:      exprTok,
        Expression: expression,
    }

    return out
}

pub func BlockStatementFromStatements(
    blockTok: token.Token,
    statements: Vec<Statement, _>,
) -> (BlockStatement) {
    return BlockStatement{
        Token:      blockTok,
        Statements: statements,
    }
}

pub func IfStatementFromParts(
    ifTok: token.Token,
