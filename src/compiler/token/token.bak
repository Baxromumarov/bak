// Token definitions for bakc.
package token

// Keep token types as explicit integer tags for bootstrap stability.
pub type TokenType = int

pub const ILLEGAL: int = 0
pub const EOF: int = 1
pub const IDENT: int = 2
pub const INT: int = 3
pub const FLOAT: int = 4
pub const STRING: int = 5
pub const CHAR: int = 6
pub const ASSIGN: int = 7
pub const PLUS: int = 8
pub const MINUS: int = 9
pub const BANG: int = 10
pub const ASTERISK: int = 11
pub const SLASH: int = 12
pub const PERCENT: int = 13
pub const LT: int = 14
pub const GT: int = 15
pub const EQ: int = 16
pub const NOT_EQ: int = 17
pub const LT_EQ: int = 18
pub const GT_EQ: int = 19
pub const AND: int = 20
pub const OR: int = 21
pub const BITAND: int = 22
pub const BITOR: int = 23
pub const BITXOR: int = 24
pub const BITNOT: int = 25
pub const LSHIFT: int = 26
pub const RSHIFT: int = 27
pub const COMMA: int = 28
pub const SEMICOLON: int = 29
pub const COLON: int = 30
pub const DOT: int = 31
pub const DOTDOT: int = 32
pub const ARROW: int = 33
pub const LPAREN: int = 34
pub const RPAREN: int = 35
pub const LBRACE: int = 36
pub const RBRACE: int = 37
pub const LBRACKET: int = 38
pub const RBRACKET: int = 39
pub const PACKAGE: int = 40
pub const VAR: int = 41
pub const CONST: int = 42
pub const MUT: int = 43
pub const FUNC: int = 44
pub const RETURN: int = 45
pub const STRUCT: int = 46
pub const ENUM: int = 47
pub const IMPL: int = 48
pub const IF: int = 49
pub const ELSE: int = 50
pub const WHILE: int = 51
pub const FOR: int = 52
pub const IN: int = 53
pub const SWITCH: int = 54
pub const CASE: int = 55
pub const DEFAULT: int = 56
pub const IMPORT: int = 57
pub const UNSAFE: int = 58
pub const DEFER: int = 59
pub const PANIC: int = 60
pub const VOID: int = 61
pub const AS: int = 62
pub const BREAK: int = 63
pub const CONTINUE: int = 64
pub const TYPE: int = 65
pub const ALIAS: int = 66
pub const TRUE: int = 67
pub const FALSE: int = 68
pub const PUB: int = 69
pub const TYPE_BOOL: int = 70
pub const TYPE_INT: int = 71
pub const TYPE_INT8: int = 72
pub const TYPE_INT16: int = 73
pub const TYPE_INT32: int = 74
pub const TYPE_INT64: int = 75
pub const TYPE_UINT: int = 76
pub const TYPE_UINT8: int = 77
pub const TYPE_UINT16: int = 78
pub const TYPE_UINT32: int = 79
pub const TYPE_UINT64: int = 80
pub const TYPE_FLOAT32: int = 81
pub const TYPE_FLOAT64: int = 82
pub const TYPE_CHAR: int = 83
pub const TYPE_STRING: int = 84
pub const TYPE_VOID: int = 85
pub const VEC: int = 86
pub const RESULT: int = 87
pub const OPTION: int = 88
pub const OK: int = 89
pub const ERR: int = 90
pub const SOME: int = 91
pub const NONE: int = 92
pub const AMPERSAND: int = 93
pub const UNDERSCORE: int = 94
pub const QUESTION: int = 95
pub const BOX: int = 96


pub struct Token {
    pub Type: int
    pub Literal: string
    pub Line: int
    pub Column: int
}

pub func TypeEq(a: int, b: int) -> (bool) {
    return a == b
}

func typeEqRef(a: &int, b: int) -> (bool) {
    return TypeEq(*a, b)
}

pub func MakeToken(tokenType: int, literal: string, line: int, column: int) -> (Token) {
    mut var out: Token = Token{
        Type: tokenType,
        Literal: literal,
        Line: line,
        Column: column,
    }

    return out
}

pub func SetToken(
    mut out: &mut Token,
    tokenType: int,
    literal: string,
    line: int,
    column: int,
) -> (void) {
    out.Type = tokenType
    out.Literal = literal
    out.Line = line
    out.Column = column

    return
}

pub func TokenTypeString(t: int) -> (string) {
    if TypeEq(
        t,
        ILLEGAL,
    ) {
        return "ILLEGAL"
    }

    if TypeEq(
        t,
        EOF,
    ) {
        return "EOF"
    }

    if TypeEq(
        t,
        IDENT,
    ) {
        return "IDENT"
    }

    if TypeEq(
        t,
        INT,
    ) {
        return "INT"
    }

    if TypeEq(
        t,
        STRING,
    ) {
        return "STRING"
    }

    return "TOKEN"
}

pub func LookupIdent(ident: string) -> (int) {
    if ident == "package" { return PACKAGE }
    if ident == "var" { return VAR }
    if ident == "const" { return CONST }
    if ident == "mut" { return MUT }
    if ident == "func" { return FUNC }
    if ident == "return" { return RETURN }
    if ident == "struct" { return STRUCT }
    if ident == "enum" { return ENUM }
    if ident == "impl" { return IMPL }
    if ident == "if" { return IF }
    if ident == "else" { return ELSE }
    if ident == "while" { return WHILE }
    if ident == "for" { return FOR }
    if ident == "in" { return IN }
    if ident == "switch" { return SWITCH }
    if ident == "case" { return CASE }
    if ident == "default" { return DEFAULT }
    if ident == "import" { return IMPORT }
    if ident == "unsafe" { return UNSAFE }
    if ident == "defer" { return DEFER }
    if ident == "panic" { return PANIC }
    if ident == "void" { return VOID }
    if ident == "as" { return AS }
    if ident == "break" { return BREAK }
    if ident == "continue" { return CONTINUE }
    if ident == "type" { return TYPE }
    if ident == "alias" { return ALIAS }
    if ident == "true" { return TRUE }
    if ident == "false" { return FALSE }
    if ident == "pub" { return PUB }
    if ident == "bool" { return TYPE_BOOL }
    if ident == "int" { return TYPE_INT }
    if ident == "int8" { return TYPE_INT8 }
    if ident == "int16" { return TYPE_INT16 }
    if ident == "int32" { return TYPE_INT32 }
    if ident == "int64" { return TYPE_INT64 }
    if ident == "uint" { return TYPE_UINT }
    if ident == "uint8" { return TYPE_UINT8 }
    if ident == "uint16" { return TYPE_UINT16 }
    if ident == "uint32" { return TYPE_UINT32 }
    if ident == "uint64" { return TYPE_UINT64 }
    if ident == "float32" { return TYPE_FLOAT32 }
    if ident == "float64" { return TYPE_FLOAT64 }
    if ident == "char" { return TYPE_CHAR }
    if ident == "string" { return TYPE_STRING }
    if ident == "Vec" { return VEC }
    if ident == "Result" { return RESULT }
    if ident == "Option" { return OPTION }
    if ident == "Ok" { return OK }
    if ident == "Err" { return ERR }
    if ident == "Some" { return SOME }
    if ident == "None" { return NONE }
    if ident == "box" { return BOX }
    return IDENT
}

pub func IsKeywordRef(t: &int) -> (bool) {
    return IsKeyword(*t)
}

pub func IsKeyword(t: int) -> (bool) {
    if t >= PACKAGE && t <= CONTINUE {
        return true
    }

    if TypeEq(
        t,
        TRUE,
    ) {
        return true
    }

    if TypeEq(
        t,
        FALSE,
    ) {
        return true
    }

    return false
}

pub func IsTypeRef(t: &int) -> (bool) {
    return IsType(*t)
}

pub func IsType(t: int) -> (bool) {
    if t >= TYPE_BOOL && t <= OPTION {
        return true
    }

    return false
}
