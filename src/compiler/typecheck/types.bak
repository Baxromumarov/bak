package typecheck

import "src/compiler/ast/ast.bak" as ast

pub struct FunctionSig {
    pub Params: Vec<ast.TypeExpression, _>
    pub ReturnType: ast.TypeExpression
}

pub struct FunctionInfo {
    pub Name: string
    pub Sig: FunctionSig
    pub Visibility: ast.Visibility
    pub Mutable: bool
}

pub struct StructFieldInfo {
    pub Name: string
    pub Type: ast.TypeExpression
    pub Visibility: ast.Visibility
}

pub struct StructInfo {
    pub Name: string
    pub Fields: Vec<StructFieldInfo, _>
    pub Methods: Vec<FunctionInfo, _>
    pub Visibility: ast.Visibility
}

pub struct EnumVariantInfo {
    pub Name: string
    pub Fields: Vec<ast.TypeExpression, _>
}

pub struct EnumInfo {
    pub Name: string
    pub Variants: Vec<EnumVariantInfo, _>
    pub Visibility: ast.Visibility
}

pub struct AliasInfo {
    pub Name: string
    pub Underlying: ast.TypeExpression
    pub Visibility: ast.Visibility
}

pub struct TypeDefInfo {
    pub Name: string
    pub Underlying: ast.TypeExpression
    pub Visibility: ast.Visibility
}

pub struct ConstInfo {
    pub Name: string
    pub Type: ast.TypeExpression
    pub Visibility: ast.Visibility
}

pub struct ModuleExports {
    pub Functions: Vec<FunctionInfo, _>
    pub Structs: Vec<StructInfo, _>
    pub Enums: Vec<EnumInfo, _>
    pub Aliases: Vec<AliasInfo, _>
    pub Types: Vec<TypeDefInfo, _>
    pub Consts: Vec<ConstInfo, _>
}

pub struct ImportBinding {
    pub Alias: string
    pub ModuleName: string
    pub Module: ModuleExports
}

pub func NewImportBinding(aliasName: string, moduleName: string, module: ModuleExports) -> (ImportBinding) {
    return ImportBinding{
        Alias: aliasName,
        ModuleName: moduleName,
        Module: module,
    }
}
