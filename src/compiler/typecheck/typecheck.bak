package typecheck

import "src/compiler/ast/ast.bak" as ast
import "src/compiler/diagnostics/diagnostics.bak" as diag
import "src/compiler/token/token.bak" as token
import "src/compiler/typecheck/environment.bak" as env
import "src/compiler/typecheck/types.bak" as types
import "src/std/strings/strings.bak" as strings

pub struct EnumVariantBinding {
    Variant:  string
    EnumName: string
}

pub struct TypeChecker {
    file:              string
    env:               env.Environment box
    emitter:           diag.DiagnosticEmitter
    functions:         Vec<types.FunctionInfo, _>
    structs:           Vec<types.StructInfo, _>
    enums:             Vec<types.EnumInfo, _>
    aliases:           Vec<types.AliasInfo, _>
    typedefs:          Vec<types.TypeDefInfo, _>
    consts:            Vec<types.ConstInfo, _>
    typeNames:         Vec<string, _>
    enumVariants:      Vec<EnumVariantBinding, _>
    builtinNames:      Vec<string, _>
    imports:           Vec<types.ImportBinding, _>
    currentReturn:     Option<ast.TypeExpression>
    processingBorrows: Vec<string, _>
    pub suppressEmits: bool
    isTestMode:        bool
}

// Cache of type names (struct/enum/alias/typedef) to avoid copying large
// `types.*Info` values during isTypeName checks in bootstrap.
// Cache of enum variant -> enum name bindings to avoid scanning `tc.enums`
// (EnumInfo contains Vecs and has triggered crashes when copied/indexed).
pub func New(
    file: string,
    imports: Vec<types.ImportBinding, _>,
) -> (TypeChecker) {
    mut var tc: TypeChecker = TypeChecker{
        aliases:           Vec.new(),
        builtinNames:      Vec.new(),
        consts:            Vec.new(),
        currentReturn:     None,
        emitter:           diag.NewEmitter(file),
        enumVariants:      Vec.new(),
        enums:             Vec.new(),
        env:               Box.new(env.NewEnv()),
        file:              file,
        functions:         Vec.new(),
        imports:           imports,
        isTestMode:        false,
        processingBorrows: Vec.new(),
        structs:           Vec.new(),
        suppressEmits:     false,
        typeNames:         Vec.new(),
        typedefs:          Vec.new(),
    }

    if false {
        // Register builtins (inlined to ensure Vec persistence)
        // println/print are variadic
        tc.functions.push(
            types.FunctionInfo{
                Mutable:    false,
                Name:       "print",
                Sig:        types.FunctionSig{
                    Params:     Vec.new(),
                    ReturnType: ast.TypeExpression.Void(
                        ast.VoidType{
                            Token: tokenNil(),
                        },
                    ),
                },
                Visibility: ast.Visibility.Public,
            },
        )
        tc.builtinNames.push("print")
        tc.functions.push(
            types.FunctionInfo{
                Mutable:    false,
                Name:       "println",
                Sig:        types.FunctionSig{
                    Params:     Vec.new(),
                    ReturnType: ast.TypeExpression.Void(
                        ast.VoidType{
                            Token: tokenNil(),
                        },
                    ),
                },
                Visibility: ast.Visibility.Public,
            },
        )
        tc.builtinNames.push("println")
        // Also recognize runtime-prefixed builtin names
        tc.builtinNames.push("__builtin_print")
        tc.builtinNames.push("__builtin_println")
        tc.builtinNames.push("__builtin_eprint")
        tc.builtinNames.push("__builtin_eprintln")

        // __builtin_args() -> Vec<string, _>
        mut var vecParams: Vec<ast.TypeExpression, _> = Vec.new()

        vecParams.push(
            ast.TypeExpression.Simple(
                ast.SimpleType{
                    Name:  "string",
                    Token: tokenNil(),
                },
            ),
        )
        vecParams.push(
            ast.TypeExpression.Simple(
                ast.SimpleType{
                    Name:  "_",
                    Token: tokenNil(),
                },
            ),
        )
        tc.functions.push(
            types.FunctionInfo{
                Mutable:    false,
                Name:       "__builtin_args",
                Sig:        types.FunctionSig{
                    Params:     Vec.new(),
                    ReturnType: ast.TypeExpression.Generic(
                        ast.GenericType{
                            Name:       "Vec",
                            Token:      tokenNil(),
                            TypeParams: vecParams,
                        },
                    ),
                },
                Visibility: ast.Visibility.Public,
            },
        )
        tc.builtinNames.push("__builtin_args")

        // __builtin_read_file(path string) -> Result<string, string>
        mut var resParams: Vec<ast.TypeExpression, _> = Vec.new()

        resParams.push(
            ast.TypeExpression.Simple(
                ast.SimpleType{
                    Name:  "string",
                    Token: tokenNil(),
                },
            ),
        )
        resParams.push(
            ast.TypeExpression.Simple(
                ast.SimpleType{
                    Name:  "string",
                    Token: tokenNil(),
                },
            ),
        )

        mut var readParams: Vec<ast.TypeExpression, _> = Vec.new()

        readParams.push(
            ast.TypeExpression.Simple(
                ast.SimpleType{
                    Name:  "string",
                    Token: tokenNil(),
                },
            ),
        )
        tc.functions.push(
            types.FunctionInfo{
                Mutable:    false,
                Name:       "__builtin_read_file",
                Sig:        types.FunctionSig{
                    Params:     readParams,
                    ReturnType: ast.TypeExpression.Generic(
                        ast.GenericType{
                            Name:       "Result",
                            Token:      tokenNil(),
                            TypeParams: resParams,
                        },
                    ),
                },
                Visibility: ast.Visibility.Public,
            },
        )
        tc.builtinNames.push("__builtin_read_file")

        // __builtin_read_file_bytes(path string) -> Result<Vec<int,_>, string>
        mut var vecIntParams2: Vec<ast.TypeExpression, _> = Vec.new()

        vecIntParams2.push(
            ast.TypeExpression.Simple(
                ast.SimpleType{
                    Name:  "int",
                    Token: tokenNil(),
                },
            ),
        )
        vecIntParams2.push(
            ast.TypeExpression.Simple(
                ast.SimpleType{
                    Name:  "_",
                    Token: tokenNil(),
                },
            ),
        )

        mut var vecIntType: ast.TypeExpression = ast.TypeExpression.Generic(
            ast.GenericType{
                Name:       "Vec",
                Token:      tokenNil(),
                TypeParams: vecIntParams2,
            },
        )
        mut var resParamsBytes: Vec<ast.TypeExpression, _> = Vec.new()

        resParamsBytes.push(vecIntType)
        resParamsBytes.push(
            ast.TypeExpression.Simple(
                ast.SimpleType{
                    Name:  "string",
                    Token: tokenNil(),
                },
            ),
        )

        mut var readBytesParams: Vec<ast.TypeExpression, _> = Vec.new()

        readBytesParams.push(
            ast.TypeExpression.Simple(
                ast.SimpleType{
                    Name:  "string",
                    Token: tokenNil(),
                },
            ),
        )
        tc.functions.push(
            types.FunctionInfo{
                Mutable:    false,
                Name:       "__builtin_read_file_bytes",
                Sig:        types.FunctionSig{
                    Params:     readBytesParams,
                    ReturnType: ast.TypeExpression.Generic(
                        ast.GenericType{
                            Name:       "Result",
                            Token:      tokenNil(),
                            TypeParams: resParamsBytes,
                        },
                    ),
                },
                Visibility: ast.Visibility.Public,
            },
        )
        tc.builtinNames.push("__builtin_read_file_bytes")

        // __builtin_write_file_bytes(path string, data Vec<int,_>) -> Result<void, string>
        mut var writeBytesParams: Vec<ast.TypeExpression, _> = Vec.new()

        writeBytesParams.push(
            ast.TypeExpression.Simple(
                ast.SimpleType{
                    Name:  "string",
                    Token: tokenNil(),
                },
            ),
        )
        writeBytesParams.push(
            ast.TypeExpression.Generic(
                ast.GenericType{
                    Name:       "Vec",
                    Token:      tokenNil(),
                    TypeParams: vecIntParams2,
                },
            ),
        )

        mut var resVoidParams: Vec<ast.TypeExpression, _> = Vec.new()

        resVoidParams.push(
            ast.TypeExpression.Void(
                ast.VoidType{
                    Token: tokenNil(),
                },
            ),
        )
        resVoidParams.push(
            ast.TypeExpression.Simple(
                ast.SimpleType{
                    Name:  "string",
                    Token: tokenNil(),
                },
            ),
        )
        tc.functions.push(
            types.FunctionInfo{
                Mutable:    false,
                Name:       "__builtin_write_file_bytes",
                Sig:        types.FunctionSig{
                    Params:     writeBytesParams,
                    ReturnType: ast.TypeExpression.Generic(
                        ast.GenericType{
                            Name:       "Result",
                            Token:      tokenNil(),
                            TypeParams: resVoidParams,
                        },
                    ),
                },
                Visibility: ast.Visibility.Public,
            },
        )
        tc.builtinNames.push("__builtin_write_file_bytes")

        // __builtin_executable() -> Result<string, string>
        mut var execResParams: Vec<ast.TypeExpression, _> = Vec.new()

        execResParams.push(
            ast.TypeExpression.Simple(
                ast.SimpleType{
                    Name:  "string",
                    Token: tokenNil(),
                },
            ),
        )
        execResParams.push(
            ast.TypeExpression.Simple(
                ast.SimpleType{
                    Name:  "string",
                    Token: tokenNil(),
                },
            ),
        )
        tc.functions.push(
            types.FunctionInfo{
                Mutable:    false,
                Name:       "__builtin_executable",
                Sig:        types.FunctionSig{
                    Params:     Vec.new(),
                    ReturnType: ast.TypeExpression.Generic(
                        ast.GenericType{
                            Name:       "Result",
                            Token:      tokenNil(),
                            TypeParams: execResParams,
                        },
                    ),
                },
                Visibility: ast.Visibility.Public,
            },
        )
        tc.builtinNames.push("__builtin_executable")

        // __builtin_string_from_bytes
        mut var bytesParams: Vec<ast.TypeExpression, _> = Vec.new()
        mut var vecIntParams: Vec<ast.TypeExpression, _> = Vec.new()

        vecIntParams.push(
            ast.TypeExpression.Simple(
                ast.SimpleType{
                    Name:  "int",
                    Token: tokenNil(),
                },
            ),
        )
        vecIntParams.push(
            ast.TypeExpression.Simple(
                ast.SimpleType{
                    Name:  "_",
                    Token: tokenNil(),
                },
            ),
        )
        bytesParams.push(
            ast.TypeExpression.Generic(
                ast.GenericType{
                    Name:       "Vec",
                    Token:      tokenNil(),
                    TypeParams: vecIntParams,
                },
            ),
        )
        bytesParams.push(
            ast.TypeExpression.Simple(
                ast.SimpleType{
                    Name:  "int",
                    Token: tokenNil(),
                },
            ),
        )
        bytesParams.push(
            ast.TypeExpression.Simple(
                ast.SimpleType{
                    Name:  "int",
                    Token: tokenNil(),
                },
            ),
        )
        tc.functions.push(
            types.FunctionInfo{
                Mutable:    false,
                Name:       "__builtin_string_from_bytes",
                Sig:        types.FunctionSig{
                    Params:     bytesParams,
                    ReturnType: ast.TypeExpression.Simple(
                        ast.SimpleType{
                            Name:  "string",
                            Token: tokenNil(),
                        },
                    ),
                },
                Visibility: ast.Visibility.Public,
            },
        )
        tc.builtinNames.push("__builtin_string_from_bytes")

        mut var extra: Vec<string, _> = Vec.new()

        extra.push("len")
        extra.push("push")
        extra.push("pop")
        extra.push("first")
        extra.push("last")
        extra.push("rest")
        extra.push("type")
        extra.push("int")
        extra.push("float")
        extra.push("string")
        extra.push("char")
        extra.push("Box")
        extra.push("unbox")
        extra.push("is_some")
        extra.push("is_none")
        extra.push("unwrap")
        extra.push("is_ok")
        extra.push("is_err")
        extra.push("unwrap_err")
        extra.push("__builtin_write_file")
        extra.push("__builtin_append_file")
        extra.push("__builtin_file_exists")
        extra.push("__builtin_is_file")
        extra.push("__builtin_is_dir")
        extra.push("__builtin_remove")
        extra.push("__builtin_mkdir")
        extra.push("__builtin_read_dir")
        extra.push("__builtin_read_file_bytes")
        extra.push("__builtin_write_file_bytes")
        extra.push("__builtin_exec")
        extra.push("__builtin_hostname")
        extra.push("__builtin_temp_dir")
        extra.push("__builtin_user_home_dir")
        extra.push("__builtin_spawn")
        extra.push("__builtin_join")
        extra.push("__builtin_sleep")
        extra.push("__builtin_thread_id")
        extra.push("__builtin_time_now")
        extra.push("__builtin_monotonic_now")
        extra.push("__builtin_cancel_new")
        extra.push("__builtin_cancel")
        extra.push("__builtin_is_cancelled")

        for n in extra {
            tc.builtinNames.push(n)
        }

        // Add signatures for some builtins to avoid "undefined function" during typecheck
        tc.functions.push(
            types.FunctionInfo{
                Mutable:    false,
                Name:       "__builtin_time_now",
                Sig:        types.FunctionSig{
                    Params:     Vec.new(),
                    ReturnType: ast.TypeExpression.Simple(
                        ast.SimpleType{
                            Name:  "int",
                            Token: tokenNil(),
                        },
                    ),
                },
                Visibility: ast.Visibility.Public,
            },
        )
        tc.functions.push(
            types.FunctionInfo{
                Mutable:    false,
                Name:       "__builtin_monotonic_now",
                Sig:        types.FunctionSig{
                    Params:     Vec.new(),
                    ReturnType: ast.TypeExpression.Simple(
                        ast.SimpleType{
                            Name:  "int",
                            Token: tokenNil(),
                        },
                    ),
                },
                Visibility: ast.Visibility.Public,
            },
        )

        mut var sleepParams: Vec<ast.TypeExpression, _> = Vec.new()

        sleepParams.push(
            ast.TypeExpression.Simple(
                ast.SimpleType{
                    Name:  "int",
                    Token: tokenNil(),
                },
            ),
        )

        // Return Result<void, string> for sleep to match Go implementation
        mut var voidResParams: Vec<ast.TypeExpression, _> = Vec.new()

        voidResParams.push(
            ast.TypeExpression.Void(
                ast.VoidType{
                    Token: tokenNil(),
                },
            ),
        )
        voidResParams.push(
            ast.TypeExpression.Simple(
                ast.SimpleType{
                    Name:  "string",
                    Token: tokenNil(),
                },
            ),
        )
        tc.functions.push(
            types.FunctionInfo{
                Mutable:    false,
                Name:       "__builtin_sleep",
                Sig:        types.FunctionSig{
                    Params:     sleepParams,
                    ReturnType: ast.TypeExpression.Generic(
                        ast.GenericType{
                            Name:       "Result",
                            Token:      tokenNil(),
                            TypeParams: voidResParams,
                        },
                    ),
                },
                Visibility: ast.Visibility.Public,
            },
        )
        tc.functions.push(
            types.FunctionInfo{
                Mutable:    false,
                Name:       "__builtin_thread_id",
                Sig:        types.FunctionSig{
                    Params:     Vec.new(),
                    ReturnType: ast.TypeExpression.Simple(
                        ast.SimpleType{
                            Name:  "int",
                            Token: tokenNil(),
                        },
                    ),
                },
                Visibility: ast.Visibility.Public,
            },
        )

        mut var joinParams: Vec<ast.TypeExpression, _> = Vec.new()

        joinParams.push(
            ast.TypeExpression.Simple(
                ast.SimpleType{
                    Name:  "thread.Thread",
                    Token: tokenNil(),
                },
            ),
        )
        tc.functions.push(
            types.FunctionInfo{
                Mutable:    false,
                Name:       "__builtin_join",
                Sig:        types.FunctionSig{
                    Params:     joinParams,
                    ReturnType: ast.TypeExpression.Void(
                        ast.VoidType{
                            Token: tokenNil(),
                        },
                    ),
                },
                Visibility: ast.Visibility.Public,
            },
        )
        tc.functions.push(
            types.FunctionInfo{
                Mutable:    false,
                Name:       "__builtin_cancel_new",
                Sig:        types.FunctionSig{
                    Params:     Vec.new(),
                    ReturnType: ast.TypeExpression.Simple(
                        ast.SimpleType{
                            Name:  "int",
                            Token: tokenNil(),
                        },
                    ),
                },
                Visibility: ast.Visibility.Public,
            },
        )

        mut var cancelParams: Vec<ast.TypeExpression, _> = Vec.new()

        cancelParams.push(
            ast.TypeExpression.Simple(
                ast.SimpleType{
                    Name:  "int",
                    Token: tokenNil(),
                },
            ),
        )
        tc.functions.push(
            types.FunctionInfo{
                Mutable:    false,
                Name:       "__builtin_cancel",
                Sig:        types.FunctionSig{
                    Params:     cancelParams,
                    ReturnType: ast.TypeExpression.Void(
                        ast.VoidType{
                            Token: tokenNil(),
                        },
                    ),
                },
                Visibility: ast.Visibility.Public,
            },
        )
        tc.functions.push(
            types.FunctionInfo{
                Mutable:    false,
                Name:       "__builtin_is_cancelled",
                Sig:        types.FunctionSig{
                    Params:     cancelParams,
                    ReturnType: ast.TypeExpression.Simple(
                        ast.SimpleType{
                            Name:  "bool",
                            Token: tokenNil(),
                        },
                    ),
                },
                Visibility: ast.Visibility.Public,
            },
        )
    }

    return tc
}

impl TypeChecker as tc {
    pub mut func Check(program: &ast.Program) -> (diag.DiagnosticEmitter) {
        tc.collectDefinitions(program)

        // Bootstrap safeguard: when diagnostics are suppressed, we also skip the
        // second pass statement-by-statement typechecking. This avoids unstable
        // AST copying behavior in the stage2 native backend while still producing
        // module exports for imports.
        if tc.suppressEmits {

            return tc.emitter
        }

        mut var i: int = 0

        while i < program.Statements.len() {
            tc.checkStatement(&program.Statements[i])
            i = i + 1
        }


        return tc.emitter
    }

    pub mut func SetTestMode(enabled: bool) -> (void) {
        tc.isTestMode = enabled

        return
    }

    mut func emit(d: diag.Diagnostic) -> (void) {
        if tc.suppressEmits {
            return
        }

        tc.emitter.emit(d)
    }

    mut func reportError(tok: token.Token, msg: string) -> (void) {
        tc.emit(
            diag.SimpleError(
                diag.ErrArgumentCount,
                msg,
                tok.Line,
                tok.Column,
            ),
        )
    }

    pub mut func Exports() -> (types.ModuleExports) {
        mut var out: types.ModuleExports = types.ModuleExports{
            Aliases:   Vec.new(),
            Consts:    Vec.new(),
            Enums:     Vec.new(),
            Functions: Vec.new(),
            Structs:   Vec.new(),
            Types:     Vec.new(),
        }

        for f in tc.functions {
            if f.Visibility == ast.Visibility.Public {
                out.Functions.push(f)
            }
        }

        for s in tc.structs {
            if s.Visibility == ast.Visibility.Public {
                out.Structs.push(s)
            }
        }

        for e in tc.enums {
            if e.Visibility == ast.Visibility.Public {
                out.Enums.push(e)
            }
        }

        for a in tc.aliases {
            if a.Visibility == ast.Visibility.Public {
                out.Aliases.push(a)
            }
        }

        for t in tc.typedefs {
            if t.Visibility == ast.Visibility.Public {
                out.Types.push(t)
            }
        }

        for c in tc.consts {
            if c.Visibility == ast.Visibility.Public {
                out.Consts.push(c)
            }
        }

        return out
    }

    mut func collectDefinitions(program: &ast.Program) -> (void) {
        var dbg: bool = tc.file.contains("src/compiler/token/token.bak") || tc.file.contains("src/compiler/ast/ast.bak") || tc.file.contains("src/compiler/lexer/lexer.bak") || tc.file.contains("src/compiler/diagnostics/diagnostics.bak")
        mut var i: int = 0

        while i < program.Statements.len() {
            if dbg {
            }

            var stmt: &ast.Statement = &program.Statements[i]

            switch *stmt {
                case ast.Statement.StructDecl(sd) {
                    if dbg {
                        println("tc(ast): collectDefinitions StructDecl " + sd.Name.Value)
                    }

                    mut var fields: Vec<types.StructFieldInfo, _> = Vec.new()

                    // Avoid indexing+borrowing of AST Vec elements here; it has produced
                    // invalid reads during bootstrap. Iteration-by-value is more stable.
                    for f in sd.Fields {
                        // V1 Restrict: No borrows in structs
                        // Keep the declared type as-is during definition collection.
                        // Resolving here is copy-heavy and can trigger bootstrap crashes
                        // for nested generic types (e.g. Vec<Statement,_> in ast.Program).
                        var resolvedFieldType: ast.TypeExpression = f.Type

                        switch resolvedFieldType {
                            case ast.TypeExpression.BorrowRef(bt) {
                                tc.emit(
                                    diag.BorrowInStruct(
                                        f.Name.Value,
                                        tc.typeToString(resolvedFieldType),
                                        f.Token.Line,
                                        f.Token.Column,
                                    ),
                                )
                            }
                            default {
                            }
                        }

                        fields.push(
                            types.StructFieldInfo{
                                Name:       f.Name.Value,
                                Type:       resolvedFieldType,
                                Visibility: f.Visibility,
                            },
                        )
                    }

                    tc.structs.push(
                        types.StructInfo{
                            Fields:     fields,
                            Methods:    Vec.new(),
                            Name:       sd.Name.Value,
                            Visibility: sd.Visibility,
                        },
                    )
                    tc.typeNames.push(sd.Name.Value + "")
                }
                case ast.Statement.EnumDecl(ed) {
                    if dbg {
                        println("tc(ast): collectDefinitions EnumDecl " + ed.Name.Value)
                    }

                    mut var variants: Vec<types.EnumVariantInfo, _> = Vec.new()

                    // Avoid taking element borrows via indexing here; it has triggered
                    // invalid reads during bootstrap. Iteration-by-value is more stable.
                    for v in ed.Variants {
                        mut var vFields: Vec<ast.TypeExpression, _> = Vec.new()

                        for ft in v.Fields {
                            // Keep declared field types as-is; resolving here is copy-heavy.
                            vFields.push(ft)
                        }

                        variants.push(
                            types.EnumVariantInfo{
                                Fields: vFields,
                                Name:   v.Name.Value,
                            },
                        )
                        // Cache variant -> enum mapping for safe lookups during inference.
                        tc.enumVariants.push(
                            EnumVariantBinding{
                                EnumName: ed.Name.Value + "",
                                Variant:  v.Name.Value + "",
                            },
                        )
                    }

                    tc.enums.push(
                        types.EnumInfo{
                            Name:       ed.Name.Value,
                            Variants:   variants,
                            Visibility: ed.Visibility,
                        },
                    )
                    tc.typeNames.push(ed.Name.Value + "")
                }
                case ast.Statement.FunctionDecl(fd) {
                    if dbg {
                        println("tc(ast): collectDefinitions FunctionDecl " + fd.Name.Value)
                    }

                    mut var params: Vec<ast.TypeExpression, _> = Vec.new()

                    for p in fd.Parameters {
                        // Keep declared types as-is during definition collection.
                        // Resolving here requires copying TypeExpression and has triggered
                        // bootstrap crashes in stage2.
                        params.push(p.Type)
                    }

                    var retTypeResolved: ast.TypeExpression = fd.ReturnType

                    tc.functions.push(
                        types.FunctionInfo{
                            Mutable:    false,
                            Name:       fd.Name.Value,
                            Sig:        types.FunctionSig{
                                Params:     params,
                                ReturnType: retTypeResolved,
                            },
                            Visibility: fd.Visibility,
                        },
                    )
                }
                case ast.Statement.AliasDecl(ad) {
                    if dbg {
                        println("tc(ast): collectDefinitions AliasDecl " + ad.Name.Value)
                    }

                    tc.aliases.push(
                        types.AliasInfo{
                            Name:       ad.Name.Value,
                            Underlying: tc.resolveType(&ad.Underlying),
                            Visibility: ad.Visibility,
                        },
                    )
                    tc.typeNames.push(ad.Name.Value + "")
                }
                case ast.Statement.TypeDecl(td) {
                    if dbg {
                        println("tc(ast): collectDefinitions TypeDecl " + td.Name.Value)
                    }

                    tc.typedefs.push(
                        types.TypeDefInfo{
                            Name:       td.Name.Value,
                            Underlying: tc.resolveType(&td.Underlying),
                            Visibility: td.Visibility,
                        },
                    )
                    tc.typeNames.push(td.Name.Value + "")
                }
                case ast.Statement.Const(cs) {
                    if dbg {
                        println("tc(ast): collectDefinitions Const " + cs.Name.Value)
                    }

                    switch cs.Type {
                        case Some(t) {
                            // Keep the declared type as-is; resolving here is unnecessary and
                            // copy-heavy during bootstrap.
                            tc.consts.push(
                                types.ConstInfo{
                                    Name:       cs.Name.Value,
                                    Type:       t,
                                    Visibility: cs.Visibility,
                                },
                            )
                        }
                        case None {
                        }
                    }
                }
                case ast.Statement.ImplDecl(id) {
                    if dbg {
                        println("tc(ast): collectDefinitions ImplDecl " + id.TypeName.Value)
                    }

                    tc.registerImplMethods(id)
                }
                default {
                }
            }

            if dbg {
            }

            i = i + 1
        }

        return
    }

    mut func registerImplMethods(id: ast.ImplDecl) -> (void) {
        // Bootstrap safety: registering impl methods requires mutating nested Vecs
        // inside `tc.structs`, which is currently unstable under the stage2 native backend.
        // When diagnostics are suppressed (bootstrap), we skip method registration and
        // only export type names/fields collected from declarations.
        if tc.suppressEmits {
            return
        }

        var structIndex: int = tc.findStructIndex(id.TypeName.Value)

        if structIndex < 0 {
            tc.emit(
                diag.TypeMismatch(
                    id.Token.Line,
                    id.Token.Column,
                    id.TypeName.Value,
                    "<unknown>",
                    "undefined struct",
                ),
            )

            return
        }

        // Avoid resolving types here; keep declared signature types as-is.
        mut var mi: int = 0

        while mi < id.Methods.len() {
            var m: &ast.MethodDecl = &id.Methods[mi]
            mut var params: Vec<ast.TypeExpression, _> = Vec.new()
            mut var pi: int = 0

            while pi < (*m).Parameters.len() {
                var p: &ast.Parameter = &(*m).Parameters[pi]

                params.push((*p).Type)
                pi = pi + 1
            }

            (tc.structs[structIndex]).Methods.push(
                types.FunctionInfo{
                    Mutable:    (*m).Mutable,
                    Name:       (*m).Name.Value,
                    Sig:        types.FunctionSig{
                        Params:     params,
                        ReturnType: (*m).ReturnType,
                    },
                    Visibility: (*m).Visibility,
                },
            )
            mi = mi + 1
        }

        return
    }

    mut func checkStatement(stmt: &ast.Statement) -> (void) {
        switch *stmt {
            case ast.Statement.Var(s) {
                tc.checkVarStatement(s)
            }
            case ast.Statement.MultiVar(s) {
                tc.checkMultiVarStatement(s)
            }
            case ast.Statement.Const(s) {
                tc.checkConstStatement(s)
            }
            case ast.Statement.ConstBlock(cb) {
                for c in cb.Constants {
                    tc.checkConstStatement(c)
                }
            }
            case ast.Statement.VarBlock(vb) {
                for v in vb.Variables {
                    tc.checkVarStatement(v)
                }
            }
            case ast.Statement.FunctionDecl(fd) {
                tc.checkFunctionDecl(fd)
            }
            case ast.Statement.ImplDecl(id) {
                tc.checkImplDecl(id)
            }
            case ast.Statement.Return(rs) {
                tc.checkReturnStatement(rs)
            }
            case ast.Statement.If(is) {
                tc.checkIfStatement(is)
            }
            case ast.Statement.While(ws) {
                tc.checkWhileStatement(ws)
            }
            case ast.Statement.For(fs) {
                tc.checkForStatement(fs)
            }
            case ast.Statement.Block(bs) {
                tc.checkBlockStatement(bs)
            }
            case ast.Statement.Expression(es) {
                tc.inferType(es.Expression)
            }
            case ast.Statement.Assignment(assign) {
                tc.checkAssignmentStatement(assign)
            }
            case ast.Statement.Switch(ss) {
                if tc.file.contains("src/compiler/token/token.bak") {
                }

                tc.checkSwitchStatement(ss)
            }
            case ast.Statement.Defer(ds) {
                tc.checkBlockStatement(ds.Body)
            }
            case ast.Statement.Panic(ps) {
                var t: Option<ast.TypeExpression> = tc.inferType(ps.Message)

                switch t {
                    case Some(tt) {
                        if tc.typeToString(tt) != "string" {
                            tc.emit(
                                diag.TypeMismatch(
                                    ps.Token.Line,
                                    ps.Token.Column,
                                    tc.typeToString(tt),
                                    "string",
                                    "panic argument",
                                ),
                            )
                        }
                    }
                    case None {
                    }
                }
            }
            default {
            }
        }

        return
    }

    mut func checkVarStatement(vs: ast.VarStatement) -> (void) {
        var name: string = vs.Name.Value
        var defined: bool = tc.env.Define(
            name,
            None,
            vs.Mutable,
            vs.Token.Line,
            vs.Token.Column,
        )

        if !defined {
            tc.emit(
                diag.DuplicateVariable(
                    name,
                    vs.Token.Line,
                    vs.Token.Column,
                ),
            )

            return
        }

        switch vs.Type {
            case Some(t) {
                switch t {
                    case ast.TypeExpression.Generic(gt) {
                        if gt.Name == "Vec" {
                            tc.checkVecDeclaration(
                                vs,
                                gt,
                            )
                            tc.env.SetType(
                                name,
                                Some(t),
                            )

                            return
                        }
                    }
                    default {
                    }
                }

                switch vs.Value {
                    case Some(v) {
                        var valueType: Option<ast.TypeExpression> = tc.inferType(v)

                        switch valueType {
                            case Some(vt) {
                                if !tc.typesMatch(
                                    t,
                                    vt,
                                ) {
                                    var msg: string = "cannot assign " + tc.typeToString(vt) + " to variable '" + name + "' of type " + tc.typeToString(t)

                                    tc.emit(
                                        diag.SimpleError(
                                            diag.ErrTypeMismatch,
                                            msg,
                                            vs.Token.Line,
                                            vs.Token.Column,
                                        ),
                                    )
                                }
                            }
                            case None {
                            }
                        }
                    }
                    case None {
                    }
                }

                tc.env.SetType(
                    name,
                    Some(t),
                )
            }
            case None {
                switch vs.Value {
                    case Some(v) {
                        // Only allow type inference from call/method call results.
                        mut var canInfer: bool = false

                        switch v {
                            case ast.Expression.Call(_) {
                                canInfer = true
                            }
                            case ast.Expression.MethodCall(_) {
                                canInfer = true
                            }
                            default {
                            }
                        }

                        if !canInfer {
                            tc.emit(
                                diag.MissingType(
                                    name,
                                    vs.Token.Line,
                                    vs.Token.Column,
                                ),
                            )
                        }

                        // Still attempt to infer the initializer's type so we can
                        // report additional diagnostics (e.g. borrow conflicts).
                        var valueType: Option<ast.TypeExpression> = tc.inferType(v)

                        tc.env.SetType(
                            name,
                            valueType,
                        )
                    }
                    case None {
                        tc.emit(
                            diag.MissingType(
                                name,
                                vs.Token.Line,
                                vs.Token.Column,
                            ),
                        )
                    }
                }
            }
        }

        return
    }

    mut func checkVecDeclaration(
        vs: ast.VarStatement,
        gt: ast.GenericType,
    ) -> (void) {
        mut var isStatic: bool = false
        mut var staticSize: int = 0

        if gt.TypeParams.len() >= 2 {
            switch gt.TypeParams[1] {
                case ast.TypeExpression.Size(se) {
                    if !se.IsDynamic {
                        isStatic = true
                        staticSize = se.Value
                    }
                }
                default {
                }
            }
        }

        switch vs.Value {
            case None {
                return
            }
            case Some(v) {
                switch v {
                    case ast.Expression.VecLiteral(_) {
                        tc.emit(
                            diag.SimpleError(
                                diag.ErrVecInvalidInit,
                                "cannot assign array literal directly to Vec; use Vec.from([...]) instead",
                                vs.Token.Line,
                                vs.Token.Column,
                            ),
                        )

                        return
                    }
                    case ast.Expression.MethodCall(mc) {
                        switch mc.Object {
                            case ast.Expression.Identifier(id) {
                                if id.Value == "Vec" {
                                    tc.checkVecConstructorCall(
                                        vs,
                                        gt,
                                        mc,
                                        isStatic,
                                        staticSize,
                                    )

                                    return
                                }
                            }
                            default {
                            }
                        }

                        // Treat non-Vec constructor method calls same as default
                        var valueType: Option<ast.TypeExpression> = tc.inferType(v)

                        switch valueType {
                            case Some(vt) {
                                if !tc.typesMatch(
                                    ast.TypeExpression.Generic(gt),
                                    vt,
                                ) {
                                    var msg: string = "cannot assign " + tc.typeToString(vt) + " to variable '" + vs.Name.Value + "' of type " + tc.typeToString(ast.TypeExpression.Generic(gt))

                                    tc.emit(
                                        diag.SimpleError(
                                            diag.ErrTypeMismatch,
                                            msg,
                                            vs.Token.Line,
                                            vs.Token.Column,
                                        ),
                                    )
                                }
                            }
                            case None {
                            }
                        }
                    }
                    default {
                        var valueType: Option<ast.TypeExpression> = tc.inferType(v)

                        switch valueType {
                            case Some(vt) {
                                if !tc.typesMatch(
                                    ast.TypeExpression.Generic(gt),
                                    vt,
                                ) {
                                    var msg: string = "cannot assign " + tc.typeToString(vt) + " to variable '" + vs.Name.Value + "' of type " + tc.typeToString(ast.TypeExpression.Generic(gt))

                                    tc.emit(
                                        diag.SimpleError(
                                            diag.ErrTypeMismatch,
                                            msg,
                                            vs.Token.Line,
                                            vs.Token.Column,
                                        ),
                                    )
                                }
                            }
                            case None {
                            }
                        }
                    }
                }
            }
        }

        return
    }

    mut func checkVecConstructorCall(
        vs: ast.VarStatement,
        gt: ast.GenericType,
        mc: ast.MethodCallExpression,
        isStatic: bool,
        staticSize: int,
    ) -> (void) {
        var method: string = mc.Method.Value

        if method == "new" {
            if isStatic {
                tc.emit(
                    diag.SimpleError(
                        diag.ErrVecDynamicOnly,
                        "Vec.new() cannot be used with static Vec<T," + staticSize.toString() + ">; use Vec.from() instead",
                        vs.Token.Line,
                        vs.Token.Column,
                    ),
                )

                return
            }

            if !vs.Mutable {
                tc.emit(
                    diag.SimpleError(
                        diag.ErrVecInvalidInit,
                        "Vec.new() should be assigned to a mutable variable (use 'mut var')",
                        vs.Token.Line,
                        vs.Token.Column,
                    ),
                )
            }

            return
        }

        if method == "from" {
            if mc.Arguments.len() != 1 {
                tc.emit(
                    diag.SimpleError(
                        diag.ErrVecInvalidInit,
                        "Vec.from() requires exactly one argument (an array literal)",
                        mc.Token.Line,
                        mc.Token.Column,
                    ),
                )

                return
            }

            switch mc.Arguments[0] {
                case ast.Expression.VecLiteral(vl) {
                    if isStatic && vl.Elements.len() != staticSize {
                        tc.emit(
                            diag.SimpleError(
                                diag.ErrVecSizeMismatch,
                                "Vec<" + tc.typeToString(gt.TypeParams[0]) + "," + staticSize.toString() + "> expects " + staticSize.toString() + " elements, but " + vl.Elements.len().toString() + " were provided",
                                mc.Token.Line,
                                mc.Token.Column,
                            ),
                        )

                        return
                    }

                    if gt.TypeParams.len() >= 1 {
                        mut var i: int = 0

                        while i < vl.Elements.len() {
                            switch tc.inferType(vl.Elements[i]) {
                                case Some(et) {
                                    if !tc.typesMatch(
                                        gt.TypeParams[0],
                                        et,
                                    ) {
                                        var msg: string = "element " + i.toString() + " in Vec.from() must be " + tc.typeToString(gt.TypeParams[0]) + ", got " + tc.typeToString(et)

                                        tc.emit(
                                            diag.SimpleError(
                                                diag.ErrTypeMismatch,
                                                msg,
                                                mc.Token.Line,
                                                mc.Token.Column,
                                            ),
                                        )

                                        return
                                    }
                                }
                                case None {
                                }
                            }

                            i = i + 1
                        }
                    }
                }
                default {
                }
            }

            return
        }

        if method == "with_cap" {
            if isStatic {
                tc.emit(
                    diag.SimpleError(
                        diag.ErrVecDynamicOnly,
                        "Vec.with_cap() cannot be used with static Vec<T," + staticSize.toString() + ">; use Vec.from() instead",
                        vs.Token.Line,
                        vs.Token.Column,
                    ),
                )

                return
            }

            if !vs.Mutable {
                tc.emit(
                    diag.SimpleError(
                        diag.ErrVecInvalidInit,
                        "Vec.with_cap() should be assigned to a mutable variable (use 'mut var')",
                        vs.Token.Line,
                        vs.Token.Column,
                    ),
                )
            }

            return
        }

        return
    }

    mut func checkMultiVarStatement(ms: ast.MultiVarStatement) -> (void) {
        switch ms.Value {
            case Some(v) {
                var valueType: Option<ast.TypeExpression> = tc.inferType(v)

                switch valueType {
                    case Some(t) {
                        switch t {
                            case ast.TypeExpression.TupleRef(tt) {
                                if tt.Elements.len() != ms.Names.len() {
                                    tc.emit(
                                        diag.TypeMismatch(
                                            ms.Token.Line,
                                            ms.Token.Column,
                                            "tuple(" + ms.Names.len().toString() + ")",
                                            "tuple(" + tt.Elements.len().toString() + ")",
                                            "",
                                        ),
                                    )

                                    return
                                }

                                mut var i: int = 0

                                while i < ms.Names.len() {
                                    var name: string = (ms.Names[i]).Value

                                    if !tc.env.Define(
                                        name,
                                        Some(tt.Elements[i]),
                                        ms.Mutable,
                                        (ms.Names[i]).Token.Line,
                                        (ms.Names[i]).Token.Column,
                                    ) {
                                        tc.emit(
                                            diag.DuplicateVariable(
                                                name,
                                                (ms.Names[i]).Token.Line,
                                                (ms.Names[i]).Token.Column,
                                            ),
                                        )
                                    }

                                    i = i + 1
                                }

                                return
                            }
                        }
                    }
                    case None {
                    }
                }
            }
            case None {
            }
        }

        return
    }

    mut func checkConstStatement(cs: ast.ConstStatement) -> (void) {
        var dbg: bool = tc.file.contains("src/compiler/token/token.bak")

        if dbg {
        }

        if dbg && cs.Name.Value == "UNSAFE" {
        }

        switch cs.Type {
            case Some(t) {
                if dbg && cs.Name.Value == "UNSAFE" {
                }

                var valueType: Option<ast.TypeExpression> = tc.inferType(cs.Value)

                if dbg && cs.Name.Value == "UNSAFE" {
                }

                switch valueType {
                    case Some(vt) {
                        if dbg && cs.Name.Value == "UNSAFE" {
                        }

                        if !tc.typesMatch(
                            t,
                            vt,
                        ) {
                            var msg: string = "cannot assign " + tc.typeToString(vt) + " to variable '" + cs.Name.Value + "' of type " + tc.typeToString(t)

                            tc.emit(
                                diag.SimpleError(
                                    diag.ErrTypeMismatch,
                                    msg,
                                    cs.Token.Line,
                                    cs.Token.Column,
                                ),
                            )
                        }
                    }
                    case None {
                    }
                }

                if dbg && cs.Name.Value == "UNSAFE" {
                }

                if !tc.env.Define(
                    cs.Name.Value,
                    Some(t),
                    false,
                    cs.Name.Token.Line,
                    cs.Name.Token.Column,
                ) {
                    tc.emit(
                        diag.DuplicateVariable(
                            cs.Name.Value,
                            cs.Token.Line,
                            cs.Token.Column,
                        ),
                    )
                }

                if dbg && cs.Name.Value == "UNSAFE" {
                }
            }
            case None {
                tc.emit(
                    diag.MissingType(
                        cs.Name.Value,
                        cs.Token.Line,
                        cs.Token.Column,
                    ),
                )
            }
        }

        return
    }

    mut func checkFunctionDecl(fd: ast.FunctionDecl) -> (void) {
        var dbg: bool = tc.file.contains("src/compiler/token/token.bak")

        if dbg {
        }

        // Push a new scope that borrows the current environment as `outer`.
        // Keep the outer Box alive locally and restore it on exit.
        var prevEnv: env.Environment box = tc.env

        tc.env = Box.new(env.NewEnclosedEnv(&*prevEnv))

        for param in fd.Parameters {
            if !tc.env.Define(
                param.Name.Value,
                Some(param.Type),
                param.Mutable,
                param.Token.Line,
                param.Token.Column,
            ) {
                tc.emit(
                    diag.DuplicateVariable(
                        param.Name.Value,
                        param.Token.Line,
                        param.Token.Column,
                    ),
                )
            }
        }

        var oldReturn: Option<ast.TypeExpression> = tc.currentReturn

        tc.currentReturn = Some(fd.ReturnType)

        if dbg {
        }

        tc.checkBlockStatement(fd.Body)

        if dbg {
        }

        tc.currentReturn = oldReturn
        // Pop scope
        tc.env = prevEnv

        if dbg {
        }

        return
    }

    mut func checkImplDecl(id: ast.ImplDecl) -> (void) {
        var structIndex: int = tc.findStructIndex(id.TypeName.Value)

        if structIndex < 0 {
            return
        }

        mut var mi: int = 0

        while mi < id.Methods.len() {
            var m: ast.MethodDecl = id.Methods[mi]
            var prevEnv: env.Environment box = tc.env

            tc.env = Box.new(env.NewEnclosedEnv(&*prevEnv))
            tc.env.Define(
                id.Receiver.Value,
                Some(
                    ast.TypeExpression.Simple(
                        ast.SimpleType{
                            Name:  id.TypeName.Value,
                            Token: id.TypeName.Token,
                        },
                    ),
                ),
                true,
                id.Receiver.Token.Line,
                id.Receiver.Token.Column,
            )

            mut var pi: int = 0

            while pi < m.Parameters.len() {
                var param: ast.Parameter = m.Parameters[pi]

                tc.env.Define(
                    param.Name.Value,
                    Some(param.Type),
                    param.Mutable,
                    param.Token.Line,
                    param.Token.Column,
                )
                pi = pi + 1
            }

            var oldReturn: Option<ast.TypeExpression> = tc.currentReturn

            tc.currentReturn = Some(m.ReturnType)
            tc.checkBlockStatement(m.Body)
            tc.currentReturn = oldReturn
            tc.env = prevEnv
            mi = mi + 1
        }

        return
    }

    mut func checkReturnStatement(rs: ast.ReturnStatement) -> (void) {
        switch tc.currentReturn {
            case Some(retType) {
                switch rs.ReturnValue {
                    case Some(rv) {
                        var valueType: Option<ast.TypeExpression> = tc.inferType(rv)

                        switch valueType {
                            case Some(vt) {
                                if !tc.typesMatch(
                                    retType,
                                    vt,
                                ) {
                                    var msg: string = "cannot return " + tc.typeToString(vt) + " from function expecting " + tc.typeToString(retType)

                                    tc.emit(
                                        diag.SimpleError(
                                            diag.ErrReturnType,
                                            msg,
                                            rs.Token.Line,
                                            rs.Token.Column,
                                        ),
                                    )
                                }

                                // V1 Restrict: No returning borrows
                                switch tc.resolveType(&vt) {
                                    case ast.TypeExpression.BorrowRef(bt) {
                                        tc.emit(
                                            diag.ReturningBorrow(
                                                tc.typeToString(vt),
                                                rs.Token.Line,
                                                rs.Token.Column,
                                            ),
                                        )
                                    }
                                    default {
                                    }
                                }
                            }
                            case None {
                            }
                        }
                    }
                    case None {
                    }
                }
            }
            case None {
            }
        }

        return
    }

    mut func checkIfStatement(is: ast.IfStatement) -> (void) {
        var condType: Option<ast.TypeExpression> = tc.inferType(is.Condition)

        switch condType {
            case Some(t) {
                if !tc.isBoolType(t) {
                    var msg: string = "if condition must be bool, got " + tc.typeToString(t)

                    tc.emit(
                        diag.SimpleError(
                            diag.ErrTypeMismatch,
                            msg,
                            is.Token.Line,
                            is.Token.Column,
                        ),
                    )
                }
            }
            case None {
            }
        }

        tc.checkBlockStatement(is.Consequence)

        switch is.Alternative {
            case Some(alt) {
                tc.checkBlockStatement(alt)
            }
            case None {
            }
        }

        return
    }

    mut func checkWhileStatement(ws: ast.WhileStatement) -> (void) {
        var condType: Option<ast.TypeExpression> = tc.inferType(ws.Condition)

        switch condType {
            case Some(t) {
                if !tc.isBoolType(t) {
                    var msg: string = "while condition must be bool, got " + tc.typeToString(t)

                    tc.emit(
                        diag.SimpleError(
                            diag.ErrTypeMismatch,
                            msg,
                            ws.Token.Line,
                            ws.Token.Column,
                        ),
                    )
                }
            }
            case None {
            }
        }

        tc.checkBlockStatement(ws.Body)

        return
    }

    mut func checkForStatement(fs: ast.ForStatement) -> (void) {
        var iterType: Option<ast.TypeExpression> = tc.inferType(fs.Iterable)
        mut var elemType: Option<ast.TypeExpression> = None

        switch iterType {
            case Some(it) {
                elemType = tc.iterableElementType(it)
            }
            case None {
            }
        }

        var prevEnv: env.Environment box = tc.env

        tc.env = Box.new(env.NewEnclosedEnv(&*prevEnv))
        tc.env.Define(
            fs.Variable.Value,
            elemType,
            false,
            fs.Variable.Token.Line,
            fs.Variable.Token.Column,
        )
        tc.checkBlockStatement(fs.Body)
        tc.env = prevEnv

        return
    }

    mut func checkSwitchStatement(ss: ast.SwitchStatement) -> (void) {
        if tc.file.contains("src/compiler/token/token.bak") {
        }

        // During stage2 bootstrap, env lookups for switch values in token/token.bak have been
        // a frequent crash point. The token module does not use pattern-binding switch cases,
        // so we can safely skip inferring the switch value type there.
        mut var switchType: Option<ast.TypeExpression> = None

        if !tc.file.contains("src/compiler/token/token.bak") {
            switchType = tc.inferType(ss.Value)
        }

        // Avoid indexing+borrowing into AST Vecs here; it has triggered invalid reads
        // in stage2 during bootstrap. Iteration-by-value is more stable.
        mut var dbg_ci: int = 0

        for c in ss.Cases {
            if tc.file.contains("src/compiler/token/token.bak") {
            }

            mut var handled: bool = false

            for v in c.Values {
                if tc.isPatternBinding(v) {
                    tc.checkSwitchPatternCase(
                        &c,
                        v,
                        switchType,
                    )
                    handled = true
                    break
                }
            }

            if !handled {
                tc.checkBlockStatement(c.Body)
            }

            dbg_ci = dbg_ci + 1
        }

        if tc.file.contains("src/compiler/token/token.bak") {
        }

        return
    }

    mut func isPatternBinding(expr: ast.Expression) -> (bool) {
        switch expr {
            case ast.Expression.EnumVariant(ev) {
                return tc.hasBindingArgs(ev.Values)
            }
            case ast.Expression.Call(call) {
                return tc.hasBindingArgs(call.Arguments)
            }
            case ast.Expression.MethodCall(mc) {
                return tc.hasBindingArgs(mc.Arguments)
            }
            default {
            }
        }

        return false
    }

    mut func checkSwitchPatternCase(
        c: &ast.SwitchCase,
        expr: ast.Expression,
        switchType: Option<ast.TypeExpression>,
    ) -> (void) {
        mut var boundNames: Vec<string, _> = Vec.new()
        mut var boundMutable: Vec<bool, _> = Vec.new()
        mut var variant: string = ""

        switch expr {
            case ast.Expression.EnumVariant(ev) {
                variant = ev.Variant.Value

                for v in ev.Values {
                    switch v {
                        case ast.Expression.Identifier(id) {
                            boundNames.push(id.Value)
                            boundMutable.push(false)
                        }
                        case ast.Expression.MutableIdentifier(id) {
                            boundNames.push(id.Value)
                            boundMutable.push(true)
                        }
                        default {
                        }
                    }
                }
            }
            case ast.Expression.Call(call) {
                switch call.Function {
                    case ast.Expression.Identifier(id) {
                        variant = id.Value
                    }
                    default {
                    }
                }

                for v in call.Arguments {
                    switch v {
                        case ast.Expression.Identifier(id) {
                            boundNames.push(id.Value)
                            boundMutable.push(false)
                        }
                        case ast.Expression.MutableIdentifier(id) {
                            boundNames.push(id.Value)
                            boundMutable.push(true)
                        }
                        default {
                        }
                    }
                }
            }
            case ast.Expression.MethodCall(mc) {
                variant = mc.Method.Value

                for v in mc.Arguments {
                    switch v {
                        case ast.Expression.Identifier(id) {
                            boundNames.push(id.Value)
                            boundMutable.push(false)
                        }
                        case ast.Expression.MutableIdentifier(id) {
                            boundNames.push(id.Value)
                            boundMutable.push(true)
                        }
                        default {
                        }
                    }
                }
            }
            default {
            }
        }

        var prevEnv: env.Environment box = tc.env

        tc.env = Box.new(env.NewEnclosedEnv(&*prevEnv))

        if boundNames.len() > 0 {
            mut var i: int = 0

            while i < boundNames.len() {
                // We don't have token info for these generated bindings, so use the case token.
                tc.env.Define(
                    boundNames[i],
                    None,
                    boundMutable[i],
                    (*c).Token.Line,
                    (*c).Token.Column,
                )
                i = i + 1
            }
        }

        tc.checkBlockStatement((*c).Body)
        tc.env = prevEnv

        return
    }

    mut func hasBindingArgs(values: Vec<ast.Expression, _>) -> (bool) {
        for v in values {
            switch v {
                case ast.Expression.Identifier(_) {
                    return true
                }
                case ast.Expression.MutableIdentifier(_) {
                    return true
                }
                default {
                }
            }
        }

        return false
    }

    mut func variantPayloadType(
        t: ast.TypeExpression,
        variant: string,
    ) -> (Option<ast.TypeExpression>) {
        switch tc.resolveType(&t) {
            case ast.TypeExpression.Generic(gt) {
                if gt.Name == "Result" && gt.TypeParams.len() >= 2 {
                    if variant == "Ok" {
                        return Some(gt.TypeParams[0])
                    }

                    if variant == "Err" {
                        return Some(gt.TypeParams[1])
                    }
                }

                if gt.Name == "Option" && gt.TypeParams.len() >= 1 {
                    if variant == "Some" {
                        return Some(gt.TypeParams[0])
                    }
                }
            }
            default {
            }
        }

        return None
    }

    mut func checkBlockStatement(bs: ast.BlockStatement) -> (void) {
        // Bootstrap mode simplification:
        // Creating nested environments (block scopes) is currently triggering
        // crashes in stage2 due to outer-env ownership semantics. For now, we
        // typecheck blocks in the current environment.
        var dbg: bool = tc.file.contains("src/compiler/token/token.bak")
        mut var si: int = 0

        for s in bs.Statements {
            if dbg {
            }

            tc.checkStatement(&s)
            si = si + 1
        }

        return
    }

    mut func checkAssignmentStatement(
        assign: ast.AssignmentStatement,
    ) -> (void) {
        switch assign.Left {
            case ast.Expression.FieldAccess(fa) {
                tc.checkFieldAssignment(
                    fa,
                    assign.Value,
                    assign.Token.Line,
                    assign.Token.Column,
                )

                return
            }
            case ast.Expression.Index(ix) {
                tc.inferIndexExpression(ix)

                var valueType: Option<ast.TypeExpression> = tc.inferType(assign.Value)

                switch valueType {
                    case Some(vt) {
                        switch tc.inferIndexExpression(ix) {
                            case Some(it) {
                                if !tc.typesMatch(
                                    it,
                                    vt,
                                ) {
                                    tc.emit(
                                        diag.TypeMismatch(
                                            assign.Token.Line,
                                            assign.Token.Column,
                                            tc.typeToString(it),
                                            tc.typeToString(vt),
                                            "index assignment",
                                        ),
                                    )
                                }
                            }
                            case None {
                            }
                        }
                    }
                    case None {
                    }
                }

                return
            }
            default {
            }
        }

        mut var varName: string = ""

        switch assign.Left {
            case ast.Expression.Identifier(id) {
                varName = id.Value
            }
            case ast.Expression.MutableIdentifier(id) {
                varName = id.Value
            }
            default {
                varName = ""
            }
        }

        if varName == "" {
            tc.inferType(assign.Value)

            return
        }

        switch tc.env.Lookup(&varName) {
            case Some(sym) {
                if sym.Moved && !sym.Poisoned {
                    tc.emit(
                        diag.UseAfterMove(
                            varName,
                            assign.Token.Line,
                            assign.Token.Column,
                            sym.MoveLine,
                            sym.MoveColumn,
                            sym.MoveReason,
                        ),
                    )
                    tc.env.MarkPoisoned(varName)

                    return
                }

                if !sym.Mutable {
                    tc.emit(
                        diag.AssignToImmutable(
                            varName,
                            assign.Token.Line,
                            assign.Token.Column,
                        ),
                    )

                    return
                }

                var valueType: Option<ast.TypeExpression> = tc.inferType(assign.Value)

                switch sym.Type {
                    case Some(expected) {
                        switch valueType {
                            case Some(vt) {
                                if !tc.typesMatch(
                                    expected,
                                    vt,
                                ) {
                                    var msg: string = "cannot assign " + tc.typeToString(vt) + " to variable '" + varName + "' of type " + tc.typeToString(expected)

                                    tc.emit(
                                        diag.SimpleError(
                                            diag.ErrTypeMismatch,
                                            msg,
                                            assign.Token.Line,
                                            assign.Token.Column,
                                        ),
                                    )
                                }
                            }
                            case None {
                            }
                        }
                    }
                    case None {
                    }
                }
            }
            case None {
            }
        }

        return
    }

    mut func checkFieldAssignment(
        fa: ast.FieldAccessExpression,
        value: ast.Expression,
        line: int,
        col: int,
    ) -> (void) {
        mut var objName: string = ""

        switch fa.Object {
            case ast.Expression.Identifier(id) {
                objName = id.Value
            }
            case ast.Expression.MutableIdentifier(id) {
                objName = id.Value
            }
            default {
                objName = ""
            }
        }

        if objName != "" {
            switch tc.env.Lookup(&objName) {
                case Some(sym) {
                    if sym.Moved && !sym.Poisoned {
                        tc.emit(
                            diag.UseAfterMove(
                                objName,
                                line,
                                col,
                                sym.MoveLine,
                                sym.MoveColumn,
                                sym.MoveReason,
                            ),
                        )
                        tc.env.MarkPoisoned(objName)

                        return
                    }

                    mut var isActuallyMutable: bool = sym.Mutable

                    if !isActuallyMutable {
                        switch sym.Type {
                            case Some(t) {
                                switch tc.resolveType(&t) {
                                    case ast.TypeExpression.BorrowRef(bt) {
                                        if bt.Mutable {
                                            isActuallyMutable = true
                                        }
                                    }
                                    default {
                                    }
                                }
                            }
                            case None {
                            }
                        }
                    }

                    if !isActuallyMutable {
                        tc.emit(
                            diag.MutabilityRequired(
                                objName,
                                line,
                                col,
                                "assign to field '" + fa.Field.Value + "'",
                            ),
                        )

                        return
                    }
                }
                case None {
                }
            }
        }

        var valueType: Option<ast.TypeExpression> = tc.inferType(value)
        var fieldType: Option<ast.TypeExpression> = tc.inferFieldAccess(fa)

        switch valueType {
            case Some(vt) {
                switch fieldType {
                    case Some(ft) {
                        if !tc.typesMatch(
                            ft,
                            vt,
                        ) {
                            tc.emit(
                                diag.TypeMismatch(
                                    line,
                                    col,
                                    tc.typeToString(ft),
                                    tc.typeToString(vt),
                                    "field '" + fa.Field.Value + "'",
                                ),
                            )
                        }
                    }
                    case None {
                    }
                }
            }
            case None {
            }
        }

        return
    }

    mut func inferType(expr: ast.Expression) -> (Option<ast.TypeExpression>) {
        switch expr {
            case ast.Expression.IntegerLiteral(_) {
                return Some(
                    ast.TypeExpression.Simple(
                        ast.SimpleType{
                            Name:  "int",
                            Token: tokenNil(),
                        },
                    ),
                )
            }
            case ast.Expression.FloatLiteral(_) {
                return Some(
                    ast.TypeExpression.Simple(
                        ast.SimpleType{
                            Name:  "float64",
                            Token: tokenNil(),
                        },
                    ),
                )
            }
            case ast.Expression.StringLiteral(_) {
                return Some(
                    ast.TypeExpression.Simple(
                        ast.SimpleType{
                            Name:  "string",
                            Token: tokenNil(),
                        },
                    ),
                )
            }
            case ast.Expression.CharLiteral(_) {
                return Some(
                    ast.TypeExpression.Simple(
                        ast.SimpleType{
                            Name:  "char",
                            Token: tokenNil(),
                        },
                    ),
                )
            }
            case ast.Expression.BooleanLiteral(_) {
                return Some(
                    ast.TypeExpression.Simple(
                        ast.SimpleType{
                            Name:  "bool",
                            Token: tokenNil(),
                        },
                    ),
                )
            }
            case ast.Expression.VoidLiteral(_) {
                return Some(
                    ast.TypeExpression.Void(
                        ast.VoidType{
                            Token: tokenNil(),
                        },
                    ),
                )
            }
            case ast.Expression.Identifier(id) {
                return tc.inferIdentifier(
                    id.Value,
                    id.Token,
                )
            }
            case ast.Expression.MutableIdentifier(id) {
                return tc.inferIdentifier(
                    id.Value,
                    id.Token,
                )
            }
            case ast.Expression.FieldAccess(fa) {
                return tc.inferFieldAccess(fa)
            }
            case ast.Expression.MethodCall(mc) {
                return tc.inferMethodCall(mc)
            }
            case ast.Expression.Call(ce) {
                return tc.inferCallExpression(ce)
            }
            case ast.Expression.Index(ix) {
                return tc.inferIndexExpression(ix)
            }
            case ast.Expression.Infix(ie) {
                return tc.inferInfixType(ie)
            }
            case ast.Expression.Prefix(pe) {
                return tc.inferPrefixType(pe)
            }
            case ast.Expression.StructLiteral(sl) {
                for f in sl.Fields {
                    tc.inferType(f.Value)
                }

                return Some(
                    ast.TypeExpression.Simple(
                        ast.SimpleType{
                            Name:  sl.Name.Value,
                            Token: sl.Name.Token,
                        },
                    ),
                )
            }
            case ast.Expression.VecLiteral(vl) {
                for e in vl.Elements {
                    tc.inferType(e)
                }

                return Some(
                    ast.TypeExpression.Generic(
                        ast.GenericType{
                            Name:       "Vec",
                            Token:      tokenNil(),
                            TypeParams: Vec.new(),
                        },
                    ),
                )
            }
            case ast.Expression.Tuple(te) {
                return Some(
                    ast.TypeExpression.TupleRef(
                        ast.TupleType{
                            Elements: tc.inferTupleTypes(te.Elements),
                            Token:    te.Token,
                        },
                    ),
                )
            }
            case ast.Expression.Range(re) {
                return tc.inferRangeExpression(re)
            }
            case ast.Expression.TypeConversion(tcExpr) {
                return Some(
                    ast.TypeExpression.Simple(
                        ast.SimpleType{
                            Name:  tcExpr.TypeName,
                            Token: tcExpr.Token,
                        },
                    ),
                )
            }
            case ast.Expression.Borrow(be) {
                return tc.inferBorrowExpression(be)
            }
            case ast.Expression.Box(be) {
                var inner: Option<ast.TypeExpression> = tc.inferType(be.Value)

                switch inner {
                    case Some(it) {
                        return Some(
                            ast.TypeExpression.BoxRef(
                                ast.BoxType{
                                    Inner: it,
                                    Token: be.Token,
                                },
                            ),
                        )
                    }
                    case None {
                        return None
                    }
                }
            }
            case ast.Expression.Deref(de) {
                var inner: Option<ast.TypeExpression> = tc.inferType(de.Value)

                switch inner {
                    case Some(t) {
                        switch t {
                            case ast.TypeExpression.BorrowRef(bt) {
                                return Some(bt.Inner)
                            }
                            case ast.TypeExpression.BoxRef(bt) {
                                return Some(bt.Inner)
                            }
                            case ast.TypeExpression.BoxOptional(bt) {
                                return Some(bt.Inner)
                            }
                            default {
                                return Some(t)
                            }
                        }
                    }
                    case None {
                        return None
                    }
                }
            }
            default {
            }
        }

        return None
    }

    mut func inferIdentifier(
        name: string,
        tok: token.Token,
    ) -> (Option<ast.TypeExpression>) {
        var dbg: bool = tc.file.contains("src/compiler/token/token.bak")

        if dbg {
        }

        switch tc.env.Lookup(&name) {
            case Some(sym) {
                if dbg {
                }

                if sym.Moved && !sym.Poisoned {
                    tc.emit(
                        diag.UseAfterMove(
                            name,
                            tok.Line,
                            tok.Column,
                            sym.MoveLine,
                            sym.MoveColumn,
                            sym.MoveReason,
                        ),
                    )
                    tc.env.MarkPoisoned(name)

                    return sym.Type
                }

                tc.env.MarkUsed(name)

                return sym.Type
            }
            case None {
                if dbg {
                }

                // Check local functions
                if dbg && name == "PACKAGE" {
                }

                switch tc.findFunctionSig(&name) {
                    case Some(sig) {
                        if dbg && name == "PACKAGE" {
                        }

                        return Some(
                            ast.TypeExpression.Function(
                                ast.FunctionType{
                                    Parameters: sig.Params,
                                    ReturnType: sig.ReturnType,
                                    Token:      tok,
                                },
                            ),
                        )
                    }
                    case None {
                    }
                }

                if dbg && name == "PACKAGE" {
                }

                if tc.isTypeName(&name) {
                    return Some(
                        ast.TypeExpression.Simple(
                            ast.SimpleType{
                                Name:  name,
                                Token: tok,
                            },
                        ),
                    )
                }

                // Enum variants used as identifiers, e.g. `Ok(x)` in switch patterns.
                if dbg && name == "PACKAGE" {
                }

                switch tc.enumVariantType(
                    &name,
                    tok,
                ) {
                    case Some(et) {
                        return Some(et)
                    }
                    case None {
                    }
                }

                if dbg && name == "PACKAGE" {
                }

                if tc.isModuleAlias(&name) {
                    return None
                }

                if dbg && name == "PACKAGE" {
                }

                tc.emit(
                    diag.UndefinedVariable(
                        name,
                        tok.Line,
                        tok.Column,
                    ),
                )

                return None
            }
        }
    }

    mut func isModuleAlias(name: &string) -> (bool) {
        mut var i: int = 0

        while i < tc.imports.len() {
            var imp: &types.ImportBinding = &tc.imports[i]

            if strings.compare(
                &(*imp).Alias,
                name,
            ) == 0 {
                return true
            }

            i = i + 1
        }

        return false
    }

    mut func isTypeName(name: &string) -> (bool) {
        mut var i: int = 0

        while i < tc.typeNames.len() {
            if strings.compare(
                &tc.typeNames[i],
                name,
            ) == 0 {
                return true
            }

            i = i + 1
        }

        return false
    }

    mut func enumVariantType(
        name: &string,
        tok: token.Token,
    ) -> (Option<ast.TypeExpression>) {
        // Bootstrap-safe implementation: avoid scanning `tc.enums` (it contains Vec fields
        // and has triggered crashes when indexed/borrowed in stage2).
        mut var i: int = 0

        while i < tc.enumVariants.len() {
            if strings.compare(
                &(tc.enumVariants[i]).Variant,
                name,
            ) == 0 {
                return Some(
                    ast.TypeExpression.Simple(
                        ast.SimpleType{
                            Name:  (tc.enumVariants[i]).EnumName,
                            Token: tok,
                        },
                    ),
                )
            }

            i = i + 1
        }

        return None
    }

    mut func inferTupleTypes(
        elements: Vec<ast.Expression, _>,
    ) -> (Vec<ast.TypeExpression, _>) {
        mut var out: Vec<ast.TypeExpression, _> = Vec.new()

        for e in elements {
            switch tc.inferType(e) {
                case Some(t) {
                    out.push(t)
                }
                case None {
                    out.push(
                        ast.TypeExpression.Error(
                            ast.ErrorType{
                                Message: "unknown",
                                Token:   tokenNil(),
                            },
                        ),
                    )
                }
            }
        }

        return out
    }

    mut func inferRangeExpression(
        re: ast.RangeExpression,
    ) -> (Option<ast.TypeExpression>) {
        var startType: Option<ast.TypeExpression> = tc.inferType(re.Start)
        var endType: Option<ast.TypeExpression> = tc.inferType(re.End)

        switch startType {
            case Some(t) {
                if !tc.isIntegerType(t) {
                    var msg: string = "range start must be integer, got " + tc.typeToString(t)

                    tc.emit(
                        diag.SimpleError(
                            diag.ErrTypeMismatch,
                            msg,
                            re.Token.Line,
                            re.Token.Column,
                        ),
                    )

                    return Some(
                        ast.TypeExpression.Error(
                            ast.ErrorType{
                                Message: "invalid range",
                                Token:   re.Token,
                            },
                        ),
                    )
                }
            }
            case None {
            }
        }

        switch endType {
            case Some(t) {
                if !tc.isIntegerType(t) {
                    var msg: string = "range end must be integer, got " + tc.typeToString(t)

                    tc.emit(
                        diag.SimpleError(
                            diag.ErrTypeMismatch,
                            msg,
                            re.Token.Line,
                            re.Token.Column,
                        ),
                    )

                    return Some(
                        ast.TypeExpression.Error(
                            ast.ErrorType{
                                Message: "invalid range",
                                Token:   re.Token,
                            },
                        ),
                    )
                }
            }
            case None {
            }
        }

        return Some(
            ast.TypeExpression.Simple(
                ast.SimpleType{
                    Name:  "Range",
                    Token: re.Token,
                },
            ),
        )
    }

    mut func inferBorrowExpression(
        be: ast.BorrowExpression,
    ) -> (Option<ast.TypeExpression>) {
        var inner: Option<ast.TypeExpression> = tc.inferType(be.Value)

        switch inner {
            case None {
                return None
            }
            case Some(t) {
                // If the borrowed value is an identifier, perform stricter ownership/borrow checks
                switch be.Value {
                    case ast.Expression.Identifier(id) {
                        var name: string = id.Value
                        var line: int = id.Token.Line
                        var col: int = id.Token.Column
                        // Re-entrancy guard: if we're already processing this name, be permissive
                        mut var i: int = 0

                        while i < tc.processingBorrows.len() {
                            if tc.processingBorrows[i] == name {
                                return Some(
                                    ast.TypeExpression.BorrowRef(
                                        ast.BorrowType{
                                            Inner:   t,
                                            Mutable: be.Mutable,
                                            Token:   be.Token,
                                        },
                                    ),
                                )
                            }

                            i = i + 1
                        }

                        // Mark as processing
                        tc.processingBorrows.push(name)

                        // Lookup the symbol and perform checks
                        switch tc.env.Lookup(&name) {
                            case Some(sym) {
                                if sym.Moved && !sym.Poisoned {
                                    tc.emit(
                                        diag.UseAfterMove(
                                            name,
                                            line,
                                            col,
                                            sym.MoveLine,
                                            sym.MoveColumn,
                                            sym.MoveReason,
                                        ),
                                    )
                                    tc.env.MarkPoisoned(name)
                                    tc.processingBorrows.remove(tc.processingBorrows.len() - 1)

                                    return None
                                }

                                if tc.env.IsBorrowedMut(name) {
                                    mut var attempted: string = "borrow as immutable"

                                    if be.Mutable {
                                        attempted = "borrow as mutable"
                                    }

                                    tc.emit(
                                        diag.BorrowConflict(
                                            name,
                                            line,
                                            col,
                                            attempted,
                                            "mutably borrowed",
                                        ),
                                    )
                                    tc.processingBorrows.remove(tc.processingBorrows.len() - 1)

                                    return None
                                }

                                if be.Mutable {
                                    if tc.env.IsBorrowedIm(name) {
                                        tc.emit(
                                            diag.BorrowConflict(
                                                name,
                                                line,
                                                col,
                                                "borrow as mutable",
                                                "immutably borrowed",
                                            ),
                                        )
                                        tc.processingBorrows.remove(tc.processingBorrows.len() - 1)

                                        return None
                                    }

                                    if !sym.Mutable {
                                        tc.emit(
                                            diag.MutabilityRequired(
                                                name,
                                                line,
                                                col,
                                                "borrow as mutable",
                                            ),
                                        )
                                        tc.processingBorrows.remove(tc.processingBorrows.len() - 1)

                                        return None
                                    }

                                    tc.env.MarkBorrowedMut(name)
                                    tc.env.activeMutBorrows.push(name)
                                } else {
                                    tc.env.MarkBorrowedIm(name)
                                    tc.env.activeImBorrows.push(name)
                                }

                                mut var result: Option<ast.TypeExpression>

                                switch sym.Type {
                                    case Some(tt) {
                                        result = Some(
                                            ast.TypeExpression.BorrowRef(
                                                ast.BorrowType{
                                                    Inner:   tt,
                                                    Mutable: be.Mutable,
                                                    Token:   be.Token,
                                                },
                                            ),
                                        )
                                    }
                                    case None {
                                        result = Some(
                                            ast.TypeExpression.BorrowRef(
                                                ast.BorrowType{
                                                    Inner:   t,
                                                    Mutable: be.Mutable,
                                                    Token:   be.Token,
                                                },
                                            ),
                                        )
                                    }
                                }

                                tc.processingBorrows.remove(tc.processingBorrows.len() - 1)

                                return result
                            }
                            case None {
                                tc.processingBorrows.remove(tc.processingBorrows.len() - 1)

                                return Some(
                                    ast.TypeExpression.BorrowRef(
                                        ast.BorrowType{
                                            Inner:   t,
                                            Mutable: be.Mutable,
                                            Token:   be.Token,
                                        },
                                    ),
                                )
                            }
                        }
                    }
                    default {
                        return Some(
                            ast.TypeExpression.BorrowRef(
                                ast.BorrowType{
                                    Inner:   t,
                                    Mutable: be.Mutable,
                                    Token:   be.Token,
                                },
                            ),
                        )
                    }
                }
            }
        }

        return None
    }

    mut func inferFieldAccess(
        fa: ast.FieldAccessExpression,
    ) -> (Option<ast.TypeExpression>) {
        switch fa.Object {
            case ast.Expression.Identifier(id) {
                var importAlias: string = id.Value
                var field: string = fa.Field.Value

                switch tc.importedConstType(
                    importAlias,
                    field,
                ) {
                    case Some(t) {
                        return Some(t)
                    }
                    case None {
                    }
                }
            }
            default {
            }
        }

        var objType: Option<ast.TypeExpression> = tc.inferType(fa.Object)

        switch objType {
            case Some(t) {
                mut var base: ast.TypeExpression = tc.resolveType(&t)

                switch base {
                    case ast.TypeExpression.BorrowRef(bt) {
                        base = bt.Inner
                    }
                    default {
                    }
                }

                switch base {
                    case ast.TypeExpression.Simple(st) {
                        var parts: Vec<string, _> = splitQualifiedName(&st.Name)

                        if parts.len() == 2 {
                            var moduleAlias: string = parts[0]
                            var name: string = parts[1]
                            mut var ii: int = 0

                            while ii < tc.imports.len() {
                                var imp: types.ImportBinding = tc.imports[ii]

                                if imp.Alias == moduleAlias {
                                    mut var si: int = 0

                                    while si < imp.Module.Structs.len() {
                                        var s: types.StructInfo = imp.Module.Structs[si]

                                        if s.Name == name {
                                            mut var fi: int = 0

                                            while fi < s.Fields.len() {
                                                var f: types.StructFieldInfo = s.Fields[fi]

                                                if f.Name == fa.Field.Value {
                                                    return Some(
                                                        qualifyImportedType(
                                                            f.Type,
                                                            &moduleAlias,
                                                            &imp,
                                                        ),
                                                    )
                                                }

                                                fi = fi + 1
                                            }
                                        }

                                        si = si + 1
                                    }

                                    mut var ei: int = 0

                                    while ei < imp.Module.Enums.len() {
                                        var e: types.EnumInfo = imp.Module.Enums[ei]

                                        if e.Name == name {
                                            // Enum variant lookup here is copy-heavy and has triggered
                                            // bootstrap crashes. For type inference, `EnumType.Variant`
                                            // always has type `EnumType`, so return it directly.
                                            return Some(t)
                                        }

                                        ei = ei + 1
                                    }
                                }

                                ii = ii + 1
                            }
                        }

                        var si: Option<&types.StructInfo> = tc.findStruct(&st.Name)

                        switch si {
                            case Some(info) {
                                mut var fi: int = 0

                                while fi < (*info).Fields.len() {
                                    if strings.compare(
                                        &((*info).Fields[fi]).Name,
                                        &fa.Field.Value,
                                    ) == 0 {
                                        return Some(tc.resolveType(&((*info).Fields[fi]).Type))
                                    }

                                    fi = fi + 1
                                }
                            }
                            case None {
                            }
                        }

                        switch tc.findEnum(&st.Name) {
                            case Some(_) {
                                // Same rationale as imported enums above.
                                return Some(t)
                            }
                            case None {
                            }
                        }

                        mut var ii2: int = 0

                        while ii2 < tc.imports.len() {
                            var imp2: types.ImportBinding = tc.imports[ii2]
                            mut var si2: int = 0

                            while si2 < imp2.Module.Structs.len() {
                                var s2: types.StructInfo = imp2.Module.Structs[si2]

                                if s2.Name == st.Name {
                                    mut var fi2: int = 0

                                    while fi2 < s2.Fields.len() {
                                        var f2: types.StructFieldInfo = s2.Fields[fi2]

                                        if f2.Name == fa.Field.Value {
                                            return Some(
                                                qualifyImportedType(
                                                    f2.Type,
                                                    &imp2.Alias,
                                                    &imp2,
                                                ),
                                            )
                                        }

                                        fi2 = fi2 + 1
                                    }
                                }

                                si2 = si2 + 1
                            }

                            ii2 = ii2 + 1
                        }
                    }
                    default {
                    }
                }
            }
            case None {
            }
        }

        return None
    }

    mut func inferIndexExpression(
        ix: ast.IndexExpression,
    ) -> (Option<ast.TypeExpression>) {
        var leftType: Option<ast.TypeExpression> = tc.inferType(ix.Left)

        tc.inferType(ix.Index)

        switch leftType {
            case Some(t) {
                switch tc.resolveType(&t) {
                    case ast.TypeExpression.Generic(gt) {
                        if gt.Name == "Vec" && gt.TypeParams.len() >= 1 {
                            return Some(gt.TypeParams[0])
                        }

                        if gt.Name == "Vec" {
                            return None
                        }
                    }
                    case ast.TypeExpression.Simple(st) {
                        if st.Name == "string" {
                            return Some(
                                ast.TypeExpression.Simple(
                                    ast.SimpleType{
                                        Name:  "char",
                                        Token: ix.Token,
                                    },
                                ),
                            )
                        }

                        if st.Name == "Range" {
                            return Some(
                                ast.TypeExpression.Simple(
                                    ast.SimpleType{
                                        Name:  "int",
                                        Token: ix.Token,
                                    },
                                ),
                            )
                        }
                    }
                    default {
                    }
                }
            }
            case None {
            }
        }

        return None
    }

    mut func inferMethodCall(
        mc: ast.MethodCallExpression,
    ) -> (Option<ast.TypeExpression>) {
        // Vec constructor calls: Vec.new(), Vec.from(...)
        switch mc.Object {
            case ast.Expression.Identifier(id) {
                if id.Value == "Vec" {
                    return Some(
                        ast.TypeExpression.Generic(
                            ast.GenericType{
                                Name:       "Vec",
                                Token:      mc.Token,
                                TypeParams: Vec.new(),
                            },
                        ),
                    )
                }
            }
            default {
            }
        }

        mut var receiverName: string = ""

        switch mc.Object {
            case ast.Expression.Identifier(id) {
                receiverName = id.Value
            }
            case ast.Expression.MutableIdentifier(id) {
                receiverName = id.Value
            }
            default {
            }
        }

        var objType: Option<ast.TypeExpression> = tc.inferType(mc.Object)

        switch objType {
            case Some(t) {
                return tc.inferMethodCallOnType(
                    mc,
                    t,
                    receiverName,
                )
            }
            case None {
                // If the object type is unknown, check if it's a module alias.
                // If so, treat it as a function call.
                switch mc.Object {
                    case ast.Expression.Identifier(id) {
                        if tc.isModuleAlias(&id.Value) {
                            if id.Value == "thread" {
                                if mc.Method.Value == "spawn" {
                                    if mc.Arguments.len() < 1 {
                                        tc.reportError(
                                            mc.Token,
                                            "spawn requires at least a function argument",
                                        )

                                        return None
                                    }

                                    var fnArg: ast.Expression = mc.Arguments[0]
                                    var fnTypeOpt: Option<ast.TypeExpression> = tc.inferType(fnArg)

                                    switch fnTypeOpt {
                                        case Some(fnType) {
                                            switch fnType {
                                                case ast.TypeExpression.Function(ft) {
                                                    if mc.Arguments.len() - 1 != ft.Parameters.len() {
                                                        tc.reportError(
                                                            mc.Token,
                                                            "spawn argument count mismatch",
                                                        )
                                                    } else {
                                                        mut var i: int = 0

                                                        while i < ft.Parameters.len() {
                                                            var argExpr: ast.Expression = mc.Arguments[i + 1]
                                                            var argType: Option<ast.TypeExpression> = tc.inferType(argExpr)

                                                            switch argType {
                                                                case Some(at) {
                                                                    if !tc.typesMatch(
                                                                        ft.Parameters[i],
                                                                        at,
                                                                    ) {
                                                                        tc.emit(
                                                                            diag.TypeMismatch(
                                                                                mc.Token.Line,
                                                                                mc.Token.Column,
                                                                                tc.typeToString(ft.Parameters[i]),
                                                                                tc.typeToString(at),
                                                                                "spawn argument " + (i + 1).toString(),
                                                                            ),
                                                                        )
                                                                    }
                                                                }
                                                                case None {
                                                                }
                                                            }

                                                            tc.trackMoveFromExpression(
                                                                argExpr,
                                                                mc.Token.Line,
                                                                mc.Token.Column,
                                                                "moved by spawn",
                                                            )
                                                            i = i + 1
                                                        }
                                                    }
                                                }
                                                default {
                                                    tc.reportError(
                                                        mc.Token,
                                                        "spawn expects a function as first argument",
                                                    )
                                                }
                                            }
                                        }
                                        case None {
                                        }
                                    }

                                    return Some(
                                        ast.TypeExpression.Simple(
                                            ast.SimpleType{
                                                Name:  "thread.Thread",
                                                Token: mc.Token,
                                            },
                                        ),
                                    )
                                }

                                if mc.Method.Value == "sleep" {
                                    if mc.Arguments.len() != 1 {
                                        tc.reportError(
                                            mc.Token,
                                            "sleep expects exactly 1 argument (ms)",
                                        )
                                    } else {
                                        var argType: Option<ast.TypeExpression> = tc.inferType(mc.Arguments[0])
                                        var expected: ast.TypeExpression = ast.TypeExpression.Simple(
                                            ast.SimpleType{
                                                Name:  "int",
                                                Token: mc.Token,
                                            },
                                        )

                                        switch argType {
                                            case Some(at) {
                                                if !tc.typesMatch(
                                                    expected,
                                                    at,
                                                ) {
                                                    tc.emit(
                                                        diag.TypeMismatch(
                                                            mc.Token.Line,
                                                            mc.Token.Column,
                                                            tc.typeToString(expected),
                                                            tc.typeToString(at),
                                                            "sleep ms",
                                                        ),
                                                    )
                                                }
                                            }
                                            case None {
                                            }
                                        }
                                    }

                                    return Some(
                                        ast.TypeExpression.Simple(
                                            ast.SimpleType{
                                                Name:  "void",
                                                Token: mc.Token,
                                            },
                                        ),
                                    )
                                }

                                if mc.Method.Value == "current_id" {
                                    if mc.Arguments.len() != 0 {
                                        tc.reportError(
                                            mc.Token,
                                            "current_id expects no arguments",
                                        )
                                    }

                                    return Some(
                                        ast.TypeExpression.Simple(
                                            ast.SimpleType{
                                                Name:  "int",
                                                Token: mc.Token,
                                            },
                                        ),
                                    )
                                }
                            }

                            switch tc.importedFunctionSig(
                                id.Value,
                                mc.Method.Value,
                            ) {
                                case Some(sig) {
                                    tc.checkCallArgs(
                                        sig,
                                        mc.Arguments,
                                        mc.Token,
                                        id.Value + "." + mc.Method.Value,
                                    )

                                    return Some(sig.ReturnType)
                                }
                                case None {
                                    // If not found in module, check arguments anyway to mark usages
                                    for arg in mc.Arguments {
                                        tc.inferType(arg)
                                    }

                                    tc.emit(
                                        diag.SimpleError(
                                            diag.ErrUndefinedFunction,
                                            "undefined function: " + mc.Method.Value,
                                            mc.Token.Line,
                                            mc.Token.Column,
                                        ),
                                    )
                                }
                            }
                        }
                    }
                    default {
                    }
                }

                return None
            }
        }
    }

    mut func inferMethodCallOnType(
        mc: ast.MethodCallExpression,
        t: ast.TypeExpression,
        receiverName: string,
    ) -> (Option<ast.TypeExpression>) {
        switch tc.resolveType(&t) {
            case ast.TypeExpression.Generic(gt) {
                if gt.Name == "Vec" {
                    return tc.inferVecMethod(
                        mc,
                        gt,
                        receiverName,
                    )
                }
            }
            case ast.TypeExpression.Simple(st) {
                if st.Name == "string" {
                    return tc.inferStringMethod(mc)
                }

                if st.Name == "char" || tc.isIntType(ast.TypeExpression.Simple(st)) || tc.isFloatType(ast.TypeExpression.Simple(st)) {
                    return tc.inferNumericMethod(mc)
                }

                var si: Option<&types.StructInfo> = tc.findStruct(&st.Name)

                switch si {
                    case Some(info) {
                        return tc.inferStructMethod(
                            mc,
                            info,
                            receiverName,
                        )
                    }
                    case None {
                        // Check imported structs
                        var isi: Option<types.StructInfo> = tc.findImportedStruct(st.Name)

                        switch isi {
                            case Some(info) {
                                return tc.inferStructMethod(
                                    mc,
                                    &info,
                                    receiverName,
                                )
                            }
                            case None {
                            }
                        }
                    }
                }
            }
            case ast.TypeExpression.BorrowRef(bt) {
                return tc.inferMethodCallOnType(
                    mc,
                    bt.Inner,
                    receiverName,
                )
            }
            case ast.TypeExpression.BoxRef(bt) {
                return tc.inferMethodCallOnType(
                    mc,
                    bt.Inner,
                    receiverName,
                )
            }
            default {
            }
        }

        return None
    }

    mut func inferStructMethod(
        mc: ast.MethodCallExpression,
        info: &types.StructInfo,
        receiverName: string,
    ) -> (Option<ast.TypeExpression>) {
        for m in (*info).Methods {
            if m.Name == mc.Method.Value {
                if m.Visibility == ast.Visibility.Private {
                    // Start of rudimentary visibility check
                    // If the struct name is fully qualified (contains '.'), it implies it's imported.
                    // Private methods on imported types are not accessible.
                    if (*info).Name.contains(".") {
                        tc.emit(
                            diag.SimpleError(
                                diag.ErrVisibility,
                                "method '" + mc.Method.Value + "' is private",
                                mc.Token.Line,
                                mc.Token.Column,
                            ),
                        )
                    }
                }

                if m.Mutable && receiverName != "" {
                    mut var isMutable: bool = false

                    switch tc.env.Lookup(&receiverName) {
                        case Some(sym) {
                            if sym.Mutable {
                                isMutable = true
                            } else {
                                switch sym.Type {
                                    case Some(t) {
                                        switch t {
                                            case ast.TypeExpression.BorrowRef(bt) {
                                                if bt.Mutable {
                                                    isMutable = true
                                                }
                                            }
                                            default {
                                            }
                                        }
                                    }
                                    case None {
                                    }
                                }
                            }
                        }
                        case None {
                        }
                    }

                    if !isMutable {
                        tc.emit(
                            diag.MutabilityRequired(
                                receiverName,
                                mc.Token.Line,
                                mc.Token.Column,
                                "call '" + mc.Method.Value + "'",
                            ),
                        )
                    }
                }

                tc.checkCallArgs(
                    m.Sig,
                    mc.Arguments,
                    mc.Token,
                    (*info).Name + "." + mc.Method.Value,
                )

                return Some(m.Sig.ReturnType)
            }
        }

        return None
    }

    mut func inferStringMethod(
        mc: ast.MethodCallExpression,
    ) -> (Option<ast.TypeExpression>) {
        var name: string = mc.Method.Value

        if name == "len" {
            return Some(
                ast.TypeExpression.Simple(
                    ast.SimpleType{
                        Name:  "int",
                        Token: mc.Token,
                    },
                ),
            )
        }

        if name == "bytes" {
            mut var params: Vec<ast.TypeExpression, _> = Vec.new()

            params.push(
                ast.TypeExpression.Simple(
                    ast.SimpleType{
                        Name:  "int",
                        Token: mc.Token,
                    },
                ),
            )
            params.push(
                ast.TypeExpression.Size(
                    ast.SizeExpression{
                        IsDynamic: true,
                        Token:     mc.Token,
                        Value:     0,
                    },
                ),
            )

            return Some(
                ast.TypeExpression.Generic(
                    ast.GenericType{
                        Name:       "Vec",
                        Token:      mc.Token,
                        TypeParams: params,
                    },
                ),
            )
        }

        if name == "chars" {
            mut var params: Vec<ast.TypeExpression, _> = Vec.new()

            params.push(
                ast.TypeExpression.Simple(
                    ast.SimpleType{
                        Name:  "char",
                        Token: mc.Token,
                    },
                ),
            )
            params.push(
                ast.TypeExpression.Size(
                    ast.SizeExpression{
                        IsDynamic: true,
                        Token:     mc.Token,
                        Value:     0,
                    },
                ),
            )

            return Some(
                ast.TypeExpression.Generic(
                    ast.GenericType{
                        Name:       "Vec",
                        Token:      mc.Token,
                        TypeParams: params,
                    },
                ),
            )
        }

        if name == "hash" {
            return Some(
                ast.TypeExpression.Simple(
                    ast.SimpleType{
                        Name:  "int",
                        Token: mc.Token,
                    },
                ),
            )
        }

        if name == "parseInt" {
            mut var params: Vec<ast.TypeExpression, _> = Vec.new()

            params.push(
                ast.TypeExpression.Simple(
                    ast.SimpleType{
                        Name:  "int",
                        Token: mc.Token,
                    },
                ),
            )
            params.push(
                ast.TypeExpression.Simple(
                    ast.SimpleType{
                        Name:  "string",
                        Token: mc.Token,
                    },
                ),
            )

            return Some(
                ast.TypeExpression.Generic(
                    ast.GenericType{
                        Name:       "Result",
                        Token:      mc.Token,
                        TypeParams: params,
                    },
                ),
            )
        }

        if name == "parseFloat" {
            mut var params: Vec<ast.TypeExpression, _> = Vec.new()

            params.push(
                ast.TypeExpression.Simple(
                    ast.SimpleType{
                        Name:  "float64",
                        Token: mc.Token,
                    },
                ),
            )
            params.push(
                ast.TypeExpression.Simple(
                    ast.SimpleType{
                        Name:  "string",
                        Token: mc.Token,
                    },
                ),
            )

            return Some(
                ast.TypeExpression.Generic(
                    ast.GenericType{
                        Name:       "Result",
                        Token:      mc.Token,
                        TypeParams: params,
                    },
                ),
            )
        }

        if name == "substring" {
            return Some(
                ast.TypeExpression.Simple(
                    ast.SimpleType{
                        Name:  "string",
                        Token: mc.Token,
                    },
                ),
            )
        }

        if name == "indexOf" || name == "lastIndexOf" {
            mut var params: Vec<ast.TypeExpression, _> = Vec.new()

            params.push(
                ast.TypeExpression.Simple(
                    ast.SimpleType{
                        Name:  "int",
                        Token: mc.Token,
                    },
                ),
            )

            return Some(
                ast.TypeExpression.Generic(
                    ast.GenericType{
                        Name:       "Option",
                        Token:      mc.Token,
                        TypeParams: params,
                    },
                ),
            )
        }

        if name == "startsWith" || name == "endsWith" || name == "contains" {
            return Some(
                ast.TypeExpression.Simple(
                    ast.SimpleType{
                        Name:  "bool",
                        Token: mc.Token,
                    },
                ),
            )
        }

        if name == "parseFloat" {
            mut var params: Vec<ast.TypeExpression, _> = Vec.new()

            params.push(
                ast.TypeExpression.Simple(
                    ast.SimpleType{
                        Name:  "float64",
                        Token: mc.Token,
                    },
                ),
            )
            params.push(
                ast.TypeExpression.Simple(
                    ast.SimpleType{
                        Name:  "string",
                        Token: mc.Token,
                    },
                ),
            )

            return Some(
                ast.TypeExpression.Generic(
                    ast.GenericType{
                        Name:       "Result",
                        Token:      mc.Token,
                        TypeParams: params,
                    },
                ),
            )
        }

        if name == "parseInt" {
            mut var params: Vec<ast.TypeExpression, _> = Vec.new()

            params.push(
                ast.TypeExpression.Simple(
                    ast.SimpleType{
                        Name:  "int",
                        Token: mc.Token,
                    },
                ),
            )
            params.push(
                ast.TypeExpression.Simple(
                    ast.SimpleType{
                        Name:  "string",
                        Token: mc.Token,
                    },
                ),
            )

            return Some(
                ast.TypeExpression.Generic(
                    ast.GenericType{
                        Name:       "Result",
                        Token:      mc.Token,
                        TypeParams: params,
                    },
                ),
            )
        }

        return None
    }

    mut func inferNumericMethod(
        mc: ast.MethodCallExpression,
    ) -> (Option<ast.TypeExpression>) {
        if mc.Method.Value == "toString" {
            return Some(
                ast.TypeExpression.Simple(
                    ast.SimpleType{
                        Name:  "string",
                        Token: mc.Token,
                    },
                ),
            )
        }

        return None
    }

    mut func inferVecMethod(
        mc: ast.MethodCallExpression,
        gt: ast.GenericType,
        receiverName: string,
    ) -> (Option<ast.TypeExpression>) {
        var method: string = mc.Method.Value
        mut var elemType: Option<ast.TypeExpression> = None

        if gt.TypeParams.len() >= 1 {
            elemType = Some(gt.TypeParams[0])
        }

        mut var isFixedSize: bool = false

        if gt.TypeParams.len() >= 2 {
            switch gt.TypeParams[1] {
                case ast.TypeExpression.Size(se) {
                    isFixedSize = !se.IsDynamic
                }
                default {
                }
            }
        }

        if isFixedSize && (method == "push" || method == "pop" || method == "append" || method == "remove" || method == "cap") {
            tc.emit(
                diag.VecDynamicOnlyMethod(
                    method,
                    tc.typeToString(ast.TypeExpression.Generic(gt)),
                    mc.Token.Line,
                    mc.Token.Column,
                ),
            )

            return None
        }

        if receiverName != "" && (method == "push" || method == "append" || method == "pop" || method == "remove" || method == "clear" || method == "reverse") {
            switch tc.env.IsMutable(receiverName) {
                case Some(isMutable) {
                    if !isMutable {
                        tc.emit(
                            diag.VecMutatingMethodOnImmutable(
                                receiverName,
                                method,
                                mc.Token.Line,
                                mc.Token.Column,
                            ),
                        )
                    }
                }
                case None {
                }
            }
        }

        if method == "len" || method == "cap" {
            return Some(
                ast.TypeExpression.Simple(
                    ast.SimpleType{
                        Name:  "int",
                        Token: mc.Token,
                    },
                ),
            )
        }

        if method == "push" || method == "append" || method == "clear" || method == "reverse" {
            return Some(ast.TypeExpression.Void(ast.VoidType{Token: mc.Token}))
        }

        if method == "pop" || method == "remove" || method == "first" || method == "last" || method == "get" {
            switch elemType {
                case Some(et) {
                    mut var params: Vec<ast.TypeExpression, _> = Vec.new()

                    params.push(et)

                    return Some(
                        ast.TypeExpression.Generic(
                            ast.GenericType{
                                Name:       "Option",
                                Token:      mc.Token,
                                TypeParams: params,
                            },
                        ),
                    )
                }
                case None {
                    return Some(
                        ast.TypeExpression.Generic(
                            ast.GenericType{
                                Name:       "Option",
                                Token:      mc.Token,
                                TypeParams: Vec.new(),
                            },
                        ),
                    )
                }
            }
        }

        if method == "contains" || method == "isEmpty" || method == "is_empty" {
            return Some(
                ast.TypeExpression.Simple(
                    ast.SimpleType{
                        Name:  "bool",
                        Token: mc.Token,
                    },
                ),
            )
        }

        if method == "join" {
            return Some(
                ast.TypeExpression.Simple(
                    ast.SimpleType{
                        Name:  "string",
                        Token: mc.Token,
                    },
                ),
            )
        }

        if method == "slice" || method == "to_vec" {
            mut var params: Vec<ast.TypeExpression, _> = Vec.new()

            switch elemType {
                case Some(et) {
                    params.push(et)
                }
                case None {
                }
            }

            params.push(
                ast.TypeExpression.Size(
                    ast.SizeExpression{
                        IsDynamic: true,
                        Token:     mc.Token,
                        Value:     0,
                    },
                ),
            )

            return Some(
                ast.TypeExpression.Generic(
                    ast.GenericType{
                        Name:       "Vec",
                        Token:      mc.Token,
                        TypeParams: params,
                    },
                ),
            )
        }

        return None
    }

    mut func inferCallExpression(
        ce: ast.CallExpression,
    ) -> (Option<ast.TypeExpression>) {
        mut var funcName: string = ""
        mut var sig: Option<types.FunctionSig> = None

        switch ce.Function {
            case ast.Expression.Identifier(id) {
                funcName = id.Value
                sig = tc.findFunctionSig(&funcName)
            }
            case ast.Expression.FieldAccess(fa) {
                mut var objName: string = ""
                mut var objExpr: Option<ast.Expression> = None

                switch fa.Object {
                    case ast.Expression.Identifier(id) {
                        objName = id.Value
                        objExpr = Some(fa.Object)
                    }
                    case ast.Expression.MutableIdentifier(id) {
                        objName = id.Value
                        objExpr = Some(fa.Object)
                    }
                    default {
                    }
                }

                if objName != "" {
                    if objName == "thread" && fa.Field.Value == "spawn" {
                        if ce.Arguments.len() < 1 {
                            tc.reportError(
                                ce.Token,
                                "spawn requires at least a function argument",
                            )

                            return None
                        }

                        // Check function argument
                        var fnArg: ast.Expression = ce.Arguments[0]
                        var fnTypeOpt: Option<ast.TypeExpression> = tc.inferType(fnArg)

                        switch fnTypeOpt {
                            case Some(fnType) {
                                switch fnType {
                                    case ast.TypeExpression.Function(ft) {
                                        if ce.Arguments.len() - 1 != ft.Parameters.len() {
                                            tc.reportError(
                                                ce.Token,
                                                "spawn argument count mismatch",
                                            )
                                        } else {
                                            mut var i: int = 0

                                            while i < ft.Parameters.len() {
                                                var argExpr: ast.Expression = ce.Arguments[i + 1]
                                                var argType: Option<ast.TypeExpression> = tc.inferType(argExpr)

                                                switch argType {
                                                    case Some(at) {
                                                        if !tc.typesMatch(
                                                            ft.Parameters[i],
                                                            at,
                                                        ) {
                                                            tc.emit(
                                                                diag.TypeMismatch(
                                                                    ce.Token.Line,
                                                                    ce.Token.Column,
                                                                    tc.typeToString(ft.Parameters[i]),
                                                                    tc.typeToString(at),
                                                                    "spawn argument " + (i + 1).toString(),
                                                                ),
                                                            )
                                                        }
                                                    }
                                                    case None {
                                                    }
                                                }

                                                tc.trackMoveFromExpression(
                                                    argExpr,
                                                    ce.Token.Line,
                                                    ce.Token.Column,
                                                    "moved by spawn",
                                                )
                                                i = i + 1
                                            }
                                        }
                                    }
                                    default {
                                        tc.reportError(
                                            ce.Token,
                                            "spawn expects a function as first argument",
                                        )
                                    }
                                }
                            }
                            case None {
                            }
                        }

                        return Some(
                            ast.TypeExpression.Simple(
                                ast.SimpleType{
                                    Name:  "thread.Thread",
                                    Token: ce.Token,
                                },
                            ),
                        )
                    }

                    funcName = objName + "." + fa.Field.Value
                    sig = tc.importedFunctionSig(
                        objName,
                        fa.Field.Value,
                    )

                    // Fallback: Struct method?
                    switch sig {
                        case None {
                            switch objExpr {
                                case Some(expr) {
                                    // Infer object type
                                    var objType: Option<ast.TypeExpression> = tc.inferType(expr)

                                    switch objType {
                                        case Some(t) {
                                            mut var base: ast.TypeExpression = tc.resolveType(&t)

                                            switch base {
                                                case ast.TypeExpression.BorrowRef(bt) {
                                                    base = bt.Inner
                                                }
                                                case ast.TypeExpression.BoxRef(bxt) {
                                                    base = bxt.Inner
                                                }
                                                default {
                                                }
                                            }

                                            switch base {
                                                case ast.TypeExpression.Simple(st) {
                                                    switch tc.findStruct(&st.Name) {
                                                        case Some(info) {
                                                            for m in (*info).Methods {
                                                                if m.Name == fa.Field.Value {
                                                                    sig = Some(m.Sig)
                                                                }
                                                            }
                                                        }
                                                        case None {
                                                            switch tc.findImportedStruct(st.Name) {
                                                                case Some(info2) {
                                                                    for m in info2.Methods {
                                                                        if m.Name == fa.Field.Value {
                                                                            sig = Some(m.Sig)
                                                                        }
                                                                    }
                                                                }
                                                                case None {
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                                default {
                                                }
                                            }
                                        }
                                        case None {
                                        }
                                    }
                                }
                                case None {
                                }
                            }
                        }
                        case Some(_) {
                        }
                    }
                }
            }
            default {
            }
        }

        switch sig {
            case Some(s) {
                tc.checkCallArgs(
                    s,
                    ce.Arguments,
                    ce.Token,
                    funcName,
                )
                tc.trackMovesFromArgs(
                    s,
                    ce.Arguments,
                    ce.Token,
                    funcName,
                )

                return Some(s.ReturnType)
            }
            case None {
                for arg in ce.Arguments {
                    tc.inferType(arg)
                }

                // Clear any temporary borrows introduced by & or &mut in arguments
                for arg in ce.Arguments {
                    switch arg {
                        case ast.Expression.Borrow(be) {
                            if be.Mutable {
                                switch be.Value {
                                    case ast.Expression.Identifier(id) {
                                        tc.env.ClearBorrowedMut(id.Value)
                                    }
                                    case ast.Expression.MutableIdentifier(id) {
                                        tc.env.ClearBorrowedMut(id.Value)
                                    }
                                    default {
                                    }
                                }
                            } else {
                                switch be.Value {
                                    case ast.Expression.Identifier(id) {
                                        tc.env.ClearBorrowedIm(id.Value)
                                    }
                                    case ast.Expression.MutableIdentifier(id) {
                                        tc.env.ClearBorrowedIm(id.Value)
                                    }
                                    default {
                                    }
                                }
                            }
                        }
                        default {
                        }
                    }
                }

                return None
            }
        }
    }

    mut func checkCallArgs(
        sig: types.FunctionSig,
        args: Vec<ast.Expression, _>,
        tok: token.Token,
        funcName: string,
    ) -> (void) {
        // Skip arity/type enforcement for registered builtins (variadic or runtime-provided).
        mut var isBuiltin: bool = false

        for n in tc.builtinNames {
            if n == funcName {
                isBuiltin = true
                break
            }
        }

        if isBuiltin {
            for arg in args {
                tc.inferType(arg)
            }

            // Clear any temporary borrows introduced by & or &mut in arguments
            mut var j: int = 0

            while j < args.len() {
                switch args[j] {
                    case ast.Expression.Borrow(be) {
                        if be.Mutable {
                            switch be.Value {
                                case ast.Expression.Identifier(id) {
                                    tc.env.ClearBorrowedMut(id.Value)
                                }
                                case ast.Expression.MutableIdentifier(id) {
                                    tc.env.ClearBorrowedMut(id.Value)
                                }
                                default {
                                }
                            }
                        } else {
                            switch be.Value {
                                case ast.Expression.Identifier(id) {
                                    tc.env.ClearBorrowedIm(id.Value)
                                }
                                case ast.Expression.MutableIdentifier(id) {
                                    tc.env.ClearBorrowedIm(id.Value)
                                }
                                default {
                                }
                            }
                        }
                    }
                    default {
                    }
                }

                j = j + 1
            }

            return
        }

        // Emit argument-count diagnostic if lengths differ, but still
        // infer all argument expressions so usage tracking remains correct.
        if args.len() != sig.Params.len() {
            tc.emit(
                diag.SimpleError(
                    diag.ErrArgumentCount,
                    "expected " + sig.Params.len().toString() + " arguments but got " + args.len().toString(),
                    tok.Line,
                    tok.Column,
                ),
            )
        }

        mut var i: int = 0

        while i < args.len() {
            if i < sig.Params.len() {
                var argType: Option<ast.TypeExpression> = tc.inferType(args[i])

                switch argType {
                    case Some(at) {
                        if !tc.typesMatch(
                            sig.Params[i],
                            at,
                        ) {
                            tc.emit(
                                diag.TypeMismatch(
                                    tok.Line,
                                    tok.Column,
                                    tc.typeToString(sig.Params[i]),
                                    tc.typeToString(at),
                                    "argument " + (i + 1).toString() + " to '" + funcName + "'",
                                ),
                            )
                        }
                    }
                    case None {
                    }
                }
            } else {
                tc.inferType(args[i])
            }

            i = i + 1
        }

        // After checking arguments, clear any temporary borrows introduced
        mut var j: int = 0

        while j < args.len() {
            switch args[j] {
                case ast.Expression.Borrow(be) {
                    if be.Mutable {
                        switch be.Value {
                            case ast.Expression.Identifier(id) {
                                tc.env.ClearBorrowedMut(id.Value)
                            }
                            case ast.Expression.MutableIdentifier(id) {
                                tc.env.ClearBorrowedMut(id.Value)
                            }
                            default {
                            }
                        }
                    } else {
                        switch be.Value {
                            case ast.Expression.Identifier(id) {
                                tc.env.ClearBorrowedIm(id.Value)
                            }
                            case ast.Expression.MutableIdentifier(id) {
                                tc.env.ClearBorrowedIm(id.Value)
                            }
                            default {
                            }
                        }
                    }
                }
                default {
                }
            }

            j = j + 1
        }

        return
    }

    mut func trackMovesFromArgs(
        sig: types.FunctionSig,
        args: Vec<ast.Expression, _>,
        tok: token.Token,
        funcName: string,
    ) -> (void) {
        mut var i: int = 0

        while i < args.len() {
            if i < sig.Params.len() {
                switch sig.Params[i] {
                    case ast.TypeExpression.BorrowRef(_) {
                    }
                    // borrows don't move
                    default {
                        tc.trackMoveFromExpression(
                            args[i],
                            tok.Line,
                            tok.Column,
                            "moved by call to " + funcName,
                        )
                    }
                }
            }

            i = i + 1
        }

        return
    }

    mut func inferInfixType(
        ie: ast.InfixExpression,
    ) -> (Option<ast.TypeExpression>) {
        var leftType: Option<ast.TypeExpression> = tc.inferType(ie.Left)
        var rightType: Option<ast.TypeExpression> = tc.inferType(ie.Right)

        switch leftType {
            case Some(lt) {
                switch rightType {
                    case Some(rt) {
                        return tc.inferInfixKnown(
                            ie,
                            lt,
                            rt,
                        )
                    }
                    case None {
                    }
                }
            }
            case None {
            }
        }

        return None
    }

    mut func inferInfixKnown(
        ie: ast.InfixExpression,
        leftType: ast.TypeExpression,
        rightType: ast.TypeExpression,
    ) -> (Option<ast.TypeExpression>) {
        var op: string = ie.Operator

        if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" {
            if tc.isNumericType(leftType) && tc.isNumericType(rightType) {
                if tc.isIntegerType(leftType) && tc.isIntegerType(rightType) {
                    if !tc.sameConcreteType(
                        leftType,
                        rightType,
                    ) {
                        switch tc.integerConstValue(ie.Left) {
                            case Some(v) {
                                if tc.fitsInIntegerType(
                                    v,
                                    rightType,
                                ) {
                                    return Some(rightType)
                                }
                            }
                            case None {
                            }
                        }

                        switch tc.integerConstValue(ie.Right) {
                            case Some(v) {
                                if tc.fitsInIntegerType(
                                    v,
                                    leftType,
                                ) {
                                    return Some(leftType)
                                }
                            }
                            case None {
                            }
                        }

                        var msg: string = "arithmetic operands must have the same integer type"

                        tc.emit(
                            diag.SimpleError(
                                diag.ErrTypeMismatch,
                                msg,
                                ie.Token.Line,
                                ie.Token.Column,
                            ),
                        )

                        return Some(
                            ast.TypeExpression.Error(
                                ast.ErrorType{
                                    Message: "type error",
                                    Token:   ie.Token,
                                },
                            ),
                        )
                    }

                    return Some(leftType)
                }

                if tc.isFloatType(leftType) && tc.isFloatType(rightType) {
                    if !tc.typesMatch(
                        leftType,
                        rightType,
                    ) {
                        var msg: string = "arithmetic operands must have the same float type"

                        tc.emit(
                            diag.SimpleError(
                                diag.ErrTypeMismatch,
                                msg,
                                ie.Token.Line,
                                ie.Token.Column,
                            ),
                        )

                        return Some(
                            ast.TypeExpression.Error(
                                ast.ErrorType{
                                    Message: "type error",
                                    Token:   ie.Token,
                                },
                            ),
                        )
                    }

                    return Some(leftType)
                }

                tc.emit(
                    diag.SimpleError(
                        diag.ErrTypeMismatch,
                        "arithmetic operands must be numeric or (for '+') both strings",
                        ie.Token.Line,
                        ie.Token.Column,
                    ),
                )

                return Some(
                    ast.TypeExpression.Error(
                        ast.ErrorType{
                            Message: "type error",
                            Token:   ie.Token,
                        },
                    ),
                )
            }

            if tc.isStringType(leftType) && tc.isStringType(rightType) && op == "+" {
                return Some(leftType)
            }

            tc.emit(
                diag.SimpleError(
                    diag.ErrTypeMismatch,
                    "arithmetic operands must be numeric or (for '+') both strings",
                    ie.Token.Line,
                    ie.Token.Column,
                ),
            )

            return Some(
                ast.TypeExpression.Error(
                    ast.ErrorType{
                        Message: "type error",
                        Token:   ie.Token,
                    },
                ),
            )
        }

        if op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" {
            return Some(
                ast.TypeExpression.Simple(
                    ast.SimpleType{
                        Name:  "bool",
                        Token: ie.Token,
                    },
                ),
            )
        }

        if op == "&&" || op == "||" {
            if tc.isBoolType(leftType) && tc.isBoolType(rightType) {
                return Some(
                    ast.TypeExpression.Simple(
                        ast.SimpleType{
                            Name:  "bool",
                            Token: ie.Token,
                        },
                    ),
                )
            }

            tc.emit(
                diag.SimpleError(
                    diag.ErrTypeMismatch,
                    "logical operators require bool operands",
                    ie.Token.Line,
                    ie.Token.Column,
                ),
            )

            return Some(
                ast.TypeExpression.Error(
                    ast.ErrorType{
                        Message: "type error",
                        Token:   ie.Token,
                    },
                ),
            )
        }

        if op == "&" || op == "|" || op == "^" {
            if tc.isIntegerType(leftType) && tc.isIntegerType(rightType) {
                if !tc.sameConcreteType(
                    leftType,
                    rightType,
                ) {
                    switch tc.integerConstValue(ie.Left) {
                        case Some(v) {
                            if tc.fitsInIntegerType(
                                v,
                                rightType,
                            ) {
                                return Some(rightType)
                            }
                        }
                        case None {
                        }
                    }

                    switch tc.integerConstValue(ie.Right) {
                        case Some(v) {
                            if tc.fitsInIntegerType(
                                v,
                                leftType,
                            ) {
                                return Some(leftType)
                            }
                        }
                        case None {
                        }
                    }

                    tc.emit(
                        diag.SimpleError(
                            diag.ErrTypeMismatch,
                            "bitwise operands must have the same integer type",
                            ie.Token.Line,
                            ie.Token.Column,
                        ),
                    )

                    return Some(
                        ast.TypeExpression.Error(
                            ast.ErrorType{
                                Message: "type error",
                                Token:   ie.Token,
                            },
                        ),
                    )
                }

                return Some(leftType)
            }

            tc.emit(
                diag.SimpleError(
                    diag.ErrTypeMismatch,
                    "bitwise operators require integer operands of the same type",
                    ie.Token.Line,
                    ie.Token.Column,
                ),
            )

            return Some(
                ast.TypeExpression.Error(
                    ast.ErrorType{
                        Message: "type error",
                        Token:   ie.Token,
                    },
                ),
            )
        }

        return Some(leftType)
    }

    mut func integerBitWidth(t: ast.TypeExpression) -> (int) {
        var name: string = tc.typeToString(tc.resolveType(&t))

        switch name {
            case "int8", "uint8" {
                return 8
            }
            case "int16", "uint16" {
                return 16
            }
            case "int32", "uint32" {
                return 32
            }
            case "int64", "uint64", "int", "uint" {
                return 64
            }
            default {
                return 0
            }
        }
    }

    mut func integerConstValue(expr: ast.Expression) -> (Option<int>) {
        switch expr {
            case ast.Expression.IntegerLiteral(il) {
                return Some(il.Value)
            }
            case ast.Expression.Prefix(pe) {
                if pe.Operator == "-" {
                    switch tc.integerConstValue(pe.Right) {
                        case Some(v) {
                            return Some(-v)
                        }
                        case None {
                        }
                    }
                }
            }
            case ast.Expression.TypeConversion(tcExpr) {
                return tc.integerConstValue(tcExpr.Value)
            }
            default {
            }
        }

        return None
    }

    mut func fitsInIntegerType(val: int, t: ast.TypeExpression) -> (bool) {
        var name: string = tc.typeToString(tc.resolveType(&t))

        switch name {
            case "int8" {
                return val >= -128 && val <= 127
            }
            case "int16" {
                return val >= -32768 && val <= 32767
            }
            case "int32" {
                return val >= -2147483648 && val <= 2147483647
            }
            case "int64", "int" {
                return true
            }
            case "uint8" {
                return val >= 0 && val <= 255
            }
            case "uint16" {
                return val >= 0 && val <= 65535
            }
            case "uint32" {
                return val >= 0 && val <= 4294967295
            }
            case "uint64", "uint" {
                return val >= 0
            }
            default {
                return false
            }
        }
    }

    mut func inferPrefixType(
        pe: ast.PrefixExpression,
    ) -> (Option<ast.TypeExpression>) {
        var rightType: Option<ast.TypeExpression> = tc.inferType(pe.Right)

        switch rightType {
            case Some(rt) {
                if pe.Operator == "!" {
                    if tc.isBoolType(rt) || tc.isIntegerType(rt) {
                        return Some(rt)
                    }

                    tc.emit(
                        diag.SimpleError(
                            diag.ErrTypeMismatch,
                            "NOT requires bool or integer operand",
                            pe.Token.Line,
                            pe.Token.Column,
                        ),
                    )
                } else if pe.Operator == "-" {
                    if tc.isNumericType(rt) {
                        return Some(rt)
                    }

                    tc.emit(
                        diag.SimpleError(
                            diag.ErrTypeMismatch,
                            "negation requires numeric operand",
                            pe.Token.Line,
                            pe.Token.Column,
                        ),
                    )
                }
            }
            case None {
            }
        }

        return None
    }

    mut func trackMoveFromExpression(
        expr: ast.Expression,
        line: int,
        col: int,
        reason: string,
    ) -> (void) {
        switch expr {
            case ast.Expression.Identifier(id) {
                tc.markMovedIdentifier(
                    id.Value,
                    line,
                    col,
                    reason,
                )
            }
            case ast.Expression.MutableIdentifier(id) {
                tc.markMovedIdentifier(
                    id.Value,
                    line,
                    col,
                    reason,
                )
            }
            case ast.Expression.Tuple(te) {
                for e in te.Elements {
                    tc.trackMoveFromExpression(
                        e,
                        line,
                        col,
                        reason,
                    )
                }
            }
            case ast.Expression.Borrow(_) {
            }
            default {
            }
        }

        return
    }

    mut func markMovedIdentifier(
        name: string,
        line: int,
        col: int,
        reason: string,
    ) -> (void) {
        switch tc.env.Lookup(&name) {
            case Some(sym) {
                switch sym.Type {
                    case Some(t) {
                        if tc.isCopyType(t) {
                            return
                        }
                    }
                    case None {
                    }
                }

                if sym.Moved && !sym.Poisoned {
                    tc.emit(
                        diag.UseAfterMove(
                            name,
                            line,
                            col,
                            sym.MoveLine,
                            sym.MoveColumn,
                            sym.MoveReason,
                        ),
                    )
                    tc.env.MarkPoisoned(name)

                    return
                }

                tc.env.MarkMoved(
                    name,
                    line,
                    col,
                    reason,
                )
            }
            case None {
            }
        }

        return
    }

    mut func resolveType(t: &ast.TypeExpression) -> (ast.TypeExpression) {
        switch *t {
            case ast.TypeExpression.Simple(st) {
                var aliasType: Option<ast.TypeExpression> = tc.lookupAlias(&st.Name)

                switch aliasType {
                    case Some(at) {
                        return tc.resolveType(&at)
                    }
                    case None {
                        return ast.TypeExpression.Simple(st)
                    }
                }
            }
            case ast.TypeExpression.Generic(gt) {
                mut var newParams: Vec<ast.TypeExpression, _> = Vec.new()

                for p in gt.TypeParams {
                    newParams.push(tc.resolveType(&p))
                }

                return ast.TypeExpression.Generic(
                    ast.GenericType{
                        Name:       gt.Name,
                        Token:      gt.Token,
                        TypeParams: newParams,
                    },
                )
            }
            case ast.TypeExpression.BorrowRef(bt) {
                return ast.TypeExpression.BorrowRef(
                    ast.BorrowType{
                        Inner:   tc.resolveType(&bt.Inner),
                        Mutable: bt.Mutable,
                        Token:   bt.Token,
                    },
                )
            }
            case ast.TypeExpression.BoxRef(bt) {
                return ast.TypeExpression.BoxRef(
                    ast.BoxType{
                        Inner: tc.resolveType(&bt.Inner),
                        Token: bt.Token,
                    },
                )
            }
            case ast.TypeExpression.BoxOptional(bt) {
                return ast.TypeExpression.BoxOptional(
                    ast.BoxOptionalType{
                        Inner: tc.resolveType(&bt.Inner),
                        Token: bt.Token,
                    },
                )
            }
            case ast.TypeExpression.TupleRef(tt) {
                mut var elems: Vec<ast.TypeExpression, _> = Vec.new()

                for e in tt.Elements {
                    elems.push(tc.resolveType(&e))
                }

                return ast.TypeExpression.TupleRef(
                    ast.TupleType{
                        Elements: elems,
                        Token:    tt.Token,
                    },
                )
            }
            default {
            }
        }

        return *t
    }

    mut func lookupAlias(name: &string) -> (Option<ast.TypeExpression>) {
        var parts: Vec<string, _> = splitQualifiedName(name)

        if parts.len() == 2 {
            var aliasName: string = parts[0]
            var ident: string = parts[1]
            mut var ii: int = 0

            while ii < tc.imports.len() {
                var imp: types.ImportBinding = tc.imports[ii]

                if imp.Alias == aliasName {
                    mut var ai: int = 0

                    while ai < imp.Module.Aliases.len() {
                        var a: types.AliasInfo = imp.Module.Aliases[ai]

                        if a.Name == ident {
                            return Some(a.Underlying)
                        }

                        ai = ai + 1
                    }
                }

                ii = ii + 1
            }
        }

        mut var i: int = 0

        while i < tc.aliases.len() {
            var a: types.AliasInfo = tc.aliases[i]

            if a.Name == *name {
                return Some(a.Underlying)
            }

            i = i + 1
        }

        return None
    }

    mut func typesMatch(
        expected: ast.TypeExpression,
        actual: ast.TypeExpression,
    ) -> (bool) {
        var exp: ast.TypeExpression = tc.resolveType(&expected)
        var act: ast.TypeExpression = tc.resolveType(&actual)

        if tc.isErrorType(exp) || tc.isErrorType(act) {
            return true
        }

        var expStr: string = tc.typeToString(exp)
        var actStr: string = tc.typeToString(act)

        if expStr == actStr {
            return true
        }

        if tc.isIntType(exp) && tc.isIntType(act) {
            return true
        }

        if tc.isFloatType(exp) && tc.isFloatType(act) {
            return true
        }

        if expStr.startsWith("Vec<") && actStr.startsWith("Vec<") {
            if expStr == "Vec<>" || actStr == "Vec<>" {
                return true
            }

            var expElem: string = vecElementType(&expStr)
            var actElem: string = vecElementType(&actStr)

            if expElem != "" && actElem != "" {
                if stripQualifier(&expElem) == stripQualifier(&actElem) {
                    return true
                }
            }
        }

        if typeBaseMatch(
            &expStr,
            &actStr,
        ) {
            return true
        }

        mut var expParts: Vec<string, _> = splitQualifiedName(&expStr)
        mut var actParts: Vec<string, _> = splitQualifiedName(&actStr)

        if expParts.len() == 2 || actParts.len() == 2 {
            mut var expBase: string = ""

            switch expParts.pop() {
                case Some(s) {
                    expBase = s
                }
                case None {
                }
            }

            mut var actBase: string = ""

            switch actParts.pop() {
                case Some(s) {
                    actBase = s
                }
                case None {
                }
            }

            if expBase == actBase {
                return true
            }
        }

        return false
    }

    mut func sameConcreteType(
        a: ast.TypeExpression,
        b: ast.TypeExpression,
    ) -> (bool) {
        return tc.typeToString(tc.resolveType(&a)) == tc.typeToString(tc.resolveType(&b))
    }

    mut func typeToString(t: ast.TypeExpression) -> (string) {
        switch t {
            case ast.TypeExpression.Simple(st) {
                return st.Name
            }
            case ast.TypeExpression.Generic(gt) {
                mut var parts: Vec<string, _> = Vec.new()

                for p in gt.TypeParams {
                    parts.push(tc.typeToString(p))
                }

                if parts.len() == 0 {
                    return gt.Name + "<>"
                }

                return gt.Name + "<" + join(
                    parts,
                    ", ",
                ) + ">"
            }
            case ast.TypeExpression.BorrowRef(bt) {
                if bt.Mutable {
                    return "&mut " + tc.typeToString(bt.Inner)
                }

                return "&" + tc.typeToString(bt.Inner)
            }
            case ast.TypeExpression.BoxRef(bt) {
                return "Box<" + tc.typeToString(bt.Inner) + ">"
            }
            case ast.TypeExpression.BoxOptional(bt) {
                return "Box?<" + tc.typeToString(bt.Inner) + ">"
            }
            case ast.TypeExpression.Size(se) {
                if se.IsDynamic {
                    return "_"
                }

                return se.Value.toString()
            }
            case ast.TypeExpression.Void(_) {
                return "void"
            }
            case ast.TypeExpression.Error(_) {
                return "<error>"
            }
            case ast.TypeExpression.TupleRef(tt) {
                mut var parts: Vec<string, _> = Vec.new()

                for e in tt.Elements {
                    parts.push(tc.typeToString(e))
                }

                return "(" + join(
                    parts,
                    ", ",
                ) + ")"
            }
        }

        return "<unknown>"
    }

    mut func isErrorType(t: ast.TypeExpression) -> (bool) {
        switch t {
            case ast.TypeExpression.Error(_) {
                return true
            }
            default {
                return false
            }
        }
    }

    mut func isCopyType(t: ast.TypeExpression) -> (bool) {
        var name: string = tc.typeToString(tc.resolveType(&t))

        return name == "int" || name == "int8" || name == "int16" || name == "int32" || name == "int64" || name == "uint" || name == "uint8" || name == "uint16" || name == "uint32" || name == "uint64" || name == "float32" || name == "float64" || name == "bool" || name == "char"
    }

    mut func isNumericType(t: ast.TypeExpression) -> (bool) {
        return tc.isIntType(t) || tc.isFloatType(t)
    }

    mut func isIntType(t: ast.TypeExpression) -> (bool) {
        var name: string = tc.typeToString(tc.resolveType(&t))

        return name == "int" || name == "int8" || name == "int16" || name == "int32" || name == "int64" || name == "uint" || name == "uint8" || name == "uint16" || name == "uint32" || name == "uint64"
    }

    mut func isIntegerType(t: ast.TypeExpression) -> (bool) {
        return tc.isIntType(t)
    }

    mut func isFloatType(t: ast.TypeExpression) -> (bool) {
        var name: string = tc.typeToString(tc.resolveType(&t))

        return name == "float32" || name == "float64"
    }

    mut func isStringType(t: ast.TypeExpression) -> (bool) {
        var name: string = tc.typeToString(tc.resolveType(&t))

        return name == "string"
    }

    mut func isBoolType(t: ast.TypeExpression) -> (bool) {
        var name: string = tc.typeToString(tc.resolveType(&t))

        return name == "bool"
    }

    mut func iterableElementType(
        t: ast.TypeExpression,
    ) -> (Option<ast.TypeExpression>) {
        var res: ast.TypeExpression = tc.resolveType(&t)

        switch res {
            case ast.TypeExpression.BorrowRef(bt) {
                return tc.iterableElementType(bt.Inner)
            }
            case ast.TypeExpression.Generic(gt) {
                if gt.Name == "Vec" && gt.TypeParams.len() >= 1 {
                    return Some(gt.TypeParams[0])
                }
            }
            case ast.TypeExpression.Simple(st) {
                if st.Name == "string" {
                    return Some(
                        ast.TypeExpression.Simple(
                            ast.SimpleType{
                                Name:  "char",
                                Token: st.Token,
                            },
                        ),
                    )
                }

                if st.Name == "Range" {
                    return Some(
                        ast.TypeExpression.Simple(
                            ast.SimpleType{
                                Name:  "int",
                                Token: st.Token,
                            },
                        ),
                    )
                }
            }
            default {
            }
        }

        return None
    }

    mut func importedFunctionSig(
        aliasName: string,
        name: string,
    ) -> (Option<types.FunctionSig>) {
        for imp in tc.imports {
            if imp.Alias == aliasName {
                for f in imp.Module.Functions {
                    if f.Name == name {
                        return Some(f.Sig)
                    }
                }
            }
        }

        return None
    }

    mut func importedConstType(
        aliasName: string,
        name: string,
    ) -> (Option<ast.TypeExpression>) {
        mut var ii: int = 0

        while ii < tc.imports.len() {
            var imp: types.ImportBinding = tc.imports[ii]

            if imp.Alias == aliasName {
                mut var ci: int = 0

                while ci < imp.Module.Consts.len() {
                    var c: types.ConstInfo = imp.Module.Consts[ci]

                    if c.Name == name {
                        return Some(c.Type)
                    }

                    ci = ci + 1
                }

                mut var ei: int = 0

                while ei < imp.Module.Enums.len() {
                    var e: types.EnumInfo = imp.Module.Enums[ei]
                    mut var vi: int = 0

                    while vi < e.Variants.len() {
                        var v: types.EnumVariantInfo = e.Variants[vi]

                        if v.Name == name {
                            return Some(
                                ast.TypeExpression.Simple(
                                    ast.SimpleType{
                                        Name:  e.Name,
                                        Token: tokenNil(),
                                    },
                                ),
                            )
                        }

                        vi = vi + 1
                    }

                    ei = ei + 1
                }
            }

            ii = ii + 1
        }

        return None
    }

    mut func findFunctionSig(name: &string) -> (Option<types.FunctionSig>) {
        mut var i: int = 0

        while i < tc.functions.len() {
            var f: types.FunctionInfo = tc.functions[i]

            if strings.compare(
                &f.Name,
                name,
            ) == 0 {
                return Some(f.Sig)
            }

            i = i + 1
        }

        return None
    }

    mut func findStructIndex(name: string) -> (int) {
        mut var i: int = 0

        while i < tc.structs.len() {
            if (tc.structs[i]).Name == name {
                return i
            }

            i = i + 1
        }

        return -1
    }

    mut func findEnum(name: &string) -> (Option<&types.EnumInfo>) {
        mut var i: int = 0

        while i < tc.enums.len() {
            if strings.compare(
                &(tc.enums[i]).Name,
                name,
            ) == 0 {
                return Some(&tc.enums[i])
            }

            i = i + 1
        }

        return None
    }

    mut func findStruct(name: &string) -> (Option<&types.StructInfo>) {
        mut var i: int = 0

        while i < tc.structs.len() {
            if strings.compare(
                &(tc.structs[i]).Name,
                name,
            ) == 0 {
                return Some(&tc.structs[i])
            }

            i = i + 1
        }

        return None
    }

    mut func findImportedStruct(name: string) -> (Option<types.StructInfo>) {
        var parts: Vec<string, _> = splitQualifiedName(&name)

        if parts.len() == 2 {
            var aliasName: string = parts[0]
            var structName: string = parts[1]
            mut var ii: int = 0

            while ii < tc.imports.len() {
                var imp: types.ImportBinding = tc.imports[ii]

                if imp.Alias == aliasName {
                    mut var si: int = 0

                    while si < imp.Module.Structs.len() {
                        var s: types.StructInfo = imp.Module.Structs[si]

                        if s.Name == structName {
                            return Some(
                                types.StructInfo{
                                    Fields:     s.Fields,
                                    Methods:    s.Methods,
                                    Name:       imp.Alias + "." + s.Name,
                                    Visibility: s.Visibility,
                                },
                            )
                        }

                        si = si + 1
                    }
                }

                ii = ii + 1
            }
        }

        return None
    }
}

func vecElementType(vecType: &string) -> (string) {
    if !vecType.startsWith("Vec<") {
        return ""
    }

    if vecType.len() < 5 {
        return ""
    }

    var inner: string = vecType.substring(
        4,
        vecType.len() - 1,
    )
    var comma: Option<int> = inner.indexOf(",")

    switch comma {
        case Some(idx) {
            return inner.substring(
                0,
                idx,
            )
        }
        case None {
            return inner
        }
    }
}

func typeBaseMatch(expStr: &string, actStr: &string) -> (bool) {
    var expIsGeneric: bool = expStr.contains("<")
    var actIsGeneric: bool = actStr.contains("<")

    if expIsGeneric == actIsGeneric {
        return false
    }

    var expBase: string = stripQualifier(&genericBaseName(expStr))
    var actBase: string = stripQualifier(&genericBaseName(actStr))

    return expBase == actBase
}

func genericBaseName(typeStr: &string) -> (string) {
    var lt: Option<int> = typeStr.indexOf("<")

    switch lt {
        case Some(idx) {
            return typeStr.substring(
                0,
                idx,
            )
        }
        case None {
            return *typeStr
        }
    }
}

func stripQualifier(name: &string) -> (string) {
    var parts: Vec<string, _> = splitQualifiedName(name)

    if parts.len() == 2 {
        return parts[1]
    }

    return *name
}

func importHasType(imp: &types.ImportBinding, name: &string) -> (bool) {
    for s in (*imp).Module.Structs {
        if s.Name == *name {
            return true
        }
    }

    for e in (*imp).Module.Enums {
        if e.Name == *name {
            return true
        }
    }

    for a in (*imp).Module.Aliases {
        if a.Name == *name {
            return true
        }
    }

    for t in (*imp).Module.Types {
        if t.Name == *name {
            return true
        }
    }

    return false
}

func qualifyImportedType(
    t: ast.TypeExpression,
    moduleAlias: &string,
    imp: &types.ImportBinding,
) -> (ast.TypeExpression) {
    switch t {
        case ast.TypeExpression.Simple(st) {
            if st.Name.contains(".") {
                return ast.TypeExpression.Simple(st)
            }

            if importHasType(
                imp,
                &st.Name,
            ) {
                return ast.TypeExpression.Simple(
                    ast.SimpleType{
                        Name:  *moduleAlias + "." + st.Name,
                        Token: st.Token,
                    },
                )
            }

            return ast.TypeExpression.Simple(st)
        }
        case ast.TypeExpression.Generic(gt) {
            mut var name: string = gt.Name

            if !name.contains(".") && importHasType(
                imp,
                &name,
            ) {
                name = *moduleAlias + "." + name
            }

            mut var params: Vec<ast.TypeExpression, _> = Vec.new()

            for p in gt.TypeParams {
                params.push(
                    qualifyImportedType(
                        p,
                        moduleAlias,
                        imp,
                    ),
                )
            }

            return ast.TypeExpression.Generic(
                ast.GenericType{
                    Name:       name,
                    Token:      gt.Token,
                    TypeParams: params,
                },
            )
        }
        case ast.TypeExpression.BorrowRef(bt) {
            return ast.TypeExpression.BorrowRef(
                ast.BorrowType{
                    Inner:   qualifyImportedType(
                        bt.Inner,
                        moduleAlias,
                        imp,
                    ),
                    Mutable: bt.Mutable,
                    Token:   bt.Token,
                },
            )
        }
        case ast.TypeExpression.BoxRef(bt) {
            return ast.TypeExpression.BoxRef(
                ast.BoxType{
                    Inner: qualifyImportedType(
                        bt.Inner,
                        moduleAlias,
                        imp,
                    ),
                    Token: bt.Token,
                },
            )
        }
        case ast.TypeExpression.BoxOptional(bt) {
            return ast.TypeExpression.BoxOptional(
                ast.BoxOptionalType{
                    Inner: qualifyImportedType(
                        bt.Inner,
                        moduleAlias,
                        imp,
                    ),
                    Token: bt.Token,
                },
            )
        }
        case ast.TypeExpression.Size(se) {
            return ast.TypeExpression.Size(se)
        }
        case ast.TypeExpression.Void(vt) {
            return ast.TypeExpression.Void(vt)
        }
        case ast.TypeExpression.Error(et) {
            return ast.TypeExpression.Error(et)
        }
        case ast.TypeExpression.TupleRef(tt) {
            mut var elems: Vec<ast.TypeExpression, _> = Vec.new()

            for e in tt.Elements {
                elems.push(
                    qualifyImportedType(
                        e,
                        moduleAlias,
                        imp,
                    ),
                )
            }

            return ast.TypeExpression.TupleRef(
                ast.TupleType{
                    Elements: elems,
                    Token:    tt.Token,
                },
            )
        }
    }

    return t
}

func splitQualifiedName(name: &string) -> (Vec<string, _>) {
    mut var parts: Vec<string, _> = Vec.new()
    var idxOpt: Option<int> = name.indexOf(".")

    switch idxOpt {
        case Some(idx) {
            var left: string = name.substring(
                0,
                idx,
            )
            var right: string = name.substring(
                idx + 1,
                name.len(),
            )

            parts.push(left)
            parts.push(right)
        }
        case None {
            parts.push(*name)
        }
    }

    return parts
}

func join(parts: Vec<string, _>, sep: string) -> (string) {
    mut var out: string = ""
    mut var i: int = 0

    while i < parts.len() {
        if i > 0 {
            out = out + sep
        }

        out = out + parts[i]
        i = i + 1
    }

    return out
}

func tokenNil() -> (token.Token) {
    return token.Token{
        Column:  0,
        Line:    0,
        Literal: "",
        Type:    token.ILLEGAL,
    }
}
