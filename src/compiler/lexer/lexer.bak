// Lexer for bakc.
package lexer

import "src/compiler/token/token.bak" as token

pub struct Lexer {
    input:        string
    position:     int
    readPosition: int
    ch:           int
    line:         int
    column:       int
    lastType:     int
    lastLiteral:  string
    lastLine:     int
    lastColumn:   int
}

pub const CH_NULL: int = 0
pub const CH_SPACE: int = 32
pub const CH_TAB: int = 9
pub const CH_NEWLINE: int = 10
pub const CH_CR: int = 13
pub const CH_EQ: int = 61
pub const CH_PLUS: int = 43
pub const CH_MINUS: int = 45
pub const CH_BANG: int = 33
pub const CH_SLASH: int = 47
pub const CH_ASTERISK: int = 42
pub const CH_PERCENT: int = 37
pub const CH_LT: int = 60
pub const CH_GT: int = 62
pub const CH_AMPERSAND: int = 38
pub const CH_PIPE: int = 124
pub const CH_CARET: int = 94
pub const CH_TILDE: int = 126
pub const CH_QUESTION: int = 63
pub const CH_SEMICOLON: int = 59
pub const CH_COLON: int = 58
pub const CH_COMMA: int = 44
pub const CH_DOT: int = 46
pub const CH_LPAREN: int = 40
pub const CH_RPAREN: int = 41
pub const CH_LBRACE: int = 123
pub const CH_RBRACE: int = 125
pub const CH_LBRACKET: int = 91
pub const CH_RBRACKET: int = 93
pub const CH_UNDERSCORE: int = 95
pub const CH_QUOTE: int = 34
pub const CH_APOSTROPHE: int = 39
pub const CH_BACKSLASH: int = 92
pub const CH_0: int = 48
pub const CH_1: int = 49
pub const CH_7: int = 55
pub const CH_9: int = 57
pub const CH_a: int = 97
pub const CH_f: int = 102
pub const CH_A: int = 65
pub const CH_F: int = 70
pub const CH_b: int = 98
pub const CH_o: int = 111
pub const CH_x: int = 120

func isDigit(ch: int) -> (bool) {
    return ch >= CH_0 && ch <= CH_9
}

func isHexDigit(ch: int) -> (bool) {
    return isDigit(ch) || ch >= CH_a && ch <= CH_f || ch >= CH_A && ch <= CH_F
}

func isLetter(ch: int) -> (bool) {
    return ch >= CH_A && ch <= 90 || ch >= CH_a && ch <= 122 || ch == CH_UNDERSCORE
}

func initialChar(input: string, readPosition: int) -> (int) {
    if readPosition >= input.len() {
        return CH_NULL
    }

    return int(input[readPosition])
}

func nextLine(line: int, ch: int) -> (int) {
    if ch == CH_NEWLINE {
        return line + 1
    }

    return line
}

func nextColumn(column: int, ch: int) -> (int) {
    if ch == CH_NEWLINE {
        return 0
    }

    return column + 1
}

func makeToken(
    tokenType: int,
    literal: string,
    line: int,
    column: int,
) -> (token.Token) {
    mut var tok: token.Token = token.MakeToken(
        token.ILLEGAL,
        "",
        line,
        column,
    )

    tok.Type = tokenType
    tok.Literal = literal
    tok.Line = line
    tok.Column = column

    return tok
}

func newToken(
    tokenType: int,
    ch: int,
    line: int,
    column: int,
) -> (token.Token) {
    var literal: string = char(ch).toString()

    return makeToken(
        tokenType,
        literal,
        line,
        column,
    )
}

func cacheScannedToken(mut l: &mut Lexer, tok: &token.Token) -> (void) {
    l.lastType = tok.Type
    l.lastLiteral = tok.Literal
    l.lastLine = tok.Line
    l.lastColumn = tok.Column

    return
}

pub func Init(mut out: &mut Lexer, input: string) -> (void) {
    var inputBytes0: Vec<int, _> = input.bytes()

    out.input = __builtin_string_from_bytes(
        inputBytes0,
        0,
        inputBytes0.len(),
    )
    out.position = 0
    out.readPosition = 0
    out.ch = CH_NULL
    out.line = 1
    out.column = 0
    out.lastType = token.ILLEGAL
    out.lastLiteral = ""
    out.lastLine = 0
    out.lastColumn = 0

    if out.input.len() == 0 {
        out.ch = CH_NULL
        out.position = 0
        out.readPosition = 0
        out.line = 1
        out.column = 0
    } else {
        out.ch = int(out.input[0])
        out.position = 0
        out.readPosition = 1
        out.line = 1
        out.column = 1
    }

    return
}

pub func New(input: string) -> (Lexer) {
    mut var l: Lexer = Lexer{
        ch:           CH_NULL,
        column:       0,
        input:        "",
        lastColumn:   0,
        lastLine:     0,
        lastLiteral:  "",
        lastType:     token.ILLEGAL,
        line:         1,
        position:     0,
        readPosition: 0,
    }
    var inputBytes1: Vec<int, _> = input.bytes()

    l.input = __builtin_string_from_bytes(
        inputBytes1,
        0,
        inputBytes1.len(),
    )
    l.position = 0
    l.readPosition = 0
    l.ch = CH_NULL
    l.line = 1
    l.column = 0
    l.lastType = token.ILLEGAL
    l.lastLiteral = ""
    l.lastLine = 0
    l.lastColumn = 0

    if l.input.len() == 0 {
        l.ch = CH_NULL
        l.position = 0
        l.readPosition = 0
        l.line = 1
        l.column = 0
    } else {
        l.ch = int(l.input[0])
        l.position = 0
        l.readPosition = 1
        l.line = 1
        l.column = 1
    }

    return l
}

// NewOwnedNoCopy takes ownership of `input` and avoids cloning source bytes.
// Parser bootstrap paths that already own the full source should prefer this
// to reduce peak memory usage in deep self-host stages.
pub func NewOwnedNoCopy(input: string) -> (Lexer) {
    mut var l: Lexer = Lexer{
        ch:           CH_NULL,
        column:       0,
        input:        "",
        lastColumn:   0,
        lastLine:     0,
        lastLiteral:  "",
        lastType:     token.ILLEGAL,
        line:         1,
        position:     0,
        readPosition: 0,
    }

    l.input = input
    l.position = 0
    l.readPosition = 0
    l.ch = CH_NULL
    l.line = 1
    l.column = 0
    l.lastType = token.ILLEGAL
    l.lastLiteral = ""
    l.lastLine = 0
    l.lastColumn = 0

    if l.input.len() == 0 {
        l.ch = CH_NULL
        l.position = 0
        l.readPosition = 0
        l.line = 1
        l.column = 0
    } else {
        l.ch = int(l.input[0])
        l.position = 0
        l.readPosition = 1
        l.line = 1
        l.column = 1
    }

    return l
}

pub func SourceClone(l: &Lexer) -> (string) {
    if (*l).input.len() == 0 {
        return ""
    }

    return (*l).input.substring(
        0,
        (*l).input.len(),
    )
}

pub func BootstrapLexer(input: string) -> (Lexer) {
    mut var l: Lexer = Lexer{
        ch:           CH_NULL,
        column:       0,
        input:        "",
        lastColumn:   0,
        lastLine:     0,
        lastLiteral:  "",
        lastType:     token.ILLEGAL,
        line:         1,
        position:     0,
        readPosition: 0,
    }

    Init(
        &mut l,
        input,
    )

    return l
}

func peekCharFrom(mut l: &mut Lexer) -> (int) {
    if l.readPosition >= l.input.len() {
        return CH_NULL
    }

    return int(l.input[l.readPosition])
}

pub func readCharFrom(mut l: &mut Lexer) -> (void) {
    if l.readPosition >= l.input.len() {
        l.ch = CH_NULL
    } else {
        l.ch = int(l.input[l.readPosition])
    }

    l.position = l.readPosition
    l.readPosition = l.readPosition + 1

    if l.ch == CH_NEWLINE {
        l.line = l.line + 1
        l.column = 0
    } else {
        l.column = l.column + 1
    }

    return
}

func sanitizeCursor(mut l: Lexer) -> (void) {
    if l.readPosition < 0 {
        l.readPosition = 0
    }

    var inputLen: int = l.input.len()

    if l.readPosition > inputLen {
        l.readPosition = inputLen
    }

    if l.readPosition == 0 {
        l.position = 0
    } else if l.position < 0 || l.position >= l.readPosition {
        l.position = l.readPosition - 1
    }

    if l.position >= inputLen {
        l.ch = CH_NULL
    } else {
        l.ch = int(l.input[l.position])
    }

    return
}

pub func nextTokenFrom(mut l: &mut Lexer) -> (token.Token) {
    while l.ch == CH_SPACE || l.ch == CH_TAB || l.ch == CH_NEWLINE || l.ch == CH_CR {
        readCharFrom(l)
    }

    while l.ch == CH_SLASH {
        if peekCharFrom(l) == CH_SLASH {
            while l.ch != CH_NEWLINE && l.ch != CH_NULL {
                readCharFrom(l)
            }

            while l.ch == CH_SPACE || l.ch == CH_TAB || l.ch == CH_NEWLINE || l.ch == CH_CR {
                readCharFrom(l)
            }
        } else {
            break
        }
    }

    while l.ch == CH_SPACE || l.ch == CH_TAB || l.ch == CH_NEWLINE || l.ch == CH_CR {
        readCharFrom(l)
    }

    var line: int = l.line
    var column: int = l.column
    mut var tok: token.Token = makeToken(
        token.ILLEGAL,
        "",
        line,
        column,
    )
    mut var advance: bool = true
    mut var advanceCount: int = 1

    if l.ch == CH_EQ {
        var peekEq: int = peekCharFrom(l)

        if peekEq == CH_EQ {
            tok.Type = token.EQ
            tok.Literal = "=="
            tok.Line = line
            tok.Column = column
            advanceCount = 2
        } else {
            tok = newToken(
                token.ASSIGN,
                l.ch,
                l.line,
                l.column,
            )
        }
    } else if l.ch == CH_PLUS {
        tok = newToken(
            token.PLUS,
            l.ch,
            l.line,
            l.column,
        )
    } else if l.ch == CH_MINUS {
        var peekMinus: int = peekCharFrom(l)

        if peekMinus == CH_GT {
            tok.Type = token.ARROW
            tok.Literal = "->"
            tok.Line = line
            tok.Column = column
            advanceCount = 2
        } else {
            tok = newToken(
                token.MINUS,
                l.ch,
                l.line,
                l.column,
            )
        }
    } else if l.ch == CH_BANG {
        var peekBang: int = peekCharFrom(l)

        if peekBang == CH_EQ {
            tok.Type = token.NOT_EQ
            tok.Literal = "!="
            tok.Line = line
            tok.Column = column
            advanceCount = 2
        } else {
            tok = newToken(
                token.BANG,
                l.ch,
                l.line,
                l.column,
            )
        }
    } else if l.ch == CH_SLASH {
        tok = newToken(
            token.SLASH,
            l.ch,
            l.line,
            l.column,
        )
    } else if l.ch == CH_ASTERISK {
        tok = newToken(
            token.ASTERISK,
            l.ch,
            l.line,
            l.column,
        )
    } else if l.ch == CH_PERCENT {
        tok = newToken(
            token.PERCENT,
            l.ch,
            l.line,
            l.column,
        )
    } else if l.ch == CH_LT {
        var peekLt: int = peekCharFrom(l)

        if peekLt == CH_EQ {
            tok.Type = token.LT_EQ
            tok.Literal = "<="
            tok.Line = line
            tok.Column = column
            advanceCount = 2
        } else if peekLt == CH_LT {
            tok.Type = token.LSHIFT
            tok.Literal = "<<"
            tok.Line = line
            tok.Column = column
            advanceCount = 2
        } else {
            tok = newToken(
                token.LT,
                l.ch,
                l.line,
                l.column,
            )
        }
    } else if l.ch == CH_GT {
        var peekGt: int = peekCharFrom(l)

        if peekGt == CH_EQ {
            tok.Type = token.GT_EQ
            tok.Literal = ">="
            tok.Line = line
            tok.Column = column
            advanceCount = 2
        } else if peekGt == CH_GT {
            tok.Type = token.RSHIFT
            tok.Literal = ">>"
            tok.Line = line
            tok.Column = column
            advanceCount = 2
        } else {
            tok = newToken(
                token.GT,
                l.ch,
                l.line,
                l.column,
            )
        }
    } else if l.ch == CH_AMPERSAND {
        var peekAmp: int = peekCharFrom(l)

        if peekAmp == CH_AMPERSAND {
            tok.Type = token.AND
            tok.Literal = "&&"
            tok.Line = line
            tok.Column = column
            advanceCount = 2
        } else {
            tok = newToken(
                token.AMPERSAND,
                l.ch,
                l.line,
                l.column,
            )
        }
    } else if l.ch == CH_PIPE {
        var peekPipe: int = peekCharFrom(l)

        if peekPipe == CH_PIPE {
            tok.Type = token.OR
            tok.Literal = "||"
            tok.Line = line
            tok.Column = column
            advanceCount = 2
        } else {
            tok = newToken(
                token.BITOR,
                l.ch,
                l.line,
                l.column,
            )
        }
    } else if l.ch == CH_CARET {
        tok = newToken(
            token.BITXOR,
            l.ch,
            l.line,
            l.column,
        )
    } else if l.ch == CH_SEMICOLON {
        tok = newToken(
            token.SEMICOLON,
            l.ch,
            l.line,
            l.column,
        )
    } else if l.ch == CH_COLON {
        tok = newToken(
            token.COLON,
            l.ch,
            l.line,
            l.column,
        )
    } else if l.ch == CH_COMMA {
        tok = newToken(
            token.COMMA,
            l.ch,
            l.line,
            l.column,
        )
    } else if l.ch == CH_DOT {
        if peekCharFrom(l) == CH_DOT {
            tok.Type = token.DOTDOT
            tok.Literal = ".."
            tok.Line = line
            tok.Column = column
            advanceCount = 2
        } else {
            tok = newToken(
                token.DOT,
                l.ch,
                l.line,
                l.column,
            )
        }
    } else if l.ch == CH_LPAREN {
        tok = newToken(
            token.LPAREN,
            l.ch,
            l.line,
            l.column,
        )
    } else if l.ch == CH_RPAREN {
        tok = newToken(
            token.RPAREN,
            l.ch,
            l.line,
            l.column,
        )
    } else if l.ch == CH_LBRACE {
        tok = newToken(
            token.LBRACE,
            l.ch,
            l.line,
            l.column,
        )
    } else if l.ch == CH_RBRACE {
        tok = newToken(
            token.RBRACE,
            l.ch,
            l.line,
            l.column,
        )
    } else if l.ch == CH_LBRACKET {
        tok = newToken(
            token.LBRACKET,
            l.ch,
            l.line,
            l.column,
        )
    } else if l.ch == CH_RBRACKET {
        tok = newToken(
            token.RBRACKET,
            l.ch,
            l.line,
            l.column,
        )
    } else if l.ch == CH_UNDERSCORE {
        var peekUnderscore: int = peekCharFrom(l)

        if isLetter(peekUnderscore) || isDigit(peekUnderscore) {
            var startIdent0: int = l.position
            mut var endIdent0: int = startIdent0

            while endIdent0 < l.input.len() {
                var ch0: int = int(l.input[endIdent0])

                if isLetter(ch0) || isDigit(ch0) || ch0 == CH_UNDERSCORE {
                    endIdent0 = endIdent0 + 1
                } else {
                    break
                }
            }

            tok.Line = line
            tok.Column = column
            tok.Literal = l.input.substring(
                startIdent0,
                endIdent0,
            )
            tok.Type = token.LookupIdent(tok.Literal)
            advance = false

            if endIdent0 < l.input.len() {
                l.position = endIdent0
                l.readPosition = endIdent0 + 1
                l.ch = int(l.input[endIdent0])
            } else {
                l.position = endIdent0
                l.readPosition = endIdent0
                l.ch = CH_NULL
            }

            l.column = column + (endIdent0 - startIdent0)
        } else {
            tok = newToken(
                token.UNDERSCORE,
                l.ch,
                l.line,
                l.column,
            )
        }
    } else if l.ch == CH_QUOTE {
        var startStr: int = l.position + 1

        while true {
            readCharFrom(l)

            if l.ch == CH_QUOTE || l.ch == CH_NULL {
                break
            }

            if l.ch == CH_BACKSLASH {
                readCharFrom(l)
            }
        }

        tok.Type = token.STRING
        tok.Line = line
        tok.Column = column
        tok.Literal = l.input.substring(
            startStr,
            l.position,
        )
        readCharFrom(l)
        cacheScannedToken(
        l,
            &tok,
        )

        return tok
    } else if l.ch == CH_APOSTROPHE {
        readCharFrom(l)

        mut var chStr: string = char(l.ch).toString()

        if l.ch == CH_BACKSLASH {
            readCharFrom(l)
            chStr = "" + char(l.ch).toString()
        }

        readCharFrom(l)

        if l.ch == CH_APOSTROPHE {
            readCharFrom(l)
        }

        tok.Type = token.CHAR
        tok.Line = line
        tok.Column = column
        tok.Literal = chStr
        cacheScannedToken(
        l,
            &tok,
        )

        return tok
    } else if l.ch == CH_NULL {
        tok.Type = token.EOF
        tok.Literal = ""
        tok.Line = line
        tok.Column = column
        advance = false
    } else if isLetter(l.ch) {
        var startIdent1: int = l.position
        mut var endIdent1: int = startIdent1

        while endIdent1 < l.input.len() {
            var ch1: int = int(l.input[endIdent1])

            if isLetter(ch1) || isDigit(ch1) || ch1 == CH_UNDERSCORE {
                endIdent1 = endIdent1 + 1
            } else {
                break
            }
        }
        tok.Line = line
        tok.Column = column
        tok.Literal = l.input.substring(
            startIdent1,
            endIdent1,
        )
        tok.Type = token.LookupIdent(tok.Literal)
        advance = false

        if endIdent1 < l.input.len() {
            l.position = endIdent1
            l.readPosition = endIdent1 + 1
            l.ch = int(l.input[endIdent1])
        } else {
            l.position = endIdent1
            l.readPosition = endIdent1
            l.ch = CH_NULL
        }

        l.column = column + (endIdent1 - startIdent1)
    } else if isDigit(l.ch) {
        var startNum: int = l.position
        mut var tokenTypeNum: int = token.INT
        mut var prefixed: bool = false

        if l.ch == CH_0 {
            var peekNum: int = peekCharFrom(l)

            if peekNum == CH_b {
                prefixed = true
                readCharFrom(l)
                readCharFrom(l)

                while l.ch == CH_0 || l.ch == CH_1 {
                    readCharFrom(l)
                }
            } else if peekNum == CH_o {
                prefixed = true
                readCharFrom(l)
                readCharFrom(l)

                while l.ch >= CH_0 && l.ch <= CH_7 {
                    readCharFrom(l)
                }
            } else if peekNum == CH_x {
                prefixed = true
                readCharFrom(l)
                readCharFrom(l)

                while isHexDigit(l.ch) {
                    readCharFrom(l)
                }
            }
        }

        if !prefixed {
            while isDigit(l.ch) {
                readCharFrom(l)
            }

            if l.ch == CH_DOT && isDigit(peekCharFrom(l)) {
                tokenTypeNum = token.FLOAT
                readCharFrom(l)

                while isDigit(l.ch) {
                    readCharFrom(l)
                }
            }
        }

        tok.Type = tokenTypeNum
        tok.Literal = l.input.substring(
            startNum,
            l.position,
        )
        tok.Line = line
        tok.Column = column
        advance = false
    } else if l.ch < 0 || l.ch > 255 {
        tok = makeToken(
            token.ILLEGAL,
            "?",
            l.line,
            l.column,
        )
    } else {
        tok = newToken(
            token.ILLEGAL,
            l.ch,
            l.line,
            l.column,
        )
    }

    if advance {
        mut var ai: int = 0

        while ai < advanceCount {
            readCharFrom(l)
            ai = ai + 1
        }
    }

    cacheScannedToken(
        l,
        &tok,
    )

    return tok
}

pub func skipToLineEndFrom(mut l: &mut Lexer) -> (void) {
    while l.ch != CH_NEWLINE && l.ch != CH_NULL {
        readCharFrom(l)
    }

    while l.ch == CH_NEWLINE || l.ch == CH_CR || l.ch == CH_SPACE || l.ch == CH_TAB {
        readCharFrom(l)
    }

    return
}

impl Lexer as l {
    pub func currentCharCode() -> (int) {
        return l.ch
    }

    pub func currentPos() -> (int) {
        return l.position
    }

    pub func currentReadPos() -> (int) {
        return l.readPosition
    }

    pub func atEOF() -> (bool) {
        return l.ch == CH_NULL
    }

    pub mut func nextTokenSafe() -> (token.Token) {
        if l.ch == CH_NULL {
            return makeToken(
                token.EOF,
                "",
                l.line,
                l.column,
            )
        }

        return nextTokenFrom(&mut l)
    }

    mut func readChar() -> (void) {
        readCharFrom(&mut l)
    }

    pub mut func skipToLineEnd() -> (void) {
        while l.ch != CH_NEWLINE && l.ch != CH_NULL {
            l.readChar()
        }

        while l.ch == CH_NEWLINE || l.ch == CH_CR || l.ch == CH_SPACE || l.ch == CH_TAB {
            l.readChar()
        }

        return
    }

    pub mut func peekChar() -> (int) {
        return peekCharFrom(&mut l)
    }

    pub mut func nextToken() -> (token.Token) {
        return nextTokenFrom(&mut l)
    }

    pub mut func nextTokenScan() -> (void) {
        nextTokenFrom(&mut l)

        return
    }

    pub func scannedType() -> (int) {
        return l.lastType
    }

    pub func scannedLiteral() -> (string) {
        return l.lastLiteral
    }

    pub func scannedLine() -> (int) {
        return l.lastLine
    }

    pub func scannedColumn() -> (int) {
        return l.lastColumn
    }

    pub mut func nextTokenInto(mut out: &mut token.Token) -> (void) {
        *out = nextTokenFrom(&mut l)

        return
    }

    mut func skipWhitespace() -> (void) {
        while l.ch == CH_SPACE || l.ch == CH_TAB || l.ch == CH_NEWLINE || l.ch == CH_CR {
            l.readChar()
        }
    }

    mut func skipComments() -> (void) {
        while l.ch == CH_SLASH {
            if l.peekChar() == CH_SLASH {
                while l.ch != CH_NEWLINE && l.ch != CH_NULL {
                    l.readChar()
                }

                while l.ch == CH_SPACE || l.ch == CH_TAB || l.ch == CH_NEWLINE || l.ch == CH_CR {
                    l.readChar()
                }
            } else if l.peekChar() == CH_ASTERISK {
                l.readChar()
                l.readChar()

                while true {
                    if l.ch == CH_NULL {
                        break
                    }

                    if l.ch == CH_ASTERISK && l.peekChar() == CH_SLASH {
                        l.readChar()
                        l.readChar()
                        break
                    }

                    l.readChar()
                }

                while l.ch == CH_SPACE || l.ch == CH_TAB || l.ch == CH_NEWLINE || l.ch == CH_CR {
                    l.readChar()
                }
            } else {
                return
            }
        }
    }

    mut func readIdentifier() -> (string) {
        var start: int = l.position

        while isLetter(l.ch) || isDigit(l.ch) || l.ch == CH_UNDERSCORE {
            l.readChar()
        }

        return l.input.substring(
            start,
            l.position,
        )
    }

    mut func readNumber() -> (token.Token) {
        var start: int = l.position
        mut var isFloat: bool = false

        if l.ch == CH_0 {
            var peek: int = l.peekChar()

            if peek == CH_b {
                l.readChar()
                l.readChar()

                while l.ch == CH_0 || l.ch == CH_1 {
                    l.readChar()
                }

                var lit: string = l.input.substring(
                    start,
                    l.position,
                )

                return makeToken(
                    token.INT,
                    lit,
                    l.line,
                    l.column,
                )
            } else if peek == CH_o {
                l.readChar()
                l.readChar()

                while l.ch >= CH_0 && l.ch <= CH_7 {
                    l.readChar()
                }

                var lit: string = l.input.substring(
                    start,
                    l.position,
                )

                return makeToken(
                    token.INT,
                    lit,
                    l.line,
                    l.column,
                )
            } else if peek == CH_x {
                l.readChar()
                l.readChar()

                while isHexDigit(l.ch) {
                    l.readChar()
                }

                var lit: string = l.input.substring(
                    start,
                    l.position,
                )

                return makeToken(
                    token.INT,
                    lit,
                    l.line,
                    l.column,
                )
            }
        }

        while isDigit(l.ch) {
            l.readChar()
        }

        if l.ch == CH_DOT && isDigit(l.peekChar()) {
            isFloat = true
            l.readChar()

            while isDigit(l.ch) {
                l.readChar()
            }
        }

        var literal: string = l.input.substring(
            start,
            l.position,
        )
        mut var tokenType: int = token.INT

        if isFloat {
            tokenType = token.FLOAT
        }

        return makeToken(
            tokenType,
            literal,
            l.line,
            l.column,
        )
    }

    mut func readString() -> (string) {
        var start: int = l.position + 1

        while true {
            l.readChar()

            if l.ch == CH_QUOTE || l.ch == CH_NULL {
                break
            }

            if l.ch == CH_BACKSLASH {
                l.readChar()
            }
        }

        var str: string = l.input.substring(
            start,
            l.position,
        )

        l.readChar()

        return str
    }

    mut func readCharLiteral() -> (string) {
        l.readChar()

        mut var chStr: string = char(l.ch).toString()

        if l.ch == CH_BACKSLASH {
            l.readChar()
            chStr = "" + char(l.ch).toString()
        }

        l.readChar()

        if l.ch == CH_APOSTROPHE {
            l.readChar()
        }

        return chStr
    }
}
