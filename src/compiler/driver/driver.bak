package driver

import "src/compiler/driver/module_graph.bak" as module_graph

pub func runNative(inputPath: string, outPath: string) -> (int) {
    var compileRes: Result<void, string> = module_graph.CompileGraphNative(
        inputPath,
        true,
        outPath,
    )

    switch compileRes {
        case Err(msg) {
            println("bakc: " + msg)
            return 1
        }
        case Ok(_) {
        }
    }

    var chmodRes: Result<void, string> = __builtin_chmod(
        outPath,
        493,
    )

    switch chmodRes {
        case Err(_) {
        }
        case Ok(_) {
        }
    }

    return 0
}

pub func run() -> (int) {
    printUsage()
    return 1
}

pub func printUsage() -> (void) {
    println("bakc: usage: bakc native <file.bak> [-o output]")
}

func copyString(value: &string) -> (string) {
    return *value
}
