// Bytecode compiler (skeleton).
package codegen

import "src/compiler/ast/ast.bak" as ast
import "src/compiler/diagnostics/diagnostics.bak" as diag
import "src/compiler/bytecode/module.bak" as bytecode
import "src/compiler/bytecode/opcode.bak" as opcode
import "src/compiler/bytecode/value.bak" as value
import "src/compiler/typecheck/types.bak" as types
import "src/std/fmt/fmt.bak" as fmt

const BUILTIN_PRINT: int = 0
const BUILTIN_PRINTLN: int = 1
const BUILTIN_LEN: int = 2
const BUILTIN_PUSH: int = 3
const BUILTIN_POP: int = 4
const BUILTIN_FIRST: int = 5
const BUILTIN_LAST: int = 6
const BUILTIN_REST: int = 7
const BUILTIN_TYPE: int = 8
const BUILTIN_INT: int = 9
const BUILTIN_FLOAT: int = 10
const BUILTIN_STRING: int = 11
const BUILTIN_CHAR: int = 12
const BUILTIN_BOX: int = 13
const BUILTIN_UNBOX: int = 14
const BUILTIN_IS_SOME: int = 15
const BUILTIN_IS_NONE: int = 16
const BUILTIN_UNWRAP: int = 17
const BUILTIN_ARGS: int = 18
const BUILTIN_EXIT: int = 19
const BUILTIN_GETENV: int = 20
const BUILTIN_SETENV: int = 21
const BUILTIN_CWD: int = 22
const BUILTIN_CHDIR: int = 23
const BUILTIN_READ_FILE: int = 24
const BUILTIN_WRITE_FILE: int = 25
const BUILTIN_APPEND_FILE: int = 26
const BUILTIN_FILE_EXISTS: int = 27
const BUILTIN_IS_FILE: int = 28
const BUILTIN_IS_DIR: int = 29
const BUILTIN_REMOVE: int = 30
const BUILTIN_MKDIR: int = 31
const BUILTIN_READ_DIR: int = 32
const BUILTIN_EXEC: int = 33
const BUILTIN_HOSTNAME: int = 34
const BUILTIN_TEMP_DIR: int = 35
const BUILTIN_USER_HOME_DIR: int = 36
const BUILTIN_EPRINT: int = 37
const BUILTIN_EPRINTLN: int = 38
const BUILTIN_READ_LINE: int = 39
const BUILTIN_READ_ALL: int = 40
const BUILTIN_STRING_FROM_BYTES: int = 41
const BUILTIN_SOCKET_CONNECT: int = 42
const BUILTIN_SOCKET_READ: int = 43
const BUILTIN_SOCKET_WRITE: int = 44
const BUILTIN_SOCKET_CLOSE: int = 45
const BUILTIN_SOCKET_CONNECT_TLS: int = 46
const BUILTIN_SOCKET_SET_TIMEOUT: int = 47
const BUILTIN_SOCKET_BIND: int = 48
const BUILTIN_SOCKET_ACCEPT: int = 49
const BUILTIN_IS_OK: int = 50
const BUILTIN_IS_ERR: int = 51
const BUILTIN_UNWRAP_ERR: int = 52
const BUILTIN_SPAWN: int = 60
const BUILTIN_JOIN: int = 61
const BUILTIN_SLEEP: int = 62
const BUILTIN_THREAD_ID: int = 63
const BUILTIN_TIME_NOW: int = 64
const BUILTIN_MONOTONIC_NOW: int = 65
const BUILTIN_EXECUTABLE: int = 66
const BUILTIN_MUTEX_NEW: int = 67
const BUILTIN_MUTEX_LOCK: int = 68
const BUILTIN_MUTEX_UNLOCK: int = 69
const BUILTIN_CANCEL_NEW: int = 78
const BUILTIN_CANCEL: int = 79
const BUILTIN_IS_CANCELLED: int = 80
pub struct Local {
    Name: string
    Depth: int
    Slot: int
}

pub struct EnumVariantInfo {
    EnumDef: bytecode.EnumDef
    VariantIndex: int
}

pub struct ImportedEnumVariant {
    EnumID: int
    VariantIndex: int
    PayloadCount: int
}

pub struct EnumVariantCacheEntry {
    VariantName: string
    EnumDef: bytecode.EnumDef
    VariantIndex: int
}

pub struct GlobalCacheEntry {
    Name: string
    Index: int
}

pub struct GlobalBucket {
    Entries: Vec<GlobalCacheEntry, _>
}

pub struct TestFnInfo {
    Name: string
    Index: int
}

pub struct CompilerState {
    pub locals: Vec<Local, _>
    pub scopeDepth: int
    pub loopStart: int
    pub loopBreaks: Vec<int, _>
    pub loopScopeDepths: Vec<int, _>
    pub loopContinues: Vec<int, _>
    pub loopContinueTarget: int
    pub currentFunction: Option<bytecode.FunctionObj>
    pub maxLocals: int
}

pub struct Compiler {
    module: bytecode.BytecodeModule
    parentStates: Vec<CompilerState, _>
    emitter: diag.DiagnosticEmitter
    scopeDepth: int
    locals: Vec<Local, _>
    loopStart: int
    loopBreaks: Vec<int, _>
    loopScopeDepths: Vec<int, _>
    moduleName: string
    imports: Vec<types.ImportBinding, _>
    aliases: Vec<types.AliasInfo, _>
    typedefs: Vec<types.TypeDefInfo, _>
    isEntryModule: bool
    initFn: Option<bytecode.FunctionObj>
    currentFunction: Option<bytecode.FunctionObj>
    hasInit: bool
    initAdded: bool
    enumVariantCache: Vec<EnumVariantCacheEntry, _>
    globalCache: Vec<GlobalBucket, _>
    loopContinues: Vec<int, _>
    loopContinueTarget: int
    maxLocals: int
    defaultRecursiveSeen: Vec<string, _>
    isTestMode: bool
    testFunctions: Vec<TestFnInfo, _>
}

pub func New(file: string) -> (Compiler) {
    mut var c: Compiler = Compiler{
        aliases: Vec.new(),
        currentFunction: None,
        defaultRecursiveSeen: Vec.new(),
        emitter: diag.NewEmitter(file),
        enumVariantCache: Vec.new(),
        globalCache: Vec.new(),
        hasInit: false,
        imports: Vec.new(),
        initAdded: false,
        initFn: Some(bytecode.FunctionObj{
            Arity: 0,
            Code: Vec.new(),
            Constants: Vec.new(),
            Name: "__bak_init",
            NumLocals: 0,
            SourceMap: Vec.new(),
        }),
        isEntryModule: false,
        isTestMode: false,
        locals: Vec.new(),
        loopBreaks: Vec.new(),
        loopContinueTarget: -1,
        loopContinues: Vec.new(),
        loopScopeDepths: Vec.new(),
        loopStart: -1,
        maxLocals: 0,
        module: bytecode.NewBytecodeModule(),
        moduleName: "",
        parentStates: Vec.new(),
        scopeDepth: 0,
        testFunctions: Vec.new(),
        typedefs: Vec.new(),
    }
    // Init buckets
    mut var i: int = 0
    while i < 1024 {
        c.globalCache.push(GlobalBucket{Entries: Vec.new()})
        i = i + 1
    }
    return c
}

impl Compiler as c {
    pub mut func SetContext(moduleName: string, imports: Vec<types.ImportBinding, _>, isEntry: bool) -> (void) {
        c.moduleName = moduleName
        c.imports = imports
        c.isEntryModule = isEntry
        return
    }
    pub mut func SetTestMode(enabled: bool) -> (void) {
        c.isTestMode = enabled
        return
    }
    pub func Module() -> (bytecode.BytecodeModule) {
        return c.module
    }
    pub mut func Emitter() -> (diag.DiagnosticEmitter) {
        return c.emitter
    }
    pub mut func Compile(program: ast.Program) -> (Result<bytecode.BytecodeModule, string>) {
        c.collectDefinitions(program)
        c.ensureBuiltinEnums()
        mut var fnIndex: int = c.module.Functions.len()
        for stmt in program.Statements {
            switch stmt {
                case ast.Statement.FunctionDecl(fd) {
                    var qualified: string = c.qualifyName(fd.Name.Value)
                    c.module.AddFunctionIndex(fd.Name.Value, fnIndex)
                    c.module.AddFunctionIndex(qualified, fnIndex)
                    fnIndex = fnIndex + 1
                }
                case ast.Statement.ImplDecl(id) {
                    var typeName: string = c.qualifyTypeName(id.TypeName.Value)
                    for m in id.Methods {
                        var methodName: string = typeName + "." + m.Name.Value
                        c.module.AddFunctionIndex(methodName, fnIndex)
                        fnIndex = fnIndex + 1
                    }
                }
                default {
                }
            }
        }
        var initRes: Result<void, string> = c.compileGlobalInits(program)
        switch initRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        for stmt in program.Statements {
            switch stmt {
                case ast.Statement.FunctionDecl(fd) {
                    var res: Result<void, string> = c.compileFunction(fd)
                    switch res {
                        case Err(msg) {
                            return Err(msg)
                        }
                        case Ok(_) {
                        }
                    }
                }
                case ast.Statement.ImplDecl(id) {
                    var res: Result<void, string> = c.compileImpl(id)
                    switch res {
                        case Err(msg) {
                            return Err(msg)
                        }
                        case Ok(_) {
                        }
                    }
                }
                case ast.Statement.Var(vs) {
                    c.addGlobal(c.qualifyName(vs.Name.Value))
                }
                case ast.Statement.Const(cs) {
                    c.addGlobal(c.qualifyName(cs.Name.Value))
                }
                case ast.Statement.VarBlock(vb) {
                    for vs in vb.Variables {
                        c.addGlobal(c.qualifyName(vs.Name.Value))
                    }
                }
                case ast.Statement.ConstBlock(cb) {
                    for cs in cb.Constants {
                        c.addGlobal(c.qualifyName(cs.Name.Value))
                    }
                }
                default {
                }
            }
        }
        mut var mainIndex: int = -1
        if c.isEntryModule && !c.isTestMode {
            var entryName: string = c.qualifyName("main")
            mut var i: int = 0
            while i < c.module.Functions.len() {
                if (c.module.Functions[i]).Name == entryName {
                    mainIndex = i
                    c.module.EntryPoint = i
                    break
                }
                i = i + 1
            }
        }
        if c.isEntryModule && c.hasInit && !c.initAdded && mainIndex >= 0 {
            c.currentFunction = c.initFn
            c.ensureReturn()
            c.initFn = c.currentFunction
            c.currentFunction = None
            var initIndex: int = c.module.Functions.len()
            c.module.Functions.push(c.initFn.unwrap())
            // Handle Option
            c.module.AddFunctionIndex(c.initFn.unwrap().Name, initIndex)
            c.initAdded = true
            mut var entryFn: bytecode.FunctionObj = bytecode.FunctionObj{
                Arity: 0,
                Code: Vec.new(),
                Constants: Vec.new(),
                Name: "__bak_entry",
                NumLocals: 0,
                SourceMap: Vec.new(),
            }
            c.currentFunction = Some(entryFn)
            c.emitEntryWrapper(initIndex, mainIndex)
            entryFn = c.currentFunction.unwrap()
            c.currentFunction = None
            var entryIndex: int = c.module.Functions.len()
            c.module.Functions.push(entryFn)
            c.module.EntryPoint = entryIndex
        }
        if c.isEntryModule && c.isTestMode {
            // Synthesize test runner
            var entryFn: bytecode.FunctionObj = bytecode.FunctionObj{
                Arity: 0,
                Code: Vec.new(),
                Constants: Vec.new(),
                Name: "__test_main",
                NumLocals: 0,
                SourceMap: Vec.new(),
            }
            c.currentFunction = Some(entryFn)
            var esc: string = char(27).toString()
            var green: string = esc + "[32m"
            var bold: string = esc + "[1m"
            var reset: string = esc + "[0m"
            // println("Running tests...")
            c.emitConstant(value.NewString(bold + "Running tests..." + reset))
            c.emit(opcode.OP_BUILTIN)
            c.emitByte(BUILTIN_PRINTLN)
            c.emitByte(1)
            c.emit(opcode.OP_POP)
            for t in c.testFunctions {
                // println("Running " + name + "...")
                c.emitConstant(value.NewString("Running " + t.Name + "... "))
                c.emit(opcode.OP_BUILTIN)
                c.emitByte(BUILTIN_PRINT)
                c.emitByte(1)
                c.emit(opcode.OP_POP)
                // call test_foo()
                c.emit(opcode.OP_GET_FUNC)
                c.emitShort(t.Index)
                c.emit(opcode.OP_CALL)
                c.emit(opcode.OP_CALL)
                c.emitByte(0)
                c.emit(opcode.OP_POP)
                c.emit(opcode.OP_POP)
                // println("PASS")
                c.emitConstant(value.NewString(green + "PASS" + reset))
                c.emit(opcode.OP_BUILTIN)
                c.emitByte(BUILTIN_PRINTLN)
                c.emitByte(1)
                c.emit(opcode.OP_POP)
            }
            c.ensureReturn()
            var entryIndex: int = c.module.Functions.len()
            c.module.Functions.push(c.currentFunction.unwrap())
            c.module.AddFunctionIndex("__test_main", entryIndex)
            c.module.EntryPoint = entryIndex
            c.currentFunction = None
            // Still generate init wrapper if needed? 
            // Yes, user code might rely on globals.
            // But for simplicity, we assume tests don't rely heavily on complex global init order 
            // OR we should wrap this synthetic main with __bak_entry wrapper calling init first.
            if c.hasInit {
                var realTestMain: int = entryIndex
                var wrapperFn: bytecode.FunctionObj = bytecode.FunctionObj{
                    Arity: 0,
                    Code: Vec.new(),
                    Constants: Vec.new(),
                    Name: "__bak_entry",
                    NumLocals: 0,
                    SourceMap: Vec.new(),
                }
                c.currentFunction = Some(wrapperFn)
                // We need initIndex.
                // Init function was pushed? No, we need to push it if not pushed.
                if !c.initAdded {
                    var initIdx: int = c.module.Functions.len()
                    c.module.Functions.push(c.initFn.unwrap())
                    c.initAdded = true
                    c.emitEntryWrapper(initIdx, realTestMain)
                } else {
                }
                // If init already pushed, find it? 
                // It is pushed only in the 'if !isTestMode' block traditionally? 
                // Actually initFn is built incrementally.
                // The original code pushed initFn only inside the if c.isEntryModule block.
                // So we should push it here too.
                var wrapperIndex: int = c.module.Functions.len()
                c.module.Functions.push(c.currentFunction.unwrap())
                c.module.AddFunctionIndex("__bak_entry", wrapperIndex)
                c.module.EntryPoint = wrapperIndex
                c.currentFunction = None
            }
        }
        return Ok(c.module)
    }
    mut func collectDefinitions(program: ast.Program) -> (void) {
        for stmt in program.Statements {
            switch stmt {
                case ast.Statement.StructDecl(sd) {
                    c.compileStructDef(sd)
                }
                case ast.Statement.EnumDecl(ed) {
                    c.compileEnumDef(ed)
                }
                case ast.Statement.AliasDecl(ad) {
                    c.aliases.push(types.AliasInfo{
                        Name: ad.Name.Value,
                        Underlying: ad.Underlying,
                        Visibility: ad.Visibility,
                    })
                }
                case ast.Statement.TypeDecl(td) {
                    c.typedefs.push(types.TypeDefInfo{
                        Name: td.Name.Value,
                        Underlying: td.Underlying,
                        Visibility: td.Visibility,
                    })
                }
                default {
                }
            }
        }
    }
    mut func ensureBuiltinEnums() -> (void) {
        if c.hasEnum("Result") {
            return
        }
        // Result<T, E>
        mut var variants: Vec<bytecode.VariantDef, _> = Vec.new()
        variants.push(bytecode.VariantDef{
            Name: "Ok",
            PayloadCount: 1,
            VariantID: 0,
        })
        variants.push(bytecode.VariantDef{
            Name: "Err",
            PayloadCount: 1,
            VariantID: 1,
        })
        c.module.AddEnum("Result", variants)
        var enumDef: bytecode.EnumDef = c.module.EnumDefs[c.module.EnumDefs.len() - 1]
        mut var j: int = 0
        while j < enumDef.Variants.len() {
            c.enumVariantCache.push(EnumVariantCacheEntry{
                EnumDef: enumDef,
                VariantIndex: j,
                VariantName: (enumDef.Variants[j]).Name,
            })
            j = j + 1
        }
        // Option<T>
        mut var optVariants: Vec<bytecode.VariantDef, _> = Vec.new()
        optVariants.push(bytecode.VariantDef{
            Name: "Some",
            PayloadCount: 1,
            VariantID: 0,
        })
        optVariants.push(bytecode.VariantDef{
            Name: "None",
            PayloadCount: 0,
            VariantID: 1,
        })
        c.module.AddEnum("Option", optVariants)
        var optDef: bytecode.EnumDef = c.module.EnumDefs[c.module.EnumDefs.len() - 1]
        j = 0
        while j < optDef.Variants.len() {
            c.enumVariantCache.push(EnumVariantCacheEntry{
                EnumDef: optDef,
                VariantIndex: j,
                VariantName: (optDef.Variants[j]).Name,
            })
            j = j + 1
        }
        return
    }
    func hasEnum(name: string) -> (bool) {
        for def in c.module.EnumDefs {
            if def.Name == name {
                return true
            }
        }
        return false
    }
    mut func compileStructDef(sd: ast.StructDecl) -> (void) {
        mut var fields: Vec<bytecode.FieldDef, _> = Vec.new()
        for f in sd.Fields {
            fields.push(bytecode.FieldDef{
                Name: f.Name.Value,
                TypeExpr: f.Type,
                TypeName: "",
            })
        }
        var name: string = c.qualifyTypeName(sd.Name.Value)
        c.module.AddStruct(name, fields)
        return
    }
    mut func compileEnumDef(ed: ast.EnumDecl) -> (void) {
        mut var variants: Vec<bytecode.VariantDef, _> = Vec.new()
        mut var i: int = 0
        while i < ed.Variants.len() {
            variants.push(bytecode.VariantDef{
                Name: (ed.Variants[i]).Name.Value,
                PayloadCount: (ed.Variants[i]).Fields.len(),
                VariantID: i,
            })
            i = i + 1
        }
        var name: string = c.qualifyTypeName(ed.Name.Value)
        c.module.AddEnum(name, variants)
        var enumDef: bytecode.EnumDef = c.module.EnumDefs[c.module.EnumDefs.len() - 1]
        mut var j: int = 0
        while j < enumDef.Variants.len() {
            c.enumVariantCache.push(EnumVariantCacheEntry{
                EnumDef: enumDef,
                VariantIndex: j,
                VariantName: (enumDef.Variants[j]).Name,
            })
            j = j + 1
        }
        return
    }
    mut func compileFunction(fd: ast.FunctionDecl) -> (Result<void, string>) {
        var qualifiedName: string = c.qualifyName(fd.Name.Value)
        var fn: bytecode.FunctionObj = bytecode.FunctionObj{
            Arity: fd.Parameters.len(),
            Code: Vec.new(),
            Constants: Vec.new(),
            Name: qualifiedName,
            NumLocals: 0,
            SourceMap: Vec.new(),
        }
        c.currentFunction = Some(fn)
        mut var newLocals: Vec<Local, _> = Vec.new()
        c.locals = newLocals
        c.scopeDepth = 0
        c.maxLocals = 0
        for p in fd.Parameters {
            c.addLocal(p.Name.Value)
        }
        var bodyRes: Result<void, string> = c.compileFunctionBody(fd.Body)
        switch bodyRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        mut var finishedFn: bytecode.FunctionObj = c.currentFunction.unwrap()
        finishedFn.NumLocals = c.maxLocals
        c.module.Functions.push(finishedFn)
        var fnIndex: int = c.module.Functions.len() - 1
        c.currentFunction = None
        if c.isTestMode && fd.Name.Value.startsWith("test_") && fd.Parameters.len() == 0 {
            c.testFunctions.push(TestFnInfo{Index: fnIndex, Name: fd.Name.Value})
        }
        return Ok(void)
    }
    mut func compileFunctionLiteral(fl: ast.FunctionLiteral) -> (Result<void, string>) {
        // Save current state to stack (Snapshot)
        var state: CompilerState = CompilerState{
            currentFunction: c.currentFunction,
            locals: c.locals,
            loopBreaks: c.loopBreaks,
            loopContinueTarget: c.loopContinueTarget,
            loopContinues: c.loopContinues,
            loopScopeDepths: c.loopScopeDepths,
            loopStart: c.loopStart,
            maxLocals: c.maxLocals,
            scopeDepth: c.scopeDepth,
        }
        c.parentStates.push(state)
        // Setup new function
        var fnName: string = "anon"
        var fn: bytecode.FunctionObj = bytecode.FunctionObj{
            Arity: fl.Parameters.len(),
            Code: Vec.new(),
            Constants: Vec.new(),
            Name: fnName,
            NumLocals: 0,
            SourceMap: Vec.new(),
            UpvalueCount: 0,
        }
        c.currentFunction = Some(fn)
        // Reset active state
        mut var newLocals: Vec<Local, _> = Vec.new()
        c.locals = newLocals
        c.scopeDepth = 0
        c.maxLocals = 0
        c.loopStart = -1
        mut var newBreaks: Vec<int, _> = Vec.new()
        c.loopBreaks = newBreaks
        mut var newDepths: Vec<int, _> = Vec.new()
        c.loopScopeDepths = newDepths
        mut var newContinues: Vec<int, _> = Vec.new()
        c.loopContinues = newContinues
        c.loopContinueTarget = -1
        // Add parameters
        for p in fl.Parameters {
            c.addLocal(p.Name.Value)
        }
        // Compile body
        var bodyRes: Result<void, string> = c.compileBlock(fl.Body)
        switch bodyRes {
            case Err(msg) {
                // Restore state on error
                var oldState: CompilerState = c.parentStates.pop().unwrap()
                c.locals = oldState.locals
                c.scopeDepth = oldState.scopeDepth
                c.maxLocals = oldState.maxLocals
                c.loopStart = oldState.loopStart
                c.loopBreaks = oldState.loopBreaks
                c.loopScopeDepths = oldState.loopScopeDepths
                c.loopContinues = oldState.loopContinues
                c.loopContinueTarget = oldState.loopContinueTarget
                c.currentFunction = oldState.currentFunction
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        c.ensureReturn()
        mut var finishedFn: bytecode.FunctionObj = c.currentFunction.unwrap()
        finishedFn.NumLocals = c.maxLocals
        // finishedFn.UpvalueCount = c.upvalues.len() // Removed
        // Add function to module
        var fnIndex: int = c.module.Functions.len()
        c.module.Functions.push(finishedFn)
        // Restore state
        var oldState: CompilerState = c.parentStates.pop().unwrap()
        c.locals = oldState.locals
        c.scopeDepth = oldState.scopeDepth
        c.maxLocals = oldState.maxLocals
        c.loopStart = oldState.loopStart
        c.loopBreaks = oldState.loopBreaks
        c.loopScopeDepths = oldState.loopScopeDepths
        c.loopContinues = oldState.loopContinues
        c.loopContinueTarget = oldState.loopContinueTarget
        c.currentFunction = oldState.currentFunction
        // Emit OP_GET_FUNC
        c.emit(opcode.OP_GET_FUNC)
        c.emitShort(fnIndex)
        return Ok(void)
    }
    mut func compileImpl(id: ast.ImplDecl) -> (Result<void, string>) {
        var typeName: string = c.qualifyTypeName(id.TypeName.Value)
        for m in id.Methods {
            var res: Result<void, string> = c.compileMethod(typeName, id.Receiver.Value, m)
            switch res {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }
        }
        return Ok(void)
    }
    mut func compileMethod(typeName: string, receiverName: string, m: ast.MethodDecl) -> (Result<void, string>) {
        var fn: bytecode.FunctionObj = bytecode.FunctionObj{
            Arity: m.Parameters.len() + 1,
            Code: Vec.new(),
            Constants: Vec.new(),
            Name: typeName + "." + m.Name.Value,
            NumLocals: 0,
            SourceMap: Vec.new(),
        }
        c.currentFunction = Some(fn)
        mut var newLocals: Vec<Local, _> = Vec.new()
        c.locals = newLocals
        c.scopeDepth = 0
        c.maxLocals = 0
        c.addLocal(receiverName)
        for p in m.Parameters {
            c.addLocal(p.Name.Value)
        }
        var bodyRes: Result<void, string> = c.compileFunctionBody(m.Body)
        switch bodyRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        mut var finishedFn: bytecode.FunctionObj = c.currentFunction.unwrap()
        finishedFn.NumLocals = c.maxLocals
        var fnIndex: int = c.module.Functions.len()
        c.module.Functions.push(finishedFn)
        c.currentFunction = None
        c.module.AddMethod(typeName, m.Name.Value, fnIndex)
        return Ok(void)
    }
    mut func compileGlobalInits(program: ast.Program) -> (Result<void, string>) {
        var oldLocals: Vec<Local, _> = c.locals
        var oldDepth: int = c.scopeDepth
        var oldLoopStart: int = c.loopStart
        var oldBreaks: Vec<int, _> = c.loopBreaks
        var oldContinues: Vec<int, _> = c.loopContinues
        var oldContinueTarget: int = c.loopContinueTarget
        mut var newLocals: Vec<Local, _> = Vec.new()
        c.locals = newLocals
        c.scopeDepth = 0
        c.loopStart = -1
        mut var newBreaks: Vec<int, _> = Vec.new()
        c.loopBreaks = newBreaks
        mut var newContinues: Vec<int, _> = Vec.new()
        c.loopContinues = newContinues
        c.loopContinueTarget = -1
        for stmt in program.Statements {
            switch stmt {
                case ast.Statement.Var(vs) {
                    var res: Result<void, string> = c.compileGlobalVarInit(vs)
                    switch res {
                        case Err(msg) {
                            c.locals = oldLocals
                            c.scopeDepth = oldDepth
                            c.loopStart = oldLoopStart
                            c.loopBreaks = oldBreaks
                            c.loopContinues = oldContinues
                            c.loopContinueTarget = oldContinueTarget
                            return Err(msg)
                        }
                        case Ok(_) {
                        }
                    }
                }
                case ast.Statement.Const(cs) {
                    var res: Result<void, string> = c.compileGlobalConstInit(cs)
                    switch res {
                        case Err(msg) {
                            c.locals = oldLocals
                            c.scopeDepth = oldDepth
                            c.loopStart = oldLoopStart
                            c.loopBreaks = oldBreaks
                            c.loopContinues = oldContinues
                            c.loopContinueTarget = oldContinueTarget
                            return Err(msg)
                        }
                        case Ok(_) {
                        }
                    }
                }
                case ast.Statement.VarBlock(vb) {
                    for vs in vb.Variables {
                        var res: Result<void, string> = c.compileGlobalVarInit(vs)
                        switch res {
                            case Err(msg) {
                                c.locals = oldLocals
                                c.scopeDepth = oldDepth
                                c.loopStart = oldLoopStart
                                c.loopBreaks = oldBreaks
                                c.loopContinues = oldContinues
                                c.loopContinueTarget = oldContinueTarget
                                return Err(msg)
                            }
                            case Ok(_) {
                            }
                        }
                    }
                }
                case ast.Statement.ConstBlock(cb) {
                    for cs in cb.Constants {
                        var res: Result<void, string> = c.compileGlobalConstInit(cs)
                        switch res {
                            case Err(msg) {
                                c.locals = oldLocals
                                c.scopeDepth = oldDepth
                                c.loopStart = oldLoopStart
                                c.loopBreaks = oldBreaks
                                c.loopContinues = oldContinues
                                c.loopContinueTarget = oldContinueTarget
                                return Err(msg)
                            }
                            case Ok(_) {
                            }
                        }
                    }
                }
                default {
                }
            }
        }
        c.locals = oldLocals
        c.scopeDepth = oldDepth
        c.loopStart = oldLoopStart
        c.loopBreaks = oldBreaks
        c.loopContinues = oldContinues
        c.loopContinueTarget = oldContinueTarget
        return Ok(void)
    }
    mut func compileGlobalVarInit(vs: ast.VarStatement) -> (Result<void, string>) {
        c.currentFunction = c.initFn
        if !c.hasInit {
            c.hasInit = true
        }
        switch vs.Value {
            case Some(expr) {
                var res: Result<void, string> = c.compileExpression(expr)
                switch res {
                    case Err(msg) {
                        c.initFn = c.currentFunction
                        c.currentFunction = None
                        return Err(msg)
                    }
                    case Ok(_) {
                    }
                }
            }
            case None {
                switch vs.Type {
                    case Some(t) {
                        var res: Result<void, string> = c.compileDefaultValue(t)
                        switch res {
                            case Err(msg) {
                                c.initFn = c.currentFunction
                                c.currentFunction = None
                                return Err(msg)
                            }
                            case Ok(_) {
                            }
                        }
                    }
                    case None {
                        c.emit(opcode.OP_NIL)
                    }
                }
            }
        }
        var idx: int = c.addGlobal(c.qualifyName(vs.Name.Value))
        c.emit(opcode.OP_SET_GLOBAL)
        c.emitShort(idx)
        c.initFn = c.currentFunction
        c.currentFunction = None
        return Ok(void)
    }
    mut func compileGlobalConstInit(cs: ast.ConstStatement) -> (Result<void, string>) {
        c.currentFunction = c.initFn
        if !c.hasInit {
            c.hasInit = true
        }
        var res: Result<void, string> = c.compileExpression(cs.Value)
        switch res {
            case Err(msg) {
                c.initFn = c.currentFunction
                c.currentFunction = None
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        var idx: int = c.addGlobal(c.qualifyName(cs.Name.Value))
        c.emit(opcode.OP_SET_GLOBAL)
        c.emitShort(idx)
        c.initFn = c.currentFunction
        c.currentFunction = None
        return Ok(void)
    }
    mut func compileFunctionBody(body: ast.BlockStatement) -> (Result<void, string>) {
        var res: Result<void, string> = c.compileBlock(body)
        switch res {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        c.ensureReturn()
        return Ok(void)
    }
    mut func compileBlock(block: ast.BlockStatement) -> (Result<void, string>) {
        c.beginScope()
        for stmt in block.Statements {
            var res: Result<void, string> = c.compileStatement(stmt)
            switch res {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }
        }
        c.endScope()
        return Ok(void)
    }
    mut func compileStatement(stmt: ast.Statement) -> (Result<void, string>) {
        switch stmt {
            case ast.Statement.Var(vs) {
                return c.compileVarStatement(vs)
            }
            case ast.Statement.MultiVar(ms) {
                return c.compileMultiVarStatement(ms)
            }
            case ast.Statement.Const(cs) {
                return c.compileConstStatement(cs)
            }
            case ast.Statement.Expression(es) {
                var res: Result<void, string> = c.compileExpression(es.Expression)
                switch res {
                    case Err(msg) {
                        return Err(msg)
                    }
                    case Ok(_) {
                    }
                }
                c.emit(opcode.OP_POP)
                return Ok(void)
            }
            case ast.Statement.Return(rs) {
                return c.compileReturnStatement(rs)
            }
            case ast.Statement.Block(bs) {
                return c.compileBlock(bs)
            }
            case ast.Statement.If(is) {
                return c.compileIfStatement(is)
            }
            case ast.Statement.While(ws) {
                return c.compileWhileStatement(ws)
            }
            case ast.Statement.For(fs) {
                return c.compileForStatement(fs)
            }
            case ast.Statement.Assignment(asStmt) {
                return c.compileAssignment(asStmt)
            }
            case ast.Statement.Break(_) {
                return c.compileBreak()
            }
            case ast.Statement.Continue(_) {
                return c.compileContinue()
            }
            case ast.Statement.Switch(ss) {
                return c.compileSwitchStatement(ss)
            }
            case ast.Statement.Defer(ds) {
                return c.compileDeferStatement(ds)
            }
            case ast.Statement.Panic(ps) {
                return c.compilePanicStatement(ps)
            }
            case ast.Statement.ConstBlock(cb) {
                for cs in cb.Constants {
                    var res: Result<void, string> = c.compileConstStatement(cs)
                    switch res {
                        case Err(msg) {
                            return Err(msg)
                        }
                        case Ok(_) {
                        }
                    }
                }
                return Ok(void)
            }
            case ast.Statement.VarBlock(vb) {
                for vs in vb.Variables {
                    var res: Result<void, string> = c.compileVarStatement(vs)
                    switch res {
                        case Err(msg) {
                            return Err(msg)
                        }
                        case Ok(_) {
                        }
                    }
                }
                return Ok(void)
            }
            case ast.Statement.Unsafe(ub) {
                return c.compileBlock(ub.Body)
            }
            case ast.Statement.Package(_) {
                return Ok(void)
            }
            case ast.Statement.Import(_) {
                return Ok(void)
            }
            case ast.Statement.ImportBlock(_) {
                return Ok(void)
            }
            case ast.Statement.FunctionDecl(_) {
                return Ok(void)
            }
            case ast.Statement.StructDecl(_) {
                return Ok(void)
            }
            case ast.Statement.EnumDecl(_) {
                return Ok(void)
            }
            case ast.Statement.ImplDecl(_) {
                return Ok(void)
            }
            case ast.Statement.TypeDecl(_) {
                return Ok(void)
            }
            case ast.Statement.AliasDecl(_) {
                return Ok(void)
            }
            default {
                return Err("codegen: unreachable statement in function body")
            }
        }
    }
    mut func compileDeferStatement(ds: ast.DeferStatement) -> (Result<void, string>) {
        var fl: ast.FunctionLiteral = ast.FunctionLiteral{
            Body: ds.Body,
            Parameters: Vec.new(),
            ReturnType: ast.TypeExpression.Void(ast.VoidType{Token: ds.Token}),
            Token: ds.Token,
        }
        var res: Result<void, string> = c.compileExpression(ast.Expression.FunctionLiteral(fl))
        switch res {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        c.emit(opcode.OP_DEFER)
        c.emitByte(0)
        return Ok(void)
    }
    mut func compilePanicStatement(ps: ast.PanicStatement) -> (Result<void, string>) {
        var res: Result<void, string> = c.compileExpression(ps.Message)
        switch res {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        c.emit(opcode.OP_PANIC)
        return Ok(void)
    }
    mut func compileVarStatement(vs: ast.VarStatement) -> (Result<void, string>) {
        switch vs.Value {
            case Some(expr) {
                var res: Result<void, string> = c.compileExpression(expr)
                switch res {
                    case Err(msg) {
                        return Err(msg)
                    }
                    case Ok(_) {
                    }
                }
            }
            case None {
                switch vs.Type {
                    case Some(t) {
                        var res: Result<void, string> = c.compileDefaultValue(t)
                        switch res {
                            case Err(msg) {
                                return Err(msg)
                            }
                            case Ok(_) {
                            }
                        }
                    }
                    case None {
                        c.emit(opcode.OP_NIL)
                    }
                }
            }
        }
        if c.scopeDepth > 0 {
            c.addLocal(vs.Name.Value)
            // If the variable name is a discard (`_`), `addLocal` won't allocate a slot.
            // In that case we should pop the initialized value instead of emitting
            // an OP_SET_LOCAL with an invalid slot (-1).
            if vs.Name.Value == "_" {
                c.emit(opcode.OP_POP)
            } else {
                var slot: int = c.locals.len() - 1
                c.emit(opcode.OP_SET_LOCAL)
                c.emitByte(slot)
            }
        } else {
            // c.emit(opcode.OP_POP) // Removed: SET_LOCAL consumes value
            var idx: int = c.addGlobal(c.qualifyName(vs.Name.Value))
            c.emit(opcode.OP_SET_GLOBAL)
            c.emitShort(idx)
        }
        return Ok(void)
    }
    mut func compileMultiVarStatement(ms: ast.MultiVarStatement) -> (Result<void, string>) {
        // If the RHS is a call/method call, prefer unpacking the returned
        // vector into individual stack values (OP_UNPACK_N) and assign in
        // reverse order. Otherwise, compile as before (dup + vec_get).
        var valueExpr: ast.Expression = ms.Value.unwrap()
        // Compile the RHS expression first.
        var res: Result<void, string> = c.compileExpression(valueExpr)
        switch res {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        // OP_UNPACK_N optimization removed as VM does not support it.
        // Fall through to fallback logic using OP_VEC_GET.
        // Fallback: for container-returning RHS, duplicate container and extract
        // each element with OP_VEC_GET (original behavior).
        mut var i: int = 0
        while i < ms.Names.len() {
            var name: string = (ms.Names[i]).Value
            // Duplicate the container so we can extract multiple elements without
            // re-evaluating the RHS expression.
            c.emit(opcode.OP_DUP)
            c.emitConstant(value.NewInt(i))
            c.emit(opcode.OP_VEC_GET)
            if c.scopeDepth > 0 {
                c.addLocal(name)
                if name == "_" {
                    c.emit(opcode.OP_POP)
                } else {
                    var slot: int = c.locals.len() - 1
                    c.emit(opcode.OP_SET_LOCAL)
                    c.emitByte(c.locals.len() - 1)
                }
            } else {
                // c.emit(opcode.OP_POP)
                var idx: int = c.addGlobal(c.qualifyName(name))
                c.emit(opcode.OP_SET_GLOBAL)
                c.emitShort(idx)
            }
            // c.emit(opcode.OP_POP)
            i = i + 1
        }
        // Pop the container
        c.emit(opcode.OP_POP)
        return Ok(void)
    }
    mut func compileConstStatement(cs: ast.ConstStatement) -> (Result<void, string>) {
        var res: Result<void, string> = c.compileExpression(cs.Value)
        switch res {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        if c.scopeDepth > 0 {
            c.addLocal(cs.Name.Value)
            if cs.Name.Value == "_" {
                c.emit(opcode.OP_POP)
            } else {
                var slot: int = c.locals.len() - 1
                c.emit(opcode.OP_SET_LOCAL)
                c.emitByte(slot)
            }
        } else {
            var idx: int = c.addGlobal(c.qualifyName(cs.Name.Value))
            c.emit(opcode.OP_SET_GLOBAL)
            c.emitShort(idx)
        }
        return Ok(void)
    }
    mut func compileReturnStatement(rs: ast.ReturnStatement) -> (Result<void, string>) {
        switch rs.ReturnValue {
            case Some(expr) {
                switch expr {
                    case ast.Expression.VoidLiteral(_) {
                        c.emit(opcode.OP_RETURN_VOID)
                        return Ok(void)
                    }
                    default {
                    }
                }
                var res: Result<void, string> = c.compileExpression(expr)
                switch res {
                    case Err(msg) {
                        return Err(msg)
                    }
                    case Ok(_) {
                    }
                }
                c.emit(opcode.OP_RETURN)
            }
            case None {
                c.emit(opcode.OP_RETURN_VOID)
            }
        }
        return Ok(void)
    }
    mut func compileIfStatement(is: ast.IfStatement) -> (Result<void, string>) {
        var condRes: Result<void, string> = c.compileExpression(is.Condition)
        switch condRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        var elseJump: int = c.emitJump(opcode.OP_JMP_IF_FALSE)
        var thenRes: Result<void, string> = c.compileBlock(is.Consequence)
        switch thenRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        var endJump: int = c.emitJump(opcode.OP_JMP)
        c.patchJump(elseJump)
        switch is.Alternative {
            case Some(alt) {
                var altRes: Result<void, string> = c.compileBlock(alt)
                switch altRes {
                    case Err(msg) {
                        return Err(msg)
                    }
                    case Ok(_) {
                    }
                }
            }
            case None {
            }
        }
        c.patchJump(endJump)
        return Ok(void)
    }
    mut func compileWhileStatement(ws: ast.WhileStatement) -> (Result<void, string>) {
        mut var fn = c.currentFunction.unwrap()
        var loopStart: int = bytecode.FunctionCodeLen(&fn)
        c.currentFunction = Some(fn)
        var oldLoopStart: int = c.loopStart
        mut var oldBreaks: Vec<int, _> = c.loopBreaks
        c.loopStart = loopStart
        mut var newBreaks: Vec<int, _> = Vec.new()
        c.loopBreaks = newBreaks
        c.loopScopeDepths.push(c.scopeDepth)
        var oldContinueTarget: int = c.loopContinueTarget
        c.loopContinueTarget = loopStart
        var condRes: Result<void, string> = c.compileExpression(ws.Condition)
        switch condRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        var exitJump: int = c.emitJump(opcode.OP_JMP_IF_FALSE)
        var bodyRes: Result<void, string> = c.compileBlock(ws.Body)
        switch bodyRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        c.emitLoop(loopStart)
        c.patchJump(exitJump)
        for j in c.loopBreaks {
            c.patchJump(j)
        }
        c.loopStart = oldLoopStart
        c.loopBreaks = oldBreaks
        c.loopContinueTarget = oldContinueTarget
        c.loopScopeDepths.remove(c.loopScopeDepths.len() - 1)
        return Ok(void)
    }
    mut func compileForStatement(fs: ast.ForStatement) -> (Result<void, string>) {
        c.beginScope()
        c.loopScopeDepths.push(c.scopeDepth)
        // Reserve locals for iterator, index, and length up-front so their
        // slot numbers remain stable even if compiling the iterable inserts
        // temporary locals.
        c.addLocal(fs.Variable.Value)
        var iterSlot: int = c.locals.len() - 1
        c.addLocal("__idx__")
        var idxSlot: int = c.locals.len() - 1
        c.addLocal("__len__")
        var lenSlot: int = c.locals.len() - 1
        // Initialize iterator to nil
        c.emit(opcode.OP_NIL)
        c.emit(opcode.OP_SET_LOCAL)
        c.emitByte(iterSlot)
        // Initialize index to 0
        c.emitConstant(value.NewInt(0))
        c.emit(opcode.OP_SET_LOCAL)
        c.emitByte(idxSlot)
        // Compile iterable and store its length
        var iterRes: Result<void, string> = c.compileExpression(fs.Iterable)
        switch iterRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        c.emit(opcode.OP_VEC_LEN)
        c.emit(opcode.OP_SET_LOCAL)
        c.emitByte(lenSlot)
        mut var fn = c.currentFunction.unwrap()
        var loopStart: int = bytecode.FunctionCodeLen(&fn)
        c.currentFunction = Some(fn)
        var oldLoopStart: int = c.loopStart
        mut var oldBreaks: Vec<int, _> = c.loopBreaks
        c.loopStart = loopStart
        mut var newBreaks: Vec<int, _> = Vec.new()
        c.loopBreaks = newBreaks
        var oldContinues: Vec<int, _> = c.loopContinues
        var oldContinueTarget: int = c.loopContinueTarget
        mut var newContinues: Vec<int, _> = Vec.new()
        c.loopContinues = newContinues
        c.loopContinueTarget = -1
        c.emit(opcode.OP_GET_LOCAL)
        c.emitByte(idxSlot)
        c.emit(opcode.OP_GET_LOCAL)
        c.emitByte(lenSlot)
        c.emit(opcode.OP_LT)
        var exitJump: int = c.emitJump(opcode.OP_JMP_IF_FALSE)
        var iterRes2: Result<void, string> = c.compileExpression(fs.Iterable)
        switch iterRes2 {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        c.emit(opcode.OP_GET_LOCAL)
        c.emitByte(idxSlot)
        c.emit(opcode.OP_VEC_GET)
        c.emit(opcode.OP_SET_LOCAL)
        c.emitByte(iterSlot)
        // c.emit(opcode.OP_POP)
        var bodyRes: Result<void, string> = c.compileBlock(fs.Body)
        switch bodyRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        for j in c.loopContinues {
            c.patchJump(j)
        }
        c.emit(opcode.OP_GET_LOCAL)
        c.emitByte(idxSlot)
        c.emitConstant(value.NewInt(1))
        c.emit(opcode.OP_ADD)
        c.emit(opcode.OP_SET_LOCAL)
        c.emitByte(idxSlot)
        // c.emit(opcode.OP_POP)
        c.emitLoop(loopStart)
        c.patchJump(exitJump)
        for j in c.loopBreaks {
            c.patchJump(j)
        }
        c.loopStart = oldLoopStart
        c.loopBreaks = oldBreaks
        c.loopContinues = oldContinues
        c.loopContinueTarget = oldContinueTarget
        c.loopScopeDepths.remove(c.loopScopeDepths.len() - 1)
        c.endScope()
        return Ok(void)
    }
    mut func compileAssignment(asStmt: ast.AssignmentStatement) -> (Result<void, string>) {
        var valRes: Result<void, string> = c.compileExpression(asStmt.Value)
        switch valRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        switch asStmt.Left {
            case ast.Expression.Identifier(id) {
                var slot: int = c.resolveLocal(id.Value)
                if slot >= 0 {
                    c.emit(opcode.OP_SET_LOCAL)
                    c.emitByte(slot)
                } else {
                    // c.emit(opcode.OP_POP)
                    switch c.lookupGlobal(id.Value) {
                        case Some(idx) {
                            c.emit(opcode.OP_SET_GLOBAL)
                            c.emitShort(idx)
                        }
                        case None {
                            var qualifiedGlobal: string = c.qualifyName(id.Value)
                            switch c.lookupGlobal(qualifiedGlobal) {
                                case Some(idx2) {
                                    c.emit(opcode.OP_SET_GLOBAL)
                                    c.emitShort(idx2)
                                }
                                case None {
                                    return Err("codegen: undefined identifier " + id.Value)
                                }
                            }
                        }
                    }
                }
            }
            case ast.Expression.MutableIdentifier(id) {
                var slot: int = c.resolveLocal(id.Value)
                if slot >= 0 {
                    c.emit(opcode.OP_SET_LOCAL)
                    c.emitByte(slot)
                } else {
                    // c.emit(opcode.OP_POP)
                    switch c.lookupGlobal(id.Value) {
                        case Some(idx) {
                            c.emit(opcode.OP_SET_GLOBAL)
                            c.emitShort(idx)
                        }
                        case None {
                            var qualifiedGlobal: string = c.qualifyName(id.Value)
                            switch c.lookupGlobal(qualifiedGlobal) {
                                case Some(idx2) {
                                    c.emit(opcode.OP_SET_GLOBAL)
                                    c.emitShort(idx2)
                                }
                                case None {
                                    return Err("codegen: undefined identifier " + id.Value)
                                }
                            }
                        }
                    }
                }
            }
            case ast.Expression.FieldAccess(fa) {
                var objRes: Result<void, string> = c.compileExpression(fa.Object)
                switch objRes {
                    case Err(msg) {
                        return Err(msg)
                    }
                    case Ok(_) {
                    }
                }
                var fieldIdx: int = c.addConstant(value.NewString(fa.Field.Value))
                c.emit(opcode.OP_SET_FIELD)
                c.emitShort(fieldIdx)
            }
            case ast.Expression.Index(ix) {
                var leftRes: Result<void, string> = c.compileExpression(ix.Left)
                switch leftRes {
                    case Err(msg) {
                        return Err(msg)
                    }
                    case Ok(_) {
                    }
                }
                var idxRes: Result<void, string> = c.compileExpression(ix.Index)
                switch idxRes {
                    case Err(msg) {
                        return Err(msg)
                    }
                    case Ok(_) {
                    }
                }
                c.emit(opcode.OP_VEC_SET)
            }
            case ast.Expression.Deref(de) {
                var res: Result<void, string> = c.compileExpression(de.Value)
                switch res {
                    case Err(msg) {
                        return Err(msg)
                    }
                    case Ok(_) {
                    }
                }
                c.emit(opcode.OP_STORE_DEREF)
            }
            default {
                return Err("codegen: invalid assignment target")
            }
        }
        // c.emit(opcode.OP_POP)
        return Ok(void)
    }
    mut func compileBreak() -> (Result<void, string>) {
        if c.loopStart < 0 && c.loopBreaks.len() == 0 {
            return Err("codegen: break outside of loop")
        }
        c.emitLoopCleanup()
        var jump: int = c.emitJump(opcode.OP_JMP)
        c.loopBreaks.push(jump)
        return Ok(void)
    }
    mut func compileContinue() -> (Result<void, string>) {
        if c.loopStart < 0 {
            return Err("codegen: continue outside of loop")
        }
        c.emitLoopCleanup()
        c.emitLoopCleanup()
        if c.loopContinueTarget >= 0 {
            c.emitLoop(c.loopContinueTarget)
        } else {
            var jump: int = c.emitJump(opcode.OP_JMP)
            mut var continues: Vec<int, _> = c.loopContinues
            continues.push(jump)
            c.loopContinues = continues
        }
        return Ok(void)
    }
    func loopScopeDepth() -> (int) {
        if c.loopScopeDepths.len() == 0 {
            return -1
        }
        return c.loopScopeDepths[c.loopScopeDepths.len() - 1]
    }
    mut func emitLoopCleanup() -> (void) {
        var depth: int = c.loopScopeDepth()
        if depth < 0 {
            return
        }
        mut var i: int = c.locals.len()
        while i > 0 {
            var local: Local = c.locals[i - 1]
            if local.Depth <= depth {
                break
            }
            c.emit(opcode.OP_POP)
            i = i - 1
        }
    }
    mut func compileSwitchStatement(ss: ast.SwitchStatement) -> (Result<void, string>) {
        var valueRes: Result<void, string> = c.compileExpression(ss.Value)
        switch valueRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        c.beginScope()
        c.addLocal("$switch")
        var switchSlot: int = c.resolveLocal("$switch")
        c.emit(opcode.OP_SET_LOCAL)
        c.emitByte(switchSlot)
        mut var exitJumps: Vec<int, _> = Vec.new()
        mut var defaultCase: Option<ast.SwitchCase> = None
        for sc in ss.Cases {
            if sc.Default {
                defaultCase = Some(sc)
                continue
            }
            mut var caseJumps: Vec<int, _> = Vec.new()
            mut var boundVar: string = ""
            mut var isSomePattern: bool = false
            mut var isNonePattern: bool = false
            mut var isEnumPattern: bool = false
            mut var enumBoundNames: Vec<string, _> = Vec.new()
            for cv in sc.Values {
                mut var handled: bool = false
                switch cv {
                    case ast.Expression.FieldAccess(fa) {
                        switch fa.Object {
                            case ast.Expression.FieldAccess(inner) {
                                switch inner.Object {
                                    case ast.Expression.Identifier(id) {
                                        if c.isImportAlias(id.Value) {
                                            switch c.importedEnumVariantByType(id.Value, inner.Field.Value, fa.Field.Value) {
                                                case Some(info) {
                                                    if info.PayloadCount == 0 {
                                                        isEnumPattern = true
                                                        c.emit(opcode.OP_GET_LOCAL)
                                                        c.emitByte(switchSlot)
                                                        c.emitConstant(value.NewInt(info.EnumID))
                                                        c.emitConstant(value.NewInt(info.VariantIndex))
                                                        c.emit(opcode.OP_IS_VARIANT)
                                                        caseJumps.push(c.emitJump(opcode.OP_JMP_IF_TRUE))
                                                        handled = true
                                                    } else {
                                                    }
                                                }
                                                case None {
                                                }
                                            }
                                        }
                                    }
                                    default {
                                    }
                                }
                            }
                            default {
                            }
                        }
                    }
                    case ast.Expression.EnumVariant(ev) {
                        // Handle Option::Some/None patterns first
                        if ev.Variant.Value == "Some" && ev.Values.len() == 1 {
                            switch patternBindingName(ev.Values[0]) {
                                case Some(name) {
                                    isSomePattern = true
                                    boundVar = name
                                    c.emit(opcode.OP_GET_LOCAL)
                                    c.emitByte(switchSlot)
                                    c.emit(opcode.OP_BUILTIN)
                                    c.emitByte(BUILTIN_IS_SOME)
                                    c.emitByte(1)
                                    caseJumps.push(c.emitJump(opcode.OP_JMP_IF_TRUE))
                                    handled = true
                                }
                                case None {
                                }
                            }
                        }
                        if !handled && ev.Variant.Value == "None" && ev.Values.len() == 0 {
                            isNonePattern = true
                            c.emit(opcode.OP_GET_LOCAL)
                            c.emitByte(switchSlot)
                            c.emit(opcode.OP_BUILTIN)
                            c.emitByte(BUILTIN_IS_NONE)
                            c.emitByte(1)
                            caseJumps.push(c.emitJump(opcode.OP_JMP_IF_TRUE))
                            handled = true
                            continue
                        }
                        // Generic enum variant with simple binding, e.g. `Ok(value)`
                        if ev.Values.len() > 0 {
                            mut var bindingsOk: bool = true
                            mut var tempNames: Vec<string, _> = Vec.new()
                            mut var i: int = 0
                            while i < ev.Values.len() {
                                switch ev.Values[i] {
                                    case ast.Expression.Identifier(argId) {
                                        tempNames.push(argId.Value)
                                    }
                                    case ast.Expression.MutableIdentifier(argId) {
                                        tempNames.push(argId.Value)
                                    }
                                    default {
                                        bindingsOk = false
                                    }
                                }
                                i = i + 1
                            }
                            if bindingsOk {
                                switch c.findEnumVariant(ev.Variant.Value) {
                                    case Some(info) {
                                        var variant: bytecode.VariantDef = info.EnumDef.Variants[info.VariantIndex]
                                        if ev.Values.len() == variant.PayloadCount {
                                            isEnumPattern = true
                                            enumBoundNames = tempNames
                                            c.emit(opcode.OP_GET_LOCAL)
                                            c.emitByte(switchSlot)
                                            c.emitConstant(value.NewInt(info.EnumDef.EnumID))
                                            c.emitConstant(value.NewInt(info.VariantIndex))
                                            c.emit(opcode.OP_IS_VARIANT)
                                            caseJumps.push(c.emitJump(opcode.OP_JMP_IF_TRUE))
                                            handled = true
                                            continue
                                        }
                                    }
                                    case None {
                                    }
                                }
                            }
                        }
                    }
                    case ast.Expression.Call(ce) {
                        switch ce.Function {
                            case ast.Expression.Identifier(id) {
                                if id.Value == "Some" && ce.Arguments.len() == 1 {
                                    switch patternBindingName(ce.Arguments[0]) {
                                        case Some(name) {
                                            isSomePattern = true
                                            boundVar = name
                                            c.emit(opcode.OP_GET_LOCAL)
                                            c.emitByte(switchSlot)
                                            c.emit(opcode.OP_BUILTIN)
                                            c.emitByte(BUILTIN_IS_SOME)
                                            c.emitByte(1)
                                            caseJumps.push(c.emitJump(opcode.OP_JMP_IF_TRUE))
                                            handled = true
                                            continue
                                        }
                                        case None {
                                        }
                                    }
                                }
                                if !isEnumPattern {
                                    switch c.findEnumVariant(id.Value) {
                                        case Some(info) {
                                            var variant: bytecode.VariantDef = info.EnumDef.Variants[info.VariantIndex]
                                            if ce.Arguments.len() == variant.PayloadCount {
                                                mut var bindingsOk: bool = true
                                                mut var tempNames: Vec<string, _> = Vec.new()
                                                for arg in ce.Arguments {
                                                    switch arg {
                                                        case ast.Expression.Identifier(argId) {
                                                            tempNames.push(argId.Value)
                                                        }
                                                        case ast.Expression.MutableIdentifier(argId) {
                                                            tempNames.push(argId.Value)
                                                        }
                                                        default {
                                                            bindingsOk = false
                                                        }
                                                    }
                                                }
                                                if bindingsOk {
                                                    isEnumPattern = true
                                                    enumBoundNames = tempNames
                                                    c.emit(opcode.OP_GET_LOCAL)
                                                    c.emitByte(switchSlot)
                                                    c.emitConstant(value.NewInt(info.EnumDef.EnumID))
                                                    c.emitConstant(value.NewInt(info.VariantIndex))
                                                    c.emit(opcode.OP_IS_VARIANT)
                                                    caseJumps.push(c.emitJump(opcode.OP_JMP_IF_TRUE))
                                                    handled = true
                                                }
                                            }
                                        }
                                        case None {
                                        }
                                    }
                                }
                            }
                            case ast.Expression.FieldAccess(fa) {
                                switch fa.Object {
                                    case ast.Expression.FieldAccess(inner) {
                                        switch inner.Object {
                                            case ast.Expression.Identifier(id) {
                                                if c.isImportAlias(id.Value) {
                                                    switch c.importedEnumVariantByType(id.Value, inner.Field.Value, fa.Field.Value) {
                                                        case Some(info) {
                                                            if ce.Arguments.len() == info.PayloadCount {
                                                                mut var bindingsOk: bool = true
                                                                mut var tempNames: Vec<string, _> = Vec.new()
                                                                for arg in ce.Arguments {
                                                                    switch arg {
                                                                        case ast.Expression.Identifier(argId) {
                                                                            tempNames.push(argId.Value)
                                                                        }
                                                                        case ast.Expression.MutableIdentifier(argId) {
                                                                            tempNames.push(argId.Value)
                                                                        }
                                                                        default {
                                                                            bindingsOk = false
                                                                        }
                                                                    }
                                                                }
                                                                if bindingsOk {
                                                                    isEnumPattern = true
                                                                    enumBoundNames = tempNames
                                                                    c.emit(opcode.OP_GET_LOCAL)
                                                                    c.emitByte(switchSlot)
                                                                    c.emitConstant(value.NewInt(info.EnumID))
                                                                    c.emitConstant(value.NewInt(info.VariantIndex))
                                                                    c.emit(opcode.OP_IS_VARIANT)
                                                                    caseJumps.push(c.emitJump(opcode.OP_JMP_IF_TRUE))
                                                                    handled = true
                                                                }
                                                            } else {
                                                            }
                                                        }
                                                        case None {
                                                        }
                                                    }
                                                }
                                            }
                                            default {
                                            }
                                        }
                                    }
                                    default {
                                    }
                                }
                            }
                            default {
                            }
                        }
                    }
                    case ast.Expression.MethodCall(mc) {
                        if !isEnumPattern {
                            switch mc.Object {
                                case ast.Expression.FieldAccess(fa) {
                                    switch fa.Object {
                                        case ast.Expression.Identifier(id) {
                                            if c.isImportAlias(id.Value) {
                                                switch c.importedEnumVariantByType(id.Value, fa.Field.Value, mc.Method.Value) {
                                                    case Some(info) {
                                                        if mc.Arguments.len() == info.PayloadCount {
                                                            mut var bindingsOk: bool = true
                                                            mut var tempNames: Vec<string, _> = Vec.new()
                                                            for arg in mc.Arguments {
                                                                switch arg {
                                                                    case ast.Expression.Identifier(argId) {
                                                                        tempNames.push(argId.Value)
                                                                    }
                                                                    case ast.Expression.MutableIdentifier(argId) {
                                                                        tempNames.push(argId.Value)
                                                                    }
                                                                    default {
                                                                        bindingsOk = false
                                                                    }
                                                                }
                                                            }
                                                            if bindingsOk {
                                                                isEnumPattern = true
                                                                enumBoundNames = tempNames
                                                                c.emit(opcode.OP_GET_LOCAL)
                                                                c.emitByte(switchSlot)
                                                                c.emitConstant(value.NewInt(info.EnumID))
                                                                c.emitConstant(value.NewInt(info.VariantIndex))
                                                                c.emit(opcode.OP_IS_VARIANT)
                                                                caseJumps.push(c.emitJump(opcode.OP_JMP_IF_TRUE))
                                                                handled = true
                                                            }
                                                        }
                                                    }
                                                    case None {
                                                    }
                                                }
                                            }
                                        }
                                        default {
                                        }
                                    }
                                }
                                default {
                                }
                            }
                            switch c.findEnumVariant(mc.Method.Value) {
                                case Some(info) {
                                    var variant: bytecode.VariantDef = info.EnumDef.Variants[info.VariantIndex]
                                    if mc.Arguments.len() == variant.PayloadCount {
                                        mut var bindingsOk: bool = true
                                        mut var tempNames: Vec<string, _> = Vec.new()
                                        for arg in mc.Arguments {
                                            switch arg {
                                                case ast.Expression.Identifier(argId) {
                                                    tempNames.push(argId.Value)
                                                }
                                                case ast.Expression.MutableIdentifier(argId) {
                                                    tempNames.push(argId.Value)
                                                }
                                                default {
                                                    bindingsOk = false
                                                }
                                            }
                                        }
                                        if bindingsOk {
                                            isEnumPattern = true
                                            enumBoundNames = tempNames
                                            c.emit(opcode.OP_GET_LOCAL)
                                            c.emitByte(switchSlot)
                                            c.emitConstant(value.NewInt(info.EnumDef.EnumID))
                                            c.emitConstant(value.NewInt(info.VariantIndex))
                                            c.emit(opcode.OP_IS_VARIANT)
                                            caseJumps.push(c.emitJump(opcode.OP_JMP_IF_TRUE))
                                            handled = true
                                        }
                                    }
                                }
                                case None {
                                }
                            }
                        }
                    }
                    case ast.Expression.Identifier(id) {
                        if id.Value == "None" {
                            isNonePattern = true
                            c.emit(opcode.OP_GET_LOCAL)
                            c.emitByte(switchSlot)
                            c.emit(opcode.OP_BUILTIN)
                            c.emitByte(BUILTIN_IS_NONE)
                            c.emitByte(1)
                            caseJumps.push(c.emitJump(opcode.OP_JMP_IF_TRUE))
                            handled = true
                            continue
                        }
                        if !isEnumPattern {
                            switch c.findEnumVariant(id.Value) {
                                case Some(info) {
                                    var variant: bytecode.VariantDef = info.EnumDef.Variants[info.VariantIndex]
                                    if variant.PayloadCount == 0 {
                                        isEnumPattern = true
                                        c.emit(opcode.OP_GET_LOCAL)
                                        c.emitByte(switchSlot)
                                        c.emitConstant(value.NewInt(info.EnumDef.EnumID))
                                        c.emitConstant(value.NewInt(info.VariantIndex))
                                        c.emit(opcode.OP_IS_VARIANT)
                                        caseJumps.push(c.emitJump(opcode.OP_JMP_IF_TRUE))
                                        handled = true
                                    }
                                }
                                case None {
                                }
                            }
                        }
                    }
                    case ast.Expression.FieldAccess(fa) {
                        switch fa.Object {
                            case ast.Expression.FieldAccess(inner) {
                                switch inner.Object {
                                    case ast.Expression.Identifier(id) {
                                        if c.isImportAlias(id.Value) {
                                            switch c.importedEnumVariantByType(id.Value, inner.Field.Value, fa.Field.Value) {
                                                case Some(info) {
                                                    if info.PayloadCount == 0 {
                                                        isEnumPattern = true
                                                        c.emit(opcode.OP_GET_LOCAL)
                                                        c.emitByte(switchSlot)
                                                        c.emitConstant(value.NewInt(info.EnumID))
                                                        c.emitConstant(value.NewInt(info.VariantIndex))
                                                        c.emit(opcode.OP_IS_VARIANT)
                                                        caseJumps.push(c.emitJump(opcode.OP_JMP_IF_TRUE))
                                                        handled = true
                                                    } else {
                                                    }
                                                }
                                                case None {
                                                }
                                            }
                                        }
                                    }
                                    default {
                                    }
                                }
                            }
                            default {
                            }
                        }
                    }
                    default {
                    }
                }
                if !handled {
                    c.emit(opcode.OP_GET_LOCAL)
                    c.emitByte(switchSlot)
                    var cvRes: Result<void, string> = c.compileExpression(cv)
                    switch cvRes {
                        case Err(msg) {
                            return Err(msg)
                        }
                        case Ok(_) {
                        }
                    }
                    c.emit(opcode.OP_EQ)
                    caseJumps.push(c.emitJump(opcode.OP_JMP_IF_TRUE))
                }
            }
            var nextCaseJump: int = c.emitJump(opcode.OP_JMP)
            for j in caseJumps {
                c.patchJump(j)
            }
            if isSomePattern && boundVar != "" {
                c.beginScope()
                c.emit(opcode.OP_GET_LOCAL)
                c.emitByte(switchSlot)
                c.emit(opcode.OP_BUILTIN)
                c.emitByte(BUILTIN_UNWRAP)
                c.emitByte(1)
                c.addLocal(boundVar)
                var bindSlot: int = c.locals.len() - 1
                c.emit(opcode.OP_SET_LOCAL)
                c.emitByte(bindSlot)
            } else if isEnumPattern {
                c.beginScope()
                if enumBoundNames.len() > 0 {
                    mut var i: int = 0
                    while i < enumBoundNames.len() {
                        c.emit(opcode.OP_GET_LOCAL)
                        c.emitByte(switchSlot)
                        c.emitConstant(value.NewInt(i))
                        c.emit(opcode.OP_GET_PAYLOAD)
                        c.addLocal(enumBoundNames[i])
                        var bindSlot2: int = c.locals.len() - 1
                        c.emit(opcode.OP_SET_LOCAL)
                        c.emitByte(bindSlot2)
                        i = i + 1
                    }
                }
            } else {
                c.beginScope()
            }
            for stmt in sc.Body.Statements {
                var stRes: Result<void, string> = c.compileStatement(stmt)
                switch stRes {
                    case Err(msg) {
                        return Err(msg)
                    }
                    case Ok(_) {
                    }
                }
            }
            c.endScope()
            exitJumps.push(c.emitJump(opcode.OP_JMP))
            c.patchJump(nextCaseJump)
        }
        switch defaultCase {
            case Some(defCase) {
                var defRes: Result<void, string> = c.compileBlock(defCase.Body)
                switch defRes {
                    case Err(msg) {
                        return Err(msg)
                    }
                    case Ok(_) {
                    }
                }
            }
            case None {
            }
        }
        for j in exitJumps {
            c.patchJump(j)
        }
        c.endScope()
        return Ok(void)
    }
    mut func compileExpression(expr: ast.Expression) -> (Result<void, string>) {
        switch expr {
            case ast.Expression.IntegerLiteral(il) {
                c.emitConstant(value.NewInt(il.Value))
                return Ok(void)
            }
            case ast.Expression.FloatLiteral(fl) {
                c.emitConstant(value.NewFloat(fl.Value))
                return Ok(void)
            }
            case ast.Expression.StringLiteral(sl) {
                c.emitConstant(value.NewString(sl.Value))
                return Ok(void)
            }
            case ast.Expression.CharLiteral(cl) {
                c.emitConstant(value.NewChar(cl.Value))
                return Ok(void)
            }
            case ast.Expression.BooleanLiteral(bl) {
                if bl.Value {
                    c.emit(opcode.OP_TRUE)
                } else {
                    c.emit(opcode.OP_FALSE)
                }
                return Ok(void)
            }
            case ast.Expression.VoidLiteral(_) {
                c.emit(opcode.OP_NIL)
                return Ok(void)
            }
            case ast.Expression.Identifier(id) {
                return c.compileIdentifier(id)
            }
            case ast.Expression.MutableIdentifier(id) {
                return c.compileIdentifier(ast.Identifier{Token: id.Token, Value: id.Value})
            }
            case ast.Expression.Prefix(pe) {
                return c.compilePrefixExpression(pe)
            }
            case ast.Expression.Infix(ie) {
                return c.compileInfixExpression(ie)
            }
            case ast.Expression.Call(ce) {
                return c.compileCallExpression(ce)
            }
            case ast.Expression.MethodCall(mc) {
                return c.compileMethodCall(mc)
            }
            case ast.Expression.FieldAccess(fa) {
                return c.compileFieldAccess(fa)
            }
            case ast.Expression.Index(ix) {
                return c.compileIndexExpression(ix)
            }
            case ast.Expression.StructLiteral(sl) {
                return c.compileStructLiteral(sl)
            }
            case ast.Expression.VecLiteral(vl) {
                return c.compileVecLiteral(vl)
            }
            case ast.Expression.Range(re) {
                return c.compileRangeExpression(re)
            }
            case ast.Expression.EnumVariant(ev) {
                return c.compileEnumVariantExpression(ev)
            }
            case ast.Expression.TypeConversion(tc) {
                return c.compileTypeConversion(tc)
            }
            case ast.Expression.Tuple(te) {
                return c.compileTupleExpression(te)
            }
            case ast.Expression.Borrow(be) {
                return c.compileBorrowExpression(be)
            }
            case ast.Expression.Box(be) {
                return c.compileBoxExpression(be)
            }
            case ast.Expression.Deref(de) {
                return c.compileDerefExpression(de)
            }
            case ast.Expression.FunctionLiteral(fl) {
                return c.compileFunctionLiteral(fl)
            }
            default {
                return Err("codegen: unreachable expression")
            }
        }
    }
    func resolveLocalInState(stateIndex: int, name: string) -> (int) {
        var state: CompilerState = c.parentStates[stateIndex]
        for i in 0..state.locals.len() {
            var idx: int = state.locals.len() - 1 - i
            if (state.locals[idx]).Name == name {
                return idx
            }
        }
        return -1
    }
    func checkParentScopes(name: string) -> (bool) {
        if c.parentStates.len() == 0 {
            return false
        }
        // Iterate parents from nearest to furthest
        for i in 0..c.parentStates.len() {
            var scopeIdx: int = c.parentStates.len() - 1 - i
            var idx: int = c.resolveLocalInState(scopeIdx, name)
            if idx != -1 {
                return true
            }
        }
        return false
    }
    mut func compileIdentifier(id: ast.Identifier) -> (Result<void, string>) {
        var slot: int = c.resolveLocal(id.Value)
        if slot >= 0 {
            c.emit(opcode.OP_GET_LOCAL)
            c.emitByte(slot)
            return Ok(void)
        }
        if c.checkParentScopes(id.Value) {
            c.emitter.emit(diag.SimpleError(diag.ErrCaptureViolation, "anonymous function cannot capture variable '" + id.Value + "'", 0, 0))
            return Err("anonymous function cannot capture variable: " + id.Value)
        }
        switch c.module.LookupFunctionIndex(id.Value) {
            case Some(idx) {
                c.emit(opcode.OP_GET_FUNC)
                c.emitShort(idx)
                return Ok(void)
            }
            case None {
            }
        }
        var qualified: string = c.qualifyName(id.Value)
        if qualified != id.Value {
            switch c.module.LookupFunctionIndex(qualified) {
                case Some(idx) {
                    c.emit(opcode.OP_GET_FUNC)
                    c.emitShort(idx)
                    return Ok(void)
                }
                case None {
                }
            }
        }
        switch c.lookupGlobal(id.Value) {
            case Some(idx) {
                c.emit(opcode.OP_GET_GLOBAL)
                c.emitShort(idx)
                return Ok(void)
            }
            case None {
            }
        }
        var qualifiedGlobal: string = c.qualifyName(id.Value)
        if qualifiedGlobal != id.Value {
            switch c.lookupGlobal(qualifiedGlobal) {
                case Some(idx) {
                    c.emit(opcode.OP_GET_GLOBAL)
                    c.emitShort(idx)
                    return Ok(void)
                }
                case None {
                }
            }
        }
        // If this looks like an imported qualified name (alias.Name), ensure imported global exists
        var dotIdxOpt: Option<int> = id.Value.indexOf(".")
        switch dotIdxOpt {
            case Some(didx) {
                var prefix: string = id.Value.substring(0, didx)
                var rest: string = id.Value.substring(didx + 1, id.Value.len())
                if c.isImportAlias(prefix) {
                    c.ensureImportedGlobal(prefix, rest)
                    // try lookup again
                    switch c.lookupGlobal(id.Value) {
                        case Some(idx2) {
                            c.emit(opcode.OP_GET_GLOBAL)
                            c.emitShort(idx2)
                            return Ok(void)
                        }
                        case None {
                        }
                    }
                    var qg: string = c.qualifyName(id.Value)
                    if qg != id.Value {
                        switch c.lookupGlobal(qg) {
                            case Some(idx3) {
                                c.emit(opcode.OP_GET_GLOBAL)
                                c.emitShort(idx3)
                                return Ok(void)
                            }
                            case None {
                            }
                        }
                    }
                }
            }
            case None {
            }
        }
        if id.Value == "None" {
            c.emit(opcode.OP_NEW_OPTION_NONE)
            return Ok(void)
        }
        switch c.findEnumVariant(id.Value) {
            case Some(info) {
                var variant: bytecode.VariantDef = info.EnumDef.Variants[info.VariantIndex]
                if variant.PayloadCount != 0 {
                    return Err("codegen: enum variant " + id.Value + " requires payload")
                }
                c.emitConstant(value.NewInt(info.EnumDef.EnumID))
                c.emitConstant(value.NewInt(info.VariantIndex))
                c.emitConstant(value.NewInt(0))
                c.emit(opcode.OP_NEW_ENUM)
                return Ok(void)
            }
            case None {
            }
        }
        return Err("codegen: undefined identifier " + id.Value)
    }
    mut func compilePrefixExpression(pe: ast.PrefixExpression) -> (Result<void, string>) {
        var res: Result<void, string> = c.compileExpression(pe.Right)
        switch res {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        if pe.Operator == "-" {
            c.emit(opcode.OP_NEG)
            return Ok(void)
        }
        if pe.Operator == "!" {
            c.emit(opcode.OP_NOT)
            return Ok(void)
        }
        return Err("codegen: unknown prefix operator " + pe.Operator)
    }
    mut func compileInfixExpression(ie: ast.InfixExpression) -> (Result<void, string>) {
        if ie.Operator == "&&" {
            var leftRes: Result<void, string> = c.compileExpression(ie.Left)
            switch leftRes {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }
            c.emit(opcode.OP_DUP)
            var endJump: int = c.emitJump(opcode.OP_JMP_IF_FALSE)
            c.emit(opcode.OP_POP)
            var rightRes: Result<void, string> = c.compileExpression(ie.Right)
            switch rightRes {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }
            c.patchJump(endJump)
            return Ok(void)
        }
        if ie.Operator == "||" {
            var leftRes: Result<void, string> = c.compileExpression(ie.Left)
            switch leftRes {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }
            c.emit(opcode.OP_DUP)
            var endJump: int = c.emitJump(opcode.OP_JMP_IF_TRUE)
            c.emit(opcode.OP_POP)
            var rightRes: Result<void, string> = c.compileExpression(ie.Right)
            switch rightRes {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }
            c.patchJump(endJump)
            return Ok(void)
        }
        var resLeft: Result<void, string> = c.compileExpression(ie.Left)
        switch resLeft {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        var resRight: Result<void, string> = c.compileExpression(ie.Right)
        switch resRight {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        if ie.Operator == "+" {
            c.emit(opcode.OP_ADD)
            return Ok(void)
        }
        if ie.Operator == "-" {
            c.emit(opcode.OP_SUB)
            return Ok(void)
        }
        if ie.Operator == "*" {
            c.emit(opcode.OP_MUL)
            return Ok(void)
        }
        if ie.Operator == "/" {
            c.emit(opcode.OP_DIV)
            return Ok(void)
        }
        if ie.Operator == "%" {
            c.emit(opcode.OP_MOD)
            return Ok(void)
        }
        if ie.Operator == "&" {
            c.emit(opcode.OP_BITAND)
            return Ok(void)
        }
        if ie.Operator == "|" {
            c.emit(opcode.OP_BITOR)
            return Ok(void)
        }
        if ie.Operator == "^" {
            c.emit(opcode.OP_BITXOR)
            return Ok(void)
        }
        if ie.Operator == "<<" {
            c.emit(opcode.OP_SHL)
            return Ok(void)
        }
        if ie.Operator == ">>" {
            c.emit(opcode.OP_SHR)
            return Ok(void)
        }
        if ie.Operator == "==" {
            c.emit(opcode.OP_EQ)
            return Ok(void)
        }
        if ie.Operator == "!=" {
            c.emit(opcode.OP_NEQ)
            return Ok(void)
        }
        if ie.Operator == "<" {
            c.emit(opcode.OP_LT)
            return Ok(void)
        }
        if ie.Operator == "<=" {
            c.emit(opcode.OP_LTE)
            return Ok(void)
        }
        if ie.Operator == ">" {
            c.emit(opcode.OP_GT)
            return Ok(void)
        }
        if ie.Operator == ">=" {
            c.emit(opcode.OP_GTE)
            return Ok(void)
        }
        return Err("codegen: unknown infix operator " + ie.Operator)
    }
    mut func compileCallExpression(ce: ast.CallExpression) -> (Result<void, string>) {
        var argCount: int = ce.Arguments.len()
        switch ce.Function {
            case ast.Expression.Identifier(id) {
                switch builtinId(id.Value) {
                    case Some(builtin) {
                        for arg in ce.Arguments {
                            var res: Result<void, string> = c.compileExpression(arg)
                            switch res {
                                case Err(msg) {
                                    return Err(msg)
                                }
                                case Ok(_) {
                                }
                            }
                        }
                        c.emit(opcode.OP_BUILTIN)
                        c.emitByte(builtin)
                        c.emitByte(argCount)
                        return Ok(void)
                    }
                    case None {
                    }
                }
                switch c.module.LookupFunctionIndex(id.Value) {
                    case Some(_) {
                    }
                    case None {
                        switch c.findEnumVariant(id.Value) {
                            case Some(info) {
                                var variant: bytecode.VariantDef = info.EnumDef.Variants[info.VariantIndex]
                                // Special case for Option constructors
                                if info.EnumDef.Name == "Option" || info.EnumDef.Name == c.qualifyTypeName("Option") {
                                    if variant.Name == "Some" {
                                        if argCount != 1 {
                                            return Err("codegen: Some() requires 1 argument")
                                        }
                                        var res: Result<void, string> = c.compileExpression(ce.Arguments[0])
                                        switch res {
                                            case Err(msg) {
                                                return Err(msg)
                                            }
                                            case Ok(_) {
                                            }
                                        }
                                        c.emit(opcode.OP_NEW_OPTION_SOME)
                                        return Ok(void)
                                    } else if variant.Name == "None" {
                                        if argCount != 0 {
                                            return Err("codegen: None requires 0 arguments")
                                        }
                                        c.emit(opcode.OP_NEW_OPTION_NONE)
                                        return Ok(void)
                                    }
                                }
                                if argCount != variant.PayloadCount {
                                    return Err("codegen: enum variant payload count mismatch")
                                }
                                for arg in ce.Arguments {
                                    var res: Result<void, string> = c.compileExpression(arg)
                                    switch res {
                                        case Err(msg) {
                                            return Err(msg)
                                        }
                                        case Ok(_) {
                                        }
                                    }
                                }
                                c.emitConstant(value.NewInt(info.EnumDef.EnumID))
                                c.emitConstant(value.NewInt(info.VariantIndex))
                                c.emitConstant(value.NewInt(argCount))
                                c.emit(opcode.OP_NEW_ENUM)
                                return Ok(void)
                            }
                            case None {
                            }
                        }
                        // If not a function/enum, this identifier might be a type constructor (e.g. UserId(x)).
                        // Treat single-argument calls where the identifier names a type as a type conversion.
                        if argCount == 1 {
                            // Check local structs/aliases/typedefs
                            var structOpt: Option<bytecode.StructDef> = c.findStructDef(id.Value)
                            if structOpt.is_some() {
                                var tc: ast.TypeConversion = ast.TypeConversion{
                                    Token: id.Token,
                                    TypeName: id.Value,
                                    Value: ce.Arguments[0],
                                }
                                return c.compileTypeConversion(tc)
                            }
                            for a in c.aliases {
                                if a.Name == id.Value {
                                    var tc2: ast.TypeConversion = ast.TypeConversion{
                                        Token: id.Token,
                                        TypeName: id.Value,
                                        Value: ce.Arguments[0],
                                    }
                                    return c.compileTypeConversion(tc2)
                                }
                            }
                            for t in c.typedefs {
                                if t.Name == id.Value {
                                    var tc3: ast.TypeConversion = ast.TypeConversion{
                                        Token: id.Token,
                                        TypeName: id.Value,
                                        Value: ce.Arguments[0],
                                    }
                                    return c.compileTypeConversion(tc3)
                                }
                            }
                            // Check imported modules for a matching type/alias/typedef
                            for imp in c.imports {
                                for a2 in imp.Module.Aliases {
                                    if a2.Name == id.Value {
                                        var tn: string = imp.ModuleName + "." + id.Value
                                        var tc4: ast.TypeConversion = ast.TypeConversion{
                                            Token: id.Token,
                                            TypeName: tn,
                                            Value: ce.Arguments[0],
                                        }
                                        return c.compileTypeConversion(tc4)
                                    }
                                }
                                for t2 in imp.Module.Types {
                                    if t2.Name == id.Value {
                                        var tn2: string = imp.ModuleName + "." + id.Value
                                        var tc5: ast.TypeConversion = ast.TypeConversion{
                                            Token: id.Token,
                                            TypeName: tn2,
                                            Value: ce.Arguments[0],
                                        }
                                        return c.compileTypeConversion(tc5)
                                    }
                                }
                                for s2 in imp.Module.Structs {
                                    if s2.Name == id.Value {
                                        var tn3: string = imp.ModuleName + "." + id.Value
                                        var tc6: ast.TypeConversion = ast.TypeConversion{
                                            Token: id.Token,
                                            TypeName: tn3,
                                            Value: ce.Arguments[0],
                                        }
                                        return c.compileTypeConversion(tc6)
                                    }
                                }
                            }
                        }
                    }
                }
            }
            case ast.Expression.FieldAccess(fa) {
                switch fa.Object {
                    case ast.Expression.Identifier(id) {
                        if c.isImportAlias(id.Value) {
                            var moduleName: string = c.importModuleName(id.Value)
                            mut var lookupName: string = id.Value + "." + fa.Field.Value
                            if moduleName != "" {
                                lookupName = moduleName + "." + fa.Field.Value
                            }
                            var isThreadModule: bool = moduleName == "src/std/thread" || moduleName == "std/thread" || moduleName == "src/std/thread/thread.bak" || moduleName == "thread"
                            if isThreadModule && fa.Field.Value == "spawn" {
                                for arg in ce.Arguments {
                                    var res: Result<void, string> = c.compileExpression(arg)
                                    switch res {
                                        case Err(msg) {
                                            return Err(msg)
                                        }
                                        case Ok(_) {
                                        }
                                    }
                                }
                                c.emit(opcode.OP_BUILTIN)
                                c.emitByte(BUILTIN_SPAWN)
                                c.emitByte(argCount)
                                return Ok(void)
                            }
                            if isThreadModule && fa.Field.Value == "sleep" {
                                for arg in ce.Arguments {
                                    var res: Result<void, string> = c.compileExpression(arg)
                                    switch res {
                                        case Err(msg) {
                                            return Err(msg)
                                        }
                                        case Ok(_) {
                                        }
                                    }
                                }
                                c.emit(opcode.OP_BUILTIN)
                                c.emitByte(BUILTIN_SLEEP)
                                c.emitByte(argCount)
                                return Ok(void)
                            }
                            if isThreadModule && fa.Field.Value == "current_id" {
                                c.emit(opcode.OP_BUILTIN)
                                c.emitByte(BUILTIN_THREAD_ID)
                                c.emitByte(0)
                                return Ok(void)
                            }
                            switch c.module.LookupFunctionIndex(lookupName) {
                                case Some(idx) {
                                    c.emit(opcode.OP_GET_FUNC)
                                    c.emitShort(idx)
                                    for arg in ce.Arguments {
                                        var res: Result<void, string> = c.compileExpression(arg)
                                        switch res {
                                            case Err(msg) {
                                                return Err(msg)
                                            }
                                            case Ok(_) {
                                            }
                                        }
                                    }
                                    c.emit(opcode.OP_CALL)
                                    c.emitByte(argCount)
                                    return Ok(void)
                                }
                                case None {
                                    if moduleName != "" {
                                        switch c.module.LookupFunctionIndex(id.Value + "." + fa.Field.Value) {
                                            case Some(idx2) {
                                                c.emit(opcode.OP_GET_FUNC)
                                                c.emitShort(idx2)
                                                for arg in ce.Arguments {
                                                    var res: Result<void, string> = c.compileExpression(arg)
                                                    switch res {
                                                        case Err(msg) {
                                                            return Err(msg)
                                                        }
                                                        case Ok(_) {
                                                        }
                                                    }
                                                }
                                                c.emit(opcode.OP_CALL)
                                                c.emitByte(argCount)
                                                return Ok(void)
                                            }
                                            case None {
                                            }
                                        }
                                    }
                                    return Err("codegen: undefined imported function " + lookupName)
                                }
                            }
                        }
                    }
                    case ast.Expression.FieldAccess(inner) {
                        switch inner.Object {
                            case ast.Expression.Identifier(id) {
                                if c.isImportAlias(id.Value) {
                                    switch c.importedEnumVariantByType(id.Value, inner.Field.Value, fa.Field.Value) {
                                        case Some(info) {
                                            if info.PayloadCount != argCount {
                                                return Err("codegen: enum variant payload count mismatch for " + id.Value + "." + inner.Field.Value + "." + fa.Field.Value)
                                            }
                                            for arg in ce.Arguments {
                                                var res: Result<void, string> = c.compileExpression(arg)
                                                switch res {
                                                    case Err(msg) {
                                                        return Err(msg)
                                                    }
                                                    case Ok(_) {
                                                    }
                                                }
                                            }
                                            c.emitConstant(value.NewInt(info.EnumID))
                                            c.emitConstant(value.NewInt(info.VariantIndex))
                                            c.emitConstant(value.NewInt(argCount))
                                            c.emit(opcode.OP_NEW_ENUM)
                                            return Ok(void)
                                        }
                                        case None {
                                        }
                                    }
                                }
                            }
                            default {
                            }
                        }
                    }
                    default {
                    }
                }
            }
            default {
            }
        }
        var calleeRes: Result<void, string> = c.compileExpression(ce.Function)
        switch calleeRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        for arg in ce.Arguments {
            var res: Result<void, string> = c.compileExpression(arg)
            switch res {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }
        }
        c.emit(opcode.OP_CALL)
        c.emitByte(argCount)
        return Ok(void)
    }
    mut func compileMethodCall(mc: ast.MethodCallExpression) -> (Result<void, string>) {
        switch mc.Object {
            case ast.Expression.Identifier(id) {
                if c.isImportAlias(id.Value) {
                    var moduleName: string = c.importModuleName(id.Value)
                    if moduleName == "src/std/thread" || moduleName == "std/thread" || moduleName == "src/std/thread/thread.bak" || moduleName == "thread" {
                        if mc.Method.Value == "spawn" {
                            for arg in mc.Arguments {
                                var res: Result<void, string> = c.compileExpression(arg)
                                switch res {
                                    case Err(msg) {
                                        return Err(msg)
                                    }
                                    case Ok(_) {
                                    }
                                }
                            }
                            c.emit(opcode.OP_BUILTIN)
                            c.emitByte(BUILTIN_SPAWN)
                            c.emitByte(mc.Arguments.len())
                            return Ok(void)
                        }
                        if mc.Method.Value == "sleep" {
                            for arg in mc.Arguments {
                                var res: Result<void, string> = c.compileExpression(arg)
                                switch res {
                                    case Err(msg) {
                                        return Err(msg)
                                    }
                                    case Ok(_) {
                                    }
                                }
                            }
                            c.emit(opcode.OP_BUILTIN)
                            c.emitByte(BUILTIN_SLEEP)
                            c.emitByte(mc.Arguments.len())
                            return Ok(void)
                        }
                        if mc.Method.Value == "current_id" {
                            c.emit(opcode.OP_BUILTIN)
                            c.emitByte(BUILTIN_THREAD_ID)
                            c.emitByte(0)
                            return Ok(void)
                        }
                    }
                }
            }
            default {
            }
        }
        // Check for imported enum variant construction: alias.Enum.Variant(...)
        switch mc.Object {
            case ast.Expression.FieldAccess(fa) {
                switch fa.Object {
                    case ast.Expression.Identifier(id) {
                        if c.isImportAlias(id.Value) {
                            switch c.importedEnumVariantByType(id.Value, fa.Field.Value, mc.Method.Value) {
                                case Some(info) {
                                    // Validate payload count
                                    var argCount: int = mc.Arguments.len()
                                    if info.PayloadCount != argCount {
                                        return Err("codegen: enum variant payload count mismatch for " + id.Value + "." + fa.Field.Value + "." + mc.Method.Value)
                                    }
                                    // Compile args
                                    for arg in mc.Arguments {
                                        var res: Result<void, string> = c.compileExpression(arg)
                                        switch res {
                                            case Err(msg) {
                                                return Err(msg)
                                            }
                                            case Ok(_) {
                                            }
                                        }
                                    }
                                    c.emitConstant(value.NewInt(info.EnumID))
                                    c.emitConstant(value.NewInt(info.VariantIndex))
                                    c.emitConstant(value.NewInt(argCount))
                                    c.emit(opcode.OP_NEW_ENUM)
                                    return Ok(void)
                                }
                                case None {
                                }
                            }
                        }
                    }
                    default {
                    }
                }
            }
            default {
            }
        }
        // Check for static method calls on imported types: alias.Type.method(...)
        switch mc.Object {
            case ast.Expression.FieldAccess(fa) {
                switch fa.Object {
                    case ast.Expression.Identifier(id) {
                        if c.isImportAlias(id.Value) {
                            var moduleName: string = c.importModuleName(id.Value)
                            mut var typeName: string = id.Value + "." + fa.Field.Value
                            if moduleName != "" {
                                typeName = moduleName + "." + fa.Field.Value
                            }
                            switch c.module.LookupFunctionIndex(typeName + "." + mc.Method.Value) {
                                case Some(idx) {
                                    c.emit(opcode.OP_GET_FUNC)
                                    c.emitShort(idx)
                                    c.emit(opcode.OP_NIL)
                                    for arg in mc.Arguments {
                                        var res: Result<void, string> = c.compileExpression(arg)
                                        switch res {
                                            case Err(msg) {
                                                return Err(msg)
                                            }
                                            case Ok(_) {
                                            }
                                        }
                                    }
                                    c.emit(opcode.OP_CALL)
                                    c.emitByte(mc.Arguments.len() + 1)
                                    return Ok(void)
                                }
                                case None {
                                }
                            }
                            if moduleName != "" {
                                var aliasName: string = id.Value + "." + fa.Field.Value + "." + mc.Method.Value
                                switch c.module.LookupFunctionIndex(aliasName) {
                                    case Some(idx2) {
                                        c.emit(opcode.OP_GET_FUNC)
                                        c.emitShort(idx2)
                                        c.emit(opcode.OP_NIL)
                                        for arg in mc.Arguments {
                                            var res2: Result<void, string> = c.compileExpression(arg)
                                            switch res2 {
                                                case Err(msg) {
                                                    return Err(msg)
                                                }
                                                case Ok(_) {
                                                }
                                            }
                                        }
                                        c.emit(opcode.OP_CALL)
                                        c.emitByte(mc.Arguments.len() + 1)
                                        return Ok(void)
                                    }
                                    case None {
                                    }
                                }
                            }
                        }
                    }
                    default {
                    }
                }
            }
            default {
            }
        }
        // Special-case: some instance methods are implemented as builtins (e.g. Option.is_some/is_none/unwrap)
        var methodName: string = mc.Method.Value
        switch builtinId(methodName) {
            case Some(bid) {
                // compile object as first argument
                var objRes: Result<void, string> = c.compileExpression(mc.Object)
                switch objRes {
                    case Err(msg) {
                        return Err(msg)
                    }
                    case Ok(_) {
                    }
                }
                // compile explicit method args after object
                for arg in mc.Arguments {
                    var res: Result<void, string> = c.compileExpression(arg)
                    switch res {
                        case Err(msg) {
                            return Err(msg)
                        }
                        case Ok(_) {
                        }
                    }
                }
                c.emit(opcode.OP_BUILTIN)
                c.emitByte(bid)
                // arg count includes the object
                c.emitByte(mc.Arguments.len() + 1)
                return Ok(void)
            }
            case None {
            }
        }
        switch mc.Object {
            case ast.Expression.Identifier(id) {
                if c.isImportAlias(id.Value) {
                    var moduleName: string = c.importModuleName(id.Value)
                    mut var lookupName: string = id.Value + "." + mc.Method.Value
                    if moduleName != "" {
                        lookupName = moduleName + "." + mc.Method.Value
                    }
                    switch c.module.LookupFunctionIndex(lookupName) {
                        case Some(idx) {
                            c.emit(opcode.OP_GET_FUNC)
                            c.emitShort(idx)
                            for arg in mc.Arguments {
                                var res: Result<void, string> = c.compileExpression(arg)
                                switch res {
                                    case Err(msg) {
                                        return Err(msg)
                                    }
                                    case Ok(_) {
                                    }
                                }
                            }
                            c.emit(opcode.OP_CALL)
                            c.emitByte(mc.Arguments.len())
                            return Ok(void)
                        }
                        case None {
                            if moduleName != "" {
                                switch c.module.LookupFunctionIndex(id.Value + "." + mc.Method.Value) {
                                    case Some(idx2) {
                                        c.emit(opcode.OP_GET_FUNC)
                                        c.emitShort(idx2)
                                        for arg in mc.Arguments {
                                            var res: Result<void, string> = c.compileExpression(arg)
                                            switch res {
                                                case Err(msg) {
                                                    return Err(msg)
                                                }
                                                case Ok(_) {
                                                }
                                            }
                                        }
                                        c.emit(opcode.OP_CALL)
                                        c.emitByte(mc.Arguments.len())
                                        return Ok(void)
                                    }
                                    case None {
                                    }
                                }
                            }
                            return Err("codegen: undefined imported function " + lookupName)
                        }
                    }
                }
            }
            case ast.Expression.FieldAccess(fa) {
                switch fa.Object {
                    case ast.Expression.Identifier(id) {
                        if c.isImportAlias(id.Value) {
                            switch c.importedEnumVariantByType(id.Value, fa.Field.Value, mc.Method.Value) {
                                case Some(info) {
                                    if info.PayloadCount != mc.Arguments.len() {
                                        return Err("codegen: enum variant payload count mismatch")
                                    }
                                    for arg in mc.Arguments {
                                        var res: Result<void, string> = c.compileExpression(arg)
                                        switch res {
                                            case Err(msg) {
                                                return Err(msg)
                                            }
                                            case Ok(_) {
                                            }
                                        }
                                    }
                                    c.emitConstant(value.NewInt(info.EnumID))
                                    c.emitConstant(value.NewInt(info.VariantIndex))
                                    c.emitConstant(value.NewInt(info.PayloadCount))
                                    c.emit(opcode.OP_NEW_ENUM)
                                    return Ok(void)
                                }
                                case None {
                                }
                            }
                        }
                    }
                    default {
                    }
                }
            }
            default {
            }
        }
        switch mc.Object {
            case ast.Expression.Identifier(id) {
                if id.Value == "Vec" {
                    var method: string = mc.Method.Value
                    if method == "new" {
                        if mc.Arguments.len() != 0 {
                            return Err("codegen: Vec.new expects 0 arguments")
                        }
                        c.emitConstant(value.NewInt(0))
                        c.emit(opcode.OP_NEW_VEC_DYNAMIC)
                        return Ok(void)
                    }
                    if method == "with_cap" {
                        if mc.Arguments.len() != 1 {
                            return Err("codegen: Vec.with_cap expects 1 argument")
                        }
                        var capRes: Result<void, string> = c.compileExpression(mc.Arguments[0])
                        switch capRes {
                            case Err(msg) {
                                return Err(msg)
                            }
                            case Ok(_) {
                            }
                        }
                        c.emit(opcode.OP_POP)
                        c.emitConstant(value.NewInt(0))
                        c.emit(opcode.OP_NEW_VEC_DYNAMIC)
                        return Ok(void)
                    }
                    if method == "from" {
                        if mc.Arguments.len() != 1 {
                            return Err("codegen: Vec.from expects 1 argument")
                        }
                        var argRes: Result<void, string> = c.compileExpression(mc.Arguments[0])
                        switch argRes {
                            case Err(msg) {
                                return Err(msg)
                            }
                            case Ok(_) {
                            }
                        }
                        return Ok(void)
                    }
                }
                // Handle HashMap.new() and HashMap.with_cap() - call prelude functions
                if id.Value == "HashMap" {
                    var method: string = mc.Method.Value
                    if method == "new" {
                        if mc.Arguments.len() != 0 {
                            return Err("codegen: HashMap.new expects 0 arguments")
                        }
                        // Compile as call to new_hash_map() free function from prelude
                        switch c.module.LookupFunctionIndex("new_hash_map") {
                            case Some(idx) {
                                c.emit(opcode.OP_GET_FUNC)
                                c.emitShort(idx)
                                c.emit(opcode.OP_CALL)
                                c.emitByte(0)
                                return Ok(void)
                            }
                            case None {
                                return Err("codegen: HashMap.new(): new_hash_map not found in prelude")
                            }
                        }
                    }
                    if method == "with_cap" {
                        if mc.Arguments.len() != 1 {
                            return Err("codegen: HashMap.with_cap expects 1 argument")
                        }
                        var capRes: Result<void, string> = c.compileExpression(mc.Arguments[0])
                        switch capRes {
                            case Err(msg) {
                                return Err(msg)
                            }
                            case Ok(_) {
                            }
                        }
                        // Compile as call to with_cap_hash_map(n) free function from prelude
                        switch c.module.LookupFunctionIndex("with_cap_hash_map") {
                            case Some(idx) {
                                c.emit(opcode.OP_GET_FUNC)
                                c.emitShort(idx)
                                c.emit(opcode.OP_CALL)
                                c.emitByte(1)
                                return Ok(void)
                            }
                            case None {
                                return Err("codegen: HashMap.with_cap(): with_cap_hash_map not found in prelude")
                            }
                        }
                    }
                }
                // Check if this is a static method call on a struct/enum (e.g. Task.new)
                // If the identifier is NOT a variable, but matches a qualified function name.
                mut var isVar: bool = false
                if c.resolveLocal(id.Value) >= 0 {
                    isVar = true
                }
                if !isVar {
                    if c.lookupGlobal(id.Value).is_some() {
                        isVar = true
                    }
                }
                if !isVar {
                    var typeName: string = c.qualifyTypeName(id.Value)
                    var staticMethodName: string = typeName + "." + mc.Method.Value
                    switch c.module.LookupFunctionIndex(staticMethodName) {
                        case Some(idx) {
                            c.emit(opcode.OP_GET_FUNC)
                            c.emitShort(idx)
                            c.emit(opcode.OP_NIL)
                            // Dummy receiver
                            for arg in mc.Arguments {
                                var res: Result<void, string> = c.compileExpression(arg)
                                switch res {
                                    case Err(msg) {
                                        return Err(msg)
                                    }
                                    case Ok(_) {
                                    }
                                }
                            }
                            c.emit(opcode.OP_CALL)
                            c.emitByte(mc.Arguments.len() + 1)
                            return Ok(void)
                        }
                        case None {
                        }
                    }
                }
            }
            default {
            }
        }
        var argCount: int = mc.Arguments.len()
        var objRes: Result<void, string> = c.compileExpression(mc.Object)
        switch objRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        for arg in mc.Arguments {
            var res: Result<void, string> = c.compileExpression(arg)
            switch res {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }
        }
        var methodIdx: int = c.addConstant(value.NewString(mc.Method.Value))
        c.emit(opcode.OP_CALL_METHOD)
        c.emitShort(methodIdx)
        c.emitByte(argCount + 1)
        return Ok(void)
    }
    mut func compileFieldAccess(fa: ast.FieldAccessExpression) -> (Result<void, string>) {
        switch fa.Object {
            case ast.Expression.Identifier(id) {
                if c.resolveLocal(id.Value) == -1 && c.isImportAlias(id.Value) {
                    mut var moduleName: string = c.importModuleName(id.Value)
                    if moduleName == "" {
                        moduleName = id.Value
                    }
                    var globalName: string = moduleName + "." + fa.Field.Value
                    switch c.lookupGlobal(globalName) {
                        case Some(idx) {
                            c.emit(opcode.OP_GET_GLOBAL)
                            c.emitShort(idx)
                            return Ok(void)
                        }
                        case None {
                        }
                    }
                    switch c.importedEnumVariant(id.Value, fa.Field.Value) {
                        case Some(info) {
                            if info.PayloadCount != 0 {
                                return Err("codegen: enum variant requires payload for " + id.Value + "." + fa.Field.Value)
                            }
                            c.emitConstant(value.NewInt(info.EnumID))
                            c.emitConstant(value.NewInt(info.VariantIndex))
                            c.emitConstant(value.NewInt(0))
                            c.emit(opcode.OP_NEW_ENUM)
                            return Ok(void)
                        }
                        case None {
                        }
                    }
                    return Err("codegen: undefined imported symbol " + id.Value + "." + fa.Field.Value)
                }
                // Check for local enum variant syntax like `F.X` where `F` is enum type
                switch c.findEnumVariant(fa.Field.Value) {
                    case Some(info) {
                        // Ensure the variant belongs to the enum named by the identifier
                        if info.EnumDef.Name == id.Value || info.EnumDef.Name.endsWith("." + id.Value) {
                            var variant: bytecode.VariantDef = info.EnumDef.Variants[info.VariantIndex]
                            if variant.PayloadCount != 0 {
                                return Err("codegen: enum variant requires payload for " + id.Value + "." + fa.Field.Value)
                            }
                            c.emitConstant(value.NewInt(info.EnumDef.EnumID))
                            c.emitConstant(value.NewInt(info.VariantIndex))
                            c.emitConstant(value.NewInt(0))
                            c.emit(opcode.OP_NEW_ENUM)
                            return Ok(void)
                        }
                    }
                    case None {
                    }
                }
            }
            case ast.Expression.FieldAccess(inner) {
                switch inner.Object {
                    case ast.Expression.Identifier(id) {
                        if c.isImportAlias(id.Value) {
                            switch c.importedEnumVariantByType(id.Value, inner.Field.Value, fa.Field.Value) {
                                case Some(info) {
                                    if info.PayloadCount != 0 {
                                        return Err("codegen: enum variant requires payload for " + id.Value + "." + inner.Field.Value + "." + fa.Field.Value)
                                    }
                                    c.emitConstant(value.NewInt(info.EnumID))
                                    c.emitConstant(value.NewInt(info.VariantIndex))
                                    c.emitConstant(value.NewInt(0))
                                    c.emit(opcode.OP_NEW_ENUM)
                                    return Ok(void)
                                }
                                case None {
                                }
                            }
                            return Err("codegen: undefined imported symbol " + id.Value + "." + inner.Field.Value + "." + fa.Field.Value)
                        }
                    }
                    default {
                    }
                }
            }
            default {
            }
        }
        var objRes: Result<void, string> = c.compileExpression(fa.Object)
        switch objRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        var fieldIdx: int = c.addConstant(value.NewString(fa.Field.Value))
        c.emit(opcode.OP_GET_FIELD)
        c.emitShort(fieldIdx)
        return Ok(void)
    }
    mut func compileIndexExpression(ix: ast.IndexExpression) -> (Result<void, string>) {
        var leftRes: Result<void, string> = c.compileExpression(ix.Left)
        switch leftRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        var idxRes: Result<void, string> = c.compileExpression(ix.Index)
        switch idxRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        c.emit(opcode.OP_VEC_GET)
        return Ok(void)
    }
    mut func compileStructLiteral(sl: ast.StructLiteral) -> (Result<void, string>) {
        switch c.findStructDef(sl.Name.Value) {
            case Some(def) {
                mut var i: int = 0
                while i < def.Fields.len() {
                    var field: bytecode.FieldDef = def.Fields[i]
                    mut var found: bool = false
                    mut var j: int = 0
                    while j < sl.Fields.len() {
                        var litField: ast.StructFieldValue = sl.Fields[j]
                        if litField.Name.Value == field.Name {
                            var res: Result<void, string> = c.compileExpression(litField.Value)
                            switch res {
                                case Err(msg) {
                                    return Err(msg)
                                }
                                case Ok(_) {
                                }
                            }
                            found = true
                            break
                        }
                        j = j + 1
                    }
                    if !found {
                        var defRes: Result<void, string> = c.compileDefaultValueInternal(field.TypeExpr)
                        switch defRes {
                            case Err(msg) {
                                return Err(msg)
                            }
                            case Ok(_) {
                            }
                        }
                    }
                    i = i + 1
                }
                c.emitConstant(value.NewInt(def.TypeID))
                c.emitConstant(value.NewInt(def.Fields.len()))
                c.emit(opcode.OP_NEW_STRUCT)
                return Ok(void)
            }
            case None {
                return Err("codegen: undefined struct " + sl.Name.Value)
            }
        }
    }
    mut func compileVecLiteral(vl: ast.VecLiteral) -> (Result<void, string>) {
        var elemCount: int = vl.Elements.len()
        for elem in vl.Elements {
            var res: Result<void, string> = c.compileExpression(elem)
            switch res {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }
        }
        c.emitConstant(value.NewInt(elemCount))
        c.emit(opcode.OP_NEW_VEC_DYNAMIC)
        return Ok(void)
    }
    mut func compileRangeExpression(re: ast.RangeExpression) -> (Result<void, string>) {
        var startRes: Result<void, string> = c.compileExpression(re.Start)
        switch startRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        var endRes: Result<void, string> = c.compileExpression(re.End)
        switch endRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        mut var flags: int = 0
        if re.StartInclusive {
            flags = flags + 1
        }
        if re.EndInclusive {
            flags = flags + 2
        }
        c.emitConstant(value.NewInt(flags))
        c.emit(opcode.OP_NEW_RANGE)
        return Ok(void)
    }
    mut func compileEnumVariantExpression(ev: ast.EnumVariantExpression) -> (Result<void, string>) {
        var variantName: string = ev.Variant.Value
        if variantName == "Some" {
            if ev.Values.len() != 1 {
                return Err("codegen: Some() expects 1 value")
            }
            var res: Result<void, string> = c.compileExpression(ev.Values[0])
            switch res {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }
            c.emit(opcode.OP_NEW_OPTION_SOME)
            return Ok(void)
        }
        if variantName == "None" {
            if ev.Values.len() != 0 {
                return Err("codegen: None() expects 0 values")
            }
            c.emit(opcode.OP_NEW_OPTION_NONE)
            return Ok(void)
        }
        var payloadCount: int = ev.Values.len()
        switch c.findEnumVariant(variantName) {
            case Some(info) {
                var variant: bytecode.VariantDef = info.EnumDef.Variants[info.VariantIndex]
                if payloadCount != variant.PayloadCount {
                    return Err("codegen: enum variant payload count mismatch")
                }
                for val in ev.Values {
                    var res: Result<void, string> = c.compileExpression(val)
                    switch res {
                        case Err(msg) {
                            return Err(msg)
                        }
                        case Ok(_) {
                        }
                    }
                }
                c.emitConstant(value.NewInt(info.EnumDef.EnumID))
                c.emitConstant(value.NewInt(info.VariantIndex))
                c.emitConstant(value.NewInt(payloadCount))
                c.emit(opcode.OP_NEW_ENUM)
                return Ok(void)
            }
            case None {
                return Err("codegen: undefined enum variant " + variantName)
            }
        }
    }
    mut func compileTypeConversion(tc: ast.TypeConversion) -> (Result<void, string>) {
        var valRes: Result<void, string> = c.compileExpression(tc.Value)
        switch valRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        if tc.TypeName == "int" || tc.TypeName == "int8" || tc.TypeName == "int16" || tc.TypeName == "int32" || tc.TypeName == "int64" {
            c.emit(opcode.OP_BUILTIN)
            c.emitByte(BUILTIN_INT)
            c.emitByte(1)
            return Ok(void)
        }
        if tc.TypeName == "float" || tc.TypeName == "float32" || tc.TypeName == "float64" {
            c.emit(opcode.OP_BUILTIN)
            c.emitByte(BUILTIN_FLOAT)
            c.emitByte(1)
            return Ok(void)
        }
        if tc.TypeName == "string" {
            c.emit(opcode.OP_BUILTIN)
            c.emitByte(BUILTIN_STRING)
            c.emitByte(1)
            return Ok(void)
        }
        if tc.TypeName == "char" {
            c.emit(opcode.OP_BUILTIN)
            c.emitByte(BUILTIN_CHAR)
            c.emitByte(1)
            return Ok(void)
        }
        if tc.TypeName == "bool" {
            c.emit(opcode.OP_NOT)
            c.emit(opcode.OP_NOT)
            return Ok(void)
        }
        return Ok(void)
    }
    mut func compileTupleExpression(te: ast.TupleExpression) -> (Result<void, string>) {
        var elemCount: int = te.Elements.len()
        for elem in te.Elements {
            var res: Result<void, string> = c.compileExpression(elem)
            switch res {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }
        }
        c.emitConstant(value.NewInt(elemCount))
        c.emit(opcode.OP_NEW_VEC_DYNAMIC)
        return Ok(void)
    }
    mut func compileBorrowExpression(be: ast.BorrowExpression) -> (Result<void, string>) {
        switch be.Value {
            case ast.Expression.Identifier(id) {
                var slot: int = c.resolveLocal(id.Value)
                if slot >= 0 {
                    c.emit(opcode.OP_BORROW_LOCAL)
                    c.emitByte(slot)
                    if be.Mutable {
                        c.emitByte(1)
                    } else {
                        c.emitByte(0)
                    }
                    return Ok(void)
                } else {
                    switch c.lookupGlobal(id.Value) {
                        case Some(idx) {
                            c.emit(opcode.OP_BORROW_GLOBAL)
                            c.emitShort(idx)
                            if be.Mutable {
                                c.emitByte(1)
                            } else {
                                c.emitByte(0)
                            }
                            return Ok(void)
                        }
                        case None {
                            return Err("codegen: borrow undefined identifier " + id.Value)
                        }
                    }
                }
            }
            case ast.Expression.MutableIdentifier(id) {
                var slot: int = c.resolveLocal(id.Value)
                if slot >= 0 {
                    c.emit(opcode.OP_BORROW_LOCAL)
                    c.emitByte(slot)
                    if be.Mutable {
                        c.emitByte(1)
                    } else {
                        c.emitByte(0)
                    }
                    return Ok(void)
                } else {
                    switch c.lookupGlobal(id.Value) {
                        case Some(idx) {
                            c.emit(opcode.OP_BORROW_GLOBAL)
                            c.emitShort(idx)
                            if be.Mutable {
                                c.emitByte(1)
                            } else {
                                c.emitByte(0)
                            }
                            return Ok(void)
                        }
                        case None {
                            return Err("codegen: borrow undefined identifier " + id.Value)
                        }
                    }
                }
            }
            default {
                // Fallback for complex borrows (e.g. fields) which are currently handled as value/object references
                return c.compileExpression(be.Value)
            }
        }
    }
    mut func compileBoxExpression(be: ast.BoxExpression) -> (Result<void, string>) {
        var valRes: Result<void, string> = c.compileExpression(be.Value)
        switch valRes {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        c.emit(opcode.OP_BUILTIN)
        c.emitByte(BUILTIN_BOX)
        c.emitByte(1)
        return Ok(void)
    }
    mut func compileDerefExpression(de: ast.DerefExpression) -> (Result<void, string>) {
        var res: Result<void, string> = c.compileExpression(de.Value)
        switch res {
            case Err(msg) {
                return Err(msg)
            }
            case Ok(_) {
            }
        }
        c.emit(opcode.OP_DEREF)
        return Ok(void)
    }
    mut func findStructDef(name: string) -> (Option<bytecode.StructDef>) {
        var resolved: string = c.resolveImportedTypeName(name)
        mut var i: int = 0
        while i < c.module.StructDefs.len() {
            var def: bytecode.StructDef = c.module.StructDefs[i]
            if def.Name == resolved {
                return Some(def)
            }
            i = i + 1
        }
        var qualified: string = c.qualifyTypeName(resolved)
        if qualified != resolved {
            i = 0
            while i < c.module.StructDefs.len() {
                var def2: bytecode.StructDef = c.module.StructDefs[i]
                if def2.Name == qualified {
                    return Some(def2)
                }
                i = i + 1
            }
        }
        // Check same-module aliases
        for a in c.aliases {
            if a.Name == resolved {
                switch a.Underlying {
                    case ast.TypeExpression.Simple(st) {
                        // try to resolve underlying simple type
                        var underlyingOpt: Option<bytecode.StructDef> = c.findStructDef(st.Name)
                        switch underlyingOpt {
                            case Some(u) {
                                return Some(u)
                            }
                            case None {
                            }
                        }
                    }
                    default {
                    }
                }
            }
        }
        for t in c.typedefs {
            if t.Name == resolved {
                switch t.Underlying {
                    case ast.TypeExpression.Simple(st3) {
                        var underlyingOpt2: Option<bytecode.StructDef> = c.findStructDef(st3.Name)
                        switch underlyingOpt2 {
                            case Some(u2) {
                                return Some(u2)
                            }
                            case None {
                            }
                        }
                    }
                    default {
                    }
                }
            }
        }
        // If not found, and resolved looks like alias.Type, try importing the struct definition
        var idxOpt: Option<int> = resolved.indexOf(".")
        switch idxOpt {
            case Some(idx) {
                var prefix: string = resolved.substring(0, idx)
                var rest: string = resolved.substring(idx + 1, resolved.len())
                if c.isImportAlias(prefix) {
                    // find the import binding and locate struct info
                    for imp in c.imports {
                        if imp.Alias == prefix {
                            for s in imp.Module.Structs {
                                if s.Name == rest {
                                    var full: string = imp.ModuleName + "." + rest
                                    var def3: bytecode.StructDef = c.ensureImportedStruct(full, s)
                                    return Some(def3)
                                }
                            }
                            // If not a struct, the imported name might be an alias or typedef
                            for a in imp.Module.Aliases {
                                if a.Name == rest {
                                    // only handle simple underlying types that refer to a struct
                                    switch a.Underlying {
                                        case ast.TypeExpression.Simple(st) {
                                            var target: string = imp.ModuleName + "." + st.Name
                                            // try to find the actual struct in the imported module
                                            for s2 in imp.Module.Structs {
                                                if s2.Name == st.Name {
                                                    var def4: bytecode.StructDef = c.ensureImportedStruct(target, s2)
                                                    return Some(def4)
                                                }
                                            }
                                        }
                                        default {
                                        }
                                    }
                                }
                            }
                            for t in imp.Module.Types {
                                if t.Name == rest {
                                    switch t.Underlying {
                                        case ast.TypeExpression.Simple(st2) {
                                            var target2: string = imp.ModuleName + "." + st2.Name
                                            for s3 in imp.Module.Structs {
                                                if s3.Name == st2.Name {
                                                    var def5: bytecode.StructDef = c.ensureImportedStruct(target2, s3)
                                                    return Some(def5)
                                                }
                                            }
                                        }
                                        default {
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            case None {
            }
        }
        return None
    }
    func findEnumVariant(variantName: string) -> (Option<EnumVariantInfo>) {
        if c.moduleName != "" {
            for entry in c.enumVariantCache {
                if entry.VariantName == variantName && entry.EnumDef.Name.startsWith(c.moduleName + ".") {
                    return Some(EnumVariantInfo{EnumDef: entry.EnumDef, VariantIndex: entry.VariantIndex})
                }
            }
        }
        for entry in c.enumVariantCache {
            if entry.VariantName == variantName {
                return Some(EnumVariantInfo{EnumDef: entry.EnumDef, VariantIndex: entry.VariantIndex})
            }
        }
        return None
    }
    func qualifyName(name: string) -> (string) {
        if c.moduleName != "" && !name.contains(".") {
            return c.moduleName + "." + name
        }
        return name
    }
    func qualifyTypeName(name: string) -> (string) {
        return c.qualifyName(name)
    }
    func isImportAlias(name: string) -> (bool) {
        for imp in c.imports {
            if imp.Alias == name {
                return true
            }
        }
        return false
    }
    func importModuleName(aliasName: string) -> (string) {
        for imp in c.imports {
            if imp.Alias == aliasName {
                return imp.ModuleName
            }
        }
        return ""
    }
    func resolveImportedTypeName(name: string) -> (string) {
        var idxOpt: Option<int> = name.indexOf(".")
        switch idxOpt {
            case Some(idx) {
                var prefix: string = name.substring(0, idx)
                var rest: string = name.substring(idx + 1, name.len())
                if c.isImportAlias(prefix) {
                    var moduleName: string = c.importModuleName(prefix)
                    if moduleName != "" {
                        return moduleName + "." + rest
                    }
                }
            }
            case None {
            }
        }
        return name
    }
    mut func ensureImportedStruct(fullName: string, info: types.StructInfo) -> (bytecode.StructDef) {
        // Ensure imported struct is present in the bytecode module and return it.
        // Debug: log when attempting to ensure an imported struct
        for f in info.Fields {
            switch f.Type {
                case ast.TypeExpression.Simple(st) {
                    println("   ", f.Name, ":", st.Name)
                }
                default {
                    println("   ", f.Name, ": (complex)")
                }
            }
        }
        // Check existing
        mut var i: int = 0
        while i < c.module.StructDefs.len() {
            var def: bytecode.StructDef = c.module.StructDefs[i]
            if def.Name == fullName {
                return def
            }
            i = i + 1
        }
        mut var fields: Vec<bytecode.FieldDef, _> = Vec.new()
        for f in info.Fields {
            fields.push(bytecode.FieldDef{
                Name: f.Name,
                TypeExpr: f.Type,
                TypeName: "",
            })
        }
        var typeID: int = c.module.AddStruct(fullName, fields)
        var def2: bytecode.StructDef = c.module.StructDefs[typeID]
        return def2
    }
    mut func ensureImportedGlobal(aliasName: string, name: string) -> (void) {
        // Ensure an imported global (const) exists in this module's globals.
        // Find import by alias and log the imported module contents for debugging
        for imp in c.imports {
            if imp.Alias == aliasName {
                // List aliases with simple underlying when available
                for a in imp.Module.Aliases {
                    switch a.Underlying {
                        case ast.TypeExpression.Simple(st) {
                            println("  ", a.Name, "->", st.Name)
                        }
                        default {
                            println("  ", a.Name, "-> (complex)")
                        }
                    }
                }
                for t in imp.Module.Types {
                    switch t.Underlying {
                        case ast.TypeExpression.Simple(st2) {
                            println("  ", t.Name, "->", st2.Name)
                        }
                        default {
                            println("  ", t.Name, "-> (complex)")
                        }
                    }
                }
                for s in imp.Module.Structs {
                    println("  ", s.Name, "(fields:")
                    for f in s.Fields {
                        switch f.Type {
                            case ast.TypeExpression.Simple(st3) {
                                println("    ", f.Name, ":", st3.Name)
                            }
                            default {
                                println("    ", f.Name, ": (complex)")
                            }
                        }
                    }
                    println("  )")
                }
                for e in imp.Module.Enums {
                    println("  ", e.Name)
                }
                for cn in imp.Module.Consts {
                    println("  ", cn.Name)
                }
                for fn in imp.Module.Functions {
                    println("  ", fn.Name)
                }
                // look for const
                for cn in imp.Module.Consts {
                    if cn.Name == name {
                        var full: string = imp.ModuleName + "." + name
                        c.addGlobal(full)
                        return
                    }
                }
                // Also add if function exists in imported module (add function index placeholder)
                for fn in imp.Module.Functions {
                    if fn.Name == name {
                        var full: string = imp.ModuleName + "." + name
                        c.module.AddFunctionIndex(full, -1)
                        return
                    }
                }
            }
        }
    }
    mut func importedEnumVariant(aliasName: string, variantName: string) -> (Option<ImportedEnumVariant>) {
        for imp in c.imports {
            if imp.Alias == aliasName {
                mut var moduleName: string = imp.ModuleName
                if moduleName == "" {
                    moduleName = aliasName
                }
                for e in imp.Module.Enums {
                    mut var idx: int = 0
                    while idx < e.Variants.len() {
                        if (e.Variants[idx]).Name == variantName {
                            var enumName: string = moduleName + "." + e.Name
                            var def: bytecode.EnumDef = c.ensureImportedEnum(enumName, e)
                            return Some(ImportedEnumVariant{
                                EnumID: def.EnumID,
                                PayloadCount: (e.Variants[idx]).Fields.len(),
                                VariantIndex: idx,
                            })
                        }
                        idx = idx + 1
                    }
                }
            }
        }
        return None
    }
    mut func importedEnumVariantByType(aliasName: string, enumName: string, variantName: string) -> (Option<ImportedEnumVariant>) {
        for imp in c.imports {
            if imp.Alias == aliasName {
                mut var moduleName: string = imp.ModuleName
                if moduleName == "" {
                    moduleName = aliasName
                }
                for e in imp.Module.Enums {
                    if e.Name == enumName {
                        mut var idx: int = 0
                        while idx < e.Variants.len() {
                            if (e.Variants[idx]).Name == variantName {
                                var fullName: string = moduleName + "." + e.Name
                                var def: bytecode.EnumDef = c.ensureImportedEnum(fullName, e)
                                return Some(ImportedEnumVariant{
                                    EnumID: def.EnumID,
                                    PayloadCount: (e.Variants[idx]).Fields.len(),
                                    VariantIndex: idx,
                                })
                            }
                            idx = idx + 1
                        }
                    }
                }
            }
        }
        return None
    }
    mut func ensureImportedEnum(enumName: string, info: types.EnumInfo) -> (bytecode.EnumDef) {
        mut var i: int = 0
        while i < c.module.EnumDefs.len() {
            var def: bytecode.EnumDef = c.module.EnumDefs[i]
            if def.Name == enumName {
                return def
            }
            i = i + 1
        }
        mut var variants: Vec<bytecode.VariantDef, _> = Vec.new()
        mut var j: int = 0
        while j < info.Variants.len() {
            variants.push(bytecode.VariantDef{
                Name: (info.Variants[j]).Name,
                PayloadCount: (info.Variants[j]).Fields.len(),
                VariantID: j,
            })
            j = j + 1
        }
        c.module.AddEnum(enumName, variants)
        mut var k: int = 0
        while k < c.module.EnumDefs.len() {
            var def2: bytecode.EnumDef = c.module.EnumDefs[k]
            if def2.Name == enumName {
                return def2
            }
            k = k + 1
        }
        return bytecode.EnumDef{
            EnumID: -1,
            Name: enumName,
            VariantIndex: Vec.new(),
            Variants: Vec.new(),
        }
    }
    mut func compileDefaultValue(t: ast.TypeExpression) -> (Result<void, string>) {
        // We can simply call internal, as explicit usage (like var declarations) 
        // doesn't carry over 'seen' context from other places.
        // We just rely on c.defaultRecursiveSeen state.
        return c.compileDefaultValueInternal(t)
    }
    mut func compileDefaultValueInternal(t: ast.TypeExpression) -> (Result<void, string>) {
        switch t {
            case ast.TypeExpression.Simple(st) {
                return c.compileDefaultSimpleType(st.Name)
            }
            case ast.TypeExpression.Void(_) {
                c.emit(opcode.OP_NIL)
                return Ok(void)
            }
            case ast.TypeExpression.Generic(gt) {
                return c.compileDefaultGenericType(gt)
            }
            case ast.TypeExpression.BoxRef(_) {
                return c.compileDefaultBox()
            }
            case ast.TypeExpression.BoxOptional(_) {
                c.emit(opcode.OP_NEW_OPTION_NONE)
                return Ok(void)
            }
            case ast.TypeExpression.BorrowRef(_) {
                c.emit(opcode.OP_NIL)
                return Ok(void)
            }
            default {
                c.emit(opcode.OP_NIL)
                return Ok(void)
            }
        }
    }
    mut func compileDefaultSimpleType(name: string) -> (Result<void, string>) {
        if name == "int" || name == "int8" || name == "int16" || name == "int32" || name == "int64" {
            c.emitConstant(value.NewInt(0))
            return Ok(void)
        }
        if name == "uint" || name == "uint8" || name == "uint16" || name == "uint32" || name == "uint64" {
            c.emitConstant(value.NewInt(0))
            return Ok(void)
        }
        if name == "float32" || name == "float64" {
            c.emitConstant(value.NewFloat(0.0))
            return Ok(void)
        }
        if name == "bool" {
            c.emit(opcode.OP_FALSE)
            return Ok(void)
        }
        if name == "string" {
            c.emitConstant(value.NewString(""))
            return Ok(void)
        }
        if name == "char" {
            c.emitConstant(value.NewChar(char(0)))
            return Ok(void)
        }
        if name == "void" {
            c.emit(opcode.OP_NIL)
            return Ok(void)
        }
        switch c.findStructDef(name) {
            case Some(def) {
                return c.compileDefaultStruct(def)
            }
            case None {
            }
        }
        c.emit(opcode.OP_NIL)
        return Ok(void)
    }
    mut func compileDefaultGenericType(gt: ast.GenericType) -> (Result<void, string>) {
        if gt.Name == "Vec" {
            return c.compileDefaultVec(gt)
        }
        if gt.Name == "Option" {
            c.emit(opcode.OP_NEW_OPTION_NONE)
            return Ok(void)
        }
        if gt.Name == "Result" {
            c.emit(opcode.OP_NIL)
            return Ok(void)
        }
        if gt.Name == "Box" {
            return c.compileDefaultBox()
        }
        c.emit(opcode.OP_NIL)
        return Ok(void)
    }
    mut func compileDefaultVec(gt: ast.GenericType) -> (Result<void, string>) {
        mut var elem: Option<ast.TypeExpression> = None
        mut var size: int = -1
        for param in gt.TypeParams {
            switch param {
                case ast.TypeExpression.Size(se) {
                    if !se.IsDynamic {
                        size = se.Value
                    }
                }
                default {
                    switch elem {
                        case None {
                            elem = Some(param)
                        }
                        case Some(_) {
                        }
                    }
                }
            }
        }
        if size >= 0 {
            switch elem {
                case Some(et) {
                    mut var i: int = 0
                    while i < size {
                        var res: Result<void, string> = c.compileDefaultValueInternal(et)
                        switch res {
                            case Err(msg) {
                                return Err(msg)
                            }
                            case Ok(_) {
                            }
                        }
                        i = i + 1
                    }
                    c.emitConstant(value.NewInt(size))
                    c.emit(opcode.OP_NEW_VEC_FIXED)
                    return Ok(void)
                }
                case None {
                }
            }
        }
        c.emitConstant(value.NewInt(0))
        c.emit(opcode.OP_NEW_VEC_DYNAMIC)
        return Ok(void)
    }
    mut func compileDefaultStruct(def: bytecode.StructDef) -> (Result<void, string>) {
        if containsString(&mut c.defaultRecursiveSeen, def.Name) {
            c.emit(opcode.OP_NIL)
            return Ok(void)
        }
        c.defaultRecursiveSeen.push(def.Name)
        var fieldCount: int = def.Fields.len()
        mut var i: int = 0
        while i < fieldCount {
            var field: bytecode.FieldDef = def.Fields[i]
            var res: Result<void, string> = c.compileDefaultValueInternal(field.TypeExpr)
            switch res {
                case Err(msg) {
                    return Err(msg)
                }
                case Ok(_) {
                }
            }
            i = i + 1
        }
        removeString(&mut c.defaultRecursiveSeen, def.Name)
        c.emitConstant(value.NewInt(def.TypeID))
        c.emitConstant(value.NewInt(fieldCount))
        c.emit(opcode.OP_NEW_STRUCT)
        return Ok(void)
    }
    mut func compileDefaultBox() -> (Result<void, string>) {
        c.emit(opcode.OP_NEW_OPTION_NONE)
        c.emit(opcode.OP_BUILTIN)
        c.emitByte(BUILTIN_BOX)
        c.emitByte(1)
        return Ok(void)
    }
    mut func addLocal(name: string) -> (void) {
        // Underscore is a discard pattern; do not allocate a local slot for it.
        if name == "_" {
            return
        }
        c.locals.push(Local{
            Depth: c.scopeDepth,
            Name: name,
            Slot: c.locals.len(),
        })
        if c.locals.len() > c.maxLocals {
            c.maxLocals = c.locals.len()
        }
        return
    }
    mut func beginScope() -> (void) {
        c.scopeDepth = c.scopeDepth + 1
        return
    }
    mut func endScope() -> (void) {
        c.scopeDepth = c.scopeDepth - 1
        while c.locals.len() > 0 {
            var last: Local = c.locals[c.locals.len() - 1]
            if last.Depth <= c.scopeDepth {
                break
            }
            c.locals.remove(c.locals.len() - 1)
        }
    }
    func resolveLocal(name: string) -> (int) {
        if c.locals.len() == 0 {
            return -1
        }
        mut var i: int = c.locals.len() - 1
        while i >= 0 {
            if (c.locals[i]).Name == name {
                return (c.locals[i]).Slot
            }
            if i == 0 {
                break
            }
            i = i - 1
        }
        return -1
    }
    mut func emitEntryWrapper(initIndex: int, mainIndex: int) -> (void) {
        c.emit(opcode.OP_GET_FUNC)
        c.emitShort(initIndex)
        c.emit(opcode.OP_CALL)
        c.emitByte(0)
        c.emit(opcode.OP_POP)
        c.emit(opcode.OP_GET_FUNC)
        c.emitShort(mainIndex)
        c.emit(opcode.OP_CALL)
        c.emitByte(0)
        c.emit(opcode.OP_RETURN)
    }
    mut func emit(op: opcode.Opcode) -> (void) {
        mut var fn = c.currentFunction.unwrap()
        bytecode.FunctionPushCode(&mut fn, opcode.OpcodeValue(op))
        c.currentFunction = Some(fn)
        return
    }
    mut func emitByte(op: int) -> (void) {
        mut var fn = c.currentFunction.unwrap()
        bytecode.FunctionPushCode(&mut fn, op)
        c.currentFunction = Some(fn)
        return
    }
    mut func emitShort(v: int) -> (void) {
        c.emitShortDirect(v)
    }
    mut func emitShortDirect(value: int) -> (void) {
        mut var fn = c.currentFunction.unwrap()
        var high: int = value >> 8 & 0xFF
        var low: int = value & 0xFF
        bytecode.FunctionPushCode(&mut fn, high)
        bytecode.FunctionPushCode(&mut fn, low)
        c.currentFunction = Some(fn)
        return
    }
    mut func emitConstant(v: value.Value) -> (int) {
        var idx: int = c.addConstant(v)
        c.emit(opcode.OP_CONST)
        c.emitShort(idx)
        return idx
    }
    mut func addConstant(val: value.Value) -> (int) {
        mut var fn = c.currentFunction.unwrap()
        var idx: int = bytecode.FunctionAddConstant(&mut fn, val)
        c.currentFunction = Some(fn)
        return idx
    }
    mut func emitJump(op: opcode.Opcode) -> (int) {
        c.emit(op)
        c.emitByte(255)
        c.emitByte(255)
        mut var fn = c.currentFunction.unwrap()
        var len: int = bytecode.FunctionCodeLen(&fn)
        c.currentFunction = Some(fn)
        return len - 2
    }
    mut func patchJump(pos: int) -> (void) {
        mut var fn_len: int = 0
        {
            mut var fn_temp = c.currentFunction.unwrap()
            fn_len = bytecode.FunctionCodeLen(&fn_temp)
            c.currentFunction = Some(fn_temp)
        }
        var offset: int = fn_len - pos - 2
        var high: int = offset >> 8 & 0xFF
        var low: int = offset & 0xFF
        mut var fn = c.currentFunction.unwrap()
        bytecode.FunctionSetCode(&mut fn, pos, high)
        bytecode.FunctionSetCode(&mut fn, pos + 1, low)
        c.currentFunction = Some(fn)
        return
    }
    mut func emitLoop(loopStart: int) -> (void) {
        c.emit(opcode.OP_JMP)
        mut var fn = c.currentFunction.unwrap()
        var offset: int = bytecode.FunctionCodeLen(&fn) - loopStart + 2
        c.currentFunction = Some(fn)
        c.emitSignedShort(-offset)
    }
    mut func emitSignedShort(value: int) -> (void) {
        mut var fn = c.currentFunction.unwrap()
        mut var u: int = 0
        if value < 0 {
            u = value + 65536
        } else {
            u = value
        }
        var high: int = u >> 8 & 0xFF
        var low: int = u & 0xFF
        bytecode.FunctionPushCode(&mut fn, high)
        bytecode.FunctionPushCode(&mut fn, low)
        c.currentFunction = Some(fn)
        return
    }
    mut func ensureReturn() -> (void) {
        mut var fn = c.currentFunction.unwrap()
        if bytecode.FunctionCodeLen(&fn) == 0 {
            c.currentFunction = Some(fn)
            c.emit(opcode.OP_RETURN_VOID)
            return
        }
        var last: int = bytecode.FunctionGetCode(&fn, bytecode.FunctionCodeLen(&fn) - 1)
        c.currentFunction = Some(fn)
        if last != opcode.OpcodeValue(opcode.OP_RETURN) && last != opcode.OpcodeValue(opcode.OP_RETURN_VOID) {
            c.emit(opcode.OP_RETURN_VOID)
        }
    }
    mut func addGlobal(name: string) -> (int) {
        var idx: int = c.module.AddGlobal(name)
        var h: int = name.hash()
        mut var bucketIdx: int = h % 1024
        if bucketIdx < 0 {
            bucketIdx = -bucketIdx
        }
        (c.globalCache[bucketIdx]).Entries.push(GlobalCacheEntry{Index: idx, Name: name})
        return idx
    }
    func lookupGlobal(name: string) -> (Option<int>) {
        var h: int = name.hash()
        mut var bucketIdx: int = h % 1024
        if bucketIdx < 0 {
            bucketIdx = -bucketIdx
        }
        for entry in (c.globalCache[bucketIdx]).Entries {
            if entry.Name == name {
                return Some(entry.Index)
            }
        }
        return None
    }
}

func builtinId(name: string) -> (Option<int>) {
    if name == "len" {
        return Some(BUILTIN_LEN)
    }
    if name == "println" {
        return Some(BUILTIN_PRINTLN)
    }
    if name == "print" {
        return Some(BUILTIN_PRINT)
    }
    if name == "push" {
        return Some(BUILTIN_PUSH)
    }
    if name == "pop" {
        return Some(BUILTIN_POP)
    }
    if name == "__builtin_string_from_bytes" {
        return Some(BUILTIN_STRING_FROM_BYTES)
    }
    if name == "first" {
        return Some(BUILTIN_FIRST)
    }
    if name == "last" {
        return Some(BUILTIN_LAST)
