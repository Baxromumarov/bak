    return None
}

func patternBindingName(expr: ast.Expression) -> (Option<string>) {
    switch expr {
        case ast.Expression.Identifier(id) {
            return Some(id.Value)
        }
        case ast.Expression.MutableIdentifier(id) {
            return Some(id.Value)
        }
        default {
            return None
        }
    }
}

func containsString(list: &mut Vec<string, _>, value: string) -> (bool) {
    mut var i: int = 0
    while i < list.len() {
        if list[i] == value {
            return true
        }
        i = i + 1
    }
    return false
}

func removeString(list: &mut Vec<string, _>, value: string) -> (void) {
    mut var i: int = 0
    while i < list.len() {
        if list[i] == value {
            (*list).remove(i)
            return
        }
        i = i + 1
    }
}
