// Bytecode opcode definitions for bakc.
package bytecode

pub enum Opcode {
    // Stack + constants
    OP_CONST
    OP_POP
    OP_DUP
    OP_SWAP

    // Locals / globals
    OP_GET_LOCAL
    OP_SET_LOCAL
    OP_GET_GLOBAL
    OP_SET_GLOBAL

    // Arithmetic
    OP_ADD
    OP_SUB
    OP_MUL
    OP_DIV
    OP_MOD
    OP_NEG

    // Comparison
    OP_EQ
    OP_NEQ
    OP_LT
    OP_LTE
    OP_GT
    OP_GTE

    // Boolean
    OP_NOT
    OP_AND
    OP_OR

    // Control flow
    OP_JMP
    OP_JMP_IF_FALSE
    OP_JMP_IF_TRUE
    OP_RETURN
    OP_RETURN_VOID
    OP_DEFER
    OP_DEFER_METHOD
    OP_DEFER_BUILTIN
    OP_PANIC

    // Function calls
    OP_CALL
    OP_CALL_METHOD
    OP_CLOSURE
    OP_GET_FUNC

    // Upvalues (for closures)
    OP_GET_UPVALUE
    OP_SET_UPVALUE
    OP_CLOSE_UPVALUE

    // Structs
    OP_NEW_STRUCT
    OP_GET_FIELD
    OP_SET_FIELD

    // Enums
    OP_NEW_ENUM
    OP_IS_VARIANT
    OP_GET_PAYLOAD

    // Option type (built-in)
    OP_NEW_OPTION_SOME
    OP_NEW_OPTION_NONE

    // Vec operations
    OP_NEW_VEC_FIXED
    OP_NEW_VEC_DYNAMIC
    OP_VEC_LEN
    OP_VEC_GET
    OP_VEC_SET
    OP_VEC_PUSH
    OP_VEC_POP

    // Range
    OP_NEW_RANGE

    // Built-in
    OP_PRINT
    OP_PRINTLN
    OP_BUILTIN

    // String operations
    OP_CONCAT

    // Special
    OP_NIL
    OP_TRUE
    OP_FALSE

    // Bitwise
    OP_BITAND
    OP_BITOR
    OP_BITXOR
    OP_SHL
    OP_SHR
    OP_UNPACK_N
    OP_NEW_TUPLE
    OP_BORROW_LOCAL
    OP_BORROW_GLOBAL
    OP_DEREF
    OP_STORE_DEREF
}

pub func OpcodeValue(op: Opcode) -> (int) {
    switch op {
        case OP_CONST { return 0 }
        case OP_POP { return 1 }
        case OP_DUP { return 2 }
        case OP_SWAP { return 3 }
        case OP_GET_LOCAL { return 4 }
        case OP_SET_LOCAL { return 5 }
        case OP_GET_GLOBAL { return 6 }
        case OP_SET_GLOBAL { return 7 }
        case OP_ADD { return 8 }
        case OP_SUB { return 9 }
        case OP_MUL { return 10 }
        case OP_DIV { return 11 }
        case OP_MOD { return 12 }
        case OP_NEG { return 13 }
        case OP_EQ { return 14 }
        case OP_NEQ { return 15 }
        case OP_LT { return 16 }
        case OP_LTE { return 17 }
        case OP_GT { return 18 }
        case OP_GTE { return 19 }
        case OP_NOT { return 20 }
        case OP_AND { return 21 }
        case OP_OR { return 22 }
        case OP_JMP { return 23 }
        case OP_JMP_IF_FALSE { return 24 }
        case OP_JMP_IF_TRUE { return 25 }
        case OP_RETURN { return 26 }
        case OP_RETURN_VOID { return 27 }
        case OP_DEFER { return 28 }
        case OP_DEFER_METHOD { return 29 }
        case OP_DEFER_BUILTIN { return 30 }
        case OP_PANIC { return 31 }
        case OP_CALL { return 32 }
        case OP_CALL_METHOD { return 33 }
        case OP_CLOSURE { return 34 }
        case OP_GET_FUNC { return 35 }
        case OP_GET_UPVALUE { return 36 }
        case OP_SET_UPVALUE { return 37 }
        case OP_CLOSE_UPVALUE { return 38 }
        case OP_NEW_STRUCT { return 39 }
        case OP_GET_FIELD { return 40 }
        case OP_SET_FIELD { return 41 }
        case OP_NEW_ENUM { return 42 }
        case OP_IS_VARIANT { return 43 }
        case OP_GET_PAYLOAD { return 44 }
        case OP_NEW_OPTION_SOME { return 45 }
        case OP_NEW_OPTION_NONE { return 46 }
        case OP_NEW_VEC_FIXED { return 47 }
        case OP_NEW_VEC_DYNAMIC { return 48 }
        case OP_VEC_LEN { return 49 }
        case OP_VEC_GET { return 50 }
        case OP_VEC_SET { return 51 }
        case OP_VEC_PUSH { return 52 }
        case OP_VEC_POP { return 53 }
        case OP_NEW_RANGE { return 54 }
        case OP_PRINT { return 55 }
        case OP_PRINTLN { return 56 }
        case OP_BUILTIN { return 57 }
        case OP_CONCAT { return 58 }
        case OP_NIL { return 59 }
        case OP_TRUE { return 60 }
        case OP_FALSE { return 61 }
        case OP_BITAND { return 62 }
        case OP_BITOR { return 63 }
        case OP_BITXOR { return 64 }
        case OP_SHL { return 65 }
        case OP_SHR { return 66 }
        case OP_UNPACK_N { return 67 }
        case OP_NEW_TUPLE { return 68 }
        case OP_BORROW_LOCAL { return 69 }
        case OP_BORROW_GLOBAL { return 70 }
        case OP_DEREF { return 71 }
        case OP_STORE_DEREF { return 72 }
    }
    return 0
}

pub func OpcodeString(op: Opcode) -> (string) {
    switch op {
        case OP_CONST { return "OP_CONST" }
        case OP_POP { return "OP_POP" }
        case OP_DUP { return "OP_DUP" }
        case OP_SWAP { return "OP_SWAP" }
        case OP_GET_LOCAL { return "OP_GET_LOCAL" }
        case OP_SET_LOCAL { return "OP_SET_LOCAL" }
        case OP_GET_GLOBAL { return "OP_GET_GLOBAL" }
        case OP_SET_GLOBAL { return "OP_SET_GLOBAL" }
        case OP_ADD { return "OP_ADD" }
        case OP_SUB { return "OP_SUB" }
        case OP_MUL { return "OP_MUL" }
        case OP_DIV { return "OP_DIV" }
        case OP_MOD { return "OP_MOD" }
        case OP_NEG { return "OP_NEG" }
        case OP_EQ { return "OP_EQ" }
        case OP_NEQ { return "OP_NEQ" }
        case OP_LT { return "OP_LT" }
        case OP_LTE { return "OP_LTE" }
        case OP_GT { return "OP_GT" }
        case OP_GTE { return "OP_GTE" }
        case OP_NOT { return "OP_NOT" }
        case OP_AND { return "OP_AND" }
        case OP_OR { return "OP_OR" }
        case OP_JMP { return "OP_JMP" }
        case OP_JMP_IF_FALSE { return "OP_JMP_IF_FALSE" }
        case OP_JMP_IF_TRUE { return "OP_JMP_IF_TRUE" }
        case OP_RETURN { return "OP_RETURN" }
        case OP_RETURN_VOID { return "OP_RETURN_VOID" }
        case OP_DEFER { return "OP_DEFER" }
        case OP_DEFER_METHOD { return "OP_DEFER_METHOD" }
        case OP_DEFER_BUILTIN { return "OP_DEFER_BUILTIN" }
        case OP_PANIC { return "OP_PANIC" }
        case OP_CALL { return "OP_CALL" }
        case OP_CALL_METHOD { return "OP_CALL_METHOD" }
        case OP_CLOSURE { return "OP_CLOSURE" }
        case OP_GET_FUNC { return "OP_GET_FUNC" }
        case OP_GET_UPVALUE { return "OP_GET_UPVALUE" }
        case OP_SET_UPVALUE { return "OP_SET_UPVALUE" }
        case OP_CLOSE_UPVALUE { return "OP_CLOSE_UPVALUE" }
        case OP_NEW_STRUCT { return "OP_NEW_STRUCT" }
        case OP_GET_FIELD { return "OP_GET_FIELD" }
        case OP_SET_FIELD { return "OP_SET_FIELD" }
        case OP_NEW_ENUM { return "OP_NEW_ENUM" }
        case OP_IS_VARIANT { return "OP_IS_VARIANT" }
        case OP_GET_PAYLOAD { return "OP_GET_PAYLOAD" }
        case OP_NEW_OPTION_SOME { return "OP_NEW_OPTION_SOME" }
        case OP_NEW_OPTION_NONE { return "OP_NEW_OPTION_NONE" }
        case OP_NEW_VEC_FIXED { return "OP_NEW_VEC_FIXED" }
        case OP_NEW_VEC_DYNAMIC { return "OP_NEW_VEC_DYNAMIC" }
        case OP_VEC_LEN { return "OP_VEC_LEN" }
        case OP_VEC_GET { return "OP_VEC_GET" }
        case OP_VEC_SET { return "OP_VEC_SET" }
        case OP_VEC_PUSH { return "OP_VEC_PUSH" }
        case OP_VEC_POP { return "OP_VEC_POP" }
        case OP_NEW_RANGE { return "OP_NEW_RANGE" }
        case OP_PRINT { return "OP_PRINT" }
        case OP_PRINTLN { return "OP_PRINTLN" }
        case OP_BUILTIN { return "OP_BUILTIN" }
        case OP_CONCAT { return "OP_CONCAT" }
        case OP_NIL { return "OP_NIL" }
        case OP_TRUE { return "OP_TRUE" }
        case OP_FALSE { return "OP_FALSE" }
        case OP_BITAND { return "OP_BITAND" }
        case OP_BITOR { return "OP_BITOR" }
        case OP_BITXOR { return "OP_BITXOR" }
        case OP_SHL { return "OP_SHL" }
        case OP_SHR { return "OP_SHR" }
        case OP_UNPACK_N { return "OP_UNPACK_N" }
        case OP_NEW_TUPLE { return "OP_NEW_TUPLE" }
        case OP_BORROW_LOCAL { return "OP_BORROW_LOCAL" }
        case OP_BORROW_GLOBAL { return "OP_BORROW_GLOBAL" }
        case OP_DEREF { return "OP_DEREF" }
        case OP_STORE_DEREF { return "OP_STORE_DEREF" }
        default { return "OP_UNKNOWN" }
    }
}
