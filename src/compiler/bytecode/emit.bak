func emitIntList(values: Vec<int, _>) -> (string) {
    mut var out: string = "["
    mut var i: int = 0
    while i < values.len() {
        if i > 0 {
            out = out + ","
        }
        out = out + strconv.intToString(values[i])
        i = i + 1
    }
    out = out + "]"
    return out
}

func emitValue(v: value.Value) -> (string) {
    var t: value.ValueType = value.ValueTypeOf(v)
    if t == value.VAL_NIL {
        return "{\"type\":\"nil\"}"
    }
    if t == value.VAL_BOOL {
        return "{\"type\":\"bool\",\"value\":" + boolToString(value.BoolValueOf(v)) + "}"
    }
    if t == value.VAL_INT {
        return "{\"type\":\"int\",\"value\":" + strconv.intToString(value.IntValueOf(v)) + "}"
    }
    if t == value.VAL_FLOAT {
        var fv: float64 = value.FloatValueOf(v)
        return "{\"type\":\"float\",\"value\":" + fv.toString() + "}"
    }
    if t == value.VAL_STRING {
        return "{\"type\":\"string\",\"value\":\"" + escapeString(value.StringValueOf(v)) + "\"}"
    }
    if t == value.VAL_CHAR {
        var s: string = string(value.CharValueOf(v))
        return "{\"type\":\"char\",\"value\":\"" + escapeString(s) + "\"}"
    }
    return "{\"type\":\"object\",\"value\":" + strconv.intToString(value.ObjectIndexOf(v)) + "}"
}

func boolToString(v: bool) -> (string) {
    if v {
        return "true"
    }
    return "false"
}

func escapeString(s: string) -> (string) {
    mut var out: string = ""
    var chars: Vec<char, _> = s.chars()
    mut var i: int = 0
    while i < chars.len() {
        var ch: char = chars[i]
        if ch == '"' {
            out = out + "\\\""
        } else if ch == '\\' {
            out = out + "\\\\"
        } else if ch == '\n' {
            out = out + "\\n"
        } else if ch == '\r' {
            out = out + "\\r"
        } else if ch == '\t' {
            out = out + "\\t"
        } else if ch == char(0) {
            out = out + "\\u0000"
        } else if ch == char(27) {
            out = out + "\\u001b"
        } else {
            out = out + string(ch)
        }
        i = i + 1
    }
    return out
}
