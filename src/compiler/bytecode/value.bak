// Bytecode value definitions for bakc.
package bytecode

pub enum ValueType {
    VAL_NIL
    VAL_BOOL
    VAL_INT
    VAL_FLOAT
    VAL_STRING
    VAL_FUNCTION
    VAL_CLOSURE
    VAL_STRUCT
    VAL_ENUM
    VAL_VEC
    VAL_RANGE
    VAL_CHAR
    VAL_BUILTIN
    VAL_OPTION
    VAL_BOX
}

pub struct Value {
    Type: ValueType
    IntValue: int
    FloatValue: float64
    BoolValue: bool
    CharValue: char
    StringValue: string
    ObjectIndex: int
}

pub func NewNil() -> (Value) {
    return Value{Type: VAL_NIL}
}

pub func NewBool(v: bool) -> (Value) {
    return Value{Type: VAL_BOOL, BoolValue: v}
}

pub func NewInt(v: int) -> (Value) {
    return Value{Type: VAL_INT, IntValue: v}
}

pub func NewFloat(v: float64) -> (Value) {
    return Value{Type: VAL_FLOAT, FloatValue: v}
}

pub func NewString(v: string) -> (Value) {
    return Value{Type: VAL_STRING, StringValue: v}
}

pub func NewChar(v: char) -> (Value) {
    return Value{Type: VAL_CHAR, CharValue: v}
}

// Accessor helpers to expose fields without direct field access
pub func ValueTypeOf(v: Value) -> (ValueType) {
    return v.Type
}

pub func BoolValueOf(v: Value) -> (bool) {
    return v.BoolValue
}

pub func IntValueOf(v: Value) -> (int) {
    return v.IntValue
}

pub func FloatValueOf(v: Value) -> (float64) {
    return v.FloatValue
}

pub func StringValueOf(v: Value) -> (string) {
    return v.StringValue
}

pub func CharValueOf(v: Value) -> (char) {
    return v.CharValue
}

pub func ObjectIndexOf(v: Value) -> (int) {
    return v.ObjectIndex
}
