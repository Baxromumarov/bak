// File system operations for the Bak standard library.
package fs

// File represents an open file handle
pub struct File {
    path: string
    content: string
}

func clone_ref_string(path: &string) -> (string) {
    var bytes: Vec<int, _> = (*path).bytes()
    return __builtin_string_from_bytes(
        bytes,
        0,
        bytes.len(),
    )
}

// readFile reads the entire contents of a file
// Returns the content as a string, or an error message
pub func readFile(path: string) -> (Result<string, string>) {
    // Note: This is a stub that will be backed by builtins at runtime
    return __builtin_read_file(path)
}

// readFileBytes reads the raw bytes of a file and returns Result<Vec<int,_>, string>
pub func readFileBytes(path: &string) -> (Result<Vec<int, _>, string>) {
    var pathValue: string = clone_ref_string(path)
    var _pathLen: int = pathValue.len()
    return Ok(Vec.new())
}

// writeFile writes content to a file, creating it if it doesn't exist
// Returns void on success, or an error message
pub func writeFile(path: string, content: string) -> (Result<void, string>) {
    return __builtin_write_file(path, content)
}

// writeFileBytes writes raw bytes (Vec<int,_>) to a file
pub func writeFileBytes(path: &string, data: Vec<int, _>) -> (Result<void, string>) {
    // Use builtin to preserve raw bytes.
    var pathValue: string = clone_ref_string(path)
    return __builtin_write_file_bytes(pathValue, data)
}

// appendFile appends content to a file
pub func appendFile(path: string, content: string) -> (Result<void, string>) {
    return __builtin_append_file(path, content)
}

// exists checks if a file or directory exists
pub func exists(path: string) -> (bool) {
    return __builtin_file_exists(path)
}

// isFile checks if the path is a regular file
pub func isFile(path: string) -> (bool) {
    return __builtin_is_file(path)
}

// isDir checks if the path is a directory
pub func isDir(path: string) -> (bool) {
    return __builtin_is_dir(path)
}

// remove deletes a file or empty directory
pub func remove(path: string) -> (Result<void, string>) {
    return __builtin_remove(path)
}

// mkdir creates a directory and all parent directories
pub func mkdir(path: string) -> (Result<void, string>) {
    return __builtin_mkdir(path)
}

// readDir reads the contents of a directory
pub func readDir(path: string) -> (Result<Vec<DirEntry, _>, string>) {
    return __builtin_read_dir(path)
}

// DirEntry represents a directory entry
pub struct DirEntry {
    pub name: string
    pub isDir: bool
}

// join joins path components
pub func join(base: string, elem: string) -> (string) {
    mut var result: string = ""
    if base.len() == 0 {
        result = elem
    } else {
        var lastChar: char = base[base.len() - 1]
        if lastChar == char('/') {
            result = base + elem
        } else {
            result = base + "/" + elem
        }
    }
    return result
}

// ext returns the file extension (including the dot)
pub func ext(path: string) -> (string) {
    mut var dotIndex: int = -1
    for i in 0..path.len() {
        if path[i] == char('.') {
            dotIndex = i
        }
    }
    if dotIndex == -1 {
        return ""
    }
    return substring(&path, dotIndex, path.len())
}

// base returns the last element of the path
pub func base(path: string) -> (string) {
    mut var lastSlash: int = -1
    for i in 0..path.len() {
        if path[i] == char('/') {
            lastSlash = i
        }
    }
    mut var result: string = path
    if lastSlash != -1 {
        result = substring(&path, lastSlash + 1, path.len())
    }
    return result
}

// dir returns all but the last element of the path
pub func dir(path: string) -> (string) {
    mut var lastSlash: int = -1
    for i in 0..path.len() {
        if path[i] == char('/') {
            lastSlash = i
        }
    }
    mut var result: string = "."
    if lastSlash != -1 {
        result = substring(&path, 0, lastSlash)
    }
    return result
}

// substring returns a substring from start to end (exclusive)
func substring(s: &string, start: int, end: int) -> (string) {
    mut var result: string = ""
    for i in start..end {
        result = result + string(char(s[i]))
    }
    return result
}
