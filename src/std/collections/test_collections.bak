package collections

import "src/std/test/test.bak" as test
import "src/std/collections/vec.bak" as vec
import "src/std/collections/hashmap.bak" as hashmap

// =============================================================================
// Vec Tests
// =============================================================================

func test_vec_push_pop() -> (void) {
    mut var t: test.T = test.new("test_vec_push_pop")
    mut var v: Vec<int, _> = Vec.new()
    
    // Empty vec
    t.eq(v.len(), 0)
    
    // Push elements
    v.push(10)
    v.push(20)
    v.push(30)
    t.eq(v.len(), 3)
    
    // Pop elements (LIFO)
    switch v.pop() {
        case Some(val) { t.eq(val, 30) }
        case None { t.fail("expected Some, got None") }
    }
    t.eq(v.len(), 2)
    t.finish()
}

func test_vec_index_access() -> (void) {
    mut var t: test.T = test.new("test_vec_index_access")
    mut var v: Vec<string, _> = Vec.new()
    v.push("hello")
    v.push("world")
    
    t.eq_string(v[0], "hello")
    t.eq_string(v[1], "world")
    t.finish()
}

func test_vec_from() -> (void) {
    mut var t: test.T = test.new("test_vec_from")
    var v: Vec<int, _> = Vec.from([1, 2, 3])
    
    t.eq(v.len(), 3)
    t.eq(v[0], 1)
    t.eq(v[1], 2)
    t.eq(v[2], 3)
    t.finish()
}

func test_vec_index_of() -> (void) {
    mut var t: test.T = test.new("test_vec_index_of")
    mut var v: Vec<int, _> = Vec.new()
    v.push(100)
    v.push(200)
    v.push(300)
    
    t.eq(vec.index_of(&v, 200, eq_int), 1)
    t.eq(vec.index_of(&v, 999, eq_int), -1)
    t.finish()
}

func test_vec_sum() -> (void) {
    mut var t: test.T = test.new("test_vec_sum")
    mut var v: Vec<int, _> = Vec.new()
    v.push(1)
    v.push(2)
    v.push(3)
    v.push(4)
    
    t.eq(vec.sum(&v), 10)
    t.finish()
}

func test_vec_max_min() -> (void) {
    mut var t: test.T = test.new("test_vec_max_min")
    mut var v: Vec<int, _> = Vec.new()
    v.push(5)
    v.push(2)
    v.push(9)
    v.push(1)
    
    switch vec.max_by(&v, compare_ints) {
        case Some(val) { t.eq(val, 9) }
        case None { t.fail("expected Some for max") }
    }
    
    switch vec.min_by(&v, compare_ints) {
        case Some(val) { t.eq(val, 1) }
        case None { t.fail("expected Some for min") }
    }
    t.finish()
}

func eq_int(a: &int, b: &int) -> (bool) { return *a == *b }
func compare_ints(a: &int, b: &int) -> (int) {
    if *a < *b { return -1 }
    if *a > *b { return 1 }
    return 0
}

// =============================================================================
// HashMap Tests (string -> string)
// =============================================================================

func test_hashmap_insert_get() -> (void) {
    mut var t: test.T = test.new("test_hashmap_insert_get")
    mut var m: hashmap.HashMap<string, string> = hashmap.new_hash_map()

    m.insert("name", "Alice")
    m.insert("city", "Boston")

    t.eq(m.len(), 2)

    switch m.get(&"name") {
        case Some(val) { t.eq_string(val, "Alice") }
        case None { t.fail("expected Some for 'name'") }
    }

    switch m.get(&"city") {
        case Some(val) { t.eq_string(val, "Boston") }
        case None { t.fail("expected Some for 'city'") }
    }
    t.finish()
}

func test_hashmap_update() -> (void) {
    mut var t: test.T = test.new("test_hashmap_update")
    mut var m: hashmap.HashMap<string, string> = hashmap.new_hash_map()

    m.insert("key", "value1")
    m.insert("key", "value2")  // Update same key

    t.eq(m.len(), 1)  // Still only 1 entry

    switch m.get(&"key") {
        case Some(val) { t.eq_string(val, "value2") }
        case None { t.fail("expected Some") }
    }
    t.finish()
}

func test_hashmap_remove() -> (void) {
    mut var t: test.T = test.new("test_hashmap_remove")
    mut var m: hashmap.HashMap<string, string> = hashmap.new_hash_map()

    m.insert("a", "1")
    m.insert("b", "2")

    switch m.remove(&"a") {
        case Some(val) { t.eq_string(val, "1") }
        case None { t.fail("expected Some for remove") }
    }

    t.eq(m.len(), 1)
    t.is_false(m.contains(&"a"))
    t.is_true(m.contains(&"b"))
    t.finish()
}

func test_hashmap_missing_key() -> (void) {
    mut var t: test.T = test.new("test_hashmap_missing_key")
    mut var m: hashmap.HashMap<string, string> = hashmap.new_hash_map()

    switch m.get(&"nonexistent") {
        case Some(_) { t.fail("expected None for missing key") }
        case None {}
    }
    t.finish()
}

// =============================================================================
// HashMap Tests (string -> int)
// =============================================================================

func test_hashmap_int_insert_get() -> (void) {
    mut var t: test.T = test.new("test_hashmap_int_insert_get")
    mut var m: hashmap.HashMap<string, int> = hashmap.new_hash_map()

    m.insert("apples", 5)
    m.insert("oranges", 10)

    t.eq(m.len(), 2)

    switch m.get(&"apples") {
        case Some(val) { t.eq(val, 5) }
        case None { t.fail("expected Some for 'apples'") }
    }
    t.finish()
}

func test_hashmap_int_increment() -> (void) {
    mut var t: test.T = test.new("test_hashmap_int_increment")
    mut var m: hashmap.HashMap<string, int> = hashmap.new_hash_map()

    m.insert("count", 0)

    // Simulate increment
    switch m.get(&"count") {
        case Some(val) {
            m.insert("count", val + 1)
        }
        case None {}
    }

    switch m.get(&"count") {
        case Some(val) { t.eq(val, 1) }
        case None { t.fail("expected Some") }
    }
    t.finish()
}
