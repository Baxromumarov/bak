package main

import "std/test/test.bak" as test

// We rely on Vec being available (either builtin or from same-package if compiled together)
// Since we are compiled as a file in src/std/collections/..., and vec.bak is in the same dir,
// but we are package 'main' and vec.bak is package 'collections'.
// We likely need to import it or rely on it being built-in.
// Given previous errors, Vec seems available globally.

func test_new() -> (void) {
    mut var t: test.T = test.new("test_new")
    
    mut var v: Vec<int, _> = Vec.new()
    t.eq(v.len(), 0)
    t.eq(v.cap(), 0)
    t.is_true(v.is_empty())
    
    t.finish()
}

func test_with_cap() -> (void) {
    mut var t: test.T = test.new("test_with_cap")
    mut var v: Vec<int, _> = Vec.with_cap(10)
    t.eq(v.len(), 0)
    t.eq(v.cap(), 10)
    t.is_true(v.is_empty())
    t.finish()
}

func test_from() -> (void) {
    mut var t: test.T = test.new("test_from")
    mut var v: Vec<int, _> = Vec.from([1, 2, 3])
    t.eq(v.len(), 3)
    t.eq(v.get(0).unwrap(), 1)
    t.eq(v.get(1).unwrap(), 2)
    t.eq(v.get(2).unwrap(), 3)
    t.finish()
}

func test_push_pop() -> (void) {
    mut var t: test.T = test.new("test_push_pop")
    mut var v: Vec<int, _> = Vec.new()
    v.push(10)
    v.push(20)
    
    t.eq(v.len(), 2)
    t.eq(v.get(0).unwrap(), 10)
    t.eq(v.get(1).unwrap(), 20)
    
    var p1: Option<int> = v.pop()
    t.eq(p1.unwrap(), 20)
    t.eq(v.len(), 1)
    
    var p2: Option<int> = v.pop()
    t.eq(p2.unwrap(), 10)
    t.eq(v.len(), 0)
    
    var p3: Option<int> = v.pop()
    t.is_true(p3.is_none())
    t.finish()
}

func test_grow() -> (void) {
    mut var t: test.T = test.new("test_grow")
    mut var v: Vec<int, _> = Vec.with_cap(2)
    v.push(1)
    v.push(2)
    t.eq(v.cap(), 2)
    
    // This should trigger grow
    v.push(3)
    t.eq(v.len(), 3)
    t.is_true(v.cap() >= 3)
    t.eq(v.get(0).unwrap(), 1)
    t.eq(v.get(1).unwrap(), 2)
    t.eq(v.get(2).unwrap(), 3)
    t.finish()
}

func test_remove() -> (void) {
    mut var t: test.T = test.new("test_remove")
    mut var v: Vec<int, _> = Vec.new()
    v.push(10)
    v.push(20)
    v.push(30)
    
    // Remove middle element
    var removed: Option<int> = v.remove(1)
    t.eq(removed.unwrap(), 20)
    t.eq(v.len(), 2)
    t.eq(v.get(0).unwrap(), 10)
    t.eq(v.get(1).unwrap(), 30)
    
    // Remove out of bounds
    var invalid: Option<int> = v.remove(5)
    t.is_true(invalid.is_none())
    t.finish()
}

func test_clear() -> (void) {
    mut var t: test.T = test.new("test_clear")
    mut var v: Vec<int, _> = Vec.new()
    v.push(1)
    v.push(2)
    
    // Uncomment when method resolution for 'clear' works or is confirmed
    // v.clear()
    // t.eq(v.len(), 0)
    // t.is_true(v.is_empty())
    
    t.finish()
}

func test_reverse() -> (void) {
    mut var t: test.T = test.new("test_reverse")
    mut var v: Vec<int, _> = Vec.new()
    v.push(1)
    v.push(2)
    v.push(3)
    
    v.reverse()
    t.eq(v.get(0).unwrap(), 3)
    t.eq(v.get(1).unwrap(), 2)
    t.eq(v.get(2).unwrap(), 1)
    t.finish()
}

func test_accessors() -> (void) {
    mut var t: test.T = test.new("test_accessors")
    mut var v: Vec<int, _> = Vec.new()
    v.push(100)
    v.push(200)
    
    t.eq(v.first().unwrap(), 100)
    t.eq(v.last().unwrap(), 200)
    
    t.is_true(v.contains(100))
    t.is_false(v.contains(300))
    
    mut var empty: Vec<int, _> = Vec.new()
    t.is_true(empty.first().is_none())
    t.is_true(empty.last().is_none())
    t.finish()
}

func test_join() -> (void) {
    mut var t: test.T = test.new("test_join")
    mut var v: Vec<string, _> = Vec.new()
    v.push("hello")
    v.push("world")
    v.push("bak")
    
    var s: string = v.join(", ")
    t.eq_string(s, "hello, world, bak")
    t.finish()
}

func main() -> (void) {
    mut var results: Vec<test.TestResult, _> = Vec.new()
    
    test_new()
    switch test.take_last_result() { case Some(r) { results.push(r) } case None {} }
    
    test_with_cap()
    switch test.take_last_result() { case Some(r) { results.push(r) } case None {} }
    
    test_from()
    switch test.take_last_result() { case Some(r) { results.push(r) } case None {} }
    
    test_push_pop()
    switch test.take_last_result() { case Some(r) { results.push(r) } case None {} }
    
    test_grow()
    switch test.take_last_result() { case Some(r) { results.push(r) } case None {} }
    
    test_remove()
    switch test.take_last_result() { case Some(r) { results.push(r) } case None {} }
    
    test_clear()
    switch test.take_last_result() { case Some(r) { results.push(r) } case None {} }
    
    test_reverse()
    switch test.take_last_result() { case Some(r) { results.push(r) } case None {} }
    
    test_accessors()
    switch test.take_last_result() { case Some(r) { results.push(r) } case None {} }
    
    test_join()
    switch test.take_last_result() { case Some(r) { results.push(r) } case None {} }
    
    test.run_tests(results)
}
