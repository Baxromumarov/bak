package collections

import hashmap "std/collections/hashmap"

// Set is a generic set backed by HashMap<T, bool>.
pub struct Set<T> {
    map: hashmap.HashMap<T, bool>
}

pub func new_set<T>() -> (Set<T>) {
    return Set{map: hashmap.newHashMap()}
}

impl Set as s {
    pub mut func add(value: T) -> (void) {
        s.map.insert(value, true)
    }

    pub mut func remove(value: T) -> (bool) {
        switch s.map.remove(&value) {
            case Ok(_) { return true }
            case Err(_) { return false }
        }
    }

    pub func contains(value: T) -> (bool) {
        return s.map.contains(&value)
    }

    pub func len() -> (int) {
        return s.map.len()
    }

    pub func values() -> (Vec<T, _>) {
        return s.map.keys()
    }

    pub func isEmpty() -> (bool) {
        return s.map.len() == 0
    }

    pub mut func clear() -> (void) {
        s.map.clear()
    }

    pub func union(other: &Set<T>) -> (Set<T>) {
        mut var out: Set<T> = new_set()
        for value in s.values() {
            out.add(value)
        }
        for value in other.values() {
            out.add(value)
        }
        return out
    }

    pub func intersection(other: &Set<T>) -> (Set<T>) {
        mut var out: Set<T> = new_set()
        for value in s.values() {
            if other.contains(value) {
                out.add(value)
            }
        }
        return out
    }

    pub func difference(other: &Set<T>) -> (Set<T>) {
        mut var out: Set<T> = new_set()
        for value in s.values() {
            if !other.contains(value) {
                out.add(value)
            }
        }
        return out
    }

    pub func isSubsetOf(other: &Set<T>) -> (bool) {
        for value in s.values() {
            if !other.contains(value) {
                return false
            }
        }
        return true
    }

    pub func intersects(other: &Set<T>) -> (bool) {
        for value in s.values() {
            if other.contains(value) {
                return true
            }
        }
        return false
    }

    pub func equals(other: &Set<T>) -> (bool) {
        if s.len() != other.len() {
            return false
        }
        return s.isSubsetOf(other)
    }

    pub func containsAll(values: &Vec<T, _>) -> (bool) {
        mut var i: int = 0
        while i < values.len() {
            if !s.contains(values[i]) {
                return false
            }
            i = i + 1
        }
        return true
    }
}

// StringSet is a simple set backed by Set<string>.
pub struct StringSet {
    inner: Set<string>
}

pub func newStringSet() -> (StringSet) {
    return StringSet{inner: new_set()}
}

impl StringSet as s {
    pub mut func add(value: string) -> (void) {
        s.inner.add(value)
    }

    pub mut func remove(value: string) -> (bool) {
        return s.inner.remove(value)
    }

    pub func contains(value: string) -> (bool) {
        return s.inner.contains(value)
    }

    pub func len() -> (int) {
        return s.inner.len()
    }

    pub func values() -> (Vec<string, _>) {
        return s.inner.values()
    }

    pub func isEmpty() -> (bool) {
        return s.inner.isEmpty()
    }

    pub mut func clear() -> (void) {
        s.inner.clear()
    }

    pub func union(other: &StringSet) -> (StringSet) {
        return StringSet{inner: s.inner.union(&other.inner)}
    }

    pub func intersection(other: &StringSet) -> (StringSet) {
        return StringSet{inner: s.inner.intersection(&other.inner)}
    }

    pub func difference(other: &StringSet) -> (StringSet) {
        return StringSet{inner: s.inner.difference(&other.inner)}
    }

    pub func isSubsetOf(other: &StringSet) -> (bool) {
        return s.inner.isSubsetOf(&other.inner)
    }

    pub func intersects(other: &StringSet) -> (bool) {
        return s.inner.intersects(&other.inner)
    }

    pub func equals(other: &StringSet) -> (bool) {
        return s.inner.equals(&other.inner)
    }

    pub func containsAll(values: &Vec<string, _>) -> (bool) {
        return s.inner.containsAll(values)
    }
}

