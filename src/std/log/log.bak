package log

import time "std/time"
import fs "std/fs"
import os "std/os"

pub const levelTrace: int = 5
pub const levelDebug: int = 10
pub const levelInfo: int = 20
pub const levelTest: int = 30
pub const levelWarn: int = 40
pub const levelError: int = 50
const COLOR_RESET: string = "\x1b[0m"
const COLOR_RED: string = "\x1b[31m"
const COLOR_GREEN: string = "\x1b[32m"
const COLOR_YELLOW: string = "\x1b[33m"
const COLOR_BLUE: string = "\x1b[34m"
const COLOR_MAGENTA: string = "\x1b[35m"
const COLOR_CYAN: string = "\x1b[36m"
const COLOR_GRAY: string = "\x1b[90m"

pub struct Logger {
    pub minLevel:   int
    pub useColor:   bool
    pub showTime:   bool
    pub prefix:     string
    pub filePath:   string
    pub appendFile: bool
}

// new creates a logger with INFO level and color on.
pub func new() -> (Logger) {
    return Logger{
        appendFile: true,
        filePath:   "",
        minLevel:   levelInfo,
        prefix:     "",
        showTime:   true,
        useColor:   true,
    }
}

// defaultLogger is the global logger used by package-level helpers.
mut var defaultLogger: Logger = new()

pub func setLevel(level: int) -> (void) {
    defaultLogger.minLevel = level
}

pub func enableColor() -> (void) {
    defaultLogger.useColor = true
}

pub func disableColor() -> (void) {
    defaultLogger.useColor = false
}

pub func setShowTime(enabled: bool) -> (void) {
    defaultLogger.showTime = enabled
}

pub func setPrefix(p: string) -> (void) {
    defaultLogger.prefix = p
}

pub func setFile(path: string) -> (void) {
    defaultLogger.filePath = path
}

pub func clearFile() -> (void) {
    defaultLogger.filePath = ""
}

pub func setAppend(enabled: bool) -> (void) {
    defaultLogger.appendFile = enabled
}

pub func traceLog(msg: string) -> (void) {
    defaultLogger.log(
        levelTrace,
        msg,
    )
}

pub func debug(msg: string) -> (void) {
    defaultLogger.log(
        levelDebug,
        msg,
    )
}

pub func info(msg: string) -> (void) {
    defaultLogger.log(
        levelInfo,
        msg,
    )
}

pub func test(msg: string) -> (void) {
    defaultLogger.log(
        levelTest,
        msg,
    )
}

pub func warn(msg: string) -> (void) {
    defaultLogger.log(
        levelWarn,
        msg,
    )
}

pub func error(msg: string) -> (void) {
    defaultLogger.log(
        levelError,
        msg,
    )
}

pub func fatal(msg: string) -> (void) {
    defaultLogger.log(
        levelError,
        msg,
    )
    os.exit(1)
}

pub func traceKv(msg: string, fields: Vec<Field, _>) -> (void) {
    defaultLogger.logKv(
        levelTrace,
        msg,
        fields,
    )
}

pub func debugKv(msg: string, fields: Vec<Field, _>) -> (void) {
    defaultLogger.logKv(
        levelDebug,
        msg,
        fields,
    )
}

pub func infoKv(msg: string, fields: Vec<Field, _>) -> (void) {
    defaultLogger.logKv(
        levelInfo,
        msg,
        fields,
    )
}

pub func testKv(msg: string, fields: Vec<Field, _>) -> (void) {
    defaultLogger.logKv(
        levelTest,
        msg,
        fields,
    )
}

pub func warnKv(msg: string, fields: Vec<Field, _>) -> (void) {
    defaultLogger.logKv(
        levelWarn,
        msg,
        fields,
    )
}

pub func errorKv(msg: string, fields: Vec<Field, _>) -> (void) {
    defaultLogger.logKv(
        levelError,
        msg,
        fields,
    )
}

pub func fatalKv(msg: string, fields: Vec<Field, _>) -> (void) {
    defaultLogger.logKv(
        levelError,
        msg,
        fields,
    )
    os.exit(1)
}

pub struct Field {
    pub key:   string
    pub value: string
}

pub func kv(key: string, value: string) -> (Field) {
    return Field{key: key, value: value}
}

pub func kvInt(key: string, value: int) -> (Field) {
    return Field{key: key, value: intToString(value)}
}

pub func kvBool(key: string, value: bool) -> (Field) {
    return Field{key: key, value: boolToString(value)}
}

pub func kvFloat(key: string, value: float64) -> (Field) {
    return Field{key: key, value: floatToString(value)}
}

pub func withPrefix(prefix: string, level: int) -> (Logger) {
    return Logger{
        appendFile: defaultLogger.appendFile,
        filePath:   defaultLogger.filePath,
        minLevel:   level,
        prefix:     prefix,
        showTime:   defaultLogger.showTime,
        useColor:   defaultLogger.useColor,
    }
}

pub func module(name: string, level: int) -> (Logger) {
    return withPrefix(
        "[" + name + "]",
        level,
    )
}

impl Logger as l {
    pub mut func log(level: int, msg: string) -> (void) {
        l.logKv(
            level,
            msg,
            Vec.new(),
        )
    }

    pub mut func logKv(
        level: int,
        msg: string,
        fields: Vec<Field, _>,
    ) -> (void) {
        if level < l.minLevel {
            return void
        }

        var levelName: string = levelToName(level)
        var prefix: string = l.prefix
        mut var timePart: string = ""

        if l.showTime {
            timePart = time.now().format(time.formatDateTime) + " "
        }

        mut var line: string = timePart

        if prefix.len() > 0 {
            line = line + prefix + " "
        }

        mut var fieldsPart: string = formatFields(&fields)

        if l.useColor {
            line = line + levelToColor(level) + "[" + levelName + "]" + COLOR_RESET + " " + msg + fieldsPart
        } else {
            line = line + "[" + levelName + "] " + msg + fieldsPart
        }

        if l.filePath.len() > 0 {
            if l.appendFile {
                var _ = fs.appendFile(
                    l.filePath,
                    line + "\n",
                )
            } else {
                var _ = fs.writeFile(
                    l.filePath,
                    line + "\n",
                )
            }
        } else {
            __builtin_println(line)
        }
    }

    pub mut func traceLog(msg: string) -> (void) {
        l.log(
            levelTrace,
            msg,
        )
    }

    pub mut func debug(msg: string) -> (void) {
        l.log(
            levelDebug,
            msg,
        )
    }

    pub mut func info(msg: string) -> (void) {
        l.log(
            levelInfo,
            msg,
        )
    }

    pub mut func warn(msg: string) -> (void) {
        l.log(
            levelWarn,
            msg,
        )
    }

    pub mut func error(msg: string) -> (void) {
        l.log(
            levelError,
            msg,
        )
    }

    pub mut func fatal(msg: string) -> (void) {
        l.log(
            levelError,
            msg,
        )
        os.exit(1)
    }

    pub mut func traceKv(msg: string, fields: Vec<Field, _>) -> (void) {
        l.logKv(
            levelTrace,
            msg,
            fields,
        )
    }

    pub mut func debugKv(msg: string, fields: Vec<Field, _>) -> (void) {
        l.logKv(
            levelDebug,
            msg,
            fields,
        )
    }

    pub mut func infoKv(msg: string, fields: Vec<Field, _>) -> (void) {
        l.logKv(
            levelInfo,
            msg,
            fields,
        )
    }

    pub mut func warnKv(msg: string, fields: Vec<Field, _>) -> (void) {
        l.logKv(
            levelWarn,
            msg,
            fields,
        )
    }

    pub mut func errorKv(msg: string, fields: Vec<Field, _>) -> (void) {
        l.logKv(
            levelError,
            msg,
            fields,
        )
    }

    pub mut func fatalKv(msg: string, fields: Vec<Field, _>) -> (void) {
        l.logKv(
            levelError,
            msg,
            fields,
        )
        os.exit(1)
    }
}

func levelToName(level: int) -> (string) {
    if level == levelTrace {
        return "TRACE"
    }

    if level == levelDebug {
        return "DEBUG"
    }

    if level == levelInfo {
        return "INFO"
    }

    if level == levelTest {
        return "TEST"
    }

    if level == levelWarn {
        return "WARN"
    }

    if level == levelError {
        return "ERROR"
    }

    return "LOG"
}

func levelToColor(level: int) -> (string) {
    if level == levelTrace {
        return COLOR_GRAY
    }

    if level == levelDebug {
        return COLOR_CYAN
    }

    if level == levelInfo {
        return COLOR_GREEN
    }

    if level == levelTest {
        return COLOR_MAGENTA
    }

    if level == levelWarn {
        return COLOR_YELLOW
    }

    if level == levelError {
        return COLOR_RED
    }

    return COLOR_BLUE
}

func formatFields(fields: &Vec<Field, _>) -> (string) {
    if fields.len() == 0 {
        return ""
    }

    mut var out: string = " {{"
    mut var i: int = 0

    while i < fields.len() {
        if i > 0 {
            out = out + ", "
        }

        out = out + fields[i].key + "=" + fields[i].value
        i = i + 1
    }

    return out + "}}"
}

// =============================================================================
// HELPER FUNCTIONS (Inlined from strconv to avoid cyclic imports)
// =============================================================================
const ch0: int = 48

func intToString(n: int) -> (string) {
    if n == 0 {
        return "0"
    }

    mut var negative: bool = false
    mut var num: int = n

    if num < 0 {
        negative = true
        num = -num
    }

    mut var digits: Vec<char, _> = Vec.new()

    while num > 0 {
        var digit: int = num % 10

        digits.push(char(ch0 + digit))
        num = num / 10
    }

    mut var result: string = ""

    if negative {
        result = "-"
    }

    mut var i: int = digits.len() - 1

    while i >= 0 {
        result = result + string(digits[i])
        i = i - 1
    }

    return result
}

func boolToString(b: bool) -> (string) {
    if b {
        return "true"
    }

    return "false"
}

func floatToString(f: float64) -> (string) {
    if f != f {
        return "NaN"
    }

    var prec: int = 6
    mut var negative: bool = false
    mut var value: float64 = f

    if value < 0.0 {
        negative = true
        value = -value
    }

    var intPart: int = int(value)
    mut var frac: float64 = value - float64(intPart)
    mut var result: string = ""

    if negative {
        result = "-"
    }

    result = result + intToString(intPart)
    result = result + "."

    mut var i: int = 0

    while i < prec {
        frac = frac * 10.0

        var digit: int = int(frac)

        result = result + string(char(ch0 + digit))
        frac = frac - float64(digit)
        i = i + 1
    }

    return result
}
