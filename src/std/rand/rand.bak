package rand

// =============================================================================
// Random Number Generation for Bak
// =============================================================================
// Implements xoshiro256** PRNG - fast, high-quality pseudorandom generator.
// Seeded automatically from system clock on first use.
// Internal state (xoshiro256** uses 4 x 64-bit words)
mut var s0: int = 0
mut var s1: int = 0
mut var s2: int = 0
mut var s3: int = 0
mut var seeded: bool = false

// -----------------------------------------------------------------------------
// Seeding
// -----------------------------------------------------------------------------
// seed initializes the PRNG with the given value.
// Uses SplitMix64 to expand a single seed into the 4-word state.
pub func seed(val: int) -> (void) {
    // SplitMix64 to fill state from a single seed
    mut var z: int = val

    // SplitMix64 constants (decimal equivalents of hex):
    // 0x9e3779b97f4a7c15 = -7046029254386353131 (signed)
    // 0xbf58476d1ce4e5b9 = -4658895280553007687 (signed)
    // 0x94d049bb133111eb = -7723592293110705685 (signed)
    z = z + -7046029254386353131
    z = (z ^ z >> 30) * -4658895280553007687
    z = (z ^ z >> 27) * -7723592293110705685
    s0 = z ^ z >> 31
    z = s0 + -7046029254386353131
    z = (z ^ z >> 30) * -4658895280553007687
    z = (z ^ z >> 27) * -7723592293110705685
    s1 = z ^ z >> 31
    z = s1 + -7046029254386353131
    z = (z ^ z >> 30) * -4658895280553007687
    z = (z ^ z >> 27) * -7723592293110705685
    s2 = z ^ z >> 31
    z = s2 + -7046029254386353131
    z = (z ^ z >> 30) * -4658895280553007687
    z = (z ^ z >> 27) * -7723592293110705685
    s3 = z ^ z >> 31
    seeded = true

    return void
}

// auto_seed seeds from the system monotonic clock if not yet seeded.
func auto_seed() -> (void) {
    if !seeded {
        seed(__builtin_monotonic_now())
    }

    return void
}

// rotl performs left rotation on a 64-bit integer.
func rotl(x: int, k: int) -> (int) {
    return x << k | x >> 64 - k
}

// next_raw generates the next raw 64-bit pseudorandom value (xoshiro256**).
func next_raw() -> (int) {
    auto_seed()

    var result: int = rotl(
        s1 * 5,
        7,
    ) * 9
    var t: int = s1 << 17

    s2 = s2 ^ s0
    s3 = s3 ^ s1
    s1 = s1 ^ s2
    s0 = s0 ^ s3
    s2 = s2 ^ t
    s3 = rotl(
        s3,
        45,
    )

    return result
}

// -----------------------------------------------------------------------------
// Integer Generation
// -----------------------------------------------------------------------------
// intN returns a random integer in [0, n).
// Panics if n <= 0.
pub func intN(n: int) -> (int) {
    if n <= 0 {
        panic "rand.intN: n must be positive"
    }

    // Use rejection sampling to avoid modulo bias
    mut var r: int = next_raw()

    // Make positive
    if r < 0 {
        r = -r
    }

    if r < 0 {
        // Handle int min (still negative after negation)
        r = 0
    }

    return r % n
}

// intRange returns a random integer in [min, max].
pub func intRange(min: int, max: int) -> (int) {
    if min > max {
        panic "rand.intRange: min must be <= max"
    }

    if min == max {
        return min
    }

    return min + intN(max - min + 1)
}

// nextInt returns a random non-negative integer.
pub func nextInt() -> (int) {
    mut var r: int = next_raw()

    if r < 0 {
        r = -r
    }

    if r < 0 {
        r = 0
    }

    return r
}

// -----------------------------------------------------------------------------
// Boolean Generation
// -----------------------------------------------------------------------------
// coin returns a random boolean value (like a coin flip).
pub func coin() -> (bool) {
    return next_raw() & 1 == 1
}

// -----------------------------------------------------------------------------
// Shuffling and Selection
// -----------------------------------------------------------------------------
// shuffle randomly reorders a Vec<int, _> in place using Fisher-Yates.
pub func shuffleInts(arr: &mut Vec<int, _>) -> (void) {
    mut var i: int = arr.len() - 1

    while i > 0 {
        var j: int = intN(i + 1)
        // Swap arr[i] and arr[j]
        var tmp: int = arr[i]

        arr[i] = arr[j]
        arr[j] = tmp
        i = i - 1
    }

    return void
}

// shuffle randomly reorders a Vec<string, _> in place using Fisher-Yates.
pub func shuffleStrings(arr: &mut Vec<string, _>) -> (void) {
    mut var i: int = arr.len() - 1

    while i > 0 {
        var j: int = intN(i + 1)
        var tmp: string = arr[i]

        arr[i] = arr[j]
        arr[j] = tmp
        i = i - 1
    }

    return void
}

// -----------------------------------------------------------------------------
// Float Generation
// -----------------------------------------------------------------------------
// nextFloat returns a random float64 in [0.0, 1.0).
pub func nextFloat() -> (float64) {
    mut var r: int = next_raw()

    // To get 53 bits of precision, right shift by 11.
    if r < 0 {
        r = -r
    }

    if r < 0 {
        r = 0
    }

    var res: int = r >> 11

    return float64(res) / 9007199254740992.0
}

// 2^53
// =============================================================================
// Additional Random Utilities
// =============================================================================
// choice returns a random element from a Vec, or Err if empty.
pub func choice<T>(arr: &Vec<T, _>) -> (Result<T, string>) {
    if arr.len() == 0 {
        return Err("empty array")
    }

    return Ok(arr[intN(arr.len())])
}

// sample returns a Vec of n random elements from arr (sampling without replacement).
// If n > arr.len(), returns all elements in random order.
pub func sample<T>(arr: &Vec<T, _>, n: int) -> (Vec<T, _>) {
    mut var result: Vec<T, _> = Vec.new()

    if arr.len() == 0 || n <= 0 {
        return result
    }

    mut var count: int = n

    if count > arr.len() {
        count = arr.len()
    }

    // Fisher-Yates shuffle a copy and take first n
    mut var copy: Vec<T, _> = Vec.withCap(arr.len())
    mut var i: int = 0

    while i < arr.len() {
        copy.push(arr[i])
        i = i + 1
    }

    mut var j: int = copy.len() - 1

    while j > 0 {
        var k: int = intN(j + 1)
        var tmp: T = copy[j]

        copy[j] = copy[k]
        copy[k] = tmp
        j = j - 1
    }

    i = 0

    while i < count {
        result.push(copy[i])
        i = i + 1
    }

    return result
}

// randomString returns a random string of length n using the given charset.
pub func randomString(n: int, charset: &string) -> (string) {
    if n <= 0 || charset.len() == 0 {
        return ""
    }

    mut var result: string = ""
    mut var i: int = 0

    while i < n {
        var idx: int = intN(charset.len())

        result = result + string(charset[idx])
        i = i + 1
    }

    return result
}

// hex returns a random hex string of length n (n bytes -> 2*n hex chars).
pub func hex(n: int) -> (string) {
    var hexChars: string = "0123456789abcdef"

    return randomString(
        n * 2,
        &hexChars,
    )
}

// alphanumeric returns a random alphanumeric string of length n.
pub func alphanumeric(n: int) -> (string) {
    var chars: string = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"

    return randomString(
        n,
        &chars,
    )
}
