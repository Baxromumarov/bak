package filepath

// File path helpers (currently identical to path).

import "src/std/path/path.bak" as path

pub const Separator: string = path.Separator

pub struct Split {
    pub Dir: string
    pub Base: string
}

pub func is_abs(p: string) -> (bool) {
    return path.is_abs(p)
}

pub func clean(p: string) -> (string) {
    return path.clean(p)
}

pub func join(a: string, b: string) -> (string) {
    return path.join(a, b)
}

pub func join_parts(parts: Vec<string, _>) -> (string) {
    return path.join_parts(parts)
}

pub func base(p: string) -> (string) {
    return path.base(&p)
}

pub func dir(p: string) -> (string) {
    return path.dir(&p)
}

pub func ext(p: string) -> (string) {
    return path.ext(&p)
}

pub func split(p: string) -> (Split) {
    var s: path.Split = path.split(&p)
    return Split{Dir: s.Dir, Base: s.Base}
}
