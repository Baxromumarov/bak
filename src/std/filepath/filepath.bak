package filepath

// File path helpers (currently identical to path).
import path "std/path"

pub const Separator: string = path.Separator

pub struct Split {
    pub Dir:  string
    pub Base: string
}

pub func isAbs(p: string) -> (bool) {
    return path.isAbs(p)
}

pub func isRel(p: string) -> (bool) {
    return path.isRel(p)
}

pub func clean(p: string) -> (string) {
    return path.clean(p)
}

pub func join(a: string, b: string) -> (string) {
    return path.join(
        a,
        b,
    )
}

pub func joinParts(parts: Vec<string, _>) -> (string) {
    return path.joinParts(parts)
}

pub func base(p: string) -> (string) {
    return path.base(&p)
}

pub func dir(p: string) -> (string) {
    return path.dir(&p)
}

pub func ext(p: string) -> (string) {
    return path.ext(&p)
}

pub func hasExt(p: string) -> (bool) {
    return path.hasExt(&p)
}

pub func stem(p: string) -> (string) {
    return path.stem(&p)
}

pub func withoutExt(p: string) -> (string) {
    return path.withoutExt(&p)
}

pub func withExt(p: string, new_ext: string) -> (string) {
    return path.withExt(
        &p,
        &new_ext,
    )
}

pub func split(p: string) -> (Split) {
    var s: path.Split = path.split(&p)

    return Split{Base: s.Base, Dir: s.Dir}
}
