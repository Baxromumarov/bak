package json

import "src/std/test/test.bak" as test
import "src/std/encoding/json/json.bak" as j

struct AppMeta {
    name: string
    version: int
    ok: bool
}

func app_meta_fields(m: AppMeta) -> (Vec<j.JsonEntry, _>) {
    return Vec.from(
        [
            j.entry_string("name", m.name),
            j.entry_int("version", m.version),
            j.entry_bool("ok", m.ok),
        ],
    )
}

func test_object_getters() -> (void) {
    mut var t: test.T = test.new("test_object_getters")
    var entries: Vec<j.JsonEntry, _> = Vec.from([j.entry("name", j.Json.String("bak")), j.entry("age", j.Json.Int(3)), j.entry("ok", j.Json.Boolean(true))])
    var obj: j.Json = j.object(entries)
    switch j.get_string(&obj, "name") {
        case Ok(v) {
            t.eq_string(v, "bak")
        }
        case Err(_) {
            t.fail("missing name")
        }
    }
    switch j.get_number(&obj, "age") {
        case Ok(v) {
            t.eq_float(v, 3.0)
        }
        case Err(_) {
            t.fail("missing age")
        }
    }
    switch j.get_bool(&obj, "ok") {
        case Ok(v) {
            t.eq(v, true)
        }
        case Err(_) {
            t.fail("missing ok")
        }
    }
    switch j.get(&obj, "missing") {
        case Ok(_) {
            t.fail("expected missing key to be Err")
        }
        case Err(_) {
        }
    }
    var pretty: string = j.pretty(obj)
    t.contains(pretty, "
")
    t.finish()
}

func test_object_helpers() -> (void) {
    mut var t: test.T = test.new("test_object_helpers")

    var meta: AppMeta = AppMeta{
        name: "bak",
        ok: true,
        version: 2,
    }

    var obj: j.Json = j.encode_obj(meta, app_meta_fields)
    var compact: string = j.marshal_obj(meta, app_meta_fields)

    switch j.get_string(&obj, "name") {
        case Ok(name) {
            t.eq_string(name, "bak")
        }
        case Err(err) {
            t.fail("name missing: " + err)
        }
    }

    t.contains(compact, "\"name\":\"bak\"")
    t.contains(compact, "\"version\":2")
    t.contains(compact, "\"ok\":true")
    t.finish()
}
