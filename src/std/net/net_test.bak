package net

import net "std/net"
import test "std/test"

func test_bind_and_close_listener() -> (void) {
    mut var t: test.T = test.new("test_bind_and_close_listener")
    var res: Result<net.TcpListener, string> = net.bind(
        "127.0.0.1",
        0,
    )

    if res.isOk() {
        mut var listener: net.TcpListener = res.unwrap()
        var close_res: Result<void, string> = net.closeListener(&mut listener)

        if close_res.isErr() {
            t.fail("closeListener failed: " + close_res.unwrapErr())
        }

        var close_again: Result<void, string> = net.closeListener(&mut listener)

        if close_again.isErr() {
            t.fail("repeated closeListener failed: " + close_again.unwrapErr())
        }

        var accept_res: Result<net.TcpStream, string> = net.accept(&mut listener)

        if accept_res.isOk() {
            t.fail("accept after close should fail")
        } else if !accept_res.unwrapErr().contains("resource closed") {
            t.fail("accept after close: " + accept_res.unwrapErr())
        }
    } else {
        var err: string = res.unwrapErr()

        if !err.contains("--allow-net") {
            t.fail("bind failed: " + err)
        }
    }

    t.finish()
}
