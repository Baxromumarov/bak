package net

pub struct TcpStream {
    fd: int
    // In the future: remoteAddr string, etc.
}

pub struct TcpListener {
    fd: int

}

pub func connect(host: string, port: int) -> (Result<TcpStream, string>) {
    var res = __builtin_socket_connect(host, port)
    switch res {
        case Ok(fd) {
            return Ok(TcpStream{fd: fd})
        }
        case Err(e) {
            return Err(e)
        }
    }
}


pub func connect_tls(host: string, port: int) -> (Result<TcpStream, string>) {
    var res = __builtin_socket_connect_tls(host, port)
    switch res {
        case Ok(fd) {
            return Ok(TcpStream{fd: fd})
        }
        case Err(e) {
            return Err(e)
        }
    }
}

pub func set_timeout(s: &mut TcpStream, ms: int) -> (Result<void, string>) {
    return __builtin_socket_set_timeout((*s).fd, ms)
}

pub func read(s: &mut TcpStream, count: int) -> (Result<Vec<int, _>, string>) {
    return __builtin_socket_read((*s).fd, count)
}

pub func write(s: &mut TcpStream, data: Vec<int, _>) -> (Result<void, string>) {
    return __builtin_socket_write((*s).fd, data)
}

pub func close(s: &mut TcpStream) -> (Result<void, string>) {
    return __builtin_socket_close((*s).fd)
}

pub func close_listener(l: &mut TcpListener) -> (Result<void, string>) {
    return __builtin_socket_close((*l).fd)
}

pub func bind(host: string, port: int) -> (Result<TcpListener, string>) {
    var res = __builtin_socket_bind(host, port)
    switch res {
        case Ok(fd) {
            return Ok(TcpListener{fd: fd})
        }
        case Err(e) {
            return Err(e)
        }
    }
}

pub func accept(l: &mut TcpListener) -> (Result<TcpStream, string>) {
    var res = __builtin_socket_accept((*l).fd)
    switch res {
        case Ok(fd) {
            return Ok(TcpStream{fd: fd})
        }
        case Err(e) {
            return Err(e)
        }
    }
}
