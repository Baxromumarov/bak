package csv

import strings "std/strings"

// =============================================================================
// CSV Parser and Writer
// =============================================================================
// Simple RFC 4180-style CSV support.
pub struct Record {
    fields: Vec<string, _>
}

// parse parses a CSV string into a Vec of Records.
pub func parse(data: &string) -> (Vec<Record, _>) {
    mut var result: Vec<Record, _> = Vec.new()

    if data.len() == 0 {
        return result
    }

    mut var fields: Vec<string, _> = Vec.new()
    mut var current: string = ""
    mut var inQuotes: bool = false
    mut var i: int = 0

    while i < data.len() {
        var ch: char = data[i]

        if ch == '"' {
            if inQuotes && i + 1 < data.len() && data[i + 1] == '"' {
                current = current + "\""
                i = i + 1
            } else {
                inQuotes = !inQuotes
            }
        } else if ch == ',' && !inQuotes {
            fields.push(current)
            current = ""
        } else if (ch == '\n' || ch == '\r') && !inQuotes {
            fields.push(current)
            result.push(Record{fields: fields})
            fields = Vec.new()
            current = ""

            if ch == '\r' && i + 1 < data.len() && data[i + 1] == '\n' {
                i = i + 1
            }
        } else {
            current = current + string(ch)
        }

        i = i + 1
    }

    // A terminal line ending terminates the final record. Otherwise flush the
    // remaining field, including an empty field after a trailing comma.
    var last: char = data[data.len() - 1]

    if last != '\n' && last != '\r' {
        fields.push(current)
        result.push(Record{fields: fields})
    }

    return result
}

// parseLine parses a single CSV line into a Record.
pub func parseLine(line: &string) -> (Record) {
    mut var fields: Vec<string, _> = Vec.new()
    mut var current: string = ""
    mut var inQuotes: bool = false
    mut var i: int = 0

    while i < line.len() {
        var ch: char = line[i]

        if ch == '"' {
            if inQuotes && i + 1 < line.len() && line[i + 1] == '"' {
                current = current + "\""
                i = i + 1
            } else {
                inQuotes = !inQuotes
            }
        } else if ch == ',' && !inQuotes {
            fields.push(current)
            current = ""
        } else {
            current = current + string(ch)
        }

        i = i + 1
    }

    fields.push(current)

    return Record{fields: fields}
}

// write writes records to a CSV string.
pub func write(records: &Vec<Record, _>) -> (string) {
    mut var result: string = ""
    mut var i: int = 0

    while i < records.len() {
        result = result + writeRecord(&records[i])

        if i < records.len() - 1 {
            result = result + "\n"
        }

        i = i + 1
    }

    return result
}

// writeRecord converts a single Record to a CSV line.
pub func writeRecord(rec: &Record) -> (string) {
    mut var result: string = ""
    mut var i: int = 0

    while i < rec.fields.len() {
        var field: string = rec.fields[i]
        // Escape field if it contains comma, quote, or newline
        mut var needsEscape: bool = false
        mut var j: int = 0

        while j < field.len() {
            var ch: char = field[j]

            if ch == ',' || ch == '"' || ch == '\n' || ch == '\r' {
                needsEscape = true
                j = field.len()
            }

            j = j + 1
        }

        if needsEscape {
            var oldQuote: string = "\""
            var newQuote: string = "\"\""

            result = result + "\"" + strings.replace(
                &field,
                &oldQuote,
                &newQuote,
            ) + "\""
        } else {
            result = result + field
        }

        if i < rec.fields.len() - 1 {
            result = result + ","
        }

        i = i + 1
    }

    return result
}

// record creates a Record from a Vec of strings.
pub func record(fields: Vec<string, _>) -> (Record) {
    return Record{fields: fields}
}

// fieldCount returns the number of fields in a record.
pub func fieldCount(rec: &Record) -> (int) {
    return rec.fields.len()
}

// get returns the field at index, or Err if out of bounds.
pub func get(rec: &Record, index: int) -> (Result<string, string>) {
    if index < 0 || index >= rec.fields.len() {
        return Err("index out of bounds")
    }

    return Ok(rec.fields[index])
}
