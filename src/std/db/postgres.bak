package postgres

import db "std/db/db"

pub alias Connection = db.Connection
pub alias QueryResult = db.QueryResult
pub alias Row = db.Row

pub func connectionFromHandle(handle: int) -> (Connection) {
    return db.Connection{handle: handle}
}

pub func emptyQueryResult() -> (QueryResult) {
    return db.QueryResult{columns: Vec.new(), rows: Vec.new()}
}

// Native PostgreSQL driver using built-in database connection.
// Connection string format: "host=localhost port=5432 user=postgres password=secret dbname=test sslmode=disable"
// connect opens a PostgreSQL connection and returns a Connection handle.
pub func connect(connStr: string) -> (Result<Connection, string>) {
    var result = __builtin_pg_connect(connStr)

    if result.isOk() {
        return Ok(db.Connection{handle: result.unwrap()})
    }

    return Err(result.unwrapErr())
}

// query executes a SQL query and returns a QueryResult.
pub func query(
    conn: &Connection,
    sql: string,
) -> (Result<QueryResult, string>) {
    if conn.handle < 0 {
        return Err("resource closed")
    }

    return __builtin_pg_query(
        conn.handle,
        sql,
    )
}

// queryParams executes a SQL query with parameters and returns a QueryResult.
// Parameters are passed as a Vec<string, _> to prevent SQL injection.
pub func queryParams(
    conn: &Connection,
    sql: string,
    params: Vec<string, _>,
) -> (Result<QueryResult, string>) {
    if conn.handle < 0 {
        return Err("resource closed")
    }

    return __builtin_pg_query(
        conn.handle,
        sql,
        params,
    )
}

// close closes the database connection.
// A second close is a no-op. Later queries return Err("resource closed").
pub func close(conn: &mut Connection) -> (Result<void, string>) {
    if conn.handle < 0 {
        return Ok(void)
    }

    var handle: int = conn.handle
    conn.handle = -1

    return __builtin_pg_close(handle)
}

pub func rows(qr: &QueryResult) -> (Vec<Row, _>) {
    return db.rows(qr)
}

pub func rowGet(row: &Row, name: string) -> (Result<string, string>) {
    return row.get(name)
}

pub func rowGetIndex(row: &Row, idx: int) -> (Result<string, string>) {
    return row.getIndex(idx)
}

pub func queryResult(
    columns: Vec<string, _>,
    rows: Vec<Vec<string, _>, _>,
) -> (QueryResult) {
    return db.QueryResult{columns: columns, rows: rows}
}
