package mysql

import db "std/db/db"

// Native MySQL driver using built-in database connection.
// Connection string format: "user:password@tcp(host:port)/database"
// connect opens a MySQL connection and returns a Connection handle.
pub func connect(connStr: string) -> (Result<db.Connection, string>) {
    var result = __builtin_mysql_connect(connStr)

    if result.isOk() {
        return Ok(db.Connection{handle: result.unwrap()})
    }

    return Err(result.unwrapErr())
}

// query executes a SQL query and returns a QueryResult.
pub func query(
    conn: &db.Connection,
    sql: string,
) -> (Result<db.QueryResult, string>) {
    if conn.handle < 0 {
        return Err("resource closed")
    }

    return __builtin_mysql_query(
        conn.handle,
        sql,
    )
}

// queryParams executes a SQL query with parameters and returns a QueryResult.
// Parameters are passed as a Vec<string, _> to support placeholder binding.
pub func queryParams(
    conn: &db.Connection,
    sql: string,
    params: Vec<string, _>,
) -> (Result<db.QueryResult, string>) {
    if conn.handle < 0 {
        return Err("resource closed")
    }

    return __builtin_mysql_query(
        conn.handle,
        sql,
        params,
    )
}

// close closes the database connection.
// A second close is a no-op. Later queries return Err("resource closed").
pub func close(conn: &mut db.Connection) -> (Result<void, string>) {
    if conn.handle < 0 {
        return Ok(void)
    }

    var handle: int = conn.handle
    conn.handle = -1

    return __builtin_mysql_close(handle)
}
