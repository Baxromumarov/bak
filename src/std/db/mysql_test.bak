package test

import db "std/db/db"
import mysql "std/db/mysql"
import "std/test"

pub func test_mysql_close_is_idempotent() -> (void) {
    mut var t: test.T = test.new("test_mysql_close_is_idempotent")
    mut var conn: db.Connection = db.Connection{handle: -1}
    var first: Result<void, string> = mysql.close(&mut conn)

    if first.isErr() {
        t.fail("close of a closed handle: " + first.unwrapErr())
    }

    var again: Result<void, string> = mysql.close(&mut conn)

    if again.isErr() {
        t.fail("repeated close: " + again.unwrapErr())
    }

    var queryResult: Result<db.QueryResult, string> = mysql.query(
        &conn,
        "select 1",
    )

    if queryResult.isOk() {
        t.fail("query after close should fail")
    } else if !queryResult.unwrapErr().contains("resource closed") {
        t.fail("query after close: " + queryResult.unwrapErr())
    }

    t.finish()
}
