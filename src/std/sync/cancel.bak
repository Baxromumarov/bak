package sync

import thread "std/thread"
import time "std/time"

pub struct CancelToken {
    handle: int
}

pub func newCancelToken() -> (CancelToken) {
    return CancelToken{handle: __builtin_cancel_new()}
}

impl CancelToken as t {
    pub func cancel() -> (void) {
        __builtin_cancel(t.handle)
    }

    pub func isCancelled() -> (bool) {
        return __builtin_is_cancelled(t.handle)
    }
}

struct CancelAfterArgs {
    token: CancelToken
    d:     time.Duration
}

func cancel_after_worker(args: CancelAfterArgs) -> (void) {
    thread.sleep(args.d)
    args.token.cancel()

    return void
}

pub func cancelAfter(d: time.Duration) -> (CancelToken) {
    var token: CancelToken = newCancelToken()
    var args: CancelAfterArgs = CancelAfterArgs{d: d, token: token}

    thread.spawn(
        cancel_after_worker,
        args,
    )

    return token
}
