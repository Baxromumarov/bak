package sync

pub struct Mutex {
    handle: int
}

pub func NewMutex() -> (Mutex) {
    return Mutex{
        handle: __builtin_mutex_new()
    }
}

// Preferred snake_case API.
pub func new_mutex() -> (Mutex) {
    return NewMutex()
}

impl Mutex as m {
    pub func lock() -> (void) {
        __builtin_mutex_lock(m.handle)
    }

    pub func unlock() -> (void) {
        __builtin_mutex_unlock(m.handle)
    }
}
