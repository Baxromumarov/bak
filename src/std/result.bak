package std

impl Result as self {
    pub func isOk() -> (bool) {
        switch self {
            case Ok(_) {
                return true
            }
            case Err(_) {
                return false
            }
        }
    }

    pub func isErr() -> (bool) {
        switch self {
            case Ok(_) {
                return false
            }
            case Err(_) {
                return true
            }
        }
    }

    pub func unwrap() -> (T) {
        switch self {
            case Ok(v) {
                return v
            }
            case Err(e) {
                panic "unwrap called on Err: " + string(e)
            }
        }
    }

    pub func unwrapErr() -> (E) {
        switch self {
            case Ok(_) {
                panic "unwrapErr called on Ok result"
            }
            case Err(e) {
                return e
            }
        }
    }

    pub func toString() -> (string) {
        switch self {
            case Ok(v) {
                return "Ok(" + string(v) + ")"
            }
            case Err(e) {
                return "Err(" + string(e) + ")"
            }
        }
    }
}
