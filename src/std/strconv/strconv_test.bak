package strconv

import "src/std/strconv/strconv.bak" as s
import "src/std/test/test.bak" as test

func test_parse_int() -> (void) {
    mut var t: test.T = test.new("test_parse_int")

    var a: string = "123"
    var res_a: Result<int, string> = s.parseInt(&a, 10)
    if res_a.is_ok() {
        t.eq(res_a.unwrap(), 123)
    } else {
        t.fail("parseInt failed: " + res_a.unwrap_err())
    }

    var b: string = "-42"
    var res_b: Result<int, string> = s.parseInt(&b, 10)
    if res_b.is_ok() {
        t.eq(res_b.unwrap(), -42)
    } else {
        t.fail("parseInt failed: " + res_b.unwrap_err())
    }

    var c: string = "ff"
    var res_c: Result<int, string> = s.parseInt(&c, 16)
    if res_c.is_ok() {
        t.eq(res_c.unwrap(), 255)
    } else {
        t.fail("parseInt failed: " + res_c.unwrap_err())
    }

    var d: string = "1011"
    var res_d: Result<int, string> = s.parseInt(&d, 2)
    if res_d.is_ok() {
        t.eq(res_d.unwrap(), 11)
    } else {
        t.fail("parseInt failed: " + res_d.unwrap_err())
    }

    var bad: string = "12z"
    var res_bad: Result<int, string> = s.parseInt(&bad, 10)
    t.is_true(res_bad.is_err())

    t.finish()
}

func test_format_int() -> (void) {
    mut var t: test.T = test.new("test_format_int")

    t.eq_string(s.formatInt(10, 2), "1010")
    t.eq_string(s.formatOctal(9), "11")
    t.eq_string(s.formatHex(255), "ff")
    t.eq_string(s.formatInt(-15, 10), "-15")

    t.finish()
}

func test_format_float() -> (void) {
    mut var t: test.T = test.new("test_format_float")

    t.eq_string(s.formatFloat(1.2345, 2), "1.23")
    t.eq_string(s.formatFloat(-0.5, 3), "-0.500")
    t.eq_string(s.formatFloat(42.0, 0), "42")
    t.eq_string(s.formatFloat(0.0, 2), "0.00")

    t.finish()
}

func test_atof() -> (void) {
    mut var t: test.T = test.new("test_atof")

    var a: string = "123.25"
    var res_a: Result<float64, string> = s.atof(&a)
    if res_a.is_ok() {
        t.eq_float(res_a.unwrap(), 123.25)
    } else {
        t.fail("atof failed: " + res_a.unwrap_err())
    }

    var b: string = "-0.5"
    var res_b: Result<float64, string> = s.atof(&b)
    if res_b.is_ok() {
        t.eq_float(res_b.unwrap(), -0.5)
    } else {
        t.fail("atof failed: " + res_b.unwrap_err())
    }

    var c: string = ".75"
    var res_c: Result<float64, string> = s.atof(&c)
    if res_c.is_ok() {
        t.eq_float(res_c.unwrap(), 0.75)
    } else {
        t.fail("atof failed: " + res_c.unwrap_err())
    }

    var d: string = "1."
    var res_d: Result<float64, string> = s.atof(&d)
    if res_d.is_ok() {
        t.eq_float(res_d.unwrap(), 1.0)
    } else {
        t.fail("atof failed: " + res_d.unwrap_err())
    }

    var bad: string = "1a"
    var res_bad: Result<float64, string> = s.atof(&bad)
    t.is_true(res_bad.is_err())

    t.finish()
}
