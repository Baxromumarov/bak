            value,
        )
    }
}

func expr_to_sql(expr: &Expr, start: int) -> (ExprSql) {
    if expr.conditions.len() == 0 {
        return ExprSql{params: Vec.new(), sql: ""}
    }

    mut var sql: string = ""
    mut var params: Vec<string, _> = Vec.new()
    mut var i: int = 0

    while i < expr.conditions.len() {
        var cond: Condition = expr.conditions[i]

        if i > 0 {
            sql = sql + " " + expr.joins[i - 1] + " "
        }

        sql = sql + cond.column + " " + cond.op + " $" + strconv.intToString(start + i + 1)
        params.push(cond.value)
        i = i + 1
    }

    return ExprSql{params: params, sql: sql}
}

func join_columns(columns: &Vec<ColumnSpec, _>) -> (string) {
    if columns.len() == 0 {
        return "*"
    }

    mut var out: string = ""
    mut var i: int = 0

    while i < columns.len() {
        if i > 0 {
            out = out + ", "
        }

        out = out + (columns[i]).name
        i = i + 1
    }

    return out
}

func build_assignment_clause(columns: &Vec<string, _>, start: int) -> (string) {
    mut var parts: Vec<string, _> = Vec.new()
    mut var i: int = 0

    while i < columns.len() {
        parts.push(columns[i] + " = $" + strconv.intToString(start + i + 1))
        i = i + 1
    }

    return join_comma_separated(&parts)
}

func build_placeholders(count: int, start: int) -> (string) {
    mut var parts: Vec<string, _> = Vec.new()
    mut var i: int = 0

    while i < count {
        parts.push("$" + strconv.intToString(start + i + 1))
        i = i + 1
    }

    return join_comma_separated(&parts)
}

func join_comma_separated(parts: &Vec<string, _>) -> (string) {
    mut var out: string = ""
    mut var i: int = 0

    while i < parts.len() {
        if i > 0 {
            out = out + ", "
        }

        out = out + parts[i]
        i = i + 1
    }

    return out
}

func empty_string_vec() -> (Vec<string, _>) {
    mut var out: Vec<string, _> = Vec.new()

    return out
}

pub struct SelectRaw {
    table:      string
    columns:    Vec<ColumnSpec, _>
    where_expr: Expr
    has_where:  bool
}

pub func select_raw(columns: Vec<ColumnSpec, _>) -> (SelectRaw) {
    return SelectRaw{
        columns:    columns,
        has_where:  false,
        table:      "",
        where_expr: empty_expr(),
    }
}

pub func select_all() -> (SelectRaw) {
    return select_raw(Vec.new())
}

impl SelectRaw as s {
    pub func from(table: string) -> (SelectRaw) {
        mut var out: SelectRaw = s

        out.table = table

        return out
    }

    pub func where(expr: Expr) -> (SelectRaw) {
        mut var out: SelectRaw = s

        out.where_expr = expr
        out.has_where = true

        return out
    }

    pub func load(
        conn: &postgres.Connection,
    ) -> (Result<postgres.QueryResult, string>) {
        return load_query(
            conn,
            &s.columns,
            s.table,
            s.where_expr,
            s.has_where,
        )
    }

    pub func rows(
        conn: &postgres.Connection,
    ) -> (Result<Vec<postgres.Row, _>, string>) {
        switch s.load(conn) {
            case Ok(qr) {
                return Ok(postgres.rows(&qr))
            }
            case Err(err) {
                return Err(err)
            }
        }
    }

    pub func load_map(
        conn: &postgres.Connection,
        decode: func(&postgres.Row) -> (Result<any, string>),
    ) -> (Result<Vec<any, _>, string>) {
        switch s.rows(conn) {
            case Ok(rows) {
                mut var out: Vec<any, _> = Vec.new()

                for row in rows {
                    switch decode(&row) {
                        case Ok(v) {
                            out.push(v)
                        }
                        case Err(err) {
                            return Err(err)
                        }
                    }
                }

                return Ok(out)
            }
            case Err(err) {
                return Err(err)
            }
        }
    }

    pub func one_map(
        conn: &postgres.Connection,
        decode: func(&postgres.Row) -> (Result<any, string>),
    ) -> (Result<any, string>) {
        switch s.load_map(
            conn,
            decode,
        ) {
            case Ok(values) {
                if values.len() == 0 {
                    return Err("not found")
                }

                return Ok(values[0])
            }
            case Err(err) {
                return Err(err)
            }
        }
    }
}

func load_query(
    conn: &postgres.Connection,
    columns: &Vec<ColumnSpec, _>,
    table: string,
    where_expr: Expr,
    has_where: bool,
) -> (Result<postgres.QueryResult, string>) {
    if table.len() == 0 {
        return Err("table name is required")
    }

    mut var sql: string = "SELECT " + join_columns(columns) + " FROM " + table

    if has_where {
        var expr_out: ExprSql = expr_to_sql(
            &where_expr,
            0,
        )

        if expr_out.sql.len() > 0 {
            sql = sql + " WHERE " + expr_out.sql

            return pgQueryParams(
                conn,
                sql,
                expr_out.params,
            )
        }
    }

    return pgQuery(
        conn,
        sql,
    )
}

pub struct InsertBuilder {
    table:     string
    columns:   Vec<string, _>
    rows:      Vec<Vec<string, _>, _>
    current:   Vec<string, _>
    has_error: bool
    err:       string
}

pub struct InsertReturningInt {
    base:   InsertBuilder
    column: string
}

pub func insert(table: string) -> (InsertBuilder) {
    return InsertBuilder{
        columns:   Vec.new(),
        current:   Vec.new(),
        err:       "",
        has_error: false,
        rows:      Vec.new(),
        table:     table,
    }
}

impl InsertBuilder as b {
    pub func value(name: string, value: any) -> (InsertBuilder) {
        mut var out: InsertBuilder = b

        if out.has_error {
            return out
        }

        var idx: int = out.current.len()

        if out.rows.len() == 0 {
            if out.columns.len() > idx {
                if out.columns[idx] != name {
                    out.has_error = true
                    out.err = "column order mismatch in insert"

                    return out
                }
            } else {
                out.columns.push(name)
            }
        } else {
            if idx >= out.columns.len() {
                out.has_error = true
                out.err = "too many values in insert row"

                return out
            }

            if out.columns[idx] != name {
                out.has_error = true
                out.err = "column order mismatch in insert row"

                return out
            }
        }

        out.current.push(string(value))

        return out
    }

    pub func row() -> (InsertBuilder) {
        mut var out: InsertBuilder = b

        if out.has_error {
            return out
        }

        if out.current.len() > 0 {
            if out.columns.len() != out.current.len() {
                out.has_error = true
                out.err = "row values must match columns count"

                return out
            }

            out.rows.push(out.current)
            out.current = empty_string_vec()
        }

        return out
    }

    pub func returning_int(column: string) -> (InsertReturningInt) {
        return InsertReturningInt{base: b, column: column}
    }

    pub func exec(conn: &postgres.Connection) -> (Result<bool, string>) {
        var state = finalize_insert(b)

        switch state {
            case Ok(parts) {
                var sql = build_insert_sql(
                    parts.table,
                    &parts.columns,
                    &parts.rows,
                    "",
                )

                return execStatement(
                    conn,
                    sql,
                    parts.params,
                )
            }
            case Err(err) {
                return Err(err)
            }
        }
    }
}

impl InsertReturningInt as b {
    pub func exec(conn: &postgres.Connection) -> (Result<int, string>) {
        var state = finalize_insert(b.base)

        switch state {
            case Ok(parts) {
                var sql = build_insert_sql(
                    parts.table,
                    &parts.columns,
                    &parts.rows,
                    b.column,
                )
                var result = pgQueryParams(
                    conn,
                    sql,
                    parts.params,
                )

                switch result {
                    case Ok(qr) {
                        var rows: Vec<postgres.Row, _> = postgres.rows(&qr)

                        if rows.len() == 0 {
                            return Err("no rows returned")
                        }

                        var ret_result: Result<string, string> = postgres.row_get_index(
                            &rows[0],
                            0,
                        )

                        switch ret_result {
                            case Ok(ret_val) {
                                switch strconv.parseInt(
                                    &ret_val,
                                    10,
                                ) {
                                    case Ok(v) {
                                        return Ok(v)
                                    }
                                    case Err(err) {
                                        return Err(err)
                                    }
                                }
                            }
                            case Err(err) {
                                return Err(err)
                            }
                        }
                    }
                    case Err(err) {
                        return Err(err)
                    }
                }
            }
            case Err(err) {
                return Err(err)
            }
        }

        return Err("missing returning value")
    }
}

struct InsertParts {
    table:   string
    columns: Vec<string, _>
    rows:    Vec<Vec<string, _>, _>
    params:  Vec<string, _>
}

func finalize_insert(b: InsertBuilder) -> (Result<InsertParts, string>) {
    if b.has_error {
        return Err(b.err)
    }

    if b.table.len() == 0 {
        return Err("table name is required")
    }

    mut var rows: Vec<Vec<string, _>, _> = b.rows

    if b.current.len() > 0 {
        if b.columns.len() == 0 {
            return Err("insert requires at least one column")
        }

        if b.current.len() != b.columns.len() {
            return Err("row values must match columns count")
        }

        rows.push(b.current)
    }

    if rows.len() == 0 {
        return Err("insert requires at least one row")
    }

    mut var params: Vec<string, _> = Vec.new()

    for row in rows {
        for v in row {
            params.push(v)
        }
    }

    return Ok(
        InsertParts{
            columns: b.columns,
            params:  params,
            rows:    rows,
            table:   b.table,
        },
    )
}

func build_insert_sql(
    table: string,
    columns: &Vec<string, _>,
    rows: &Vec<Vec<string, _>, _>,
    returning: string,
) -> (string) {
    mut var sql: string = "INSERT INTO " + table + " (" + join_comma_separated(columns) + ") VALUES "
    mut var row_parts: Vec<string, _> = Vec.new()
    mut var i: int = 0

    while i < rows.len() {
        row_parts.push(
            "(" + build_placeholders(
                columns.len(),
                i * columns.len(),
            ) + ")",
        )
        i = i + 1
    }

    sql = sql + join_comma_separated(&row_parts)

    if returning.len() > 0 {
        sql = sql + " RETURNING " + returning
    }

    return sql
}

pub struct UpdateBuilder {
    table:      string
    set_cols:   Vec<string, _>
    set_vals:   Vec<string, _>
    where_expr: Expr
    has_where:  bool
    has_error:  bool
    err:        string
}

pub func update(table: string) -> (UpdateBuilder) {
    return UpdateBuilder{
        err:        "",
        has_error:  false,
        has_where:  false,
        set_cols:   Vec.new(),
        set_vals:   Vec.new(),
        table:      table,
        where_expr: empty_expr(),
    }
}

impl UpdateBuilder as b {
    pub func set(name: string, value: any) -> (UpdateBuilder) {
        mut var out: UpdateBuilder = b

        if out.has_error {
            return out
        }

        out.set_cols.push(name)
        out.set_vals.push(string(value))

        return out
    }

    pub func where(expr: Expr) -> (UpdateBuilder) {
        mut var out: UpdateBuilder = b

        out.where_expr = expr
        out.has_where = true

        return out
    }

    pub func exec(conn: &postgres.Connection) -> (Result<bool, string>) {
        if b.has_error {
            return Err(b.err)
        }

        if b.table.len() == 0 {
            return Err("table name is required")
        }

        if b.set_cols.len() == 0 {
            return Err("update requires at least one column")
        }

        mut var sql: string = "UPDATE " + b.table + " SET " + build_assignment_clause(
            &b.set_cols,
            0,
        )
        mut var params: Vec<string, _> = Vec.new()

        for v in b.set_vals {
            params.push(v)
        }

        if b.has_where {
            var expr_out: ExprSql = expr_to_sql(
                &b.where_expr,
                b.set_cols.len(),
            )

            if expr_out.sql.len() > 0 {
                sql = sql + " WHERE " + expr_out.sql

                for v in expr_out.params {
                    params.push(v)
                }
            }
        }

        return execStatement(
            conn,
            sql,
            params,
        )
    }
}

pub struct DeleteBuilder {
    table:      string
    where_expr: Expr
    has_where:  bool
    allow_all:  bool
    has_error:  bool
    err:        string
}

pub func delete(table: string) -> (DeleteBuilder) {
    return DeleteBuilder{
        allow_all:  false,
        err:        "",
        has_error:  false,
        has_where:  false,
        table:      table,
        where_expr: empty_expr(),
    }
}

impl DeleteBuilder as b {
    pub func where(expr: Expr) -> (DeleteBuilder) {
        mut var out: DeleteBuilder = b

        out.where_expr = expr
        out.has_where = true

        return out
    }

    pub func all() -> (DeleteBuilder) {
        mut var out: DeleteBuilder = b

        out.allow_all = true

        return out
    }

    pub func exec(conn: &postgres.Connection) -> (Result<bool, string>) {
        if b.has_error {
            return Err(b.err)
        }

        if b.table.len() == 0 {
            return Err("table name is required")
        }

        if !b.has_where && !b.allow_all {
            return Err("delete requires where clause or explicit all()")
        }

        mut var sql: string = "DELETE FROM " + b.table
        mut var params: Vec<string, _> = Vec.new()

        if b.has_where {
            var expr_out: ExprSql = expr_to_sql(
                &b.where_expr,
                0,
            )

            if expr_out.sql.len() > 0 {
                sql = sql + " WHERE " + expr_out.sql

                for v in expr_out.params {
                    params.push(v)
                }
            }
        }

        return execStatement(
            conn,
            sql,
            params,
        )
    }
}
