package borm

import "src/std/db/postgres.bak" as postgres
import "src/std/strconv/strconv.bak" as strconv

pub alias Connection = postgres.Connection
pub alias QueryResult = postgres.QueryResult
pub alias Row = postgres.Row

pub func connection(handle: int) -> (postgres.Connection) {
    return postgres.connection_from_handle(handle)
}

pub func empty_query_result() -> (postgres.QueryResult) {
    return postgres.empty_query_result()
}

pub func connect(conn_str: string) -> (Result<postgres.Connection, string>) {
    return postgres.connect(conn_str)
}

pub func close(conn: postgres.Connection) -> (Result<void, string>) {
    return postgres.close(conn)
}

pub func row_get(row: &Row, name: string) -> (Result<string, string>) {
    return postgres.row_get(
        row,
        name,
    )
}

pub func row_get_index(row: &Row, idx: int) -> (Result<string, string>) {
    return postgres.row_get_index(
        row,
        idx,
    )
}

var defaultPgQuery: func(&postgres.Connection, string) -> (Result<postgres.QueryResult, string>) = postgres.query
var defaultPgQueryParams: func(&postgres.Connection, string, Vec<string, _>) -> (Result<postgres.QueryResult, string>) = postgres.query_params

pub func defaultRunStatement(
    conn: &postgres.Connection,
    sql: string,
    params: Vec<string, _>,
) -> (Result<bool, string>) {
    switch defaultPgQueryParams(
        conn,
        sql,
        params,
    ) {
        case Ok(_) {
            return Ok(true)
        }
        case Err(err) {
            return Err(err)
        }
    }
}

mut var pgQuery: func(&postgres.Connection, string) -> (Result<postgres.QueryResult, string>) = defaultPgQuery
mut var pgQueryParams: func(&postgres.Connection, string, Vec<string, _>) -> (Result<postgres.QueryResult, string>) = defaultPgQueryParams
mut var execStatement: func(&postgres.Connection, string, Vec<string, _>) -> (Result<bool, string>) = defaultRunStatement

pub func set_query_hooks(
    queryFn: func(&postgres.Connection, string) -> (Result<postgres.QueryResult, string>),
    queryParamsFn: func(&postgres.Connection, string, Vec<string, _>) -> (Result<postgres.QueryResult, string>),
) -> (void) {
    pgQuery = queryFn
    pgQueryParams = queryParamsFn
}

pub func reset_query_hooks() -> (void) {
    pgQuery = defaultPgQuery
    pgQueryParams = defaultPgQueryParams
}

pub func set_exec_hook(
    execFn: func(&postgres.Connection, string, Vec<string, _>) -> (Result<bool, string>),
) -> (void) {
    execStatement = execFn
}

pub func reset_exec_hook() -> (void) {
    execStatement = defaultRunStatement
}

pub func transaction(
    conn: &postgres.Connection,
) -> (Result<postgres.Connection, string>) {
    switch execStatement(
        conn,
        "BEGIN",
        Vec.new(),
    ) {
        case Ok(_) {
            return Ok(*conn)
        }
        case Err(err) {
            return Err(err)
        }
    }
}

pub func commit(tx: &postgres.Connection) -> (Result<bool, string>) {
    return execStatement(
        tx,
        "COMMIT",
        Vec.new(),
    )
}

pub func rollback(tx: &postgres.Connection) -> (Result<bool, string>) {
    return execStatement(
        tx,
        "ROLLBACK",
        Vec.new(),
    )
}

pub struct ColumnSpec {
    pub name: string
}

pub struct Column {
    spec: ColumnSpec
}

pub struct ColumnInt {
    spec: ColumnSpec
}

pub struct ColumnFloat {
    spec: ColumnSpec
}

pub struct ColumnString {
    spec: ColumnSpec
}

pub func col(name: string) -> (Column) {
    return Column{
        spec: ColumnSpec{name: name},
    }
}

pub func col_int(name: string) -> (ColumnInt) {
    return ColumnInt{
        spec: ColumnSpec{name: name},
    }
}

pub func col_float(name: string) -> (ColumnFloat) {
    return ColumnFloat{
        spec: ColumnSpec{name: name},
    }
}

pub func col_string(name: string) -> (ColumnString) {
    return ColumnString{
        spec: ColumnSpec{name: name},
    }
}

struct Condition {
    column: string
    op:     string
    value:  string
}

pub struct Expr {
    conditions: Vec<Condition, _>
    joins:      Vec<string, _>
}

struct ExprSql {
    sql:    string
    params: Vec<string, _>
}

func empty_expr() -> (Expr) {
    return Expr{conditions: Vec.new(), joins: Vec.new()}
}

func expr_from_value(column: string, op: string, value: string) -> (Expr) {
    return Expr{
        conditions: Vec.from(
            [
                Condition{
                    column: column,
                    op:     op,
                    value:  value,
                },
            ],
        ),
        joins:      Vec.new(),
    }
}

func merge_expr(left: Expr, join: string, right: Expr) -> (Expr) {
    if left.conditions.len() == 0 {
        return right
    }

    if right.conditions.len() == 0 {
        return left
    }

    mut var conditions: Vec<Condition, _> = Vec.new()
    mut var joins: Vec<string, _> = Vec.new()

    for c in left.conditions {
        conditions.push(c)
    }

    for j in left.joins {
        joins.push(j)
    }

    joins.push(join)

    for c in right.conditions {
        conditions.push(c)
    }

    for j in right.joins {
        joins.push(j)
    }

    return Expr{conditions: conditions, joins: joins}
}

impl Expr as e {
    pub func and(other: Expr) -> (Expr) {
        return merge_expr(
            e,
            "AND",
            other,
        )
    }

    pub func or(other: Expr) -> (Expr) {
        return merge_expr(
            e,
            "OR",
            other,
        )
    }
}

impl Column as c {
    pub func spec() -> (ColumnSpec) {
        return c.spec
    }

    pub func eq(value: any) -> (Expr) {
        return expr_from_value(
            c.spec.name,
            "=",
            string(value),
        )
    }

    pub func gt(value: any) -> (Expr) {
        return expr_from_value(
            c.spec.name,
            ">",
            string(value),
        )
    }

    pub func gte(value: any) -> (Expr) {
        return expr_from_value(
            c.spec.name,
            ">=",
            string(value),
        )
    }

    pub func lt(value: any) -> (Expr) {
        return expr_from_value(
            c.spec.name,
            "<",
            string(value),
        )
    }

    pub func lte(value: any) -> (Expr) {
        return expr_from_value(
            c.spec.name,
            "<=",
            string(value),
        )
    }
}

