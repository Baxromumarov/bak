package os

// args returns the command-line arguments passed to the program
pub func args() -> (Vec<string, _>) {
    return __builtin_args()
}

// exit terminates the program with the given exit code
pub func exit(code: int) -> (void) {
    __builtin_exit(code)
}

// getenv retrieves the value of the environment variable named by the key
pub func getenv(key: string) -> (Result<string, string>) {
    return __builtin_getenv(key)
}

// getenvResult retrieves an environment variable as Result for Result-only flows.
pub func getenvResult(key: string) -> (Result<string, string>) {
    return getenv(key)
}

// setenv sets the value of the environment variable named by the key
pub func setenv(key: string, value: string) -> (Result<void, string>) {
    return __builtin_setenv(
        key,
        value,
    )
}

// cwd returns the current working directory
pub func cwd() -> (Result<string, string>) {
    return __builtin_cwd()
}

// chdir changes the current working directory to the named directory
pub func chdir(path: string) -> (Result<void, string>) {
    return __builtin_chdir(path)
}

// readDir reads the contents of a directory
pub func readDir(path: string) -> (Result<Vec<DirEntry, _>, string>) {
    return __builtin_read_dir(path)
}

// executable returns the path of the current executable
pub func executable() -> (Result<string, string>) {
    return __builtin_executable()
}

pub struct ExecResult {
    pub Output:    string
    pub Stdout:    string
    pub Stderr:    string
    pub ExitCode:  int
    pub TimedOut:  bool
    pub Truncated: bool
}

// exec runs an external command directly without invoking a shell.
// Shell expansion, pipelines, and redirection are not interpreted.
pub func exec(
    cmd: string,
    args: Vec<string, _>,
) -> (Result<ExecResult, string>) {
    return __builtin_exec(
        cmd,
        args,
    )
}

// chmod changes file mode bits (e.g. 493 for 0755).
pub func chmod(path: string, mode: int) -> (Result<void, string>) {
    return __builtin_chmod(
        path,
        mode,
    )
}

pub func hostname() -> (Result<string, string>) {
    return __builtin_hostname()
}

pub func tempDir() -> (string) {
    return __builtin_temp_dir()
}

pub func userHomeDir() -> (Result<string, string>) {
    return __builtin_user_home_dir()
}

pub struct DirEntry {
    pub Name:  string
    pub IsDir: bool
    pub Size:  int
}
