package time

import strconv "std/strconv"

pub struct Duration {
    nanos: int
}

pub struct Time {
    nanos: int
}

pub const nanosecond: int = 1
pub const microsecond: int = 1000
pub const millisecond: int = 1000000
pub const second: int = 1000000000
pub const minute: int = 60000000000
pub const hour: int = 3600000000000
// Time format constants for Time.as()
pub const formatUnix: string = "unix"
pub const formatUnixMillis: string = "unixMillis"
pub const formatUnixNanos: string = "unixNanos"
pub const formatRfc3339: string = "rfc3339"
pub const formatRfc3339Nano: string = "rfc3339_nano"
pub const formatIso8601: string = "iso8601"
pub const formatDate: string = "date"
pub const formatTime: string = "time"
pub const formatDateTime: string = "datetime"
pub const formatTimeMillis: string = "time_millis"
pub const formatTimeNanos: string = "time_nanos"

// Convenience constructors for durations
pub func nanos(n: int) -> (Duration) {
    return Duration{nanos: n}
}

pub func micros(n: int) -> (Duration) {
    return Duration{nanos: n * microsecond}
}

pub func millis(n: int) -> (Duration) {
    return Duration{nanos: n * millisecond}
}

pub func secs(n: int) -> (Duration) {
    return Duration{nanos: n * second}
}

pub func mins(n: int) -> (Duration) {
    return Duration{nanos: n * minute}
}

pub func hours(n: int) -> (Duration) {
    return Duration{nanos: n * hour}
}

pub func zeroDuration() -> (Duration) {
    return Duration{nanos: 0}
}

impl Duration as d {
    pub func asNanos() -> (int) {
        return d.nanos
    }

    pub func asMicros() -> (int) {
        return d.nanos / 1000
    }

    pub func asMillis() -> (int) {
        return d.nanos / 1000000
    }

    pub func asSecs() -> (int) {
        return d.nanos / 1000000000
    }

    pub func add(other: Duration) -> (Duration) {
        return Duration{nanos: d.nanos + other.nanos}
    }

    pub func sub(other: Duration) -> (Duration) {
        return Duration{nanos: d.nanos - other.nanos}
    }

    pub func mul(factor: int) -> (Duration) {
        return Duration{nanos: d.nanos * factor}
    }

    pub func divBy(divisor: int) -> (Duration) {
        return Duration{nanos: d.nanos / divisor}
    }

    pub func neg() -> (Duration) {
        return Duration{nanos: -d.nanos}
    }

    pub func abs() -> (Duration) {
        if d.nanos < 0 {
            return Duration{nanos: -d.nanos}
        }

        return d
    }

    pub func trunc(unit: int) -> (Duration) {
        // Round down to nearest unit (unit in nanos)
        if unit <= 0 {
            return d
        }

        var n: int = d.nanos - d.nanos % unit

        return Duration{nanos: n}
    }

    pub func round(unit: int) -> (Duration) {
        // Round to nearest unit
        if unit <= 0 {
            return d
        }

        var rem: int = d.nanos % unit
        mut var base: int = d.nanos - rem

        if rem * 2 >= unit {
            base = base + unit
        }

        return Duration{nanos: base}
    }

    pub func toString() -> (string) {
        return strconv.intToString(d.nanos) + "ns"
    }

    pub func eq(other: Duration) -> (bool) {
        return d.nanos == other.nanos
    }

    pub func lt(other: Duration) -> (bool) {
        return d.nanos < other.nanos
    }

    pub func gt(other: Duration) -> (bool) {
        return d.nanos > other.nanos
    }
}

impl Time as t {
    pub func add(d: Duration) -> (Time) {
        return Time{nanos: t.nanos + d.nanos}
    }

    pub func sub(other: Time) -> (Duration) {
        return Duration{nanos: t.nanos - other.nanos}
    }

    pub func subDuration(d: Duration) -> (Time) {
        return Time{nanos: t.nanos - d.nanos}
    }

    pub func eq(other: Time) -> (bool) {
        return t.nanos == other.nanos
    }

    pub func isZero() -> (bool) {
        return t.nanos == 0
    }

    pub func until(other: Time) -> (Duration) {
        // duration between other and this (other - this)
        return Duration{nanos: other.nanos - t.nanos}
    }

    pub func unixNanos() -> (int) {
        return t.nanos
    }

    pub func unixMillis() -> (int) {
        return t.nanos / 1000000
    }

    pub func unix() -> (int) {
        return t.nanos / 1000000000
    }
    // Format time using a predefined format constant.
    // Fast path for unix numeric formats
    pub func format(format: string) -> (string) {
        if format == formatUnix {
            return strconv.intToString(t.unix())
        }

        if format == formatUnixMillis {
            return strconv.intToString(t.unixMillis())
        }

        if format == formatUnixNanos {
            return strconv.intToString(t.unixNanos())
        }

        var parts: Vec<int, _> = __builtin_time_parts(t.nanos)
        var year: int = parts[0]
        var month: int = parts[1]
        var day: int = parts[2]
        var hour: int = parts[3]
        var minute: int = parts[4]
        var second: int = parts[5]
        var nanos: int = parts[6]
        var date: string = padLeft(
            year,
            4,
        ) + "-" + padLeft(
            month,
            2,
        ) + "-" + padLeft(
            day,
            2,
        )
        var time: string = padLeft(
            hour,
            2,
        ) + ":" + padLeft(
            minute,
            2,
        ) + ":" + padLeft(
            second,
            2,
        )

        if format == formatDate {
            return date
        }

        if format == formatTime {
            return time
        }

        if format == formatDateTime {
            return date + " " + time
        }

        if format == formatTimeMillis {
            return time + "." + padLeft(
                nanos / 1000000,
                3,
            )
        }

        if format == formatTimeNanos {
            return time + "." + padLeft(
                nanos,
                9,
            )
        }

        if format == formatRfc3339 || format == formatIso8601 {
            return date + "T" + time + "Z"
        }

        if format == formatRfc3339Nano {
            return date + "T" + time + "." + padLeft(
                nanos,
                9,
            ) + "Z"
        }

        // Unknown format: fallback to RFC3339
        return date + "T" + time + "Z"
    }

    pub func after(other: Time) -> (bool) {
        return t.nanos > other.nanos
    }

    pub func before(other: Time) -> (bool) {
        return t.nanos < other.nanos
    }
}

func padLeft(value: int, width: int) -> (string) {
    mut var s: string = strconv.intToString(value)

    while s.len() < width {
        s = "0" + s
    }

    return s
}

// Time constructors
pub func fromUnix(secs: int) -> (Time) {
    return Time{nanos: secs * second}
}

pub func fromUnixMillis(ms: int) -> (Time) {
    return Time{nanos: ms * millisecond}
}

pub func fromUnixNanos(nanos: int) -> (Time) {
    return Time{nanos: nanos}
}

// Monotonic helpers
pub func monotonicSince(start: int) -> (Duration) {
    return Duration{nanos: __builtin_monotonic_now() - start}
}

// Convenience sleep wrappers
pub func sleepMs(ms: int) -> (void) {
    sleep(fromMillis(ms))

    return void
}

pub func sleepSecs(s: int) -> (void) {
    sleep(fromSecs(s))

    return void
}

pub func now() -> (Time) {
    return Time{nanos: __builtin_time_now()}
}

pub func monotonicNow() -> (int) {
    return __builtin_monotonic_now()
}

pub func nowMs() -> (int) {
    return (now()).unixMillis()
}

pub func sleep(d: Duration) -> (void) {
    // Convert to milliseconds for the builtin
    mut var ms: int = d.nanos / 1000000

    if ms < 1 && d.nanos > 0 {
        ms = 1
    }

    // __builtin_sleep returns Result<void, string>, we unwrap it to panic on failure
    (__builtin_sleep(ms)).unwrap()

    return void
}

pub func fromMillis(ms: int) -> (Duration) {
    return Duration{nanos: ms * millisecond}
}

pub func fromSecs(s: int) -> (Duration) {
    return Duration{nanos: s * second}
}

pub func since(t: Time) -> (Duration) {
    return (now()).sub(t)
}

// =============================================================================
// Additional Time Utilities
// =============================================================================
// parseDuration parses a simple duration string like "100ms", "5s", "2m", "1h".
// Returns Err if the format is unrecognized.
pub func parseDuration(s: &string) -> (Result<Duration, string>) {
    if s.len() == 0 {
        return Err("empty duration string")
    }

    mut var numStr: string = ""
    mut var i: int = 0

    while i < s.len() {
        var ch: char = s[i]

        if ch >= '0' && ch <= '9' {
            numStr = numStr + string(ch)
        } else {
            break
        }

        i = i + 1
    }

    if numStr.len() == 0 {
        return Err("duration missing number")
    }

    var numRes: Result<int, string> = strconv.atoi(&numStr)

    switch numRes {
        case Err(e) {
            return Err(e)
        }
        case Ok(n) {
            var unit: string = s.substring(
                i,
                s.len(),
            )

            if unit == "ns" {
                return Ok(Duration{nanos: n})
            }

            if unit == "us" || unit == "µs" {
                return Ok(Duration{nanos: n * microsecond})
            }

            if unit == "ms" {
                return Ok(Duration{nanos: n * millisecond})
            }

            if unit == "s" {
                return Ok(Duration{nanos: n * second})
            }

            if unit == "m" {
                return Ok(Duration{nanos: n * minute})
            }

            if unit == "h" {
                return Ok(Duration{nanos: n * hour})
            }

            return Err("unknown duration unit: " + unit)
        }
    }
}

// Timer represents a one-shot or periodic timer.
pub struct Timer {
    start:    Time
    interval: Duration
}

impl Timer as t {
    // newTimer creates a Timer that fires after interval from now.
    pub func newTimer(interval: Duration) -> (Timer) {
        return Timer{interval: interval, start: now()}
    }
    // reset resets the timer to fire after interval from now.
    pub mut func reset(interval: Duration) -> (void) {
        t.start = now()
        t.interval = interval

        return void
    }
    // elapsed returns true if the interval has passed.
    pub func elapsed() -> (bool) {
        return (since(t.start)).asNanos() >= t.interval.asNanos()
    }
    // remaining returns the time remaining until the timer fires.
    pub func remaining() -> (Duration) {
        var passed: Duration = since(t.start)
        var intervalNanos: int = t.interval.asNanos()
        var passedNanos: int = passed.asNanos()

        if passedNanos >= intervalNanos {
            return Duration{nanos: 0}
        }

        return Duration{nanos: intervalNanos - passedNanos}
    }
}

// Stopwatch is a simple elapsed-time tracker.
pub struct Stopwatch {
    start:   int
    running: bool
}

impl Stopwatch as sw {
    // new creates a new stopped Stopwatch.
    pub func new() -> (Stopwatch) {
        return Stopwatch{running: false, start: 0}
    }
    // start starts the stopwatch.
    pub mut func start() -> (void) {
        sw.start = monotonicNow()
        sw.running = true

        return void
    }
    // stop stops the stopwatch and returns the elapsed duration.
    pub mut func stop() -> (Duration) {
        sw.running = false

        return monotonicSince(sw.start)
    }
    // reset resets the stopwatch to zero.
    pub mut func reset() -> (void) {
        sw.start = monotonicNow()

        return void
    }
    // elapsed returns the elapsed time since start.
    pub func elapsed() -> (Duration) {
        if !sw.running {
            return Duration{nanos: 0}
        }

        return monotonicSince(sw.start)
    }
    // isRunning returns true if the stopwatch is running.
    pub func isRunning() -> (bool) {
        return sw.running
    }
}

// sleepUntil sleeps until the given Time.
pub func sleepUntil(t: Time) -> (void) {
    var d: Duration = t.until(now())

    if d.asNanos() > 0 {
        sleep(d)
    }

    return void
}

// tick creates a Timer that fires every interval.
pub func tick(interval: Duration) -> (Timer) {
    return Timer{interval: interval, start: now()}
}
