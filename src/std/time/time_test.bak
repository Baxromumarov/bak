package time

import "src/std/test/test.bak" as test
import "src/std/time/time.bak" as tlib

func test_duration_constructors() -> (void) {
    mut var t: test.T = test.new("test_duration_constructors")
    var d1: tlib.Duration = tlib.micros(2)
    t.eq(d1.as_micros(), 2)

    var d2: tlib.Duration = tlib.millis(1500)
    t.eq(d2.as_millis(), 1500)

    var d3: tlib.Duration = tlib.secs(3)
    t.eq(d3.as_secs(), 3)
    t.finish()
}

func test_duration_arithmetic() -> (void) {
    mut var t: test.T = test.new("test_duration_arithmetic")
    var a: tlib.Duration = tlib.secs(2)
    var diff: tlib.Duration = a.sub(tlib.millis(500))
    t.eq(diff.as_millis(), 1500)

    var prod: tlib.Duration = a.mul(3)
    t.eq(prod.as_secs(), 6)

    var divd: tlib.Duration = prod.div_by(2)
    t.eq(divd.as_secs(), 3)
    t.finish()
}

func test_duration_rounding_and_trunc() -> (void) {
    mut var t: test.T = test.new("test_duration_rounding_and_trunc")
    var d: tlib.Duration = tlib.millis(1501)
    var r: tlib.Duration = d.round(tlib.Second)
    t.eq(r.as_millis(), 2000)

    var tr: tlib.Duration = d.trunc(tlib.Second)
    t.eq(tr.as_millis(), 1000)
    t.finish()
}

func test_duration_neg_abs_to_string() -> (void) {
    mut var t: test.T = test.new("test_duration_neg_abs_to_string")
    var d: tlib.Duration = tlib.secs(1)
    var negd: tlib.Duration = d.neg()
    t.eq(negd.as_secs(), -1)

    var absd: tlib.Duration = negd.abs()
    t.eq(absd.as_secs(), 1)

    var s: string = d.to_string()
    t.contains(s, "ns")
    t.finish()
}

func test_time_conversions_and_ops() -> (void) {
    mut var t: test.T = test.new("test_time_conversions_and_ops")
    var t1: tlib.Time = tlib.from_unix(10)
    t.eq(t1.unix(), 10)

    var t2: tlib.Time = tlib.from_unix_millis(1500)
    t.eq(t2.unix_millis(), 1500)

    var t3: tlib.Time = t1.add(tlib.secs(5))
    t.eq(t3.unix(), 15)

    var dur: tlib.Duration = t1.until(tlib.from_unix(12))
    t.eq(dur.as_secs(), 2)

    t.is_true(tlib.from_unix(5).before(tlib.from_unix(6)))
    t.is_true(tlib.from_unix(6).after(tlib.from_unix(5)))
    t.finish()
}

func test_monotonic_and_sleep() -> (void) {
    mut var t: test.T = test.new("test_monotonic_and_sleep")
    var start: int = tlib.monotonic_now()
    // short tlib.sleep; test only that monotonic time advances
    tlib.sleep_ms(1)
    var elapsed: tlib.Duration = tlib.monotonic_since(start)
    t.gte(elapsed.as_millis(), 1)
    t.finish()
}

func test_time_formats() -> (void) {
    mut var t: test.T = test.new("test_time_formats")
    var epoch: tlib.Time = tlib.from_unix(0)
    t.eq_string(epoch.format(tlib.FormatUnix), "0")
    t.eq_string(epoch.format(tlib.FormatUnixMillis), "0")
    t.eq_string(epoch.format(tlib.FormatUnixNanos), "0")
    t.eq_string(epoch.format(tlib.FormatDate), "1970-01-01")
    t.eq_string(epoch.format(tlib.FormatTime), "00:00:00")
    t.eq_string(epoch.format(tlib.FormatDateTime), "1970-01-01 00:00:00")
    t.eq_string(epoch.format(tlib.FormatRFC3339), "1970-01-01T00:00:00Z")
    t.eq_string(epoch.format(tlib.FormatISO8601), "1970-01-01T00:00:00Z")

    var nano: tlib.Time = tlib.from_unix_nanos(123456789)
    t.eq_string(nano.format(tlib.FormatUnix), "0")
    t.eq_string(nano.format(tlib.FormatUnixMillis), "123")
    t.eq_string(nano.format(tlib.FormatUnixNanos), "123456789")
    t.eq_string(nano.format(tlib.FormatTimeMillis), "00:00:00.123")
    t.eq_string(nano.format(tlib.FormatTimeNanos), "00:00:00.123456789")
    t.eq_string(nano.format(tlib.FormatRFC3339Nano), "1970-01-01T00:00:00.123456789Z")
    t.finish()
}

// Tests are registered as `test_` functions and run by the test harness.
