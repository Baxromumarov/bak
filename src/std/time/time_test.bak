package time

import test "std/test"
import tlib "std/time"

func test_duration_constructors() -> (void) {
    mut var t: test.T = test.new("test_duration_constructors")
    var d1: tlib.Duration = tlib.micros(2)

    t.eq(
        d1.asMicros(),
        2,
    )

    var d2: tlib.Duration = tlib.millis(1500)

    t.eq(
        d2.asMillis(),
        1500,
    )

    var d3: tlib.Duration = tlib.secs(3)

    t.eq(
        d3.asSecs(),
        3,
    )
    t.finish()
}

func test_duration_arithmetic() -> (void) {
    mut var t: test.T = test.new("test_duration_arithmetic")
    var a: tlib.Duration = tlib.secs(2)
    var diff: tlib.Duration = a.sub(tlib.millis(500))

    t.eq(
        diff.asMillis(),
        1500,
    )

    var prod: tlib.Duration = a.mul(3)

    t.eq(
        prod.asSecs(),
        6,
    )

    var divd: tlib.Duration = prod.divBy(2)

    t.eq(
        divd.asSecs(),
        3,
    )
    t.finish()
}

func test_duration_rounding_and_trunc() -> (void) {
    mut var t: test.T = test.new("test_duration_rounding_and_trunc")
    var d: tlib.Duration = tlib.millis(1501)
    var r: tlib.Duration = d.round(tlib.second)

    t.eq(
        r.asMillis(),
        2000,
    )

    var tr: tlib.Duration = d.trunc(tlib.second)

    t.eq(
        tr.asMillis(),
        1000,
    )
    t.finish()
}

func test_duration_neg_abs_to_string() -> (void) {
    mut var t: test.T = test.new("test_duration_neg_abs_to_string")
    var d: tlib.Duration = tlib.secs(1)
    var negd: tlib.Duration = d.neg()

    t.eq(
        negd.asSecs(),
        -1,
    )

    var absd: tlib.Duration = negd.abs()

    t.eq(
        absd.asSecs(),
        1,
    )

    var s: string = d.toString()

    t.contains(
        s,
        "ns",
    )
    t.finish()
}

func test_time_conversions_and_ops() -> (void) {
    mut var t: test.T = test.new("test_time_conversions_and_ops")
    var t1: tlib.Time = tlib.fromUnix(10)

    t.eq(
        t1.unix(),
        10,
    )

    var t2: tlib.Time = tlib.fromUnixMillis(1500)

    t.eq(
        t2.unixMillis(),
        1500,
    )

    var t3: tlib.Time = t1.add(tlib.secs(5))

    t.eq(
        t3.unix(),
        15,
    )

    var dur: tlib.Duration = t1.until(tlib.fromUnix(12))

    t.eq(
        dur.asSecs(),
        2,
    )
    t.isTrue(tlib.fromUnix(5).before(tlib.fromUnix(6)))
    t.isTrue(tlib.fromUnix(6).after(tlib.fromUnix(5)))
    t.finish()
}

func test_monotonic_and_sleep() -> (void) {
    mut var t: test.T = test.new("test_monotonic_and_sleep")
    var start: int = tlib.monotonicNow()

    // short tlib.sleep; test only that monotonic time advances
    tlib.sleepMs(1)

    var elapsed: tlib.Duration = tlib.monotonicSince(start)

    t.gte(
        elapsed.asMillis(),
        1,
    )
    t.finish()
}

func test_time_formats() -> (void) {
    mut var t: test.T = test.new("test_time_formats")
    var epoch: tlib.Time = tlib.fromUnix(0)

    t.eqString(
        epoch.format(tlib.formatUnix),
        "0",
    )
    t.eqString(
        epoch.format(tlib.formatUnixMillis),
        "0",
    )
    t.eqString(
        epoch.format(tlib.formatUnixNanos),
        "0",
    )
    t.eqString(
        epoch.format(tlib.formatDate),
        "1970-01-01",
    )
    t.eqString(
        epoch.format(tlib.formatTime),
        "00:00:00",
    )
    t.eqString(
        epoch.format(tlib.formatDateTime),
        "1970-01-01 00:00:00",
    )
    t.eqString(
        epoch.format(tlib.formatRfc3339),
        "1970-01-01T00:00:00Z",
    )
    t.eqString(
        epoch.format(tlib.formatIso8601),
        "1970-01-01T00:00:00Z",
    )

    var nano: tlib.Time = tlib.fromUnixNanos(123456789)

    t.eqString(
        nano.format(tlib.formatUnix),
        "0",
    )
    t.eqString(
        nano.format(tlib.formatUnixMillis),
        "123",
    )
    t.eqString(
        nano.format(tlib.formatUnixNanos),
        "123456789",
    )
    t.eqString(
        nano.format(tlib.formatTimeMillis),
        "00:00:00.123",
    )
    t.eqString(
        nano.format(tlib.formatTimeNanos),
        "00:00:00.123456789",
    )
    t.eqString(
        nano.format(tlib.formatRfc3339Nano),
        "1970-01-01T00:00:00.123456789Z",
    )
    t.finish()
} // Tests are registered as `test_` functions and run by the test harness.
