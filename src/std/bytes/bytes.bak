package bytes

import "src/std/fs/fs.bak" as fs
import "src/std/bytes/types.bak" as types

// new returns an empty Bytes buffer
pub func new() -> (types.Bytes) {
    return types.Bytes{data: Vec.new()}
}

// withCapacity creates a Bytes buffer with an initial capacity (best-effort)
pub func withCapacity(_cap: int) -> (types.Bytes) {
    // Vec with explicit capacity API is not exposed everywhere yet;
    // fall back to empty Vec for now.
    return types.Bytes{data: Vec.new()}
}

// fromVec takes ownership of an existing Vec<int, _> and returns Bytes
pub func fromVec(v: Vec<int, _>) -> (types.Bytes) {
    return types.Bytes{data: v}
}

// fromString creates a Bytes buffer from a string (byte-wise copy)
pub func fromString(s: string) -> (types.Bytes) {
    mut var out: types.Bytes = types.Bytes{data: Vec.new()}
    mut var i: int = 0
    while i < s.len() {
        out.data.push(int(s[i]))
        i = i + 1
    }
    return out
}

// toString converts bytes to string by casting each element to char
pub func toString(b: &types.Bytes) -> (string) {
    mut var out: string = ""
    mut var i: int = 0
    while i < b.data.len() {
        out = out + string(char(b.data[i]))
        i = i + 1
    }
    return out
}

// to_vec copies bytes into a Vec<int, _>
pub func toVec(b: &types.Bytes) -> (Vec<int, _>) {
    mut var out: Vec<int, _> = Vec.new()
    mut var i: int = 0
    while i < b.data.len() {
        out.push(b.data[i])
        i = i + 1
    }
    return out
}

// view creates an owned view (copy) over `b` from `start` with `length`
pub func view(b: &types.Bytes, start: int, length: int) -> (Result<types.BytesView, string>) {
    if start < 0 || length < 0 || start + length > b.data.len() {
        return Err("invalid view range")
    }
    // create a copy for now for simplicity, or use slice if supported
    mut var out: Vec<int, _> = Vec.new()
    mut var i: int = start
    var end: int = start + length
    while i < end {
        out.push(b.data[i])
        i = i + 1
    }
    return Ok(types.BytesView{data: out})
}

// length returns number of bytes
pub func length(b: &types.Bytes) -> (int) {
    // Standalone function avoids runtime crash with `impl`
    return b.data.len()
}

// get returns the byte at index or Err if out of range
pub func get(b: &types.Bytes, i: int) -> (Result<int, string>) {
    if i < 0 || i >= b.data.len() {
        return Err("index out of bounds")
    }
    return Ok(b.data[i])
}

// set writes a byte at index, returns Err on OOB
pub func set(b: &mut types.Bytes, i: int, v: int) -> (Result<void, string>) {
    if i < 0 || i >= b.data.len() {
        return Err("index out of bounds")
    }
    b.data[i] = v
    return Ok(void)
}

// -----------------------------------------------------------------------------
// View functions
// -----------------------------------------------------------------------------

// viewLength for views
pub func viewLength(v: &types.BytesView) -> (int) {
    return v.data.len()
}

// viewGet from view
pub func viewGet(v: &types.BytesView, i: int) -> (Result<int, string>) {
    if i < 0 || i >= v.data.len() {
        return Err("index out of bounds")
    }
    return Ok(v.data[i])
}

// readFile reads a file and returns its bytes
pub func readFile(path: string) -> (Result<types.Bytes, string>) {
    // Prefer reading raw bytes via fs.readFileBytes when available.
    var rb: Result<Vec<int, _>, string> = fs.readFileBytes(&path)
    if rb.isOk() {
        return Ok(fromVec(rb.unwrap()))
    }
    // fall back to string-based read
    var r: Result<string, string> = fs.readFile(path)
    if r.isOk() {
        return Ok(fromString(r.unwrap()))
    }
    return Err(r.unwrapErr())
}

// writeFile writes bytes to a file
pub func writeFile(path: string, data: &types.Bytes) -> (Result<void, string>) {
    // Prefer writing raw bytes
    mut var vecData: Vec<int,_> = Vec.new()
    mut var i: int = 0
    while i < data.data.len() {
        vecData.push(data.data[i])
        i = i + 1
    }

    var wres: Result<void, string> = fs.writeFileBytes(&path, vecData)
    if wres.isOk() {
        return Ok(void)
    }
    return Err(wres.unwrapErr())
}
