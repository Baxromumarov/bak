package bytes_test

import test "std/test"
import types "std/bytes/types"
import bytes "std/bytes"

func test_from_string_and_len() -> (void) {
    mut var t: test.T = test.new("test_from_string_and_len")
    var bb: types.Bytes = bytes.fromString("hello")

    t.eq(
        bytes.length(&bb),
        5,
    )
    t.finish()
}

func test_get_first_byte() -> (void) {
    mut var t: test.T = test.new("test_get_first_byte")
    var bb: types.Bytes = bytes.fromString("hello")

    switch bytes.get(
        &bb,
        0,
    ) {
        case Ok(v) {
            t.eq(
                v,
                int('h'),
            )
        }
        case Err(_) {
            t.fail("expected Ok for index 0")
        }
    }

    t.finish()
}

func test_view_and_view_len() -> (void) {
    mut var t: test.T = test.new("test_view_and_view_len")
    var bb: types.Bytes = bytes.fromString("hello")
    var view_res: Result<types.BytesView, string> = bytes.view(
        &bb,
        0,
        2,
    )

    if view_res.isOk() {
        var v: types.BytesView = view_res.unwrap()

        t.eq(
            bytes.viewLength(&v),
            2,
        )
    } else {
        t.fail("view failed: " + view_res.unwrapErr())
    }

    t.finish()
}

func test_set_changes_source() -> (void) {
    mut var t: test.T = test.new("test_set_changes_source")
    mut var bb: types.Bytes = bytes.fromString("hello")
    var set_res: Result<void, string> = bytes.set(
        &mut bb,
        1,
        int('a'),
    )

    if set_res.isErr() {
        t.fail("set failed: " + set_res.unwrapErr())
    }

    t.eqString(
        bytes.toString(&bb),
        "hallo",
    )
    t.finish()
}
