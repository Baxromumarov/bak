package http

pub struct Header {
    pub name:  string
    pub value: string
}

pub func headerValue(headers: &Vec<Header, _>, name: string) -> (Result<string, string>) {
    mut var i: int = 0
    while i < headers.len() {
        var h: Header = headers[i]
        if eqCaseInsensitive(&h.name, &name) {
            return Ok(h.value)
        }
        i = i + 1
    }
    return Err("header not found")
}
