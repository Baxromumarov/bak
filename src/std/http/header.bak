package http

pub struct Header {
    pub name:  string
    pub value: string
}

pub func header_value(headers: &Vec<Header, _>, name: string) -> (Option<string>) {
    mut var i: int = 0
    while i < headers.len() {
        var h: Header = headers[i]
        if eq_case_insensitive(&h.name, &name) {
            return Some(h.value)
        }
        i = i + 1
    }
    return None
}
