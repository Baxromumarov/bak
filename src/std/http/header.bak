package http

import strings "std/strings"

pub struct Header {
    pub name:  string
    pub value: string
}

pub func headerValue(
    headers: &Vec<Header, _>,
    name: string,
) -> (Result<string, string>) {
    mut var i: int = 0

    while i < headers.len() {
        var h: Header = headers[i]

        if eqCaseInsensitive(
            &h.name,
            &name,
        ) {
            return Ok(h.value)
        }

        i = i + 1
    }

    return Err("header not found")
}

func parseHeaders(raw: string) -> (Result<Vec<Header, _>, string>) {
    mut var headers: Vec<Header, _> = Vec.new()
    mut var current: string = raw

    while current.len() > 0 {
        var lineEnd: int = indexOf(
            &current,
            &lf,
        )
        mut var line: string = current

        if lineEnd != -1 {
            mut var trimEnd: int = lineEnd

            if lineEnd > 0 && current[lineEnd - 1] == '\r' {
                trimEnd = lineEnd - 1
            }

            line = current.substring(
                0,
                trimEnd,
            )
            current = current.substring(
                lineEnd + 1,
                current.len(),
            )
        } else {
            current = ""
        }

        if line.len() == 0 {
            continue
        }

        var colonIndex: int = indexOf(
            &line,
            &":",
        )

        if colonIndex <= 0 {
            return Err("invalid header line")
        }

        var name: string = line.substring(
            0,
            colonIndex,
        )
        var rawValue: string = line.substring(
            colonIndex + 1,
            line.len(),
        )

        headers.push(
            Header{
                name:  name,
                value: strings.trim(&rawValue),
            },
        )
    }

    return Ok(headers)
}
