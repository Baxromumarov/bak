package sort

import collections "std/collections/set"
import vector "std/sort/vector"

// Sort Set<T> values and return a sorted Vec.
pub func sort_set<T>(
    set: &collections.Set<T>,
    asc: bool,
    cmp: func(&T, &T) -> (int),
) -> (Vec<T, _>) {
    mut var items: Vec<T, _> = set.values()

    vector.sort(
        &mut items,
        asc,
        cmp,
    )

    return items
}

// Sort Set<T> values with a custom less function.
pub func sort_set_by<T>(
    set: &collections.Set<T>,
    asc: bool,
    less: func(&T, &T) -> (bool),
) -> (Vec<T, _>) {
    mut var items: Vec<T, _> = set.values()

    vector.sort_by(
        &mut items,
        asc,
        less,
    )

    return items
}

// Sort StringSet values and return a sorted Vec.
pub func sortStringSet(
    set: &collections.StringSet,
    asc: bool,
) -> (Vec<string, _>) {
    mut var items: Vec<string, _> = set.values()

    vector.sortStrings(
        &mut items,
        asc,
    )

    return items
}

// Sort StringSet values with a custom less function.
pub func sortStringSetBy(
    set: &collections.StringSet,
    asc: bool,
    less: func(&string, &string) -> (bool),
) -> (Vec<string, _>) {
    mut var items: Vec<string, _> = set.values()

    vector.sort_by(
        &mut items,
        asc,
        less,
    )

    return items
}

// Sort IntSet values and return a sorted Vec.
pub func sortIntSet(set: &collections.IntSet, asc: bool) -> (Vec<int, _>) {
    mut var items: Vec<int, _> = set.values()

    vector.sortInts(
        &mut items,
        asc,
    )

    return items
}

// Sort IntSet values with a custom less function.
pub func sortIntSetBy(
    set: &collections.IntSet,
    asc: bool,
    less: func(&int, &int) -> (bool),
) -> (Vec<int, _>) {
    mut var items: Vec<int, _> = set.values()

    vector.sort_by(
        &mut items,
        asc,
        less,
    )

    return items
}
