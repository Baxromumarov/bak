package sort

import test "std/test"
import collections_set "std/collections/set"
import hashmap "std/collections/hashmap"
import sortSet "std/sort/set"
import sort_map "std/sort/map"
import sort_vector "std/sort/vector"

func less_len(a: &string, b: &string) -> (bool) {
    return a.len() < b.len()
}

func test_sort_generic_set() -> (void) {
    mut var t: test.T = test.new("test_sort_generic_set")
    mut var s: collections_set.Set<int> = collections_set.newSet()

    s.add(3)
    s.add(1)
    s.add(2)

    var items: Vec<int, _> = sortSet.sortSet(
        &s,
        true,
        sort_vector.compareInts,
    )

    t.eq(
        items[0],
        1,
    )
    t.eq(
        items[1],
        2,
    )
    t.eq(
        items[2],
        3,
    )
    t.finish()
}

func test_sorted_keys_generic_map() -> (void) {
    mut var t: test.T = test.new("test_sorted_keys_generic_map")
    mut var m: hashmap.HashMap<int, string> = hashmap.newHashMap()

    m.insert(
        2,
        "two",
    )
    m.insert(
        1,
        "one",
    )
    m.insert(
        3,
        "three",
    )

    var keys: Vec<int, _> = sort_map.sortedKeys(
        &m,
        true,
        sort_vector.compareInts,
    )

    t.eq(
        keys[0],
        1,
    )
    t.eq(
        keys[1],
        2,
    )
    t.eq(
        keys[2],
        3,
    )
    t.finish()
}

func test_sort_string_set() -> (void) {
    mut var t: test.T = test.new("test_sort_string_set")
    mut var s: collections_set.StringSet = collections_set.newStringSet()

    s.add("b")
    s.add("a")
    s.add("c")

    var items: Vec<string, _> = sortSet.sortStringSet(
        &s,
        true,
    )

    t.eqString(
        items[0],
        "a",
    )
    t.eqString(
        items[1],
        "b",
    )
    t.eqString(
        items[2],
        "c",
    )
    t.finish()
}

func test_sort_int_set_desc() -> (void) {
    mut var t: test.T = test.new("test_sort_int_set_desc")
    mut var s: collections_set.IntSet = collections_set.newIntSet()

    s.add(1)
    s.add(3)
    s.add(2)

    var items: Vec<int, _> = sortSet.sortIntSet(
        &s,
        false,
    )

    t.eq(
        items[0],
        3,
    )
    t.eq(
        items[1],
        2,
    )
    t.eq(
        items[2],
        1,
    )
    t.finish()
}

func test_sort_string_set_by() -> (void) {
    mut var t: test.T = test.new("test_sort_string_set_by")
    mut var s: collections_set.StringSet = collections_set.newStringSet()

    s.add("ccc")
    s.add("a")
    s.add("bb")

    var items: Vec<string, _> = sortSet.sortStringSetBy(
        &s,
        true,
        less_len,
    )

    t.eqString(
        items[0],
        "a",
    )
    t.eqString(
        items[1],
        "bb",
    )
    t.eqString(
        items[2],
        "ccc",
    )
    t.finish()
}

func test_sorted_keys_string_map() -> (void) {
    mut var t: test.T = test.new("test_sorted_keys_string_map")
    mut var m: hashmap.HashMap<string, string> = hashmap.newHashMap()

    m.insert(
        "b",
        "1",
    )
    m.insert(
        "a",
        "2",
    )
    m.insert(
        "c",
        "3",
    )

    var keys: Vec<string, _> = sort_map.sortedKeys(
        &m,
        true,
        sort_vector.compareStrings,
    )

    t.eqString(
        keys[0],
        "a",
    )
    t.eqString(
        keys[1],
        "b",
    )
    t.eqString(
        keys[2],
        "c",
    )
    t.finish()
}

func test_sorted_keys_string_map_by() -> (void) {
    mut var t: test.T = test.new("test_sorted_keys_string_map_by")
    mut var m: hashmap.HashMap<string, string> = hashmap.newHashMap()

    m.insert(
        "bbb",
        "1",
    )
    m.insert(
        "a",
        "2",
    )
    m.insert(
        "cc",
        "3",
    )

    var keys: Vec<string, _> = sort_map.sortedKeysBy(
        &m,
        true,
        less_len,
    )

    t.eqString(
        keys[0],
        "a",
    )
    t.eqString(
        keys[1],
        "cc",
    )
    t.eqString(
        keys[2],
        "bbb",
    )
    t.finish()
}

func test_sorted_keys_int_map() -> (void) {
    mut var t: test.T = test.new("test_sorted_keys_int_map")
    mut var m: hashmap.HashMap<string, int> = hashmap.newHashMap()

    m.insert(
        "2",
        20,
    )
    m.insert(
        "1",
        10,
    )
    m.insert(
        "3",
        30,
    )

    var keys: Vec<string, _> = sort_map.sortedKeys(
        &m,
        true,
        sort_vector.compareStrings,
    )

    t.eqString(
        keys[0],
        "1",
    )
    t.eqString(
        keys[1],
        "2",
    )
    t.eqString(
        keys[2],
        "3",
    )
    t.finish()
}
