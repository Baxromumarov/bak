package main

import dyn "dyn_arr.bak"
import test "std/test"

func make_data(age: int64) -> (dyn.Data) {
    return dyn.Data{
        age:  age,
        fl:   12.0,
        name: "hello",
    }
}

func test_divide_age_ok() -> (void) {
    mut var t: test.T = test.new("test_divide_age_ok")
    var d: dyn.Data = make_data(12)
    var result: Result<int64, string> = d.divideAge()

    t.isOk(result)
    t.eq(
        result.unwrap(),
        int64(6),
    )
    t.finish()

    return void
}

func test_divide_age_zero_error() -> (void) {
    mut var t: test.T = test.new("test_divide_age_zero_error")
    var d: dyn.Data = make_data(0)
    var result: Result<int64, string> = d.divideAge()

    t.isErr(result)
    t.eqString(
        result.unwrapErr(),
        "zero division error",
    )
    t.finish()

    return void
}

func test_half_age_uses_divide_age() -> (void) {
    mut var t: test.T = test.new("test_half_age_uses_divide_age")
    var d: dyn.Data = make_data(14)
    var result: Result<int64, string> = dyn.halfAge(d)

    t.isOk(result)
    t.eq(
        result.unwrap(),
        int64(7),
    )
    t.finish()

    return void
}

func test_half_age_propagates_zero_error() -> (void) {
    mut var t: test.T = test.new("test_half_age_propagates_zero_error")
    var d: dyn.Data = make_data(0)
    var result: Result<int64, string> = dyn.halfAge(d)

    t.isErr(result)
    t.eqString(
        result.unwrapErr(),
        "zero division error",
    )
    t.finish()

    return void
}
