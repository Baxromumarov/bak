package main

import "src/std/path/path.bak" as path
import "src/std/filepath/filepath.bak" as fp

func main() -> (void) {
    var joined: string = path.join("/usr", "local/bin")
    println("path.join:", joined)

    var cleaned: string = path.clean("/usr//local/../bin/")
    println("path.clean:", cleaned)

    var sample: string = "/home/user/file.txt"
    println("path.base:", path.base(&sample))
    println("path.dir:", path.dir(&sample))
    println("path.ext:", path.ext(&sample))

    println("filepath.join:", fp.join("a", "b"))
}
