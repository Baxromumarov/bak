package main

import "std/encoding/json" as json

func main() -> (void) {
    var entries: Vec<json.JsonEntry, _> = Vec.from([
        json.entry("name", json.Json.String("bak")),
        json.entry("version", json.Json.Int(1)),
        json.entry("ok", json.Json.Boolean(true)),
    ])

    var obj: json.Json = json.object(entries)
    println("compact:")
    println(json.marshal(obj))
    println("")
    println("pretty:")
    println(json.marshal_pretty(obj, 2))
}
