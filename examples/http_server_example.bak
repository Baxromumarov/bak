package main

import http "std/http"

func handle_hello(req: http.Request) -> (http.Response) {
    mut var who: string = "world"

    switch req.query("name") {
        case Ok(v) {
            who = v
        }
        case Err(_) {
            who = who
        }
    }

    return http.text(
        200,
        "Hello, " + who + "!",
    )
}

func main() -> (void) {
    mut var router = http.newRouter()

    router.get(
        "/hello",
        handle_hello,
    )

    var _ = http.listenAndServe(
        ":8080",
        router,
    )

    return void
}
