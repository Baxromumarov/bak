// Vectors (Vec) in bak
// The unified sequence type for both fixed and dynamic arrays

package main

func main() -> (void) {
    // Fixed-size Vec - stack allocated, size known at compile time
    var fixedVec: Vec<int, 5> = Vec.from([1, 2, 3, 4, 5])
    println("Fixed Vec:", fixedVec)
    println("Length:", len(fixedVec))
    println("First element:", fixedVec[0])
    println("Last element:", fixedVec[4])
    
    // Dynamic Vec - heap backed, can grow
    mut var dynamicVec: Vec<int, _> = Vec.from([10, 20, 30])
    println("Dynamic Vec:", dynamicVec)
    
    // Push to dynamic vec (requires mut)
    dynamicVec.push(40)
    dynamicVec.push(50)
    println("After push:", dynamicVec)
    
    // Pop from dynamic vec
    var popped = dynamicVec.pop()
    switch popped {
        case Some(v) {
            println("Popped:", v)
        }
        case None {
            println("Vec was empty")
        }
    }
    println("After pop:", dynamicVec)
    
    // Iteration
    println("Iterating over fixed vec:")
    for item in fixedVec {
        println("  -", item)
    }
    
    // Vec methods
    println("Is dynamic vec empty?", dynamicVec.is_empty())
    
    // Getting elements safely
    var elem = dynamicVec.get(1)
    switch elem {
        case Some(v) {
            println("Element at index 1:", v)
        }
        case None {
            println("Index out of bounds")
        }
    }
    
    // Index out of bounds
    var outOfBounds = dynamicVec.get(100)
    switch outOfBounds {
        case Some(v) {
            println("Element:", v)
        }
        case None {
            println("Index 100 is out of bounds!")
        }
    }
    
    // Built-in functions
    println("first:", first(fixedVec))
    println("last:", last(fixedVec))
}
