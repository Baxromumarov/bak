package main

import http "std/http"

func main() -> (void) {
    var params: Vec<http.QueryParam, _> = Vec.from(
        [
            http.QueryParam{name: "q", value: "bak"},
            http.QueryParam{name: "page", value: "1"},
        ],
    )
    var url: string = http.appendQuery(
        "http://example.com/search",
        params,
    )
    var headers: Vec<http.Header, _> = Vec.from(
        [
            http.Header{name: "User-Agent", value: "bak-client/0.1"},
        ],
    )
    var raw: string = "GET /search?q=bak&page=1 HTTP/1.1\r\nHost: example.com\r\nUser-Agent: bak-client/0.1\r\n\r\n"

    switch http.parseRequest(raw) {
        case Ok(req) {
            println(
                "url:",
                url,
            )
            println(
                "path:",
                req.path,
            )
            println(
                "user-agent header present:",
                req.hasHeader("User-Agent"),
            )
            println(
                "query count:",
                req.queryParams().len(),
            )
            println(
                "example response:",
                http.text(
                    200,
                    "ok",
                ).bodyString(
                ),
            )
        }
        case Err(e) {
            println(
                "request parse failed:",
                e,
            )
        }
    }

    println(
        "default headers configured:",
        headers.len(),
    )
}
