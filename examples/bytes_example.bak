package main

import bytes "std/bytes"
import byteTypes "std/bytes/types"

func main() -> (void) {
    mut var buffer: byteTypes.Bytes = bytes.fromString("hello world")
    // Mutate before taking shared borrows; Bak v0.1 borrows are lexical.
    var setResult: Result<void, string> = bytes.set(
        &mut buffer,
        6,
        int('B'),
    )

    if setResult.isErr() {
        println(
            "set error:",
            setResult.unwrapErr(),
        )
    }

    println(
        "len:",
        bytes.length(&buffer),
    )

    switch bytes.view(
        &buffer,
        0,
        5,
    ) {
        case Ok(view) {
            println(
                "view len:",
                bytes.viewLength(&view),
            )
            println(
                "first byte:",
                bytes.viewGet(
                    &view,
                    0,
                ).unwrap(),
            )
        }
        case Err(message) {
            println(
                "view error:",
                message,
            )
        }
    }

    println(
        "as string:",
        bytes.toString(&buffer),
    )

    return void
}
