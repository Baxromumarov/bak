package main

import log "std/log"

func main() -> (void) {
    log.setPrefix("[demo]")
    log.setLevel(log.levelDebug)
    log.debug("debug message")
    log.info("info message")
    log.test("test message")
    log.warn("warn message")
    log.error("error message")
    log.disableColor()
    log.info("color disabled")
    log.infoKv(
        "user logged in",
        Vec.from(
            [
                log.kv(
                    "user",
                    "bakhrom",
                ),
                log.kv(
                    "role",
                    "admin",
                ),
            ],
        ),
    )

    mut var api: log.Logger = log.module(
        "api",
        log.levelDebug,
    )

    api.log(
        log.levelInfo,
        "module logger info",
    )
    api.logKv(
        log.levelDebug,
        "module debug",
        Vec.from(
            [
                log.kv(
                    "path",
                    "/v1/users",
                ),
            ],
        ),
    )
}
