package main

enum JobStatus {
    Pending
    Running
    Done
    Failed
}

struct Job {
    id:       int
    attempts: int
    status:   JobStatus
    payload:  string
}

struct Queue {
    jobs:   Vec<Job, _>
    nextID: int
}

impl Queue as q {
    mut func enqueue(payload: string) -> (int) {
        var id: int = q.nextID
        q.nextID = q.nextID + 1
        q.jobs.push(Job{id: id, attempts: 0, status: JobStatus.Pending, payload: payload})
        return id
    }

    mut func runOnce() -> (void) {
        mut var i: int = 0
        while i < q.jobs.len() {
            mut var job: Job = q.jobs[i]
            if job.status == JobStatus.Pending {
                job.status = JobStatus.Running
                job.attempts = job.attempts + 1
                if job.payload.len() == 0 {
                    job.status = JobStatus.Failed
                } else {
                    job.status = JobStatus.Done
                }
                q.jobs[i] = job
            }
            i = i + 1
        }
        return void
    }

    func count(status: JobStatus) -> (int) {
        mut var total: int = 0
        for job in q.jobs {
            if job.status == status {
                total = total + 1
            }
        }
        return total
    }
}

func newQueue() -> (Queue) {
    return Queue{jobs: Vec.new(), nextID: 1}
}

func main() -> (void) {
    mut var queue: Queue = newQueue()
    println("job: " + queue.enqueue("send-email").toString())
    println("job: " + queue.enqueue("").toString())
    queue.runOnce()
    println("done: " + queue.count(JobStatus.Done).toString())
    println("failed: " + queue.count(JobStatus.Failed).toString())
    return void
}
