package main

enum EntryKind {
    Debit
    Credit
}

struct Entry {
    account: string
    kind:    EntryKind
    amount:  int
}

struct Ledger {
    entries: Vec<Entry, _>
}

impl Ledger as l {
    mut func add(entry: Entry) -> (void) {
        l.entries.push(entry)

        return void
    }

    func balance(account: string) -> (int) {
        mut var total: int = 0

        for entry in l.entries {
            if entry.account == account {
                if entry.kind == EntryKind.Credit {
                    total = total + entry.amount
                } else {
                    total = total - entry.amount
                }
            }
        }

        return total
    }
}

func newLedger() -> (Ledger) {
    return Ledger{entries: Vec.new()}
}

func main() -> (void) {
    mut var ledger: Ledger = newLedger()

    ledger.add(
        Entry{
            account: "cash",
            amount:  100,
            kind:    EntryKind.Credit,
        },
    )

    ledger.add(
        Entry{
            account: "cash",
            amount:  35,
            kind:    EntryKind.Debit,
        },
    )
    ledger.add(
        Entry{
            account: "bank",
            amount:  80,
            kind:    EntryKind.Credit,
        },
    )
    println("cash balance: " + ledger.balance("cash").toString())
    println("bank balance: " + ledger.balance("bank").toString())

    return void
}
