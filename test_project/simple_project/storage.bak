package storage

import items "./item.bak"

pub struct Vault {
    pub products: Vec<items.Product, _>
}

impl Vault as v {
    pub mut func add(mut product: items.Product) -> (void) {
        v.products.push(product)
    }

    pub func getTotalValue() -> (float64) {
        mut var total: float64 = 0.0

        for p in v.products {
            total = total + p.rate
        }

        return total
    }

    pub func filter(
        f: func(&items.Product) -> (bool),
    ) -> (Vec<items.Product, _>) {
        mut var results: Vec<items.Product, _> = Vec.new()

        for p in v.products {
            if f(&p) {
                results.push(p)
            }
        }

        return results
    }
}

pub func newVault() -> (Vault) {
    return Vault{
        products: Vec.new(),
    }
}
