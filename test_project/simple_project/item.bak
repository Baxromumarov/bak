package item

pub enum Category {
    Electronics
    Grocery
    Furniture
}

// pub type Price = float64 // Testing strictness - currently failing alias assignment

pub struct Product {
    pub name: string
    pub id: int
    pub rate: float64
    pub kind: Category
}

pub func new(name: string, id: int, rate: float64, kind: Category) -> (Product) {
    return Product{
        name: name,
        id: id,
        rate: rate,
        kind: kind,
    }
}
