package main

import "std/http" as http
import "src/std/db/postgres.bak" as postgres
import "src/std/db/db.bak" as db
import "src/std/encoding/json/json.bak" as json

pub struct Task {
	pub id: int
	pub title: string
	pub completed: bool
}

impl Task as t {
	pub func to_json() -> (json.Json) {
		return json.encode_obj(t, task_json_entries)
	}
}

func task_json_entries(t: Task) -> (Vec<json.JsonEntry, _>) {
	return Vec.from(
		[
			json.entry_int("id", t.id),
			json.entry_string("title", t.title),
			json.entry_bool("completed", t.completed),
		],
	)
}

struct TaskInput {
	title: string
}

struct TasksDB {
	conn: db.Connection
	ready: bool
}

mut var tasks_db: TasksDB = TasksDB{conn: db.Connection{Handle: 0}, ready: false}

func connect_to_db() -> (TasksDB) {
	// Update this to your local Postgres credentials as needed.
	var conn_str: string = "host=localhost port=5432 user=postgres password=postgres dbname=bakdb sslmode=disable"
	var conn_result = postgres.connect(conn_str)
	if conn_result.is_err() {
		println("Database connection error: " + conn_result.unwrap_err())
		return TasksDB{ready: false}
	}

	var conn: db.Connection = conn_result.unwrap()
	var schema_result = ensure_schema(&conn)
	if schema_result.is_err() {
		println("Schema init error: " + schema_result.unwrap_err())
		return TasksDB{ready: false}
	}

	println("Postgres connected and schema ready")

	return TasksDB{conn: conn, ready: true}
}

func ensure_schema(conn: &db.Connection) -> (Result<void, string>) {
	var sql: string = "CREATE TABLE IF NOT EXISTS tasks (
                            id SERIAL PRIMARY KEY,
                            title TEXT NOT NULL,
                            completed BOOLEAN NOT NULL DEFAULT FALSE)"
	var q = postgres.query(conn, sql)
	if q.is_err() {
		return Err(q.unwrap_err())
	}
	return Ok(void)
}

func health_handler(_req: http.Request) -> (http.Response) {
	mut var entries: Vec<json.JsonEntry, _> = Vec.new()

	entries.push(json.entry("status", json.Json.String("ok")))
	entries.push(json.entry("db_ready", json.Json.Boolean(tasks_db.ready)))
	
    return http.json(200, json.marshal(json.object(entries)))
}

func list_tasks_handler(_req: http.Request) -> (http.Response) {
	if !tasks_db.ready {
		return http.error("database is not ready")
	}

	var sql: string = "SELECT id, title, completed FROM tasks ORDER BY id"
	var result = postgres.query(&tasks_db.conn, sql)
	if result.is_err() {
		return http.error("query failed: " + result.unwrap_err())
	}

	var tasks_result = map_query_result_to_tasks(result.unwrap())
	switch tasks_result {
		case Ok(tasks) {
			return http.json(200, json.marshal_array(tasks, task_to_json))
		}
		case Err(e) {
			return http.error("mapping failed: " + e)
		}
	}

	return http.Response{}
}

func create_task_handler(req: http.Request) -> (http.Response) {
	if !tasks_db.ready {
		return http.error("database is not ready")
	}

	var input_result = parse_task_input(req.body_string())
	if input_result.is_err() {
		return http.text(400, input_result.unwrap_err())
	}

	var input: TaskInput = input_result.unwrap()
	var sql: string = "INSERT INTO tasks (title, completed) VALUES ($1, FALSE) RETURNING id, title, completed"
	var params: Vec<string, _> = Vec.from([input.title])
	var result = postgres.query_params(&tasks_db.conn, sql, params)
	if result.is_err() {
		return http.error("insert failed: " + result.unwrap_err())
	}

	var task_result = map_query_result_to_task(result.unwrap())
	switch task_result {
		case Ok(task) {
			return http.json(201, json.marshal(task.to_json()))
		}
		case Err(e) {
			return http.error("create mapping failed: " + e)
		}
	}

	return http.Response{}
}

func toggle_task_handler(req: http.Request) -> (http.Response) {
	if !tasks_db.ready {
		return http.error("database is not ready")
	}

	var id_result = parse_id_param(&req)
	if id_result.is_err() {
		return http.text(400, id_result.unwrap_err())
	}

	var sql: string = "UPDATE tasks SET completed = NOT completed WHERE id = $1 RETURNING id, title, completed"
	var params: Vec<string, _> = Vec.from([id_result.unwrap().toString()])
	var result = postgres.query_params(&tasks_db.conn, sql, params)
	if result.is_err() {
		return http.error("toggle failed: " + result.unwrap_err())
	}

	var task_result = map_query_result_to_task(result.unwrap())
	switch task_result {
		case Ok(task) {
			return http.json(200, json.marshal(task.to_json()))
		}
		case Err(e) {
			if e == "not found" {
				return http.not_found()
			}
			return http.error("toggle mapping failed: " + e)
		}
	}

	return http.Response{}
}

func delete_task_handler(req: http.Request) -> (http.Response) {
	if !tasks_db.ready {
		return http.error("database is not ready")
	}

	var id_result = parse_id_param(&req)
	if id_result.is_err() {
		return http.text(400, id_result.unwrap_err())
	}

	var sql: string = "DELETE FROM tasks WHERE id = $1 RETURNING id, title, completed"
	var params: Vec<string, _> = Vec.from([id_result.unwrap().toString()])
	var result = postgres.query_params(&tasks_db.conn, sql, params)
	if result.is_err() {
		return http.error("delete failed: " + result.unwrap_err())
	}

	var task_result = map_query_result_to_task(result.unwrap())
	switch task_result {
		case Ok(task) {
			return http.json(200, json.marshal(task.to_json()))
		}
		case Err(e) {
			if e == "not found" {
				return http.not_found()
			}
			return http.error("delete mapping failed: " + e)
		}
	}

	return http.Response{}
}

func task_to_json(t: Task) -> (json.Json) {
	return t.to_json()
}

func parse_id_param(req: &http.Request) -> (Result<int, string>) {
	var id_result = parse_id_from_path(req.path)
	if id_result.is_err() {
		return Err(id_result.unwrap_err())
	}

	return Ok(id_result.unwrap())
}

func parse_id_from_path(path: string) -> (Result<int, string>) {
	mut var end: int = path.len()
	if path.endsWith("/toggle") {
		end = path.len() - 7
	}

	if end <= 0 {
		return Err("missing id param")
	}

	mut var start: int = end - 1
	while start >= 0 && path[start] != '/' {
		start = start - 1
	}
	start = start + 1

	if start >= end {
		return Err("missing id param")
	}

	var id_str: string = path.substring(start, end)
	if id_str.len() == 0 {
		return Err("missing id param")
	}

	var id_result = id_str.parseInt()
	if id_result.is_err() {
		return Err("invalid id param")
	}

	return Ok(id_result.unwrap())
}

func parse_task_input(body: string) -> (Result<TaskInput, string>) {
	if body.len() == 0 {
		return Err("request body is empty")
	}

	var parsed = json.unmarshal(body)
	if parsed.is_err() {
		return Err("invalid JSON: " + parsed.unwrap_err())
	}

	var obj_result = json.as_object(parsed.unwrap())
	if obj_result.is_err() {
		return Err(obj_result.unwrap_err())
	}
	var obj: json.Json = obj_result.unwrap()

	var title_result = json.require_string(&obj, "title")
	if title_result.is_err() {
		return Err(title_result.unwrap_err())
	}

	return Ok(TaskInput{title: title_result.unwrap()})
}

func map_query_result_to_tasks(result: db.QueryResult) -> (Result<Vec<Task, _>, string>) {
	mut var tasks: Vec<Task, _> = Vec.new()
	var rows: Vec<db.Row, _> = db.rows(&result)

	for row in rows {
		var id_result = row.get_int("id")
		if id_result.is_err() {
			return Err(id_result.unwrap_err())
		}

		var title_result = get_required_string(&row, "title")
		if title_result.is_err() {
			return Err(title_result.unwrap_err())
		}

		var completed_result = get_required_bool(&row, "completed")
		if completed_result.is_err() {
			return Err(completed_result.unwrap_err())
		}

		tasks.push(Task{
			id: id_result.unwrap(),
			title: title_result.unwrap(),
			completed: completed_result.unwrap(),
		})
	}

	return Ok(tasks)
}

func map_query_result_to_task(result: db.QueryResult) -> (Result<Task, string>) {
	var rows: Vec<db.Row, _> = db.rows(&result)
	if rows.len() == 0 {
		return Err("not found")
	}

	var row: db.Row = rows[0]

	var id_result = row.get_int("id")
	if id_result.is_err() {
		return Err(id_result.unwrap_err())
	}

	var title_result = get_required_string(&row, "title")
	if title_result.is_err() {
		return Err(title_result.unwrap_err())
	}

	var completed_result = get_required_bool(&row, "completed")
	if completed_result.is_err() {
		return Err(completed_result.unwrap_err())
	}

	return Ok(Task{
		id: id_result.unwrap(),
		title: title_result.unwrap(),
		completed: completed_result.unwrap(),
	})
}

func get_required_string(row: &db.Row, name: string) -> (Result<string, string>) {
	return row.get_string(name)
}

func get_required_bool(row: &db.Row, name: string) -> (Result<bool, string>) {
	return row.get_bool(name)
}

func main() -> (void) {
	tasks_db = connect_to_db()
	defer {
		if tasks_db.ready {
			var close_result = postgres.close(tasks_db.conn)
			if close_result.is_err() {
				println("Database close error: " + close_result.unwrap_err())
			}
		}
	}

    mut var router: http.Router = http.new_router()
	router.get("/health", health_handler)
	router.get("/tasks", list_tasks_handler)
	router.post("/tasks", create_task_handler)
	router.put("/tasks/:id/toggle", toggle_task_handler)
	router.delete("/tasks/:id", delete_task_handler)

	println("API listening on 0.0.0.0:8080")
	println("POST /tasks body: {\"title\":\"ship bak\"}")
	println("PUT /tasks/:id/toggle")

	var serve = http.listen_and_serve("0.0.0.0:8080", router)
	if serve.is_err() {
		println("Server error: " + serve.unwrap_err())
	}

	return void
}
