{
  "name": "bak",
  "displayName": "Bak Language",
  "description": "Bak language support with LSP",
  "version": "0.1.1",
  "publisher": "bak",
  "repository": {
    "type": "git",
    "url": "https://github.com/baxromumarov/bak.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:bak",
    "onCommand:bak.showOutput",
    "onCommand:bak.restartLanguageServer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "bak",
        "aliases": [
          "Bak",
          "bak"
        ],
        "extensions": [
          ".bak"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "bak.showOutput",
        "title": "Bak: Show Language Server Output"
      },
      {
        "command": "bak.restartLanguageServer",
        "title": "Bak: Restart Language Server"
      }
    ],
    "grammars": [
      {
        "language": "bak",
        "scopeName": "source.bak",
        "path": "./syntaxes/bak.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Bak Go Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/bak-go-dark.json"
      },
      {
        "label": "Bak Go Light",
        "uiTheme": "vs",
        "path": "./themes/bak-go-light.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Bak",
      "properties": {
        "bak.lspPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional path to the bak language server executable. Leave empty to use the bundled server, workspace bin/bak-lsp, or PATH."
        }
      }
    }
  },
  "scripts": {
	"check": "tsc -p ./ --noEmit",
	"build": "npm run check && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js",
	"watch": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js --watch",
    "package": "sh ./scripts/package-vsix.sh"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.2"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
