package main

// --- Result tests ---

func might_fail(ok: bool) -> (Result<int, string>) {
    if ok {
        return Ok(42)
    }
    return Err("something went wrong")
}

func use_result_ok() -> (Result<int, string>) {
    var val: int = might_fail(true)?
    return Ok(val + 1)
}

func use_result_err() -> (Result<int, string>) {
    var val: int = might_fail(false)?
    return Ok(val + 1)
}

// --- Additional Result tests ---

func find_value(present: bool) -> (Result<int, string>) {
    if present {
        return Ok(100)
    }
    return Err("missing value")
}

func use_option_some() -> (Result<int, string>) {
    var val: int = find_value(true)?
    return Ok(val + 1)
}

func use_option_none() -> (Result<int, string>) {
    var val: int = find_value(false)?
    return Ok(val + 1)
}

func main() -> (void) {
    println("=== Result ? operator ===")

    // Ok path: should unwrap and return Ok(43)
    switch use_result_ok() {
        case Ok(v) {
            println("ok:")
            println(v)
        }
        case Err(e) {
            println("err:")
            println(e)
        }
    }

    // Err path: should propagate the error
    switch use_result_err() {
        case Ok(v) {
            println("ok:")
            println(v)
        }
        case Err(e) {
            println("err:")
            println(e)
        }
    }

    println("=== Result ? operator (additional) ===")

    // Ok path: should unwrap and return Ok(101)
    switch use_option_some() {
        case Ok(v) {
            println("ok:")
            println(v)
        }
        case Err(e) {
            println("err:")
            println(e)
        }
    }

    // Err path: should propagate Err
    switch use_option_none() {
        case Ok(v) {
            println("ok:")
            println(v)
        }
        case Err(e) {
            println("err:")
            println(e)
        }
    }

    return void
}
