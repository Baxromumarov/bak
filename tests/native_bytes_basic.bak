package main

import bytes "std/bytes"

func main() -> (int) {
    mut var score: int = 0
    mut var b: bytes.Bytes = bytes.fromString("hi")

    {
        if bytes.length(&b) == 2 {
            score = score + 1
        }

        var opt: Result<int, string> = bytes.get(
            &b,
            0,
        )

        if opt.isOk() && opt.unwrap() == int('h') {
            score = score + 1
        }
    }

    var _ = bytes.set(
        &mut b,
        1,
        int('o'),
    )
    var s: string = bytes.toString(&b)

    if s.len() == 2 && s[0] == 'h' && s[1] == 'o' {
        score = score + 1
    }

    return score
}
