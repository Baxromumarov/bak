// ❌ TEST: double mutable borrow - should fail
package main

func modify(v: &mut Vec<int,_>) -> (void) {
    v.push(100)
    return void
}

func main() -> (void) {
    mut var v: Vec<int,_> = Vec.from([1,2,3])
    modify(&mut v)
    modify(&mut v)  // ❌ should error: v is still mutably borrowed
    return void
}
