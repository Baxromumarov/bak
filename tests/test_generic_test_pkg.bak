package main

import "src/std/test/test.bak" as test

struct Point {
    x: int
    y: int
}

func test_generic_int_eq() -> (void) {
    mut var t: test.T = test.new("test_generic_int")
    t.eq(10, 10)
    if t.has_failed() {
        println("FAIL: eq<int> failed on equal values")
    } else {
        println("PASS: eq<int> works")
    }
    t.finish()
}

func test_generic_string_eq() -> (void) {
    mut var t: test.T = test.new("test_generic_string")
    t.eq("hello", "hello")
    if t.has_failed() {
        println("FAIL: eq<string> failed on equal values")
    } else {
        println("PASS: eq<string> works")
    }
    t.finish()
}

func main() -> (void) {
    test_generic_int_eq()
    test_generic_string_eq()
    println("Generic test verification complete")
}
