// ❌ TEST: consume while mutably borrowed - should fail
package main

func modify(v: &mut Vec<int, _>) -> (void) {
    v.push(100)

    return void
}

func consume(v: Vec<int, _>) -> (int) {
    return v.len()
}

func main() -> (void) {
    mut var v: Vec<int, _> = Vec.from([1, 2, 3])

    modify(&mut v)
    consume(v)

    // ❌ should error: v is still mutably borrowed
    return void
}
