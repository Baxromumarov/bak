package main

struct Node {
    value: int
    next: Node box?
}

func main() -> (void) {
    var n: Node = Node {
        value: 2,
        next: None
    }

    var head: Node = Node {
        value: 1,
        next: Some(box n)
    }

    // is_some() style
    if head.next.is_some() {
        println("is_some ok")
        var cur: &Node = head.next.deref()
        println(cur.value)
    } else {
        println("is_some fail")
    }

    // switch pattern
    switch head.next {
        case Some(next) {
            println("switch ok")
            var cur: &Node = next.deref()
            println(cur.value)
        }
        case None {
            println("switch none")
        }
    }

    println("TEST_OK")
    return void
}
