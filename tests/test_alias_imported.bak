package main

import types "tests/typelib/typelib.bak"
import math "tests/mathlib.bak"

// =============================================================================
// Test: Alias for Imported PUBLIC Structs  
// =============================================================================
// Alias for imported public struct
alias Point = types.Point
alias Person = types.Person

func testImportedPublicAlias() -> (void) {
    println("Imported public type aliases:")

    // Use local alias for imported struct - must use full qualified type on both sides
    var p: Point = Point{x: 10, y: 20}

    println(
        "  Point (alias for types.Point):",
        p,
    )

    var person: Person = Person{
        active: true,
        age:    30,
        name:   "Alice",
    }

    println(
        "  Person:",
        person,
    )
    println("✓ Imported public alias tests passed")

    return void
}

// =============================================================================
// Test: Direct Usage of Imported Types (without local alias)
// =============================================================================
func testDirectImportedTypes() -> (void) {
    println("Direct imported type usage:")

    // Use qualified name directly
    var p: types.Point = types.Point{x: 5, y: 15}

    println(
        "  types.Point:",
        p,
    )

    // Use imported function
    var createdPoint: types.Point = types.createPoint(
        25,
        35,
    )

    println(
        "  types.createPoint(25, 35):",
        createdPoint,
    )
    // Use imported constant
    println(
        "  types.maxPoints:",
        types.maxPoints,
    )
    println("✓ Direct imported type tests passed")

    return void
}

// =============================================================================
// Test: Vec with Imported Types and Aliases
// =============================================================================
func testVecWithImportedTypes() -> (void) {
    println("Vec with imported types:")

    // Vec of imported type via alias
    mut var points: Vec<Point, _> = Vec.new()

    points.push(Point{x: 1, y: 2})
    points.push(Point{x: 3, y: 4})
    points.push(Point{x: 5, y: 6})
    println(
        "  Vec<Point, _>:",
        points,
    )
    println("✓ Vec with imported type tests passed")

    return void
}

// =============================================================================
// Test: Function Using Imported Types
// =============================================================================
func processPoint(p: &Point) -> (int) {
    return p.x + p.y
}

func createPerson(name: string, age: int) -> (Person) {
    return Person{
        active: true,
        age:    age,
        name:   name,
    }
}

func testFunctionsWithImportedTypes() -> (void) {
    println("Functions with imported types:")

    var p: Point = Point{x: 10, y: 20}
    var sum: int = processPoint(&p)

    println(
        "  processPoint({{x: 10, y: 20}}) =",
        sum,
    )

    var person: Person = createPerson(
        "Dave",
        40,
    )

    println(
        "  createPerson(Dave, 40) =",
        person,
    )
    println("✓ Function with imported type tests passed")

    return void
}

// =============================================================================
// Test: Multiple Imports with Aliases
// =============================================================================
alias Calculator = math.Calc

func testMultipleImports() -> (void) {
    println("Multiple imports with aliases:")

    var calc: Calculator = Calculator{a: 10, b: 20}

    println(
        "  Calculator (from mathlib):",
        calc,
    )

    var point: Point = Point{x: 5, y: 10}

    println(
        "  Point (from typelib):",
        point,
    )
    println("✓ Multiple imports tests passed")

    return void
}

func main() -> (void) {
    println("========================================")
    println("Imported Type Alias Tests")
    println("========================================")
    println("")
    testImportedPublicAlias()
    println("")
    testDirectImportedTypes()
    println("")
    testVecWithImportedTypes()
    println("")
    testFunctionsWithImportedTypes()
    println("")
    testMultipleImports()
    println("")
    println("========================================")
    println("All imported alias tests completed!")
    println("========================================")

    return void
}
