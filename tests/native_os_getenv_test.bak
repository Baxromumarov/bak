package main

import "std/os"

func main() -> (void) {
    println("Testing os.getenv...")

    var home: Result<string, string> = os.getenv("HOME")

    if home.isOk() {
        var h: string = home.unwrap()

        println(
            "HOME:",
            h,
        )
    } else {
        println("HOME not set")
    }

    var path: Result<string, string> = os.getenv("PATH")

    if path.isOk() {
        println("PATH is set")
    } else {
        println("PATH not set")
    }

    var nonexistent: Result<string, string> = os.getenv("DEFINITELY_NOT_SET_XYZ123")

    if nonexistent.isErr() {
        println("PASS: Non-existent var returns Err")
    } else {
        println("FAIL: Found non-existent var")
    }

    println("Done")
}
