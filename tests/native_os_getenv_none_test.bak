package main

import "std/os"

func main() -> (void) {
    println("Testing os.getenv for non-existent var...")

    var nonexistent: Option<string> = os.getenv("DEFINITELY_NOT_SET_XYZ123")

    if nonexistent.is_none() {
        println("PASS: Non-existent var returns None")
    } else {
        println("FAIL: Found non-existent var")
    }

    println("Done")
}
