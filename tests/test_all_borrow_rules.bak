// Test cases from ownership_and_borrowing_rule.txt
// Run each test separately by uncommenting
package main

func inspect(v: &Vec<int, _>) -> (int) {
    return v.len()
}

// func _modify(v: &mut Vec<int,_>) -> (void) {
