package main

pub struct Entry {
    pub path:  string
    pub alias: string
}

func main() -> (int) {
    var importPath: string = "src/std/http/server.bak"
    var importAlias: string = "driver"
    var e: Entry = Entry{alias: importAlias, path: importPath}

    println("e.path=" + e.path)
    println("e.alias=" + e.alias)

    return 0
}
