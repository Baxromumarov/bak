package main

import thread "std/thread"

mut var counter: int = 0

func incrementer(iters: int) -> (void) {
    mut var i: int = 0

    while i < iters {
        counter = counter + 1
        i = i + 1
    }
}

func main() -> (void) {
    var iters: int = 50000
    var t1 = thread.spawn(
        incrementer,
        iters,
    )
    var t2 = thread.spawn(
        incrementer,
        iters,
    )
    var t3 = thread.spawn(
        incrementer,
        iters,
    )
    var t4 = thread.spawn(
        incrementer,
        iters,
    )

    t1.join()
    t2.join()
    t3.join()
    t4.join()
    println(
        "Final counter:",
        counter,
    )
    println(
        "Expected ~",
        iters * 4,
    )

    if counter > 0 {
        println("SUCCESS: Globals are shared")
    } else {
        println("FAILURE: Globals are NOT shared")
    }
}
