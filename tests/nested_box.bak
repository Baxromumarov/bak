package main

struct Node {
    value: int
    next: Node box?
}

func main() -> (void) {
    var n: Node = Node { value: 3, next: None }

    // nested box: Box(Box(n))
    var head: Node = Node { value: 1, next: Box(Box(n)) }

    // is_some() should be true
    if head.next.is_some() {
        println("nested is_some ok")
    } else {
        println("ERROR nested is_some false")
    }

    // switch should bind nested Box and allow double-deref to Node
    switch head.next {
        case Some(inner) {
            println("nested switch ok")
            // inner is a Box whose Value is a Box containing Node
            var cur: &Node = inner.deref().deref()
            println(cur.value)
        }
        case None {
            println("ERROR nested switch None")
        }
    }

    println("TEST_OK")
    return void
}
