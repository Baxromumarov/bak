package main

struct Node {
    value: int
    next: Node box?
}

func main() -> (void) {
    var n: Node = Node { value: 9, next: None }

    // Option(Some(Box(None))) and Option(Some(Box(Some(n)))) variants
    var a: Node = Node { value: 1, next: Some(Box(None)) }
    var b: Node = Node { value: 2, next: Some(Box(Some(n))) }

    // a: Some(Box(None)) -> Some branch should bind Box which is None inside
    switch a.next {
        case Some(bx) {
            println("a matched Some")
            if bx.is_some() {
                println("ERROR: bx is_some on Box(None)")
            } else {
                println("a Box(None) detected ok")
            }
        }
        case None { println("ERROR a None") }
    }

    // b: Some(Box(Some(n))) -> Some branch, inner option is Some
    switch b.next {
        case Some(bx) {
            println("b matched Some")
            if bx.deref().is_some() {
                println("b inner is_some ok")
                switch bx.deref() {
                    case Some(nv) {
                        var cur: &Node = nv.deref()
                        println(cur.value)
                    }
                    case None { println("ERROR b inner None") }
                }
            } else {
                println("ERROR b inner is_some false")
            }
        }
        case None { println("ERROR b None") }
    }

    println("TEST_OK")
    return void
}
