package main

import "std/os"

func main() -> (void) {
    println("Testing os.cwd...")
    var result: Result<string, string> = os.cwd()
    if result.is_ok() {
        var cwd: string = result.unwrap()
        println("Current directory:", cwd)
    } else {
        println("Error getting cwd")
    }
    println("Done")
}
