func main() -> (void) {
    // ✅ Test 1: Multiple immutable borrows should pass
    var v1: Vec<int, _> = Vec.from([1, 2, 3])

    inspect(&v1)
    inspect(&v1)
    println("Test 1 passed: multiple immutable borrows")

    // ❌ Test 2: mutable borrow then immutable borrow should fail
    // mut var v2 Vec<int,_> = Vec.from([1,2,3])
