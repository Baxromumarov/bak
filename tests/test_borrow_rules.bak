    // inspect(&v2)
    // ✅ Test 3: mutable borrow in a block, then immutable should pass
    // mut var v3 Vec<int,_> = Vec.from([1,2,3])
    // {
    //     modify(&mut v3)
    // }
    // inspect(&v3)
    return void
}
