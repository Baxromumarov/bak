package lexer

// Simplified lexer test
pub struct Lexer {
    position: int
    ch:       int
}

impl Lexer as l {
    mut func readChar() -> (void) {
        l.ch = l.position
        l.position = l.position + 1

        return void
    }

    func show() -> (void) {
        println("pos=" + string(l.position) + " ch=" + string(l.ch))

        return void
    }
}

pub func new() -> (Lexer) {
    mut var lexer: Lexer = Lexer{ch: 0, position: 0}

    lexer.readChar()

    return lexer
}
