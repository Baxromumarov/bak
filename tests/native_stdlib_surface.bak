package main

import crypto "std/crypto"
import fs "std/fs"
import os "std/os"

func clonePath(path: &string) -> (string) {
    var bytes: Vec<int, _> = (*path).bytes()

    return __builtin_string_from_bytes(bytes, 0, bytes.len())
}

func main() -> (int) {
    mut var score: int = 0
    mut var file_path: string = ""

    if crypto.fnv1a("hello") == 1335831723 {
        score = score + 1
    }

    switch os.cwd() {
        case Ok(cwd) {
            if cwd.len() > 0 {
                file_path = cwd + "/bak_phase3_stdlib.txt"
                score = score + 1
            }
        }
        case Err(_) {
        }
    }

    if file_path.len() > 0 {
        switch fs.writeFile(
            clonePath(&file_path),
            "phase3",
        ) {
            case Ok(_) {
                score = score + 1
            }
            case Err(_) {
            }
        }
    }

    if file_path.len() > 0 && fs.exists(clonePath(&file_path)) {
        score = score + 1
    }

    if file_path.len() > 0 {
        switch fs.readFile(clonePath(&file_path)) {
            case Ok(contents) {
                if contents == "phase3" {
                    score = score + 1
                }
            }
            case Err(_) {
            }
        }
    }

    return score
}
