// Test cascade prevention - should only show ONE error
package main

func consume(v: Vec<int,_>) -> (int) {
    return v.len()
}

func main() -> (void) {
    var v: Vec<int,_> = Vec.from([1,2,3])
    consume(v)      // v is moved here
    consume(v)      // error: use of moved value
    consume(v)      // should NOT produce another error (poisoned)
    consume(v)      // should NOT produce another error (poisoned)
    return void
}
