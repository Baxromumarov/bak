package main

func main() -> (int) {
    var a: Result<int, string> = Ok(7)
    var b: Result<int, string> = Err("missing")
    mut var result: int = 0
    if a.isOk() {
        result = result + 1
    }
    if b.isErr() {
        result = result + 1
    }
    result = result + a.unwrap()
    return result
}
