package main

import strings "std/strings"
import path "std/path"
import filepath "std/filepath"
import fs "std/fs"
import test "std/test"

func test_strings_enhancements() -> (void) {
    mut var t: test.T = test.new("test_strings_enhancements")
    var s: string = "bak"

    t.eqString(
        strings.reverse(&s),
        "kab",
    )

    var text: string = "a\r\nb\n"
    var ls: Vec<string, _> = strings.lines(&text)

    t.eq(
        ls.len(),
        3,
    )

    switch ls.get(0) {
        case Ok(v) {
            t.eqString(
                v,
                "a",
            )
        }
        case Err(_) {
            t.fail("expected line 0")
        }
    }

    switch ls.get(1) {
        case Ok(v) {
            t.eqString(
                v,
                "b",
            )
        }
        case Err(_) {
            t.fail("expected line 1")
        }
    }

    switch ls.get(2) {
        case Ok(v) {
            t.eqString(
                v,
                "",
            )
        }
        case Err(_) {
            t.fail("expected line 2")
        }
    }

    var prefixes: Vec<string, _> = Vec.from(["src/", "pkg/"])
    var suffixes: Vec<string, _> = Vec.from([".bak", ".txt"])
    var path_like: string = "src/main.bak"

    t.isTrue(
        strings.hasPrefixAny(
            &path_like,
            &prefixes,
        ),
    )
    t.isTrue(
        strings.hasSuffixAny(
            &path_like,
            &suffixes,
        ),
    )
    t.isFalse(
        strings.hasPrefixAny(
            &path_like,
            &Vec.from(["cmd/", "lsp/"]),
        ),
    )
    t.isFalse(
        strings.hasSuffixAny(
            &path_like,
            &Vec.from([".go", ".json"]),
        ),
    )
    t.finish()
}

func test_path_enhancements() -> (void) {
    mut var t: test.T = test.new("test_path_enhancements")
    var p: string = "/tmp/archive.tar.gz"

    t.isFalse(path.isRel(p))
    t.eqString(
        path.ext(&p),
        ".gz",
    )
    t.isTrue(path.hasExt(&p))
    t.eqString(
        path.stem(&p),
        "archive.tar",
    )
    t.eqString(
        path.withoutExt(&p),
        "/tmp/archive.tar",
    )

    var bak_ext: string = "bak"

    t.eqString(
        path.withExt(
            &p,
            &bak_ext,
        ),
        "/tmp/archive.tar.bak",
    )

    var explicit_ext: string = ".tmp"

    t.eqString(
        path.withExt(
            &p,
            &explicit_ext,
        ),
        "/tmp/archive.tar.tmp",
    )

    var no_ext: string = "notes"

    t.isTrue(path.isRel(no_ext))
    t.isFalse(path.hasExt(&no_ext))
    t.eqString(
        path.stem(&no_ext),
        "notes",
    )
    t.eqString(
        path.withoutExt(&no_ext),
        "notes",
    )
    t.finish()
}

func test_filepath_and_fs_helpers() -> (void) {
    mut var t: test.T = test.new("test_filepath_and_fs_helpers")

    t.eqString(
        filepath.clean("a//b/./c"),
        "a/b/c",
    )
    t.isTrue(filepath.isRel("tmp/file.txt"))
    t.isFalse(filepath.isRel("/tmp/file.txt"))
    t.isTrue(filepath.hasExt("tmp/file.txt"))
    t.eqString(
        filepath.stem("archive.tar.gz"),
        "archive.tar",
    )
    t.eqString(
        filepath.withoutExt("/tmp/archive.tar.gz"),
        "/tmp/archive.tar",
    )
    t.eqString(
        filepath.withExt(
            "/tmp/archive.tar.gz",
            "bak",
        ),
        "/tmp/archive.tar.bak",
    )
    t.eqString(
        filepath.withExt(
            "/tmp/archive.tar.gz",
            ".tmp",
        ),
        "/tmp/archive.tar.tmp",
    )

    var joined: string = fs.joinParts(
        Vec.from(
            [
                "/tmp",
                "bak",
                "logs",
                "..",
                "today.log",
            ],
        ),
    )

    t.eqString(
        joined,
        "/tmp/bak/today.log",
    )
    t.eqString(
        fs.readFileOr(
            "/definitely/missing/file.bak",
            "fallback",
        ),
        "fallback",
    )
    t.finish()
}
