// Test: Option None with any type - should PASS
// This file should compile without type errors
package main

func findString(id: int) -> (Option<string>) {
    if id != 0 {
        return Some("found")
    }
    // OK: None matches any Option<T>
    return None
}

func findInt(id: int) -> (Option<int>) {
    if id != 0 {
        return Some(id)
    }
    // OK: None matches any Option<T>
    return None
}

func main() -> (void) {
    var s = findString(0)
    var i = findInt(0)
    
    switch s {
        case Some(v) {
            println("String:", v)
        }
        case None {
            println("No string")
        }
    }
    
    switch i {
        case Some(v) {
            println("Int:", v)
        }
        case None {
            println("No int")
        }
    }
    return void
}
