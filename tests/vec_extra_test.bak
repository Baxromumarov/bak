package main

import test "std/test"

func test_reverse() -> (void) {
    mut var t: test.T = test.new("test_reverse")
    mut var v: Vec<int, _> = Vec.new()

    v.push(1)
    v.push(2)
    v.push(3)
    // Reverse
    v.reverse()
    t.eq(
        v[0],
        3,
    )
    t.eq(
        v[1],
        2,
    )
    t.eq(
        v[2],
        1,
    )
    t.finish()
}

func test_contains() -> (void) {
    mut var t: test.T = test.new("test_contains")
    mut var v: Vec<string, _> = Vec.new()

    v.push("a")
    v.push("b")
    t.eq(
        v.contains("a"),
        true,
    )
    t.eq(
        v.contains("c"),
        false,
    )
    t.finish()
}
