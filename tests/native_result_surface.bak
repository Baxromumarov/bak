package main

func main() -> (int) {
    mut var score: int = 0

    mut var v: Vec<int, _> = Vec.new()
    switch v.pop() {
        case Err(_) { score = score + 1 }
        case Ok(_) {}
    }

    v.push(10)
    v.push(20)

    switch v.first() {
        case Ok(x) {
            if x == 10 {
                score = score + 1
            }
        }
        case Err(_) {}
    }

    switch v.last() {
        case Ok(x) {
            if x == 20 {
                score = score + 1
            }
        }
        case Err(_) {}
    }

    switch v.get(1) {
        case Ok(x) {
            if x == 20 {
                score = score + 1
            }
        }
        case Err(_) {}
    }

    switch v.remove(0) {
        case Ok(x) {
            if x == 10 {
                score = score + 1
            }
        }
        case Err(_) {}
    }

    switch v.get(99) {
        case Err(_) { score = score + 1 }
        case Ok(_) {}
    }

    var s: string = "abc"
    switch s.get(1) {
        case Ok(ch) {
            if ch == char('b') {
                score = score + 1
            }
        }
        case Err(_) {}
    }

    switch s.get(9) {
        case Err(_) { score = score + 1 }
        case Ok(_) {}
    }

    var ok: Result<int, string> = Ok(42)
    switch ok {
        case Ok(v) {
            if v == 42 {
                score = score + 1
            }
        }
        case Err(_) {}
    }
    if ok.is_ok() {
        score = score + 1
    }
    if ok.unwrap() == 42 {
        score = score + 1
    }

    var err: Result<int, string> = Err("x")
    switch err {
        case Err(msg) {
            if msg.len() == 1 {
                score = score + 1
            }
        }
        case Ok(_) {}
    }
    if err.is_err() {
        score = score + 1
    }
    if err.unwrap_err().len() == 1 {
        score = score + 1
    }

    return score
}
