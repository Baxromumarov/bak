package main

import "src/std/test/test.bak" as test

func test_addition() -> (void) {
    mut var t: test.T = test.new("test_addition")
    t.eq(1 + 1, 2)
    t.finish()
}

func test_pass() -> (void) {
    mut var t: test.T = test.new("test_pass")
    t.is_true(true)
    t.finish()
}

func normal_function() -> (void) {
    println("This should not run")
}
