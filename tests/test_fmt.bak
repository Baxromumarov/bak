package main

import fmt "std/fmt"

func main() -> (void) {
    // StringBuilder
    mut var sb: fmt.StringBuilder = fmt.newBuilder()

    sb.write("Hello")
    sb.write(", ")
    sb.write("World!")
    println(sb.build())
    // Format with placeholders
    println(
        fmt.format1(
            "Hello, {}!",
            "Bak",
        ),
    )
    println(
        fmt.format2(
            "{} + {} = awesome",
            "Bak",
            "coding",
        ),
    )
    println(
        fmt.sprintfInt(
            "The answer is {}",
            42,
        ),
    )
    println(
        fmt.sprintf2int(
            "{} + {} = ?",
            10,
            20,
        ),
    )
    // Repeat and pad
    println(
        fmt.repeat(
            "ab",
            3,
        ),
    )
    println(
        fmt.padLeft(
            "42",
            6,
            "0",
        ),
    )
    println(
        fmt.padRight(
            "hi",
            6,
            ".",
        ),
    )

    return void
}
