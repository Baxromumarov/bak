// working version:borrowing without moving
package main

func consume(v: &Vec<int, _>) -> (int) {
    return v.len()
}

func main() -> (void) {
    var nums: Vec<int, _> = Vec.from([1, 2, 3])
    var a: int = consume(&nums)
    var b: int = consume(&nums)

    println(
        a,
        b,
    )

    return void
}
