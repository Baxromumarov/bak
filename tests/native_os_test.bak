package main

import "std/os"

func main() -> (void) {
    // Test os.cwd
    var cwd_result: Result<string, string> = os.cwd()

    switch cwd_result {
        case Ok(cwd) {
            println(
                "Current directory:",
                cwd,
            )
        }
        case Err(e) {
            println(
                "cwd error:",
                e,
            )
        }
    }

    // Test os.getenv  
    var home: Result<string, string> = os.getenv("HOME")

    switch home {
        case Ok(h) {
            println(
                "HOME:",
                h,
            )
        }
        case Err(_e) {
            println("HOME not set")
        }
    }

    var path: Result<string, string> = os.getenv("PATH")

    switch path {
        case Ok(p) {
            println(
                "PATH exists (length",
                len(p),
                ")",
            )
        }
        case Err(_e) {
            println("PATH not set")
        }
    }

    // Test non-existent env var
    var nonexistent: Result<string, string> = os.getenv("DEFINITELY_NOT_SET_XYZ123")

    switch nonexistent {
        case Ok(v) {
            println(
                "ERROR: Found non-existent var:",
                v,
            )
        }
        case Err(_) {
            println("Non-existent var correctly returns Err")
        }
    }

    println("All os tests passed!")
    // Test os.exit (should exit with code 0)
    os.exit(0)
    // This should never print
    println("ERROR: Should have exited!")
}
