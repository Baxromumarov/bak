package main

import test "std/test"
import queue "std/collections/queue"
import set "std/collections/set"

func test_vec_core_behaviour() -> (void) {
    mut var t: test.T = test.new("test_vec_core_behaviour")
    mut var v: Vec<int, _> = Vec.new()

    t.isTrue(v.isEmpty())
    t.eq(
        v.len(),
        0,
    )
    v.push(10)
    v.push(20)
    t.eq(
        v.len(),
        2,
    )

    switch v.pop() {
        case Ok(last) {
            t.eq(
                last,
                20,
            )
        }
        case Err(err) {
            t.fail("pop failed: " + err)
        }
    }

    t.eq(
        v.len(),
        1,
    )
    t.isFalse(v.isEmpty())
    t.finish()
}

func test_vec_accessors_and_helpers() -> (void) {
    mut var t: test.T = test.new("test_vec_accessors_and_helpers")
    mut var v: Vec<int, _> = Vec.from([3, 1, 2])

    t.isTrue(v.cap() >= v.len())
    t.eq(
        v.first().unwrap(),
        3,
    )
    t.eq(
        v.last().unwrap(),
        2,
    )
    t.eq(
        v.contains(1),
        true,
    )
    t.eq(
        v.contains(99),
        false,
    )
    v.reverse()
    t.eq(
        v.join(","),
        "2,1,3",
    )

    switch v.remove(1) {
        case Ok(mid) {
            t.eq(
                mid,
                1,
            )
        }
        case Err(err) {
            t.fail("remove failed: " + err)
        }
    }

    t.eq(
        v.join(","),
        "2,3",
    )
    t.finish()
}

func test_vec_error_paths() -> (void) {
    mut var t: test.T = test.new("test_vec_error_paths")
    mut var v: Vec<int, _> = Vec.new()

    t.isTrue(v.first().isErr())
    t.isTrue(v.last().isErr())
    t.isTrue(v.get(0).isErr())
    t.isTrue(v.remove(0).isErr())
    t.isTrue(v.pop().isErr())
    t.finish()
}

func test_queue_helpers() -> (void) {
    mut var t: test.T = test.new("test_queue_helpers")
    mut var q = queue.newQueue()

    t.isTrue(q.isEmpty())
    t.eq(
        q.peekOr(99),
        99,
    )
    t.eq(
        q.popOr(88),
        88,
    )
    q.push(1)
    q.push(2)
    q.push(3)
    t.eq(
        q.len(),
        3,
    )
    t.eq(
        q.peekOr(0),
        1,
    )

    var snapshot: Vec<int, _> = q.toVec()

    t.eq(
        snapshot.len(),
        3,
    )
    t.eq(
        snapshot[0],
        1,
    )
    t.eq(
        snapshot[2],
        3,
    )
    t.eq(
        q.popOr(0),
        1,
    )

    var drained: Vec<int, _> = q.drain()

    t.eq(
        drained.len(),
        2,
    )
    t.eq(
        drained[0],
        2,
    )
    t.eq(
        drained[1],
        3,
    )
    t.isTrue(q.isEmpty())
    t.finish()
}

func test_set_helpers() -> (void) {
    mut var t: test.T = test.new("test_set_helpers")
    mut var a: set.IntSet = set.newIntSet()

    a.add(1)
    a.add(2)
    a.add(3)

    mut var b: set.IntSet = set.newIntSet()

    b.add(3)
    b.add(4)
    t.isTrue(a.intersects(&b))
    t.isFalse(a.equals(&b))
    t.isTrue(a.containsAll(&Vec.from([1, 2])))
    t.isFalse(a.containsAll(&Vec.from([1, 9])))

    mut var c: set.IntSet = set.newIntSet()

    c.add(1)
    c.add(2)
    c.add(3)
    t.isTrue(a.equals(&c))
    t.finish()
}
