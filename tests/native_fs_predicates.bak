// Test native file predicate builtins
package main

func main() -> (void) {
    var exists: bool = __builtin_file_exists("tests/native_fs_predicates.bak")

    if exists {
        println("PASS: __builtin_file_exists returns true for existing file")
    } else {
        println("FAIL: __builtin_file_exists returned false for existing file")
    }

    var isFile: bool = __builtin_is_file("tests/native_fs_predicates.bak")

    if isFile {
        println("PASS: __builtin_is_file returns true for file")
    } else {
        println("FAIL: __builtin_is_file returned false for file")
    }

    var isDir: bool = __builtin_is_dir("tests")

    if isDir {
        println("PASS: __builtin_is_dir returns true for directory")
    } else {
        println("FAIL: __builtin_is_dir returned false for directory")
    }

    println("=== Native file predicate tests complete ===")
}
