// tests/unused_checks/unused_funcs.bak
// Expected: warning for `unused_func`, no warning for `used_func`.
package main

func used_func() -> (void) {
    println("used_func called")
    return void
}

func unused_func() -> (void) {
    // intentionally unused
    println("unused_func called")
    return void
}

func main() -> (void) {
    used_func()
    return void
}
