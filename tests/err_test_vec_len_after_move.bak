// ❌ TEST: Vec.len() after move - should fail
package main

func consume(v: Vec<int, _>) -> (int) {
    return v.len()
}

func main() -> (void) {
    var v: Vec<int, _> = Vec.from([1, 2, 3])

    consume(v)

    // v is moved here
    var n: int = v.len()

    // ❌ ERROR: use of moved value 'v'
    println(n)

    return void
}
