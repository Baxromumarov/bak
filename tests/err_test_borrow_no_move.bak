package main

// consume takes ownership of v (move semantics)
func consume(v: Vec<int,_>) -> (int) {
    return v.len()
}

// borrow_func borrows v (no ownership transfer)
func borrow_func(v: &Vec<int,_>) -> (int) {
    return v.len()
}

func main() -> (void) {
    mut var nums: Vec<int,_> = Vec.from([1, 2, 3])
    
    // Borrowing should NOT move the value
    var a: int = borrow_func(&nums)
    println("First borrow:", a)
    
    // Should still be able to use nums after borrowing
    var b: int = borrow_func(&nums)
    println("Second borrow:", b)
    
    // Should still be able to consume after borrowing
    var c: int = consume(nums)
    println("Consume after borrow:", c)
    
    // But this should error - nums was moved
    var d: int = consume(nums)
    
    return void
}
