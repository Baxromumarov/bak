package mathlib

pub const pi: int = 3

pub struct Calc {
    pub a: int
    pub b: int
}

impl Calc as c {
    pub mut func add() -> (int) {
        return c.a + c.b
    }

    pub mut func sub() -> (int) {
        return c.a - c.b
    }
}

pub func add(a: int, b: int) -> (int) {
    return a + b
}

pub func sub(a: int, b: int) -> (int) {
    return a - b
}
