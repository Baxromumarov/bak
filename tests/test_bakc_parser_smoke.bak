// Smoke test for the bakc parser (bootstrap).
package main

import (
    "src/compiler/lexer/lexer.bak" as lexer
    "src/compiler/parser/parser.bak" as parser
)

func main() -> (void) {
    var readResult: Result<string, string> = fs.readFile("examples/hello.bak")
    switch readResult {
        case Ok(source) {
            var lex: lexer.Lexer = lexer.New(source)
            mut var p: parser.Parser = parser.NewParserFromLexer(lex)
            var program = p.ParseProgram()
            var errors: Vec<string, _> = p.Errors()

            if errors.len() > 0 {
                println("bakc parser smoke: errors")
                for err in errors {
                    println("  -", err)
                }
                os.exit(1)
            }

            println("bakc parser smoke: parsed", program.Statements.len(), "statements")
        }
        case Err(e) {
            println("bakc parser smoke: read error:", e)
            os.exit(1)
        }
    }
}
