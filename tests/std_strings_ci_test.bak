package main

import "src/std/strings/strings.bak" as strings
import "src/std/test/test.bak" as test

func test_strings_snake_case_api() -> (void) {
    mut var t: test.T = test.new("test_strings_snake_case_api")

    var text: string = "  bak-lang  "
    t.eqString(strings.trimLeft(&text), "bak-lang  ")
    t.eqString(strings.trimRight(&text), "  bak-lang")

    var name: string = "baklang"
    t.isTrue(strings.startsWith(&name, &"bak"))
    t.isTrue(strings.endsWith(&name, &"lang"))

    var csv: string = "a,b,c"
    var parts: Vec<string, _> = strings.split(&csv, &",")
    t.eq(parts.len(), 3)

    switch strings.parseInt(&"42") {
        case Ok(v) { t.eq(v, 42) }
        case Err(err) { t.fail("parseInt failed: " + err) }
    }

    switch strings.parseFloat(&"3.5") {
        case Ok(v) { t.eqFloat(v, 3.5) }
        case Err(err) { t.fail("parseFloat failed: " + err) }
    }

    var phrase: string = "bak language"
    t.eqString(strings.replaceFirst(&phrase, &"bak", &"BAK"), "BAK language")
    t.eqString(strings.padLeft(&"7", 3, char('0')), "007")
    t.eqString(strings.padRight(&"7", 3, char('0')), "700")

    switch strings.charAt(&name, 0) {
        case Ok(ch) { t.eqString(string(ch), "b") }
        case Err(err) { t.fail("charAt failed: " + err) }
    }

    t.eqString(strings.reverse(&"bak"), "kab")

    t.finish()
}
