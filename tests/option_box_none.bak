package main

struct Node {
    value: int
    next: Node box?
}

func main() -> (void) {
    var n: Node = Node { value: 2, next: None }

    var head: Node = Node { value: 1, next: None }

    // is_some() should be false
    if head.next.is_some() {
        println("ERROR is_some on None")
    } else {
        println("none is_some ok")
    }

    // switch should take None branch
    switch head.next {
        case Some(_) { println("ERROR switch matched Some on None") }
        case None { println("none switch ok") }
    }

    println("TEST_OK")
    return void
}
