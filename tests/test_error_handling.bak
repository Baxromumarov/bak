// Test file for error handling with Result
package main

func divide(a: int, b: int) -> (Result<int, string>) {
    if b == 0 {
        return Err("Division by zero")
    }
    return Ok(a / b)
}

func findIndex(arr: &Vec<string, _>, target: string) -> (Result<int, string>) {
    mut var i: int = 0
    while i < arr.len() {
        if arr[i] == target {
            return Ok(i)
        }
        i = i + 1
    }
    return Err("not found")
}

func parseNumber(s: &string) -> (Result<int, string>) {
    var result: Result<int, string> = s.parseInt()
    switch result {
        case Ok(n) {
            return Ok(n)
        }
        case Err(_) {
            return Err("Invalid number")
        }
    }
    return Err("Failed to parse")
}

func safeSqrt(n: float64) -> (Result<float64, string>) {
    if n < 0.0 {
        return Err("negative input")
    }
    // Simple approximation
    return Ok(n)
}

func main() -> (void) {
    println("=== Testing Error Handling ===")
    
    println("\n1. Result - Ok case:")
    var result1: Result<int, string> = divide(10, 2)
    switch result1 {
        case Ok(val) {
            println("  10 / 2 =", val)
        }
        case Err(e) {
            println("  Error:", e)
        }
    }
    
    println("\n2. Result - Err case:")
    var result2: Result<int, string> = divide(10, 0)
    switch result2 {
        case Ok(val) {
            println("  10 / 0 =", val)
        }
        case Err(e) {
            println("  Error:", e)
        }
    }
    
    println("\n3. Result matching:")
    switch result1 {
        case Ok(v) {
            println("  divide(10, 2) is Ok:", true)
        }
        case Err(e) {
            println("  divide(10, 2) is Ok:", false)
        }
    }
    switch result2 {
        case Ok(v) {
            println("  divide(10, 0) is Err:", false)
        }
        case Err(e) {
            println("  divide(10, 0) is Err:", true)
        }
    }
    
    println("\n4. Result unwrap_or:")
    switch result1 {
        case Ok(v) {
            println("  divide(10, 2).unwrap():", v)
        }
        case Err(e) {
            println("  Error")
        }
    }
    switch result2 {
        case Ok(v) {
            println("  divide(10, 0) value:", v)
        }
        case Err(e) {
            println("  divide(10, 0) default: -1")
        }
    }
    
    println("\n5. Result - Ok case:")
    var names: Vec<string, _> = Vec.from(["Alice", "Bob", "Charlie"])
    var found: Result<int, string> = findIndex(&names, "Bob")
    switch found {
        case Ok(idx) {
            println("  'Bob' found at index:", idx)
        }
        case Err(_) {
            println("  'Bob' not found")
        }
    }
    
    println("\n6. Result - Err case:")
    var notFound: Result<int, string> = findIndex(&names, "David")
    switch notFound {
        case Ok(idx) {
            println("  'David' found at index:", idx)
        }
        case Err(_) {
            println("  'David' not found")
        }
    }
    
    println("\n7. Result matching:")
    switch found {
        case Ok(v) {
            println("  findIndex(names, 'Bob').is_ok():", true)
        }
        case Err(_) {
            println("  findIndex(names, 'Bob').is_ok():", false)
        }
    }
    switch notFound {
        case Ok(_) {
            println("  findIndex(names, 'David').is_err():", false)
        }
        case Err(_) {
            println("  findIndex(names, 'David').is_err():", true)
        }
    }
    
    println("\n8. Result unwrap/default:")
    switch found {
        case Ok(v) {
            println("  found.unwrap():", v)
        }
        case Err(_) {
            println("  found default: -1")
        }
    }
    switch notFound {
        case Ok(v) {
            println("  notFound value:", v)
        }
        case Err(_) {
            println("  notFound default: -1")
        }
    }
    
    println("\n9. Chaining results:")
    var parseResult: Result<int, string> = parseNumber(&"42")
    switch parseResult {
        case Ok(n) {
            println("  Parsed '42':", n)
        }
        case Err(e) {
            println("  Parse error:", e)
        }
    }
    
    var badParse: Result<int, string> = parseNumber(&"abc")
    switch badParse {
        case Ok(n) {
            println("  Parsed 'abc':", n)
        }
        case Err(e) {
            println("  Parse error:", e)
        }
    }
    
    println("\n10. Multiple error handling:")
    var values: Vec<string, _> = Vec.from(["10", "20", "bad", "40"])
    print("  Parsing values: ")
    for v in values {
        var parsed: Result<int, string> = parseNumber(&v)
        switch parsed {
            case Ok(n) {
                print(n, " ")
            }
            case Err(e) {
                print("ERR ")
            }
        }
    }
    println()

    println("\n11. safeSqrt:")
    switch safeSqrt(9.0) {
        case Ok(v) {
            println("  sqrt(9):", v)
        }
        case Err(e) {
            println("  sqrt error:", e)
        }
    }
    
    println("\n=== Error handling tests complete ===")
}
